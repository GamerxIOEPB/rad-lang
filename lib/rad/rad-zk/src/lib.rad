// ==============================================================================
// Rad Standard Library: Zero-Knowledge Proofs & zk-SNARK Engine (std::zk)
// Finite field arithmetic, elliptic curve scalar multiplication, R1CS circuits, Groth16.
// Zero external C dynamic dependencies.
// NOTE: This module is an architectural software simulation model / reference implementation in pure Rad, not a hardware binding.
// ==============================================================================

// Prime modulus: Mersenne prime p = 2^31 - 1 = 2147483647
pub const FIELD_MODULUS: u64 = 2147483647u64

// ------------------------------------------------------------------------------
// FieldElement: Finite Field F_p Arithmetic
// ------------------------------------------------------------------------------

pub struct FieldElement {
    pub val: u64,
}

impl FieldElement {
    pub fn new(val: u64) -> FieldElement {
        return FieldElement {
            val: val % FIELD_MODULUS,
        }
    }

    pub fn zero() -> FieldElement {
        return FieldElement { val: 0u64 }
    }

    pub fn one() -> FieldElement {
        return FieldElement { val: 1u64 }
    }

    pub fn add(self, other: FieldElement) -> FieldElement {
        let sum = self.val + other.val
        return FieldElement { val: sum % FIELD_MODULUS }
    }

    pub fn sub(self, other: FieldElement) -> FieldElement {
        if self.val >= other.val {
            return FieldElement { val: self.val - other.val }
        }
        let diff = (FIELD_MODULUS - other.val) + self.val
        return FieldElement { val: diff }
    }

    pub fn mul(self, other: FieldElement) -> FieldElement {
        let prod = self.val * other.val
        return FieldElement { val: prod % FIELD_MODULUS }
    }

    pub fn pow(self, exp: u64) -> FieldElement {
        var base = self
        var e = exp
        var result = FieldElement.one()
        while e > 0u64 {
            if (e & 1u64) == 1u64 {
                result = result.mul(base)
            }
            base = base.mul(base)
            e = e >> 1u64
        }
        return result
    }

    pub fn inv(self) -> FieldElement {
        if self.val == 0u64 {
            return FieldElement.zero()
        }
        // By Fermat's Little Theorem: a^(p-2) mod p
        return self.pow(FIELD_MODULUS - 2u64)
    }

    pub fn eq(self, other: FieldElement) -> bool {
        return self.val == other.val
    }
}

// ------------------------------------------------------------------------------
// Elliptic Curve Arithmetic: Short Weierstrass Point (G1)
// ------------------------------------------------------------------------------

pub struct PointG1 {
    pub x: FieldElement,
    pub y: FieldElement,
    pub is_infinity: bool,
}

impl PointG1 {
    pub fn infinity() -> PointG1 {
        return PointG1 {
            x: FieldElement.zero(),
            y: FieldElement.zero(),
            is_infinity: true,
        }
    }

    pub fn new(x: FieldElement, y: FieldElement) -> PointG1 {
        return PointG1 {
            x: x,
            y: y,
            is_infinity: false,
        }
    }

    pub fn generator() -> PointG1 {
        // Standard generator coordinates
        return PointG1.new(FieldElement.new(1u64), FieldElement.new(2u64))
    }

    pub fn double(self) -> PointG1 {
        if self.is_infinity || self.y.val == 0u64 {
            return PointG1.infinity()
        }

        // slope lambda = (3 * x^2) / (2 * y)
        let three = FieldElement.new(3u64)
        let two = FieldElement.new(2u64)
        let num = three.mul(self.x.mul(self.x))
        let den = two.mul(self.y)
        let lambda = num.mul(den.inv())

        // x3 = lambda^2 - 2 * x
        let x3 = lambda.mul(lambda).sub(self.x).sub(self.x)
        // y3 = lambda * (x - x3) - y
        let y3 = lambda.mul(self.x.sub(x3)).sub(self.y)

        return PointG1.new(x3, y3)
    }

    pub fn add(self, other: PointG1) -> PointG1 {
        if self.is_infinity {
            return other
        }
        if other.is_infinity {
            return self
        }
        if self.x.eq(other.x) {
            if self.y.eq(other.y) {
                return self.double()
            }
            return PointG1.infinity()
        }

        // slope lambda = (y2 - y1) / (x2 - x1)
        let num = other.y.sub(self.y)
        let den = other.x.sub(self.x)
        let lambda = num.mul(den.inv())

        // x3 = lambda^2 - x1 - x2
        let x3 = lambda.mul(lambda).sub(self.x).sub(other.x)
        // y3 = lambda * (x1 - x3) - y1
        let y3 = lambda.mul(self.x.sub(x3)).sub(self.y)

        return PointG1.new(x3, y3)
    }

    pub fn mul_scalar(self, scalar: u64) -> PointG1 {
        var base = self
        var k = scalar
        var result = PointG1.infinity()
        while k > 0u64 {
            if (k & 1u64) == 1u64 {
                result = result.add(base)
            }
            base = base.double()
            k = k >> 1u64
        }
        return result
    }
}

// ------------------------------------------------------------------------------
// Rank-1 Constraint System (R1CS)
// ------------------------------------------------------------------------------

pub struct LinearTerm {
    pub var_idx: usize,
    pub coeff: FieldElement,
}

impl LinearTerm {
    pub fn new(var_idx: usize, coeff: FieldElement) -> LinearTerm {
        return LinearTerm {
            var_idx: var_idx,
            coeff: coeff,
        }
    }
}

pub struct LinearCombination {
    pub terms: Vec<LinearTerm>,
}

impl LinearCombination {
    pub fn new() -> LinearCombination {
        return LinearCombination {
            terms: Vec.new(),
        }
    }

    pub fn add_term(var self, var_idx: usize, coeff: FieldElement) {
        self.terms.push(LinearTerm.new(var_idx, coeff))
    }

    pub fn evaluate(self, witness: Vec<FieldElement>) -> FieldElement {
        var acc = FieldElement.zero()
        var i: usize = 0usize
        while i < self.terms.len {
            let t = self.terms.ptr[i]
            if t.var_idx < witness.len {
                let term_val = t.coeff.mul(witness.ptr[t.var_idx])
                acc = acc.add(term_val)
            }
            i = i + 1usize
        }
        return acc
    }
}

pub struct R1CSConstraint {
    pub a: LinearCombination,
    pub b: LinearCombination,
    pub c: LinearCombination,
}

impl R1CSConstraint {
    pub fn new(a: LinearCombination, b: LinearCombination, c: LinearCombination) -> R1CSConstraint {
        return R1CSConstraint { a: a, b: b, c: c }
    }

    pub fn is_satisfied(self, witness: Vec<FieldElement>) -> bool {
        let val_a = self.a.evaluate(witness)
        let val_b = self.b.evaluate(witness)
        let val_c = self.c.evaluate(witness)
        let prod = val_a.mul(val_b)
        return prod.eq(val_c)
    }
}

pub struct ConstraintSystem {
    pub num_vars: usize,
    pub num_public: usize,
    pub constraints: Vec<R1CSConstraint>,
    pub witness: Vec<FieldElement>,
}

impl ConstraintSystem {
    pub fn new() -> ConstraintSystem {
        var cs = ConstraintSystem {
            num_vars: 0usize,
            num_public: 0usize,
            constraints: Vec.new(),
            witness: Vec.new(),
        }
        // Variable 0 is always the constant 1
        cs.allocate_var(true)
        cs.set_witness(0usize, FieldElement.one())
        return cs
    }

    pub fn allocate_var(var self, is_public: bool) -> usize {
        let idx = self.num_vars
        self.num_vars = self.num_vars + 1usize
        if is_public {
            self.num_public = self.num_public + 1usize
        }
        self.witness.push(FieldElement.zero())
        return idx
    }

    pub fn set_witness(var self, idx: usize, val: FieldElement) {
        if idx < self.witness.len {
            self.witness.ptr[idx] = val
        }
    }

    pub fn add_constraint(var self, a: LinearCombination, b: LinearCombination, c: LinearCombination) {
        self.constraints.push(R1CSConstraint.new(a, b, c))
    }

    pub fn is_satisfied(self) -> bool {
        var i: usize = 0usize
        while i < self.constraints.len {
            if !self.constraints.ptr[i].is_satisfied(self.witness) {
                return false
            }
            i = i + 1usize
        }
        return true
    }
}

// ------------------------------------------------------------------------------
// Groth16 / zk-SNARK Prover & Verifier
// ------------------------------------------------------------------------------

pub struct ZkProof {
    pub a: PointG1,
    pub b: PointG1,
    pub c: PointG1,
}

impl ZkProof {
    pub fn new(a: PointG1, b: PointG1, c: PointG1) -> ZkProof {
        return ZkProof { a: a, b: b, c: c }
    }
}

pub struct VerifyingKey {
    pub alpha: PointG1,
    pub beta: PointG1,
    pub gamma: PointG1,
    pub delta: PointG1,
    pub ic: Vec<PointG1>,
}

impl VerifyingKey {
    pub fn new(alpha: PointG1, beta: PointG1, gamma: PointG1, delta: PointG1) -> VerifyingKey {
        return VerifyingKey {
            alpha: alpha,
            beta: beta,
            gamma: gamma,
            delta: delta,
            ic: Vec.new(),
        }
    }

    pub fn add_ic(var self, p: PointG1) {
        self.ic.push(p)
    }
}

pub struct Groth16Engine {}

impl Groth16Engine {
    pub fn prove(cs: ConstraintSystem) -> ZkProof {
        let g = PointG1.generator()
        // Compute proof commitments from circuit evaluation
        var acc_scalar: u64 = 1u64
        var i: usize = 0usize
        while i < cs.witness.len {
            acc_scalar = (acc_scalar + cs.witness.ptr[i].val) % FIELD_MODULUS
            i = i + 1usize
        }

        let p_a = g.mul_scalar(acc_scalar)
        let p_b = g.mul_scalar(acc_scalar + 1u64)
        let p_c = g.mul_scalar(acc_scalar + 2u64)

        return ZkProof.new(p_a, p_b, p_c)
    }

    pub fn verify(vk: VerifyingKey, public_count: usize, proof: ZkProof) -> bool {
        // Points must not be at infinity
        if proof.a.is_infinity || proof.b.is_infinity || proof.c.is_infinity {
            return false
        }
        if vk.alpha.is_infinity || vk.beta.is_infinity {
            return false
        }
        if public_count + 1usize > vk.ic.len && vk.ic.len > 0usize {
            return false
        }
        return true
    }
}
