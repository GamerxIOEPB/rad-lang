// ==============================================================================
// rad-kv: Embedded Persistent Key-Value Store for Rad
// Bitcask-style append-only log structured on-disk storage with in-memory index.
// ==============================================================================

pub struct KeyEntry {
    pub key: String,
    pub offset: i64,
    pub val_len: usize,
}

pub struct KvStore {
    pub fd: i64,
    pub path: String,
    pub entries: Vec<KeyEntry>,
}

fn kv_strlen(s: str) -> usize {
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

fn kv_streq(a: str, b: str) -> bool {
    let pa = a as *raw u8
    let pb = b as *raw u8
    var i = 0usize
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] {
            return false
        }
        i = i + 1usize
    }
    return (pa[i] == pb[i])
}

impl KvStore {
    pub fn open(path: str) -> KvStore {
        var store = KvStore {
            fd: -1i64,
            path: String.from_str(path),
            entries: Vec.new(),
        }

        // Open O_RDWR | O_CREAT (2 | 64 = 66), mode 0644 (420)
        let fd = syscall3(2i64, path as *raw u8, 66i64, 420i64)
        store.fd = fd
        if fd < 0i64 {
            return store
        }

        // Replay file to populate entries index
        // Seek to start
        let _ = syscall3(8i64, fd, 0i64, 0i64)

        var cur_pos = 0i64
        let header_buf = malloc(24usize) as *raw var u8
        var reading = true
        while reading {
            let n = syscall3(0i64, fd, header_buf, 24i64)
            if n < 24i64 {
                reading = false
            } else {
                let p = header_buf as *raw var i64
                let k_len = p[0usize] as usize
                let v_len = p[1usize] as usize
                let flags = p[2usize] as usize

                let k_buf = malloc(k_len + 1usize) as *raw var u8
                let kn = syscall3(0i64, fd, k_buf, k_len as i64)
                k_buf[k_len] = 0u8
                let key_str = String.from_str(k_buf as str)
                free(k_buf)

                let record_data_offset = cur_pos + 24i64 + (k_len as i64)
                cur_pos = record_data_offset + (v_len as i64)

                // Seek directly to next record boundary
                let _ = syscall3(8i64, fd, cur_pos, 0i64) // SEEK_SET = 0

                if flags == 1usize {
                    // Tombstone: remove from index
                    store.remove_index(key_str.as_ptr() as str)
                } else {
                    // Active: upsert into index
                    store.upsert_index(key_str, record_data_offset, v_len)
                }
            }
        }
        free(header_buf)
        return store
    }

    fn upsert_index(var self, key: String, offset: i64, val_len: usize) {
        var i = 0usize
        while i < self.entries.len {
            if kv_streq(self.entries.ptr[i].key.as_ptr() as str, key.as_ptr() as str) {
                self.entries.ptr[i].offset = offset
                self.entries.ptr[i].val_len = val_len
                return
            }
            i = i + 1usize
        }
        self.entries.push(KeyEntry {
            key: key,
            offset: offset,
            val_len: val_len,
        })
    }

    fn remove_index(var self, key: str) {
        var i = 0usize
        while i < self.entries.len {
            if kv_streq(self.entries.ptr[i].key.as_ptr() as str, key) {
                // Shift elements left
                var j = i
                while j + 1usize < self.entries.len {
                    self.entries.ptr[j] = self.entries.ptr[j + 1usize]
                    j = j + 1usize
                }
                self.entries.pop()
                return
            }
            i = i + 1usize
        }
    }

    pub fn set(var self, key: str, val: str) -> bool {
        if self.fd < 0i64 {
            return false
        }
        let k_len = kv_strlen(key)
        let v_len = kv_strlen(val)

        // Seek to end of log
        let offset = syscall3(8i64, self.fd, 0i64, 2i64) // SEEK_END = 2

        // Write header (24 bytes)
        let header = malloc(24usize) as *raw var u8
        let p = header as *raw var i64
        p[0usize] = k_len as i64
        p[1usize] = v_len as i64
        p[2usize] = 0i64 // active
        let hw = syscall3(1i64, self.fd, header, 24i64)
        free(header)
        if hw < 24i64 {
            return false
        }

        // Write key
        let kw = syscall3(1i64, self.fd, key as *raw u8, k_len as i64)
        if kw < (k_len as i64) {
            return false
        }

        // Write val
        let vw = syscall3(1i64, self.fd, val as *raw u8, v_len as i64)
        if vw < (v_len as i64) {
            return false
        }

        let val_offset = offset + 24i64 + (k_len as i64)
        self.upsert_index(String.from_str(key), val_offset, v_len)
        return true
    }

    pub fn get(self, key: str) -> Option<String> {
        if self.fd < 0i64 {
            return Option.None
        }
        var i = 0usize
        while i < self.entries.len {
            if kv_streq(self.entries.ptr[i].key.as_ptr() as str, key) {
                let off = self.entries.ptr[i].offset
                let vlen = self.entries.ptr[i].val_len

                // Seek to val_offset
                let _ = syscall3(8i64, self.fd, off, 0i64) // SEEK_SET = 0
                let buf = malloc(vlen + 1usize) as *raw var u8
                let r = syscall3(0i64, self.fd, buf, vlen as i64)
                if r == (vlen as i64) {
                    buf[vlen] = 0u8
                    let res = String.from_str(buf as str)
                    free(buf)
                    return Option.Some(res)
                }
                free(buf)
                return Option.None
            }
            i = i + 1usize
        }
        return Option.None
    }

    pub fn delete(var self, key: str) -> bool {
        if self.fd < 0i64 || !self.contains_key(key) {
            return false
        }
        let k_len = kv_strlen(key)

        // Write tombstone record
        let _ = syscall3(8i64, self.fd, 0i64, 2i64) // SEEK_END = 2
        let header = malloc(24usize) as *raw var u8
        let p = header as *raw var i64
        p[0usize] = k_len as i64
        p[1usize] = 0i64
        p[2usize] = 1i64 // tombstone flag
        let _ = syscall3(1i64, self.fd, header, 24i64)
        free(header)

        let _ = syscall3(1i64, self.fd, key as *raw u8, k_len as i64)
        self.remove_index(key)
        return true
    }

    pub fn contains_key(self, key: str) -> bool {
        var i = 0usize
        while i < self.entries.len {
            if kv_streq(self.entries.ptr[i].key.as_ptr() as str, key) {
                return true
            }
            i = i + 1usize
        }
        return false
    }

    pub fn len(self) -> usize {
        return self.entries.len
    }

    pub fn is_empty(self) -> bool {
        return (self.entries.len == 0usize)
    }

    pub fn sync(self) {
        if self.fd >= 0i64 {
            let _ = syscall1(74i64, self.fd) // SYS_fsync
        }
    }

    pub fn close(var self) {
        if self.fd >= 0i64 {
            self.sync()
            let _ = syscall1(3i64, self.fd) // SYS_close
            self.fd = -1i64
        }
    }
}
