import "../src/lib.rad";

extern "C" {
    fn unlink(path: str) -> i32;
}

fn main() -> i32 {
    let db_path = "/tmp/test_pkg_kv.db";
    let _ = unlink(db_path);

    println("1. Testing KvStore creation and writes...");
    var store = KvStore.open(db_path);
    if store.fd < 0i64 {
        println("FAIL: open kv store");
        return 1;
    }

    let ok1 = store.set("key1", "val1");
    let ok2 = store.set("key2", "val2");
    if !ok1 || !ok2 {
        println("FAIL: set keys");
        return 1;
    }
    if store.len() != 2usize {
        println("FAIL: expected 2 keys");
        return 1;
    }

    println("2. Testing KvStore reads...");
    let v1 = store.get("key1");
    match v1 {
        Option.Some(s) => {
            if !kv_streq(s.as_ptr() as str, "val1") {
                println("FAIL: val1 mismatch");
                return 1;
            }
        },
        Option.None => {
            println("FAIL: key1 not found");
            return 1;
        },
    }

    println("3. Testing KvStore deletes...");
    let del_ok = store.delete("key1");
    if !del_ok || store.contains_key("key1") {
        println("FAIL: delete key1");
        return 1;
    }
    if store.len() != 1usize {
        println("FAIL: expected 1 key after delete");
        return 1;
    }
    store.close();

    println("4. Testing KvStore persistence reopen...");
    var store2 = KvStore.open(db_path);
    if store2.len() != 1usize {
        println("FAIL: expected 1 key on reopen");
        return 1;
    }
    let v2 = store2.get("key2");
    match v2 {
        Option.Some(s) => {
            if !kv_streq(s.as_ptr() as str, "val2") {
                println("FAIL: val2 mismatch on reopen");
                return 1;
            }
        },
        Option.None => {
            println("FAIL: key2 not found on reopen");
            return 1;
        },
    }
    store2.close();
    let _ = unlink(db_path);

    println("[PASS] rad-kv test suite succeeded!");
    return 0;
}
