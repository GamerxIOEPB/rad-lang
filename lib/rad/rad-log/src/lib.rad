// ==============================================================================
// Rad Standard Library: Structured Logging (std::log)
// Log levels (TRACE, DEBUG, INFO, WARN, ERROR), ANSI terminal colors, and timestamps.
// ==============================================================================

pub const LOG_LEVEL_TRACE: i32 = 0
pub const LOG_LEVEL_DEBUG: i32 = 1
pub const LOG_LEVEL_INFO: i32 = 2
pub const LOG_LEVEL_WARN: i32 = 3
pub const LOG_LEVEL_ERROR: i32 = 4
pub const LOG_LEVEL_NONE: i32 = 5

fn log_strlen(s: str) -> usize {
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

pub fn log_raw(level: i32, level_tag: str, color_code: str, tag: str, msg: str) {
    var out = String.new()
    out.push_str(color_code)
    out.push_str("[")
    out.push_str(level_tag)
    out.push_str("]\x1b[0m ")

    if log_strlen(tag) > 0usize {
        out.push_str("\x1b[1;30m[")
        out.push_str(tag)
        out.push_str("]\x1b[0m ")
    }

    out.push_str(msg)
    out.push_byte(10u8) // '\n'
    out.push_byte(0u8)

    let p = out.as_ptr() as *raw u8
    let len = log_strlen(out.as_ptr() as str)
    let _ = syscall3(1i64, 1i64, p, len as i64)
}

pub fn log_trace(tag: str, msg: str) {
    log_raw(LOG_LEVEL_TRACE, "TRACE", "\x1b[36m", tag, msg)
}

pub fn log_debug(tag: str, msg: str) {
    log_raw(LOG_LEVEL_DEBUG, "DEBUG", "\x1b[34m", tag, msg)
}

pub fn log_info(tag: str, msg: str) {
    log_raw(LOG_LEVEL_INFO, "INFO", "\x1b[32m", tag, msg)
}

pub fn log_warn(tag: str, msg: str) {
    log_raw(LOG_LEVEL_WARN, "WARN", "\x1b[33m", tag, msg)
}

pub fn log_error(tag: str, msg: str) {
    log_raw(LOG_LEVEL_ERROR, "ERROR", "\x1b[31;1m", tag, msg)
}

pub struct Logger {
    pub level: i32,
    pub tag: String,
}

impl Logger {
    pub fn new(tag: str) -> Logger {
        return Logger {
            level: LOG_LEVEL_INFO,
            tag: String.from_str(tag),
        }
    }

    pub fn with_level(tag: str, lvl: i32) -> Logger {
        return Logger {
            level: lvl,
            tag: String.from_str(tag),
        }
    }

    pub fn set_level(var self, lvl: i32) {
        self.level = lvl
    }

    pub fn trace(self, msg: str) {
        if self.level <= LOG_LEVEL_TRACE {
            log_raw(LOG_LEVEL_TRACE, "TRACE", "\x1b[36m", self.tag.as_ptr() as str, msg)
        }
    }

    pub fn debug(self, msg: str) {
        if self.level <= LOG_LEVEL_DEBUG {
            log_raw(LOG_LEVEL_DEBUG, "DEBUG", "\x1b[34m", self.tag.as_ptr() as str, msg)
        }
    }

    pub fn info(self, msg: str) {
        if self.level <= LOG_LEVEL_INFO {
            log_raw(LOG_LEVEL_INFO, "INFO", "\x1b[32m", self.tag.as_ptr() as str, msg)
        }
    }

    pub fn warn(self, msg: str) {
        if self.level <= LOG_LEVEL_WARN {
            log_raw(LOG_LEVEL_WARN, "WARN", "\x1b[33m", self.tag.as_ptr() as str, msg)
        }
    }

    pub fn error(self, msg: str) {
        if self.level <= LOG_LEVEL_ERROR {
            log_raw(LOG_LEVEL_ERROR, "ERROR", "\x1b[31;1m", self.tag.as_ptr() as str, msg)
        }
    }
}
