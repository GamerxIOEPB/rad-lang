// ==============================================================================
// rad-toml — Pure-Rad TOML Parser, DOM Document Tree, and Serializer
// Zero C, zero libc, zero external dependencies.
// ==============================================================================

pub const TOML_STRING: i32  = 1
pub const TOML_INTEGER: i32 = 2
pub const TOML_FLOAT: i32   = 3
pub const TOML_BOOL: i32    = 4
pub const TOML_ARRAY: i32   = 5
pub const TOML_TABLE: i32   = 6

pub struct TomlMember {
    pub key: String,
    pub val: TomlValue,
}

pub struct TomlValue {
    pub kind: i32,
    pub str_val: String,
    pub int_val: i64,
    pub float_val: f64,
    pub bool_val: bool,
    pub arr_val: Vec<TomlValue>,
    pub table_val: Vec<TomlMember>,
}

pub fn str_len(s: str) -> usize {
    if (s as usize) == 0usize { return 0usize }
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

pub fn str_eq(a: str, b: str) -> bool {
    let pa = a as *raw u8
    let pb = b as *raw u8
    if (a as usize) == (b as usize) { return true }
    if (a as usize) == 0usize || (b as usize) == 0usize { return false }
    var i = 0usize
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] { return false }
        i = i + 1usize
    }
    return pa[i] == pb[i]
}

pub fn str_starts_with(s: str, prefix: str) -> bool {
    let slen = str_len(s)
    let plen = str_len(prefix)
    if plen > slen { return false }
    let ps = s as *raw u8
    let pp = prefix as *raw u8
    var i = 0usize
    while i < plen {
        if ps[i] != pp[i] { return false }
        i = i + 1usize
    }
    return true
}

pub fn str_ends_with(s: str, suffix: str) -> bool {
    let s_len = str_len(s)
    let suf_len = str_len(suffix)
    if s_len < suf_len || s_len == 0usize { return false }
    let ps = s as *raw u8
    let p_suf = suffix as *raw u8
    let start = s_len - suf_len
    var i = 0usize
    while i < suf_len {
        if ps[start + i] != p_suf[i] { return false }
        i = i + 1usize
    }
    return true
}

pub fn parse_toml(content: str) -> TomlValue {
    return TomlValue.parse(content)
}

pub fn str_contains(haystack: str, needle: str) -> bool {
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0usize { return true }
    if nlen > hlen { return false }
    let ph = haystack as *raw u8
    let pn = needle as *raw u8
    var i = 0usize
    while i + nlen <= hlen {
        var match_ok = true
        var j = 0usize
        while j < nlen {
            if ph[i + j] != pn[j] {
                match_ok = false
                break
            }
            j = j + 1usize
        }
        if match_ok { return true }
        i = i + 1usize
    }
    return false
}

fn toml_str_eq(a: str, b: str) -> bool {
    return str_eq(a, b)
}

impl TomlValue {
    pub fn string(s: str) -> TomlValue {
        return TomlValue {
            kind: TOML_STRING,
            str_val: String.from_str(s),
            int_val: 0i64,
            float_val: 0.0,
            bool_val: false,
            arr_val: Vec.new(),
            table_val: Vec.new(),
        }
    }

    pub fn integer(i: i64) -> TomlValue {
        return TomlValue {
            kind: TOML_INTEGER,
            str_val: String.new(),
            int_val: i,
            float_val: 0.0,
            bool_val: false,
            arr_val: Vec.new(),
            table_val: Vec.new(),
        }
    }

    pub fn float(f: f64) -> TomlValue {
        return TomlValue {
            kind: TOML_FLOAT,
            str_val: String.new(),
            int_val: 0i64,
            float_val: f,
            bool_val: false,
            arr_val: Vec.new(),
            table_val: Vec.new(),
        }
    }

    pub fn bool(b: bool) -> TomlValue {
        return TomlValue {
            kind: TOML_BOOL,
            str_val: String.new(),
            int_val: 0i64,
            float_val: 0.0,
            bool_val: b,
            arr_val: Vec.new(),
            table_val: Vec.new(),
        }
    }

    pub fn array() -> TomlValue {
        return TomlValue {
            kind: TOML_ARRAY,
            str_val: String.new(),
            int_val: 0i64,
            float_val: 0.0,
            bool_val: false,
            arr_val: Vec.new(),
            table_val: Vec.new(),
        }
    }

    pub fn table() -> TomlValue {
        return TomlValue {
            kind: TOML_TABLE,
            str_val: String.new(),
            int_val: 0i64,
            float_val: 0.0,
            bool_val: false,
            arr_val: Vec.new(),
            table_val: Vec.new(),
        }
    }

    pub fn is_string(self) -> bool {
        return self.kind == TOML_STRING
    }

    pub fn is_integer(self) -> bool {
        return self.kind == TOML_INTEGER
    }

    pub fn is_float(self) -> bool {
        return self.kind == TOML_FLOAT
    }

    pub fn is_bool(self) -> bool {
        return self.kind == TOML_BOOL
    }

    pub fn is_array(self) -> bool {
        return self.kind == TOML_ARRAY
    }

    pub fn is_table(self) -> bool {
        return self.kind == TOML_TABLE
    }

    pub fn as_str(self) -> str {
        if self.kind == TOML_STRING {
            return self.str_val.as_ptr() as str
        }
        return ""
    }

    pub fn as_int(self) -> i64 {
        if self.kind == TOML_INTEGER {
            return self.int_val
        } else if self.kind == TOML_FLOAT {
            return self.float_val as i64
        }
        return 0i64
    }

    pub fn as_float(self) -> f64 {
        if self.kind == TOML_FLOAT {
            return self.float_val
        } else if self.kind == TOML_INTEGER {
            return self.int_val as f64
        }
        return 0.0
    }

    pub fn as_bool(self) -> bool {
        return self.bool_val
    }

    pub fn add(var self, val: TomlValue) {
        if self.kind == TOML_ARRAY {
            self.arr_val.push(val)
        }
    }

    pub fn set(var self, key: str, val: TomlValue) {
        if self.kind != TOML_TABLE {
            return
        }
        var i = 0usize
        while i < self.table_val.len {
            if toml_str_eq(self.table_val.ptr[i].key.as_ptr() as str, key) {
                self.table_val.ptr[i].val = val
                return
            }
            i = i + 1usize
        }
        self.table_val.push(TomlMember {
            key: String.from_str(key),
            val: val,
        })
    }

    pub fn get(self, path: str) -> Option<TomlValue> {
        if self.kind != TOML_TABLE {
            return Option.None
        }
        let p_len = str_len(path)
        let p = path as *raw u8
        var dot_pos = p_len
        var i = 0usize
        while i < p_len {
            if p[i] == 46u8 { // '.'
                dot_pos = i
                break
            }
            i = i + 1usize
        }

        var head = String.new()
        var j = 0usize
        while j < dot_pos {
            head.push_byte(p[j])
            j = j + 1usize
        }

        let head_str = head.as_ptr() as str
        var found_idx = 0usize
        var found = false
        var k = 0usize
        while k < self.table_val.len {
            if toml_str_eq(self.table_val.ptr[k].key.as_ptr() as str, head_str) {
                found_idx = k
                found = true
                break
            }
            k = k + 1usize
        }

        if !found {
            return Option.None
        }

        let curr_val = self.table_val.ptr[found_idx].val
        if dot_pos >= p_len {
            return Option.Some(curr_val)
        } else {
            let tail_str = (path as usize + dot_pos + 1usize) as str
            return curr_val.get(tail_str)
        }
    }

    pub fn get_str(self, path: str) -> str {
        let opt = self.get(path)
        match opt {
            Option.Some(v) => return v.as_str(),
            _ => return "",
        }
    }

    pub fn get_int(self, path: str) -> i64 {
        let opt = self.get(path)
        match opt {
            Option.Some(v) => return v.as_int(),
            _ => return 0i64,
        }
    }

    pub fn get_bool(self, path: str) -> bool {
        let opt = self.get(path)
        match opt {
            Option.Some(v) => return v.as_bool(),
            _ => return false,
        }
    }

    pub fn get_table(self, path: str) -> Option<TomlValue> {
        let opt = self.get(path)
        match opt {
            Option.Some(v) => {
                if v.kind == TOML_TABLE {
                    return Option.Some(v)
                }
                return Option.None
            },
            _ => return Option.None,
        }
    }

    pub fn get_array(self, path: str) -> Option<Vec<TomlValue> > {
        let opt = self.get(path)
        match opt {
            Option.Some(v) => {
                if v.kind == TOML_ARRAY {
                    return Option.Some(v.arr_val)
                }
                return Option.None
            },
            _ => return Option.None,
        }
    }

    // =========================================================================
    // Parser Entry Point
    // =========================================================================
    pub fn parse(content: str) -> TomlValue {
        var root = TomlValue.table()
        var cur_section = String.new()

        let len = str_len(content)
        let p = content as *raw u8
        var i = 0usize

        while i < len {
            // Skip leading whitespace on line
            while i < len && (p[i] == 32u8 || p[i] == 9u8 || p[i] == 13u8) {
                i = i + 1usize
            }
            if i >= len { break }

            // Empty line
            if p[i] == 10u8 {
                i = i + 1usize
                continue
            }

            // Comment line
            if p[i] == 35u8 { // '#'
                while i < len && p[i] != 10u8 {
                    i = i + 1usize
                }
                if i < len { i = i + 1usize }
                continue
            }

            // Section Header: [section] or [section.sub]
            if p[i] == 91u8 { // '['
                i = i + 1usize
                while i < len && (p[i] == 32u8 || p[i] == 9u8) { i = i + 1usize }
                var sec_name = String.new()
                while i < len && p[i] != 93u8 && p[i] != 10u8 {
                    if p[i] != 32u8 && p[i] != 9u8 {
                        sec_name.push_byte(p[i])
                    }
                    i = i + 1usize
                }
                if i < len && p[i] == 93u8 { i = i + 1usize }
                while i < len && p[i] != 10u8 { i = i + 1usize }
                if i < len { i = i + 1usize }

                cur_section = sec_name
                // Ensure section table exists in root
                let sec_check = root.get(cur_section.as_ptr() as str)
                match sec_check {
                    Option.None => {
                        root.ensure_table_path(cur_section.as_ptr() as str)
                    },
                    _ => {},
                }
                continue
            }

            // Key-Value Pair: key = value
            var key_buf = String.new()
            while i < len && p[i] != 61u8 && p[i] != 10u8 && p[i] != 35u8 {
                let b = p[i]
                if b != 32u8 && b != 9u8 {
                    key_buf.push_byte(b)
                }
                i = i + 1usize
            }

            if i < len && p[i] == 61u8 {
                i = i + 1usize // Skip '='
                while i < len && (p[i] == 32u8 || p[i] == 9u8) { i = i + 1usize }

                // Parse Value
                let val_res = parse_toml_value_at(p, len, i)
                i = val_res.next_pos

                // Skip remainder of line / comment
                while i < len && p[i] != 10u8 {
                    i = i + 1usize
                }
                if i < len { i = i + 1usize }

                let k_str = key_buf.as_ptr() as str
                if cur_section.len() == 0usize {
                    root.set(k_str, val_res.val)
                } else {
                    root.set_in_section(cur_section.as_ptr() as str, k_str, val_res.val)
                }
            } else {
                // Skip invalid line
                while i < len && p[i] != 10u8 {
                    i = i + 1usize
                }
                if i < len { i = i + 1usize }
            }
        }

        return root
    }

    fn ensure_table_path(var self, path: str) {
        if self.kind != TOML_TABLE { return }
        let p_len = str_len(path)
        let p = path as *raw u8
        var dot_pos = p_len
        var i = 0usize
        while i < p_len {
            if p[i] == 46u8 {
                dot_pos = i
                break
            }
            i = i + 1usize
        }

        var head = String.new()
        var j = 0usize
        while j < dot_pos {
            head.push_byte(p[j])
            j = j + 1usize
        }
        let head_str = head.as_ptr() as str

        var found = false
        var k = 0usize
        while k < self.table_val.len {
            if toml_str_eq(self.table_val.ptr[k].key.as_ptr() as str, head_str) {
                found = true
                if dot_pos < p_len {
                    let tail_str = (path as usize + dot_pos + 1usize) as str
                    self.table_val.ptr[k].val.ensure_table_path(tail_str)
                }
                return
            }
            k = k + 1usize
        }

        if !found {
            var new_tbl = TomlValue.table()
            if dot_pos < p_len {
                let tail_str = (path as usize + dot_pos + 1usize) as str
                new_tbl.ensure_table_path(tail_str)
            }
            self.set(head_str, new_tbl)
        }
    }

    fn set_in_section(var self, section: str, key: str, val: TomlValue) {
        self.ensure_table_path(section)
        let s_len = str_len(section)
        let p = section as *raw u8
        var dot_pos = s_len
        var i = 0usize
        while i < s_len {
            if p[i] == 46u8 {
                dot_pos = i
                break
            }
            i = i + 1usize
        }

        var head = String.new()
        var j = 0usize
        while j < dot_pos {
            head.push_byte(p[j])
            j = j + 1usize
        }
        let head_str = head.as_ptr() as str

        var k = 0usize
        while k < self.table_val.len {
            if toml_str_eq(self.table_val.ptr[k].key.as_ptr() as str, head_str) {
                if dot_pos < s_len {
                    let tail_str = (section as usize + dot_pos + 1usize) as str
                    self.table_val.ptr[k].val.set_in_section(tail_str, key, val)
                } else {
                    self.table_val.ptr[k].val.set(key, val)
                }
                return
            }
            k = k + 1usize
        }
    }

    // =========================================================================
    // Serializer (to_string)
    // =========================================================================
    pub fn to_string(self) -> String {
        var out = String.new()
        if self.kind != TOML_TABLE {
            return out
        }

        // 1. Top-level scalar and array keys
        var i = 0usize
        while i < self.table_val.len {
            let m = self.table_val.ptr[i]
            if m.val.kind != TOML_TABLE {
                out.push_str(m.key.as_ptr() as str)
                out.push_str(" = ")
                out.push_str(serialize_toml_value(m.val).as_ptr() as str)
                out.push_byte(10u8)
            }
            i = i + 1usize
        }

        // 2. Sections
        i = 0usize
        while i < self.table_val.len {
            let m = self.table_val.ptr[i]
            if m.val.kind == TOML_TABLE {
                if out.len() > 0usize {
                    out.push_byte(10u8)
                }
                out.push_byte(91u8) // '['
                out.push_str(m.key.as_ptr() as str)
                out.push_byte(93u8) // ']'
                out.push_byte(10u8)

                var j = 0usize
                while j < m.val.table_val.len {
                    let sub_m = m.val.table_val.ptr[j]
                    if sub_m.val.kind != TOML_TABLE {
                        out.push_str(sub_m.key.as_ptr() as str)
                        out.push_str(" = ")
                        out.push_str(serialize_toml_value(sub_m.val).as_ptr() as str)
                        out.push_byte(10u8)
                    }
                    j = j + 1usize
                }
            }
            i = i + 1usize
        }

        return out
    }
}

struct ParseValResult {
    val: TomlValue,
    next_pos: usize,
}

fn parse_toml_value_at(p: *raw u8, len: usize, start: usize) -> ParseValResult {
    var i = start
    while i < len && (p[i] == 32u8 || p[i] == 9u8) {
        i = i + 1usize
    }

    if i >= len {
        return ParseValResult { val: TomlValue.string(""), next_pos: len }
    }

    // String: "..." or '...'
    if p[i] == 34u8 || p[i] == 39u8 {
        let quote = p[i]
        i = i + 1usize
        var str_buf = String.new()
        while i < len && p[i] != quote && p[i] != 10u8 {
            if p[i] == 92u8 && i + 1usize < len && quote == 34u8 { // '\\' escape
                i = i + 1usize
                let esc = p[i]
                if esc == 110u8 {
                    str_buf.push_byte(10u8)
                } else if esc == 116u8 {
                    str_buf.push_byte(9u8)
                } else if esc == 114u8 {
                    str_buf.push_byte(13u8)
                } else if esc == 34u8 {
                    str_buf.push_byte(34u8)
                } else if esc == 92u8 {
                    str_buf.push_byte(92u8)
                } else {
                    str_buf.push_byte(esc)
                }
            } else {
                str_buf.push_byte(p[i])
            }
            i = i + 1usize
        }
        if i < len && p[i] == quote { i = i + 1usize }
        return ParseValResult {
            val: TomlValue.string(str_buf.as_ptr() as str),
            next_pos: i,
        }
    }

    // Array: [...]
    if p[i] == 91u8 { // '['
        i = i + 1usize
        var arr = TomlValue.array()
        while i < len && p[i] != 93u8 {
            while i < len && (p[i] == 32u8 || p[i] == 9u8 || p[i] == 10u8 || p[i] == 13u8 || p[i] == 44u8) {
                i = i + 1usize
            }
            if i >= len || p[i] == 93u8 { break }
            let item_res = parse_toml_value_at(p, len, i)
            arr.add(item_res.val)
            i = item_res.next_pos
            while i < len && (p[i] == 32u8 || p[i] == 9u8) { i = i + 1usize }
            if i < len && p[i] == 44u8 { i = i + 1usize }
        }
        if i < len && p[i] == 93u8 { i = i + 1usize }
        return ParseValResult { val: arr, next_pos: i }
    }

    // Inline Table: { k = v, ... }
    if p[i] == 123u8 { // '{'
        i = i + 1usize
        var tbl = TomlValue.table()
        while i < len && p[i] != 125u8 {
            while i < len && (p[i] == 32u8 || p[i] == 9u8 || p[i] == 44u8) { i = i + 1usize }
            if i >= len || p[i] == 125u8 { break }
            var k_buf = String.new()
            while i < len && p[i] != 61u8 && p[i] != 125u8 && p[i] != 10u8 {
                if p[i] != 32u8 && p[i] != 9u8 { k_buf.push_byte(p[i]) }
                i = i + 1usize
            }
            if i < len && p[i] == 61u8 {
                i = i + 1usize
                while i < len && (p[i] == 32u8 || p[i] == 9u8) { i = i + 1usize }
                let v_res = parse_toml_value_at(p, len, i)
                tbl.set(k_buf.as_ptr() as str, v_res.val)
                i = v_res.next_pos
                while i < len && (p[i] == 32u8 || p[i] == 9u8) { i = i + 1usize }
                if i < len && p[i] == 44u8 { i = i + 1usize }
            }
        }
        if i < len && p[i] == 125u8 { i = i + 1usize }
        return ParseValResult { val: tbl, next_pos: i }
    }

    // Boolean or Number
    var tok = String.new()
    while i < len && p[i] != 10u8 && p[i] != 13u8 && p[i] != 35u8 && p[i] != 44u8 && p[i] != 93u8 && p[i] != 125u8 && p[i] != 32u8 && p[i] != 9u8 {
        tok.push_byte(p[i])
        i = i + 1usize
    }

    let t_str = tok.as_ptr() as str
    if toml_str_eq(t_str, "true") {
        return ParseValResult { val: TomlValue.bool(true), next_pos: i }
    }
    if toml_str_eq(t_str, "false") {
        return ParseValResult { val: TomlValue.bool(false), next_pos: i }
    }

    // Number check: hex (0x...), binary (0b...), float (.), int
    if str_starts_with(t_str, "0x") || str_starts_with(t_str, "0X") {
        let hex_val = parse_hex_str((t_str as usize + 2usize) as str)
        return ParseValResult { val: TomlValue.integer(hex_val), next_pos: i }
    }
    if str_starts_with(t_str, "0b") || str_starts_with(t_str, "0B") {
        let bin_val = parse_bin_str((t_str as usize + 2usize) as str)
        return ParseValResult { val: TomlValue.integer(bin_val), next_pos: i }
    }
    if str_contains(t_str, ".") {
        let f_val = parse_float_str(t_str)
        return ParseValResult { val: TomlValue.float(f_val), next_pos: i }
    }

    let int_val = parse_int_str(t_str)
    return ParseValResult { val: TomlValue.integer(int_val), next_pos: i }
}

fn serialize_toml_value(val: TomlValue) -> String {
    var s = String.new()
    if val.kind == TOML_STRING {
        s.push_byte(34u8) // '"'
        let p = val.str_val.as_ptr() as *raw u8
        var i = 0usize
        let len = val.str_val.len()
        while i < len {
            if p[i] == 34u8 {
                s.push_byte(92u8) // '\\'
                s.push_byte(34u8)
            } else if p[i] == 92u8 {
                s.push_byte(92u8)
                s.push_byte(92u8)
            } else if p[i] == 10u8 {
                s.push_byte(92u8)
                s.push_byte(110u8)
            } else {
                s.push_byte(p[i])
            }
            i = i + 1usize
        }
        s.push_byte(34u8)
    } else if val.kind == TOML_INTEGER {
        s.push_str(toml_int_to_str(val.int_val).as_ptr() as str)
    } else if val.kind == TOML_FLOAT {
        let ip = val.float_val as i64
        s.push_str(toml_int_to_str(ip).as_ptr() as str)
        s.push_byte(46u8)
        var frac = val.float_val - (ip as f64)
        if frac < 0.0 { frac = -frac }
        let frac_i = (frac * 1000.0) as i64
        s.push_str(toml_int_to_str(frac_i).as_ptr() as str)
    } else if val.kind == TOML_BOOL {
        if val.bool_val {
            s.push_str("true")
        } else {
            s.push_str("false")
        }
    } else if val.kind == TOML_ARRAY {
        s.push_byte(91u8) // '['
        var i = 0usize
        while i < val.arr_val.len {
            if i > 0usize { s.push_str(", ") }
            s.push_str(serialize_toml_value(val.arr_val.ptr[i]).as_ptr() as str)
            i = i + 1usize
        }
        s.push_byte(93u8) // ']'
    } else if val.kind == TOML_TABLE {
        s.push_str("{ ")
        var i = 0usize
        while i < val.table_val.len {
            if i > 0usize { s.push_str(", ") }
            s.push_str(val.table_val.ptr[i].key.as_ptr() as str)
            s.push_str(" = ")
            s.push_str(serialize_toml_value(val.table_val.ptr[i].val).as_ptr() as str)
            i = i + 1usize
        }
        s.push_str(" }")
    }
    return s
}

fn toml_int_to_str(val: i64) -> String {
    if val == 0i64 { return String.from_str("0") }
    var v = val
    var is_neg = false
    if v < 0i64 {
        is_neg = true
        v = -v
    }
    var rev = String.new()
    while v > 0i64 {
        let digit = (v % 10i64) as u8
        rev.push_byte(48u8 + digit)
        v = v / 10i64
    }
    if is_neg { rev.push_byte(45u8) }
    var res = String.new()
    var len = rev.len()
    let p = rev.as_ptr()
    while len > 0usize {
        len = len - 1usize
        res.push_byte(p[len])
    }
    return res
}

fn parse_int_str(s: str) -> i64 {
    let p = s as *raw u8
    let len = str_len(s)
    var i = 0usize
    var is_neg = false
    if i < len && p[i] == 45u8 {
        is_neg = true
        i = i + 1usize
    } else if i < len && p[i] == 43u8 {
        i = i + 1usize
    }
    var res = 0i64
    while i < len {
        let c = p[i]
        if c >= 48u8 && c <= 57u8 {
            res = (res * 10i64) + ((c - 48u8) as i64)
        } else {
            break
        }
        i = i + 1usize
    }
    if is_neg { return -res }
    return res
}

fn parse_hex_str(s: str) -> i64 {
    let p = s as *raw u8
    let len = str_len(s)
    var res = 0i64
    var i = 0usize
    while i < len {
        let c = p[i]
        var digit = 0i64
        if c >= 48u8 && c <= 57u8 {
            digit = (c - 48u8) as i64
        } else if c >= 65u8 && c <= 70u8 {
            digit = (c - 65u8 + 10u8) as i64
        } else if c >= 97u8 && c <= 102u8 {
            digit = (c - 97u8 + 10u8) as i64
        } else {
            break
        }
        res = (res * 16i64) + digit
        i = i + 1usize
    }
    return res
}

fn parse_bin_str(s: str) -> i64 {
    let p = s as *raw u8
    let len = str_len(s)
    var res = 0i64
    var i = 0usize
    while i < len {
        let c = p[i]
        if c == 48u8 {
            res = res * 2i64
        } else if c == 49u8 {
            res = (res * 2i64) + 1i64
        } else {
            break
        }
        i = i + 1usize
    }
    return res
}

fn parse_float_str(s: str) -> f64 {
    let p = s as *raw u8
    let len = str_len(s)
    var i = 0usize
    var is_neg = false
    if i < len && p[i] == 45u8 {
        is_neg = true
        i = i + 1usize
    }
    var whole = 0.0
    while i < len && p[i] >= 48u8 && p[i] <= 57u8 {
        whole = (whole * 10.0) + ((p[i] - 48u8) as f64)
        i = i + 1usize
    }
    var frac = 0.0
    if i < len && p[i] == 46u8 {
        i = i + 1usize
        var div = 10.0
        while i < len && p[i] >= 48u8 && p[i] <= 57u8 {
            frac = frac + (((p[i] - 48u8) as f64) / div)
            div = div * 10.0
            i = i + 1usize
        }
    }
    let total = whole + frac
    if is_neg { return -total }
    return total
}
