// Rad Core Library: Result<T, E>

import option;

pub struct Result<T, E> {
    tag: i64,
    val: i64,
}

impl Result<T, E> {
    pub fn Ok(val: T) -> Result<T, E> {
        return Result { tag: 1i64, val: val as i64 };
    }

    pub fn Err(err: E) -> Result<T, E> {
        return Result { tag: 0i64, val: err as i64 };
    }

    pub fn is_ok(res: Result<T, E>) -> bool {
        return res.tag == 1i64;
    }

    pub fn is_err(res: Result<T, E>) -> bool {
        return res.tag == 0i64;
    }

    pub fn unwrap_or(res: Result<T, E>, default_val: T) -> T {
        if res.tag == 1i64 {
            return res.val as T;
        }
        return default_val;
    }

    pub fn unwrap(res: Result<T, E>) -> T {
        if res.tag == 1i64 {
            return res.val as T;
        }
        panic("called Result.unwrap() on an Err value");
        return res.val as T;
    }

    pub fn expect(res: Result<T, E>, msg: str) -> T {
        if res.tag == 1i64 {
            return res.val as T;
        }
        panic(msg);
        return res.val as T;
    }

    pub fn unwrap_err(res: Result<T, E>) -> E {
        if res.tag == 0i64 {
            return res.val as E;
        }
        panic("called Result.unwrap_err() on an Ok value");
        return res.val as E;
    }

    pub fn ok(res: Result<T, E>) -> Option<T> {
        if res.tag == 1i64 {
            return Option.Some(res.val as T);
        }
        return Option.None;
    }

    pub fn err(res: Result<T, E>) -> Option<E> {
        if res.tag == 0i64 {
            return Option.Some(res.val as E);
        }
        return Option.None;
    }

    pub fn map<U>(res: Result<T, E>, f: fn(T) -> U) -> Result<U, E> {
        if res.tag == 1i64 {
            return Result.Ok(f(res.val as T));
        }
        return Result.Err(res.val as E);
    }

    pub fn map_err<F>(res: Result<T, E>, f: fn(E) -> F) -> Result<T, F> {
        if res.tag == 0i64 {
            return Result.Err(f(res.val as E));
        }
        return Result.Ok(res.val as T);
    }

    pub fn and_then<U>(res: Result<T, E>, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        if res.tag == 1i64 {
            return f(res.val as T);
        }
        return Result.Err(res.val as E);
    }

    pub fn unwrap_or_else(res: Result<T, E>, f: fn(E) -> T) -> T {
        if res.tag == 1i64 {
            return res.val as T;
        }
        return f(res.val as E);
    }
}


impl<T, E> Result<T, E> {
    pub fn contains(res: Result<T, E>, target: T) -> bool {
        if res.is_ok() {
            return res.unwrap() == target
        }
        return false
    }

    pub fn or_else<F>(res: Result<T, E>, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        if res.is_ok() {
            return Result.Ok(res.unwrap())
        }
        return f(res.unwrap_err())
    }
}
