// Rad Core Library: Option<T>

import result;

pub enum Option<T> {
    None,
    Some(T),
}

impl Option<T> {
    pub fn is_some(opt: Option<T>) -> bool {
        match opt {
            Option.Some(_) => { return true; },
            Option.None => { return false; },
        }
    }

    pub fn is_none(opt: Option<T>) -> bool {
        match opt {
            Option.Some(_) => { return false; },
            Option.None => { return true; },
        }
    }

    pub fn unwrap_or(opt: Option<T>, default_val: T) -> T {
        match opt {
            Option.Some(val) => { return val; },
            Option.None => { return default_val; },
        }
    }

    pub fn unwrap(opt: Option<T>) -> T {
        match opt {
            Option.Some(val) => { return val; },
            Option.None => {
                panic("called Option.unwrap() on a None value");
                return opt;
            },
        }
    }

    pub fn expect(opt: Option<T>, msg: str) -> T {
        match opt {
            Option.Some(val) => { return val; },
            Option.None => {
                panic(msg);
                return opt;
            },
        }
    }

    pub fn ok_or<E>(opt: Option<T>, err: E) -> Result<T, E> {
        match opt {
            Option.Some(val) => { return Result.Ok(val); },
            Option.None => { return Result.Err(err); },
        }
    }

    pub fn map<U>(opt: Option<T>, f: fn(T) -> U) -> Option<U> {
        match opt {
            Option.Some(val) => { return Option.Some(f(val)); },
            Option.None => { return Option.None; },
        }
    }

    pub fn and_then<U>(opt: Option<T>, f: fn(T) -> Option<U>) -> Option<U> {
        match opt {
            Option.Some(val) => { return f(val); },
            Option.None => { return Option.None; },
        }
    }

    pub fn unwrap_or_else(opt: Option<T>, f: fn() -> T) -> T {
        match opt {
            Option.Some(val) => { return val; },
            Option.None => { return f(); },
        }
    }
}
