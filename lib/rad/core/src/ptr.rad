// ==============================================================================
// core/src/ptr.rad — Raw pointer operations (backed by codegen intrinsics)
// ==============================================================================

pub fn null<T>() -> *raw const T;
pub fn null_var<T>() -> *raw var T;
pub fn is_null<T>(p: *raw const T) -> bool;
pub fn ptr_read<T>(p: *raw const T) -> T;
pub fn ptr_write<T>(p: *raw var T, val: T);
pub fn read_volatile<T>(p: *raw const T) -> T;
pub fn write_volatile<T>(p: *raw var T, val: T);
pub fn offset<T>(p: *raw const T, count: isize) -> *raw const T;
pub fn offset_var<T>(p: *raw var T, count: isize) -> *raw var T;
