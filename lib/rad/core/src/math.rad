// ==============================================================================
// core/src/math.rad — Core integer math & bit-manipulation primitives
// ==============================================================================

pub fn min(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

pub fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

pub fn abs(x: i64) -> i64 {
    if x < 0i64 {
        return -x
    }
    return x
}

pub fn clamp(val: i64, min_val: i64, max_val: i64) -> i64 {
    if val < min_val {
        return min_val
    }
    if val > max_val {
        return max_val
    }
    return val
}

pub fn sign(x: i64) -> i64 {
    if x > 0i64 { return 1i64 }
    if x < 0i64 { return -1i64 }
    return 0i64
}

pub fn gcd(a_in: i64, b_in: i64) -> i64 {
    var a = abs(a_in)
    var b = abs(b_in)
    while b != 0i64 {
        let t = a % b
        a = b
        b = t
    }
    return a
}

pub fn lcm(a: i64, b: i64) -> i64 {
    if a == 0i64 || b == 0i64 {
        return 0i64
    }
    let g = gcd(a, b)
    return abs((a / g) * b)
}

pub fn pow_i64(base: i64, exp: u64) -> i64 {
    var b = base
    var e = exp
    var res = 1i64
    while e > 0u64 {
        if (e & 1u64) == 1u64 {
            res = res * b
        }
        b = b * b
        e = e >> 1u64
    }
    return res
}

pub fn isqrt(n: i64) -> i64 {
    if n <= 0i64 { return 0i64 }
    if n < 4i64 { return 1i64 }
    var x = n
    var y = (x + 1i64) / 2i64
    while y < x {
        x = y
        y = (x + n / x) / 2i64
    }
    return x
}

pub fn is_power_of_two(n: i64) -> bool {
    if n <= 0i64 { return false }
    return (n & (n - 1i64)) == 0i64
}

pub fn next_power_of_two(n: i64) -> i64 {
    if n <= 1i64 { return 1i64 }
    var p = 1i64
    while p < n {
        p = p * 2i64
    }
    return p
}

pub fn div_ceil(a: i64, b: i64) -> i64 {
    if b <= 0i64 { return 0i64 }
    return (a + b - 1i64) / b
}

pub fn in_range(val: i64, lo: i64, hi: i64) -> bool {
    return val >= lo && val <= hi
}
