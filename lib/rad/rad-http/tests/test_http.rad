// tests/test_http.rad — Validation of rad-http parsing and data structures

import "../src/lib.rad";

fn main() -> i32 {
    // 1. Test URL parsing
    let url_opt = parse_url("http://localhost:8080/api/v1/users");
    match url_opt {
        Option.Some(u) => {
            if !str_eq(u.host.as_ptr() as str, "localhost") {
                println("FAIL: host mismatch");
                return 1;
            }
            if u.port != 8080 {
                println("FAIL: port mismatch");
                return 1;
            }
            if !str_eq(u.path.as_ptr() as str, "/api/v1/users") {
                println("FAIL: path mismatch");
                return 1;
            }
        },
        Option.None => {
            println("FAIL: parse_url returned None");
            return 1;
        }
    }

    // 2. Test HTTP response parser
    var raw_resp = String.from_str("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 15\r\n\r\n{\"status\":\"ok\"}");
    let resp = parse_http_response(raw_resp);

    if resp.status_code != 200 {
        println("FAIL: expected status 200");
        return 1;
    }
    if !str_eq(resp.status_text.as_ptr() as str, "OK") {
        println("FAIL: expected status text OK");
        return 1;
    }

    let ct_opt = resp.get_header("Content-Type");
    match ct_opt {
        Option.Some(ct) => {
            if !str_eq(ct.as_ptr() as str, "application/json") {
                println("FAIL: header content-type mismatch");
                return 1;
            }
        },
        Option.None => {
            println("FAIL: missing Content-Type header");
            return 1;
        }
    }

    if !str_eq(resp.body.as_ptr() as str, "{\"status\":\"ok\"}") {
        println("FAIL: body mismatch");
        return 1;
    }

    println("[PASS] rad-http tests completed successfully!");
    return 0;
}

fn str_eq(a: str, b: str) -> bool {
    let pa = a as *raw u8;
    let pb = b as *raw u8;
    var i = 0usize;
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] { return false; }
        i = i + 1usize;
    }
    return pa[i] == pb[i];
}
