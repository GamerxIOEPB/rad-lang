// Rad Alloc Library: Box<T> (Unique Owned Heap Pointer)

import allocator;
import core/mem;

pub struct Box<T> {
    pub ptr: *raw var T,
}

impl<T> Box<T> {
    pub fn new(val: T) -> Box<T> {
        let size = size_of_val(val)
        let raw = malloc(size)
        let p = raw as *raw var T
        p[0usize] = val
        Box { ptr: p }
    }

    pub fn get(self) -> T {
        return self.ptr[0usize]
    }

    pub fn set(var self, val: T) {
        self.ptr[0usize] = val
    }

    pub fn drop(var self) {
        free(self.ptr as *raw var u8)
        self.ptr = 0usize as *raw var T
    }
}
