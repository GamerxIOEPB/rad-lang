import "../src/lib.rad";

// Comprehensive test suite for rad-yaml

fn main() -> i32 {
    println("1. Testing YAML Scalar Parsing...");
    let s_int = YamlValue.parse_scalar("12345");
    if s_int.as_int() != 12345i64 {
        println("FAIL: integer parsing");
        return 1;
    }

    let s_neg = YamlValue.parse_scalar("-42");
    if s_neg.as_int() != -42i64 {
        println("FAIL: negative integer parsing");
        return 1;
    }

    let s_bool = YamlValue.parse_scalar("true");
    if !s_bool.as_bool() {
        println("FAIL: bool parsing");
        return 1;
    }

    let s_str = YamlValue.parse_scalar("\"hello world\"");
    if !yaml_str_eq(s_str.as_str(), "hello world") {
        println("FAIL: quoted string parsing");
        return 1;
    }

    println("2. Testing Hierarchical Mapping & Sequence Parsing...");
    var doc_str = String.new();
    doc_str.push_str("name: rad-app\n");
    doc_str.push_str("version: 1\n");
    doc_str.push_str("enabled: true\n");
    doc_str.push_str("server:\n");
    doc_str.push_str("  host: localhost\n");
    doc_str.push_str("  port: 8080\n");

    let parse_res = YamlValue.parse(doc_str.as_ptr() as str);
    match parse_res {
        Result.Ok(val) => {
            if !yaml_str_eq(val.get_str("name"), "rad-app") {
                println("FAIL: name mismatch");
                return 1;
            }
            if val.get_int("version") != 1i64 {
                println("FAIL: version mismatch");
                return 1;
            }
            if !val.get_bool("enabled") {
                println("FAIL: enabled mismatch");
                return 1;
            }
            if !yaml_str_eq(val.get_str("server.host"), "localhost") {
                println("FAIL: server.host mismatch");
                return 1;
            }
            if val.get_int("server.port") != 8080i64 {
                println("FAIL: server.port mismatch");
                return 1;
            }
        },
        Result.Err(e) => {
            println("FAIL: failed to parse valid yaml");
            return 1;
        }
    }

    println("3. Testing Sequence & Inline Sequences...");
    var seq_doc = String.new();
    seq_doc.push_str("- apple\n");
    seq_doc.push_str("- banana\n");
    seq_doc.push_str("- cherry\n");

    let seq_res = YamlValue.parse(seq_doc.as_ptr() as str);
    match seq_res {
        Result.Ok(val) => {
            if !val.is_sequence() {
                println("FAIL: expected sequence");
                return 1;
            }
            if val.seq_val.len != 3usize {
                println("FAIL: sequence length mismatch");
                return 1;
            }
            if !yaml_str_eq(val.seq_val.ptr[0].as_str(), "apple") {
                println("FAIL: seq[0] apple");
                return 1;
            }
            if !yaml_str_eq(val.seq_val.ptr[1].as_str(), "banana") {
                println("FAIL: seq[1] banana");
                return 1;
            }
        },
        Result.Err(e) => {
            println("FAIL: failed to parse seq yaml");
            return 1;
        }
    }

    println("4. Testing Serialization...");
    var root = YamlValue.mapping();
    root.set("title", YamlValue.string("Rad YAML Demo"));
    root.set("count", YamlValue.integer(42i64));

    var sub = YamlValue.mapping();
    sub.set("active", YamlValue.bool(true));
    root.set("details", sub);

    let serialized = root.to_string();
    if yaml_str_len(serialized.as_ptr() as str) == 0usize {
        println("FAIL: serialization empty");
        return 1;
    }

    let reparsed_res = YamlValue.parse(serialized.as_ptr() as str);
    match reparsed_res {
        Result.Ok(rep) => {
            if !yaml_str_eq(rep.get_str("title"), "Rad YAML Demo") {
                println("FAIL: round-trip title");
                return 1;
            }
            if rep.get_int("count") != 42i64 {
                println("FAIL: round-trip count");
                return 1;
            }
            if !rep.get_bool("details.active") {
                println("FAIL: round-trip details.active");
                return 1;
            }
        },
        Result.Err(e) => {
            println("FAIL: round-trip reparsing error");
            return 1;
        }
    }

    println("rad-yaml tests PASSED successfully!");
    return 0;
}
