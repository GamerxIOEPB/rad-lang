// ==============================================================================
// rad-test — Ergonomic Unit Testing Harness for Rad
// Assertions, test case tracking, and colored terminal reporting.
// ==============================================================================

extern "C" {
    fn exit(status: i32);
}

pub struct TestSuite {
    pub name: String,
    pub passed: usize,
    pub failed: usize,
    pub total: usize,
}

impl TestSuite {
    pub fn new(name: str) -> TestSuite {
        TestSuite {
            name: String.from_str(name),
            passed: 0usize,
            failed: 0usize,
            total: 0usize,
        }
    }

    pub fn check(var self, test_name: str, passed: bool, failure_detail: str) {
        self.total = self.total + 1usize;
        if passed {
            self.passed = self.passed + 1usize;
            print("\x1b[32m  [PASS]\x1b[0m ");
            println(test_name);
        } else {
            self.failed = self.failed + 1usize;
            print("\x1b[31m  [FAIL]\x1b[0m ");
            print(test_name);
            if str_len(failure_detail) > 0usize {
                print(" — \x1b[33m");
                print(failure_detail);
                print("\x1b[0m");
            }
            println("");
        }
    }

    pub fn check_true(var self, test_name: str, cond: bool) {
        self.check(test_name, cond, "expected condition to be true");
    }

    pub fn check_false(var self, test_name: str, cond: bool) {
        self.check(test_name, !cond, "expected condition to be false");
    }

    pub fn check_eq_i64(var self, test_name: str, actual: i64, expected: i64) {
        let ok = actual == expected;
        if ok {
            self.check(test_name, true, "");
        } else {
            print("\x1b[31m  [FAIL]\x1b[0m ");
            print(test_name);
            print(" — expected ");
            print_num(expected);
            print(", got ");
            print_num(actual);
            println("");
            self.total = self.total + 1usize;
            self.failed = self.failed + 1usize;
        }
    }

    pub fn check_eq_str(var self, test_name: str, actual: str, expected: str) {
        let ok = str_eq(actual, expected);
        if ok {
            self.check(test_name, true, "");
        } else {
            print("\x1b[31m  [FAIL]\x1b[0m ");
            print(test_name);
            print(" — expected '");
            print(expected);
            print("', got '");
            print(actual);
            println("'");
            self.total = self.total + 1usize;
            self.failed = self.failed + 1usize;
        }
    }

    pub fn check_ne_i64(var self, test_name: str, actual: i64, unexpected: i64) {
        let ok = actual != unexpected;
        self.check(test_name, ok, "values were unexpectedly equal");
    }

    pub fn check_ne_str(var self, test_name: str, actual: str, unexpected: str) {
        let ok = !str_eq(actual, unexpected);
        self.check(test_name, ok, "strings were unexpectedly equal");
    }

    pub fn print_summary(self) -> i32 {
        println("");
        print("=== Test Suite: ");
        print(self.name.as_ptr() as str);
        println(" ===");

        print("Total:  ");
        print_num(self.total as i64);
        print(" | Passed: \x1b[32m");
        print_num(self.passed as i64);
        print("\x1b[0m | Failed: ");
        if self.failed > 0usize {
            print("\x1b[31m");
            print_num(self.failed as i64);
            print("\x1b[0m");
        } else {
            print("0");
        }
        println("");

        if self.failed == 0usize {
            println("\x1b[32m[ALL TESTS PASSED]\x1b[0m");
            return 0;
        } else {
            println("\x1b[31m[SOME TESTS FAILED]\x1b[0m");
            return 1;
        }
    }
}

// Standalone fatal assertions (calling exit(101) on failure)
pub fn assert(cond: bool) {
    if !cond {
        println("\x1b[31massertion failed: condition was false\x1b[0m");
        exit(101);
    }
}

pub fn assert_eq(a: i64, b: i64) {
    if a != b {
        print("\x1b[31massertion failed: ");
        print_num(a);
        print(" != ");
        print_num(b);
        println("\x1b[0m");
        exit(101);
    }
}

pub fn assert_ne(a: i64, b: i64) {
    if a == b {
        print("\x1b[31massertion failed: ");
        print_num(a);
        println(" == unexpected value\x1b[0m");
        exit(101);
    }
}

pub fn assert_streq(a: str, b: str) {
    if !str_eq(a, b) {
        print("\x1b[31massertion failed: '");
        print(a);
        print("' != '");
        print(b);
        println("'\x1b[0m");
        exit(101);
    }
}

pub fn assert_strne(a: str, b: str) {
    if str_eq(a, b) {
        print("\x1b[31massertion failed: '");
        print(a);
        print("' == '");
        print(b);
        println("'\x1b[0m");
        exit(101);
    }
}

// Standalone assertions (returning bool)
pub fn assert_true(cond: bool, msg: str) -> bool {
    if !cond {
        print("\x1b[31mAssertion failed: \x1b[0m");
        println(msg);
        return false;
    }
    return true;
}

pub fn assert_false(cond: bool, msg: str) -> bool {
    if cond {
        print("\x1b[31mAssertion failed (expected false): \x1b[0m");
        println(msg);
        return false;
    }
    return true;
}

pub fn assert_eq_i64(a: i64, b: i64, msg: str) -> bool {
    if a != b {
        print("\x1b[31mAssertion failed (");
        print_num(a);
        print(" != ");
        print_num(b);
        print("): \x1b[0m");
        println(msg);
        return false;
    }
    return true;
}

pub fn assert_eq_str(a: str, b: str, msg: str) -> bool {
    if !str_eq(a, b) {
        print("\x1b[31mAssertion failed ('");
        print(a);
        print("' != '");
        print(b);
        print("'): \x1b[0m");
        println(msg);
        return false;
    }
    return true;
}

// Helper utilities
fn str_len(s: str) -> usize {
    if (s as usize) == 0usize { return 0usize; }
    let p = s as *raw u8;
    var i = 0usize;
    while p[i] != 0u8 { i = i + 1usize; }
    return i;
}

fn str_eq(a: str, b: str) -> bool {
    if (a as usize) == 0usize || (b as usize) == 0usize {
        return (a as usize) == (b as usize);
    }
    let pa = a as *raw u8;
    let pb = b as *raw u8;
    var i = 0usize;
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] { return false; }
        i = i + 1usize;
    }
    return pa[i] == pb[i];
}

fn print_num(n: i64) {
    let s = int_to_string(n);
    print(s.as_ptr() as str);
}

fn int_to_string(val: i64) -> String {
    if val == 0i64 {
        return String.from_str("0");
    }
    var v = val;
    var is_neg = false;
    if v < 0i64 {
        is_neg = true;
        v = -v;
    }
    var rev = String.new();
    while v > 0i64 {
        let digit = (v % 10i64) as u8;
        rev.push_byte(48u8 + digit);
        v = v / 10i64;
    }
    if is_neg {
        rev.push_byte(45u8);
    }
    var res = String.new();
    var len = rev.len();
    let p = rev.as_ptr();
    while len > 0usize {
        len = len - 1usize;
        res.push_byte(p[len]);
    }
    return res;
}
