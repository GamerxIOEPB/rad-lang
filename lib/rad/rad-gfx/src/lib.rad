// ==============================================================================
// rad-gfx: Lightweight 2D Graphics Framebuffer & Image Exporter for Rad
// Zero-dependency pure-Rad rasterizer supporting lines, rects, circles, PPM and BMP.
// ==============================================================================

import std/terminal;
import std/keyboard;

pub struct Color {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8,
}

impl Color {
    pub fn rgb(r: u8, g: u8, b: u8) -> Color {
        return Color { r: r, g: g, b: b, a: 255u8 }
    }

    pub fn rgba(r: u8, g: u8, b: u8, a: u8) -> Color {
        return Color { r: r, g: g, b: b, a: a }
    }

    pub fn black() -> Color { return Color.rgb(0u8, 0u8, 0u8) }
    pub fn white() -> Color { return Color.rgb(255u8, 255u8, 255u8) }
    pub fn red() -> Color { return Color.rgb(255u8, 0u8, 0u8) }
    pub fn green() -> Color { return Color.rgb(0u8, 255u8, 0u8) }
    pub fn blue() -> Color { return Color.rgb(0u8, 0u8, 255u8) }
    pub fn yellow() -> Color { return Color.rgb(255u8, 255u8, 0u8) }
    pub fn cyan() -> Color { return Color.rgb(0u8, 255u8, 255u8) }
    pub fn magenta() -> Color { return Color.rgb(255u8, 0u8, 255u8) }
}

pub struct Canvas {
    pub width: usize,
    pub height: usize,
    pub pixels: *raw var u8,
    pub chars: *raw var u8,
    pub char_fg: *raw var u8,
}

fn gfx_int_abs(v: i64) -> i64 {
    if v < 0i64 {
        return -v
    }
    return v
}

fn gfx_int_to_str(val: usize) -> String {
    if val == 0usize {
        return String.from_str("0")
    }
    var buf = String.new()
    var v = val
    while v > 0usize {
        let rem = (v % 10usize) as u8
        buf.push_byte(48u8 + rem)
        v = v / 10usize
    }
    // Reverse digits
    var res = String.new()
    var i = buf.len()
    while i > 0usize {
        i = i - 1usize
        let ch = (buf.as_ptr() as *raw u8)[i]
        res.push_byte(ch)
    }
    return res
}

fn gfx_get_char_bits(ch: u8) -> i32 {
    var c = ch;
    if c >= 97u8 && c <= 122u8 { c = c - 32u8; } // uppercase
    if c == 65u8 { return 23530; }
    if c == 66u8 { return 15083; }
    if c == 67u8 { return 29263; }
    if c == 68u8 { return 15211; }
    if c == 69u8 { return 29391; }
    if c == 70u8 { return 4815; }
    if c == 71u8 { return 31567; }
    if c == 72u8 { return 23533; }
    if c == 73u8 { return 29847; }
    if c == 74u8 { return 31524; }
    if c == 75u8 { return 23277; }
    if c == 76u8 { return 29257; }
    if c == 77u8 { return 23421; }
    if c == 78u8 { return 23549; }
    if c == 79u8 { return 31599; }
    if c == 80u8 { return 5103; }
    if c == 81u8 { return 18927; }
    if c == 82u8 { return 23279; }
    if c == 83u8 { return 31183; }
    if c == 84u8 { return 9367; }
    if c == 85u8 { return 31597; }
    if c == 86u8 { return 11117; }
    if c == 87u8 { return 24429; }
    if c == 88u8 { return 23213; }
    if c == 89u8 { return 31213; }
    if c == 90u8 { return 29351; }
    if c == 48u8 { return 31599; }
    if c == 49u8 { return 29850; }
    if c == 50u8 { return 29671; }
    if c == 51u8 { return 31207; }
    if c == 52u8 { return 18925; }
    if c == 53u8 { return 31183; }
    if c == 54u8 { return 31695; }
    if c == 55u8 { return 18727; }
    if c == 56u8 { return 31727; }
    if c == 57u8 { return 31215; }
    if c == 58u8 { return 1040; }
    if c == 45u8 { return 448; }
    if c == 43u8 { return 1488; }
    if c == 37u8 { return 21157; }
    if c == 62u8 { return 5393; }
    if c == 60u8 { return 17492; }
    if c == 91u8 { return 12875; }
    if c == 93u8 { return 26918; }
    if c == 47u8 { return 4772; }
    if c == 46u8 { return 8192; }
    if c == 32u8 { return 0; }
    return 0;
}

impl Canvas {
    pub fn new(width: usize, height: usize) -> Canvas {
        let total_bytes = width * height * 4usize;
        let p = malloc(total_bytes) as *raw var u8;
        let num_cells = width * ((height + 1usize) / 2usize);
        let ch_buf = malloc(num_cells) as *raw var u8;
        let fg_buf = malloc(num_cells * 3usize) as *raw var u8;
        var ci = 0usize;
        while ci < num_cells {
            ch_buf[ci] = 0u8;
            fg_buf[ci * 3usize] = 255u8;
            fg_buf[ci * 3usize + 1usize] = 255u8;
            fg_buf[ci * 3usize + 2usize] = 255u8;
            ci = ci + 1usize;
        }
        var c = Canvas {
            width: width,
            height: height,
            pixels: p,
            chars: ch_buf,
            char_fg: fg_buf,
        };
        c.clear(Color.black());
        return c;
    }

    pub fn clear(var self, color: Color) {
        var y = 0usize;
        while y < self.height {
            var x = 0usize;
            while x < self.width {
                self.set_pixel(x, y, color);
                x = x + 1usize;
            }
            y = y + 1usize;
        }
        let num_cells = self.width * ((self.height + 1usize) / 2usize);
        var ci = 0usize;
        while ci < num_cells {
            self.chars[ci] = 0u8;
            ci = ci + 1usize;
        }
    }

    pub fn set_pixel_rgb(var self, x: usize, y: usize, r: u8, g: u8, b: u8) {
        if x >= self.width || y >= self.height {
            return
        }
        let idx = ((y * self.width) + x) * 4usize
        self.pixels[idx] = r
        self.pixels[idx + 1usize] = g
        self.pixels[idx + 2usize] = b
        self.pixels[idx + 3usize] = 255u8
    }

    pub fn set_pixel_rgba(var self, x: usize, y: usize, r: u8, g: u8, b: u8, a: u8) {
        if x >= self.width || y >= self.height {
            return
        }
        let idx = ((y * self.width) + x) * 4usize
        self.pixels[idx] = r
        self.pixels[idx + 1usize] = g
        self.pixels[idx + 2usize] = b
        self.pixels[idx + 3usize] = a
    }

    pub fn set_pixel(var self, x: usize, y: usize, color: Color) {
        self.set_pixel_rgba(x, y, color.r, color.g, color.b, color.a)
    }

    pub fn get_pixel(self, x: usize, y: usize) -> Color {
        if x >= self.width || y >= self.height {
            return Color.black()
        }
        let idx = ((y * self.width) + x) * 4usize
        return Color.rgba(
            self.pixels[idx],
            self.pixels[idx + 1usize],
            self.pixels[idx + 2usize],
            self.pixels[idx + 3usize]
        )
    }

    pub fn fill_rect_rgb(var self, x: usize, y: usize, w: usize, h: usize, r: u8, g: u8, b: u8) {
        var py = y
        let max_y = y + h
        let max_x = x + w
        while py < max_y && py < self.height {
            var px = x
            while px < max_x && px < self.width {
                self.set_pixel_rgb(px, py, r, g, b)
                px = px + 1usize
            }
            py = py + 1usize
        }
    }

    pub fn fill_rect(var self, x: usize, y: usize, w: usize, h: usize, color: Color) {
        self.fill_rect_rgb(x, y, w, h, color.r, color.g, color.b)
    }

    pub fn draw_rect_rgb(var self, x: usize, y: usize, w: usize, h: usize, r: u8, g: u8, b: u8) {
        if w == 0usize || h == 0usize {
            return
        }
        let x1 = (x + w) - 1usize
        let y1 = (y + h) - 1usize

        var px = x
        while px <= x1 {
            self.set_pixel_rgb(px, y, r, g, b)
            self.set_pixel_rgb(px, y1, r, g, b)
            px = px + 1usize
        }

        var py = y
        while py <= y1 {
            self.set_pixel_rgb(x, py, r, g, b)
            self.set_pixel_rgb(x1, py, r, g, b)
            py = py + 1usize
        }
    }

    pub fn draw_rect(var self, x: usize, y: usize, w: usize, h: usize, color: Color) {
        self.draw_rect_rgb(x, y, w, h, color.r, color.g, color.b)
    }

    pub fn draw_line_rgb(var self, x0: i64, y0: i64, x1: i64, y1: i64, r: u8, g: u8, b: u8) {
        let dx = gfx_int_abs(x1 - x0)
        var sx = -1i64
        if x0 < x1 {
            sx = 1i64
        }
        let dy = -gfx_int_abs(y1 - y0)
        var sy = -1i64
        if y0 < y1 {
            sy = 1i64
        }
        var err = dx + dy

        var cx = x0
        var cy = y0
        var running = true
        while running {
            if cx >= 0i64 && cy >= 0i64 {
                self.set_pixel_rgb(cx as usize, cy as usize, r, g, b)
            }
            if cx == x1 && cy == y1 {
                running = false
            } else {
                let e2 = err * 2i64
                if e2 >= dy {
                    err = err + dy
                    cx = cx + sx
                }
                if e2 <= dx {
                    err = err + dx
                    cy = cy + sy
                }
            }
        }
    }

    pub fn draw_line(var self, x0: i64, y0: i64, x1: i64, y1: i64, color: Color) {
        self.draw_line_rgb(x0, y0, x1, y1, color.r, color.g, color.b)
    }

    pub fn draw_circle(var self, cx: i64, cy: i64, radius: i64, color: Color) {
        var x = 0i64
        var y = radius
        var d = 3i64 - (2i64 * radius)

        while y >= x {
            self.draw_circle_pts(cx, cy, x, y, color)
            x = x + 1i64
            if d > 0i64 {
                y = y - 1i64
                d = d + (4i64 * (x - y)) + 10i64
            } else {
                d = d + (4i64 * x) + 6i64
            }
        }
    }

    fn draw_circle_pts(var self, cx: i64, cy: i64, x: i64, y: i64, color: Color) {
        if cx + x >= 0i64 && cy + y >= 0i64 { self.set_pixel((cx + x) as usize, (cy + y) as usize, color) }
        if cx - x >= 0i64 && cy + y >= 0i64 { self.set_pixel((cx - x) as usize, (cy + y) as usize, color) }
        if cx + x >= 0i64 && cy - y >= 0i64 { self.set_pixel((cx + x) as usize, (cy - y) as usize, color) }
        if cx - x >= 0i64 && cy - y >= 0i64 { self.set_pixel((cx - x) as usize, (cy - y) as usize, color) }
        if cx + y >= 0i64 && cy + x >= 0i64 { self.set_pixel((cx + y) as usize, (cy + x) as usize, color) }
        if cx - y >= 0i64 && cy + x >= 0i64 { self.set_pixel((cx - y) as usize, (cy + x) as usize, color) }
        if cx + y >= 0i64 && cy - x >= 0i64 { self.set_pixel((cx + y) as usize, (cy - x) as usize, color) }
        if cx - y >= 0i64 && cy - x >= 0i64 { self.set_pixel((cx - y) as usize, (cy - x) as usize, color) }
    }

    pub fn fill_circle(var self, cx: i64, cy: i64, radius: i64, color: Color) {
        var y = -radius
        while y <= radius {
            var x = -radius
            while x <= radius {
                if (x * x) + (y * y) <= (radius * radius) {
                    let px = cx + x
                    let py = cy + y
                    if px >= 0i64 && py >= 0i64 {
                        self.set_pixel(px as usize, py as usize, color)
                    }
                }
                x = x + 1i64
            }
            y = y + 1i64
        }
    }

    pub fn draw_char_bitmap(var self, x: usize, y: usize, ch: u8, r: u8, g: u8, b: u8) {
        let bits = gfx_get_char_bits(ch);
        var row = 0usize;
        while row < 5usize {
            let r_bits = (bits >> ((row * 3usize) as i32)) & 7;
            if (r_bits & 1) != 0 { self.set_pixel_rgb(x, y + row, r, g, b); }
            if (r_bits & 2) != 0 { self.set_pixel_rgb(x + 1usize, y + row, r, g, b); }
            if (r_bits & 4) != 0 { self.set_pixel_rgb(x + 2usize, y + row, r, g, b); }
            row = row + 1usize;
        }
    }

    pub fn draw_char_rgb(var self, x: usize, y: usize, ch: u8, r: u8, g: u8, b: u8) {
        let term_row = y / 2usize;
        let max_rows = (self.height + 1usize) / 2usize;
        if term_row >= max_rows || x >= self.width {
            return;
        }
        let idx = (term_row * self.width) + x;
        self.chars[idx] = ch;
        let fg_idx = idx * 3usize;
        self.char_fg[fg_idx] = r;
        self.char_fg[fg_idx + 1usize] = g;
        self.char_fg[fg_idx + 2usize] = b;
    }

    pub fn draw_char(var self, x: usize, y: usize, ch: u8, color: Color) {
        self.draw_char_rgb(x, y, ch, color.r, color.g, color.b);
    }

    pub fn draw_text_bitmap(var self, x: usize, y: usize, text: str, color: Color) {
        let p = text as *raw u8;
        var i = 0usize;
        var cx = x;
        while p[i] != 0u8 {
            self.draw_char_bitmap(cx, y, p[i], color.r, color.g, color.b);
            cx = cx + 4usize;
            i = i + 1usize;
        }
    }

    pub fn draw_text_rgb(var self, x: usize, y: usize, text: str, r: u8, g: u8, b: u8) {
        let term_row = y / 2usize;
        let max_rows = (self.height + 1usize) / 2usize;
        if term_row >= max_rows {
            return;
        }
        let p = text as *raw u8;
        var i = 0usize;
        var cx = x;
        while p[i] != 0u8 && cx < self.width {
            let idx = (term_row * self.width) + cx;
            self.chars[idx] = p[i];
            let fg_idx = idx * 3usize;
            self.char_fg[fg_idx] = r;
            self.char_fg[fg_idx + 1usize] = g;
            self.char_fg[fg_idx + 2usize] = b;
            cx = cx + 1usize;
            i = i + 1usize;
        }
    }

    pub fn draw_text(var self, x: usize, y: usize, text: str, color: Color) {
        self.draw_text_rgb(x, y, text, color.r, color.g, color.b);
    }

    pub fn save_ppm(self, path: str) -> bool {
        // Open O_WRONLY | O_CREAT | O_TRUNC (1 | 64 | 512 = 577), mode 0644 (420)
        let fd = syscall3(2i64, path as *raw u8, 577i64, 420i64)
        if fd < 0i64 {
            return false
        }

        // Header: "P6\n<width> <height>\n255\n"
        var hdr = String.from_str("P6\n")
        hdr.push_str(gfx_int_to_str(self.width).as_ptr() as str)
        hdr.push_byte(32u8) // ' '
        hdr.push_str(gfx_int_to_str(self.height).as_ptr() as str)
        hdr.push_str("\n255\n")

        let _ = syscall3(1i64, fd, hdr.as_ptr() as *raw u8, hdr.len() as i64)

        // Write RGB data row by row
        let row_buf = malloc(self.width * 3usize) as *raw var u8
        var y = 0usize
        while y < self.height {
            var x = 0usize
            while x < self.width {
                let p_idx = ((y * self.width) + x) * 4usize
                let r_idx = x * 3usize
                row_buf[r_idx] = self.pixels[p_idx]
                row_buf[r_idx + 1usize] = self.pixels[p_idx + 1usize]
                row_buf[r_idx + 2usize] = self.pixels[p_idx + 2usize]
                x = x + 1usize
            }
            let _ = syscall3(1i64, fd, row_buf, (self.width * 3usize) as i64)
            y = y + 1usize
        }
        free(row_buf)

        let _ = syscall1(3i64, fd) // SYS_close
        return true
    }

    pub fn destroy(var self) {
        if (self.pixels as usize) != 0usize {
            free(self.pixels);
            self.pixels = 0usize as *raw var u8;
        }
        if (self.chars as usize) != 0usize {
            free(self.chars);
            self.chars = 0usize as *raw var u8;
        }
        if (self.char_fg as usize) != 0usize {
            free(self.char_fg);
            self.char_fg = 0usize as *raw var u8;
        }
    }
}

// ==============================================================================
// Interactive Windowing & Framebuffer Display
// Zero-dependency 60 FPS live rendering backend with non-blocking event polling.
// ==============================================================================

pub const EVENT_NONE: i32 = 0;
pub const EVENT_KEY: i32 = 1;
pub const EVENT_MOUSE: i32 = 2;
pub const EVENT_CLOSE: i32 = 3;
pub const EVENT_KEY_UP: i32 = 4;

pub const KEY_UP: u8 = 200u8;
pub const KEY_DOWN: u8 = 201u8;
pub const KEY_RIGHT: u8 = 202u8;
pub const KEY_LEFT: u8 = 203u8;
pub const KEY_ESC: u8 = 27u8;

pub struct Event {
    pub kind: i32,
    pub key: u8,
    pub mouse_x: i32,
    pub mouse_y: i32,
}

impl Event {
    pub fn is_key(self, ch: u8) -> bool {
        return self.kind == EVENT_KEY && self.key == ch;
    }

    pub fn is_release(self) -> bool {
        return self.kind == EVENT_KEY_UP;
    }

    pub fn is_release_key(self, ch: u8) -> bool {
        return self.kind == EVENT_KEY_UP && self.key == ch;
    }

    pub fn is_close(self) -> bool {
        return self.kind == EVENT_CLOSE;
    }

    pub fn is_up(self) -> bool {
        return self.kind == EVENT_KEY && self.key == KEY_UP;
    }

    pub fn is_down(self) -> bool {
        return self.kind == EVENT_KEY && self.key == KEY_DOWN;
    }

    pub fn is_left(self) -> bool {
        return self.kind == EVENT_KEY && self.key == KEY_LEFT;
    }

    pub fn is_right(self) -> bool {
        return self.kind == EVENT_KEY && self.key == KEY_RIGHT;
    }
}

pub struct ScreenSize {
    pub width: usize,
    pub height: usize,
    pub cols: usize,
    pub rows: usize,
}

pub struct Window {
    pub width: usize,
    pub height: usize,
    pub title: String,
    pub open: bool,
    pub frame_count: u64,
    pub cols: usize,
    pub rows: usize,
    pub session: TerminalSession,
    pub is_closed: bool,
    pub render_buf: *raw var u8,
    pub render_cap: usize,
    pub event_buf: *raw var u8,
    pub key_states: *raw var u8,
    pub has_release_events: bool,
    pub kbd: KeyboardReader,
}

fn gfx_str_len(s: str) -> usize {
    let p = s as *raw u8;
    var len = 0usize;
    while p[len] != 0u8 {
        len = len + 1usize;
    }
    return len;
}

fn buf_push_byte(buf: *raw var u8, pos: usize, cap: usize, b: u8) -> usize {
    if pos < cap {
        buf[pos] = b;
        return pos + 1usize;
    }
    return pos;
}

fn buf_push_str(buf: *raw var u8, pos: usize, cap: usize, s: str) -> usize {
    if (s as usize) == 0usize { return pos; }
    let p = s as *raw u8;
    var cur = pos;
    var i = 0usize;
    while p[i] != 0u8 && cur < cap {
        buf[cur] = p[i];
        cur = cur + 1usize;
        i = i + 1usize;
    }
    return cur;
}

fn buf_push_u8_dec(buf: *raw var u8, pos: usize, cap: usize, val: u8) -> usize {
    var cur = pos;
    if val >= 100u8 {
        cur = buf_push_byte(buf, cur, cap, 48u8 + (val / 100u8));
        cur = buf_push_byte(buf, cur, cap, 48u8 + ((val / 10u8) % 10u8));
        cur = buf_push_byte(buf, cur, cap, 48u8 + (val % 10u8));
    } else if val >= 10u8 {
        cur = buf_push_byte(buf, cur, cap, 48u8 + (val / 10u8));
        cur = buf_push_byte(buf, cur, cap, 48u8 + (val % 10u8));
    } else {
        cur = buf_push_byte(buf, cur, cap, 48u8 + val);
    }
    return cur;
}

fn buf_push_usize_dec(buf: *raw var u8, pos: usize, cap: usize, val: usize) -> usize {
    if val == 0usize {
        return buf_push_byte(buf, pos, cap, 48u8);
    }
    var cur = pos;
    let v = val;
    var div: usize = 1usize;
    while v / div >= 10usize {
        div = div * 10usize;
    }
    while div > 0usize {
        let d = (v / div) % 10usize;
        cur = buf_push_byte(buf, cur, cap, (48usize + d) as u8);
        div = div / 10usize;
    }
    return cur;
}

fn buf_emit_fg(buf: *raw var u8, pos: usize, cap: usize, r: u8, g: u8, b: u8) -> usize {
    var cur = pos;
    cur = buf_push_str(buf, cur, cap, "\x1b[38;2;");
    cur = buf_push_u8_dec(buf, cur, cap, r);
    cur = buf_push_byte(buf, cur, cap, 59u8);
    cur = buf_push_u8_dec(buf, cur, cap, g);
    cur = buf_push_byte(buf, cur, cap, 59u8);
    cur = buf_push_u8_dec(buf, cur, cap, b);
    cur = buf_push_byte(buf, cur, cap, 109u8);
    return cur;
}

fn buf_emit_bg(buf: *raw var u8, pos: usize, cap: usize, r: u8, g: u8, b: u8) -> usize {
    var cur = pos;
    cur = buf_push_str(buf, cur, cap, "\x1b[48;2;");
    cur = buf_push_u8_dec(buf, cur, cap, r);
    cur = buf_push_byte(buf, cur, cap, 59u8);
    cur = buf_push_u8_dec(buf, cur, cap, g);
    cur = buf_push_byte(buf, cur, cap, 59u8);
    cur = buf_push_u8_dec(buf, cur, cap, b);
    cur = buf_push_byte(buf, cur, cap, 109u8);
    return cur;
}

pub fn push_i64_str(out: var String, val: i64) {
    if val == 0i64 {
        out.push_byte(48u8);
        return;
    }
    var v = val;
    if v < 0i64 {
        out.push_byte(45u8);
        v = 0i64 - v;
    }
    var div: i64 = 1i64;
    while v / div >= 10i64 {
        div = div * 10i64;
    }
    while div > 0i64 {
        let d = (v / div) % 10i64;
        out.push_byte((48i64 + d) as u8);
        div = div / 10i64;
    }
}

pub fn push_f64_str(out: var String, val: f64, decimals: usize) {
    var v = val;
    if v < 0.0 {
        out.push_byte(45u8);
        v = 0.0 - v;
    }
    let int_part = v as i64;
    push_i64_str(out, int_part);
    if decimals > 0usize {
        out.push_byte(46u8);
        var frac = v - (int_part as f64);
        var i = 0usize;
        while i < decimals {
            frac = frac * 10.0;
            let digit = (frac as i64) % 10i64;
            out.push_byte((48i64 + digit) as u8);
            frac = frac - ((frac as i64) as f64);
            i = i + 1usize;
        }
    }
}

fn push_u8_str(out: var String, val: u8) {
    let v = val as i32;
    if v >= 100 {
        out.push_byte((48 + (v / 100)) as u8);
        out.push_byte((48 + ((v / 10) % 10)) as u8);
        out.push_byte((48 + (v % 10)) as u8);
    } else if v >= 10 {
        out.push_byte((48 + (v / 10)) as u8);
        out.push_byte((48 + (v % 10)) as u8);
    } else {
        out.push_byte((48 + v) as u8);
    }
}

fn push_usize_str(out: var String, val: usize) {
    if val == 0usize {
        out.push_byte(48u8);
        return;
    }
    let v = val;
    var div: usize = 1usize;
    while v / div >= 10usize {
        div = div * 10usize;
    }
    while div > 0usize {
        let d = (v / div) % 10usize;
        out.push_byte((48usize + d) as u8);
        div = div / 10usize;
    }
}

fn emit_fg(out: var String, r: u8, g: u8, b: u8) {
    out.push_str("\x1b[38;2;");
    push_u8_str(out, r);
    out.push_byte(59u8);
    push_u8_str(out, g);
    out.push_byte(59u8);
    push_u8_str(out, b);
    out.push_byte(109u8);
}

fn emit_bg(out: var String, r: u8, g: u8, b: u8) {
    out.push_str("\x1b[48;2;");
    push_u8_str(out, r);
    out.push_byte(59u8);
    push_u8_str(out, g);
    out.push_byte(59u8);
    push_u8_str(out, b);
    out.push_byte(109u8);
}

impl Window {
    pub fn screen_size() -> ScreenSize {
        let buf = malloc(8usize) as *raw var u8;
        var r = syscall3(16i64, 1i64, 21523i64, buf); // SYS_ioctl = 16, stdout = 1, TIOCGWINSZ = 21523
        if r != 0i64 {
            r = syscall3(16i64, 0i64, 21523i64, buf); // fallback on stdin = 0
        }
        var rows = 24usize;
        var cols = 80usize;
        if r == 0i64 {
            let r_val = (buf[0usize] as usize) | ((buf[1usize] as usize) << 8);
            let c_val = (buf[2usize] as usize) | ((buf[3usize] as usize) << 8);
            if r_val > 4usize && c_val > 10usize {
                rows = r_val;
                cols = c_val;
            }
        }
        free(buf);

        // In half-block mode, each terminal row holds 2 vertical pixels.
        // We use (rows - 1) terminal rows and (cols - 2) columns to completely eliminate auto-wrap and scrolling.
        var term_rows = rows;
        if term_rows > 1usize {
            term_rows = term_rows - 1usize;
        }
        let px_height = term_rows * 2usize;

        var term_cols = cols;
        if term_cols > 2usize {
            term_cols = term_cols - 2usize;
        }
        let px_width = term_cols;

        return ScreenSize {
            width: px_width,
            height: px_height,
            cols: cols,
            rows: rows,
        };
    }

    pub fn open(width: usize, height: usize, title: str) -> Window {
        let sz = Window.screen_size();
        var w = width;
        var h = height;
        if w == 0usize || h == 0usize {
            w = sz.width;
            h = sz.height;
        }

        var session = TerminalSession.new();
        session.enable_raw_mode();
        session.enter_alternate_screen();
        session.hide_cursor();
        session.clear_screen();

        let cap = 2097152usize;
        let r_buf = malloc(cap) as *raw var u8;
        let ev_buf = malloc(32usize) as *raw var u8;
        let k_states = malloc(256usize) as *raw var u8;
        var ki = 0usize;
        while ki < 256usize {
            k_states[ki] = 0u8;
            ki = ki + 1usize;
        }

        let kbd = KeyboardReader.new();

        return Window {
            width: w,
            height: h,
            title: String.from_str(title),
            open: true,
            frame_count: 0u64,
            cols: sz.cols,
            rows: sz.rows,
            session: session,
            is_closed: false,
            render_buf: r_buf,
            render_cap: cap,
            event_buf: ev_buf,
            key_states: k_states,
            has_release_events: false,
            kbd: kbd,
        };
    }

    pub fn open_autores(title: str) -> Window {
        return Window.open(0usize, 0usize, title);
    }

    pub fn check_resize(var self) -> bool {
        let sz = Window.screen_size();
        if sz.cols != self.cols || sz.rows != self.rows {
            self.cols = sz.cols;
            self.rows = sz.rows;
            self.width = sz.width;
            self.height = sz.height;
            return true;
        }
        return false;
    }

    pub fn draw_canvas_from(var self, canvas: Canvas, start_row: usize) {
        if self.is_closed || (self.render_buf as usize) == 0usize {
            return;
        }
        var pos = 0usize;
        let buf = self.render_buf;
        let cap = self.render_cap;

        if start_row <= 1usize {
            pos = buf_push_str(buf, pos, cap, "\x1b[H"); // Cursor home (row 1, col 1)
        } else {
            pos = buf_push_str(buf, pos, cap, "\x1b[");
            pos = buf_push_usize_dec(buf, pos, cap, start_row);
            pos = buf_push_str(buf, pos, cap, ";1H"); // Cursor to start_row, col 1
        }

        var last_fg_r = -1i32;
        var last_fg_g = -1i32;
        var last_fg_b = -1i32;
        var last_bg_r = -1i32;
        var last_bg_g = -1i32;
        var last_bg_b = -1i32;

        let px_ptr = canvas.pixels;
        let c_w = canvas.width;
        let c_h = canvas.height;

        var y = 0usize;
        while y < c_h {
            let row1_off = y * c_w * 4usize;
            let has_row2 = y + 1usize < c_h;
            let row2_off = (y + 1usize) * c_w * 4usize;

            var x = 0usize;
            while x < c_w {
                let p1 = row1_off + (x * 4usize);
                let tr = px_ptr[p1] as i32;
                let tg = px_ptr[p1 + 1usize] as i32;
                let tb = px_ptr[p1 + 2usize] as i32;

                var br = 0i32;
                var bg = 0i32;
                var bb = 0i32;
                if has_row2 {
                    let p2 = row2_off + (x * 4usize);
                    br = px_ptr[p2] as i32;
                    bg = px_ptr[p2 + 1usize] as i32;
                    bb = px_ptr[p2 + 2usize] as i32;
                }

                let cell_idx = (y / 2usize) * c_w + x;
                let cell_ch = canvas.chars[cell_idx];

                if cell_ch != 0u8 {
                    let fg_r = canvas.char_fg[cell_idx * 3usize] as i32;
                    let fg_g = canvas.char_fg[cell_idx * 3usize + 1usize] as i32;
                    let fg_b = canvas.char_fg[cell_idx * 3usize + 2usize] as i32;
                    if fg_r != last_fg_r || fg_g != last_fg_g || fg_b != last_fg_b {
                        pos = buf_emit_fg(buf, pos, cap, fg_r as u8, fg_g as u8, fg_b as u8);
                        last_fg_r = fg_r;
                        last_fg_g = fg_g;
                        last_fg_b = fg_b;
                    }
                    if br != last_bg_r || bg != last_bg_g || bb != last_bg_b {
                        pos = buf_emit_bg(buf, pos, cap, br as u8, bg as u8, bb as u8);
                        last_bg_r = br;
                        last_bg_g = bg;
                        last_bg_b = bb;
                    }
                    pos = buf_push_byte(buf, pos, cap, cell_ch);
                } else if tr == br && tg == bg && tb == bb {
                    if br != last_bg_r || bg != last_bg_g || bb != last_bg_b {
                        pos = buf_emit_bg(buf, pos, cap, br as u8, bg as u8, bb as u8);
                        last_bg_r = br;
                        last_bg_g = bg;
                        last_bg_b = bb;
                    }
                    pos = buf_push_byte(buf, pos, cap, 32u8); // ' '
                } else {
                    if tr != last_fg_r || tg != last_fg_g || tb != last_fg_b {
                        pos = buf_emit_fg(buf, pos, cap, tr as u8, tg as u8, tb as u8);
                        last_fg_r = tr;
                        last_fg_g = tg;
                        last_fg_b = tb;
                    }
                    if br != last_bg_r || bg != last_bg_g || bb != last_bg_b {
                        pos = buf_emit_bg(buf, pos, cap, br as u8, bg as u8, bb as u8);
                        last_bg_r = br;
                        last_bg_g = bg;
                        last_bg_b = bb;
                    }
                    // Upper half-block: ▀
                    pos = buf_push_byte(buf, pos, cap, 226u8);
                    pos = buf_push_byte(buf, pos, cap, 150u8);
                    pos = buf_push_byte(buf, pos, cap, 128u8);
                }

                x = x + 1usize;
            }
            if y + 2usize < c_h {
                pos = buf_push_str(buf, pos, cap, "\x1b[0m\r\n");
            } else {
                pos = buf_push_str(buf, pos, cap, "\x1b[0m");
            }
            last_fg_r = -1i32;
            last_fg_g = -1i32;
            last_fg_b = -1i32;
            last_bg_r = -1i32;
            last_bg_g = -1i32;
            last_bg_b = -1i32;
            y = y + 2usize;
        }

        var written = 0i64;
        let total = pos as i64;
        let p_val = (buf as usize);
        while written < total {
            let cur_ptr = (p_val + (written as usize)) as *raw u8;
            let n = syscall3(1i64, 1i64, cur_ptr, total - written);
            if n <= 0i64 {
                break;
            }
            written = written + n;
        }
        self.frame_count = self.frame_count + 1u64;
    }

    pub fn draw_canvas(var self, canvas: Canvas) {
        self.draw_canvas_from(canvas, 1usize);
    }

    pub fn draw_canvas_with_header(var self, header: str, canvas: Canvas) {
        if self.is_closed || (self.render_buf as usize) == 0usize {
            return;
        }
        var pos = 0usize;
        let buf = self.render_buf;
        let cap = self.render_cap;

        // Atomic frame start: cursor home (row 1, col 1)
        pos = buf_push_str(buf, pos, cap, "\x1b[H");

        // Write row 1 header string
        pos = buf_push_str(buf, pos, cap, header);

        // Clear to end of header line (\x1b[K) and newline down to row 2
        pos = buf_push_str(buf, pos, cap, "\x1b[0m\x1b[K\r\n");

        var last_fg_r = -1i32;
        var last_fg_g = -1i32;
        var last_fg_b = -1i32;
        var last_bg_r = -1i32;
        var last_bg_g = -1i32;
        var last_bg_b = -1i32;

        let px_ptr = canvas.pixels;
        let c_w = canvas.width;
        let c_h = canvas.height;

        var y = 0usize;
        while y < c_h {
            let row1_off = y * c_w * 4usize;
            let has_row2 = y + 1usize < c_h;
            let row2_off = (y + 1usize) * c_w * 4usize;

            var x = 0usize;
            while x < c_w {
                let p1 = row1_off + (x * 4usize);
                let tr = px_ptr[p1] as i32;
                let tg = px_ptr[p1 + 1usize] as i32;
                let tb = px_ptr[p1 + 2usize] as i32;

                var br = 0i32;
                var bg = 0i32;
                var bb = 0i32;
                if has_row2 {
                    let p2 = row2_off + (x * 4usize);
                    br = px_ptr[p2] as i32;
                    bg = px_ptr[p2 + 1usize] as i32;
                    bb = px_ptr[p2 + 2usize] as i32;
                }

                let cell_idx = (y / 2usize) * c_w + x;
                let cell_ch = canvas.chars[cell_idx];

                if cell_ch != 0u8 {
                    let fg_r = canvas.char_fg[cell_idx * 3usize] as i32;
                    let fg_g = canvas.char_fg[cell_idx * 3usize + 1usize] as i32;
                    let fg_b = canvas.char_fg[cell_idx * 3usize + 2usize] as i32;
                    if fg_r != last_fg_r || fg_g != last_fg_g || fg_b != last_fg_b {
                        pos = buf_emit_fg(buf, pos, cap, fg_r as u8, fg_g as u8, fg_b as u8);
                        last_fg_r = fg_r;
                        last_fg_g = fg_g;
                        last_fg_b = fg_b;
                    }
                    if br != last_bg_r || bg != last_bg_g || bb != last_bg_b {
                        pos = buf_emit_bg(buf, pos, cap, br as u8, bg as u8, bb as u8);
                        last_bg_r = br;
                        last_bg_g = bg;
                        last_bg_b = bb;
                    }
                    pos = buf_push_byte(buf, pos, cap, cell_ch);
                } else if tr == br && tg == bg && tb == bb {
                    if br != last_bg_r || bg != last_bg_g || bb != last_bg_b {
                        pos = buf_emit_bg(buf, pos, cap, br as u8, bg as u8, bb as u8);
                        last_bg_r = br;
                        last_bg_g = bg;
                        last_bg_b = bb;
                    }
                    pos = buf_push_byte(buf, pos, cap, 32u8); // ' '
                } else {
                    if tr != last_fg_r || tg != last_fg_g || tb != last_fg_b {
                        pos = buf_emit_fg(buf, pos, cap, tr as u8, tg as u8, tb as u8);
                        last_fg_r = tr;
                        last_fg_g = tg;
                        last_fg_b = tb;
                    }
                    if br != last_bg_r || bg != last_bg_g || bb != last_bg_b {
                        pos = buf_emit_bg(buf, pos, cap, br as u8, bg as u8, bb as u8);
                        last_bg_r = br;
                        last_bg_g = bg;
                        last_bg_b = bb;
                    }
                    // Upper half-block: ▀
                    pos = buf_push_byte(buf, pos, cap, 226u8);
                    pos = buf_push_byte(buf, pos, cap, 150u8);
                    pos = buf_push_byte(buf, pos, cap, 128u8);
                }

                x = x + 1usize;
            }
            if y + 2usize < c_h {
                pos = buf_push_str(buf, pos, cap, "\x1b[0m\r\n");
            } else {
                pos = buf_push_str(buf, pos, cap, "\x1b[0m");
            }
            last_fg_r = -1i32;
            last_fg_g = -1i32;
            last_fg_b = -1i32;
            last_bg_r = -1i32;
            last_bg_g = -1i32;
            last_bg_b = -1i32;
            y = y + 2usize;
        }

        var written = 0i64;
        let total = pos as i64;
        let p_val = (buf as usize);
        while written < total {
            let cur_ptr = (p_val + (written as usize)) as *raw u8;
            let n = syscall3(1i64, 1i64, cur_ptr, total - written);
            if n <= 0i64 {
                break;
            }
            written = written + n;
        }
        self.frame_count = self.frame_count + 1u64;
    }

    pub fn draw_overlay_text(var self, row: usize, col: usize, text: str, fg_r: u8, fg_g: u8, fg_b: u8, bg_r: u8, bg_g: u8, bg_b: u8) {
        var pos = 0usize;
        let buf = self.render_buf;
        let cap = self.render_cap;
        pos = buf_push_str(buf, pos, cap, "\x1b[");
        pos = buf_push_usize_dec(buf, pos, cap, row);
        pos = buf_push_byte(buf, pos, cap, 59u8);
        pos = buf_push_usize_dec(buf, pos, cap, col);
        pos = buf_push_byte(buf, pos, cap, 72u8);
        pos = buf_emit_fg(buf, pos, cap, fg_r, fg_g, fg_b);
        pos = buf_emit_bg(buf, pos, cap, bg_r, bg_g, bg_b);
        pos = buf_push_str(buf, pos, cap, text);
        pos = buf_push_str(buf, pos, cap, "\x1b[0m");
        let _ = syscall3(1i64, 1i64, buf as *raw u8, pos as i64);
    }

    pub fn begin_overlay(self) -> usize {
        return 0usize;
    }

    pub fn add_overlay_text(self, var pos: usize, row: usize, col: usize, text: str, fg_r: u8, fg_g: u8, fg_b: u8, bg_r: u8, bg_g: u8, bg_b: u8) -> usize {
        let buf = self.render_buf;
        let cap = self.render_cap;
        pos = buf_push_str(buf, pos, cap, "\x1b[");
        pos = buf_push_usize_dec(buf, pos, cap, row);
        pos = buf_push_byte(buf, pos, cap, 59u8);
        pos = buf_push_usize_dec(buf, pos, cap, col);
        pos = buf_push_byte(buf, pos, cap, 72u8);
        pos = buf_emit_fg(buf, pos, cap, fg_r, fg_g, fg_b);
        pos = buf_emit_bg(buf, pos, cap, bg_r, bg_g, bg_b);
        pos = buf_push_str(buf, pos, cap, text);
        pos = buf_push_str(buf, pos, cap, "\x1b[0m");
        return pos;
    }

    pub fn flush_overlay(self, pos: usize) {
        if pos > 0usize {
            let _ = syscall3(1i64, 1i64, self.render_buf as *raw u8, pos as i64);
        }
    }

    pub fn poll_event(var self) -> Option<Event> {
        let evt = self.kbd.read_key(0);
        if evt.code == KEY_NONE {
            return Option.None;
        }

        // Map KeyEvent to key code (u8)
        var code: u8 = 0u8;
        if evt.code == KEY_CHAR {
            code = evt.char_val;
        } else if evt.code == KEY_UP {
            code = KEY_UP;
        } else if evt.code == KEY_DOWN {
            code = KEY_DOWN;
        } else if evt.code == KEY_LEFT {
            code = KEY_LEFT;
        } else if evt.code == KEY_RIGHT {
            code = KEY_RIGHT;
        } else if evt.code == KEY_ESC {
            code = KEY_ESC;
        } else if evt.code == KEY_ENTER {
            code = 10u8;
        } else if evt.code == KEY_BACKSPACE {
            code = 127u8;
        } else if evt.code == KEY_TAB {
            code = 9u8;
        }

        if evt.is_release {
            self.has_release_events = true;
            if code != 0u8 {
                self.key_states[code as usize] = 0u8;
            }
            return Option.Some(Event {
                kind: EVENT_KEY_UP,
                key: code,
                mouse_x: 0,
                mouse_y: 0,
            });
        }

        // Key press or repeat:
        // When release events are active (Kitty protocol), pin to 255 until physical release.
        // On legacy terminals without release events:
        // - Turn keys (Left/Right arrows): 3 frames (~50ms) for snappy instant camera stopping
        // - Move keys (WASD): 6 frames (~100ms) for responsive braking and short stopping distance
        var active_val: u8 = 6u8;
        if self.has_release_events {
            active_val = 255u8;
        } else if code == KEY_LEFT || code == KEY_RIGHT {
            active_val = 3u8;
        }
        if code != 0u8 {
            self.key_states[code as usize] = active_val;
        }

        if evt.is_char(113u8) || evt.is_char(81u8) || evt.is_ctrl(99u8) || evt.is_eof() {
            return Option.Some(Event {
                kind: EVENT_CLOSE,
                key: code,
                mouse_x: 0,
                mouse_y: 0,
            });
        }

        return Option.Some(Event {
            kind: EVENT_KEY,
            key: code,
            mouse_x: 0,
            mouse_y: 0,
        });
    }

    pub fn is_key_down(self, key: u8) -> bool {
        if self.is_closed || (self.key_states as usize) == 0usize {
            return false;
        }
        return self.key_states[key as usize] > 0u8;
    }

    pub fn is_action_up(self) -> bool {
        return self.is_key_down(KEY_UP) || self.is_key_down(119u8) || self.is_key_down(87u8);
    }

    pub fn is_action_down(self) -> bool {
        return self.is_key_down(KEY_DOWN) || self.is_key_down(115u8) || self.is_key_down(83u8);
    }

    pub fn is_action_left(self) -> bool {
        return self.is_key_down(KEY_LEFT) || self.is_key_down(97u8) || self.is_key_down(65u8);
    }

    pub fn is_action_right(self) -> bool {
        return self.is_key_down(KEY_RIGHT) || self.is_key_down(100u8) || self.is_key_down(68u8);
    }

    pub fn tick_input(var self) {
        if self.is_closed || (self.key_states as usize) == 0usize {
            return;
        }
        if self.has_release_events {
            return;
        }
        var i = 0usize;
        while i < 256usize {
            if self.key_states[i] > 0u8 {
                self.key_states[i] = self.key_states[i] - 1u8;
            }
            i = i + 1usize;
        }
    }

    pub fn is_open(self) -> bool {
        return self.open && !self.is_closed;
    }

    pub fn clear_row(var self, row: usize) {
        var pos = 0usize;
        let buf = self.render_buf;
        let cap = self.render_cap;
        pos = buf_push_str(buf, pos, cap, "\x1b[");
        pos = buf_push_usize_dec(buf, pos, cap, row);
        pos = buf_push_str(buf, pos, cap, ";1H\x1b[2K\x1b[0m");
        let _ = syscall3(1i64, 1i64, buf as *raw u8, pos as i64);
    }

    pub fn close(var self) {
        if self.is_closed {
            return;
        }
        self.is_closed = true;
        self.open = false;

        if (self.render_buf as usize) != 0usize {
            free(self.render_buf);
            self.render_buf = 0usize as *raw var u8;
            self.render_cap = 0usize;
        }
        if (self.event_buf as usize) != 0usize {
            free(self.event_buf);
            self.event_buf = 0usize as *raw var u8;
        }
        if (self.key_states as usize) != 0usize {
            free(self.key_states);
            self.key_states = 0usize as *raw var u8;
        }
        self.kbd.close_reader();
        self.title.drop();

        // Reset text formatting and clear the alternate screen buffer
        let clear_seq = "\x1b[0m\x1b[2J\x1b[H";
        let _ = syscall3(1i64, 1i64, clear_seq as *raw u8, 10i64);

        // End terminal session (restores cursor, leaves alternate screen, restores termios via TCSETSF)
        self.session.end_session();

        // Extra guarantee: ensure cursor is visible and reset styling
        let final_seq = "\x1b[?25h\x1b[0m\r\n";
        let _ = syscall3(1i64, 1i64, final_seq as *raw u8, 10i64);
    }

    pub fn sleep_frame(fps: u64) {
        var ms = 16u64;
        if fps > 0u64 {
            ms = 1000u64 / fps;
        }
        let req = malloc(16usize) as *raw var u8;
        let sec = (ms / 1000u64) as i64;
        let nsec = ((ms % 1000u64) * 1000000u64) as i64;
        var i = 0usize;
        while i < 8usize {
            req[i] = ((sec >> (i * 8usize)) & 255i64) as u8;
            req[i + 8usize] = ((nsec >> (i * 8usize)) & 255i64) as u8;
            i = i + 1usize;
        }
        let _ = syscall2(35i64, req, 0usize as *raw u8);
        free(req);
    }
}

// ==============================================================================
// Professional First-Person Movement & Camera Controller (FpsController)
// ==============================================================================
// Implements standard shooter physics (Quake / Source / Unreal style):
// - Instant camera rotation with ZERO drift and ZERO residual momentum
// - High ground friction (stops within ~0.15s without sliding across rooms)
// - Dual-mode input: Kitty release-event tracking + legacy repeat bridging
// - Independent multi-axis steering without forward velocity starvation
// ==============================================================================

pub struct FpsController {
    pub move_speed: f64,
    pub turn_speed: f64,
    pub sprint_multiplier: f64,
    pub vel_forward: f64,
    pub vel_strafe: f64,
    pub vel_turn: f64,
    pub forward_hold: u64,
    pub backward_hold: u64,
    pub strafe_left_hold: u64,
    pub strafe_right_hold: u64,
    pub turn_left_hold: u64,
    pub turn_right_hold: u64,
}

impl FpsController {
    pub fn new(move_speed: f64, turn_speed: f64) -> FpsController {
        return FpsController {
            move_speed: move_speed,
            turn_speed: turn_speed,
            sprint_multiplier: 1.35,
            vel_forward: 0.0,
            vel_strafe: 0.0,
            vel_turn: 0.0,
            forward_hold: 0u64,
            backward_hold: 0u64,
            strafe_left_hold: 0u64,
            strafe_right_hold: 0u64,
            turn_left_hold: 0u64,
            turn_right_hold: 0u64,
        };
    }

    pub fn handle_event(var self, ev: Event, frame_count: u64) {
        if ev.is_release() {
            if ev.key == 119u8 || ev.key == 87u8 || ev.key == KEY_UP {
                self.forward_hold = 0u64;
            } else if ev.key == 115u8 || ev.key == 83u8 || ev.key == KEY_DOWN {
                self.backward_hold = 0u64;
            } else if ev.key == 97u8 || ev.key == 65u8 {
                self.strafe_left_hold = 0u64;
            } else if ev.key == 100u8 || ev.key == 68u8 {
                self.strafe_right_hold = 0u64;
            } else if ev.key == KEY_LEFT {
                self.turn_left_hold = 0u64;
            } else if ev.key == KEY_RIGHT {
                self.turn_right_hold = 0u64;
            }
        } else if ev.kind == EVENT_KEY {
            if ev.is_up() || ev.is_key(119u8) || ev.is_key(87u8) {
                self.forward_hold = frame_count + 5u64;
                self.backward_hold = 0u64;
            } else if ev.is_down() || ev.is_key(115u8) || ev.is_key(83u8) {
                self.backward_hold = frame_count + 5u64;
                self.forward_hold = 0u64;
            } else if ev.is_key(97u8) || ev.is_key(65u8) {
                self.strafe_left_hold = frame_count + 5u64;
                self.strafe_right_hold = 0u64;
            } else if ev.key == 100u8 || ev.key == 68u8 {
                self.strafe_right_hold = frame_count + 5u64;
                self.strafe_left_hold = 0u64;
            } else if ev.is_left() {
                self.turn_left_hold = frame_count + 2u64;
                self.turn_right_hold = 0u64;
            } else if ev.is_right() {
                self.turn_right_hold = frame_count + 2u64;
                self.turn_left_hold = 0u64;
            }
        }
    }

    pub fn update(var self, window: Window, frame_count: u64) {
        var spd = self.move_speed;
        if window.is_key_down(32u8) { // Space (sprint)
            spd = spd * self.sprint_multiplier;
        }

        // Active steering sustains forward walking momentum across repeat delays
        let is_steering = (self.turn_left_hold > frame_count) || (self.turn_right_hold > frame_count) || window.is_key_down(KEY_LEFT) || window.is_key_down(KEY_RIGHT);
        if is_steering && self.forward_hold > frame_count {
            self.forward_hold = frame_count + 5u64;
        }

        var target_forward: f64 = 0.0;
        var target_strafe: f64 = 0.0;
        var target_turn: f64 = 0.0;

        if (self.forward_hold > frame_count) || window.is_action_up() { target_forward = target_forward + spd; }
        if (self.backward_hold > frame_count) || window.is_action_down() { target_forward = target_forward - spd; }
        if (self.strafe_left_hold > frame_count) || window.is_key_down(97u8) || window.is_key_down(65u8) { target_strafe = target_strafe - spd; }
        if (self.strafe_right_hold > frame_count) || window.is_key_down(100u8) || window.is_key_down(68u8) { target_strafe = target_strafe + spd; }
        if (self.turn_left_hold > frame_count) || window.is_key_down(KEY_LEFT) { target_turn = target_turn - self.turn_speed; }
        if (self.turn_right_hold > frame_count) || window.is_key_down(KEY_RIGHT) { target_turn = target_turn + self.turn_speed; }

        // Normal shooter camera: instant looking with ZERO drift and ZERO residual momentum
        self.vel_turn = target_turn;

        // Quake/Source-style ground acceleration & crisp friction braking
        if self.vel_forward == 0.0 && target_forward != 0.0 {
            self.vel_forward = target_forward;
        } else if target_forward == 0.0 {
            self.vel_forward = self.vel_forward * 0.65; // High ground friction: stops within ~0.15s
        } else {
            self.vel_forward = (self.vel_forward * 0.40) + (target_forward * 0.60);
        }

        if self.vel_strafe == 0.0 && target_strafe != 0.0 {
            self.vel_strafe = target_strafe;
        } else if target_strafe == 0.0 {
            self.vel_strafe = self.vel_strafe * 0.65; // High ground friction
        } else {
            self.vel_strafe = (self.vel_strafe * 0.40) + (target_strafe * 0.60);
        }

        if self.vel_forward > -0.0005 && self.vel_forward < 0.0005 { self.vel_forward = 0.0; }
        if self.vel_strafe > -0.0005 && self.vel_strafe < 0.0005 { self.vel_strafe = 0.0; }
    }
}
