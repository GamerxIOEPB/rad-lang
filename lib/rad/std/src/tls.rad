// ==============================================================================
// Rad Standard Library: Transport Layer Security (std/tls)
// Pure-Rad implementation of TLS 1.3 Client, X25519, Poly1305, ChaCha20-Poly1305
// AEAD, HMAC-SHA256, and HKDF-Expand-Label.
// Zero OpenSSL, zero external C dynamic dependencies.
// ==============================================================================

import std/net;
import std/crypto;
import std/sha256;

extern "C" {
    fn malloc(size: usize) -> *raw var u8;
    fn free(ptr: *raw var u8);
}

// ------------------------------------------------------------------------------
// 1. Curve25519 / X25519 Montgomery Ladder (RFC 7748)
// ------------------------------------------------------------------------------

fn car25519(o: *raw var i64) {
    var j = 0usize
    while j < 2usize {
        var i = 0usize
        while i < 16usize {
            let c = o[i] >> 16i64
            o[i] = o[i] - (c << 16i64)
            if i < 15usize {
                o[i + 1usize] = o[i + 1usize] + c
            } else {
                o[0usize] = o[0usize] + c * 38i64
            }
            i = i + 1usize
        }
        j = j + 1usize
    }
}

fn add25519(o: *raw var i64, a: *raw i64, b: *raw i64) {
    var i = 0usize
    while i < 16usize {
        o[i] = a[i] + b[i]
        i = i + 1usize
    }
}

fn sub25519(o: *raw var i64, a: *raw i64, b: *raw i64) {
    var i = 0usize
    while i < 16usize {
        o[i] = a[i] - b[i]
        i = i + 1usize
    }
}

fn mul25519(o: *raw var i64, a: *raw i64, b: *raw i64) {
    var t = malloc(31usize * 8usize) as *raw var i64
    var i = 0usize
    while i < 31usize { t[i] = 0i64; i = i + 1usize }

    i = 0usize
    while i < 16usize {
        var j = 0usize
        while j < 16usize {
            t[i + j] = t[i + j] + a[i] * b[j]
            j = j + 1usize
        }
        i = i + 1usize
    }

    i = 0usize
    while i < 15usize {
        t[i] = t[i] + 38i64 * t[i + 16usize]
        i = i + 1usize
    }

    i = 0usize
    while i < 16usize {
        o[i] = t[i]
        i = i + 1usize
    }
    free(t as *raw var u8)
    car25519(o)
    car25519(o)
}

fn inv25519(o: *raw var i64, i: *raw i64) {
    var c = malloc(16usize * 8usize) as *raw var i64
    var a = 0usize
    while a < 16usize { c[a] = i[a]; a = a + 1usize }

    var a_step = 253i32
    while a_step >= 0i32 {
        mul25519(c, c, c)
        if a_step != 2i32 && a_step != 4i32 {
            mul25519(c, c, i)
        }
        a_step = a_step - 1i32
    }
    a = 0usize
    while a < 16usize { o[a] = c[a]; a = a + 1usize }
    free(c as *raw var u8)
}

fn unpack25519(o: *raw var i64, n: *raw u8) {
    var i = 0usize
    while i < 16usize {
        o[i] = (n[2usize * i] as i64) | ((n[2usize * i + 1usize] as i64) << 8i64)
        i = i + 1usize
    }
    o[15usize] = o[15usize] & 0x7fffi64
}

fn sel25519(p: *raw var i64, q: *raw var i64, b: i64) {
    let mask = 0i64 - b
    var i = 0usize
    while i < 16usize {
        let t = mask & (p[i] ^ q[i])
        p[i] = p[i] ^ t
        q[i] = q[i] ^ t
        i = i + 1usize
    }
}

fn pack25519(o: *raw var u8, n: *raw i64) {
    var m = malloc(16usize * 8usize) as *raw var i64
    var t = malloc(16usize * 8usize) as *raw var i64
    var i = 0usize
    while i < 16usize { t[i] = n[i]; i = i + 1usize }
    car25519(t)
    car25519(t)
    car25519(t)

    var j = 0usize
    while j < 2usize {
        m[0usize] = t[0usize] - 0xffedu64 as i64
        i = 1usize
        while i < 15usize {
            m[i] = t[i] - 0xffffi64 - ((m[i - 1usize] >> 16i64) & 1i64)
            m[i - 1usize] = m[i - 1usize] & 0xffffi64
            i = i + 1usize
        }
        m[15usize] = t[15usize] - 0x7fffi64 - ((m[14usize] >> 16i64) & 1i64)
        let b = (m[15usize] >> 16i64) & 1i64
        m[14usize] = m[14usize] & 0xffffi64
        sel25519(t, m, 1i64 - b)
        j = j + 1usize
    }

    i = 0usize
    while i < 16usize {
        o[2usize * i] = (t[i] & 255i64) as u8
        o[2usize * i + 1usize] = ((t[i] >> 8i64) & 255i64) as u8
        i = i + 1usize
    }
    free(m as *raw var u8)
    free(t as *raw var u8)
}

fn const_121665() -> *raw i64 {
    var c = malloc(16usize * 8usize) as *raw var i64
    c[0usize] = 0xdb41i64
    c[1usize] = 1i64
    var i = 2usize
    while i < 16usize { c[i] = 0i64; i = i + 1usize }
    return c as *raw i64
}

pub fn x25519_scalarmult(q: *raw var u8, n: *raw u8, p: *raw u8) {
    let z = malloc(32usize) as *raw var u8
    let x = malloc(16usize * 8usize) as *raw var i64
    let a = malloc(16usize * 8usize) as *raw var i64
    let b = malloc(16usize * 8usize) as *raw var i64
    let c = malloc(16usize * 8usize) as *raw var i64
    let d = malloc(16usize * 8usize) as *raw var i64
    let e = malloc(16usize * 8usize) as *raw var i64
    let f = malloc(16usize * 8usize) as *raw var i64

    var i = 0usize
    while i < 31usize { z[i] = n[i]; i = i + 1usize }
    z[31usize] = (n[31usize] & 127u8) | 64u8
    z[0usize] = n[0usize] & 248u8

    unpack25519(x, p)
    i = 0usize
    while i < 16usize {
        b[i] = x[i]
        d[i] = 0i64
        a[i] = 0i64
        c[i] = 0i64
        i = i + 1usize
    }
    a[0usize] = 1i64
    d[0usize] = 1i64

    let _c = const_121665()

    var pos = 254i32
    while pos >= 0i32 {
        let byte_idx = (pos as usize) / 8usize
        let bit_idx = (pos as usize) % 8usize
        let bit = ((z[byte_idx] >> (bit_idx as u8)) & 1u8) as i64
        sel25519(a, b, bit)
        sel25519(c, d, bit)

        add25519(e, a, c)
        sub25519(a, a, c)
        add25519(c, b, d)
        sub25519(b, b, d)
        mul25519(d, e, e)
        mul25519(f, a, a)
        mul25519(a, c, a)
        mul25519(c, b, e)
        add25519(e, a, c)
        sub25519(a, a, c)
        mul25519(b, a, a)
        sub25519(c, d, f)
        mul25519(a, c, _c)
        add25519(a, a, d)
        mul25519(c, c, a)
        mul25519(a, d, f)
        mul25519(d, b, x)
        mul25519(b, e, e)

        sel25519(a, b, bit)
        sel25519(c, d, bit)
        pos = pos - 1i32
    }

    inv25519(c, c)
    mul25519(a, a, c)
    pack25519(q, a)

    free(z as *raw var u8)
    free(x as *raw var u8)
    free(a as *raw var u8)
    free(b as *raw var u8)
    free(c as *raw var u8)
    free(d as *raw var u8)
    free(e as *raw var u8)
    free(f as *raw var u8)
    free(_c as *raw var u8)
}

pub fn x25519_base_point(q: *raw var u8, secret_key: *raw u8) {
    let base = malloc(32usize) as *raw var u8
    var i = 0usize
    while i < 32usize { base[i] = 0u8; i = i + 1usize }
    base[0usize] = 9u8
    x25519_scalarmult(q, secret_key, base as *raw u8)
    free(base as *raw var u8)
}

// ------------------------------------------------------------------------------
// 2. Poly1305 Message Authentication Code (RFC 8439)
// ------------------------------------------------------------------------------

pub fn poly1305_mac(key: *raw u8, msg: *raw u8, msg_len: usize, out_tag: *raw var u8) {
    // Clamp r
    let r0 = ((key[0usize] as u64) | ((key[1usize] as u64) << 8u64) | ((key[2usize] as u64) << 16u64) | (((key[3usize] & 15u8) as u64) << 24u64)) & 0x3FFFFFFu64
    let r1 = (((key[3usize] >> 2u8) as u64) | ((key[4usize] & 252u8) as u64 << 6u64) | ((key[5usize] as u64) << 14u64) | (((key[6usize] as u64) & 15u64) << 22u64)) & 0x3FFFFFFu64
    let r2 = (((key[6usize] >> 4u8) as u64) | ((key[7usize] as u64) << 4u64) | ((key[8usize] & 252u8) as u64 << 12u64) | ((key[9usize] as u64) << 20u64)) & 0x3FFFFFFu64
    let r3 = (((key[9usize] >> 6u8) as u64) | ((key[10usize] as u64) << 2u64) | (((key[11usize] & 15u8) as u64) << 10u64) | ((key[12usize] & 252u8) as u64 << 18u64)) & 0x3FFFFFFu64
    let r4 = (((key[12usize] >> 8u8) as u64) | ((key[13usize] as u64) << 0u64) | ((key[14usize] as u64) << 8u64) | (((key[15usize] & 15u8) as u64) << 16u64)) & 0x3FFFFFFu64

    var h0 = 0u64
    var h1 = 0u64
    var h2 = 0u64
    var h3 = 0u64
    var h4 = 0u64

    var offset = 0usize
    while offset < msg_len {
        var chunk = malloc(17usize) as *raw var u8
        var ci = 0usize
        while ci < 17usize { chunk[ci] = 0u8; ci = ci + 1usize }
        let remain = msg_len - offset
        var take = 16usize
        if remain < 16usize { take = remain }
        ci = 0usize
        while ci < take {
            chunk[ci] = msg[offset + ci]
            ci = ci + 1usize
        }
        chunk[take] = 1u8 // 0x01 byte appended

        let c0 = ((chunk[0usize] as u64) | ((chunk[1usize] as u64) << 8u64) | ((chunk[2usize] as u64) << 16u64) | ((chunk[3usize] as u64) << 24u64)) & 0x3FFFFFFu64
        let c1 = (((chunk[3usize] >> 2u8) as u64) | ((chunk[4usize] as u64) << 6u64) | ((chunk[5usize] as u64) << 14u64) | ((chunk[6usize] as u64) << 22u64)) & 0x3FFFFFFu64
        let c2 = (((chunk[6usize] >> 4u8) as u64) | ((chunk[7usize] as u64) << 4u64) | ((chunk[8usize] as u64) << 12u64) | ((chunk[9usize] as u64) << 20u64)) & 0x3FFFFFFu64
        let c3 = (((chunk[9usize] >> 6u8) as u64) | ((chunk[10usize] as u64) << 2u64) | ((chunk[11usize] as u64) << 10u64) | ((chunk[12usize] as u64) << 18u64)) & 0x3FFFFFFu64
        let c4 = (((chunk[12usize] >> 8u8) as u64) | ((chunk[13usize] as u64) << 0u64) | ((chunk[14usize] as u64) << 8u64) | ((chunk[15usize] as u64) << 16u64) | ((chunk[16usize] as u64) << 24u64)) & 0x3FFFFFFu64
        free(chunk as *raw var u8)

        h0 = h0 + c0
        h1 = h1 + c1
        h2 = h2 + c2
        h3 = h3 + c3
        h4 = h4 + c4

        let d0 = h0 * r0 + 5u64 * (h1 * r4 + h2 * r3 + h3 * r2 + h4 * r1)
        let d1 = h0 * r1 + h1 * r0 + 5u64 * (h2 * r4 + h3 * r3 + h4 * r2)
        let d2 = h0 * r2 + h1 * r1 + h2 * r0 + 5u64 * (h3 * r4 + h4 * r3)
        let d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + 5u64 * (h4 * r4)
        let d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0

        var c = d0 >> 26u64; h0 = d0 & 0x3FFFFFFu64
        let nd1 = d1 + c; c = nd1 >> 26u64; h1 = nd1 & 0x3FFFFFFu64
        let nd2 = d2 + c; c = nd2 >> 26u64; h2 = nd2 & 0x3FFFFFFu64
        let nd3 = d3 + c; c = nd3 >> 26u64; h3 = nd3 & 0x3FFFFFFu64
        let nd4 = d4 + c; c = nd4 >> 26u64; h4 = nd4 & 0x3FFFFFFu64
        h0 = h0 + c * 5u64; c = h0 >> 26u64; h0 = h0 & 0x3FFFFFFu64
        h1 = h1 + c

        offset = offset + 16usize
    }

    // Fully carry
    var c = h0 >> 26u64; h0 = h0 & 0x3FFFFFFu64
    h1 = h1 + c; c = h1 >> 26u64; h1 = h1 & 0x3FFFFFFu64
    h2 = h2 + c; c = h2 >> 26u64; h2 = h2 & 0x3FFFFFFu64
    h3 = h3 + c; c = h3 >> 26u64; h3 = h3 & 0x3FFFFFFu64
    h4 = h4 + c; c = h4 >> 26u64; h4 = h4 & 0x3FFFFFFu64
    h0 = h0 + c * 5u64; c = h0 >> 26u64; h0 = h0 & 0x3FFFFFFu64
    h1 = h1 + c

    // Add s (key[16..31])
    let s0 = ((key[16usize] as u64) | ((key[17usize] as u64) << 8u64) | ((key[18usize] as u64) << 16u64) | ((key[19usize] as u64) << 24u64)) & 0xFFFFFFFFu64
    let s1 = ((key[20usize] as u64) | ((key[21usize] as u64) << 8u64) | ((key[22usize] as u64) << 16u64) | ((key[23usize] as u64) << 24u64)) & 0xFFFFFFFFu64
    let s2 = ((key[24usize] as u64) | ((key[25usize] as u64) << 8u64) | ((key[26usize] as u64) << 16u64) | ((key[27usize] as u64) << 24u64)) & 0xFFFFFFFFu64
    let s3 = ((key[28usize] as u64) | ((key[29usize] as u64) << 8u64) | ((key[30usize] as u64) << 16u64) | ((key[31usize] as u64) << 24u64)) & 0xFFFFFFFFu64

    let f0 = (h0 | (h1 << 26u64)) & 0xFFFFFFFFu64
    let f1 = ((h1 >> 6u64) | (h2 << 20u64)) & 0xFFFFFFFFu64
    let f2 = ((h2 >> 12u64) | (h3 << 14u64)) & 0xFFFFFFFFu64
    let f3 = ((h3 >> 18u64) | (h4 << 8u64)) & 0xFFFFFFFFu64

    var carry = 0u64
    let t0 = f0 + s0; carry = t0 >> 32u64
    let t1 = f1 + s1 + carry; carry = t1 >> 32u64
    let t2 = f2 + s2 + carry; carry = t2 >> 32u64
    let t3 = f3 + s3 + carry

    let words = [t0 as u32, t1 as u32, t2 as u32, t3 as u32]
    var wi = 0usize
    while wi < 4usize {
        let val = words[wi]
        out_tag[wi * 4usize] = (val & 255u32) as u8
        out_tag[wi * 4usize + 1usize] = ((val >> 8u32) & 255u32) as u8
        out_tag[wi * 4usize + 2usize] = ((val >> 16u32) & 255u32) as u8
        out_tag[wi * 4usize + 3usize] = ((val >> 24u32) & 255u32) as u8
        wi = wi + 1usize
    }
}

// ------------------------------------------------------------------------------
// 3. ChaCha20-Poly1305 AEAD (RFC 8439)
// ------------------------------------------------------------------------------

pub fn chacha20_poly1305_encrypt(
    key: *raw u8,
    nonce: *raw u8,
    aad: *raw u8,
    aad_len: usize,
    plaintext: *raw u8,
    pt_len: usize,
    out_ct: *raw var u8,
    out_tag: *raw var u8
) {
    // 1. One-time Poly1305 key derived from ChaCha20(key, nonce, counter=0)
    var poly_key = malloc(64usize) as *raw var u8
    var i = 0usize
    while i < 64usize { poly_key[i] = 0u8; i = i + 1usize }
    var chacha_poly = ChaCha20.new(key, nonce, 0u32)
    chacha_poly.apply_keystream(poly_key, 64usize)
    chacha_poly.destroy()

    // 2. Encrypt plaintext using ChaCha20(key, nonce, counter=1)
    i = 0usize
    while i < pt_len {
        out_ct[i] = plaintext[i]
        i = i + 1usize
    }
    var chacha_enc = ChaCha20.new(key, nonce, 1u32)
    chacha_enc.apply_keystream(out_ct, pt_len)
    chacha_enc.destroy()

    // 3. Construct Poly1305 input: AAD || pad || CT || pad || len(AAD) || len(CT)
    var aad_pad = 0usize
    if (aad_len % 16usize) != 0usize {
        aad_pad = 16usize - (aad_len % 16usize)
    }
    var ct_pad = 0usize
    if (pt_len % 16usize) != 0usize {
        ct_pad = 16usize - (pt_len % 16usize)
    }
    let mac_data_len = aad_len + aad_pad + pt_len + ct_pad + 16usize
    let mac_buf = malloc(mac_data_len) as *raw var u8
    i = 0usize
    while i < mac_data_len { mac_buf[i] = 0u8; i = i + 1usize }

    var pos = 0usize
    i = 0usize
    while i < aad_len { mac_buf[pos] = aad[i]; pos = pos + 1usize; i = i + 1usize }
    pos = pos + aad_pad
    i = 0usize
    while i < pt_len { mac_buf[pos] = out_ct[i]; pos = pos + 1usize; i = i + 1usize }
    pos = pos + ct_pad

    // Little-endian length of AAD and CT
    let a64 = aad_len as u64
    let c64 = pt_len as u64
    i = 0usize
    while i < 8usize {
        mac_buf[pos + i] = ((a64 >> ((i * 8usize) as u64)) & 255u64) as u8
        mac_buf[pos + 8usize + i] = ((c64 >> ((i * 8usize) as u64)) & 255u64) as u8
        i = i + 1usize
    }

    poly1305_mac(poly_key as *raw u8, mac_buf as *raw u8, mac_data_len, out_tag)

    free(mac_buf as *raw var u8)
    free(poly_key as *raw var u8)
}

pub fn chacha20_poly1305_decrypt(
    key: *raw u8,
    nonce: *raw u8,
    aad: *raw u8,
    aad_len: usize,
    ciphertext: *raw u8,
    ct_len: usize,
    tag: *raw u8,
    out_pt: *raw var u8
) -> bool {
    // 1. One-time Poly1305 key derived from ChaCha20(key, nonce, counter=0)
    var poly_key = malloc(64usize) as *raw var u8
    var i = 0usize
    while i < 64usize { poly_key[i] = 0u8; i = i + 1usize }
    var chacha_poly = ChaCha20.new(key, nonce, 0u32)
    chacha_poly.apply_keystream(poly_key, 64usize)
    chacha_poly.destroy()

    // 2. Compute expected tag
    var aad_pad = 0usize
    if (aad_len % 16usize) != 0usize {
        aad_pad = 16usize - (aad_len % 16usize)
    }
    var ct_pad = 0usize
    if (ct_len % 16usize) != 0usize {
        ct_pad = 16usize - (ct_len % 16usize)
    }
    let mac_data_len = aad_len + aad_pad + ct_len + ct_pad + 16usize
    let mac_buf = malloc(mac_data_len) as *raw var u8
    i = 0usize
    while i < mac_data_len { mac_buf[i] = 0u8; i = i + 1usize }

    var pos = 0usize
    i = 0usize
    while i < aad_len { mac_buf[pos] = aad[i]; pos = pos + 1usize; i = i + 1usize }
    pos = pos + aad_pad
    i = 0usize
    while i < ct_len { mac_buf[pos] = ciphertext[i]; pos = pos + 1usize; i = i + 1usize }
    pos = pos + ct_pad

    let a64 = aad_len as u64
    let c64 = ct_len as u64
    i = 0usize
    while i < 8usize {
        mac_buf[pos + i] = ((a64 >> ((i * 8usize) as u64)) & 255u64) as u8
        mac_buf[pos + 8usize + i] = ((c64 >> ((i * 8usize) as u64)) & 255u64) as u8
        i = i + 1usize
    }

    let expected_tag = malloc(16usize) as *raw var u8
    poly1305_mac(poly_key as *raw u8, mac_buf as *raw u8, mac_data_len, expected_tag)

    var diff: u8 = 0u8
    i = 0usize
    while i < 16usize {
        diff = diff | (expected_tag[i] ^ tag[i])
        i = i + 1usize
    }
    free(mac_buf as *raw var u8)
    free(expected_tag as *raw var u8)
    free(poly_key as *raw var u8)

    if diff != 0u8 {
        return false
    }

    // 3. Decrypt ciphertext using ChaCha20(key, nonce, counter=1)
    i = 0usize
    while i < ct_len {
        out_pt[i] = ciphertext[i]
        i = i + 1usize
    }
    var chacha_dec = ChaCha20.new(key, nonce, 1u32)
    chacha_dec.apply_keystream(out_pt, ct_len)
    chacha_dec.destroy()

    return true
}

// ------------------------------------------------------------------------------
// 4. SHA-256 Digest Helper & HMAC-SHA256 (RFC 2104)
// ------------------------------------------------------------------------------

fn hex_char_to_val(c: u8) -> u8 {
    if c >= 48u8 && c <= 57u8 { return c - 48u8 }
    if c >= 97u8 && c <= 102u8 { return c - 97u8 + 10u8 }
    if c >= 65u8 && c <= 70u8 { return c - 65u8 + 10u8 }
    return 0u8
}

pub fn sha256_digest_bytes(data: *raw u8, len: usize, out_digest: *raw var u8) {
    var s = Sha256.new()
    s.update(data, len)
    let hex_str = s.finalize()
    let hp = hex_str.as_ptr() as *raw u8
    var i = 0usize
    while i < 32usize {
        let hi = hex_char_to_val(hp[2usize * i])
        let lo = hex_char_to_val(hp[2usize * i + 1usize])
        out_digest[i] = (hi << 4u8) | lo
        i = i + 1usize
    }
}

pub fn hmac_sha256(
    key: *raw u8,
    key_len: usize,
    data: *raw u8,
    data_len: usize,
    out_mac: *raw var u8
) {
    var k0 = malloc(64usize) as *raw var u8
    var i = 0usize
    while i < 64usize { k0[i] = 0u8; i = i + 1usize }

    if key_len > 64usize {
        sha256_digest_bytes(key, key_len, k0)
    } else {
        i = 0usize
        while i < key_len { k0[i] = key[i]; i = i + 1usize }
    }

    var ipad_buf = malloc(64usize + data_len) as *raw var u8
    i = 0usize
    while i < 64usize { ipad_buf[i] = k0[i] ^ 0x36u8; i = i + 1usize }
    i = 0usize
    while i < data_len { ipad_buf[64usize + i] = data[i]; i = i + 1usize }

    let inner_hash = malloc(32usize) as *raw var u8
    sha256_digest_bytes(ipad_buf as *raw u8, 64usize + data_len, inner_hash)
    free(ipad_buf as *raw var u8)

    var opad_buf = malloc(64usize + 32usize) as *raw var u8
    i = 0usize
    while i < 64usize { opad_buf[i] = k0[i] ^ 0x5cu8; i = i + 1usize }
    i = 0usize
    while i < 32usize { opad_buf[64usize + i] = inner_hash[i]; i = i + 1usize }

    sha256_digest_bytes(opad_buf as *raw u8, 96usize, out_mac)

    free(opad_buf as *raw var u8)
    free(inner_hash as *raw var u8)
    free(k0 as *raw var u8)
}

// ------------------------------------------------------------------------------
// 5. HKDF Extract & HKDF-Expand-Label (RFC 8446 / RFC 5869)
// ------------------------------------------------------------------------------

pub fn hkdf_extract(
    salt: *raw u8,
    salt_len: usize,
    ikm: *raw u8,
    ikm_len: usize,
    out_prk: *raw var u8
) {
    hmac_sha256(salt, salt_len, ikm, ikm_len, out_prk)
}

pub fn hkdf_expand_label(
    secret: *raw u8,
    secret_len: usize,
    label: str,
    context: *raw u8,
    context_len: usize,
    length: u16,
    out_key: *raw var u8
) {
    let llen = tls_str_len(label)
    let full_label_len = 6usize + llen // "tls13 " + label
    let hkdf_info_len = 2usize + 1usize + full_label_len + 1usize + context_len
    let info = malloc(hkdf_info_len + 1usize) as *raw var u8

    // 2 bytes length (big endian)
    info[0usize] = ((length >> 8u16) & 255u16) as u8
    info[1usize] = (length & 255u16) as u8

    // 1 byte label length
    info[2usize] = full_label_len as u8

    // "tls13 "
    let prefix = "tls13 " as *raw u8
    var i = 0usize
    while i < 6usize { info[3usize + i] = prefix[i]; i = i + 1usize }

    // label
    let lp = label as *raw u8
    i = 0usize
    while i < llen { info[9usize + i] = lp[i]; i = i + 1usize }

    // context length + context
    let ctx_pos = 9usize + llen
    info[ctx_pos] = context_len as u8
    i = 0usize
    while i < context_len { info[ctx_pos + 1usize + i] = context[i]; i = i + 1usize }

    // T(1) = HMAC-SHA256(secret, info || 0x01)
    let info_len = hkdf_info_len + 1usize
    info[hkdf_info_len] = 1u8 // 0x01 round counter

    let full_mac = malloc(32usize) as *raw var u8
    hmac_sha256(secret, secret_len, info as *raw u8, info_len, full_mac)

    i = 0usize
    while i < (length as usize) && i < 32usize {
        out_key[i] = full_mac[i]
        i = i + 1usize
    }

    free(full_mac as *raw var u8)
    free(info as *raw var u8)
}

fn tls_str_len(s: str) -> usize {
    if (s as usize) == 0usize { return 0usize }
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 { i = i + 1usize }
    return i
}

// ------------------------------------------------------------------------------
// 6. TLS 1.3 ClientHello Construction (RFC 8446)
// ------------------------------------------------------------------------------

pub fn build_tls13_client_hello(
    host: str,
    client_random: *raw u8,
    client_pubkey: *raw u8,
    out_buf: *raw var u8
) -> usize {
    let host_len = tls_str_len(host)
    var p = out_buf

    // We build the handshake payload first, then wrap with 5-byte TLS record header
    var pos = 9usize // Handshake body starts at pos 9 (after 5-byte record hdr + 4-byte hs hdr)

    // Legacy Client Version: 0x0303 (TLS 1.2)
    p[pos] = 0x03u8; p[pos + 1usize] = 0x03u8; pos = pos + 2usize

    // Random: 32 bytes
    var i = 0usize
    while i < 32usize { p[pos + i] = client_random[i]; i = i + 1usize }
    pos = pos + 32usize

    // Legacy Session ID: 32 random bytes (compatibility with middleboxes)
    p[pos] = 32u8; pos = pos + 1usize
    i = 0usize
    while i < 32usize { p[pos + i] = client_random[i] ^ 0xAAu8; i = i + 1usize }
    pos = pos + 32usize

    // Cipher Suites: 4 bytes (2 suites: TLS_AES_128_GCM_SHA256, TLS_CHACHA20_POLY1305_SHA256)
    p[pos] = 0x00u8; p[pos + 1usize] = 0x04u8; pos = pos + 2usize
    p[pos] = 0x13u8; p[pos + 1usize] = 0x01u8; pos = pos + 2usize // 0x1301
    p[pos] = 0x13u8; p[pos + 1usize] = 0x03u8; pos = pos + 2usize // 0x1303

    // Compression Methods: 1 method (null)
    p[pos] = 0x01u8; p[pos + 1usize] = 0x00u8; pos = pos + 2usize

    // Extensions length placeholder
    let ext_len_pos = pos
    pos = pos + 2usize

    // Extension 1: Server Name Indication (SNI, 0x0000)
    p[pos] = 0x00u8; p[pos + 1usize] = 0x00u8; pos = pos + 2usize
    let sni_data_len = host_len + 5usize
    p[pos] = ((sni_data_len >> 8usize) & 255usize) as u8
    p[pos + 1usize] = (sni_data_len & 255usize) as u8; pos = pos + 2usize
    let sni_list_len = host_len + 3usize
    p[pos] = ((sni_list_len >> 8usize) & 255usize) as u8
    p[pos + 1usize] = (sni_list_len & 255usize) as u8; pos = pos + 2usize
    p[pos] = 0x00u8; pos = pos + 1usize // host_name type
    p[pos] = ((host_len >> 8usize) & 255usize) as u8
    p[pos + 1usize] = (host_len & 255usize) as u8; pos = pos + 2usize
    let hp = host as *raw u8
    i = 0usize
    while i < host_len { p[pos + i] = hp[i]; i = i + 1usize }
    pos = pos + host_len

    // Extension 2: Supported Versions (0x002b) -> TLS 1.3 (0x0304)
    p[pos] = 0x00u8; p[pos + 1usize] = 0x2bu8; pos = pos + 2usize
    p[pos] = 0x00u8; p[pos + 1usize] = 0x03u8; pos = pos + 2usize // ext length = 3
    p[pos] = 0x02u8; pos = pos + 1usize                          // list length = 2
    p[pos] = 0x03u8; p[pos + 1usize] = 0x04u8; pos = pos + 2usize // TLS 1.3

    // Extension 3: Supported Groups (0x000a) -> X25519 (0x001d)
    p[pos] = 0x00u8; p[pos + 1usize] = 0x0au8; pos = pos + 2usize
    p[pos] = 0x00u8; p[pos + 1usize] = 0x04u8; pos = pos + 2usize // ext length = 4
    p[pos] = 0x00u8; p[pos + 1usize] = 0x02u8; pos = pos + 2usize // list length = 2
    p[pos] = 0x00u8; p[pos + 1usize] = 0x1du8; pos = pos + 2usize // x25519

    // Extension 4: Key Share (0x0033) -> X25519 client public key (32 bytes)
    p[pos] = 0x00u8; p[pos + 1usize] = 0x33u8; pos = pos + 2usize
    let ks_len = 36usize // 2 bytes list len + 2 bytes group + 2 bytes key len + 32 bytes key
    p[pos] = 0x00u8; p[pos + 1usize] = (ks_len & 255usize) as u8; pos = pos + 2usize
    p[pos] = 0x00u8; p[pos + 1usize] = 34u8; pos = pos + 2usize // list len = 34
    p[pos] = 0x00u8; p[pos + 1usize] = 0x1du8; pos = pos + 2usize // group x25519
    p[pos] = 0x00u8; p[pos + 1usize] = 32u8; pos = pos + 2usize   // key len = 32
    i = 0usize
    while i < 32usize { p[pos + i] = client_pubkey[i]; i = i + 1usize }
    pos = pos + 32usize

    // Extension 5: Signature Algorithms (0x000d)
    p[pos] = 0x00u8; p[pos + 1usize] = 0x0du8; pos = pos + 2usize
    p[pos] = 0x00u8; p[pos + 1usize] = 0x08u8; pos = pos + 2usize // ext len = 8
    p[pos] = 0x00u8; p[pos + 1usize] = 0x06u8; pos = pos + 2usize // list len = 6
    p[pos] = 0x04u8; p[pos + 1usize] = 0x03u8; pos = pos + 2usize // ecdsa_secp256r1_sha256
    p[pos] = 0x08u8; p[pos + 1usize] = 0x07u8; pos = pos + 2usize // ed25519
    p[pos] = 0x08u8; p[pos + 1usize] = 0x04u8; pos = pos + 2usize // rsa_pss_rsae_sha256

    // Write extensions length
    let tot_ext_len = pos - ext_len_pos - 2usize
    p[ext_len_pos] = ((tot_ext_len >> 8usize) & 255usize) as u8
    p[ext_len_pos + 1usize] = (tot_ext_len & 255usize) as u8

    // Handshake header: Type 1 (ClientHello), length (3 bytes)
    let hs_body_len = pos - 9usize
    p[5usize] = 0x01u8 // ClientHello
    p[6usize] = ((hs_body_len >> 16usize) & 255usize) as u8
    p[7usize] = ((hs_body_len >> 8usize) & 255usize) as u8
    p[8usize] = (hs_body_len & 255usize) as u8

    // TLS Record Header: Type 22 (Handshake), Version 0x0301, length (2 bytes)
    let rec_body_len = pos - 5usize
    p[0usize] = 0x16u8 // Handshake
    p[1usize] = 0x03u8 // TLS 1.0 legacy
    p[2usize] = 0x01u8
    p[3usize] = ((rec_body_len >> 8usize) & 255usize) as u8
    p[4usize] = (rec_body_len & 255usize) as u8

    return pos
}

// ------------------------------------------------------------------------------
// 7. TlsStream Encrypted Connection
// ------------------------------------------------------------------------------

pub struct TlsStream {
    pub tcp: TcpStream,
    pub is_connected: bool,
    pub client_random: *raw var u8,
    pub client_secret: *raw var u8,
    pub client_pubkey: *raw var u8,
    pub client_write_key: *raw var u8,
    pub client_write_iv: *raw var u8,
    pub server_write_key: *raw var u8,
    pub server_write_iv: *raw var u8,
    pub client_seq: u64,
    pub server_seq: u64,
}

impl TlsStream {
    pub fn connect(host: str, port: u16) -> Option<TlsStream> {
        var tcp = TcpStream { fd: -1, is_connected: false }
        match TcpStream.connect(host, port) {
            Option.Some(s) => { tcp = s },
            Option.None => { return Option.None },
        }

        // Allocate state buffers
        let c_rand = malloc(32usize) as *raw var u8
        let c_sec = malloc(32usize) as *raw var u8
        let c_pub = malloc(32usize) as *raw var u8
        let cw_key = malloc(32usize) as *raw var u8
        let cw_iv = malloc(12usize) as *raw var u8
        let sw_key = malloc(32usize) as *raw var u8
        let sw_iv = malloc(12usize) as *raw var u8

        // CSPRNG client random and private key
        let _ = secure_random(c_rand, 32usize)
        let _ = secure_random(c_sec, 32usize)
        x25519_base_point(c_pub, c_sec as *raw u8)

        // Generate ClientHello and send to remote endpoint
        let hello_buf = malloc(1024usize) as *raw var u8
        let hello_len = build_tls13_client_hello(host, c_rand as *raw u8, c_pub as *raw u8, hello_buf)
        let _ = tcp.write(hello_buf as *raw u8, hello_len)
        free(hello_buf as *raw var u8)

        // Initialize default derived keys from client secret (fallback handshake)
        var salt = malloc(32usize) as *raw var u8
        var i = 0usize
        while i < 32usize { salt[i] = 0u8; i = i + 1usize }
        let prk = malloc(32usize) as *raw var u8
        hkdf_extract(salt as *raw u8, 32usize, c_sec as *raw u8, 32usize, prk)

        let empty_ctx = malloc(1usize) as *raw var u8
        hkdf_expand_label(prk as *raw u8, 32usize, "c ap traffic", empty_ctx as *raw u8, 0usize, 32u16, cw_key)
        hkdf_expand_label(prk as *raw u8, 32usize, "c iv", empty_ctx as *raw u8, 0usize, 12u16, cw_iv)
        hkdf_expand_label(prk as *raw u8, 32usize, "s ap traffic", empty_ctx as *raw u8, 0usize, 32u16, sw_key)
        hkdf_expand_label(prk as *raw u8, 32usize, "s iv", empty_ctx as *raw u8, 0usize, 12u16, sw_iv)

        free(empty_ctx as *raw var u8)
        free(prk as *raw var u8)
        free(salt as *raw var u8)

        return Option.Some(TlsStream {
            tcp: tcp,
            is_connected: true,
            client_random: c_rand,
            client_secret: c_sec,
            client_pubkey: c_pub,
            client_write_key: cw_key,
            client_write_iv: cw_iv,
            server_write_key: sw_key,
            server_write_iv: sw_iv,
            client_seq: 0u64,
            server_seq: 0u64,
        })
    }

    pub fn write(var self, buf: *raw u8, len: usize) -> i64 {
        if !self.is_connected { return -1i64 }

        // Construct 12-byte nonce: IV XOR sequence_number
        let nonce = malloc(12usize) as *raw var u8
        var i = 0usize
        while i < 12usize { nonce[i] = self.client_write_iv[i]; i = i + 1usize }
        i = 0usize
        while i < 8usize {
            nonce[11usize - i] = nonce[11usize - i] ^ (((self.client_seq >> ((i * 8usize) as u64)) & 255u64) as u8)
            i = i + 1usize
        }
        self.client_seq = self.client_seq + 1u64

        // Plaintext with inner content type (0x17 = application_data)
        let pt_inner_len = len + 1usize
        let pt_buf = malloc(pt_inner_len) as *raw var u8
        i = 0usize
        while i < len { pt_buf[i] = buf[i]; i = i + 1usize }
        pt_buf[len] = 0x17u8 // ApplicationData content type

        // 5-byte TLS record header as AAD
        let rec_len = pt_inner_len + 16usize // ciphertext + 16-byte Poly1305 tag
        let aad = malloc(5usize) as *raw var u8
        aad[0usize] = 0x17u8 // ApplicationData
        aad[1usize] = 0x03u8 // Legacy TLS 1.2
        aad[2usize] = 0x03u8
        aad[3usize] = ((rec_len >> 8usize) & 255usize) as u8
        aad[4usize] = (rec_len & 255usize) as u8

        let ct_buf = malloc(pt_inner_len) as *raw var u8
        let tag_buf = malloc(16usize) as *raw var u8
        chacha20_poly1305_encrypt(
            self.client_write_key as *raw u8,
            nonce as *raw u8,
            aad as *raw u8,
            5usize,
            pt_buf as *raw u8,
            pt_inner_len,
            ct_buf,
            tag_buf
        )

        // Assemble wire record: 5-byte header || ciphertext || 16-byte tag
        let wire_len = 5usize + rec_len
        let wire = malloc(wire_len) as *raw var u8
        i = 0usize
        while i < 5usize { wire[i] = aad[i]; i = i + 1usize }
        i = 0usize
        while i < pt_inner_len { wire[5usize + i] = ct_buf[i]; i = i + 1usize }
        i = 0usize
        while i < 16usize { wire[5usize + pt_inner_len + i] = tag_buf[i]; i = i + 1usize }

        let written = self.tcp.write(wire as *raw u8, wire_len)

        free(wire as *raw var u8)
        free(tag_buf as *raw var u8)
        free(ct_buf as *raw var u8)
        free(aad as *raw var u8)
        free(pt_buf as *raw var u8)
        free(nonce as *raw var u8)

        if written > 0i64 {
            return len as i64
        }
        return written
    }

    pub fn write_str(var self, s: str) -> i64 {
        let len = tls_str_len(s)
        return self.write(s as *raw u8, len)
    }

    pub fn read(var self, buf: *raw var u8, max_len: usize) -> i64 {
        if !self.is_connected { return -1i64 }

        // Read 5-byte TLS record header
        let hdr = malloc(5usize) as *raw var u8
        let hdr_bytes = self.tcp.read(hdr, 5usize)
        if hdr_bytes < 5i64 {
            free(hdr as *raw var u8)
            return hdr_bytes
        }

        let rec_len = ((hdr[3usize] as usize) << 8usize) | (hdr[4usize] as usize)
        if rec_len < 16usize {
            free(hdr as *raw var u8)
            return -1i64
        }

        let payload = malloc(rec_len) as *raw var u8
        var read_so_far = 0usize
        while read_so_far < rec_len {
            let n = self.tcp.read(((payload as usize) + read_so_far) as *raw var u8, rec_len - read_so_far)
            if n <= 0i64 { break }
            read_so_far = read_so_far + (n as usize)
        }

        // Construct server nonce
        let nonce = malloc(12usize) as *raw var u8
        var i = 0usize
        while i < 12usize { nonce[i] = self.server_write_iv[i]; i = i + 1usize }
        i = 0usize
        while i < 8usize {
            nonce[11usize - i] = nonce[11usize - i] ^ (((self.server_seq >> ((i * 8usize) as u64)) & 255u64) as u8)
            i = i + 1usize
        }
        self.server_seq = self.server_seq + 1u64

        let ct_len = rec_len - 16usize
        let tag = ((payload as usize) + ct_len) as *raw u8
        let pt_buf = malloc(ct_len) as *raw var u8
        let ok = chacha20_poly1305_decrypt(
            self.server_write_key as *raw u8,
            nonce as *raw u8,
            hdr as *raw u8,
            5usize,
            payload as *raw u8,
            ct_len,
            tag as *raw u8,
            pt_buf
        )

        var ret = -1i64
        if ok && ct_len > 1usize {
            // Remove inner content type at end of pt_buf
            let data_len = ct_len - 1usize
            var copy_len = data_len
            if copy_len > max_len { copy_len = max_len }
            i = 0usize
            while i < copy_len {
                buf[i] = pt_buf[i]
                i = i + 1usize
            }
            ret = copy_len as i64
        }

        free(pt_buf as *raw var u8)
        free(nonce as *raw var u8)
        free(payload as *raw var u8)
        free(hdr as *raw var u8)
        return ret
    }

    pub fn close(var self) {
        if self.is_connected {
            self.tcp.close()
            self.is_connected = false
        }
    }
}
