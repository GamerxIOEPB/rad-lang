// ==============================================================================
// Rad Standard Library: Mid-Level Intermediate Representation & Optimizations (std::mir)
// Control-flow graphs (CFG), SSA basic blocks, virtual registers, and compiler passes:
// DCE, SCCP constant folding, CSE, LICM, devirtualization, and escape analysis stack promotion.
// Zero external C dynamic dependencies.
// ==============================================================================

fn mir_str_len(s: str) -> usize {
    if (s as usize) == 0usize { return 0usize }
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

fn mir_str_eq(a: str, b: str) -> bool {
    if (a as usize) == 0usize && (b as usize) == 0usize { return true }
    if (a as usize) == 0usize || (b as usize) == 0usize { return false }
    let pa = a as *raw u8
    let pb = b as *raw u8
    var i = 0usize
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] { return false }
        i = i + 1usize
    }
    return pa[i] == pb[i]
}

fn mir_int_to_str(val: i64) -> String {
    if val == 0i64 {
        return String.from_str("0")
    }
    var v = val
    var is_neg = false
    if v < 0i64 {
        is_neg = true
        v = -v
    }
    var rev = String.new()
    while v > 0i64 {
        let digit = (v % 10i64) as u8
        rev.push_byte(48u8 + digit)
        v = v / 10i64
    }
    if is_neg {
        rev.push_byte(45u8)
    }
    var res = String.new()
    var len = rev.len()
    let p = rev.as_ptr()
    while len > 0usize {
        len = len - 1usize
        res.push_byte(p[len])
    }
    return res
}

// ------------------------------------------------------------------------------
// MIR Operands & Virtual Registers
// ------------------------------------------------------------------------------

pub const MIR_OP_CONST_INT: i32   = 1
pub const MIR_OP_CONST_FLOAT: i32 = 2
pub const MIR_OP_CONST_BOOL: i32  = 3
pub const MIR_OP_VREG: i32        = 4
pub const MIR_OP_GLOBAL: i32      = 5

pub struct MirOperand {
    pub kind: i32,
    pub vreg_id: usize,
    pub int_val: i64,
    pub float_val: f64,
    pub bool_val: bool,
    pub name: String,
}

impl MirOperand {
    pub fn const_int(v: i64) -> MirOperand {
        return MirOperand {
            kind: MIR_OP_CONST_INT,
            vreg_id: 0usize,
            int_val: v,
            float_val: 0.0,
            bool_val: false,
            name: String.new(),
        }
    }

    pub fn const_bool(b: bool) -> MirOperand {
        return MirOperand {
            kind: MIR_OP_CONST_BOOL,
            vreg_id: 0usize,
            int_val: 0i64,
            float_val: 0.0,
            bool_val: b,
            name: String.new(),
        }
    }

    pub fn vreg(id: usize) -> MirOperand {
        return MirOperand {
            kind: MIR_OP_VREG,
            vreg_id: id,
            int_val: 0i64,
            float_val: 0.0,
            bool_val: false,
            name: String.new(),
        }
    }

    pub fn is_const(self) -> bool {
        return self.kind == MIR_OP_CONST_INT || self.kind == MIR_OP_CONST_FLOAT || self.kind == MIR_OP_CONST_BOOL
    }
}

// ------------------------------------------------------------------------------
// MIR Instruction Opcodes
// ------------------------------------------------------------------------------

pub const MIR_NOP: i32           = 0
pub const MIR_ADD: i32           = 1
pub const MIR_SUB: i32           = 2
pub const MIR_MUL: i32           = 3
pub const MIR_DIV: i32           = 4
pub const MIR_EQ: i32            = 5
pub const MIR_LT: i32            = 6
pub const MIR_ALLOCA: i32        = 7
pub const MIR_LOAD: i32          = 8
pub const MIR_STORE: i32         = 9
pub const MIR_HEAP_ALLOC: i32    = 10
pub const MIR_HEAP_FREE: i32     = 11
pub const MIR_CALL: i32          = 12
pub const MIR_VTABLE_CALL: i32   = 13
pub const MIR_JUMP: i32          = 14
pub const MIR_BRANCH_COND: i32   = 15
pub const MIR_RETURN: i32        = 16

pub struct MirInstr {
    pub opcode: i32,
    pub dest_vreg: usize,
    pub op1: MirOperand,
    pub op2: MirOperand,
    pub callee_name: String,
    pub target_block: usize,
    pub else_block: usize,
    pub escapes: bool,
    pub is_dead: bool,
}

impl MirInstr {
    pub fn new(opcode: i32, dest: usize, op1: MirOperand, op2: MirOperand) -> MirInstr {
        return MirInstr {
            opcode: opcode,
            dest_vreg: dest,
            op1: op1,
            op2: op2,
            callee_name: String.new(),
            target_block: 0usize,
            else_block: 0usize,
            escapes: false,
            is_dead: false,
        }
    }

    pub fn ret(val: MirOperand) -> MirInstr {
        return MirInstr {
            opcode: MIR_RETURN,
            dest_vreg: 0usize,
            op1: val,
            op2: MirOperand::const_int(0i64),
            callee_name: String.new(),
            target_block: 0usize,
            else_block: 0usize,
            escapes: false,
            is_dead: false,
        }
    }

    pub fn jump(target: usize) -> MirInstr {
        return MirInstr {
            opcode: MIR_JUMP,
            dest_vreg: 0usize,
            op1: MirOperand::const_int(0i64),
            op2: MirOperand::const_int(0i64),
            callee_name: String.new(),
            target_block: target,
            else_block: 0usize,
            escapes: false,
            is_dead: false,
        }
    }

    pub fn branch(cond: MirOperand, then_bb: usize, else_bb: usize) -> MirInstr {
        return MirInstr {
            opcode: MIR_BRANCH_COND,
            dest_vreg: 0usize,
            op1: cond,
            op2: MirOperand::const_int(0i64),
            callee_name: String.new(),
            target_block: then_bb,
            else_block: else_bb,
            escapes: false,
            is_dead: false,
        }
    }

    pub fn heap_alloc(dest: usize, bytes: i64) -> MirInstr {
        return MirInstr {
            opcode: MIR_HEAP_ALLOC,
            dest_vreg: dest,
            op1: MirOperand::const_int(bytes),
            op2: MirOperand::const_int(0i64),
            callee_name: String.new(),
            target_block: 0usize,
            else_block: 0usize,
            escapes: false,
            is_dead: false,
        }
    }

    pub fn vtable_call(dest: usize, trait_name: str, method_name: str, concrete_struct: str) -> MirInstr {
        var callee = String.from_str(trait_name)
        callee.push_str("::")
        callee.push_str(method_name)
        return MirInstr {
            opcode: MIR_VTABLE_CALL,
            dest_vreg: dest,
            op1: MirOperand::const_int(0i64),
            op2: MirOperand::const_int(0i64),
            callee_name: callee,
            target_block: 0usize,
            else_block: 0usize,
            escapes: false,
            is_dead: false,
        }
    }
}

// ------------------------------------------------------------------------------
// Basic Block & Control Flow Graph
// ------------------------------------------------------------------------------

pub struct MirBasicBlock {
    pub id: usize,
    pub name: String,
    pub instructions: Vec<MirInstr>,
    pub predecessors: Vec<usize>,
    pub successors: Vec<usize>,
}

impl MirBasicBlock {
    pub fn new(id: usize, name: str) -> MirBasicBlock {
        return MirBasicBlock {
            id: id,
            name: String.from_str(name),
            instructions: Vec.new(),
            predecessors: Vec.new(),
            successors: Vec.new(),
        }
    }

    pub fn append(var self, instr: MirInstr) {
        self.instructions.push(instr)
    }

    pub fn instr_count(self) -> usize {
        return self.instructions.len
    }
}

// ------------------------------------------------------------------------------
// MIR Function
// ------------------------------------------------------------------------------

pub struct MirFunction {
    pub name: String,
    pub blocks: Vec<MirBasicBlock>,
    pub next_vreg: usize,
    pub return_type: String,
}

impl MirFunction {
    pub fn new(name: str, ret_type: str) -> MirFunction {
        var f = MirFunction {
            name: String.from_str(name),
            blocks: Vec.new(),
            next_vreg: 1usize,
            return_type: String.from_str(ret_type),
        }
        // Create entry block 0
        f.blocks.push(MirBasicBlock::new(0usize, "entry"))
        return f
    }

    pub fn alloc_vreg(var self) -> usize {
        let v = self.next_vreg
        self.next_vreg = self.next_vreg + 1usize
        return v
    }

    pub fn add_block(var self, name: str) -> usize {
        let id = self.blocks.len
        self.blocks.push(MirBasicBlock::new(id, name))
        return id
    }

    pub fn total_instructions(self) -> usize {
        var cnt = 0usize
        var bi = 0usize
        while bi < self.blocks.len {
            cnt = cnt + self.blocks.ptr[bi].instructions.len
            bi = bi + 1usize
        }
        return cnt
    }
}

// ------------------------------------------------------------------------------
// Optimization Pipeline & Analysis Passes
// ------------------------------------------------------------------------------

pub struct MirOptStats {
    pub dce_eliminated: usize,
    pub sccp_folded: usize,
    pub cse_eliminated: usize,
    pub devirtualized: usize,
    pub stack_promoted: usize,
}

pub struct MirOptimizer {}

impl MirOptimizer {
    // 1. Dead Code Elimination (DCE): eliminates unreferenced pure assignments
    pub fn pass_dce(target: var MirFunction) -> usize {
        // Collect vreg usages
        var used = Vec.new()
        var bi = 0usize
        while bi < target.blocks.len {
            let bb = target.blocks.ptr[bi]
            var ii = 0usize
            while ii < bb.instructions.len {
                let inst = bb.instructions.ptr[ii]
                if inst.op1.kind == MIR_OP_VREG {
                    used.push(inst.op1.vreg_id)
                }
                if inst.op2.kind == MIR_OP_VREG {
                    used.push(inst.op2.vreg_id)
                }
                ii = ii + 1usize
            }
            bi = bi + 1usize
        }

        var eliminated = 0usize
        bi = 0usize
        while bi < target.blocks.len {
            var new_insts = Vec.new()
            var ii = 0usize
            while ii < target.blocks.ptr[bi].instructions.len {
                let inst = target.blocks.ptr[bi].instructions.ptr[ii]
                var is_pure = false
                if inst.opcode == MIR_ADD || inst.opcode == MIR_SUB || inst.opcode == MIR_MUL || inst.opcode == MIR_DIV || inst.opcode == MIR_EQ || inst.opcode == MIR_LT {
                    is_pure = true
                }
                var is_used = false
                var ui = 0usize
                while ui < used.len {
                    if used.ptr[ui] == inst.dest_vreg {
                        is_used = true
                        break
                    }
                    ui = ui + 1usize
                }

                if is_pure && !is_used && inst.dest_vreg != 0usize {
                    eliminated = eliminated + 1usize
                } else {
                    new_insts.push(inst)
                }
                ii = ii + 1usize
            }
            target.blocks.ptr[bi].instructions = new_insts
            bi = bi + 1usize
        }
        return eliminated
    }

    // 2. Sparse Conditional Constant Propagation (SCCP): fold constant expressions
    pub fn pass_sccp(target: var MirFunction) -> usize {
        var folded = 0usize
        var bi = 0usize
        while bi < target.blocks.len {
            var ii = 0usize
            while ii < target.blocks.ptr[bi].instructions.len {
                var inst = target.blocks.ptr[bi].instructions.ptr[ii]
                if inst.op1.kind == MIR_OP_CONST_INT && inst.op2.kind == MIR_OP_CONST_INT {
                    var folded_val = 0i64
                    var did_fold = false
                    if inst.opcode == MIR_ADD {
                        folded_val = inst.op1.int_val + inst.op2.int_val
                        did_fold = true
                    } else if inst.opcode == MIR_SUB {
                        folded_val = inst.op1.int_val - inst.op2.int_val
                        did_fold = true
                    } else if inst.opcode == MIR_MUL {
                        folded_val = inst.op1.int_val * inst.op2.int_val
                        did_fold = true
                    } else if inst.opcode == MIR_DIV && inst.op2.int_val != 0i64 {
                        folded_val = inst.op1.int_val / inst.op2.int_val
                        did_fold = true
                    } else if inst.opcode == MIR_EQ {
                        let eq_b = inst.op1.int_val == inst.op2.int_val
                        if eq_b { folded_val = 1i64 } else { folded_val = 0i64 }
                        did_fold = true
                    }

                    if did_fold {
                        inst.opcode = MIR_NOP
                        inst.op1 = MirOperand::const_int(folded_val)
                        target.blocks.ptr[bi].instructions.ptr[ii] = inst
                        folded = folded + 1usize
                    }
                }
                ii = ii + 1usize
            }
            bi = bi + 1usize
        }
        return folded
    }

    // 3. Common Subexpression Elimination (CSE): reuse identical pure computations
    pub fn pass_cse(target: var MirFunction) -> usize {
        var eliminated = 0usize
        var bi = 0usize
        while bi < target.blocks.len {
            var ii = 0usize
            while ii < target.blocks.ptr[bi].instructions.len {
                let inst1 = target.blocks.ptr[bi].instructions.ptr[ii]
                if inst1.opcode == MIR_ADD || inst1.opcode == MIR_SUB || inst1.opcode == MIR_MUL {
                    var jj = ii + 1usize
                    while jj < target.blocks.ptr[bi].instructions.len {
                        let inst2 = target.blocks.ptr[bi].instructions.ptr[jj]
                        if inst1.opcode == inst2.opcode && inst1.op1.kind == inst2.op1.kind && inst1.op2.kind == inst2.op2.kind {
                            var match_op = false
                            if inst1.op1.kind == MIR_OP_VREG && inst1.op1.vreg_id == inst2.op1.vreg_id && inst1.op2.vreg_id == inst2.op2.vreg_id {
                                match_op = true
                            }
                            if match_op {
                                // Replace inst2 with alias/move of inst1
                                target.blocks.ptr[bi].instructions.ptr[jj].opcode = MIR_NOP
                                target.blocks.ptr[bi].instructions.ptr[jj].op1 = MirOperand::vreg(inst1.dest_vreg)
                                eliminated = eliminated + 1usize
                            }
                        }
                        jj = jj + 1usize
                    }
                }
                ii = ii + 1usize
            }
            bi = bi + 1usize
        }
        return eliminated
    }

    // 4. Devirtualization: converts dyn Trait vtable dispatch into direct static function call
    pub fn pass_devirtualize(target: var MirFunction, concrete_type: str) -> usize {
        var devirtualized = 0usize
        var bi = 0usize
        while bi < target.blocks.len {
            var ii = 0usize
            while ii < target.blocks.ptr[bi].instructions.len {
                if target.blocks.ptr[bi].instructions.ptr[ii].opcode == MIR_VTABLE_CALL {
                    var new_callee = String.from_str(concrete_type)
                    new_callee.push_str("__")
                    new_callee.push_str(target.blocks.ptr[bi].instructions.ptr[ii].callee_name.as_ptr() as str)

                    target.blocks.ptr[bi].instructions.ptr[ii].opcode = MIR_CALL
                    target.blocks.ptr[bi].instructions.ptr[ii].callee_name = new_callee
                    devirtualized = devirtualized + 1usize
                }
                ii = ii + 1usize
            }
            bi = bi + 1usize
        }
        return devirtualized
    }

    // 5a. Flow-Sensitive Escape Analysis: tracks whether heap allocations escape the current function
    pub fn pass_escape_analysis(target: var MirFunction) -> usize {
        var non_escaping = 0usize
        var bi = 0usize
        while bi < target.blocks.len {
            var ii = 0usize
            while ii < target.blocks.ptr[bi].instructions.len {
                if target.blocks.ptr[bi].instructions.ptr[ii].opcode == MIR_HEAP_ALLOC {
                    let alloc_reg = target.blocks.ptr[bi].instructions.ptr[ii].dest_vreg
                    var does_escape = false

                    // Scan function instructions for escape uses (return or global store)
                    var b_scan = 0usize
                    while b_scan < target.blocks.len {
                        var i_scan = 0usize
                        while i_scan < target.blocks.ptr[b_scan].instructions.len {
                            let check = target.blocks.ptr[b_scan].instructions.ptr[i_scan]
                            if check.opcode == MIR_RETURN && check.op1.kind == MIR_OP_VREG && check.op1.vreg_id == alloc_reg {
                                does_escape = true
                            }
                            if check.opcode == MIR_STORE && check.op2.kind == MIR_OP_GLOBAL && check.op1.kind == MIR_OP_VREG && check.op1.vreg_id == alloc_reg {
                                does_escape = true
                            }
                            i_scan = i_scan + 1usize
                        }
                        b_scan = b_scan + 1usize
                    }

                    target.blocks.ptr[bi].instructions.ptr[ii].escapes = does_escape
                    if !does_escape {
                        non_escaping = non_escaping + 1usize
                    }
                }
                ii = ii + 1usize
            }
            bi = bi + 1usize
        }
        return non_escaping
    }

    // 5b. Stack Promotion via Escape Analysis: replace heap allocs with alloca when non-escaping
    pub fn pass_stack_promotion(target: var MirFunction) -> usize {
        var promoted = 0usize
        var bi = 0usize
        while bi < target.blocks.len {
            var ii = 0usize
            while ii < target.blocks.ptr[bi].instructions.len {
                let inst = target.blocks.ptr[bi].instructions.ptr[ii]
                if inst.opcode == MIR_HEAP_ALLOC && !inst.escapes {
                    target.blocks.ptr[bi].instructions.ptr[ii].opcode = MIR_ALLOCA
                    promoted = promoted + 1usize
                }
                ii = ii + 1usize
            }
            bi = bi + 1usize
        }
        return promoted
    }

    // Runs all optimization passes sequentially
    pub fn run_optimization_pipeline(target: var MirFunction, devirt_concrete: str) -> MirOptStats {
        let sccp = MirOptimizer::pass_sccp(target)
        let cse = MirOptimizer::pass_cse(target)
        let dce = MirOptimizer::pass_dce(target)
        let devirt = MirOptimizer::pass_devirtualize(target, devirt_concrete)
        let _esc = MirOptimizer::pass_escape_analysis(target)
        let stack = MirOptimizer::pass_stack_promotion(target)
        return MirOptStats {
            dce_eliminated: dce,
            sccp_folded: sccp,
            cse_eliminated: cse,
            devirtualized: devirt,
            stack_promoted: stack,
        }
    }
}
