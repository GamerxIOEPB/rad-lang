// ==============================================================================
// Rad Standard Library: HTTP/1.1 Engine (std::http)
// Pure-Rad HTTP Request/Response parser, Router, Server, and Client.
// Zero external C dynamic library dependencies.
// ==============================================================================

import std/net;
import std/event;
import std/compress;
import std/tls;
import std/os/linux/syscall;

pub struct HttpHeader {
    pub name: String,
    pub value: String,
}

pub struct HttpRequest {
    pub method: String,
    pub path: String,
    pub query: String,
    pub version: String,
    pub header_names: Vec<String>,
    pub header_values: Vec<String>,
    pub param_keys: Vec<String>,
    pub param_vals: Vec<String>,
    pub body: String,
}

impl HttpRequest {
    pub fn new() -> HttpRequest {
        return HttpRequest {
            method: String.from_str("GET"),
            path: String.from_str("/"),
            query: String.new(),
            version: String.from_str("HTTP/1.1"),
            header_names: Vec.new(),
            header_values: Vec.new(),
            param_keys: Vec.new(),
            param_vals: Vec.new(),
            body: String.new(),
        }
    }

    pub fn get_param(self, name: str) -> Option<String> {
        var i = 0usize
        while i < self.param_keys.len {
            if http_str_eq(self.param_keys.ptr[i].as_ptr() as str, name) {
                return Option.Some(self.param_vals.ptr[i])
            }
            i = i + 1usize
        }
        return Option.None
    }

    pub fn get_header(self, name: str) -> Option<String> {
        var i = 0usize
        while i < self.header_names.len {
            let hn = self.header_names.ptr[i].as_ptr() as str
            if http_case_insensitive_eq(hn, name) {
                return Option.Some(self.header_values.ptr[i])
            }
            i = i + 1usize
        }
        return Option.None
    }

    pub fn set_header(var self, name: str, value: str) {
        var found = false
        var i = 0usize
        while i < self.header_names.len {
            if http_case_insensitive_eq(self.header_names.ptr[i].as_ptr() as str, name) {
                self.header_values.ptr[i] = String.from_str(value)
                found = true
                break
            }
            i = i + 1usize
        }
        if !found {
            self.header_names.push(String.from_str(name))
            self.header_values.push(String.from_str(value))
        }
    }

    pub fn get_query_param(self, key: str) -> Option<String> {
        let q = self.query.as_ptr() as str
        let qlen = http_str_len(q)
        let klen = http_str_len(key)
        if qlen == 0usize || klen == 0usize {
            return Option.None
        }
        let p = q as *raw u8
        var i = 0usize
        while i < qlen {
            // Find key match at start or after '&'
            var is_matched = false
            if i == 0usize || p[i - 1usize] == 38u8 { // '&'
                if i + klen <= qlen {
                    var m = true
                    var ki = 0usize
                    while ki < klen {
                        if p[i + ki] != (key as *raw u8)[ki] {
                            m = false
                            break
                        }
                        ki = ki + 1usize
                    }
                    if m && (i + klen == qlen || p[i + klen] == 61u8 || p[i + klen] == 38u8) { // '=' or '&'
                        is_matched = true
                    }
                }
            }
            if is_matched {
                let vstart = i + klen + 1usize
                if vstart > qlen || p[i + klen] != 61u8 {
                    return Option.Some(String.new())
                }
                var vend = vstart
                while vend < qlen && p[vend] != 38u8 {
                    vend = vend + 1usize
                }
                var val = String.new()
                var vi = vstart
                while vi < vend {
                    val.push_byte(p[vi])
                    vi = vi + 1usize
                }
                val.push_byte(0u8)
                return Option.Some(val)
            }
            i = i + 1usize
        }
        return Option.None
    }
}

pub struct HttpResponse {
    pub status_code: i32,
    pub status_text: String,
    pub header_names: Vec<String>,
    pub header_values: Vec<String>,
    pub body: String,
}

impl HttpResponse {
    pub fn new(code: i32, text: str) -> HttpResponse {
        return HttpResponse {
            status_code: code,
            status_text: String.from_str(text),
            header_names: Vec.new(),
            header_values: Vec.new(),
            body: String.new(),
        }
    }

    pub fn ok(body_str: str) -> HttpResponse {
        var res = HttpResponse.new(200, "OK")
        res.body = String.from_str(body_str)
        res.set_header("Content-Type", "text/plain; charset=utf-8")
        res.set_header("Content-Length", http_int_to_str(http_str_len(body_str) as i64).as_ptr() as str)
        return res
    }

    pub fn json(json_str: str) -> HttpResponse {
        var res = HttpResponse.new(200, "OK")
        res.body = String.from_str(json_str)
        res.set_header("Content-Type", "application/json")
        res.set_header("Content-Length", http_int_to_str(http_str_len(json_str) as i64).as_ptr() as str)
        return res
    }

    pub fn html(html_str: str) -> HttpResponse {
        var res = HttpResponse.new(200, "OK")
        res.body = String.from_str(html_str)
        res.set_header("Content-Type", "text/html; charset=utf-8")
        res.set_header("Content-Length", http_int_to_str(http_str_len(html_str) as i64).as_ptr() as str)
        return res
    }

    pub fn not_found() -> HttpResponse {
        var res = HttpResponse.new(404, "Not Found")
        let b = "404 Not Found"
        res.body = String.from_str(b)
        res.set_header("Content-Type", "text/plain")
        res.set_header("Content-Length", http_int_to_str(http_str_len(b) as i64).as_ptr() as str)
        return res
    }

    pub fn bad_request(msg: str) -> HttpResponse {
        var res = HttpResponse.new(400, "Bad Request")
        res.body = String.from_str(msg)
        res.set_header("Content-Type", "text/plain")
        res.set_header("Content-Length", http_int_to_str(http_str_len(msg) as i64).as_ptr() as str)
        return res
    }

    pub fn internal_error(msg: str) -> HttpResponse {
        var res = HttpResponse.new(500, "Internal Server Error")
        res.body = String.from_str(msg)
        res.set_header("Content-Type", "text/plain")
        res.set_header("Content-Length", http_int_to_str(http_str_len(msg) as i64).as_ptr() as str)
        return res
    }

    pub fn set_header(var self, name: str, value: str) {
        var found = false
        var i = 0usize
        while i < self.header_names.len {
            if http_case_insensitive_eq(self.header_names.ptr[i].as_ptr() as str, name) {
                self.header_values.ptr[i] = String.from_str(value)
                found = true
                break
            }
            i = i + 1usize
        }
        if !found {
            self.header_names.push(String.from_str(name))
            self.header_values.push(String.from_str(value))
        }
    }

    pub fn get_header(self, name: str) -> Option<String> {
        var i = 0usize
        while i < self.header_names.len {
            if http_case_insensitive_eq(self.header_names.ptr[i].as_ptr() as str, name) {
                return Option.Some(self.header_values.ptr[i])
            }
            i = i + 1usize
        }
        return Option.None
    }

    pub fn to_wire(self) -> String {
        var wire = String.new()
        wire.push_str("HTTP/1.1 ")
        wire.push_str(http_int_to_str(self.status_code as i64).as_ptr() as str)
        wire.push_str(" ")
        wire.push_str(self.status_text.as_ptr() as str)
        wire.push_str("\r\n")

        var i = 0usize
        while i < self.header_names.len {
            wire.push_str(self.header_names.ptr[i].as_ptr() as str)
            wire.push_str(": ")
            wire.push_str(self.header_values.ptr[i].as_ptr() as str)
            wire.push_str("\r\n")
            i = i + 1usize
        }
        wire.push_str("\r\n")
        if self.body.len() > 0usize {
            wire.push_str(self.body.as_ptr() as str)
        }
        wire.push_byte(0u8)
        return wire
    }
}

// ------------------------------------------------------------------------------
// HTTP Parsing Utilities
// ------------------------------------------------------------------------------

fn http_str_len(s: str) -> usize {
    if (s as usize) == 0usize {
        return 0usize
    }
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

fn http_str_eq(a: str, b: str) -> bool {
    let pa = a as *raw u8
    let pb = b as *raw u8
    var i = 0usize
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] {
            return false
        }
        i = i + 1usize
    }
    return pa[i] == 0u8 && pb[i] == 0u8
}

fn http_str_starts_with(s: str, prefix: str) -> bool {
    let ps = s as *raw u8
    let pp = prefix as *raw u8
    var i = 0usize
    while pp[i] != 0u8 {
        if ps[i] == 0u8 || ps[i] != pp[i] {
            return false
        }
        i = i + 1usize
    }
    return true
}

fn http_str_ends_with(s: str, suffix: str) -> bool {
    let slen = http_str_len(s)
    let sublen = http_str_len(suffix)
    if sublen > slen { return false }
    let ps = s as *raw u8
    let psub = suffix as *raw u8
    var i = 0usize
    let offset = slen - sublen
    while i < sublen {
        if ps[offset + i] != psub[i] {
            return false
        }
        i = i + 1usize
    }
    return true
}

fn http_str_contains(s: str, sub: str) -> bool {
    let slen = http_str_len(s)
    let sublen = http_str_len(sub)
    if sublen == 0usize { return true }
    if sublen > slen { return false }
    let ps = s as *raw u8
    let psub = sub as *raw u8
    var i = 0usize
    while i + sublen <= slen {
        var j = 0usize
        var matched = true
        while j < sublen {
            if ps[i + j] != psub[j] {
                matched = false
                break
            }
            j = j + 1usize
        }
        if matched { return true }
        i = i + 1usize
    }
    return false
}

fn http_to_lower(c: u8) -> u8 {
    if c >= 65u8 && c <= 90u8 {
        return c + 32u8
    }
    return c
}

fn http_case_insensitive_eq(a: str, b: str) -> bool {
    let pa = a as *raw u8
    let pb = b as *raw u8
    var i = 0usize
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if http_to_lower(pa[i]) != http_to_lower(pb[i]) {
            return false
        }
        i = i + 1usize
    }
    return pa[i] == 0u8 && pb[i] == 0u8
}

fn http_int_to_str(val: i64) -> String {
    if val == 0i64 {
        return String.from_str("0")
    }
    var v = val
    var is_neg = false
    if v < 0i64 {
        is_neg = true
        v = -v
    }
    var rev = String.new()
    while v > 0i64 {
        let digit = (v % 10i64) as u8
        rev.push_byte(48u8 + digit)
        v = v / 10i64
    }
    if is_neg {
        rev.push_byte(45u8)
    }
    var res = String.new()
    var len = rev.len()
    let p = rev.as_ptr()
    while len > 0usize {
        len = len - 1usize
        res.push_byte(p[len])
    }
    res.push_byte(0u8)
    return res
}

fn http_str_to_int(s: str) -> i64 {
    let p = s as *raw u8
    let len = http_str_len(s)
    var res = 0i64
    var i = 0usize
    while i < len && p[i] >= 48u8 && p[i] <= 57u8 {
        res = res * 10i64 + ((p[i] - 48u8) as i64)
        i = i + 1usize
    }
    return res
}

pub fn parse_http_request(raw: str) -> Option<HttpRequest> {
    let total_len = http_str_len(raw)
    if total_len < 10usize {
        return Option.None
    }
    let p = raw as *raw u8
    var pos = 0usize

    // 1. Method
    var method = String.new()
    while pos < total_len && p[pos] != 32u8 && p[pos] != 13u8 && p[pos] != 10u8 {
        method.push_byte(p[pos])
        pos = pos + 1usize
    }
    method.push_byte(0u8)
    if pos >= total_len || p[pos] != 32u8 {
        return Option.None
    }
    pos = pos + 1usize // Skip ' '

    // 2. Full Path (Path + optional '?' + Query)
    var raw_target = String.new()
    while pos < total_len && p[pos] != 32u8 && p[pos] != 13u8 && p[pos] != 10u8 {
        raw_target.push_byte(p[pos])
        pos = pos + 1usize
    }
    raw_target.push_byte(0u8)
    if pos >= total_len || p[pos] != 32u8 {
        return Option.None
    }
    pos = pos + 1usize // Skip ' '

    // Split raw_target into path and query
    var path = String.new()
    var query = String.new()
    let rt_p = raw_target.as_ptr()
    let rt_len = raw_target.len()
    var in_query = false
    var rti = 0usize
    while rti < rt_len {
        let b = rt_p[rti]
        if b == 0u8 {
            break
        }
        if b == 63u8 && !in_query { // '?'
            in_query = true
        } else if in_query {
            query.push_byte(b)
        } else {
            path.push_byte(b)
        }
        rti = rti + 1usize
    }
    path.push_byte(0u8)
    query.push_byte(0u8)

    // 3. HTTP Version
    var version = String.new()
    while pos < total_len && p[pos] != 13u8 && p[pos] != 10u8 {
        version.push_byte(p[pos])
        pos = pos + 1usize
    }
    version.push_byte(0u8)

    // Skip \r\n after request line
    if pos < total_len && p[pos] == 13u8 { pos = pos + 1usize }
    if pos < total_len && p[pos] == 10u8 { pos = pos + 1usize }

    // 4. Headers
    var header_names = Vec.new()
    var header_values = Vec.new()
    while pos < total_len {
        // Check for end of headers (\r\n or \n)
        if p[pos] == 13u8 && pos + 1usize < total_len && p[pos + 1usize] == 10u8 {
            pos = pos + 2usize
            break
        }
        if p[pos] == 10u8 {
            pos = pos + 1usize
            break
        }

        // Header name
        var h_name = String.new()
        while pos < total_len && p[pos] != 58u8 && p[pos] != 13u8 && p[pos] != 10u8 {
            h_name.push_byte(p[pos])
            pos = pos + 1usize
        }
        h_name.push_byte(0u8)
        if pos < total_len && p[pos] == 58u8 { // ':'
            pos = pos + 1usize
        }
        // Skip leading whitespace in value
        while pos < total_len && (p[pos] == 32u8 || p[pos] == 9u8) {
            pos = pos + 1usize
        }
        // Header value
        var h_val = String.new()
        while pos < total_len && p[pos] != 13u8 && p[pos] != 10u8 {
            h_val.push_byte(p[pos])
            pos = pos + 1usize
        }
        h_val.push_byte(0u8)

        if pos < total_len && p[pos] == 13u8 { pos = pos + 1usize }
        if pos < total_len && p[pos] == 10u8 { pos = pos + 1usize }

        if h_name.len() > 0usize {
            header_names.push(h_name)
            header_values.push(h_val)
        }
    }

    // 5. Body
    var body = String.new()
    while pos < total_len {
        body.push_byte(p[pos])
        pos = pos + 1usize
    }
    body.push_byte(0u8)

    return Option.Some(HttpRequest {
        method: method,
        path: path,
        query: query,
        version: version,
        header_names: header_names,
        header_values: header_values,
        param_keys: Vec.new(),
        param_vals: Vec.new(),
        body: body,
    })
}

pub fn parse_http_response(raw: str) -> Option<HttpResponse> {
    let total_len = http_str_len(raw)
    if total_len < 12usize {
        return Option.None
    }
    let p = raw as *raw u8
    var pos = 0usize

    // Version
    while pos < total_len && p[pos] != 32u8 {
        pos = pos + 1usize
    }
    if pos >= total_len { return Option.None }
    pos = pos + 1usize // Skip ' '

    // Status code
    var code_str = String.new()
    while pos < total_len && p[pos] >= 48u8 && p[pos] <= 57u8 {
        code_str.push_byte(p[pos])
        pos = pos + 1usize
    }
    code_str.push_byte(0u8)
    let status_code = http_str_to_int(code_str.as_ptr() as str) as i32
    if pos < total_len && p[pos] == 32u8 { pos = pos + 1usize }

    // Status text
    var status_text = String.new()
    while pos < total_len && p[pos] != 13u8 && p[pos] != 10u8 {
        status_text.push_byte(p[pos])
        pos = pos + 1usize
    }
    status_text.push_byte(0u8)

    if pos < total_len && p[pos] == 13u8 { pos = pos + 1usize }
    if pos < total_len && p[pos] == 10u8 { pos = pos + 1usize }

    // Headers
    var header_names = Vec.new()
    var header_values = Vec.new()
    while pos < total_len {
        if p[pos] == 13u8 && pos + 1usize < total_len && p[pos + 1usize] == 10u8 {
            pos = pos + 2usize
            break
        }
        if p[pos] == 10u8 {
            pos = pos + 1usize
            break
        }

        var h_name = String.new()
        while pos < total_len && p[pos] != 58u8 && p[pos] != 13u8 && p[pos] != 10u8 {
            h_name.push_byte(p[pos])
            pos = pos + 1usize
        }
        h_name.push_byte(0u8)
        if pos < total_len && p[pos] == 58u8 { pos = pos + 1usize }
        while pos < total_len && (p[pos] == 32u8 || p[pos] == 9u8) {
            pos = pos + 1usize
        }
        var h_val = String.new()
        while pos < total_len && p[pos] != 13u8 && p[pos] != 10u8 {
            h_val.push_byte(p[pos])
            pos = pos + 1usize
        }
        h_val.push_byte(0u8)

        if pos < total_len && p[pos] == 13u8 { pos = pos + 1usize }
        if pos < total_len && p[pos] == 10u8 { pos = pos + 1usize }

        if h_name.len() > 0usize {
            header_names.push(h_name)
            header_values.push(h_val)
        }
    }

    // Body
    var body = String.new()
    while pos < total_len {
        body.push_byte(p[pos])
        pos = pos + 1usize
    }
    body.push_byte(0u8)

    return Option.Some(HttpResponse {
        status_code: status_code,
        status_text: status_text,
        header_names: header_names,
        header_values: header_values,
        body: body,
    })
}

// ------------------------------------------------------------------------------
// HTTP Router
// ------------------------------------------------------------------------------

pub struct HttpRoute {
    pub method: String,
    pub path: String,
    pub handler_id: i32,
}

pub struct HttpRouter {
    pub routes: Vec<HttpRoute>,
}

impl HttpRouter {
    pub fn new() -> HttpRouter {
        return HttpRouter {
            routes: Vec.new(),
        }
    }

    pub fn add_route(var self, method: str, path: str, handler_id: i32) {
        self.routes.push(HttpRoute {
            method: String.from_str(method),
            path: String.from_str(path),
            handler_id: handler_id,
        })
    }

    pub fn get(var self, path: str, handler_id: i32) {
        self.routes.push(HttpRoute {
            method: String.from_str("GET"),
            path: String.from_str(path),
            handler_id: handler_id,
        })
    }

    pub fn post(var self, path: str, handler_id: i32) {
        self.routes.push(HttpRoute {
            method: String.from_str("POST"),
            path: String.from_str(path),
            handler_id: handler_id,
        })
    }

    pub fn match_route_with_params(self, method: str, path: str, out_keys: Vec<String>, out_vals: Vec<String>) -> i32 {
        var i = 0usize
        while i < self.routes.len {
            let r = self.routes.ptr[i]
            if http_str_eq(r.method.as_ptr() as str, method) {
                let r_path = r.path.as_ptr() as str
                if http_str_eq(r_path, path) {
                    return r.handler_id
                }
                if http_str_contains(r_path, ":") {
                    var tmp_keys = Vec.new()
                    var tmp_vals = Vec.new()
                    if match_path_pattern(r_path, path, tmp_keys, tmp_vals) {
                        var ki = 0usize
                        while ki < tmp_keys.len {
                            out_keys.push(tmp_keys.ptr[ki])
                            out_vals.push(tmp_vals.ptr[ki])
                            ki = ki + 1usize
                        }
                        return r.handler_id
                    }
                }
            }
            i = i + 1usize
        }
        return -1
    }

    pub fn match_route(self, method: str, path: str) -> i32 {
        let dummy_k = Vec.new()
        let dummy_v = Vec.new()
        return self.match_route_with_params(method, path, dummy_k, dummy_v)
    }
}

fn match_path_pattern(pattern: str, actual: str, out_keys: Vec<String>, out_vals: Vec<String>) -> bool {
    let p_len = http_str_len(pattern)
    let a_len = http_str_len(actual)
    if p_len == 0usize && a_len == 0usize { return true }
    if p_len == 0usize || a_len == 0usize { return false }

    let pp = pattern as *raw u8
    let ap = actual as *raw u8
    var pi = 0usize
    var ai = 0usize
    while pi < p_len && ai < a_len {
        while pi < p_len && pp[pi] == 47u8 { pi = pi + 1usize }
        while ai < a_len && ap[ai] == 47u8 { ai = ai + 1usize }
        if pi >= p_len && ai >= a_len { return true }
        if pi >= p_len || ai >= a_len { return false }

        var p_seg = String.new()
        while pi < p_len && pp[pi] != 47u8 {
            p_seg.push_byte(pp[pi])
            pi = pi + 1usize
        }
        p_seg.push_byte(0u8)

        var a_seg = String.new()
        while ai < a_len && ap[ai] != 47u8 {
            a_seg.push_byte(ap[ai])
            ai = ai + 1usize
        }
        a_seg.push_byte(0u8)

        let ps = p_seg.as_ptr() as str
        let as_str = a_seg.as_ptr() as str
        if http_str_starts_with(ps, ":") {
            let key = (ps as usize + 1usize) as str
            out_keys.push(String.from_str(key))
            out_vals.push(String.from_str(as_str))
        } else {
            if !http_str_eq(ps, as_str) {
                return false
            }
        }
    }
    while pi < p_len && pp[pi] == 47u8 { pi = pi + 1usize }
    while ai < a_len && ap[ai] == 47u8 { ai = ai + 1usize }
    return pi == p_len && ai == a_len
}

// ------------------------------------------------------------------------------
// SHA-1 & Base64 Primitives for WebSocket Handshake (RFC 6455)
// ------------------------------------------------------------------------------

fn sha1_rotl(v: u32, n: u32) -> u32 {
    let uv = (v as u64) & 4294967295u64
    let r1 = (uv << (n as u64)) & 4294967295u64
    let r2 = uv >> ((32u32 - n) as u64)
    return (((r1 | r2) & 4294967295u64) as u32)
}

fn sha1_digest_20bytes(msg: str, out_buf: *raw var u8) {
    let len = http_str_len(msg)
    let p_msg = msg as *raw u8

    var h0: u32 = 0x67452301u32
    var h1: u32 = 0xEFCDAB89u32
    var h2: u32 = 0x98BADCFEu32
    var h3: u32 = 0x10325476u32
    var h4: u32 = 0xC3D2E1F0u32

    let padded_len = ((len + 9usize + 63usize) / 64usize) * 64usize
    let buf = malloc(padded_len) as *raw var u8
    var i = 0usize
    while i < padded_len {
        buf[i] = 0u8
        i = i + 1usize
    }
    i = 0usize
    while i < len {
        buf[i] = p_msg[i]
        i = i + 1usize
    }
    buf[len] = 0x80u8

    let bit_len = (len as u64) * 8u64
    var bi = 0usize
    while bi < 8usize {
        let shift = ((7usize - bi) * 8usize) as u64
        buf[padded_len - 8usize + bi] = ((bit_len >> shift) & 255u64) as u8
        bi = bi + 1usize
    }

    var chunk = 0usize
    let w = malloc(80usize * 4usize) as *raw var u32
    while chunk < padded_len {
        var t = 0usize
        while t < 16usize {
            let idx = chunk + t * 4usize
            w[t] = ((buf[idx] as u32) << 24u32) |
                   ((buf[idx + 1usize] as u32) << 16u32) |
                   ((buf[idx + 2usize] as u32) << 8u32) |
                   (buf[idx + 3usize] as u32)
            t = t + 1usize
        }
        while t < 80usize {
            let xor_val = w[t - 3usize] ^ w[t - 8usize] ^ w[t - 14usize] ^ w[t - 16usize]
            w[t] = sha1_rotl(xor_val, 1u32)
            t = t + 1usize
        }

        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4

        var round = 0usize
        while round < 80usize {
            var f: u32 = 0u32
            var k: u32 = 0u32
            if round < 20usize {
                f = d ^ (b & (c ^ d))
                k = 0x5A827999u32
            } else if round < 40usize {
                f = b ^ c ^ d
                k = 0x6ED9EBA1u32
            } else if round < 60usize {
                f = (b & c) | (b & d) | (c & d)
                k = 0x8F1BBCDCu32
            } else {
                f = b ^ c ^ d
                k = 0xCA62C1D6u32
            }
            let temp = (((sha1_rotl(a, 5u32) as u64 + f as u64 + e as u64 + k as u64 + w[round] as u64) & 4294967295u64) as u32)
            e = d
            d = c
            c = sha1_rotl(b, 30u32)
            b = a
            a = temp
            round = round + 1usize
        }

        h0 = ((h0 as u64 + a as u64) & 4294967295u64) as u32
        h1 = ((h1 as u64 + b as u64) & 4294967295u64) as u32
        h2 = ((h2 as u64 + c as u64) & 4294967295u64) as u32
        h3 = ((h3 as u64 + d as u64) & 4294967295u64) as u32
        h4 = ((h4 as u64 + e as u64) & 4294967295u64) as u32

        chunk = chunk + 64usize
    }

    free(w as *raw var u8)
    free(buf as *raw var u8)

    let h_arr = [h0, h1, h2, h3, h4]
    var hi = 0usize
    while hi < 5usize {
        let val = h_arr[hi]
        out_buf[hi * 4usize] = ((val >> 24u32) & 255u32) as u8
        out_buf[hi * 4usize + 1usize] = ((val >> 16u32) & 255u32) as u8
        out_buf[hi * 4usize + 2usize] = ((val >> 8u32) & 255u32) as u8
        out_buf[hi * 4usize + 3usize] = (val & 255u32) as u8
        hi = hi + 1usize
    }
}

fn base64_encode(bytes: *raw u8, len: usize) -> String {
    var s = String.new()
    var i = 0usize
    while i < len {
        let b0 = bytes[i] as u32
        var b1 = 0u32
        var b2 = 0u32
        if i + 1usize < len { b1 = bytes[i + 1usize] as u32 }
        if i + 2usize < len { b2 = bytes[i + 2usize] as u32 }
        let trip = (b0 << 16u32) | (b1 << 8u32) | b2
        let c0 = ((trip >> 18u32) & 63u32) as usize
        let c1 = ((trip >> 12u32) & 63u32) as usize
        let c2 = ((trip >> 6u32) & 63u32) as usize
        let c3 = (trip & 63u32) as usize
        let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" as *raw u8
        s.push_byte(table[c0])
        s.push_byte(table[c1])
        if i + 1usize < len {
            s.push_byte(table[c2])
        } else {
            s.push_byte(61u8) // '='
        }
        if i + 2usize < len {
            s.push_byte(table[c3])
        } else {
            s.push_byte(61u8) // '='
        }
        i = i + 3usize
    }
    s.push_byte(0u8)
    return s
}

pub fn ws_upgrade_handshake(req: HttpRequest) -> Option<HttpResponse> {
    match req.get_header("Sec-WebSocket-Key") {
        Option.Some(key) => {
            var full_key = String.new()
            full_key.push_str(key.as_ptr() as str)
            full_key.push_str("258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
            full_key.push_byte(0u8)
            let out_digest = malloc(20usize) as *raw var u8
            sha1_digest_20bytes(full_key.as_ptr() as str, out_digest)
            let accept = base64_encode(out_digest as *raw u8, 20usize)
            free(out_digest as *raw var u8)

            var resp = HttpResponse.new(101, "Switching Protocols")
            resp.set_header("Upgrade", "websocket")
            resp.set_header("Connection", "Upgrade")
            resp.set_header("Sec-WebSocket-Accept", accept.as_ptr() as str)
            return Option.Some(resp)
        },
        Option.None => {
            return Option.None
        },
    }
}

pub fn handle_static_file(filepath: str, enable_gzip: bool) -> HttpResponse {
    let fp = fopen(filepath, "rb")
    if (fp as usize) == 0usize {
        return HttpResponse.not_found()
    }
    fseek(fp, 0i64, 2)
    let fsize = ftell(fp) as usize
    fseek(fp, 0i64, 0)
    let buf = malloc(fsize + 1usize) as *raw var u8
    fread(buf as ptr, 1usize, fsize, fp)
    fclose(fp)
    buf[fsize] = 0u8

    var mime = "text/plain"
    if http_str_ends_with(filepath, ".html") { mime = "text/html; charset=utf-8" }
    else if http_str_ends_with(filepath, ".css") { mime = "text/css" }
    else if http_str_ends_with(filepath, ".js") { mime = "application/javascript" }
    else if http_str_ends_with(filepath, ".json") { mime = "application/json" }
    else if http_str_ends_with(filepath, ".png") { mime = "image/png" }
    else if http_str_ends_with(filepath, ".wasm") { mime = "application/wasm" }

    var resp = HttpResponse.new(200, "OK")
    resp.set_header("Content-Type", mime)
    if enable_gzip && fsize > 128usize {
        let gzipped = gzip_compress(buf as str)
        resp.body = gzipped
        resp.set_header("Content-Encoding", "gzip")
        resp.set_header("Content-Length", http_int_to_str(gzipped.len as i64).as_ptr() as str)
    } else {
        resp.body = String.from_str(buf as str)
        resp.set_header("Content-Length", http_int_to_str(fsize as i64).as_ptr() as str)
    }
    free(buf as *raw var u8)
    return resp
}

// ------------------------------------------------------------------------------
// HTTP Server (Event-Driven Async Reactor via Linux epoll)
// ------------------------------------------------------------------------------

pub struct HttpServer {
    pub port: u16,
    pub router: HttpRouter,
    pub is_running: bool,
}

impl HttpServer {
    pub fn new(port: u16) -> HttpServer {
        return HttpServer {
            port: port,
            router: HttpRouter.new(),
            is_running: false,
        }
    }

    pub fn set_router(var self, r: HttpRouter) {
        self.router = r
    }

    pub fn serve_event_loop(var self, max_iterations: i32) -> i32 {
        var listener: TcpListener = TcpListener { fd: -1, is_bound: false }
        match TcpListener.bind("127.0.0.1", self.port) {
            Option.Some(l) => { listener = l },
            Option.None => { return -1 },
        }
        var el = EventLoop { epoll_fd: -1, is_closed: false }
        match EventLoop.new() {
            Option.Some(l) => { el = l },
            Option.None => {
                listener.close()
                return -2
            },
        }

        // Set listener non-blocking via syscall fcntl (SYS_fcntl = 72, F_GETFL = 3, F_SETFL = 4, O_NONBLOCK = 2048)
        let flags = syscall3(72i64, listener.fd as i64, 3i64, 0i64)
        let _ = syscall3(72i64, listener.fd as i64, 4i64, flags | 2048i64)
        let _ = el.add(listener.fd, EPOLLIN | EPOLLET, listener.fd as u64)
        self.is_running = true

        var processed_requests = 0i32
        let events = malloc(16usize * 64usize) as *raw var u8
        var iter = 0i32
        while self.is_running && (max_iterations <= 0i32 || iter < max_iterations) {
            iter = iter + 1i32
            let num_events = syscall4(232i64, el.epoll_fd as i64, events as i64, 64i64, 50i64) as i32
            var ei = 0i32
            while ei < num_events {
                let ev_ptr = ((events as usize) + (ei as usize) * 16usize) as *raw u32
                let ev_flags = ev_ptr[0usize]
                let ev_fd = (((events as usize) + (ei as usize) * 16usize + 4usize) as *raw u64)[0usize] as i32

                if ev_fd == listener.fd {
                    match listener.accept() {
                        Option.Some(client) => {
                            let cflags = syscall3(72i64, client.fd as i64, 3i64, 0i64)
                            let _ = syscall3(72i64, client.fd as i64, 4i64, cflags | 2048i64)
                            let _ = el.add(client.fd, EPOLLIN | EPOLLET, client.fd as u64)
                        },
                        Option.None => {},
                    }
                } else if (ev_flags & EPOLLIN) != 0u32 {
                    var client = TcpStream { fd: ev_fd, is_connected: true }
                    let req_buf = malloc(4096usize) as *raw var u8
                    let bytes_read = client.read(req_buf, 4095usize)
                    if bytes_read > 0i64 {
                        req_buf[bytes_read as usize] = 0u8
                        match parse_http_request(req_buf as str) {
                            Option.Some(req) => {
                                var resp = HttpResponse.not_found()
                                match ws_upgrade_handshake(req) {
                                    Option.Some(ws_resp) => {
                                        resp = ws_resp
                                    },
                                    Option.None => {
                                        let h_id = self.router.match_route_with_params(
                                            req.method.as_ptr() as str,
                                            req.path.as_ptr() as str,
                                            req.param_keys,
                                            req.param_vals
                                        )
                                        if h_id >= 0 {
                                            resp = HttpResponse.ok("OK from async epoll reactor")
                                        }
                                    },
                                }
                                let wire = resp.to_wire()
                                let _ = client.write_str(wire.as_ptr() as str)
                                processed_requests = processed_requests + 1i32
                            },
                            Option.None => {},
                        }
                    }
                    free(req_buf as *raw var u8)
                    el.remove(client.fd)
                    client.close()
                }
                ei = ei + 1i32
            }
        }
        free(events as *raw var u8)
        el.remove(listener.fd)
        listener.close()
        return processed_requests
    }
}

// ------------------------------------------------------------------------------
// HTTP Client
// ------------------------------------------------------------------------------

pub struct HttpClient {}

impl HttpClient {
    pub fn request(method: str, url: str, body: str, content_type: str) -> Option<HttpResponse> {
        let ulen = http_str_len(url)
        if ulen < 7usize {
            return Option.None
        }
        let p = url as *raw u8
        var pos = 0usize
        var is_https = false
        var port = 80u16

        if http_str_starts_with(url, "https://") {
            pos = 8usize
            is_https = true
            port = 443u16
        } else if http_str_starts_with(url, "http://") {
            pos = 7usize
            is_https = false
            port = 80u16
        }

        var host = String.new()
        while pos < ulen && p[pos] != 58u8 && p[pos] != 47u8 {
            host.push_byte(p[pos])
            pos = pos + 1usize
        }
        host.push_byte(0u8)

        if pos < ulen && p[pos] == 58u8 { // ':'
            pos = pos + 1usize
            var port_str = String.new()
            while pos < ulen && p[pos] >= 48u8 && p[pos] <= 57u8 {
                port_str.push_byte(p[pos])
                pos = pos + 1usize
            }
            port_str.push_byte(0u8)
            let parsed_port = http_str_to_int(port_str.as_ptr() as str)
            if parsed_port > 0i64 && parsed_port <= 65535i64 {
                port = parsed_port as u16
            }
        }

        var path = String.new()
        if pos < ulen && p[pos] == 47u8 { // '/'
            while pos < ulen {
                path.push_byte(p[pos])
                pos = pos + 1usize
            }
        } else {
            path.push_str("/")
        }
        path.push_byte(0u8)

        // Resolve host
        var host_ip = String.from_str(host.as_ptr() as str)
        if http_str_eq(host.as_ptr() as str, "localhost") {
            host_ip = String.from_str("127.0.0.1")
        }

        // Build wire request
        var req = String.new()
        req.push_str(method)
        req.push_str(" ")
        req.push_str(path.as_ptr() as str)
        req.push_str(" HTTP/1.1\r\n")
        req.push_str("Host: ")
        req.push_str(host.as_ptr() as str)
        req.push_str("\r\n")
        req.push_str("Connection: close\r\n")

        let blen = http_str_len(body)
        if blen > 0usize {
            if http_str_len(content_type) > 0usize {
                req.push_str("Content-Type: ")
                req.push_str(content_type)
                req.push_str("\r\n")
            }
            req.push_str("Content-Length: ")
            req.push_str(http_int_to_str(blen as i64).as_ptr() as str)
            req.push_str("\r\n")
        }
        req.push_str("\r\n")
        if blen > 0usize {
            req.push_str(body)
        }
        req.push_byte(0u8)

        let resp_buf = malloc(65536usize) as *raw var u8
        var bytes_read: i64 = 0i64

        if is_https {
            let tls_opt = TlsStream.connect(host_ip.as_ptr() as str, port)
            match tls_opt {
                Option.Some(t) => {
                    var tls = t
                    let _ = tls.write_str(req.as_ptr() as str)
                    bytes_read = tls.read(resp_buf, 65535usize)
                    tls.close()
                },
                Option.None => {
                    free(resp_buf as *raw var u8)
                    return Option.None
                },
            }
        } else {
            let tcp_opt = TcpStream.connect(host_ip.as_ptr() as str, port)
            match tcp_opt {
                Option.Some(s) => {
                    var stream = s
                    let _ = stream.write_str(req.as_ptr() as str)
                    bytes_read = stream.read(resp_buf, 65535usize)
                    stream.close()
                },
                Option.None => {
                    free(resp_buf as *raw var u8)
                    return Option.None
                },
            }
        }

        if bytes_read <= 0i64 {
            free(resp_buf as *raw var u8)
            return Option.None
        }
        resp_buf[bytes_read as usize] = 0u8
        let parsed = parse_http_response(resp_buf as str)
        free(resp_buf as *raw var u8)
        return parsed
    }

    pub fn get(url: str) -> Option<HttpResponse> {
        return HttpClient.request("GET", url, "", "")
    }

    pub fn post(url: str, content_type: str, body: str) -> Option<HttpResponse> {
        return HttpClient.request("POST", url, body, content_type)
    }
}
