// ==============================================================================
// Rad Standard Library: Process Spawning and Environment
// Safe, shell-injection-free argument vector execution, pipe capture, and signals.
// Pure Linux syscalls: SYS_fork (57), SYS_execve (59), SYS_wait4 (61), SYS_pipe (22).
// ==============================================================================

extern "C" {
    fn getenv(name: str) -> *raw u8;
    fn setenv(name: str, val: str, overwrite: i32) -> i32;
    fn system(cmd: str) -> i32;
}

fn proc_str_len(s: str) -> usize {
    let p = s as *raw u8
    var len = 0usize
    while p[len] != 0u8 {
        len = len + 1usize
    }
    return len
}

fn os_read_all(fd: i32) -> String {
    var out = String.new()
    if fd < 0 {
        return out
    }
    let buf = malloc(4096usize) as *raw var u8
    var n = syscall3(0i64, fd as i64, buf, 4096i64)
    while n > 0i64 {
        var i = 0usize
        let count = n as usize
        while i < count {
            out.push_byte(buf[i])
            i = i + 1usize
        }
        n = syscall3(0i64, fd as i64, buf, 4096i64)
    }
    free(buf)
    let _ = syscall1(3i64, fd as i64)
    out.push_byte(0u8)
    return out
}

pub struct ChildProcess {
    pub pid: i32,
    pub stdin_fd: i32,
    pub stdout_fd: i32,
    pub stderr_fd: i32,
}

impl ChildProcess {
    pub fn id(self) -> i32 {
        return self.pid
    }

    pub fn wait(self) -> i32 {
        let status_buf = malloc(8usize) as *raw var u8
        status_buf[0usize] = 0u8
        status_buf[1usize] = 0u8
        status_buf[2usize] = 0u8
        status_buf[3usize] = 0u8
        // SYS_wait4 = 61: wait4(pid, status, options, rusage)
        let r = syscall4(61i64, self.pid as i64, status_buf, 0i64, 0usize as *raw u8)
        if r < 0i64 {
            free(status_buf)
            return -1
        }
        let b0 = status_buf[0usize] as i32
        let b1 = status_buf[1usize] as i32
        let b2 = status_buf[2usize] as i32
        let b3 = status_buf[3usize] as i32
        let status = (b0 & 255) | ((b1 & 255) << 8) | ((b2 & 255) << 16) | ((b3 & 255) << 24)
        free(status_buf)
        return ((status >> 8) & 255)
    }

    pub fn kill(self, sig: i32) -> bool {
        // SYS_kill = 62
        let r = syscall2(62i64, self.pid as i64, sig as i64)
        return (r == 0i64)
    }

    pub fn write_stdin(self, data: str) -> i64 {
        if self.stdin_fd < 0 {
            return -1i64
        }
        let len = proc_str_len(data)
        return syscall3(1i64, self.stdin_fd as i64, data as *raw u8, len as i64)
    }

    pub fn close_stdin(var self) {
        if self.stdin_fd >= 0 {
            let _ = syscall1(3i64, self.stdin_fd as i64)
            self.stdin_fd = -1
        }
    }

    pub fn read_stdout(self) -> String {
        return os_read_all(self.stdout_fd)
    }

    pub fn read_stderr(self) -> String {
        return os_read_all(self.stderr_fd)
    }
}

// Backwards compatibility alias struct
pub struct Child {
    pub pid: i32,
    pub stdout_fd: i32,
}

impl Child {
    pub fn id(self) -> i32 {
        return self.pid
    }

    pub fn wait(self) -> i32 {
        let status_buf = malloc(8usize) as *raw var u8
        status_buf[0usize] = 0u8
        status_buf[1usize] = 0u8
        status_buf[2usize] = 0u8
        status_buf[3usize] = 0u8
        let r = syscall4(61i64, self.pid as i64, status_buf, 0i64, 0usize as *raw u8)
        if r < 0i64 {
            free(status_buf)
            return -1
        }
        let b0 = status_buf[0usize] as i32
        let b1 = status_buf[1usize] as i32
        let b2 = status_buf[2usize] as i32
        let b3 = status_buf[3usize] as i32
        let status = (b0 & 255) | ((b1 & 255) << 8) | ((b2 & 255) << 16) | ((b3 & 255) << 24)
        free(status_buf)
        return ((status >> 8) & 255)
    }

    pub fn kill(self, sig: i32) -> bool {
        let r = syscall2(62i64, self.pid as i64, sig as i64)
        return (r == 0i64)
    }
}

pub struct Output {
    pub status: i32,
    pub stdout: String,
    pub stderr: String,
}

impl Output {
    pub fn success(self) -> bool {
        return (self.status == 0)
    }
}

pub struct Command {
    pub program: String,
    pub args: Vec<String>,
    pub env_vars: Vec<String>,
    pub current_dir: String,
    pub pipe_stdin: bool,
    pub capture_stdout: bool,
    pub capture_stderr: bool,
}

impl Command {
    pub fn new(program: str) -> Command {
        var args = Vec.new()
        args.push(String.from_str(program))
        return Command {
            program: String.from_str(program),
            args: args,
            env_vars: Vec.new(),
            current_dir: String.new(),
            pipe_stdin: false,
            capture_stdout: false,
            capture_stderr: false,
        }
    }

    pub fn arg(var self, a: str) {
        self.args.push(String.from_str(a))
    }

    pub fn args(var self, list: []str) {
        var i = 0usize
        while i < list.len {
            self.args.push(String.from_str(list[i]))
            i = i + 1usize
        }
    }

    pub fn current_dir(var self, dir: str) {
        self.current_dir = String.from_str(dir)
    }

    pub fn stdin_piped(var self) {
        self.pipe_stdin = true
    }

    pub fn stdout_captured(var self) {
        self.capture_stdout = true
    }

    pub fn stderr_captured(var self) {
        self.capture_stderr = true
    }

    pub fn env(var self, key: str, val: str) {
        var entry = String.new()
        entry.push_str(key)
        entry.push_byte(61u8) // '='
        entry.push_str(val)
        entry.push_byte(0u8)
        self.env_vars.push(entry)
    }

    pub fn spawn(self) -> Option<ChildProcess> {
        var in_r_fd = -1
        var in_w_fd = -1
        var out_r_fd = -1
        var out_w_fd = -1
        var err_r_fd = -1
        var err_w_fd = -1

        // SYS_pipe = 22
        if self.pipe_stdin {
            let pbuf = malloc(16usize) as *raw var u8
            let pr = syscall1(22i64, pbuf)
            if pr != 0i64 {
                free(pbuf)
                return Option.None
            }
            let r0 = pbuf[0usize] as i32
            let r1 = pbuf[1usize] as i32
            let r2 = pbuf[2usize] as i32
            let r3 = pbuf[3usize] as i32
            in_r_fd = (r0 & 255) | ((r1 & 255) << 8) | ((r2 & 255) << 16) | ((r3 & 255) << 24)

            let w0 = pbuf[4usize] as i32
            let w1 = pbuf[5usize] as i32
            let w2 = pbuf[6usize] as i32
            let w3 = pbuf[7usize] as i32
            in_w_fd = (w0 & 255) | ((w1 & 255) << 8) | ((w2 & 255) << 16) | ((w3 & 255) << 24)
            free(pbuf)
        }

        if self.capture_stdout {
            let pbuf = malloc(16usize) as *raw var u8
            let pr = syscall1(22i64, pbuf)
            if pr != 0i64 {
                free(pbuf)
                return Option.None
            }
            let r0 = pbuf[0usize] as i32
            let r1 = pbuf[1usize] as i32
            let r2 = pbuf[2usize] as i32
            let r3 = pbuf[3usize] as i32
            out_r_fd = (r0 & 255) | ((r1 & 255) << 8) | ((r2 & 255) << 16) | ((r3 & 255) << 24)

            let w0 = pbuf[4usize] as i32
            let w1 = pbuf[5usize] as i32
            let w2 = pbuf[6usize] as i32
            let w3 = pbuf[7usize] as i32
            out_w_fd = (w0 & 255) | ((w1 & 255) << 8) | ((w2 & 255) << 16) | ((w3 & 255) << 24)
            free(pbuf)
        }

        if self.capture_stderr {
            let pbuf = malloc(16usize) as *raw var u8
            let pr = syscall1(22i64, pbuf)
            if pr != 0i64 {
                free(pbuf)
                return Option.None
            }
            let r0 = pbuf[0usize] as i32
            let r1 = pbuf[1usize] as i32
            let r2 = pbuf[2usize] as i32
            let r3 = pbuf[3usize] as i32
            err_r_fd = (r0 & 255) | ((r1 & 255) << 8) | ((r2 & 255) << 16) | ((r3 & 255) << 24)

            let w0 = pbuf[4usize] as i32
            let w1 = pbuf[5usize] as i32
            let w2 = pbuf[6usize] as i32
            let w3 = pbuf[7usize] as i32
            err_w_fd = (w0 & 255) | ((w1 & 255) << 8) | ((w2 & 255) << 16) | ((w3 & 255) << 24)
            free(pbuf)
        }

        // SYS_fork = 57
        let pid = syscall0(57i64) as i32
        if pid < 0 {
            if self.pipe_stdin {
                let _ = syscall1(3i64, in_r_fd as i64)
                let _ = syscall1(3i64, in_w_fd as i64)
            }
            if self.capture_stdout {
                let _ = syscall1(3i64, out_r_fd as i64)
                let _ = syscall1(3i64, out_w_fd as i64)
            }
            if self.capture_stderr {
                let _ = syscall1(3i64, err_r_fd as i64)
                let _ = syscall1(3i64, err_w_fd as i64)
            }
            return Option.None
        }

        if pid == 0 {
            // Child process
            if self.current_dir.len() > 0usize {
                // SYS_chdir = 80
                let _ = syscall1(80i64, self.current_dir.as_ptr() as *raw u8)
            }

            // Stdin pipe
            if self.pipe_stdin {
                let _ = syscall1(3i64, in_w_fd as i64) // close write end
                let _ = syscall2(33i64, in_r_fd as i64, 0i64) // dup2 stdin (fd 0)
                let _ = syscall1(3i64, in_r_fd as i64)
            }

            // Stdout pipe
            if self.capture_stdout {
                let _ = syscall1(3i64, out_r_fd as i64) // close read end
                let _ = syscall2(33i64, out_w_fd as i64, 1i64) // dup2 stdout (fd 1)
                let _ = syscall1(3i64, out_w_fd as i64)
            }

            // Stderr pipe
            if self.capture_stderr {
                let _ = syscall1(3i64, err_r_fd as i64) // close read end
                let _ = syscall2(33i64, err_w_fd as i64, 2i64) // dup2 stderr (fd 2)
                let _ = syscall1(3i64, err_w_fd as i64)
            }

            // Construct argv pointer array
            let argc = self.args.len
            let argv_raw = malloc((argc + 1usize) * 8usize) as *raw var usize
            var i = 0usize
            while i < argc {
                argv_raw[i] = self.args.ptr[i].as_ptr() as usize
                i = i + 1usize
            }
            argv_raw[argc] = 0usize

            // Construct envp pointer array if specified
            var envp_raw = 0usize as *raw var usize
            if self.env_vars.len > 0usize {
                let envc = self.env_vars.len
                envp_raw = malloc((envc + 1usize) * 8usize) as *raw var usize
                i = 0usize
                while i < envc {
                    envp_raw[i] = self.env_vars.ptr[i].as_ptr() as usize
                    i = i + 1usize
                }
                envp_raw[envc] = 0usize
            } else {
                envp_raw = malloc(8usize) as *raw var usize
                envp_raw[0usize] = 0usize
            }

            // SYS_execve = 59
            let _ = syscall3(59i64, self.program.as_ptr() as *raw u8, argv_raw as *raw u8, envp_raw as *raw u8)
            // SYS_exit = 60
            let _ = syscall1(60i64, 127i64)
        }

        // Parent process
        var parent_in_fd = -1
        var parent_out_fd = -1
        var parent_err_fd = -1

        if self.pipe_stdin {
            let _ = syscall1(3i64, in_r_fd as i64) // close read end
            parent_in_fd = in_w_fd
        }
        if self.capture_stdout {
            let _ = syscall1(3i64, out_w_fd as i64) // close write end
            parent_out_fd = out_r_fd
        }
        if self.capture_stderr {
            let _ = syscall1(3i64, err_w_fd as i64) // close write end
            parent_err_fd = err_r_fd
        }

        return Option.Some(ChildProcess {
            pid: pid,
            stdin_fd: parent_in_fd,
            stdout_fd: parent_out_fd,
            stderr_fd: parent_err_fd,
        })
    }

    pub fn status(self) -> i32 {
        let spawn_res = self.spawn()
        match spawn_res {
            Option.Some(c) => return c.wait(),
            Option.None => return -1,
            _ => return -1,
        }
    }

    pub fn output(var self) -> Option<Output> {
        self.capture_stdout = true
        self.capture_stderr = true
        let spawn_res = self.spawn()
        match spawn_res {
            Option.Some(c) => {
                var out_str = String.new()
                if c.stdout_fd >= 0 {
                    let buf = malloc(4096usize) as *raw var u8
                    // SYS_read = 0
                    var n = syscall3(0i64, c.stdout_fd as i64, buf, 4096i64)
                    while n > 0i64 {
                        var i = 0usize
                        let count = n as usize
                        while i < count {
                            out_str.push_byte(buf[i])
                            i = i + 1usize
                        }
                        n = syscall3(0i64, c.stdout_fd as i64, buf, 4096i64)
                    }
                    free(buf)
                    // SYS_close = 3
                    let _ = syscall1(3i64, c.stdout_fd as i64)
                }

                var err_str = String.new()
                if c.stderr_fd >= 0 {
                    let buf = malloc(4096usize) as *raw var u8
                    var n = syscall3(0i64, c.stderr_fd as i64, buf, 4096i64)
                    while n > 0i64 {
                        var i = 0usize
                        let count = n as usize
                        while i < count {
                            err_str.push_byte(buf[i])
                            i = i + 1usize
                        }
                        n = syscall3(0i64, c.stderr_fd as i64, buf, 4096i64)
                    }
                    free(buf)
                    let _ = syscall1(3i64, c.stderr_fd as i64)
                }

                let st = c.wait()
                out_str.push_byte(0u8)
                err_str.push_byte(0u8)
                return Option.Some(Output {
                    status: st,
                    stdout: out_str,
                    stderr: err_str,
                })
            },
            Option.None => return Option.None,
            _ => return Option.None,
        }
    }

    pub fn pipe(self, next_cmd: Command) -> Pipeline {
        return Pipeline.new(self, next_cmd)
    }
}

pub struct Pipeline {
    pub cmd1: Command,
    pub cmd2: Command,
}

impl Pipeline {
    pub fn new(c1: Command, c2: Command) -> Pipeline {
        return Pipeline {
            cmd1: c1,
            cmd2: c2,
        }
    }

    pub fn run(self) -> Option<Output> {
        // Intermediate pipe between cmd1 and cmd2
        let pbuf = malloc(8usize) as *raw var u8
        let pr_mid = syscall1(22i64, pbuf)
        if pr_mid != 0i64 {
            free(pbuf)
            return Option.None
        }
        let mid_r = (pbuf[0usize] as i32 & 255) | ((pbuf[1usize] as i32 & 255) << 8) | ((pbuf[2usize] as i32 & 255) << 16) | ((pbuf[3usize] as i32 & 255) << 24)
        let mid_w = (pbuf[4usize] as i32 & 255) | ((pbuf[5usize] as i32 & 255) << 8) | ((pbuf[6usize] as i32 & 255) << 16) | ((pbuf[7usize] as i32 & 255) << 24)

        // Capture stdout pipe for cmd2
        let pr_out = syscall1(22i64, pbuf)
        if pr_out != 0i64 {
            let _ = syscall1(3i64, mid_r as i64)
            let _ = syscall1(3i64, mid_w as i64)
            free(pbuf)
            return Option.None
        }
        let out_r = (pbuf[0usize] as i32 & 255) | ((pbuf[1usize] as i32 & 255) << 8) | ((pbuf[2usize] as i32 & 255) << 16) | ((pbuf[3usize] as i32 & 255) << 24)
        let out_w = (pbuf[4usize] as i32 & 255) | ((pbuf[5usize] as i32 & 255) << 8) | ((pbuf[6usize] as i32 & 255) << 16) | ((pbuf[7usize] as i32 & 255) << 24)

        // Capture stderr pipe for cmd2
        let pr_err = syscall1(22i64, pbuf)
        if pr_err != 0i64 {
            let _ = syscall1(3i64, mid_r as i64)
            let _ = syscall1(3i64, mid_w as i64)
            let _ = syscall1(3i64, out_r as i64)
            let _ = syscall1(3i64, out_w as i64)
            free(pbuf)
            return Option.None
        }
        let err_r = (pbuf[0usize] as i32 & 255) | ((pbuf[1usize] as i32 & 255) << 8) | ((pbuf[2usize] as i32 & 255) << 16) | ((pbuf[3usize] as i32 & 255) << 24)
        let err_w = (pbuf[4usize] as i32 & 255) | ((pbuf[5usize] as i32 & 255) << 8) | ((pbuf[6usize] as i32 & 255) << 16) | ((pbuf[7usize] as i32 & 255) << 24)
        free(pbuf)

        // Fork child 1 (cmd1)
        let pid1 = syscall0(57i64) as i32
        if pid1 < 0 {
            let _ = syscall1(3i64, mid_r as i64)
            let _ = syscall1(3i64, mid_w as i64)
            let _ = syscall1(3i64, out_r as i64)
            let _ = syscall1(3i64, out_w as i64)
            let _ = syscall1(3i64, err_r as i64)
            let _ = syscall1(3i64, err_w as i64)
            return Option.None
        }
        if pid1 == 0 {
            // Redirect stdout to mid_w
            let _ = syscall2(33i64, mid_w as i64, 1i64)
            let _ = syscall1(3i64, mid_r as i64)
            let _ = syscall1(3i64, mid_w as i64)
            let _ = syscall1(3i64, out_r as i64)
            let _ = syscall1(3i64, out_w as i64)
            let _ = syscall1(3i64, err_r as i64)
            let _ = syscall1(3i64, err_w as i64)

            let c1 = self.cmd1
            if c1.current_dir.len() > 0usize {
                let _ = syscall1(80i64, c1.current_dir.as_ptr() as *raw u8)
            }

            let argc1 = c1.args.len
            let args_vec1 = malloc((argc1 + 1usize) * 8usize) as *raw var usize
            var i1 = 0usize
            while i1 < argc1 {
                args_vec1[i1] = c1.args.ptr[i1].as_ptr() as usize
                i1 = i1 + 1usize
            }
            args_vec1[argc1] = 0usize

            var envp_vec1 = 0usize as *raw var usize
            if c1.env_vars.len > 0usize {
                let envc1 = c1.env_vars.len
                envp_vec1 = malloc((envc1 + 1usize) * 8usize) as *raw var usize
                var e1 = 0usize
                while e1 < envc1 {
                    envp_vec1[e1] = c1.env_vars.ptr[e1].as_ptr() as usize
                    e1 = e1 + 1usize
                }
                envp_vec1[envc1] = 0usize
            } else {
                envp_vec1 = malloc(8usize) as *raw var usize
                envp_vec1[0usize] = 0usize
            }

            let _ = syscall3(59i64, c1.program.as_ptr() as *raw u8, args_vec1 as *raw u8, envp_vec1 as *raw u8)
            let _ = syscall1(60i64, 127i64)
        }

        // Fork child 2 (cmd2)
        let pid2 = syscall0(57i64) as i32
        if pid2 < 0 {
            let _ = syscall1(3i64, mid_r as i64)
            let _ = syscall1(3i64, mid_w as i64)
            let _ = syscall1(3i64, out_r as i64)
            let _ = syscall1(3i64, out_w as i64)
            let _ = syscall1(3i64, err_r as i64)
            let _ = syscall1(3i64, err_w as i64)
            return Option.None
        }
        if pid2 == 0 {
            // Redirect stdin from mid_r
            let _ = syscall2(33i64, mid_r as i64, 0i64)
            // Redirect stdout to out_w
            let _ = syscall2(33i64, out_w as i64, 1i64)
            // Redirect stderr to err_w
            let _ = syscall2(33i64, err_w as i64, 2i64)

            let _ = syscall1(3i64, mid_r as i64)
            let _ = syscall1(3i64, mid_w as i64)
            let _ = syscall1(3i64, out_r as i64)
            let _ = syscall1(3i64, out_w as i64)
            let _ = syscall1(3i64, err_r as i64)
            let _ = syscall1(3i64, err_w as i64)

            let c2 = self.cmd2
            if c2.current_dir.len() > 0usize {
                let _ = syscall1(80i64, c2.current_dir.as_ptr() as *raw u8)
            }

            let argc2 = c2.args.len
            let args_vec2 = malloc((argc2 + 1usize) * 8usize) as *raw var usize
            var i2 = 0usize
            while i2 < argc2 {
                args_vec2[i2] = c2.args.ptr[i2].as_ptr() as usize
                i2 = i2 + 1usize
            }
            args_vec2[argc2] = 0usize

            var envp_vec2 = 0usize as *raw var usize
            if c2.env_vars.len > 0usize {
                let envc2 = c2.env_vars.len
                envp_vec2 = malloc((envc2 + 1usize) * 8usize) as *raw var usize
                var e2 = 0usize
                while e2 < envc2 {
                    envp_vec2[e2] = c2.env_vars.ptr[e2].as_ptr() as usize
                    e2 = e2 + 1usize
                }
                envp_vec2[envc2] = 0usize
            } else {
                envp_vec2 = malloc(8usize) as *raw var usize
                envp_vec2[0usize] = 0usize
            }

            let _ = syscall3(59i64, c2.program.as_ptr() as *raw u8, args_vec2 as *raw u8, envp_vec2 as *raw u8)
            let _ = syscall1(60i64, 127i64)
        }

        // Parent process: close mid pipe and write ends of output capture pipes
        let _ = syscall1(3i64, mid_r as i64)
        let _ = syscall1(3i64, mid_w as i64)
        let _ = syscall1(3i64, out_w as i64)
        let _ = syscall1(3i64, err_w as i64)

        // Read output from final command
        let out_str = os_read_all(out_r)
        let err_str = os_read_all(err_r)

        // Wait for children
        let status_buf = malloc(8usize) as *raw var u8
        status_buf[0usize] = 0u8
        status_buf[1usize] = 0u8
        let _ = syscall4(61i64, pid1 as i64, status_buf, 0i64, 0usize as *raw u8)

        status_buf[0usize] = 0u8
        status_buf[1usize] = 0u8
        let r2 = syscall4(61i64, pid2 as i64, status_buf, 0i64, 0usize as *raw u8)
        var st2 = 0
        if r2 >= 0i64 {
            let b0 = status_buf[0usize] as i32
            let b1 = status_buf[1usize] as i32
            let b2 = status_buf[2usize] as i32
            let b3 = status_buf[3usize] as i32
            let status = (b0 & 255) | ((b1 & 255) << 8) | ((b2 & 255) << 16) | ((b3 & 255) << 24)
            st2 = ((status >> 8) & 255)
        }
        free(status_buf)

        return Option.Some(Output {
            status: st2,
            stdout: out_str,
            stderr: err_str,
        })
    }

    pub fn status(self) -> i32 {
        let res = self.run()
        match res {
            Option.Some(out) => return out.status,
            Option.None => return -1,
            _ => return -1,
        }
    }
}

pub struct Process {}

impl Process {
    pub fn id() -> i32 {
        // SYS_getpid = 39
        return syscall0(39i64) as i32
    }

    pub fn exit_process(code: i32) {
        // SYS_exit_group = 231
        let _ = syscall1(231i64, code as i64)
        let _ = syscall1(60i64, code as i64)
    }

    pub fn run_command(cmd: str) -> i32 {
        return system(cmd)
    }
}

pub fn get_env(name: str) -> Option<String> {
    let val_ptr = getenv(name)
    if (val_ptr as usize) == 0usize {
        return Option.None
    } else {
        return Option.Some(String.from_str(val_ptr as str))
    }
}

pub fn set_env(name: str, val: str) -> bool {
    return (setenv(name, val, 1) == 0)
}

pub fn env_get(name: str) -> Option<String> {
    return get_env(name)
}

pub fn env_set(name: str, val: str) -> bool {
    return set_env(name, val)
}

pub fn env_vars() -> Vec<String> {
    var list = Vec.new()
    let fd = syscall3(2i64, "/proc/self/environ" as *raw u8, 0i64, 0i64)
    if fd < 0i64 {
        return list
    }
    let cap = 65536usize
    let buf = malloc(cap) as *raw var u8
    let n = syscall3(0i64, fd, buf, cap as i64)
    let _ = syscall1(3i64, fd)
    if n <= 0i64 {
        free(buf)
        return list
    }
    let total = n as usize
    var cur = String.new()
    var i = 0usize
    while i < total {
        let b = buf[i]
        if b == 0u8 {
            if cur.len > 0usize {
                list.push(cur)
                cur = String.new()
            }
        } else {
            cur.push_byte(b)
        }
        i = i + 1usize
    }
    if cur.len > 0usize {
        list.push(cur)
    }
    free(buf)
    return list
}

pub fn process_exit(code: i32) {
    Process.exit_process(code)
}
