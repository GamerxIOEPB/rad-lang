// ==============================================================================
// Rad Standard Library: Reactive Web & WASM Framework (std::dom)
// Virtual DOM (VNode), declarative element helpers, signals & universal SSR.
// Zero external C dynamic dependencies.
// ==============================================================================

fn str_len(s: str) -> usize {
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

fn str_eq(a: str, b: str) -> bool {
    let pa = a as usize
    let pb = b as usize
    if pa == pb { return true }
    if pa == 0usize || pb == 0usize { return false }
    let la = str_len(a)
    let lb = str_len(b)
    if la != lb { return false }
    let p1 = a as *raw u8
    let p2 = b as *raw u8
    var i = 0usize
    while i < la {
        if p1[i] != p2[i] { return false }
        i = i + 1usize
    }
    return true
}

pub struct VNode {
    pub tag: String,
    pub text_content: String,
    pub attrs_keys: Vec<String>,
    pub attrs_vals: Vec<String>,
    pub children: Vec<VNode>,
    pub is_text: bool,
}

impl VNode {
    pub fn new_element(tag: str) -> VNode {
        return VNode {
            tag: String.from_str(tag),
            text_content: String.new(),
            attrs_keys: Vec.new(),
            attrs_vals: Vec.new(),
            children: Vec.new(),
            is_text: false,
        }
    }

    pub fn new_text(content: str) -> VNode {
        return VNode {
            tag: String.new(),
            text_content: String.from_str(content),
            attrs_keys: Vec.new(),
            attrs_vals: Vec.new(),
            children: Vec.new(),
            is_text: true,
        }
    }

    pub fn attr(var self, key: str, val: str) -> VNode {
        self.attrs_keys.push(String.from_str(key))
        self.attrs_vals.push(String.from_str(val))
        return self
    }

    pub fn add_child(var self, child: VNode) {
        self.children.push(child)
    }
}

// Element helper functions
pub fn div(children: Vec<VNode>) -> VNode {
    var node = VNode::new_element("div")
    var i = 0usize
    while i < children.len {
        node.add_child(children.ptr[i])
        i = i + 1usize
    }
    return node
}

pub fn h1(content: str) -> VNode {
    var node = VNode::new_element("h1")
    node.add_child(VNode::new_text(content))
    return node
}

pub fn h2(content: str) -> VNode {
    var node = VNode::new_element("h2")
    node.add_child(VNode::new_text(content))
    return node
}

pub fn p(content: str) -> VNode {
    var node = VNode::new_element("p")
    node.add_child(VNode::new_text(content))
    return node
}

pub fn span(content: str) -> VNode {
    var node = VNode::new_element("span")
    node.add_child(VNode::new_text(content))
    return node
}

pub fn button(label: str) -> VNode {
    var node = VNode::new_element("button")
    node.add_child(VNode::new_text(label))
    return node
}

pub fn input_tag(input_type: str, placeholder: str) -> VNode {
    var node = VNode::new_element("input")
    node = node.attr("type", input_type)
    if str_len(placeholder) > 0usize {
        node = node.attr("placeholder", placeholder)
    }
    return node
}

pub fn a(href: str, label: str) -> VNode {
    var node = VNode::new_element("a")
    node = node.attr("href", href)
    node.add_child(VNode::new_text(label))
    return node
}

pub fn text_node(content: str) -> VNode {
    return VNode::new_text(content)
}

// Fine-grained Reactive Signal
pub struct Signal {
    pub value: i64,
    pub version: i64,
}

impl Signal {
    pub fn new(initial: i64) -> Signal {
        return Signal {
            value: initial,
            version: 1i64,
        }
    }

    pub fn get(self) -> i64 {
        return self.value
    }

    pub fn set(var self, val: i64) {
        self.value = val
        self.version = self.version + 1i64
    }
}

// Universal Server-Side Rendering (SSR)
pub fn is_self_closing(tag: str) -> bool {
    return str_eq(tag, "input") || str_eq(tag, "img") || str_eq(tag, "br") ||
           str_eq(tag, "hr") || str_eq(tag, "meta") || str_eq(tag, "link")
}

pub fn render_to_string(node: VNode) -> String {
    var out = String.new()
    if node.is_text {
        out.push_str(node.text_content.as_ptr() as str)
        return out
    }

    let tag_str = node.tag.as_ptr() as str
    out.push_byte(60u8) // '<'
    out.push_str(tag_str)

    var i = 0usize
    while i < node.attrs_keys.len {
        out.push_byte(32u8) // ' '
        out.push_str(node.attrs_keys.ptr[i].as_ptr() as str)
        out.push_str("=\"")
        out.push_str(node.attrs_vals.ptr[i].as_ptr() as str)
        out.push_byte(34u8) // '"'
        i = i + 1usize
    }

    if is_self_closing(tag_str) {
        out.push_str(" />")
        return out
    }

    out.push_byte(62u8) // '>'

    var ci = 0usize
    while ci < node.children.len {
        let child_html = render_to_string(node.children.ptr[ci])
        out.push_str(child_html.as_ptr() as str)
        ci = ci + 1usize
    }

    out.push_str("</")
    out.push_str(tag_str)
    out.push_byte(62u8) // '>'

    return out
}

pub fn render_page(title: str, body_node: VNode) -> String {
    var out = String.new()
    out.push_str("<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>")
    out.push_str(title)
    out.push_str("</title></head><body>")
    let body_html = render_to_string(body_node)
    out.push_str(body_html.as_ptr() as str)
    out.push_str("</body></html>")
    return out
}

// WebSocket Live State Synchronization
pub struct StateSync {}

impl StateSync {
    pub fn encode_action(action: str, key: str, val: str) -> String {
        var out = String.new()
        out.push_str("{\"type\":\"action\",\"name\":\"")
        out.push_str(action)
        out.push_str("\",\"key\":\"")
        out.push_str(key)
        out.push_str("\",\"val\":\"")
        out.push_str(val)
        out.push_str("\"}")
        return out
    }

    pub fn encode_patch(selector: str, html: str) -> String {
        var out = String.new()
        out.push_str("{\"type\":\"patch\",\"selector\":\"")
        out.push_str(selector)
        out.push_str("\",\"html\":\"")
        out.push_str(html)
        out.push_str("\"}")
        return out
    }
}
