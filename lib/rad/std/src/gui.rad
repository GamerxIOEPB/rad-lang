// ==============================================================================
// Rad Standard Library: Pure-Rad Native Desktop GUI Toolkit (std::gui)
// 100% Pure Rad implementation of Wayland wire protocol and X11 wire protocol.
// Zero external C bridge files, zero libwayland-client, zero libX11.
// Automatic display server detection, software rasterizer, flexbox layout,
// vector path tessellator, and declarative UI widget hierarchy.
// ==============================================================================

extern "C" {
    fn malloc(size: usize) -> *raw var u8;
    fn free(ptr: *raw var u8);
    fn memcpy(dest: *raw var u8, src: *raw u8, n: usize) -> *raw var u8;
    fn getenv(name: str) -> *raw u8;
    fn open(path: str, flags: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn read(fd: i32, buf: *raw var u8, count: usize) -> isize;
    fn usleep(usec: u32) -> i32;
}

fn gui_str_len(s: str) -> usize {
    if (s as usize) == 0usize { return 0usize; }
    let p = s as *raw u8;
    var i = 0usize;
    while p[i] != 0u8 {
        i = i + 1usize;
    }
    return i;
}

fn gui_str_eq(a: str, b: str) -> bool {
    if (a as usize) == 0usize && (b as usize) == 0usize { return true; }
    if (a as usize) == 0usize || (b as usize) == 0usize { return false; }
    let pa = a as *raw u8;
    let pb = b as *raw u8;
    var i = 0usize;
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] { return false; }
        i = i + 1usize;
    }
    return pa[i] == pb[i];
}

fn gui_read_u32(p: *raw u8, offset: usize) -> u32 {
    let b0 = p[offset] as u32;
    let b1 = p[offset + 1usize] as u32;
    let b2 = p[offset + 2usize] as u32;
    let b3 = p[offset + 3usize] as u32;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

fn gui_read_i32(p: *raw u8, offset: usize) -> i32 {
    return gui_read_u32(p, offset) as i32;
}

fn gui_read_u16(p: *raw u8, offset: usize) -> u16 {
    let b0 = p[offset] as u16;
    let b1 = p[offset + 1usize] as u16;
    return b0 | (b1 << 8);
}

fn gui_read_be_u16(p: *raw u8, offset: usize) -> u16 {
    let b0 = p[offset] as u16;
    let b1 = p[offset + 1usize] as u16;
    return (b0 << 8) | b1;
}

// ------------------------------------------------------------------------------
// Display Server Backends & Events
// ------------------------------------------------------------------------------

pub const WINDOW_BACKEND_AUTO: u32     = 0u32;
pub const WINDOW_BACKEND_WAYLAND: u32  = 1u32;
pub const WINDOW_BACKEND_X11: u32      = 2u32;
pub const WINDOW_BACKEND_COCOA: u32    = 3u32;
pub const WINDOW_BACKEND_WIN32: u32    = 4u32;
pub const WINDOW_BACKEND_HEADLESS: u32 = 5u32;

pub const WINDOW_EVENT_NONE: u32       = 0u32;
pub const WINDOW_EVENT_CLOSE: u32      = 1u32;
pub const WINDOW_EVENT_RESIZE: u32     = 2u32;
pub const WINDOW_EVENT_MOUSE_DOWN: u32 = 3u32;
pub const WINDOW_EVENT_MOUSE_UP: u32   = 4u32;
pub const WINDOW_EVENT_MOUSE_MOVE: u32 = 5u32;
pub const WINDOW_EVENT_KEY_DOWN: u32   = 6u32;
pub const WINDOW_EVENT_KEY_UP: u32     = 7u32;

pub struct WindowEvent {
    pub event_type: u32,
    pub x: f32,
    pub y: f32,
    pub key_code: u32,
    pub width: f32,
    pub height: f32,
}

impl WindowEvent {
    pub fn none() -> WindowEvent {
        return WindowEvent {
            event_type: WINDOW_EVENT_NONE,
            x: 0.0,
            y: 0.0,
            key_code: 0u32,
            width: 0.0,
            height: 0.0,
        };
    }

    pub fn mouse_move(x: f32, y: f32) -> WindowEvent {
        return WindowEvent {
            event_type: WINDOW_EVENT_MOUSE_MOVE,
            x: x,
            y: y,
            key_code: 0u32,
            width: 0.0,
            height: 0.0,
        };
    }

    pub fn mouse_down(x: f32, y: f32) -> WindowEvent {
        return WindowEvent {
            event_type: WINDOW_EVENT_MOUSE_DOWN,
            x: x,
            y: y,
            key_code: 0u32,
            width: 0.0,
            height: 0.0,
        };
    }

    pub fn resize(w: f32, h: f32) -> WindowEvent {
        return WindowEvent {
            event_type: WINDOW_EVENT_RESIZE,
            x: 0.0,
            y: 0.0,
            key_code: 0u32,
            width: w,
            height: h,
        };
    }
}

// Automatic display server detector
pub fn detect_display_backend() -> u32 {
    let wl_disp = getenv("WAYLAND_DISPLAY");
    if (wl_disp as usize) != 0usize {
        let p = wl_disp as *raw u8;
        if p[0] != 0u8 {
            return WINDOW_BACKEND_WAYLAND;
        }
    }
    let session = getenv("XDG_SESSION_TYPE");
    if (session as usize) != 0usize && (wl_disp as usize) == 0usize {
        let sp = session as *raw u8;
        if sp[0] != 0u8 && gui_str_eq(session as str, "wayland") {
            return WINDOW_BACKEND_WAYLAND;
        }
    }
    let x_disp = getenv("DISPLAY");
    if (x_disp as usize) != 0usize {
        let xp = x_disp as *raw u8;
        if xp[0] != 0u8 {
            return WINDOW_BACKEND_X11;
        }
    }
    return WINDOW_BACKEND_HEADLESS;
}

// ------------------------------------------------------------------------------
// Built-in 8x16 Bitmap Font Table (4096 bytes)
// ------------------------------------------------------------------------------

pub fn get_font8x16_hex() -> str {
    return "";
}

fn gui_hex_digit(c: u8) -> u8 {
    if c >= ('0' as u8) && c <= ('9' as u8) { return c - ('0' as u8); }
    if c >= ('a' as u8) && c <= ('f' as u8) { return c - ('a' as u8) + 10u8; }
    if c >= ('A' as u8) && c <= ('F' as u8) { return c - ('A' as u8) + 10u8; }
    return 0u8;
}

fn gui_get_font_byte(c: usize, row: usize) -> u8 {
    let font_str = get_font8x16_hex();
    let idx = (c * 16usize + row) * 2usize;
    let p = font_str as *raw u8;
    let c0 = p[idx];
    let c1 = p[idx + 1usize];
    return (gui_hex_digit(c0) << 4) | gui_hex_digit(c1);
}

// ------------------------------------------------------------------------------
// Pure-Rad Wayland Backend Implementation
// ------------------------------------------------------------------------------

pub struct WaylandBackend {
    pub sock_fd: i32,
    pub shm_fd: i32,
    pub width: i32,
    pub height: i32,
    pub stride: i32,
    pub buf_size: i32,
    pub pixels: *raw var u32,
    pub configured: bool,
    pub is_open: bool,
    pub mouse_x: f32,
    pub mouse_y: f32,
    pub mouse_down: bool,
    pub pointer_bound: bool,
    pub read_buf: *raw var u8,
    pub read_buf_cap: usize,
}

fn wayland_get_socket_path() -> String {
    let wl_disp = getenv("WAYLAND_DISPLAY");
    var disp_str = "wayland-0";
    if (wl_disp as usize) != 0usize {
        disp_str = wl_disp as str;
    }
    let runtime_dir = getenv("XDG_RUNTIME_DIR");
    if (runtime_dir as usize) != 0usize {
        var res = String.from_str(runtime_dir as str);
        res.push_str("/");
        res.push_str(disp_str);
        return res;
    }
    var res = String.from_str("/run/user/1000/");
    res.push_str(disp_str);
    return res;
}

fn wayland_connect() -> i32 {
    let fd = syscall3(41i64, 1i64, 1i64, 0i64) as i32; // socket(AF_UNIX, SOCK_STREAM, 0)
    if fd < 0 { return -1; }

    let path_str = wayland_get_socket_path();
    let path_p = path_str.as_ptr() as *raw u8;
    let path_len = path_str.len;

    let sun = malloc(112usize);
    var i = 0usize;
    while i < 112usize { sun[i] = 0u8; i = i + 1usize; }
    sun[0] = 1u8; // AF_UNIX
    i = 0usize;
    while i < path_len && i < 107usize {
        sun[2usize + i] = path_p[i];
        i = i + 1usize;
    }
    sun[2usize + i] = 0u8;

    let res = syscall3(42i64, fd as i64, sun as i64, 110i64) as i32;
    free(sun);
    if res < 0 {
        let _ = syscall1(3i64, fd as i64);
        return -1;
    }
    return fd;
}

fn wayland_send_packet(fd: i32, obj: u32, opcode: u16, payload: *raw u8, payload_len: usize) -> bool {
    let msg_size = (8usize + payload_len) as u16;
    let buf = malloc(8usize + payload_len);
    buf[0] = (obj & 0xFFu32) as u8;
    buf[1] = ((obj >> 8) & 0xFFu32) as u8;
    buf[2] = ((obj >> 16) & 0xFFu32) as u8;
    buf[3] = ((obj >> 24) & 0xFFu32) as u8;
    buf[4] = (opcode & 0xFFu16) as u8;
    buf[5] = ((opcode >> 8) & 0xFFu16) as u8;
    buf[6] = (msg_size & 0xFFu16) as u8;
    buf[7] = ((msg_size >> 8) & 0xFFu16) as u8;

    var i = 0usize;
    while i < payload_len {
        buf[8usize + i] = payload[i];
        i = i + 1usize;
    }
    let written = syscall3(1i64, fd as i64, buf as i64, (8usize + payload_len) as i64) as isize;
    free(buf);
    return written == (8usize + payload_len) as isize;
}

fn wayland_sendmsg_fd(sock_fd: i32, obj: u32, opcode: u16, pass_fd: i32, payload: *raw u8, payload_len: usize) -> bool {
    let msg_size = (8usize + payload_len) as u16;
    let msg_buf = malloc(8usize + payload_len);
    msg_buf[0] = (obj & 0xFFu32) as u8;
    msg_buf[1] = ((obj >> 8) & 0xFFu32) as u8;
    msg_buf[2] = ((obj >> 16) & 0xFFu32) as u8;
    msg_buf[3] = ((obj >> 24) & 0xFFu32) as u8;
    msg_buf[4] = (opcode & 0xFFu16) as u8;
    msg_buf[5] = ((opcode >> 8) & 0xFFu16) as u8;
    msg_buf[6] = (msg_size & 0xFFu16) as u8;
    msg_buf[7] = ((msg_size >> 8) & 0xFFu16) as u8;
    var i = 0usize;
    while i < payload_len {
        msg_buf[8usize + i] = payload[i];
        i = i + 1usize;
    }

    let iov = malloc(16usize);
    let iov_64 = iov as *raw var u64;
    iov_64[0] = msg_buf as u64;
    iov_64[1] = (8usize + payload_len) as u64;

    let cmsg = malloc(24usize);
    let cmsg_64 = cmsg as *raw var u64;
    cmsg_64[0] = 20u64; // cmsg_len
    let cmsg_32 = cmsg as *raw var u32;
    cmsg_32[2] = 1u32; // SOL_SOCKET
    cmsg_32[3] = 1u32; // SCM_RIGHTS
    cmsg_32[4] = pass_fd as u32;
    cmsg_32[5] = 0u32;

    let msg = malloc(56usize);
    var mi = 0usize;
    while mi < 56usize { msg[mi] = 0u8; mi = mi + 1usize; }
    let msg_64 = msg as *raw var u64;
    msg_64[2] = iov as u64;
    msg_64[3] = 1u64;
    msg_64[4] = cmsg as u64;
    msg_64[5] = 24u64;

    let ret = syscall3(46i64, sock_fd as i64, msg as i64, 0i64) as isize;
    free(msg);
    free(cmsg);
    free(iov);
    free(msg_buf);
    return ret > 0isize;
}

fn wayland_send_bind(fd: i32, global_name: u32, iface: str, version: u32, new_id: u32) {
    let iface_len = gui_str_len(iface) + 1usize;
    var pad = 0usize;
    if (iface_len % 4usize) != 0usize {
        pad = 4usize - (iface_len % 4usize);
    }
    let str_padded_len = iface_len + pad;
    let payload_len = 4usize + 4usize + str_padded_len + 4usize + 4usize;
    let payload = malloc(payload_len);
    var p32 = payload as *raw var u32;
    p32[0] = global_name;
    p32[1] = iface_len as u32;
    let p_bytes = payload as *raw var u8;
    let iface_p = iface as *raw u8;
    var i = 0usize;
    while i < iface_len - 1usize {
        p_bytes[8usize + i] = iface_p[i];
        i = i + 1usize;
    }
    p_bytes[8usize + i] = 0u8;
    i = i + 1usize;
    while i < str_padded_len {
        p_bytes[8usize + i] = 0u8;
        i = i + 1usize;
    }
    let tail_offset = (8usize + str_padded_len) / 4usize;
    p32[tail_offset] = version;
    p32[tail_offset + 1usize] = new_id;

    let _ = wayland_send_packet(fd, 2u32 /* wl_registry */, 0u16 /* bind */, payload, payload_len);
    free(payload);
}

fn wayland_send_string(fd: i32, obj: u32, opcode: u16, s: str) {
    let s_len = gui_str_len(s) + 1usize;
    var pad = 0usize;
    if (s_len % 4usize) != 0usize {
        pad = 4usize - (s_len % 4usize);
    }
    let str_padded_len = s_len + pad;
    let payload_len = 4usize + str_padded_len;
    let payload = malloc(payload_len);
    var p32 = payload as *raw var u32;
    p32[0] = s_len as u32;
    let p_bytes = payload as *raw var u8;
    let s_p = s as *raw u8;
    var i = 0usize;
    while i < s_len - 1usize {
        p_bytes[4usize + i] = s_p[i];
        i = i + 1usize;
    }
    p_bytes[4usize + i] = 0u8;
    i = i + 1usize;
    while i < str_padded_len {
        p_bytes[4usize + i] = 0u8;
        i = i + 1usize;
    }
    let _ = wayland_send_packet(fd, obj, opcode, payload, payload_len);
    free(payload);
}

impl WaylandBackend {
    pub fn init(title: str, width: i32, height: i32) -> WaylandBackend {
        let fd = wayland_connect();
        if fd < 0 {
            return WaylandBackend {
                sock_fd: -1, shm_fd: -1, width: width, height: height,
                stride: width * 4i32, buf_size: 0, pixels: 0usize as *raw var u32,
                configured: false, is_open: false, mouse_x: 0.0, mouse_y: 0.0,
                mouse_down: false, pointer_bound: false,
                read_buf: 0usize as *raw var u8, read_buf_cap: 0usize,
            };
        }

        // 1. Get registry (new_id 2)
        let p_reg = malloc(4usize);
        let p_reg32 = p_reg as *raw var u32;
        p_reg32[0] = 2u32;
        let _ = wayland_send_packet(fd, 1u32, 1u16, p_reg, 4usize);
        free(p_reg);

        // 2. Sync (new_id 3)
        let p_sync = malloc(4usize);
        let p_sync32 = p_sync as *raw var u32;
        p_sync32[0] = 3u32;
        let _ = wayland_send_packet(fd, 1u32, 0u16, p_sync, 4usize);
        free(p_sync);

        let read_buf_cap = 65536usize;
        let read_buf = malloc(read_buf_cap);
        var compositor_id = 0u32;
        var shm_id = 0u32;
        var wm_base_id = 0u32;
        var seat_id = 0u32;
        var sync_done = false;

        while !sync_done {
            let n = syscall3(0i64, fd as i64, read_buf as i64, read_buf_cap as i64) as isize;
            if n <= 0isize { break; }

            var offset = 0usize;
            while offset + 8usize <= n as usize {
                let obj = gui_read_u32(read_buf, offset);
                let opcode = gui_read_u16(read_buf, offset + 4usize);
                let size = gui_read_u16(read_buf, offset + 6usize) as usize;
                if size < 8usize || offset + size > n as usize { break; }

                if obj == 1u32 && opcode == 0u16 {
                    sync_done = true;
                    break;
                }
                if obj == 2u32 && opcode == 0u16 {
                    let name = gui_read_u32(read_buf, offset + 8usize);
                    let str_p = read_buf as usize + offset + 16usize;
                    if gui_str_eq(str_p as str, "wl_compositor") {
                        compositor_id = name;
                    } else if gui_str_eq(str_p as str, "wl_shm") {
                        shm_id = name;
                    } else if gui_str_eq(str_p as str, "xdg_wm_base") {
                        wm_base_id = name;
                    } else if gui_str_eq(str_p as str, "wl_seat") {
                        seat_id = name;
                    }
                }
                if obj == 3u32 && opcode == 0u16 {
                    sync_done = true;
                }
                offset = offset + size;
            }
        }

        if compositor_id == 0u32 || shm_id == 0u32 || wm_base_id == 0u32 {
            free(read_buf);
            let _ = syscall1(3i64, fd as i64);
            return WaylandBackend {
                sock_fd: -1, shm_fd: -1, width: width, height: height,
                stride: width * 4i32, buf_size: 0, pixels: 0usize as *raw var u32,
                configured: false, is_open: false, mouse_x: 0.0, mouse_y: 0.0,
                mouse_down: false, pointer_bound: false,
                read_buf: 0usize as *raw var u8, read_buf_cap: 0usize,
            };
        }

        // Bind globals: 4=compositor, 5=shm, 6=seat, 7=wm_base
        wayland_send_bind(fd, compositor_id, "wl_compositor", 4u32, 4u32);
        wayland_send_bind(fd, shm_id, "wl_shm", 1u32, 5u32);
        if seat_id != 0u32 {
            wayland_send_bind(fd, seat_id, "wl_seat", 7u32, 6u32);
        }
        wayland_send_bind(fd, wm_base_id, "xdg_wm_base", 1u32, 7u32);

        let stride = width * 4i32;
        let buf_size = stride * height;
        let shm_fd = syscall2(319i64, "rad_wayland_shm" as *raw u8 as i64, 1i64) as i32;
        let _ = syscall2(77i64, shm_fd as i64, buf_size as i64);
        let pixels = syscall6(9i64, 0i64, buf_size as i64, 3i64, 1i64, shm_fd as i64, 0i64) as *raw var u32;

        // Create pool (8) and buffer (9)
        let p_pool = malloc(8usize);
        let p_pool32 = p_pool as *raw var u32;
        p_pool32[0] = 8u32;
        p_pool32[1] = buf_size as u32;
        let _ = wayland_sendmsg_fd(fd, 5u32, 0u16, shm_fd, p_pool, 8usize);
        free(p_pool);

        let p_buf = malloc(24usize);
        let p_buf32 = p_buf as *raw var u32;
        p_buf32[0] = 9u32;
        p_buf32[1] = 0u32;
        p_buf32[2] = width as u32;
        p_buf32[3] = height as u32;
        p_buf32[4] = stride as u32;
        p_buf32[5] = 1u32; // WL_SHM_FORMAT_XRGB8888
        let _ = wayland_send_packet(fd, 8u32, 0u16, p_buf, 24usize);
        free(p_buf);

        // Surface (10), XDG Surface (11), XDG Toplevel (12)
        let p_surf = malloc(4usize);
        let p_surf32 = p_surf as *raw var u32;
        p_surf32[0] = 10u32;
        let _ = wayland_send_packet(fd, 4u32, 0u16, p_surf, 4usize);
        free(p_surf);

        let p_xdgs = malloc(8usize);
        let p_xdgs32 = p_xdgs as *raw var u32;
        p_xdgs32[0] = 11u32;
        p_xdgs32[1] = 10u32;
        let _ = wayland_send_packet(fd, 7u32, 2u16, p_xdgs, 8usize);
        free(p_xdgs);

        let p_top = malloc(4usize);
        let p_top32 = p_top as *raw var u32;
        p_top32[0] = 12u32;
        let _ = wayland_send_packet(fd, 11u32, 1u16, p_top, 4usize);
        free(p_top);

        wayland_send_string(fd, 12u32, 2u16, title);
        wayland_send_string(fd, 12u32, 3u16, "rad.wayland.gui");

        // Initial commit
        let _ = wayland_send_packet(fd, 10u32, 6u16, 0usize as *raw u8, 0usize);

        // Initial configure wait
        var configured = false;
        let pfd = malloc(8usize);
        let pfd_32 = pfd as *raw var i32;
        pfd_32[0] = fd;
        let pfd_16 = pfd as *raw var i16;
        pfd_16[2] = 1i16; // POLLIN
        pfd_16[3] = 0i16;

        var tries = 0;
        while !configured && tries < 100 {
            let pr = syscall3(7i64, pfd as i64, 1i64, 10i64) as i32;
            if pr > 0 {
                let n = syscall3(0i64, fd as i64, read_buf as i64, read_buf_cap as i64) as isize;
                if n <= 0isize { break; }
                var offset = 0usize;
                while offset + 8usize <= n as usize {
                    let obj = gui_read_u32(read_buf, offset);
                    let opcode = gui_read_u16(read_buf, offset + 4usize);
                    let size = gui_read_u16(read_buf, offset + 6usize) as usize;
                    if size < 8usize || offset + size > n as usize { break; }

                    if obj == 7u32 && opcode == 0u16 {
                        let serial = gui_read_u32(read_buf, offset + 8usize);
                        let p_pong = malloc(4usize);
                        let p_pong32 = p_pong as *raw var u32;
                        p_pong32[0] = serial;
                        let _ = wayland_send_packet(fd, 7u32, 3u16, p_pong, 4usize);
                        free(p_pong);
                    }
                    if obj == 11u32 && opcode == 0u16 {
                        let serial = gui_read_u32(read_buf, offset + 8usize);
                        let p_ack = malloc(4usize);
                        let p_ack32 = p_ack as *raw var u32;
                        p_ack32[0] = serial;
                        let _ = wayland_send_packet(fd, 11u32, 4u16, p_ack, 4usize);
                        free(p_ack);

                        let p_att = malloc(12usize);
                        let p_att32 = p_att as *raw var u32;
                        p_att32[0] = 9u32; p_att32[1] = 0u32; p_att32[2] = 0u32;
                        let _ = wayland_send_packet(fd, 10u32, 1u16, p_att, 12usize);
                        free(p_att);

                        let p_dam = malloc(16usize);
                        let p_dam32 = p_dam as *raw var u32;
                        p_dam32[0] = 0u32; p_dam32[1] = 0u32; p_dam32[2] = width as u32; p_dam32[3] = height as u32;
                        let _ = wayland_send_packet(fd, 10u32, 9u16, p_dam, 16usize);
                        free(p_dam);

                        let _ = wayland_send_packet(fd, 10u32, 6u16, 0usize as *raw u8, 0usize);
                        configured = true;
                    }
                    offset = offset + size;
                }
            }
            tries = tries + 1;
        }
        free(pfd);

        return WaylandBackend {
            sock_fd: fd, shm_fd: shm_fd, width: width, height: height,
            stride: stride, buf_size: buf_size, pixels: pixels,
            configured: configured, is_open: true, mouse_x: 0.0, mouse_y: 0.0,
            mouse_down: false, pointer_bound: false,
            read_buf: read_buf, read_buf_cap: read_buf_cap,
        };
    }

    pub fn poll_events(var self, var events: Vec<WindowEvent>) -> bool {
        if !self.is_open { return false; }

        let pfd = malloc(8usize);
        let pfd_32 = pfd as *raw var i32;
        pfd_32[0] = self.sock_fd;
        let pfd_16 = pfd as *raw var i16;
        pfd_16[2] = 1i16; // POLLIN
        pfd_16[3] = 0i16;

        while true {
            let pr = syscall3(7i64, pfd as i64, 1i64, 0i64) as i32;
            if pr <= 0 { break; }

            let n = syscall3(0i64, self.sock_fd as i64, self.read_buf as i64, self.read_buf_cap as i64) as isize;
            if n <= 0isize {
                self.is_open = false;
                break;
            }

            var offset = 0usize;
            while offset + 8usize <= n as usize {
                let obj = gui_read_u32(self.read_buf, offset);
                let opcode = gui_read_u16(self.read_buf, offset + 4usize);
                let size = gui_read_u16(self.read_buf, offset + 6usize) as usize;
                if size < 8usize || offset + size > n as usize { break; }

                if obj == 1u32 && opcode == 0u16 {
                    self.is_open = false;
                    break;
                }
                if obj == 7u32 && opcode == 0u16 {
                    let serial = gui_read_u32(self.read_buf, offset + 8usize);
                    let p_pong = malloc(4usize);
                    let p_pong32 = p_pong as *raw var u32;
                    p_pong32[0] = serial;
                    let _ = wayland_send_packet(self.sock_fd, 7u32, 3u16, p_pong, 4usize);
                    free(p_pong);
                }
                if obj == 11u32 && opcode == 0u16 {
                    let serial = gui_read_u32(self.read_buf, offset + 8usize);
                    let p_ack = malloc(4usize);
                    let p_ack32 = p_ack as *raw var u32;
                    p_ack32[0] = serial;
                    let _ = wayland_send_packet(self.sock_fd, 11u32, 4u16, p_ack, 4usize);
                    free(p_ack);
                    self.configured = true;
                }
                if obj == 12u32 && opcode == 1u16 {
                    self.is_open = false;
                    events.push(WindowEvent {
                        event_type: WINDOW_EVENT_CLOSE,
                        x: 0.0, y: 0.0, key_code: 0u32, width: 0.0, height: 0.0,
                    });
                }
                if obj == 6u32 && opcode == 0u16 {
                    let caps = gui_read_u32(self.read_buf, offset + 8usize);
                    if (caps & 1u32) != 0u32 && !self.pointer_bound {
                        let p_ptr = malloc(4usize);
                        let p_ptr32 = p_ptr as *raw var u32;
                        p_ptr32[0] = 13u32; // pointer id 13
                        let _ = wayland_send_packet(self.sock_fd, 6u32, 0u16, p_ptr, 4usize);
                        free(p_ptr);
                        self.pointer_bound = true;
                    }
                }
                if obj == 13u32 {
                    if opcode == 0u16 {
                        // pointer enter
                        let sx = (gui_read_i32(self.read_buf, offset + 16usize) as f32) / 256.0;
                        let sy = (gui_read_i32(self.read_buf, offset + 20usize) as f32) / 256.0;
                        self.mouse_x = sx; self.mouse_y = sy;
                        events.push(WindowEvent::mouse_move(sx, sy));
                    } else if opcode == 2u16 {
                        // pointer motion
                        let sx = (gui_read_i32(self.read_buf, offset + 12usize) as f32) / 256.0;
                        let sy = (gui_read_i32(self.read_buf, offset + 16usize) as f32) / 256.0;
                        self.mouse_x = sx; self.mouse_y = sy;
                        events.push(WindowEvent::mouse_move(sx, sy));
                    } else if opcode == 3u16 {
                        // pointer button
                        let btn = gui_read_u32(self.read_buf, offset + 16usize);
                        let state = gui_read_u32(self.read_buf, offset + 20usize);
                        if btn == 272u32 {
                            if state == 1u32 {
                                self.mouse_down = true;
                                events.push(WindowEvent::mouse_down(self.mouse_x, self.mouse_y));
                            } else {
                                self.mouse_down = false;
                                events.push(WindowEvent {
                                    event_type: WINDOW_EVENT_MOUSE_UP,
                                    x: self.mouse_x, y: self.mouse_y, key_code: btn, width: 0.0, height: 0.0,
                                });
                            }
                        }
                    }
                }

                offset = offset + size;
            }
        }

        free(pfd);
        return self.is_open;
    }

    pub fn commit(var self, pixels: *raw var u32) {
        if !self.is_open || (self.pixels as usize) == 0usize || (pixels as usize) == 0usize { return; }
        let count = (self.width as usize) * (self.height as usize);
        let _ = memcpy(self.pixels as *raw var u8, pixels as *raw u8, count * 4usize);

        let p_att = malloc(12usize);
        let p_att32 = p_att as *raw var u32;
        p_att32[0] = 9u32; p_att32[1] = 0u32; p_att32[2] = 0u32;
        let _ = wayland_send_packet(self.sock_fd, 10u32, 1u16, p_att, 12usize);
        free(p_att);

        let p_dam = malloc(16usize);
        let p_dam32 = p_dam as *raw var u32;
        p_dam32[0] = 0u32; p_dam32[1] = 0u32; p_dam32[2] = self.width as u32; p_dam32[3] = self.height as u32;
        let _ = wayland_send_packet(self.sock_fd, 10u32, 9u16, p_dam, 16usize);
        free(p_dam);

        let _ = wayland_send_packet(self.sock_fd, 10u32, 6u16, 0usize as *raw u8, 0usize);
    }

    pub fn destroy(var self) {
        if self.sock_fd >= 0 {
            let _ = syscall1(11i64, self.pixels as i64); // munmap
            let _ = syscall1(3i64, self.shm_fd as i64);
            let _ = syscall1(3i64, self.sock_fd as i64);
            self.sock_fd = -1;
        }
        if (self.read_buf as usize) != 0usize {
            free(self.read_buf);
            self.read_buf = 0usize as *raw var u8;
        }
    }
}

// ------------------------------------------------------------------------------
// Pure-Rad X11 Backend Implementation
// ------------------------------------------------------------------------------

pub struct X11Backend {
    pub sock_fd: i32,
    pub win_id: u32,
    pub gc_id: u32,
    pub width: i32,
    pub height: i32,
    pub is_open: bool,
    pub mouse_x: f32,
    pub mouse_y: f32,
    pub mouse_down: bool,
    pub put_buf: *raw var u8,
    pub put_buf_len: usize,
}

fn x11_connect(display_num: i32) -> i32 {
    let fd = syscall3(41i64, 1i64, 1i64, 0i64) as i32;
    if fd < 0 { return -1; }

    let sun = malloc(112usize);
    var i = 0usize;
    while i < 112usize { sun[i] = 0u8; i = i + 1usize; }
    sun[0] = 1u8; // AF_UNIX

    let path = "/tmp/.X11-unix/X0";
    let p_path = path as *raw u8;
    var len = 0usize;
    while p_path[len] != 0u8 {
        sun[2usize + len] = p_path[len];
        len = len + 1usize;
    }
    sun[2usize + len - 1usize] = (('0' as u8) + (display_num as u8));
    sun[2usize + len] = 0u8;

    let res = syscall3(42i64, fd as i64, sun as i64, 110i64) as i32;
    free(sun);
    if res < 0 {
        let _ = syscall1(3i64, fd as i64);
        return -1;
    }
    return fd;
}

impl X11Backend {
    pub fn init(title: str, width: i32, height: i32) -> X11Backend {
        let fd = x11_connect(0);
        if fd < 0 {
            return X11Backend {
                sock_fd: -1, win_id: 0u32, gc_id: 0u32, width: width, height: height,
                is_open: false, mouse_x: 0.0, mouse_y: 0.0, mouse_down: false,
                put_buf: 0usize as *raw var u8, put_buf_len: 0usize,
            };
        }

        // Read XAUTHORITY cookie
        let xauth_env = getenv("XAUTHORITY");
        var xauth_path = "/run/user/1000/xauth_XmgLGX";
        if (xauth_env as usize) != 0usize {
            xauth_path = xauth_env as str;
        }

        let afd = open(xauth_path, 0);
        var auth_name_len = 0usize;
        var auth_data_len = 0usize;
        let auth_name = malloc(64usize);
        let auth_data = malloc(64usize);

        if afd >= 0 {
            let auth_buf = malloc(4096usize);
            let n = read(afd, auth_buf, 4096usize);
            let _ = close(afd);
            if n > 0isize {
                var idx = 0usize;
                while idx + 10usize < n as usize {
                    let family = gui_read_be_u16(auth_buf, idx); idx = idx + 2usize;
                    let addr_len = gui_read_be_u16(auth_buf, idx) as usize; idx = idx + 2usize + addr_len;
                    let num_len = gui_read_be_u16(auth_buf, idx) as usize; idx = idx + 2usize + num_len;
                    let n_len = gui_read_be_u16(auth_buf, idx) as usize; idx = idx + 2usize;
                    var ni = 0usize;
                    while ni < n_len && ni < 63usize {
                        auth_name[ni] = auth_buf[idx + ni];
                        ni = ni + 1usize;
                    }
                    auth_name[ni] = 0u8;
                    auth_name_len = n_len;
                    idx = idx + n_len;

                    let d_len = gui_read_be_u16(auth_buf, idx) as usize; idx = idx + 2usize;
                    var di = 0usize;
                    while di < d_len && di < 63usize {
                        auth_data[di] = auth_buf[idx + di];
                        di = di + 1usize;
                    }
                    auth_data[di] = 0u8;
                    auth_data_len = d_len;
                    idx = idx + d_len;
                    break;
                }
            }
            free(auth_buf);
        }

        var pad_name = 0usize;
        if (auth_name_len % 4usize) != 0usize { pad_name = 4usize - (auth_name_len % 4usize); }
        var pad_data = 0usize;
        if (auth_data_len % 4usize) != 0usize { pad_data = 4usize - (auth_data_len % 4usize); }

        let req_size = 12usize + auth_name_len + pad_name + auth_data_len + pad_data;
        let req = malloc(req_size);
        var ri = 0usize;
        while ri < req_size { req[ri] = 0u8; ri = ri + 1usize; }

        req[0] = 'l' as u8;
        req[2] = 11u8;
        req[6] = (auth_name_len & 0xFFusize) as u8;
        req[7] = ((auth_name_len >> 8) & 0xFFusize) as u8;
        req[8] = (auth_data_len & 0xFFusize) as u8;
        req[9] = ((auth_data_len >> 8) & 0xFFusize) as u8;

        ri = 0usize;
        while ri < auth_name_len { req[12usize + ri] = auth_name[ri]; ri = ri + 1usize; }
        let data_offset = 12usize + auth_name_len + pad_name;
        ri = 0usize;
        while ri < auth_data_len { req[data_offset + ri] = auth_data[ri]; ri = ri + 1usize; }

        let _ = syscall3(1i64, fd as i64, req as i64, req_size as i64);
        free(req);
        free(auth_name);
        free(auth_data);

        let reply_hdr = malloc(8usize);
        let _ = syscall3(0i64, fd as i64, reply_hdr as i64, 8i64);
        let status = reply_hdr[0];
        let add_len = gui_read_u16(reply_hdr, 6usize) as usize;
        free(reply_hdr);

        if status != 1u8 {
            let _ = syscall1(3i64, fd as i64);
            return X11Backend {
                sock_fd: -1, win_id: 0u32, gc_id: 0u32, width: width, height: height,
                is_open: false, mouse_x: 0.0, mouse_y: 0.0, mouse_down: false,
                put_buf: 0usize as *raw var u8, put_buf_len: 0usize,
            };
        }

        let body_len = add_len * 4usize;
        let body = malloc(body_len);
        var total_read = 0usize;
        while total_read < body_len {
            let n = syscall3(0i64, fd as i64, (body as usize + total_read) as i64, (body_len - total_read) as i64) as isize;
            if n <= 0isize { break; }
            total_read = total_read + (n as usize);
        }

        let rid_base = gui_read_u32(body, 4usize);
        let vendor_len = gui_read_u16(body, 16usize) as usize;
        let num_formats = body[21] as usize;
        var pad_vendor = 0usize;
        if (vendor_len % 4usize) != 0usize { pad_vendor = 4usize - (vendor_len % 4usize); }
        let screen_offset = 32usize + vendor_len + pad_vendor + num_formats * 8usize;
        let root_window = gui_read_u32(body, screen_offset);
        let root_visual = gui_read_u32(body, screen_offset + 32usize);
        let root_depth = body[screen_offset + 38] as u8;
        free(body);

        let win_id = rid_base | 1u32;
        let gc_id = rid_base | 2u32;

        // 1. CreateWindow
        let cw_buf = malloc(40usize);
        var cwi = 0usize;
        while cwi < 40usize { cw_buf[cwi] = 0u8; cwi = cwi + 1usize; }
        cw_buf[0] = 1u8; // CreateWindow
        cw_buf[1] = root_depth;
        cw_buf[2] = 10u8; // length = 10 words (40 bytes)
        cw_buf[3] = 0u8;
        let cw_32 = cw_buf as *raw var u32;
        cw_32[1] = win_id;
        cw_32[2] = root_window;
        let cw_16 = cw_buf as *raw var u16;
        cw_16[6] = 50u16; cw_16[7] = 50u16;
        cw_16[8] = width as u16; cw_16[9] = height as u16;
        cw_16[10] = 0u16; cw_16[11] = 1u16;
        cw_32[6] = root_visual;
        cw_32[7] = 0x802u32; // CWBackPixel | CWEventMask
        cw_32[8] = 0x00121418u32;
        cw_32[9] = 0x0002804Du32; // Exposure | KeyPress | ButtonPress | ButtonRelease | PointerMotion | StructureNotify
        let _ = syscall3(1i64, fd as i64, cw_buf as i64, 40i64);
        free(cw_buf);

        // 2. CreateGC
        let gc_buf = malloc(16usize);
        var gci = 0usize;
        while gci < 16usize { gc_buf[gci] = 0u8; gci = gci + 1usize; }
        gc_buf[0] = 55u8;
        gc_buf[2] = 4u8;
        let gc_32 = gc_buf as *raw var u32;
        gc_32[1] = gc_id;
        gc_32[2] = win_id;
        let _ = syscall3(1i64, fd as i64, gc_buf as i64, 16i64);
        free(gc_buf);

        // 3. MapWindow
        let map_buf = malloc(8usize);
        map_buf[0] = 8u8; map_buf[1] = 0u8; map_buf[2] = 2u8; map_buf[3] = 0u8;
        let map_32 = map_buf as *raw var u32;
        map_32[1] = win_id;
        let _ = syscall3(1i64, fd as i64, map_buf as i64, 8i64);
        free(map_buf);

        // PutImage chunk buffer (sized for 32 scanline chunk)
        let chunk_h = 32usize;
        let max_pixel_words = (width as usize) * chunk_h;
        let put_buf_len = (6usize + max_pixel_words) * 4usize;
        let put_buf = malloc(put_buf_len);
        var pi = 0usize;
        while pi < 24usize { put_buf[pi] = 0u8; pi = pi + 1usize; }

        return X11Backend {
            sock_fd: fd, win_id: win_id, gc_id: gc_id, width: width, height: height,
            is_open: true, mouse_x: 0.0, mouse_y: 0.0, mouse_down: false,
            put_buf: put_buf, put_buf_len: put_buf_len,
        };
    }

    pub fn poll_events(var self, var events: Vec<WindowEvent>) -> bool {
        if !self.is_open { return false; }

        let pfd = malloc(8usize);
        let pfd_32 = pfd as *raw var i32;
        pfd_32[0] = self.sock_fd;
        let pfd_16 = pfd as *raw var i16;
        pfd_16[2] = 1i16; // POLLIN
        pfd_16[3] = 0i16;

        let ev_buf = malloc(32usize);
        while true {
            let pr = syscall3(7i64, pfd as i64, 1i64, 0i64) as i32;
            if pr <= 0 { break; }
            let n = syscall3(0i64, self.sock_fd as i64, ev_buf as i64, 32i64) as isize;
            if n < 32isize { break; }

            let ev_code = ev_buf[0] & 0x7Fu8;
            if ev_code == 2u8 {
                let key = ev_buf[1] as u32;
                events.push(WindowEvent {
                    event_type: WINDOW_EVENT_KEY_DOWN,
                    x: self.mouse_x, y: self.mouse_y, key_code: key, width: 0.0, height: 0.0,
                });
                if key == 9u32 || key == 24u32 {
                    self.is_open = false;
                    events.push(WindowEvent {
                        event_type: WINDOW_EVENT_CLOSE,
                        x: 0.0, y: 0.0, key_code: 0u32, width: 0.0, height: 0.0,
                    });
                }
            } else if ev_code == 3u8 {
                let key = ev_buf[1] as u32;
                events.push(WindowEvent {
                    event_type: WINDOW_EVENT_KEY_UP,
                    x: self.mouse_x, y: self.mouse_y, key_code: key, width: 0.0, height: 0.0,
                });
            } else if ev_code == 4u8 {
                let btn = ev_buf[1] as u32;
                let mx = gui_read_u16(ev_buf, 24usize) as f32;
                let my = gui_read_u16(ev_buf, 26usize) as f32;
                self.mouse_x = mx; self.mouse_y = my;
                if btn == 1u32 { self.mouse_down = true; }
                events.push(WindowEvent::mouse_down(self.mouse_x, self.mouse_y));
            } else if ev_code == 5u8 {
                let btn = ev_buf[1] as u32;
                let mx = gui_read_u16(ev_buf, 24usize) as f32;
                let my = gui_read_u16(ev_buf, 26usize) as f32;
                self.mouse_x = mx; self.mouse_y = my;
                if btn == 1u32 { self.mouse_down = false; }
                events.push(WindowEvent {
                    event_type: WINDOW_EVENT_MOUSE_UP,
                    x: self.mouse_x, y: self.mouse_y, key_code: btn, width: 0.0, height: 0.0,
                });
            } else if ev_code == 6u8 {
                let mx = gui_read_u16(ev_buf, 24usize) as f32;
                let my = gui_read_u16(ev_buf, 26usize) as f32;
                self.mouse_x = mx; self.mouse_y = my;
                events.push(WindowEvent::mouse_move(mx, my));
            } else if ev_code == 33u8 {
                self.is_open = false;
                events.push(WindowEvent {
                    event_type: WINDOW_EVENT_CLOSE,
                    x: 0.0, y: 0.0, key_code: 0u32, width: 0.0, height: 0.0,
                });
            }
        }

        free(ev_buf);
        free(pfd);
        return self.is_open;
    }

    pub fn commit(var self, pixels: *raw var u32) {
        if !self.is_open || (self.put_buf as usize) == 0usize || (pixels as usize) == 0usize { return; }
        let chunk_h = 32i32;
        var y = 0i32;
        while y < self.height {
            var h = chunk_h;
            if y + h > self.height {
                h = self.height - y;
            }
            let pixel_words = (self.width as usize) * (h as usize);
            let total_words = 6usize + pixel_words;

            self.put_buf[0] = 72u8; // PutImage
            self.put_buf[1] = 2u8;  // ZPixmap
            self.put_buf[2] = (total_words & 0xFFusize) as u8;
            self.put_buf[3] = ((total_words >> 8) & 0xFFusize) as u8;

            let put_32 = self.put_buf as *raw var u32;
            put_32[1] = self.win_id;
            put_32[2] = self.gc_id;

            let put_16 = self.put_buf as *raw var u16;
            put_16[6] = self.width as u16;
            put_16[7] = h as u16;
            put_16[8] = 0u16; // dst-x
            put_16[9] = y as u16; // dst-y

            self.put_buf[20] = 0u8; // left-pad
            self.put_buf[21] = 24u8; // depth
            self.put_buf[22] = 0u8;
            self.put_buf[23] = 0u8;

            let src_offset = (y as usize) * (self.width as usize);
            let dst_offset = 24usize;
            let _ = memcpy((self.put_buf as usize + dst_offset) as *raw var u8,
                           (pixels as usize + src_offset * 4usize) as *raw u8,
                           pixel_words * 4usize);

            let req_bytes = total_words * 4usize;
            let _ = syscall3(1i64, self.sock_fd as i64, self.put_buf as i64, req_bytes as i64);

            y = y + h;
        }
    }

    pub fn destroy(var self) {
        if self.sock_fd >= 0 {
            let _ = syscall1(3i64, self.sock_fd as i64);
            self.sock_fd = -1;
        }
        if (self.put_buf as usize) != 0usize {
            free(self.put_buf);
            self.put_buf = 0usize as *raw var u8;
        }
    }
}

// ------------------------------------------------------------------------------
// Unified High-Level Window & Software Rasterizer
// ------------------------------------------------------------------------------

pub struct Window {
    pub title: String,
    pub width: i32,
    pub height: i32,
    pub backend_type: u32,
    pub is_open_flag: bool,
    pub pixels: *raw var u32,
    pub font_cache: *raw var u8,
    pub event_queue: Vec<WindowEvent>,

    pub wayland: WaylandBackend,
    pub x11: X11Backend,
}

impl Window {
    pub fn open(title: str, width: i32, height: i32) -> Window {
        let detected = detect_display_backend();
        return Window::open_with_backend(title, width, height, detected);
    }

    pub fn open_with_backend(title: str, width: i32, height: i32, backend: u32) -> Window {
        // Allocate font cache
        let f_cache = malloc(4096usize);
        var ci = 0usize;
        while ci < 256usize {
            var ri = 0usize;
            while ri < 16usize {
                f_cache[ci * 16usize + ri] = gui_get_font_byte(ci, ri);
                ri = ri + 1usize;
            }
            ci = ci + 1usize;
        }

        let back_px = malloc((width as usize) * (height as usize) * 4usize) as *raw var u32;

        // If backend is WAYLAND:
        if backend == WINDOW_BACKEND_WAYLAND {
            var wl = WaylandBackend::init(title, width, height);
            if wl.is_open {
                return Window {
                    title: String.from_str(title),
                    width: width,
                    height: height,
                    backend_type: WINDOW_BACKEND_WAYLAND,
                    is_open_flag: true,
                    pixels: back_px,
                    font_cache: f_cache,
                    event_queue: Vec.new(),
                    wayland: wl,
                    x11: X11Backend {
                        sock_fd: -1, win_id: 0u32, gc_id: 0u32, width: width, height: height,
                        is_open: false, mouse_x: 0.0, mouse_y: 0.0, mouse_down: false,
                        put_buf: 0usize as *raw var u8, put_buf_len: 0usize,
                    },
                };
            }
        }

        // If backend is X11 or Wayland failed, fallback to X11:
        if backend == WINDOW_BACKEND_X11 || backend == WINDOW_BACKEND_WAYLAND {
            var x_backend = X11Backend::init(title, width, height);
            if x_backend.is_open {
                return Window {
                    title: String.from_str(title),
                    width: width,
                    height: height,
                    backend_type: WINDOW_BACKEND_X11,
                    is_open_flag: true,
                    pixels: back_px,
                    font_cache: f_cache,
                    event_queue: Vec.new(),
                    wayland: WaylandBackend {
                        sock_fd: -1, shm_fd: -1, width: width, height: height,
                        stride: width * 4i32, buf_size: 0, pixels: 0usize as *raw var u32,
                        configured: false, is_open: false, mouse_x: 0.0, mouse_y: 0.0,
                        mouse_down: false, pointer_bound: false,
                        read_buf: 0usize as *raw var u8, read_buf_cap: 0usize,
                    },
                    x11: x_backend,
                };
            }
        }

        // Headless Fallback:
        return Window {
            title: String.from_str(title),
            width: width,
            height: height,
            backend_type: WINDOW_BACKEND_HEADLESS,
            is_open_flag: true,
            pixels: back_px,
            font_cache: f_cache,
            event_queue: Vec.new(),
            wayland: WaylandBackend {
                sock_fd: -1, shm_fd: -1, width: width, height: height,
                stride: width * 4i32, buf_size: 0, pixels: 0usize as *raw var u32,
                configured: false, is_open: false, mouse_x: 0.0, mouse_y: 0.0,
                mouse_down: false, pointer_bound: false,
                read_buf: 0usize as *raw var u8, read_buf_cap: 0usize,
            },
            x11: X11Backend {
                sock_fd: -1, win_id: 0u32, gc_id: 0u32, width: width, height: height,
                is_open: false, mouse_x: 0.0, mouse_y: 0.0, mouse_down: false,
                put_buf: 0usize as *raw var u8, put_buf_len: 0usize,
            },
        };
    }

    pub fn is_open(self) -> bool {
        if self.backend_type == WINDOW_BACKEND_WAYLAND {
            return self.wayland.is_open;
        } else if self.backend_type == WINDOW_BACKEND_X11 {
            return self.x11.is_open;
        }
        return self.is_open_flag;
    }

    pub fn poll_events(var self) {
        if self.backend_type == WINDOW_BACKEND_WAYLAND {
            let _ = self.wayland.poll_events(self.event_queue);
            self.is_open_flag = self.wayland.is_open;
        } else if self.backend_type == WINDOW_BACKEND_X11 {
            let _ = self.x11.poll_events(self.event_queue);
            self.is_open_flag = self.x11.is_open;
        }
    }

    pub fn poll_event(var self) -> WindowEvent {
        if self.event_queue.len == 0usize {
            self.poll_events();
        }
        if self.event_queue.len == 0usize {
            return WindowEvent::none();
        }
        let ev = self.event_queue.ptr[0];
        var i = 0usize;
        while i + 1usize < self.event_queue.len {
            self.event_queue.ptr[i] = self.event_queue.ptr[i + 1usize];
            i = i + 1usize;
        }
        self.event_queue.len = self.event_queue.len - 1usize;
        return ev;
    }

    pub fn mouse_x(self) -> f32 {
        if self.backend_type == WINDOW_BACKEND_WAYLAND {
            return self.wayland.mouse_x;
        } else if self.backend_type == WINDOW_BACKEND_X11 {
            return self.x11.mouse_x;
        }
        return 0.0;
    }

    pub fn mouse_y(self) -> f32 {
        if self.backend_type == WINDOW_BACKEND_WAYLAND {
            return self.wayland.mouse_y;
        } else if self.backend_type == WINDOW_BACKEND_X11 {
            return self.x11.mouse_y;
        }
        return 0.0;
    }

    pub fn mouse_down(self) -> bool {
        if self.backend_type == WINDOW_BACKEND_WAYLAND {
            return self.wayland.mouse_down;
        } else if self.backend_type == WINDOW_BACKEND_X11 {
            return self.x11.mouse_down;
        }
        return false;
    }

    pub fn clear(var self, color: u32) {
        if (self.pixels as usize) == 0usize { return; }
        let count = (self.width as usize) * (self.height as usize);
        var i = 0usize;
        while i < count {
            self.pixels[i] = color;
            i = i + 1usize;
        }
    }

    pub fn draw_rect(var self, x: i32, y: i32, w: i32, h: i32, color: u32) {
        if (self.pixels as usize) == 0usize || w <= 0 || h <= 0 { return; }
        var x0 = x; if x0 < 0 { x0 = 0; }
        var y0 = y; if y0 < 0 { y0 = 0; }
        var x1 = x + w; if x1 > self.width { x1 = self.width; }
        var y1 = y + h; if y1 > self.height { y1 = self.height; }

        var r = y0;
        while r < y1 {
            let row_offset = (r * self.width) as usize;
            var c = x0;
            while c < x1 {
                self.pixels[row_offset + (c as usize)] = color;
                c = c + 1i32;
            }
            r = r + 1i32;
        }
    }

    pub fn draw_rect_outline(var self, x: i32, y: i32, w: i32, h: i32, border_width: i32, color: u32) {
        if w <= 0 || h <= 0 || border_width <= 0 { return; }
        self.draw_rect(x, y, w, border_width, color);
        self.draw_rect(x, y + h - border_width, w, border_width, color);
        self.draw_rect(x, y + border_width, border_width, h - 2 * border_width, color);
        self.draw_rect(x + w - border_width, y + border_width, border_width, h - 2 * border_width, color);
    }

    pub fn draw_rect_rounded(var self, x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32) {
        if w <= 0 || h <= 0 { return; }
        var rad = radius;
        if rad <= 0 {
            self.draw_rect(x, y, w, h, color);
            return;
        }
        if rad > w / 2 { rad = w / 2; }
        if rad > h / 2 { rad = h / 2; }

        let r2 = rad * rad;
        self.draw_rect(x, y + rad, w, h - 2 * rad, color);
        self.draw_rect(x + rad, y, w - 2 * rad, rad, color);
        self.draw_rect(x + rad, y + h - rad, w - 2 * rad, rad, color);

        let cx0 = x + rad; let cx1 = x + w - rad - 1;
        let cy0 = y + rad; let cy1 = y + h - rad - 1;

        var dy = 0;
        while dy < rad {
            var dx = 0;
            while dx < rad {
                let d2 = (rad - 1 - dx) * (rad - 1 - dx) + (rad - 1 - dy) * (rad - 1 - dy);
                if d2 <= r2 {
                    let px0 = cx0 - rad + dx; let py0 = cy0 - rad + dy;
                    if px0 >= 0 && px0 < self.width && py0 >= 0 && py0 < self.height {
                        self.pixels[(py0 * self.width + px0) as usize] = color;
                    }
                    let px1 = cx1 + (rad - 1 - dx); let py1 = cy0 - rad + dy;
                    if px1 >= 0 && px1 < self.width && py1 >= 0 && py1 < self.height {
                        self.pixels[(py1 * self.width + px1) as usize] = color;
                    }
                    let px2 = cx0 - rad + dx; let py2 = cy1 + (rad - 1 - dy);
                    if px2 >= 0 && px2 < self.width && py2 >= 0 && py2 < self.height {
                        self.pixels[(py2 * self.width + px2) as usize] = color;
                    }
                    let px3 = cx1 + (rad - 1 - dx); let py3 = cy1 + (rad - 1 - dy);
                    if px3 >= 0 && px3 < self.width && py3 >= 0 && py3 < self.height {
                        self.pixels[(py3 * self.width + px3) as usize] = color;
                    }
                }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
    }

    pub fn draw_circle(var self, cx: i32, cy: i32, radius: i32, color: u32) {
        if (self.pixels as usize) == 0usize || radius <= 0 { return; }
        let r2 = radius * radius;
        var y0 = cy - radius; if y0 < 0 { y0 = 0; }
        var y1 = cy + radius; if y1 >= self.height { y1 = self.height - 1; }

        var y = y0;
        while y <= y1 {
            let dy = y - cy;
            var dx = 0;
            while dx <= radius && (dx * dx + dy * dy) <= r2 {
                dx = dx + 1;
            }
            dx = dx - 1;
            var x0 = cx - dx; if x0 < 0 { x0 = 0; }
            var x1 = cx + dx; if x1 >= self.width { x1 = self.width - 1; }

            let row_offset = (y * self.width) as usize;
            var x = x0;
            while x <= x1 {
                self.pixels[row_offset + (x as usize)] = color;
                x = x + 1;
            }
            y = y + 1;
        }
    }

    pub fn draw_text(var self, x: i32, y: i32, text: str, color: u32, scale: i32) {
        if (self.pixels as usize) == 0usize || (text as usize) == 0usize { return; }
        var s = scale;
        if s <= 0 { s = 1; }

        var cur_x = x;
        var cur_y = y;
        let p_text = text as *raw u8;

        var i = 0usize;
        while p_text[i] != 0u8 {
            let c = p_text[i] as usize;
            if c == 10usize { // newline
                cur_x = x;
                cur_y = cur_y + 18 * s;
                i = i + 1usize;
                continue;
            }

            var row = 0usize;
            while row < 16usize {
                let bits = self.font_cache[c * 16usize + row];
                let py = cur_y + (row as i32) * s;
                if py >= self.height { break; }
                if py + s > 0 {
                    var col = 0usize;
                    while col < 8usize {
                        if (bits & (0x80u8 >> col)) != 0u8 {
                            let px = cur_x + (col as i32) * s;
                            if px < self.width && px + s > 0 {
                                if s == 1 {
                                    if px >= 0 && py >= 0 {
                                        self.pixels[(py * self.width + px) as usize] = color;
                                    }
                                } else {
                                    self.draw_rect(px, py, s, s, color);
                                }
                            }
                        }
                        col = col + 1usize;
                    }
                }
                row = row + 1usize;
            }
            cur_x = cur_x + 8 * s;
            i = i + 1usize;
        }
    }

    pub fn text_width(self, text: str, scale: i32) -> i32 {
        if (text as usize) == 0usize { return 0; }
        var s = scale; if s <= 0 { s = 1; }
        let p = text as *raw u8;
        var len = 0i32;
        while p[len as usize] != 0u8 {
            len = len + 1;
        }
        return len * 8 * s;
    }

    pub fn i64_width(self, val: i64, scale: i32) -> i32 {
        var s = scale; if s <= 0 { s = 1; }
        var v = val;
        var digits = 0i32;
        if v < 0i64 {
            digits = 1;
            v = -v;
        }
        if v == 0i64 {
            digits = 1;
        } else {
            while v > 0i64 {
                digits = digits + 1;
                v = v / 10i64;
            }
        }
        return digits * 8 * s;
    }

    pub fn draw_i64(var self, x: i32, y: i32, val: i64, color: u32, scale: i32) {
        let buf = malloc(32usize); var bi = 0usize; while bi < 32usize { buf[bi] = 0u8; bi = bi + 1usize; }
        var v = val;
        var is_neg = false;
        if v < 0i64 {
            is_neg = true;
            v = -v;
        }
        var pos = 30usize;
        if v == 0i64 {
            buf[pos] = '0' as u8;
            pos = pos - 1usize;
        } else {
            while v > 0i64 && pos > 0usize {
                let rem = (v % 10i64) as u8;
                buf[pos] = ('0' as u8) + rem;
                v = v / 10i64;
                pos = pos - 1usize;
            }
        }
        if is_neg && pos > 0usize {
            buf[pos] = '-' as u8;
            pos = pos - 1usize;
        }
        let p_str = (buf as usize + pos + 1usize) as str;
        self.draw_text(x, y, p_str, color, scale);
    }

    pub fn draw_formatted(var self, x: i32, y: i32, prefix: str, val: i64, suffix: str, color: u32, scale: i32) {
        var res = String.from_str(prefix);
        let buf = malloc(32usize); var bi = 0usize; while bi < 32usize { buf[bi] = 0u8; bi = bi + 1usize; }
        var v = val;
        var is_neg = false;
        if v < 0i64 { is_neg = true; v = -v; }
        var pos = 30usize;
        if v == 0i64 {
            buf[pos] = '0' as u8;
            pos = pos - 1usize;
        } else {
            while v > 0i64 && pos > 0usize {
                let rem = (v % 10i64) as u8;
                buf[pos] = ('0' as u8) + rem;
                v = v / 10i64;
                pos = pos - 1usize;
            }
        }
        if is_neg && pos > 0usize {
            buf[pos] = '-' as u8;
            pos = pos - 1usize;
        }
        let p_num = (buf as usize + pos + 1usize) as str;
        res.push_str(p_num);
        res.push_str(suffix);
        self.draw_text(x, y, res.as_ptr() as str, color, scale);
    }

    pub fn draw_xy(var self, x: i32, y: i32, prefix: str, val_x: i64, val_y: i64, color: u32, scale: i32) {
        var res = String.from_str(prefix);
        res.push_str("X = ");
        // format val_x
        let buf = malloc(32usize); var bi = 0usize; while bi < 32usize { buf[bi] = 0u8; bi = bi + 1usize; }
        var v = val_x;
        var pos = 30usize;
        if v == 0i64 { buf[pos] = '0' as u8; pos = pos - 1usize; }
        else {
            while v > 0i64 && pos > 0usize {
                buf[pos] = ('0' as u8) + ((v % 10i64) as u8);
                v = v / 10i64;
                pos = pos - 1usize;
            }
        }
        res.push_str((buf as usize + pos + 1usize) as str);
        res.push_str(", Y = ");
        // format val_y
        let buf2 = malloc(32usize); var bi2 = 0usize; while bi2 < 32usize { buf2[bi2] = 0u8; bi2 = bi2 + 1usize; }
        v = val_y;
        pos = 30usize;
        if v == 0i64 { buf2[pos] = '0' as u8; pos = pos - 1usize; }
        else {
            while v > 0i64 && pos > 0usize {
                buf2[pos] = ('0' as u8) + ((v % 10i64) as u8);
                v = v / 10i64;
                pos = pos - 1usize;
            }
        }
        res.push_str((buf2 as usize + pos + 1usize) as str);
        res.push_str(" px");
        self.draw_text(x, y, res.as_ptr() as str, color, scale);
    }

    pub fn present(var self) {
        if self.backend_type == WINDOW_BACKEND_WAYLAND {
            self.wayland.commit(self.pixels);
        } else if self.backend_type == WINDOW_BACKEND_X11 {
            self.x11.commit(self.pixels);
        }
    }

    pub fn save_bmp(self, filename: str) -> bool {
        if (self.pixels as usize) == 0usize || (filename as usize) == 0usize { return false; }
        // 0x242 = O_CREAT (0x40) | O_RDWR (0x02) | O_TRUNC (0x200), mode 0666 = 438
        let fd = syscall3(2i64, filename as i64, 0x242i64, 438i64) as i32;
        if fd < 0 { return false; }

        let w = self.width;
        let h = self.height;
        let row_size = (w * 4i32) as usize;
        let image_size = row_size * (h as usize);
        let file_size = 54usize + image_size;

        let hdr = malloc(54usize);
        var i = 0usize;
        while i < 54usize { hdr[i] = 0u8; i = i + 1usize; }

        // BMP header
        hdr[0] = 'B' as u8; hdr[1] = 'M' as u8;
        let fs = file_size as u32;
        hdr[2] = (fs & 0xFFu32) as u8;
        hdr[3] = ((fs >> 8) & 0xFFu32) as u8;
        hdr[4] = ((fs >> 16) & 0xFFu32) as u8;
        hdr[5] = ((fs >> 24) & 0xFFu32) as u8;
        hdr[10] = 54u8;

        // DIB header
        hdr[14] = 40u8;
        let wu = w as u32;
        hdr[18] = (wu & 0xFFu32) as u8;
        hdr[19] = ((wu >> 8) & 0xFFu32) as u8;
        hdr[20] = ((wu >> 16) & 0xFFu32) as u8;
        hdr[21] = ((wu >> 24) & 0xFFu32) as u8;

        // Negative height for top-down bitmap
        let nh = (-h) as u32;
        hdr[22] = (nh & 0xFFu32) as u8;
        hdr[23] = ((nh >> 8) & 0xFFu32) as u8;
        hdr[24] = ((nh >> 16) & 0xFFu32) as u8;
        hdr[25] = ((nh >> 24) & 0xFFu32) as u8;

        hdr[26] = 1u8;  // planes
        hdr[28] = 32u8; // bpp

        let is = image_size as u32;
        hdr[34] = (is & 0xFFu32) as u8;
        hdr[35] = ((is >> 8) & 0xFFu32) as u8;
        hdr[36] = ((is >> 16) & 0xFFu32) as u8;
        hdr[37] = ((is >> 24) & 0xFFu32) as u8;

        let _ = syscall3(1i64, fd as i64, hdr as i64, 54i64);
        free(hdr);

        let _ = syscall3(1i64, fd as i64, self.pixels as i64, image_size as i64);
        let _ = close(fd);
        return true;
    }

    pub fn close(var self) {
        self.is_open_flag = false;
        if self.backend_type == WINDOW_BACKEND_WAYLAND {
            self.wayland.is_open = false;
        } else if self.backend_type == WINDOW_BACKEND_X11 {
            self.x11.is_open = false;
        }
    }

    pub fn destroy(var self) {
        if self.backend_type == WINDOW_BACKEND_WAYLAND {
            self.wayland.destroy();
        } else if self.backend_type == WINDOW_BACKEND_X11 {
            self.x11.destroy();
            if (self.pixels as usize) != 0usize {
                free(self.pixels as *raw var u8);
                self.pixels = 0usize as *raw var u32;
            }
        } else if self.backend_type == WINDOW_BACKEND_HEADLESS {
            if (self.pixels as usize) != 0usize {
                free(self.pixels as *raw var u8);
                self.pixels = 0usize as *raw var u32;
            }
        }
        if (self.font_cache as usize) != 0usize {
            free(self.font_cache);
            self.font_cache = 0usize as *raw var u8;
        }
    }
}

// ------------------------------------------------------------------------------
// Legacy NativeWindow Interface (Backwards-Compatibility with tests)
// ------------------------------------------------------------------------------

pub struct WindowConfig {
    pub title: String,
    pub width: f32,
    pub height: f32,
    pub backend: u32,
    pub resizable: bool,
}

pub struct NativeWindow {
    pub config: WindowConfig,
    pub is_open: bool,
    pub event_queue: Vec<WindowEvent>,
}

impl NativeWindow {
    pub fn new(title: str, width: f32, height: f32, backend: u32) -> NativeWindow {
        return NativeWindow {
            config: WindowConfig {
                title: String.from_str(title),
                width: width,
                height: height,
                backend: backend,
                resizable: true,
            },
            is_open: true,
            event_queue: Vec.new(),
        };
    }

    pub fn push_event(var self, ev: WindowEvent) {
        self.event_queue.push(ev);
    }

    pub fn poll_event(var self) -> WindowEvent {
        if self.event_queue.len == 0usize {
            return WindowEvent::none();
        }
        let ev = self.event_queue.ptr[0];
        var i = 0usize;
        while i + 1usize < self.event_queue.len {
            self.event_queue.ptr[i] = self.event_queue.ptr[i + 1usize];
            i = i + 1usize;
        }
        self.event_queue.len = self.event_queue.len - 1usize;
        return ev;
    }

    pub fn close(var self) {
        self.is_open = false;
    }

    pub fn width(self) -> f32 {
        return self.config.width;
    }

    pub fn height(self) -> f32 {
        return self.config.height;
    }
}

// ------------------------------------------------------------------------------
// 2D Vector Path Tessellator
// ------------------------------------------------------------------------------

pub struct Vertex2D {
    pub x: f32,
    pub y: f32,
    pub u: f32,
    pub v: f32,
    pub color: u32,
}

pub struct VectorPath {
    pub vertices: Vec<Vertex2D>,
    pub indices: Vec<u32>,
}

impl VectorPath {
    pub fn new() -> VectorPath {
        return VectorPath {
            vertices: Vec.new(),
            indices: Vec.new(),
        };
    }

    pub fn add_vertex(var self, x: f32, y: f32, u: f32, v: f32, color: u32) -> u32 {
        let idx = self.vertices.len as u32;
        self.vertices.push(Vertex2D { x: x, y: y, u: u, v: v, color: color });
        return idx;
    }

    pub fn add_triangle(var self, i0: u32, i1: u32, i2: u32) {
        self.indices.push(i0);
        self.indices.push(i1);
        self.indices.push(i2);
    }

    pub fn add_rect(var self, x: f32, y: f32, w: f32, h: f32, color: u32) {
        let v0 = self.add_vertex(x, y, 0.0, 0.0, color);
        let v1 = self.add_vertex(x + w, y, 1.0, 0.0, color);
        let v2 = self.add_vertex(x + w, y + h, 1.0, 1.0, color);
        let v3 = self.add_vertex(x, y + h, 0.0, 1.0, color);

        self.add_triangle(v0, v1, v2);
        self.add_triangle(v0, v2, v3);
    }

    pub fn add_circle(var self, cx: f32, cy: f32, radius: f32, segments: usize, color: u32) {
        if segments < 3usize { return; }
        let center_idx = self.add_vertex(cx, cy, 0.5, 0.5, color);
        let seg_f = segments as f32;
        let pi2 = 6.2831853f32;

        var i = 0usize;
        while i < segments {
            let theta = (i as f32) * pi2 / seg_f;
            let x = cx + radius * (1.0 - (theta * theta) * 0.5);
            let y = cy + radius * theta;
            let _ = self.add_vertex(x, y, 0.0, 0.0, color);
            i = i + 1usize;
        }

        var s = 0usize;
        while s < segments {
            let next_s = (s + 1usize) % segments;
            self.add_triangle(center_idx, (center_idx + 1u32 + (s as u32)), (center_idx + 1u32 + (next_s as u32)));
            s = s + 1usize;
        }
    }

    pub fn vertex_count(self) -> usize {
        return self.vertices.len;
    }

    pub fn index_count(self) -> usize {
        return self.indices.len;
    }

    pub fn clear(var self) {
        self.vertices = Vec.new();
        self.indices = Vec.new();
    }
}

// ------------------------------------------------------------------------------
// Font Metrics & Atlas
// ------------------------------------------------------------------------------

pub struct FontAtlas {
    pub family: String,
    pub size: f32,
}

impl FontAtlas {
    pub fn new(family: str, size: f32) -> FontAtlas {
        return FontAtlas {
            family: String.from_str(family),
            size: size,
        };
    }

    pub fn measure_text(self, text: str, font_size: f32) -> f32 {
        let len = gui_str_len(text) as f32;
        return len * font_size * 0.55;
    }

    pub fn line_height(self, font_size: f32) -> f32 {
        return font_size * 1.25;
    }
}

// ------------------------------------------------------------------------------
// Flexbox Layout Engine
// ------------------------------------------------------------------------------

pub const FLEX_DIRECTION_ROW: u32    = 0u32;
pub const FLEX_DIRECTION_COLUMN: u32 = 1u32;

pub const ALIGN_START: u32           = 0u32;
pub const ALIGN_CENTER: u32          = 1u32;
pub const ALIGN_END: u32             = 2u32;

pub const JUSTIFY_START: u32         = 0u32;
pub const JUSTIFY_CENTER: u32        = 1u32;
pub const JUSTIFY_END: u32           = 2u32;
pub const JUSTIFY_SPACE_BETWEEN: u32 = 3u32;

pub struct LayoutBox {
    pub x: f32,
    pub y: f32,
    pub width: f32,
    pub height: f32,
    pub direction: u32,
    pub align_items: u32,
    pub justify_content: u32,
    pub padding_left: f32,
    pub padding_top: f32,
    pub padding_right: f32,
    pub padding_bottom: f32,
    pub flex_grow: f32,
    pub children: Vec<LayoutBox>,
}

impl LayoutBox {
    pub fn new(w: f32, h: f32) -> LayoutBox {
        return LayoutBox {
            x: 0.0,
            y: 0.0,
            width: w,
            height: h,
            direction: FLEX_DIRECTION_ROW,
            align_items: ALIGN_START,
            justify_content: JUSTIFY_START,
            padding_left: 0.0,
            padding_top: 0.0,
            padding_right: 0.0,
            padding_bottom: 0.0,
            flex_grow: 0.0,
            children: Vec.new(),
        };
    }

    pub fn add_child(var self, child: LayoutBox) {
        self.children.push(child);
    }

    pub fn compute_layout(var self, container_w: f32, container_h: f32) {
        if self.width <= 0.0 { self.width = container_w; }
        if self.height <= 0.0 { self.height = container_h; }

        let avail_w = self.width - self.padding_left - self.padding_right;
        let avail_h = self.height - self.padding_top - self.padding_bottom;

        var cur_x = self.x + self.padding_left;
        var cur_y = self.y + self.padding_top;

        if self.direction == FLEX_DIRECTION_ROW {
            var ci = 0usize;
            while ci < self.children.len {
                let ch_w = self.children.ptr[ci].width;
                let ch_h = self.children.ptr[ci].height;

                var child_y = cur_y;
                if self.align_items == ALIGN_CENTER {
                    child_y = cur_y + (avail_h - ch_h) * 0.5;
                } else if self.align_items == ALIGN_END {
                    child_y = cur_y + (avail_h - ch_h);
                }

                self.children.ptr[ci].x = cur_x;
                self.children.ptr[ci].y = child_y;
                self.children.ptr[ci].compute_layout(ch_w, ch_h);

                cur_x = cur_x + ch_w;
                ci = ci + 1usize;
            }
        } else {
            var ci = 0usize;
            while ci < self.children.len {
                let ch_w = self.children.ptr[ci].width;
                let ch_h = self.children.ptr[ci].height;

                var child_x = cur_x;
                if self.align_items == ALIGN_CENTER {
                    child_x = cur_x + (avail_w - ch_w) * 0.5;
                } else if self.align_items == ALIGN_END {
                    child_x = cur_x + (avail_w - ch_w);
                }

                self.children.ptr[ci].x = child_x;
                self.children.ptr[ci].y = cur_y;
                self.children.ptr[ci].compute_layout(ch_w, ch_h);

                cur_y = cur_y + ch_h;
                ci = ci + 1usize;
            }
        }
    }
}

// ------------------------------------------------------------------------------
// Declarative UI Widget Hierarchy
// ------------------------------------------------------------------------------

pub const WIDGET_CONTAINER: u32 = 0u32;
pub const WIDGET_BUTTON: u32    = 1u32;
pub const WIDGET_LABEL: u32     = 2u32;

pub struct UiWidget {
    pub id: usize,
    pub widget_type: u32,
    pub label: String,
    pub layout: LayoutBox,
    pub bg_color: u32,
    pub text_color: u32,
    pub is_hovered: bool,
    pub is_pressed: bool,
    pub children: Vec<UiWidget>,
}

impl UiWidget {
    pub fn new_container(id: usize, w: f32, h: f32, bg: u32) -> UiWidget {
        return UiWidget {
            id: id,
            widget_type: WIDGET_CONTAINER,
            label: String.new(),
            layout: LayoutBox::new(w, h),
            bg_color: bg,
            text_color: 0u32,
            is_hovered: false,
            is_pressed: false,
            children: Vec.new(),
        };
    }

    pub fn new_button(id: usize, text: str, w: f32, h: f32) -> UiWidget {
        return UiWidget {
            id: id,
            widget_type: WIDGET_BUTTON,
            label: String.from_str(text),
            layout: LayoutBox::new(w, h),
            bg_color: 0x004488u32,
            text_color: 0xFFFFFFu32,
            is_hovered: false,
            is_pressed: false,
            children: Vec.new(),
        };
    }

    pub fn new_label(id: usize, text: str, w: f32, h: f32) -> UiWidget {
        return UiWidget {
            id: id,
            widget_type: WIDGET_LABEL,
            label: String.from_str(text),
            layout: LayoutBox::new(w, h),
            bg_color: 0u32,
            text_color: 0x222222u32,
            is_hovered: false,
            is_pressed: false,
            children: Vec.new(),
        };
    }

    pub fn add_child(var self, child: UiWidget) {
        self.children.push(child);
    }

    pub fn contains_point(self, px: f32, py: f32) -> bool {
        let x0 = self.layout.x;
        let y0 = self.layout.y;
        let x1 = x0 + self.layout.width;
        let y1 = y0 + self.layout.height;
        return px >= x0 && px <= x1 && py >= y0 && py <= y1;
    }

    pub fn dispatch_mouse_move(var self, mx: f32, my: f32) {
        self.is_hovered = self.contains_point(mx, my);
        var i = 0usize;
        while i < self.children.len {
            self.children.ptr[i].dispatch_mouse_move(mx, my);
            i = i + 1usize;
        }
    }

    pub fn dispatch_mouse_click(var self, mx: f32, my: f32) -> usize {
        if !self.contains_point(mx, my) {
            return 0usize;
        }
        var i = 0usize;
        while i < self.children.len {
            let hit = self.children.ptr[i].dispatch_mouse_click(mx, my);
            if hit != 0usize {
                return hit;
            }
            i = i + 1usize;
        }
        if self.widget_type == WIDGET_BUTTON {
            self.is_pressed = true;
            return self.id;
        }
        return 0usize;
    }

    pub fn render(self, var path: VectorPath) {
        if self.bg_color != 0u32 {
            var col = self.bg_color;
            if self.is_hovered && self.widget_type == WIDGET_BUTTON {
                col = col + 0x001122u32;
            }
            path.add_rect(self.layout.x, self.layout.y, self.layout.width, self.layout.height, col);
        }

        var i = 0usize;
        while i < self.children.len {
            self.children.ptr[i].render(path);
            i = i + 1usize;
        }
    }
}
