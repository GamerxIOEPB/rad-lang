// ==============================================================================
// Rad Standard Library: Embedded Key-Value Storage Engine (std::kv)
// Pure-Rad Log-Structured Bitcask-style Key-Value Engine with Zero Dependencies.
// ACID writes, single-seek O(1) reads, background compaction, and integrity checks.
// ==============================================================================

extern "C" {
    fn open(path: str, flags: i32, mode: u32) -> i32;
    fn close(fd: i32) -> i32;
    fn pread(fd: i32, buf: *raw var u8, count: usize, offset: i64) -> i64;
    fn pwrite(fd: i32, buf: *raw u8, count: usize, offset: i64) -> i64;
    fn write(fd: i32, buf: *raw u8, count: usize) -> i64;
    fn read(fd: i32, buf: *raw var u8, count: usize) -> i64;
    fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
    fn fsync(fd: i32) -> i32;
    fn unlink(path: str) -> i32;
    fn rename(oldpath: str, newpath: str) -> i32;
    fn time(tloc: *raw var u64) -> u64;
}

fn kv_str_len(s: str) -> usize {
    if (s as usize) == 0usize {
        return 0usize
    }
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

fn kv_str_eq(a: str, b: str) -> bool {
    let pa = a as usize
    let pb = b as usize
    if pa == pb { return true }
    if pa == 0usize || pb == 0usize { return false }
    let la = kv_str_len(a)
    let lb = kv_str_len(b)
    if la != lb { return false }
    let b1 = a as *raw u8
    let b2 = b as *raw u8
    var i = 0usize
    while i < la {
        if b1[i] != b2[i] { return false }
        i = i + 1usize
    }
    return true
}

// 32-bit FNV-1a Hash for Record Checksum
fn kv_calc_checksum(k_ptr: *raw u8, k_len: usize, v_ptr: *raw u8, v_len: usize) -> u32 {
    var h: u32 = 2166136261u32
    var i = 0usize
    while i < k_len {
        h = h ^ (k_ptr[i] as u32)
        h = h * 16777619u32
        i = i + 1usize
    }
    i = 0usize
    while i < v_len {
        h = h ^ (v_ptr[i] as u32)
        h = h * 16777619u32
        i = i + 1usize
    }
    return h
}

// Little-Endian serialization helpers
fn kv_write_u32(buf: *raw var u8, offset: usize, val: u32) {
    buf[offset + 0usize] = (val & 255u32) as u8
    buf[offset + 1usize] = ((val >> 8u32) & 255u32) as u8
    buf[offset + 2usize] = ((val >> 16u32) & 255u32) as u8
    buf[offset + 3usize] = ((val >> 24u32) & 255u32) as u8
}

fn kv_read_u32(buf: *raw u8, offset: usize) -> u32 {
    let b0 = buf[offset + 0usize] as u32
    let b1 = (buf[offset + 1usize] as u32) << 8u32
    let b2 = (buf[offset + 2usize] as u32) << 16u32
    let b3 = (buf[offset + 3usize] as u32) << 24u32
    return b0 | b1 | b2 | b3
}

fn kv_write_u64(buf: *raw var u8, offset: usize, val: u64) {
    var i = 0usize
    var cur = val
    while i < 8usize {
        buf[offset + i] = (cur & 255u64) as u8
        cur = cur >> 8u64
        i = i + 1usize
    }
}

fn kv_read_u64(buf: *raw u8, offset: usize) -> u64 {
    var res: u64 = 0u64
    var i = 8usize
    while i > 0usize {
        i = i - 1usize
        res = (res << 8u64) | (buf[offset + i] as u64)
    }
    return res
}

// ------------------------------------------------------------------------------
// KvBatch: Atomic Multiple Mutation Builder
// ------------------------------------------------------------------------------

pub struct KvBatch {
    pub ops: Vec<i32>,         // 0 = Put, 1 = Delete
    pub keys: Vec<String>,
    pub values: Vec<String>,
}

impl KvBatch {
    pub fn new() -> KvBatch {
        return KvBatch {
            ops: Vec.new(),
            keys: Vec.new(),
            values: Vec.new(),
        }
    }

    pub fn put(var self, key: str, val: str) {
        self.ops.push(0i32)
        self.keys.push(String.from_str(key))
        self.values.push(String.from_str(val))
    }

    pub fn delete(var self, key: str) {
        self.ops.push(1i32)
        self.keys.push(String.from_str(key))
        self.values.push(String.new())
    }

    pub fn count(self) -> usize {
        return self.ops.len
    }

    pub fn clear(var self) {
        self.ops.len = 0usize
        self.keys.len = 0usize
        self.values.len = 0usize
    }
}

// ------------------------------------------------------------------------------
// KvStore: Embedded Key-Value Storage Engine
// ------------------------------------------------------------------------------

pub struct KvStore {
    pub file_path: String,
    pub fd: i32,
    pub is_open: bool,
    pub keys: Vec<String>,
    pub offsets: Vec<usize>,
    pub val_lens: Vec<usize>,
    pub timestamps: Vec<u64>,
}

impl KvStore {
    // Open or create a database file at the specified filesystem path
    pub fn open(path: str) -> Option<KvStore> {
        // O_RDWR (2) | O_CREAT (64) = 66
        let fd = open(path, 66i32, 420u32) // mode 0644
        if fd < 0 {
            return Option.None
        }

        var store = KvStore {
            file_path: String.from_str(path),
            fd: fd,
            is_open: true,
            keys: Vec.new(),
            offsets: Vec.new(),
            val_lens: Vec.new(),
            timestamps: Vec.new(),
        }

        store.load_index()
        return Option.Some(store)
    }

    fn find_key(self, key: str) -> i64 {
        var i = 0usize
        while i < self.keys.len {
            let k = self.keys.ptr[i].as_ptr() as str
            if kv_str_eq(k, key) {
                return i as i64
            }
            i = i + 1usize
        }
        return -1i64
    }

    // Scans the append-only log file to populate the in-memory KeyDir index
    fn load_index(var self) {
        let fsize = lseek(self.fd, 0i64, 2i32) // SEEK_END
        if fsize <= 0i64 {
            return
        }

        let hdr_buf = malloc(25usize) as *raw var u8
        var curr_offset = 0i64

        while curr_offset + 25i64 <= fsize {
            let n_hdr = pread(self.fd, hdr_buf, 25usize, curr_offset)
            if n_hdr != 25i64 {
                break
            }

            let magic = kv_read_u32(hdr_buf as *raw u8, 0usize)
            if magic != 1380009035u32 { // 0x5241444B = "RADK"
                break
            }

            let ts = kv_read_u64(hdr_buf as *raw u8, 4usize)
            let klen = kv_read_u32(hdr_buf as *raw u8, 12usize) as usize
            let vlen = kv_read_u32(hdr_buf as *raw u8, 16usize) as usize
            let tombstone = hdr_buf[20usize]
            let checksum = kv_read_u32(hdr_buf as *raw u8, 21usize)

            let rec_total = 25i64 + (klen as i64) + (vlen as i64)
            if curr_offset + rec_total > fsize {
                break // Partial tail record
            }

            // Read key
            let k_raw = malloc(klen + 1usize) as *raw var u8
            let n_key = pread(self.fd, k_raw, klen, curr_offset + 25i64)
            k_raw[klen] = 0u8

            // Read value for checksum verification
            var v_raw: *raw var u8 = 0usize as *raw var u8
            if vlen > 0usize {
                v_raw = malloc(vlen + 1usize) as *raw var u8
                let _nv = pread(self.fd, v_raw, vlen, curr_offset + 25i64 + (klen as i64))
                v_raw[vlen] = 0u8
            }

            let calc_chk = kv_calc_checksum(k_raw as *raw u8, klen, v_raw as *raw u8, vlen)
            if (v_raw as usize) != 0usize {
                free(v_raw)
            }

            if calc_chk != checksum {
                free(k_raw)
                break // Corrupted record, stop loading index
            }

            var k_str = String.new()
            var ki = 0usize
            while ki < klen {
                k_str.push_byte(k_raw[ki])
                ki = ki + 1usize
            }
            k_str.push_byte(0u8)
            free(k_raw)

            let k_name = k_str.as_ptr() as str
            let existing_idx = self.find_key(k_name)

            if tombstone != 0u8 {
                // Tombstone: remove from in-memory index
                if existing_idx >= 0i64 {
                    let idx = existing_idx as usize
                    let last_idx = self.keys.len - 1usize
                    if idx != last_idx {
                        self.keys.ptr[idx] = self.keys.ptr[last_idx]
                        self.offsets.ptr[idx] = self.offsets.ptr[last_idx]
                        self.val_lens.ptr[idx] = self.val_lens.ptr[last_idx]
                        self.timestamps.ptr[idx] = self.timestamps.ptr[last_idx]
                    }
                    let _ = self.keys.pop()
                    let _ = self.offsets.pop()
                    let _ = self.val_lens.pop()
                    let _ = self.timestamps.pop()
                }
            } else {
                // Active put: update or insert
                let val_offset = (curr_offset + 25i64 + (klen as i64)) as usize
                if existing_idx >= 0i64 {
                    let idx = existing_idx as usize
                    self.offsets.ptr[idx] = val_offset
                    self.val_lens.ptr[idx] = vlen
                    self.timestamps.ptr[idx] = ts
                } else {
                    self.keys.push(k_str)
                    self.offsets.push(val_offset)
                    self.val_lens.push(vlen)
                    self.timestamps.push(ts)
                }
            }

            curr_offset = curr_offset + rec_total
        }

        free(hdr_buf)
        let _ = lseek(self.fd, 0i64, 2i32) // Position at end for subsequent writes
    }

    // Insert or update a key-value record
    pub fn put(var self, key: str, val: str) -> bool {
        if !self.is_open { return false }
        let klen = kv_str_len(key)
        let vlen = kv_str_len(val)
        let ts = time(0usize as *raw var u64)
        let chk = kv_calc_checksum(key as *raw u8, klen, val as *raw u8, vlen)

        let curr_fpos = lseek(self.fd, 0i64, 2i32)
        if curr_fpos < 0i64 { return false }

        // Construct record header
        let hdr_buf = malloc(25usize) as *raw var u8
        kv_write_u32(hdr_buf, 0usize, 1380009035u32) // "RADK"
        kv_write_u64(hdr_buf, 4usize, ts)
        kv_write_u32(hdr_buf, 12usize, klen as u32)
        kv_write_u32(hdr_buf, 16usize, vlen as u32)
        hdr_buf[20usize] = 0u8 // not tombstone
        kv_write_u32(hdr_buf, 21usize, chk)

        let w_hdr = write(self.fd, hdr_buf as *raw u8, 25usize)
        free(hdr_buf)
        if w_hdr != 25i64 { return false }

        let w_key = write(self.fd, key as *raw u8, klen)
        if w_key != (klen as i64) { return false }

        if vlen > 0usize {
            let w_val = write(self.fd, val as *raw u8, vlen)
            if w_val != (vlen as i64) { return false }
        }

        // Update KeyDir index
        let val_offset = (curr_fpos + 25i64 + (klen as i64)) as usize
        let existing_idx = self.find_key(key)
        if existing_idx >= 0i64 {
            let idx = existing_idx as usize
            self.offsets.ptr[idx] = val_offset
            self.val_lens.ptr[idx] = vlen
            self.timestamps.ptr[idx] = ts
        } else {
            self.keys.push(String.from_str(key))
            self.offsets.push(val_offset)
            self.val_lens.push(vlen)
            self.timestamps.push(ts)
        }

        return true
    }

    // Retrieve a value by key in O(1) single-seek lookup
    pub fn get(self, key: str) -> Option<String> {
        if !self.is_open { return Option.None }
        let existing_idx = self.find_key(key)
        if existing_idx < 0i64 {
            return Option.None
        }

        let idx = existing_idx as usize
        let vlen = self.val_lens.ptr[idx]
        let offset = self.offsets.ptr[idx] as i64

        if vlen == 0usize {
            return Option.Some(String.new())
        }

        let v_buf = malloc(vlen + 1usize) as *raw var u8
        let n_read = pread(self.fd, v_buf, vlen, offset)
        if n_read != (vlen as i64) {
            free(v_buf)
            return Option.None
        }
        v_buf[vlen] = 0u8

        var res = String.new()
        var i = 0usize
        while i < vlen {
            res.push_byte(v_buf[i])
            i = i + 1usize
        }
        res.push_byte(0u8)
        free(v_buf)
        return Option.Some(res)
    }

    // Check if a key exists in the database
    pub fn has(self, key: str) -> bool {
        if !self.is_open { return false }
        return self.find_key(key) >= 0i64
    }

    // Delete a key by appending a tombstone record and updating the index
    pub fn delete(var self, key: str) -> bool {
        if !self.is_open { return false }
        let existing_idx = self.find_key(key)
        if existing_idx < 0i64 {
            return false
        }

        let klen = kv_str_len(key)
        let ts = time(0usize as *raw var u64)
        let chk = kv_calc_checksum(key as *raw u8, klen, 0usize as *raw u8, 0usize)

        let hdr_buf = malloc(25usize) as *raw var u8
        kv_write_u32(hdr_buf, 0usize, 1380009035u32) // "RADK"
        kv_write_u64(hdr_buf, 4usize, ts)
        kv_write_u32(hdr_buf, 12usize, klen as u32)
        kv_write_u32(hdr_buf, 16usize, 0u32) // vlen = 0
        hdr_buf[20usize] = 1u8 // tombstone = 1
        kv_write_u32(hdr_buf, 21usize, chk)

        let _w1 = write(self.fd, hdr_buf as *raw u8, 25usize)
        free(hdr_buf)
        let _w2 = write(self.fd, key as *raw u8, klen)

        // Remove from index
        let idx = existing_idx as usize
        let last_idx = self.keys.len - 1usize
        if idx != last_idx {
            self.keys.ptr[idx] = self.keys.ptr[last_idx]
            self.offsets.ptr[idx] = self.offsets.ptr[last_idx]
            self.val_lens.ptr[idx] = self.val_lens.ptr[last_idx]
            self.timestamps.ptr[idx] = self.timestamps.ptr[last_idx]
        }
        let _ = self.keys.pop()
        let _ = self.offsets.pop()
        let _ = self.val_lens.pop()
        let _ = self.timestamps.pop()

        return true
    }

    // Return the total count of active records
    pub fn count(self) -> usize {
        return self.keys.len
    }

    // Return all active keys as a vector of strings
    pub fn all_keys(self) -> Vec<String> {
        var res = Vec.new()
        var i = 0usize
        while i < self.keys.len {
            res.push(String.from_str(self.keys.ptr[i].as_ptr() as str))
            i = i + 1usize
        }
        return res
    }

    // Commit an atomic batch of operations
    pub fn commit(var self, batch: KvBatch) -> bool {
        if !self.is_open { return false }
        var i = 0usize
        while i < batch.ops.len {
            let op = batch.ops.ptr[i]
            let k = batch.keys.ptr[i].as_ptr() as str
            if op == 0i32 {
                let v = batch.values.ptr[i].as_ptr() as str
                let ok = self.put(k, v)
                if !ok { return false }
            } else if op == 1i32 {
                let _ = self.delete(k)
            }
            i = i + 1usize
        }
        return self.sync()
    }

    // Compact the database by copying only active records into a fresh compacted file
    pub fn compact(var self) -> bool {
        if !self.is_open { return false }

        var tmp_path = String.new()
        tmp_path.push_str(self.file_path.as_ptr() as str)
        tmp_path.push_str(".compact")
        tmp_path.push_byte(0u8)

        let _ = unlink(tmp_path.as_ptr() as str)
        let tmp_fd = open(tmp_path.as_ptr() as str, 66i32, 420u32)
        if tmp_fd < 0 { return false }

        var i = 0usize
        while i < self.keys.len {
            let k = self.keys.ptr[i].as_ptr() as str
            let klen = kv_str_len(k)
            let vlen = self.val_lens.ptr[i]
            let offset = self.offsets.ptr[i] as i64
            let ts = self.timestamps.ptr[i]

            var v_buf: *raw var u8 = 0usize as *raw var u8
            if vlen > 0usize {
                v_buf = malloc(vlen + 1usize) as *raw var u8
                let n_read = pread(self.fd, v_buf, vlen, offset)
                if n_read != (vlen as i64) {
                    free(v_buf)
                    let _ = close(tmp_fd)
                    return false
                }
            }

            let chk = kv_calc_checksum(k as *raw u8, klen, v_buf as *raw u8, vlen)
            let hdr_buf = malloc(25usize) as *raw var u8
            kv_write_u32(hdr_buf, 0usize, 1380009035u32)
            kv_write_u64(hdr_buf, 4usize, ts)
            kv_write_u32(hdr_buf, 12usize, klen as u32)
            kv_write_u32(hdr_buf, 16usize, vlen as u32)
            hdr_buf[20usize] = 0u8
            kv_write_u32(hdr_buf, 21usize, chk)

            let _w1 = write(tmp_fd, hdr_buf as *raw u8, 25usize)
            free(hdr_buf)
            let _w2 = write(tmp_fd, k as *raw u8, klen)
            if vlen > 0usize {
                let _w3 = write(tmp_fd, v_buf as *raw u8, vlen)
                free(v_buf)
            }

            i = i + 1usize
        }

        let _ = fsync(tmp_fd)
        let _ = close(tmp_fd)
        let _ = close(self.fd)

        // Atomically replace old database file with compacted file
        let ren_ok = rename(tmp_path.as_ptr() as str, self.file_path.as_ptr() as str)
        if ren_ok != 0 { return false }

        // Reopen new file and reload index
        let new_fd = open(self.file_path.as_ptr() as str, 66i32, 420u32)
        if new_fd < 0 {
            self.is_open = false
            return false
        }
        self.fd = new_fd
        self.keys.len = 0usize
        self.offsets.len = 0usize
        self.val_lens.len = 0usize
        self.timestamps.len = 0usize
        self.load_index()

        return true
    }

    // Flush in-flight data to persistent physical disk
    pub fn sync(self) -> bool {
        if !self.is_open { return false }
        return fsync(self.fd) == 0
    }

    // Close the database handle
    pub fn close(var self) {
        if self.is_open {
            let _ = fsync(self.fd)
            let _ = close(self.fd)
            self.is_open = false
        }
    }
}
