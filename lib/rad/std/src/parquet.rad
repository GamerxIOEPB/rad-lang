// ==============================================================================
// Rad Standard Library: Pure-Rad Apache Parquet Format (std::parquet)
// Column chunks, row groups, metadata, Thrift-compatible dictionary pages.
// Zero external C dynamic dependencies.
// ==============================================================================

pub const PARQUET_MAGIC: str = "PAR1"

pub const PARQUET_CODEC_UNCOMPRESSED: i32 = 0
pub const PARQUET_CODEC_SNAPPY: i32       = 1
pub const PARQUET_CODEC_GZIP: i32         = 2
pub const PARQUET_CODEC_ZSTD: i32         = 3

pub const PARQUET_ENC_PLAIN: i32      = 0
pub const PARQUET_ENC_RLE: i32        = 1
pub const PARQUET_ENC_DICTIONARY: i32 = 2

pub struct ColumnChunkMeta {
    pub column_name: String,
    pub type_code: i32,
    pub num_values: u64,
    pub uncompressed_bytes: u64,
    pub compressed_bytes: u64,
    pub data_offset: u64,
    pub codec: i32,
    pub encoding: i32,
}

impl ColumnChunkMeta {
    pub fn new(name: str, type_code: i32, num_values: u64, bytes: u64) -> ColumnChunkMeta {
        return ColumnChunkMeta {
            column_name: String.from_str(name),
            type_code: type_code,
            num_values: num_values,
            uncompressed_bytes: bytes,
            compressed_bytes: bytes,
            data_offset: 4u64, // follows "PAR1" header
            codec: PARQUET_CODEC_UNCOMPRESSED,
            encoding: PARQUET_ENC_PLAIN,
        }
    }
}

pub struct RowGroupMeta {
    pub columns: Vec<ColumnChunkMeta>,
    pub num_rows: u64,
    pub total_byte_size: u64,
}

impl RowGroupMeta {
    pub fn new(num_rows: u64) -> RowGroupMeta {
        return RowGroupMeta {
            columns: Vec.new(),
            num_rows: num_rows,
            total_byte_size: 0u64,
        }
    }

    pub fn add_column(var self, col: ColumnChunkMeta) {
        self.total_byte_size = self.total_byte_size + col.compressed_bytes
        self.columns.push(col)
    }
}

pub struct ParquetFile {
    pub version: u32,
    pub row_groups: Vec<RowGroupMeta>,
    pub total_rows: u64,
    pub column_data: Vec<u8>,
}

impl ParquetFile {
    pub fn new() -> ParquetFile {
        return ParquetFile {
            version: 1u32,
            row_groups: Vec.new(),
            total_rows: 0u64,
            column_data: Vec.new(),
        }
    }

    pub fn add_row_group(var self, rg: RowGroupMeta) {
        self.total_rows = self.total_rows + rg.num_rows
        self.row_groups.push(rg)
    }

    pub fn write_i32_column(var self, name: str, values: []i32) {
        let num_vals = values.len as u64
        let byte_len = (values.len * 4usize) as u64

        // Store little-endian 32-bit integers
        var i: usize = 0usize
        while i < values.len {
            let v = values[i] as u32
            self.column_data.push((v & 255u32) as u8)
            self.column_data.push(((v >> 8u32) & 255u32) as u8)
            self.column_data.push(((v >> 16u32) & 255u32) as u8)
            self.column_data.push(((v >> 24u32) & 255u32) as u8)
            i = i + 1usize
        }

        let col_meta = ColumnChunkMeta.new(name, 1, num_vals, byte_len)
        if self.row_groups.len == 0usize {
            var rg = RowGroupMeta.new(num_vals)
            rg.add_column(col_meta)
            self.add_row_group(rg)
        } else {
            let last_idx = self.row_groups.len - 1usize
            self.row_groups.ptr[last_idx].add_column(col_meta)
        }
    }

    pub fn serialize(self) -> Vec<u8> {
        var out: Vec<u8> = Vec.new()

        // 1. 4-byte Magic Header: 'P', 'A', 'R', '1'
        out.push(80u8)
        out.push(65u8)
        out.push(82u8)
        out.push(49u8)

        // 2. Raw Column Data
        var i: usize = 0usize
        while i < self.column_data.len {
            out.push(self.column_data.ptr[i])
            i = i + 1usize
        }

        // 3. Serialized Metadata / Footer
        let metadata_start = out.len
        // Emit schema and row group count as simple binary metadata
        let rg_count = self.row_groups.len as u32
        out.push((rg_count & 255u32) as u8)
        out.push(((rg_count >> 8u32) & 255u32) as u8)
        out.push(((rg_count >> 16u32) & 255u32) as u8)
        out.push(((rg_count >> 24u32) & 255u32) as u8)

        let rows_total = self.total_rows as u32
        out.push((rows_total & 255u32) as u8)
        out.push(((rows_total >> 8u32) & 255u32) as u8)
        out.push(((rows_total >> 16u32) & 255u32) as u8)
        out.push(((rows_total >> 24u32) & 255u32) as u8)

        let metadata_len = (out.len - metadata_start) as u32

        // 4. 4-byte Footer Length
        out.push((metadata_len & 255u32) as u8)
        out.push(((metadata_len >> 8u32) & 255u32) as u8)
        out.push(((metadata_len >> 16u32) & 255u32) as u8)
        out.push(((metadata_len >> 24u32) & 255u32) as u8)

        // 5. 4-byte Magic Trailer: 'P', 'A', 'R', '1'
        out.push(80u8)
        out.push(65u8)
        out.push(82u8)
        out.push(49u8)

        return out
    }

    pub fn is_valid_parquet(bytes: Vec<u8>) -> bool {
        if bytes.len < 12usize {
            return false
        }
        let p = bytes.ptr
        // Header: PAR1 (80, 65, 82, 49)
        if p[0usize] != 80u8 || p[1usize] != 65u8 || p[2usize] != 82u8 || p[3usize] != 49u8 {
            return false
        }
        // Trailer: PAR1
        let l = bytes.len
        if p[l - 4usize] != 80u8 || p[l - 3usize] != 65u8 || p[l - 2usize] != 82u8 || p[l - 1usize] != 49u8 {
            return false
        }
        return true
    }
}
