// Rad Standard Library: File System Operations

fn fs_str_len(s: str) -> usize {
    if (s as usize) == 0usize {
        return 0usize
    }
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    i
}

pub struct File {
    pub handle: *raw var u8,
    pub is_open: bool,
}

impl File {
    pub fn open(path: str, mode: str) -> Option<File> {
        let fp = fopen(path, mode)
        if (fp as usize) == 0usize {
            Option.None
        } else {
            Option.Some(File {
                handle: fp,
                is_open: true,
            })
        }
    }

    pub fn create(path: str) -> Option<File> {
        File.open(path, "w")
    }

    pub fn open_read(path: str) -> Option<File> {
        File.open(path, "r")
    }

    pub fn open_write(path: str) -> Option<File> {
        File.open(path, "w")
    }

    pub fn open_append(path: str) -> Option<File> {
        File.open(path, "a")
    }

    pub fn write_str(var self, s: str) -> bool {
        if !self.is_open {
            return false
        }
        let p = s as *raw u8
        var len = 0usize
        while p[len] != 0u8 {
            len = len + 1usize
        }
        let written = fwrite(p as *raw var u8, 1usize, len, self.handle) as usize
        fflush(self.handle)
        written == len
    }

    pub fn read_to_string(var self) -> String {
        var result = String.new()
        if !self.is_open {
            return result
        }
        fseek(self.handle, 0i64, 2)
        let file_size = ftell(self.handle) as usize
        fseek(self.handle, 0i64, 0)
        if file_size == 0usize {
            return result
        }

        let raw = malloc(file_size + 1usize)
        let n_read = fread(raw, 1usize, file_size, self.handle) as usize
        var p = raw as *raw var u8
        p[n_read] = 0u8
        var i = 0usize
        while i < n_read {
            result.push_byte(p[i])
            i = i + 1usize
        }
        free(raw)
        result
    }

    pub fn flush(var self) {
        if self.is_open {
            fflush(self.handle)
        }
    }

    pub fn close(var self) {
        if self.is_open {
            fclose(self.handle)
            self.is_open = false
        }
    }

    pub fn drop(var self) {
        self.close()
    }
}

pub fn read_file(path: str) -> Option<String> {
    let fp = fopen(path, "rb")
    if (fp as usize) == 0usize {
        return Option.None
    }
    fseek(fp, 0i64, 2)
    let file_size = ftell(fp) as usize
    fseek(fp, 0i64, 0)
    if file_size == 0usize {
        fclose(fp)
        return Option.Some(String.new())
    }
    let raw = malloc(file_size + 1usize)
    let n_read = fread(raw, 1usize, file_size, fp) as usize
    fclose(fp)
    var p = raw as *raw var u8
    p[n_read] = 0u8
    var s = String.new()
    var i = 0usize
    while i < n_read {
        s.push_byte(p[i])
        i = i + 1usize
    }
    free(raw)
    Option.Some(s)
}

pub fn write_file(path: str, contents: str) -> bool {
    let fp = fopen(path, "wb")
    if (fp as usize) == 0usize {
        return false
    }
    let p = contents as *raw u8
    var len = 0usize
    while p[len] != 0u8 {
        len = len + 1usize
    }
    let written = fwrite(p as *raw var u8, 1usize, len, fp) as usize
    fclose(fp)
    written == len
}

pub fn remove_file(path: str) -> bool {
    let res = remove(path)
    res == 0
}

extern "C" {
    fn access(path: str, mode: i32) -> i32;
    fn mkdir(path: str, mode: u32) -> i32;
    fn rmdir(path: str) -> i32;
    fn stat(path: str, buf: *raw var u8) -> i32;
    fn fflush(fp: *raw var u8) -> i32;
    fn opendir(name: str) -> *raw var u8;
    fn readdir(dirp: *raw var u8) -> *raw var u8;
    fn closedir(dirp: *raw var u8) -> i32;
}

pub struct FileMetadata {
    pub size: i64,
    pub modified_sec: i64,
    pub is_directory: bool,
    pub is_regular_file: bool,
    pub mode: u32,
}

pub struct DirEntry {
    pub name: String,
    pub path: String,
    pub is_directory: bool,
    pub is_file: bool,
}

pub struct Fs {}

impl Fs {
    pub fn exists(path: str) -> bool { exists(path) }
    pub fn is_dir(path: str) -> bool { is_dir(path) }
    pub fn is_file(path: str) -> bool { is_file(path) }
    pub fn make_dir(path: str) -> bool { make_dir(path) }
    pub fn make_dir_p(path: str) -> bool { make_dir_p(path) }
    pub fn remove_file(path: str) -> bool { remove_file(path) }
    pub fn remove_dir(path: str) -> bool { remove_dir(path) }
    pub fn copy_file(src: str, dst: str) -> bool { copy_file(src, dst) }
    pub fn read_file(path: str) -> Option<String> { read_file(path) }
    pub fn write_file(path: str, content: str) -> bool { write_file(path, content) }
    pub fn temp_dir() -> String { temp_dir() }
    pub fn metadata(path: str) -> Option<FileMetadata> { get_metadata(path) }
    pub fn file_size(path: str) -> i64 { get_file_size(path) }
    pub fn modified_time(path: str) -> i64 { get_modified_time(path) }
    pub fn read_dir(path: str) -> Vec<DirEntry> { read_dir(path) }
    pub fn walk_dir(path: str) -> Vec<String> { walk_dir(path) }
}

pub fn exists(path: str) -> bool {
    return access(path, 0) == 0
}

pub fn is_dir(path: str) -> bool {
    let statbuf = malloc(144usize) as *raw var u8
    let r = stat(path, statbuf)
    if r != 0 {
        free(statbuf)
        return false
    }
    // st_mode at offset 24 (u32)
    let b0 = statbuf[24usize] as u32
    let b1 = statbuf[25usize] as u32
    let mode = b0 + (b1 * 256u32)
    free(statbuf)
    // S_IFDIR is 0x4000 (16384)
    return (mode & 61440u32) == 16384u32
}

pub fn is_file(path: str) -> bool {
    let statbuf = malloc(144usize) as *raw var u8
    let r = stat(path, statbuf)
    if r != 0 {
        free(statbuf)
        return false
    }
    let b0 = statbuf[24usize] as u32
    let b1 = statbuf[25usize] as u32
    let mode = b0 + (b1 * 256u32)
    free(statbuf)
    // S_IFREG is 0x8000 (32768)
    return (mode & 61440u32) == 32768u32
}

pub fn make_dir(path: str) -> bool {
    return mkdir(path, 511u32) == 0 // 0777
}

pub fn remove_dir(path: str) -> bool {
    return rmdir(path) == 0
}

pub fn make_dir_p(path: str) -> bool {
    if exists(path) {
        return true
    }
    let ptr = path as *raw u8
    var len = 0usize
    while ptr[len] != 0u8 {
        len = len + 1usize
    }
    if len == 0usize {
        return false
    }

    var sub = String.new()
    var i = 0usize
    while i < len {
        let b = ptr[i]
        sub.push_byte(b)
        if b == 47u8 && sub.len() > 1usize { // '/'
            let s_str = sub.as_ptr() as str
            if !exists(s_str) {
                let _ = make_dir(s_str)
            }
        }
        i = i + 1usize
    }
    if !exists(path) {
        return make_dir(path)
    }
    return true
}

pub fn copy_file(src: str, dst: str) -> bool {
    let fp_in = fopen(src, "rb")
    if (fp_in as usize) == 0usize {
        return false
    }
    let fp_out = fopen(dst, "wb")
    if (fp_out as usize) == 0usize {
        fclose(fp_in)
        return false
    }
    let buf = malloc(4096usize) as *raw var u8
    var ok = true
    while true {
        let n = fread(buf, 1usize, 4096usize, fp_in) as usize
        if n == 0usize {
            break
        }
        let w = fwrite(buf, 1usize, n, fp_out) as usize
        if w != n {
            ok = false
            break
        }
    }
    free(buf)
    fclose(fp_in)
    fclose(fp_out)
    return ok
}

pub fn temp_dir() -> String {
    let env_tmp = getenv("TMPDIR")
    if (env_tmp as usize) != 0usize {
        return String.from_str(env_tmp as str)
    }
    return String.from_str("/tmp")
}

pub fn get_metadata(path: str) -> Option<FileMetadata> {
    let statbuf = malloc(144usize) as *raw var u8
    let r = stat(path, statbuf)
    if r != 0 {
        free(statbuf)
        return Option.None
    }
    let b0 = statbuf[24usize] as u32
    let b1 = statbuf[25usize] as u32
    let mode = b0 + (b1 * 256u32)
    let is_directory = (mode & 61440u32) == 16384u32
    let is_regular_file = (mode & 61440u32) == 32768u32

    // st_size at offset 48 (i64)
    let p_size = (statbuf as usize + 48usize) as *raw i64
    let size = p_size[0usize]

    // st_mtime at offset 88 (i64)
    let p_mtime = (statbuf as usize + 88usize) as *raw i64
    let mtime = p_mtime[0usize]

    free(statbuf)
    return Option.Some(FileMetadata {
        size: size,
        modified_sec: mtime,
        is_directory: is_directory,
        is_regular_file: is_regular_file,
        mode: mode,
    })
}

pub fn get_file_size(path: str) -> i64 {
    let statbuf = malloc(144usize) as *raw var u8
    let r = stat(path, statbuf)
    if r != 0 {
        free(statbuf)
        return -1i64
    }
    let p_size = (statbuf as usize + 48usize) as *raw i64
    let size = p_size[0usize]
    free(statbuf)
    return size
}

pub fn get_modified_time(path: str) -> i64 {
    let statbuf = malloc(144usize) as *raw var u8
    let r = stat(path, statbuf)
    if r != 0 {
        free(statbuf)
        return 0i64
    }
    let p_mtime = (statbuf as usize + 88usize) as *raw i64
    let mtime = p_mtime[0usize]
    free(statbuf)
    return mtime
}

pub fn read_dir(path: str) -> Vec<DirEntry> {
    var entries = Vec.new()
    let dirp = opendir(path)
    if (dirp as usize) == 0usize {
        return entries
    }
    let plen = fs_str_len(path)
    let has_trailing_slash = plen > 0usize && (path as *raw u8)[plen - 1usize] == 47u8

    while true {
        let ent = readdir(dirp)
        if (ent as usize) == 0usize {
            break
        }
        let d_type = ent[18usize]
        let name_ptr = (ent as usize + 19usize) as *raw u8

        // Skip "." and ".."
        if name_ptr[0usize] == 46u8 { // '.'
            if name_ptr[1usize] == 0u8 {
                continue
            }
            if name_ptr[1usize] == 46u8 && name_ptr[2usize] == 0u8 {
                continue
            }
        }

        var name_str = String.new()
        var ni = 0usize
        while name_ptr[ni] != 0u8 {
            name_str.push_byte(name_ptr[ni])
            ni = ni + 1usize
        }

        var full_path = String.new()
        full_path.push_str(path)
        if !has_trailing_slash {
            full_path.push_byte(47u8) // '/'
        }
        full_path.push_str(name_str.as_ptr() as str)

        entries.push(DirEntry {
            name: name_str,
            path: full_path,
            is_directory: (d_type == 4u8),
            is_file: (d_type == 8u8),
        })
    }
    closedir(dirp)
    return entries
}

pub fn walk_dir(path: str) -> Vec<String> {
    var all_files = Vec.new()
    var dirs_to_visit = Vec.new()
    dirs_to_visit.push(String.from_str(path))

    while dirs_to_visit.len > 0usize {
        let cur_dir = dirs_to_visit.pop()
        let entries = read_dir(cur_dir.as_ptr() as str)
        var ei = 0usize
        while ei < entries.len {
            let ent = entries.ptr[ei]
            all_files.push(ent.path)
            if ent.is_directory {
                dirs_to_visit.push(ent.path)
            }
            ei = ei + 1usize
        }
    }
    return all_files
}
