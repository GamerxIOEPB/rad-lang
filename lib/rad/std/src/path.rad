// ==============================================================================
// Rad Standard Library: Path Utilities
// Path joining, normalization, components, and extensions.
// ==============================================================================

fn path_len(s: str) -> usize {
    if (s as usize) == 0usize {
        return 0usize
    }
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    i
}

pub struct Path {}

impl Path {
    pub fn is_absolute(p: str) -> bool {
        if path_len(p) == 0usize {
            return false
        }
        let ptr = p as *raw u8
        ptr[0usize] == 47u8 // '/'
    }

    pub fn join(a: str, b: str) -> String {
        let la = path_len(a)
        let lb = path_len(b)
        if la == 0usize {
            return String.from_str(b)
        }
        if lb == 0usize {
            return String.from_str(a)
        }
        if Path.is_absolute(b) {
            return String.from_str(b)
        }

        var res = String.new()
        res.push_str(a)
        let pa = a as *raw u8
        if pa[la - 1usize] != 47u8 {
            res.push_byte(47u8) // '/'
        }
        res.push_str(b)
        res
    }

    pub fn basename(p: str) -> String {
        let len = path_len(p)
        if len == 0usize {
            return String.from_str("")
        }
        let ptr = p as *raw u8
        var last_slash = 0usize
        var has_slash = false
        var i = 0usize
        while i < len {
            if ptr[i] == 47u8 {
                last_slash = i + 1usize
                has_slash = true
            }
            i = i + 1usize
        }
        if !has_slash || last_slash >= len {
            return String.from_str(p)
        }
        var res = String.new()
        i = last_slash
        while i < len {
            res.push_byte(ptr[i])
            i = i + 1usize
        }
        res
    }

    pub fn dirname(p: str) -> String {
        let len = path_len(p)
        if len == 0usize {
            return String.from_str(".")
        }
        let ptr = p as *raw u8
        var last_slash = 0usize
        var has_slash = false
        var i = 0usize
        while i < len {
            if ptr[i] == 47u8 {
                last_slash = i
                has_slash = true
            }
            i = i + 1usize
        }
        if !has_slash {
            return String.from_str(".")
        }
        if last_slash == 0usize {
            return String.from_str("/")
        }
        var res = String.new()
        i = 0usize
        while i < last_slash {
            res.push_byte(ptr[i])
            i = i + 1usize
        }
        res
    }

    pub fn extension(p: str) -> String {
        let base = Path.basename(p)
        let blen = base.len()
        let bptr = base.as_ptr() as *raw u8
        var dot_idx = 0usize
        var has_dot = false
        var i = 0usize
        while i < blen {
            if bptr[i] == 46u8 { // '.'
                dot_idx = i + 1usize
                has_dot = true
            }
            i = i + 1usize
        }
        if !has_dot || dot_idx >= blen {
            return String.from_str("")
        }
        var res = String.new()
        i = dot_idx
        while i < blen {
            res.push_byte(bptr[i])
            i = i + 1usize
        }
        res
    }

    pub fn normalize(p: str) -> String {
        let len = path_len(p)
        if len == 0usize {
            return String.from_str(".")
        }
        let ptr = p as *raw u8
        let is_abs = ptr[0usize] == 47u8

        // Split by '/'
        var parts = Vec.new()
        var cur = String.new()
        var i = 0usize
        while i < len {
            let b = ptr[i]
            if b == 47u8 {
                if cur.len() > 0usize {
                    parts.push(cur)
                    cur = String.new()
                }
            } else {
                cur.push_byte(b)
            }
            i = i + 1usize
        }
        if cur.len() > 0usize {
            parts.push(cur)
        }

        // Process '.' and '..'
        var resolved = Vec.new()
        var pi = 0usize
        while pi < parts.len {
            let part_str = parts.ptr[pi].as_ptr() as str
            let p_len = path_len(part_str)
            let p_ptr = part_str as *raw u8
            if p_len == 1usize && p_ptr[0usize] == 46u8 { // "."
                // skip
            } else if p_len == 2usize && p_ptr[0usize] == 46u8 && p_ptr[1usize] == 46u8 { // ".."
                if resolved.len > 0usize {
                    let _ = resolved.pop()
                } else if !is_abs {
                    resolved.push(parts.ptr[pi])
                }
            } else {
                resolved.push(parts.ptr[pi])
            }
            pi = pi + 1usize
        }

        if resolved.len == 0usize {
            if is_abs {
                return String.from_str("/")
            } else {
                return String.from_str(".")
            }
        }

        var res = String.new()
        if is_abs {
            res.push_byte(47u8)
        }
        var ri = 0usize
        while ri < resolved.len {
            if ri > 0usize {
                res.push_byte(47u8)
            }
            res.push_str(resolved.ptr[ri].as_ptr() as str)
            ri = ri + 1usize
        }
        res
    }

    pub fn is_relative(p: str) -> bool {
        !Path.is_absolute(p)
    }

    pub fn file_name(p: str) -> String {
        Path.basename(p)
    }

    pub fn parent(p: str) -> String {
        Path.dirname(p)
    }

    pub fn has_extension(p: str, ext: str) -> bool {
        let cur_ext = Path.extension(p)
        let c_str = cur_ext.as_ptr() as str
        let len_c = path_len(c_str)
        let len_e = path_len(ext)
        if len_c == 0usize || len_e == 0usize {
            return false
        }
        var target_ext = ext
        if (ext as *raw u8)[0usize] == 46u8 { // skip leading '.'
            target_ext = (ext as usize + 1usize) as str
        }
        let pc = c_str as *raw u8
        let pe = target_ext as *raw u8
        var i = 0usize
        while pc[i] != 0u8 && pe[i] != 0u8 {
            if pc[i] != pe[i] {
                return false
            }
            i = i + 1usize
        }
        pc[i] == pe[i]
    }

    pub fn with_extension(p: str, new_ext: str) -> String {
        let len = path_len(p)
        if len == 0usize {
            var s = String.new()
            if path_len(new_ext) > 0usize {
                if (new_ext as *raw u8)[0usize] != 46u8 {
                    s.push_byte(46u8)
                }
                s.push_str(new_ext)
            }
            return s
        }
        let ptr = p as *raw u8
        var last_slash: i64 = -1i64
        var last_dot: i64 = -1i64
        var i = 0usize
        while i < len {
            if ptr[i] == 47u8 { // '/'
                last_slash = i as i64
                last_dot = -1i64
            } else if ptr[i] == 46u8 { // '.'
                last_dot = i as i64
            }
            i = i + 1usize
        }

        var stem_len = len
        if last_dot > last_slash && last_dot > 0i64 {
            stem_len = last_dot as usize
        }

        var res = String.new()
        i = 0usize
        while i < stem_len {
            res.push_byte(ptr[i])
            i = i + 1usize
        }

        if path_len(new_ext) > 0usize {
            if (new_ext as *raw u8)[0usize] != 46u8 {
                res.push_byte(46u8) // '.'
            }
            res.push_str(new_ext)
        }
        res
    }
}

// ------------------------------------------------------------------------------
// PathBuf: Ergonomic Owned Mutable Path Buffer
// ------------------------------------------------------------------------------

pub struct PathBuf {
    pub inner: String,
}

impl PathBuf {
    pub fn new() -> PathBuf {
        PathBuf { inner: String.new() }
    }

    pub fn from(p: str) -> PathBuf {
        PathBuf { inner: String.from_str(p) }
    }

    pub fn as_str(self) -> str {
        self.inner.as_ptr() as str
    }

    pub fn to_string(self) -> String {
        String.from_str(self.inner.as_ptr() as str)
    }

    pub fn join(var self, next: str) -> PathBuf {
        let joined = Path.join(self.inner.as_ptr() as str, next)
        self.inner.drop()
        self.inner = joined
        self
    }

    pub fn parent(self) -> PathBuf {
        PathBuf { inner: Path.dirname(self.inner.as_ptr() as str) }
    }

    pub fn file_name(self) -> String {
        Path.basename(self.inner.as_ptr() as str)
    }

    pub fn extension(self) -> String {
        Path.extension(self.inner.as_ptr() as str)
    }

    pub fn with_extension(var self, ext: str) -> PathBuf {
        let res = Path.with_extension(self.inner.as_ptr() as str, ext)
        self.inner.drop()
        self.inner = res
        self
    }
}
