// ==============================================================================
// Rad Standard Library: Environment Variables (std::env)
// Ergonomic, safe access to process environment variables.
// ==============================================================================

import process;

pub fn get(name: str) -> Option<String> {
    return process.env_get(name);
}

pub fn set(name: str, val: str) -> bool {
    return process.env_set(name, val);
}

pub fn vars() -> Vec<String> {
    return process.env_vars();
}
