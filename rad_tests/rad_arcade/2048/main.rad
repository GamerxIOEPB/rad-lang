// ==============================================================================
// Rad Arcade: 2048
// Classic 2048 sliding-tile puzzle game in pure native Rad.
// Zero external dependencies — pure syscalls, terminal, and double-buffered console.
// ==============================================================================

import terminal;
import keyboard;
import console;
import time;

const GRID_SIZE: usize = 4usize
const TILE_W: usize = 9usize
const TILE_H: usize = 3usize
const BOARD_X: usize = 6usize
const BOARD_Y: usize = 6usize

struct Game2048 {
    // 4x4 board stored in 16-element buffer
    grid: *raw var i64,
    score: i64,
    best_score: i64,
    won: bool,
    won_acknowledged: bool,
    game_over: bool,
    paused: bool,
    rng_state: u64,
    // Reusable scratch buffers — zero runtime heap allocation
    scratch_line: *raw var i64,
    scratch_comp: *raw var i64,
    scratch_merge: *raw var i64,
    scratch_indices: *raw var usize,
}

impl Game2048 {
    fn new() -> Game2048 {
        let buf = malloc(16usize * 8usize) as *raw var i64
        let s_line = malloc(4usize * 8usize) as *raw var i64
        let s_comp = malloc(4usize * 8usize) as *raw var i64
        let s_merge = malloc(4usize * 8usize) as *raw var i64
        let s_indices = malloc(16usize * 8usize) as *raw var usize
        var g = Game2048 {
            grid: buf,
            score: 0i64,
            best_score: 0i64,
            won: false,
            won_acknowledged: false,
            game_over: false,
            paused: false,
            rng_state: 88172645463325252u64,
            scratch_line: s_line,
            scratch_comp: s_comp,
            scratch_merge: s_merge,
            scratch_indices: s_indices,
        }
        g.reset()
        return g
    }

    fn rand_u32(var self) -> i64 {
        self.rng_state = (self.rng_state * 6364136223846793005u64) + 1442695040888963407u64
        return ((self.rng_state >> 33u64) & 2147483647u64) as i64
    }

    fn reset(var self) {
        var i = 0usize
        while i < 16usize {
            self.grid[i] = 0i64
            i = i + 1usize
        }
        self.score = 0i64
        self.won = false
        self.won_acknowledged = false
        self.game_over = false
        self.paused = false

        // Start with two tiles
        self.spawn_tile()
        self.spawn_tile()
    }

    fn spawn_tile(var self) {
        var count = 0usize
        var i = 0usize
        while i < 16usize {
            if self.grid[i] == 0i64 {
                self.scratch_indices[count] = i
                count = count + 1usize
            }
            i = i + 1usize
        }

        if count > 0usize {
            var raw_rnd = self.rand_u32()
            if raw_rnd < 0i64 { raw_rnd = -raw_rnd }
            let choice_idx = (raw_rnd as usize) % count
            if choice_idx < count {
                let pos = self.scratch_indices[choice_idx]
                if pos < 16usize {
                    var r_rnd = self.rand_u32()
                    if r_rnd < 0i64 { r_rnd = -r_rnd }
                    let r = (r_rnd as usize) % 10usize
                    if r == 0usize {
                        self.grid[pos] = 4i64
                    } else {
                        self.grid[pos] = 2i64
                    }
                }
            }
        }
    }

    fn can_move(self) -> bool {
        // Check for any empty cells
        var i = 0usize
        while i < 16usize {
            if self.grid[i] == 0i64 {
                return true
            }
            i = i + 1usize
        }

        // Check horizontal adjacent
        var r = 0usize
        while r < 4usize {
            var c = 0usize
            while c < 3usize {
                let v1 = self.grid[r * 4usize + c]
                let v2 = self.grid[r * 4usize + (c + 1usize)]
                if v1 == v2 {
                    return true
                }
                c = c + 1usize
            }
            r = r + 1usize
        }

        // Check vertical adjacent
        var col = 0usize
        while col < 4usize {
            var row = 0usize
            while row < 3usize {
                let v1 = self.grid[row * 4usize + col]
                let v2 = self.grid[(row + 1usize) * 4usize + col]
                if v1 == v2 {
                    return true
                }
                row = row + 1usize
            }
            col = col + 1usize
        }

        return false
    }

    // Slide and merge a single 4-element line to the left
    // Returns true if the line was changed
    fn slide_line_left(var self, line: *raw var i64) -> bool {
        var changed = false

        // 1. Zero out scratch buffers
        var i = 0usize
        while i < 4usize {
            self.scratch_comp[i] = 0i64
            self.scratch_merge[i] = 0i64
            i = i + 1usize
        }

        // 2. Compress non-zero elements
        var pos = 0usize
        i = 0usize
        while i < 4usize {
            if line[i] != 0i64 {
                self.scratch_comp[pos] = line[i]
                pos = pos + 1usize
            }
            i = i + 1usize
        }

        // 3. Merge adjacent identical elements
        var m_pos = 0usize
        i = 0usize
        while i < 4usize {
            if self.scratch_comp[i] != 0i64 {
                if i + 1usize < 4usize && self.scratch_comp[i] == self.scratch_comp[i + 1usize] {
                    let val = self.scratch_comp[i] * 2i64
                    self.scratch_merge[m_pos] = val
                    self.score = self.score + val
                    if self.score > self.best_score {
                        self.best_score = self.score
                    }
                    if val == 2048i64 && !self.won {
                        self.won = true
                    }
                    m_pos = m_pos + 1usize
                    i = i + 2usize
                } else {
                    self.scratch_merge[m_pos] = self.scratch_comp[i]
                    m_pos = m_pos + 1usize
                    i = i + 1usize
                }
            } else {
                i = i + 1usize
            }
        }

        // 4. Write back and detect changes
        i = 0usize
        while i < 4usize {
            if line[i] != self.scratch_merge[i] {
                changed = true
            }
            line[i] = self.scratch_merge[i]
            i = i + 1usize
        }

        return changed
    }

    fn move_left(var self) -> bool {
        var moved = false
        var r = 0usize
        while r < 4usize {
            var c = 0usize
            while c < 4usize {
                self.scratch_line[c] = self.grid[r * 4usize + c]
                c = c + 1usize
            }
            if self.slide_line_left(self.scratch_line) {
                moved = true
            }
            c = 0usize
            while c < 4usize {
                self.grid[r * 4usize + c] = self.scratch_line[c]
                c = c + 1usize
            }
            r = r + 1usize
        }
        return moved
    }

    fn move_right(var self) -> bool {
        var moved = false
        var r = 0usize
        while r < 4usize {
            var c = 0usize
            while c < 4usize {
                self.scratch_line[c] = self.grid[r * 4usize + (3usize - c)]
                c = c + 1usize
            }
            if self.slide_line_left(self.scratch_line) {
                moved = true
            }
            c = 0usize
            while c < 4usize {
                self.grid[r * 4usize + (3usize - c)] = self.scratch_line[c]
                c = c + 1usize
            }
            r = r + 1usize
        }
        return moved
    }

    fn move_up(var self) -> bool {
        var moved = false
        var col = 0usize
        while col < 4usize {
            var r = 0usize
            while r < 4usize {
                self.scratch_line[r] = self.grid[r * 4usize + col]
                r = r + 1usize
            }
            if self.slide_line_left(self.scratch_line) {
                moved = true
            }
            r = 0usize
            while r < 4usize {
                self.grid[r * 4usize + col] = self.scratch_line[r]
                r = r + 1usize
            }
            col = col + 1usize
        }
        return moved
    }

    fn move_down(var self) -> bool {
        var moved = false
        var col = 0usize
        while col < 4usize {
            var r = 0usize
            while r < 4usize {
                self.scratch_line[r] = self.grid[(3usize - r) * 4usize + col]
                r = r + 1usize
            }
            if self.slide_line_left(self.scratch_line) {
                moved = true
            }
            r = 0usize
            while r < 4usize {
                self.grid[(3usize - r) * 4usize + col] = self.scratch_line[r]
                r = r + 1usize
            }
            col = col + 1usize
        }
        return moved
    }

    fn handle_move(var self, dx: i32, dy: i32) {
        if self.game_over || self.paused {
            return
        }

        var moved = false
        if dx == -1 {
            moved = self.move_left()
        } else if dx == 1 {
            moved = self.move_right()
        } else if dy == -1 {
            moved = self.move_up()
        } else if dy == 1 {
            moved = self.move_down()
        }

        if moved {
            self.spawn_tile()
            if !self.can_move() {
                self.game_over = true
            }
        }
    }

    fn get_tile_colors(val: i64) -> Color {
        if val == 2i64 || val == 4i64 {
            return Color.indexed(236u8) // Dark charcoal text on light tile
        } else if val == 128i64 || val == 256i64 || val == 2048i64 {
            return Color.black() // Deep black on bright gold tiles
        }
        // High-contrast bright white for 8, 16, 32, 64, 512, 1024, >2048
        return Color.bright_white()
    }

    fn get_tile_bg(val: i64) -> Color {
        if val == 0i64 {
            return Color.indexed(237u8) // Light gray shade for empty blocks
        } else if val == 2i64 {
            return Color.indexed(253u8) // Light warm ivory
        } else if val == 4i64 {
            return Color.indexed(229u8) // Pale warm bisque
        } else if val == 8i64 {
            return Color.indexed(208u8) // Rich vibrant orange
        } else if val == 16i64 {
            return Color.indexed(202u8) // Deep warm coral orange
        } else if val == 32i64 {
            return Color.indexed(196u8) // Bright tomato red
        } else if val == 64i64 {
            return Color.indexed(160u8) // Deep rich crimson
        } else if val == 128i64 {
            return Color.indexed(220u8) // Glowing golden yellow
        } else if val == 256i64 {
            return Color.indexed(214u8) // Bright amber gold
        } else if val == 512i64 {
            return Color.indexed(40u8)  // Vibrant emerald green
        } else if val == 1024i64 {
            return Color.indexed(33u8)  // Electric azure blue
        } else if val == 2048i64 {
            return Color.indexed(226u8) // Radiant electric gold
        } else if val > 2048i64 {
            return Color.indexed(129u8) // Royal purple
        }
        return Color.indexed(237u8)
    }

    fn get_tile_label(val: i64) -> str {
        if val == 2i64 { return "2" }
        if val == 4i64 { return "4" }
        if val == 8i64 { return "8" }
        if val == 16i64 { return "16" }
        if val == 32i64 { return "32" }
        if val == 64i64 { return "64" }
        if val == 128i64 { return "128" }
        if val == 256i64 { return "256" }
        if val == 512i64 { return "512" }
        if val == 1024i64 { return "1024" }
        if val == 2048i64 { return "2048" }
        if val == 4096i64 { return "4096" }
        if val == 8192i64 { return "8192" }
        if val == 16384i64 { return "16384" }
        if val == 32768i64 { return "32768" }
        if val == 65536i64 { return "65536" }
        return ""
    }

    fn get_tile_label_len(val: i64) -> usize {
        if val < 10i64 { return 1usize }
        if val < 100i64 { return 2usize }
        if val < 1000i64 { return 3usize }
        if val < 10000i64 { return 4usize }
        return 5usize
    }

    fn render(self, var con: Console) {
        con.clear()

        // 1. Header & Title Banner
        con.print_str(BOARD_X, 1usize, "2 0 4 8", Color.bright_yellow(), Color.default())
        con.print_str(BOARD_X + 9usize, 1usize, "Join the numbers to get to the 2048 tile!", Color.white(), Color.default())

        // 2. Score Boxes
        // SCORE BOX
        con.draw_box(BOARD_X + 16usize, 2usize, 11usize, 3usize, Color.bright_black(), Color.default())
        con.print_str(BOARD_X + 18usize, 2usize, "SCORE", Color.bright_yellow(), Color.default())
        let s_str = int_to_str(self.score)
        let s_pad = (9usize - s_str.len()) / 2usize
        con.print_str(BOARD_X + 17usize + s_pad, 3usize, s_str.as_ptr() as str, Color.bright_white(), Color.default())

        // BEST SCORE BOX
        con.draw_box(BOARD_X + 28usize, 2usize, 11usize, 3usize, Color.bright_black(), Color.default())
        con.print_str(BOARD_X + 31usize, 2usize, "BEST", Color.bright_cyan(), Color.default())
        let b_str = int_to_str(self.best_score)
        let b_pad = (9usize - b_str.len()) / 2usize
        con.print_str(BOARD_X + 29usize + b_pad, 3usize, b_str.as_ptr() as str, Color.bright_white(), Color.default())

        // 3. Draw 4x4 Grid Board Outline
        let grid_total_w = 4usize * (TILE_W + 1usize) + 1usize
        let grid_total_h = 4usize * (TILE_H + 1usize) + 1usize
        con.draw_box(BOARD_X - 1usize, BOARD_Y - 1usize, grid_total_w, grid_total_h, Color.bright_black(), Color.default())

        // 4. Draw Individual Tiles
        var r = 0usize
        while r < 4usize {
            var c = 0usize
            while c < 4usize {
                let val = self.grid[r * 4usize + c]
                let tx = BOARD_X + c * (TILE_W + 1usize)
                let ty = BOARD_Y + r * (TILE_H + 1usize)

                let fg = Game2048.get_tile_colors(val)
                let bg = Game2048.get_tile_bg(val)

                if val == 0i64 {
                    // Empty cell: visible light gray shade block with subtle ASCII dot marker
                    con.draw_rect(tx, ty, TILE_W, TILE_H, 32u8, Color.indexed(243u8), bg)
                    con.set_cell(tx + 4usize, ty + 1usize, 46u8, Color.indexed(243u8), bg)
                } else {
                    // Solid tile
                    con.draw_rect(tx, ty, TILE_W, TILE_H, 32u8, fg, bg)
                    let num_str = Game2048.get_tile_label(val)
                    let n_len = Game2048.get_tile_label_len(val)
                    let pad_x = (TILE_W - n_len) / 2usize
                    con.print_str(tx + pad_x, ty + 1usize, num_str, fg, bg)
                }

                c = c + 1usize
            }
            r = r + 1usize
        }

        // 5. Status Messages & Controls Footer
        let footer_y = BOARD_Y + grid_total_h
        con.print_str(BOARD_X, footer_y, "Controls: Arrows / WASD to Slide   R: Restart   P: Pause   Q: Quit", Color.bright_black(), Color.default())

        if self.game_over {
            con.draw_box(BOARD_X + 3usize, BOARD_Y + 5usize, 34usize, 5usize, Color.bright_red(), Color.black())
            con.print_str(BOARD_X + 11usize, BOARD_Y + 6usize, "G A M E   O V E R !", Color.bright_red(), Color.black())
            con.print_str(BOARD_X + 8usize, BOARD_Y + 8usize, "Press 'R' to Play Again", Color.bright_white(), Color.black())
        } else if self.won && !self.won_acknowledged {
            con.draw_box(BOARD_X + 3usize, BOARD_Y + 5usize, 34usize, 5usize, Color.bright_yellow(), Color.black())
            con.print_str(BOARD_X + 8usize, BOARD_Y + 6usize, "Y O U   R E A C H E D   2 0 4 8 !", Color.bright_yellow(), Color.black())
            con.print_str(BOARD_X + 6usize, BOARD_Y + 8usize, "Press Enter or Arrow to Keep Going", Color.bright_white(), Color.black())
        } else if self.paused {
            con.draw_box(BOARD_X + 8usize, BOARD_Y + 6usize, 24usize, 3usize, Color.bright_yellow(), Color.black())
            con.print_str(BOARD_X + 14usize, BOARD_Y + 7usize, "P A U S E D", Color.bright_yellow(), Color.black())
        }

        con.present()
    }

    fn destroy(var self) {
        if (self.grid as usize) != 0usize {
            free(self.grid as *raw u8)
            self.grid = 0usize as *raw var i64
        }
        if (self.scratch_line as usize) != 0usize {
            free(self.scratch_line as *raw u8)
            self.scratch_line = 0usize as *raw var i64
        }
        if (self.scratch_comp as usize) != 0usize {
            free(self.scratch_comp as *raw u8)
            self.scratch_comp = 0usize as *raw var i64
        }
        if (self.scratch_merge as usize) != 0usize {
            free(self.scratch_merge as *raw u8)
            self.scratch_merge = 0usize as *raw var i64
        }
        if (self.scratch_indices as usize) != 0usize {
            free(self.scratch_indices as *raw u8)
            self.scratch_indices = 0usize as *raw var usize
        }
    }
}

fn main() -> i32 {
    var term = TerminalSession.new()
    term.enable_raw_mode()
    term.enter_alternate_screen()
    term.hide_cursor()

    var kbd = KeyboardReader.new()
    var con = Console.new(54usize, 26usize)
    var timer = FrameTimer.new(60u32)
    var game: Game2048 = Game2048.new()

    var running = true
    while running {
        let _dt = timer.tick()

        while true {
            let evt = kbd.read_key(0)
            if evt.code == KEY_NONE {
                break
            }

            if (evt.code == KEY_ESC || evt.is_char(113u8) || evt.is_ctrl(99u8) || evt.is_eof()) && !evt.is_release {
                running = false
            } else if evt.is_char(112u8) && !evt.is_release { // 'p'
                game.paused = !game.paused
            } else if evt.is_char(114u8) && !evt.is_release { // 'r'
                game.reset()
            } else if game.won && !game.won_acknowledged && !evt.is_release {
                if evt.code == KEY_ENTER || evt.is_char(32u8) || evt.code == KEY_UP || evt.code == KEY_DOWN || evt.code == KEY_LEFT || evt.code == KEY_RIGHT {
                    game.won_acknowledged = true
                }
            } else if !game.paused && !game.game_over && !evt.is_release {
                if evt.code == KEY_LEFT || evt.is_char(97u8) || evt.is_char(65u8) { // Left / 'a'
                    game.handle_move(-1, 0)
                } else if evt.code == KEY_RIGHT || evt.is_char(100u8) || evt.is_char(68u8) { // Right / 'd'
                    game.handle_move(1, 0)
                } else if evt.code == KEY_UP || evt.is_char(119u8) || evt.is_char(87u8) { // Up / 'w'
                    game.handle_move(0, -1)
                } else if evt.code == KEY_DOWN || evt.is_char(115u8) || evt.is_char(83u8) { // Down / 's'
                    game.handle_move(0, 1)
                }
            }
        }

        game.render(con)
        timer.pace()
    }

    game.destroy()
    con.close_console()
    kbd.close_reader()
    term.close()
    0
}
