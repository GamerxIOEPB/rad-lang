// ==============================================================================
// RadChess: Authoritative LAN Multiplayer Session Manager
// Handles Host / Client roles, non-blocking TCP state machine, move sync, clocks.
// ==============================================================================

import "./constants";
import "./transport";
import "./protocol";
import "../chess/constants";

pub struct NetworkSession {
    pub net_role: i32,
    pub net_state: i32,
    pub listen_fd: i32,
    pub peer_fd: i32,
    pub local_player_name: String,
    pub remote_player_name: String,
    pub local_color: i32,
    pub remote_color: i32,
    pub time_control_idx: i32,
    pub white_time_ms: i32,
    pub black_time_ms: i32,
    pub last_tick_ms: i64,
    pub has_pending_remote_move: bool,
    pub pending_remote_move_uci: String,
    pub remote_offered_draw: bool,
    pub remote_resigned: bool,
    pub remote_wants_rematch: bool,
    pub status_banner: String,
    pub in_buf: *raw var u8,
}

impl NetworkSession {
    pub fn new(local_name: str) -> NetworkSession {
        let buf = malloc(2048usize) as *raw var u8;
        NetworkSession {
            net_role: NET_ROLE_NONE,
            net_state: NET_STATE_IDLE,
            listen_fd: -1,
            peer_fd: -1,
            local_player_name: String.from_str(local_name),
            remote_player_name: String.from_str("Waiting..."),
            local_color: COLOR_WHITE,
            remote_color: COLOR_BLACK,
            time_control_idx: 0,
            white_time_ms: 300000, // 5 min default
            black_time_ms: 300000,
            last_tick_ms: 0i64,
            has_pending_remote_move: false,
            pending_remote_move_uci: String.new(),
            remote_offered_draw: false,
            remote_resigned: false,
            remote_wants_rematch: false,
            status_banner: String.from_str("Not connected"),
            in_buf: buf,
        }
    }

    // Host LAN game on specified TCP port (default 45870)
    pub fn start_hosting(var self, port: i32, host_color: i32, tc_idx: i32) -> bool {
        self.close_session();
        let fd = create_tcp_socket();
        if fd < 0 {
            self.status_banner = String.from_str("Failed to create host socket");
            return false;
        }

        set_reuseaddr(fd);
        set_nonblocking(fd);

        if !bind_socket(fd, port, 0u32) {
            close_socket(fd);
            self.status_banner = String.from_str("Failed to bind host port");
            return false;
        }

        if !listen_socket(fd, 4) {
            close_socket(fd);
            self.status_banner = String.from_str("Failed to listen on host socket");
            return false;
        }

        self.listen_fd = fd;
        self.net_role = NET_ROLE_HOST;
        self.net_state = NET_STATE_LISTENING;
        self.local_color = host_color;
        if host_color == COLOR_WHITE {
            self.remote_color = COLOR_BLACK;
        } else {
            self.remote_color = COLOR_WHITE;
        }
        self.time_control_idx = tc_idx;
        self.init_clock_times(tc_idx);
        self.status_banner = String.from_str("Hosting game... waiting for opponent");
        true
    }

    // Connect to host as client
    pub fn connect_to_host(var self, host_ip: str, port: i32) -> bool {
        self.close_session();
        let fd = create_tcp_socket();
        if fd < 0 {
            self.status_banner = String.from_str("Failed to create client socket");
            return false;
        }

        set_reuseaddr(fd);
        let r = connect_socket(fd, host_ip, port);
        if r != 0 {
            close_socket(fd);
            self.status_banner = String.from_str("Connection failed to host");
            return false;
        }

        set_nonblocking(fd);
        self.peer_fd = fd;
        self.net_role = NET_ROLE_CLIENT;
        self.net_state = NET_STATE_CONNECTING;

        // Send HELLO handshake
        let hello = build_msg_hello(self.local_player_name.as_ptr() as str, COLOR_BLACK, 0);
        let _ = send_tcp(fd, hello.as_ptr() as *raw u8, hello.len());
        self.status_banner = String.from_str("Connected! Synchronizing game...");
        true
    }

    fn init_clock_times(var self, tc: i32) {
        if tc == 1 { // 3+2
            self.white_time_ms = 180000;
            self.black_time_ms = 180000;
        } else if tc == 2 { // 5+3
            self.white_time_ms = 300000;
            self.black_time_ms = 300000;
        } else if tc == 3 { // 10+0
            self.white_time_ms = 600000;
            self.black_time_ms = 600000;
        } else { // No clock
            self.white_time_ms = 0;
            self.black_time_ms = 0;
        }
    }

    // Poll network events (non-blocking)
    pub fn poll_events(var self, now_ms: i64) {
        // If hosting, check for incoming connection
        if self.net_role == NET_ROLE_HOST && self.net_state == NET_STATE_LISTENING {
            let client_fd = accept_socket(self.listen_fd);
            if client_fd >= 0 {
                set_nonblocking(client_fd);
                self.peer_fd = client_fd;
                self.net_state = NET_STATE_CONNECTED;
                // Send WELCOME
                let wel = build_msg_welcome(
                    self.local_player_name.as_ptr() as str,
                    self.remote_color,
                    self.time_control_idx
                );
                let _ = send_tcp(client_fd, wel.as_ptr() as *raw u8, wel.len());
                self.status_banner = String.from_str("Opponent connected! Starting match...");
            }
        }

        // If peer socket active, poll for incoming messages
        if self.peer_fd >= 0 {
            while true {
                let n = recv_tcp(self.peer_fd, self.in_buf, 2047usize);
                if n <= 0i64 {
                    break;
                }
                self.in_buf[n as usize] = 0u8;
                let raw_str = self.in_buf as *raw u8 as str;
                self.handle_incoming_line(raw_str);
            }
        }

        // Clocks update (if match active and time control enabled)
        if self.net_state == NET_STATE_PLAYING && self.white_time_ms > 0 {
            self.last_tick_ms = now_ms;
        }
    }

    pub fn handle_incoming_line(var self, raw_msg: str) {
        let opcode = parse_protocol_opcode(raw_msg);

        if opcode == MSG_HELLO {
            let opp_name = parse_protocol_field(raw_msg, 1usize);
            self.remote_player_name = opp_name;
            let wel = build_msg_welcome(
                self.local_player_name.as_ptr() as str,
                self.remote_color,
                self.time_control_idx
            );
            let _ = send_tcp(self.peer_fd, wel.as_ptr() as *raw u8, wel.len());
            let st = build_msg_start(
                self.local_player_name.as_ptr() as str,
                self.remote_player_name.as_ptr() as str
            );
            let _ = send_tcp(self.peer_fd, st.as_ptr() as *raw u8, st.len());
            self.net_state = NET_STATE_PLAYING;
            self.status_banner = String.from_str("Match started!");
        } else if opcode == MSG_WELCOME {
            let host_name = parse_protocol_field(raw_msg, 1usize);
            let color_str = parse_protocol_field(raw_msg, 2usize);
            let tc_str = parse_protocol_field(raw_msg, 3usize);

            self.remote_player_name = host_name;
            let c_val = chess_parse_int(color_str.as_ptr() as str);
            let tc_val = chess_parse_int(tc_str.as_ptr() as str);

            self.local_color = c_val;
            if c_val == COLOR_WHITE {
                self.remote_color = COLOR_BLACK;
            } else {
                self.remote_color = COLOR_WHITE;
            }
            self.time_control_idx = tc_val;
            self.init_clock_times(tc_val);
            self.net_state = NET_STATE_PLAYING;
            self.status_banner = String.from_str("Match started!");
        } else if opcode == MSG_START {
            self.net_state = NET_STATE_PLAYING;
            self.status_banner = String.from_str("Game on!");
        } else if opcode == MSG_MOVE {
            let uci = parse_protocol_field(raw_msg, 1usize);
            let w_time = parse_protocol_field(raw_msg, 2usize);
            let b_time = parse_protocol_field(raw_msg, 3usize);

            self.pending_remote_move_uci = uci;
            self.has_pending_remote_move = true;

            let wt = chess_parse_int(w_time.as_ptr() as str);
            let bt = chess_parse_int(b_time.as_ptr() as str);
            if wt > 0 { self.white_time_ms = wt; }
            if bt > 0 { self.black_time_ms = bt; }
        } else if opcode == MSG_DRAW_OFFER {
            self.remote_offered_draw = true;
            self.status_banner = String.from_str("Opponent offered a draw (Press Y/N)");
        } else if opcode == MSG_DRAW_ACCEPT {
            self.net_state = NET_STATE_GAME_OVER;
            self.status_banner = String.from_str("Draw agreed by mutual consent!");
        } else if opcode == MSG_DRAW_DECLINE {
            self.status_banner = String.from_str("Opponent declined draw offer");
        } else if opcode == MSG_RESIGN {
            self.remote_resigned = true;
            self.net_state = NET_STATE_GAME_OVER;
            self.status_banner = String.from_str("Opponent resigned. You win!");
        } else if opcode == MSG_REMATCH_REQ {
            self.remote_wants_rematch = true;
            self.status_banner = String.from_str("Opponent requests rematch! (Press Y/N)");
        } else if opcode == MSG_REMATCH_ACCEPT {
            // Swap colors
            let tmp = self.local_color;
            self.local_color = self.remote_color;
            self.remote_color = tmp;
            self.init_clock_times(self.time_control_idx);
            self.net_state = NET_STATE_PLAYING;
            self.status_banner = String.from_str("Rematch started!");
        }
    }

    // Send a move across the network
    pub fn send_move(var self, uci: str, w_ms: i32, b_ms: i32) {
        if self.peer_fd >= 0 {
            let msg = build_msg_move(uci, w_ms, b_ms);
            let _ = send_tcp(self.peer_fd, msg.as_ptr() as *raw u8, msg.len());
        }
    }

    pub fn send_draw_offer(var self) {
        if self.peer_fd >= 0 {
            let msg = build_simple_msg("DRAW_OFFER");
            let _ = send_tcp(self.peer_fd, msg.as_ptr() as *raw u8, msg.len());
            self.status_banner = String.from_str("Draw offer sent");
        }
    }

    pub fn send_draw_accept(var self) {
        if self.peer_fd >= 0 {
            let msg = build_simple_msg("DRAW_ACCEPT");
            let _ = send_tcp(self.peer_fd, msg.as_ptr() as *raw u8, msg.len());
            self.net_state = NET_STATE_GAME_OVER;
            self.status_banner = String.from_str("Draw agreed!");
        }
    }

    pub fn send_draw_decline(var self) {
        if self.peer_fd >= 0 {
            let msg = build_simple_msg("DRAW_DECLINE");
            let _ = send_tcp(self.peer_fd, msg.as_ptr() as *raw u8, msg.len());
            self.remote_offered_draw = false;
        }
    }

    pub fn send_resign(var self) {
        if self.peer_fd >= 0 {
            let msg = build_simple_msg("RESIGN");
            let _ = send_tcp(self.peer_fd, msg.as_ptr() as *raw u8, msg.len());
            self.net_state = NET_STATE_GAME_OVER;
            self.status_banner = String.from_str("You resigned. Opponent wins!");
        }
    }

    pub fn send_rematch_request(var self) {
        if self.peer_fd >= 0 {
            let msg = build_simple_msg("REMATCH_REQ");
            let _ = send_tcp(self.peer_fd, msg.as_ptr() as *raw u8, msg.len());
            self.status_banner = String.from_str("Rematch request sent");
        }
    }

    pub fn send_rematch_accept(var self) {
        if self.peer_fd >= 0 {
            let msg = build_simple_msg("REMATCH_ACCEPT");
            let _ = send_tcp(self.peer_fd, msg.as_ptr() as *raw u8, msg.len());
            let tmp = self.local_color;
            self.local_color = self.remote_color;
            self.remote_color = tmp;
            self.init_clock_times(self.time_control_idx);
            self.net_state = NET_STATE_PLAYING;
            self.status_banner = String.from_str("Rematch started!");
        }
    }

    pub fn close_session(var self) {
        if self.peer_fd >= 0 {
            close_socket(self.peer_fd);
            self.peer_fd = -1;
        }
        if self.listen_fd >= 0 {
            close_socket(self.listen_fd);
            self.listen_fd = -1;
        }
        self.net_role = NET_ROLE_NONE;
        self.net_state = NET_STATE_CLOSED;
    }
}
