// ==============================================================================
// RadChess: Negamax Search, Alpha-Beta, Move Ordering & Quiescence
// ==============================================================================

import "../chess/constants";
import "../chess/moves";
import "../chess/board";
import "../chess/rules";
import "./evaluate";
import "./transposition";

pub const CHECKMATE_SCORE: i32 = 30000
pub const INFINITY_SCORE: i32  = 100000

pub struct SearchResult {
    pub s_score: i32,
    pub s_best_move: Move,
}

// MVV-LVA score for move ordering
fn get_move_sort_score(b: Board, m: Move, hash_move: Move) -> i32 {
    // 1. Hash move gets highest priority
    if !hash_move.is_none() && m.eq(hash_move) {
        return 100000
    }

    // 2. Promotions
    if m.is_promo() {
        if m.promo_type == PIECE_QUEEN { return 90000 }
        if m.promo_type == PIECE_KNIGHT { return 85000 }
        return 80000
    }

    // 3. Captures (MVV-LVA)
    if m.is_capture() {
        let victim_piece = b.squares[m.to_sq as usize]
        let attacker_piece = b.squares[m.from_sq as usize]
        var victim_val = 0
        var attacker_val = 0

        let vt = get_piece_type(victim_piece)
        if vt == PIECE_PAWN { victim_val = 100 }
        else if vt == PIECE_KNIGHT { victim_val = 320 }
        else if vt == PIECE_BISHOP { victim_val = 330 }
        else if vt == PIECE_ROOK { victim_val = 500 }
        else if vt == PIECE_QUEEN { victim_val = 900 }

        let at = get_piece_type(attacker_piece)
        if at == PIECE_PAWN { attacker_val = 100 }
        else if at == PIECE_KNIGHT { attacker_val = 320 }
        else if at == PIECE_BISHOP { attacker_val = 330 }
        else if at == PIECE_ROOK { attacker_val = 500 }
        else if at == PIECE_QUEEN { attacker_val = 900 }

        return 50000 + (victim_val * 10) - attacker_val
    }

    return 0
}

// Order moves in-place by sort score descending
fn sort_moves(b: Board, var moves: Vec<Move>, hash_move: Move) {
    if moves.len <= 1usize { return }

    var i = 0usize
    while i < moves.len - 1usize {
        var best_idx = i
        var best_score = get_move_sort_score(b, moves.ptr[i], hash_move)

        var j = i + 1usize
        while j < moves.len {
            let sc = get_move_sort_score(b, moves.ptr[j], hash_move)
            if sc > best_score {
                best_score = sc
                best_idx = j
            }
            j = j + 1usize
        }

        if best_idx != i {
            let tmp = moves.ptr[i]
            moves.ptr[i] = moves.ptr[best_idx]
            moves.ptr[best_idx] = tmp
        }
        i = i + 1usize
    }
}

// Quiescence search to avoid horizon effect on tactical captures
pub fn quiesce(var b: Board, var alpha: i32, beta: i32, qdepth: i32) -> i32 {
    let stand_pat = evaluate_board(b)
    if qdepth <= 0 {
        return stand_pat
    }
    if stand_pat >= beta {
        return beta
    }
    if stand_pat > alpha {
        alpha = stand_pat
    }

    let captures = generate_legal_captures(b)
    sort_moves(b, captures, Move.none())

    var i = 0usize
    while i < captures.len {
        let m = captures.ptr[i]
        b.make_move(m)
        let score = -quiesce(b, -beta, -alpha, qdepth - 1)
        b.unmake_move()

        if score >= beta {
            return beta
        }
        if score > alpha {
            alpha = score
        }
        i = i + 1usize
    }

    return alpha
}

// Negamax search with Alpha-Beta pruning & Transposition Table
pub fn negamax(
    var b: Board,
    var tt: TranspositionTable,
    depth: i32,
    ply: i32,
    var alpha: i32,
    beta: i32
) -> SearchResult {
    // 3-fold repetition or 50-move rule check (draw)
    if b.repetition_count() >= 3 || b.halfmove_clock >= 100 {
        return SearchResult { s_score: 0, s_best_move: Move.none() }
    }

    // Transposition Table lookup
    let orig_alpha = alpha
    let lookup = tt.lookup(b.zobrist_hash, depth, alpha, beta)
    if lookup.hit == 1 && ply > 0 {
        return SearchResult { s_score: lookup.tt_res_score, s_best_move: lookup.tt_res_move }
    }
    var hash_move = Move.none()
    if lookup.hit != 0 {
        hash_move = lookup.tt_res_move
    }

    // Leaf node: run quiescence search
    if depth <= 0 {
        let q_score = quiesce(b, alpha, beta, 4)
        return SearchResult { s_score: q_score, s_best_move: Move.none() }
    }

    let moves = generate_legal_moves(b)
    if moves.len == 0usize {
        if in_check(b, b.side_to_move) {
            // Checkmate: favor shorter mates (-CHECKMATE_SCORE + ply)
            return SearchResult { s_score: -CHECKMATE_SCORE + ply, s_best_move: Move.none() }
        }
        // Stalemate
        return SearchResult { s_score: 0, s_best_move: Move.none() }
    }

    sort_moves(b, moves, hash_move)

    var best_score = -INFINITY_SCORE
    var best_move = moves.ptr[0]

    var i = 0usize
    while i < moves.len {
        let m = moves.ptr[i]
        b.make_move(m)
        let child = negamax(b, tt, depth - 1, ply + 1, -beta, -alpha)
        let score = -child.s_score
        b.unmake_move()

        if score > best_score {
            best_score = score
            best_move = m
        }
        if score > alpha {
            alpha = score
        }
        if alpha >= beta {
            break // Beta cutoff
        }
        i = i + 1usize
    }

    // Store in Transposition Table
    var flag = TT_EXACT
    if best_score <= orig_alpha {
        flag = TT_ALPHA
    } else if best_score >= beta {
        flag = TT_BETA
    }
    tt.store(b.zobrist_hash, depth, best_score, flag, best_move)

    return SearchResult { s_score: best_score, s_best_move: best_move }
}

// Search AI best move according to difficulty level
pub fn search_best_move(var b: Board, var tt: TranspositionTable, level: i32) -> Move {
    let legal = generate_legal_moves(b)
    if legal.len == 0usize {
        return Move.none()
    }
    if legal.len == 1usize {
        return legal.ptr[0]
    }

    // Level 1: Beginner (Depth 1)
    if level <= 1 {
        let res = negamax(b, tt, 1, 0, -INFINITY_SCORE, INFINITY_SCORE)
        return res.s_best_move
    }

    // Level 2: Easy (Depth 2)
    if level == 2 {
        let res = negamax(b, tt, 2, 0, -INFINITY_SCORE, INFINITY_SCORE)
        return res.s_best_move
    }

    // Level 3: Medium (Depth 4 with Quiescence)
    if level == 3 {
        var bm = legal.ptr[0]
        var d = 1
        while d <= 4 {
            let res = negamax(b, tt, d, 0, -INFINITY_SCORE, INFINITY_SCORE)
            if !res.s_best_move.is_none() {
                bm = res.s_best_move
            }
            d = d + 1
        }
        return bm
    }

    // Level 4: Hard (Iterative deepening to Depth 5)
    var best_m = legal.ptr[0]
    var depth = 1
    let max_depth = 5
    while depth <= max_depth {
        let res = negamax(b, tt, depth, 0, -INFINITY_SCORE, INFINITY_SCORE)
        if !res.s_best_move.is_none() {
            best_m = res.s_best_move
        }
        depth = depth + 1
    }
    return best_m
}
