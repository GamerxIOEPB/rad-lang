import "./colors";
import "../chess/constants";
import "../multiplayer/discovery";

pub fn draw_header() {
    print(FG_BRIGHT_CYAN());
    put_line("        ♜ RAD CHESS — Native Linux Chess ♜");
    print(RESET());
}

// Render Main Menu
pub fn render_main_menu(selected_idx: i32) {
    print("\r\n");
    print(FG_BRIGHT_CYAN());
    put_line("╔══════════════════════════════════════════╗");
    put_line("║                                          ║");
    print("║              ");
    print(BOLD());
    print(FG_BRIGHT_YELLOW());
    print("♜ RAD CHESS ♜");
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line("               ║");
    put_line("║                                          ║");
    print("║          ");
    print(FG_WHITE());
    print("Native Linux Chess");
    print(FG_BRIGHT_CYAN());
    put_line("              ║");
    put_line("║                                          ║");
    put_line("╠══════════════════════════════════════════╣");
    put_line("║                                          ║");

    // Option 1
    print("║       ");
    if selected_idx == 0 {
        print(BG_SELECTED());
        print(FG_BLACK());
        print(BOLD());
        print(" > 1. Play with Computer < ");
    } else {
        print(FG_WHITE());
        print("   1. Play with Computer   ");
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line("        ║");

    // Option 2
    print("║       ");
    if selected_idx == 1 {
        print(BG_SELECTED());
        print(FG_BLACK());
        print(BOLD());
        print(" > 2. Play Online        < ");
    } else {
        print(FG_WHITE());
        print("   2. Play Online          ");
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line("        ║");

    // Option 3
    print("║       ");
    if selected_idx == 2 {
        print(BG_SELECTED());
        print(FG_BLACK());
        print(BOLD());
        print(" > 3. Settings           < ");
    } else {
        print(FG_WHITE());
        print("   3. Settings             ");
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line("        ║");

    // Option 4
    print("║       ");
    if selected_idx == 3 {
        print(BG_SELECTED());
        print(FG_BLACK());
        print(BOLD());
        print(" > 4. Exit               < ");
    } else {
        print(FG_WHITE());
        print("   4. Exit                 ");
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line("        ║");

    put_line("║                                          ║");
    put_line("╠══════════════════════════════════════════╣");
    print("║       ");
    print(FG_BRIGHT_WHITE());
    print("↑ / ↓ Navigate · Enter Select");
    print(FG_BRIGHT_CYAN());
    put_line("      ║");
    put_line("╚══════════════════════════════════════════╝");
    print(RESET());
}

// Render AI Setup Menu
pub fn render_ai_menu(selected_idx: i32, side: i32, diff: i32, tc: i32) {
    print("\r\n");
    print(FG_BRIGHT_CYAN());
    put_line("╔══════════════════════════════════════════╗");
    print("║        ");
    print(BOLD());
    print(FG_BRIGHT_YELLOW());
    print("Play with Built-in AI Opponent");
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line("    ║");
    put_line("╠══════════════════════════════════════════╣");

    // Option 0: Side
    print("║   ");
    if selected_idx == 0 {
        print(BG_SELECTED()); print(FG_BLACK()); print(BOLD());
        if side == 0 { print("> Your Side: White (First Move)       "); }
        else if side == 1 { print("> Your Side: Black (Second Move)      "); }
        else { print("> Your Side: Random                   "); }
    } else {
        print(FG_WHITE());
        if side == 0 { print("  Your Side: White (First Move)       "); }
        else if side == 1 { print("  Your Side: Black (Second Move)      "); }
        else { print("  Your Side: Random                   "); }
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line(" ║");

    // Option 1: Difficulty
    print("║   ");
    if selected_idx == 1 {
        print(BG_SELECTED()); print(FG_BLACK()); print(BOLD());
        if diff == 1 { print("> Difficulty: 1. Beginner (Depth 1)   "); }
        else if diff == 2 { print("> Difficulty: 2. Easy     (Depth 2)   "); }
        else if diff == 3 { print("> Difficulty: 3. Medium   (Depth 3)   "); }
        else { print("> Difficulty: 4. Hard     (Depth 4)   "); }
    } else {
        print(FG_WHITE());
        if diff == 1 { print("  Difficulty: 1. Beginner (Depth 1)   "); }
        else if diff == 2 { print("  Difficulty: 2. Easy     (Depth 2)   "); }
        else if diff == 3 { print("  Difficulty: 3. Medium   (Depth 3)   "); }
        else { print("  Difficulty: 4. Hard     (Depth 4)   "); }
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line(" ║");

    // Option 2: Time Control
    print("║   ");
    if selected_idx == 2 {
        print(BG_SELECTED()); print(FG_BLACK()); print(BOLD());
        if tc == 0 { print("> Clock: No Clock (Unlimited)         "); }
        else if tc == 1 { print("> Clock: 3 + 2 Blitz                  "); }
        else if tc == 2 { print("> Clock: 5 + 3 Rapid                  "); }
        else { print("> Clock: 10 + 0 Classical             "); }
    } else {
        print(FG_WHITE());
        if tc == 0 { print("  Clock: No Clock (Unlimited)         "); }
        else if tc == 1 { print("  Clock: 3 + 2 Blitz                  "); }
        else if tc == 2 { print("  Clock: 5 + 3 Rapid                  "); }
        else { print("  Clock: 10 + 0 Classical             "); }
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line(" ║");

    // Option 3: Start
    put_line("╠══════════════════════════════════════════╣");
    print("║   ");
    if selected_idx == 3 {
        print(BG_SELECTED()); print(FG_BLACK()); print(BOLD());
        print("> START CHESS MATCH                   ");
    } else {
        print(FG_BRIGHT_GREEN());
        print("  START CHESS MATCH                   ");
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line(" ║");

    // Option 4: Back
    print("║   ");
    if selected_idx == 4 {
        print(BG_SELECTED()); print(FG_BLACK()); print(BOLD());
        print("> Back to Main Menu                   ");
    } else {
        print(FG_WHITE());
        print("  Back to Main Menu                   ");
    }
    print(RESET());
    print(FG_BRIGHT_CYAN());
    put_line(" ║");

    put_line("╠══════════════════════════════════════════╣");
    print("║  ");
    print(FG_BRIGHT_WHITE());
    print("↑ / ↓ Navigate · Enter / Space Select  ");
    print(FG_BRIGHT_CYAN());
    put_line(" ║");
    put_line("╚══════════════════════════════════════════╝");
    print(RESET());
}

