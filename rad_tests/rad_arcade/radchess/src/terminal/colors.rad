// ==============================================================================
// RadChess: ANSI Colors, Visual Styles & Palette Themes
// ==============================================================================

pub fn RESET() -> str { "\x1b[0m" }
pub fn BOLD() -> str  { "\x1b[1m" }
pub fn DIM() -> str   { "\x1b[2m" }
pub fn REVERSE() -> str { "\x1b[7m" }

// Standard Foreground colors
pub fn FG_BLACK() -> str   { "\x1b[30m" }
pub fn FG_RED() -> str     { "\x1b[31m" }
pub fn FG_GREEN() -> str   { "\x1b[32m" }
pub fn FG_YELLOW() -> str  { "\x1b[33m" }
pub fn FG_BLUE() -> str    { "\x1b[34m" }
pub fn FG_MAGENTA() -> str { "\x1b[35m" }
pub fn FG_CYAN() -> str    { "\x1b[36m" }
pub fn FG_WHITE() -> str   { "\x1b[37m" }

// High-intensity foreground
pub fn FG_BRIGHT_WHITE() -> str  { "\x1b[97m" }
pub fn FG_BRIGHT_YELLOW() -> str { "\x1b[93m" }
pub fn FG_BRIGHT_CYAN() -> str   { "\x1b[96m" }
pub fn FG_BRIGHT_GREEN() -> str  { "\x1b[92m" }
pub fn FG_BRIGHT_RED() -> str    { "\x1b[91m" }

// Highlights
pub fn BG_SELECTED() -> str   { "\x1b[48;5;214m" } // Amber orange
pub fn BG_LEGAL_MOVE() -> str { "\x1b[48;5;150m" } // Soft mint target
pub fn BG_LAST_MOVE() -> str  { "\x1b[48;5;178m" } // Gold highlight
pub fn BG_CHECK() -> str      { "\x1b[48;5;196m" } // Bright crimson

// Piece colors
pub fn FG_WHITE_PIECE() -> str { "\x1b[38;5;231;1m" } // Pure crisp white
pub fn FG_BLACK_PIECE() -> str { "\x1b[38;5;234;1m" } // Deep obsidian black

// Get square background escape sequence based on theme and square coordinate
pub fn get_sq_bg(theme: i32, is_light: bool) -> str {
    if theme == 1 { // Classic Wood
        if is_light { return "\x1b[48;5;223m"; }
        return "\x1b[48;5;137m";
    } else if theme == 2 { // Emerald Forest
        if is_light { return "\x1b[48;5;254m"; }
        return "\x1b[48;5;29m";
    } else if theme == 3 { // Midnight
        if is_light { return "\x1b[48;5;242m"; }
        return "\x1b[48;5;236m";
    } else if theme == 4 { // Cyberpunk
        if is_light { return "\x1b[48;5;234m"; }
        return "\x1b[48;5;22m";
    }
    // Default Modern Slate (Theme 0)
    if is_light { return "\x1b[48;5;253m"; }
    return "\x1b[48;5;67m";
}

pub fn put_line(s: str) {
    print(s);
    print("\r\n");
}

pub fn print_pad_str(s: str, target_len: usize) {
    let p = s as *raw u8;
    var len = 0usize;
    while p[len] != 0u8 {
        len = len + 1usize;
    }
    var i = 0usize;
    var printed = 0usize;
    while i < len && printed < target_len {
        let ch = p[i];
        if ch >= 32u8 && ch < 127u8 {
            var buf = String.new();
            buf.push_byte(ch);
            print(buf.as_ptr() as str);
            printed = printed + 1usize;
        }
        i = i + 1usize;
    }
    while printed < target_len {
        print(" ");
        printed = printed + 1usize;
    }
}
