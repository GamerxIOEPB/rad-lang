// ==============================================================================
// Rad Arcade: Tetris
// Pure-Rad terminal implementation of classic Tetris.
// Zero external dependencies — pure syscalls, terminal, and console rendering.
// ==============================================================================

import terminal;
import keyboard;
import console;
import time;

struct TetrisGame {
    board: *raw var u8, // 10 x 20 grid
    cur_piece: i32,
    cur_rot: i32,
    cur_x: i32,
    cur_y: i32,
    next_piece: i32,
    score: i64,
    lines: i64,
    level: i64,
    game_over: bool,
    paused: bool,
    drop_timer: f64,
    drop_interval: f64,
}

// Tetromino definitions: 7 shapes * 4 rotations * 4 blocks * (dx, dy)
fn get_tetromino_offset(shape: i32, rot: i32, block: i32, is_y: bool) -> i32 {
    let s = shape % 7
    let r = rot % 4
    let b = block % 4

    // I-piece (0)
    if s == 0 {
        if r == 0 || r == 2 {
            if is_y { return 0 }
            if b == 0 { return -1 }
            if b == 1 { return 0 }
            if b == 2 { return 1 }
            return 2
        } else {
            if !is_y { return 0 }
            if b == 0 { return -1 }
            if b == 1 { return 0 }
            if b == 2 { return 1 }
            return 2
        }
    }
    // O-piece (1)
    if s == 1 {
        if is_y {
            if b == 0 || b == 1 { return 0 }
            return 1
        } else {
            if b == 0 || b == 2 { return 0 }
            return 1
        }
    }
    // T-piece (2)
    if s == 2 {
        if r == 0 {
            if is_y {
                if b == 3 { return -1 }
                return 0
            } else {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return 0
            }
        } else if r == 1 {
            if is_y {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return 0
            } else {
                if b == 3 { return 1 }
                return 0
            }
        } else if r == 2 {
            if is_y {
                if b == 3 { return 1 }
                return 0
            } else {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return 0
            }
        } else {
            if is_y {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return 0
            } else {
                if b == 3 { return -1 }
                return 0
            }
        }
    }
    // S-piece (3)
    if s == 3 {
        if r == 0 || r == 2 {
            if is_y {
                if b == 0 || b == 1 { return 0 }
                return -1
            } else {
                if b == 0 { return -1 }
                if b == 1 || b == 2 { return 0 }
                return 1
            }
        } else {
            if is_y {
                if b == 0 { return -1 }
                if b == 1 || b == 2 { return 0 }
                return 1
            } else {
                if b == 0 || b == 1 { return 0 }
                return 1
            }
        }
    }
    // Z-piece (4)
    if s == 4 {
        if r == 0 || r == 2 {
            if is_y {
                if b == 0 || b == 1 { return -1 }
                return 0
            } else {
                if b == 0 { return -1 }
                if b == 1 || b == 2 { return 0 }
                return 1
            }
        } else {
            if is_y {
                if b == 0 { return -1 }
                if b == 1 || b == 2 { return 0 }
                return 1
            } else {
                if b == 0 || b == 1 { return 1 }
                return 0
            }
        }
    }
    // J-piece (5)
    if s == 5 {
        if r == 0 {
            if is_y {
                if b == 3 { return -1 }
                return 0
            } else {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return -1
            }
        } else if r == 1 {
            if is_y {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return -1
            } else {
                if b == 3 { return 1 }
                return 0
            }
        } else if r == 2 {
            if is_y {
                if b == 3 { return 1 }
                return 0
            } else {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return 1
            }
        } else {
            if is_y {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return 1
            } else {
                if b == 3 { return -1 }
                return 0
            }
        }
    }
    // L-piece (6)
    if s == 6 {
        if r == 0 {
            if is_y {
                if b == 3 { return -1 }
                return 0
            } else {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return 1
            }
        } else if r == 1 {
            if is_y {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return 1
            } else {
                if b == 3 { return 1 }
                return 0
            }
        } else if r == 2 {
            if is_y {
                if b == 3 { return 1 }
                return 0
            } else {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return -1
            }
        } else {
            if is_y {
                if b == 0 { return -1 }
                if b == 1 { return 0 }
                if b == 2 { return 1 }
                return -1
            } else {
                if b == 3 { return -1 }
                return 0
            }
        }
    }
    return 0
}

fn get_piece_color(shape: i32) -> Color {
    let s = shape % 7
    if s == 0 { return Color.cyan() }          // I: Cyan
    if s == 1 { return Color.bright_yellow() } // O: Yellow
    if s == 2 { return Color.magenta() }       // T: Purple
    if s == 3 { return Color.green() }         // S: Green
    if s == 4 { return Color.red() }           // Z: Red
    if s == 5 { return Color.blue() }          // J: Blue
    return Color.bright_red()                  // L: Orange/Bright Red
}

impl TetrisGame {
    fn new() -> TetrisGame {
        let b = malloc(200usize) as *raw var u8
        var i = 0usize
        while i < 200usize {
            b[i] = 0u8
            i = i + 1usize
        }
        TetrisGame {
            board: b,
            cur_piece: 0,
            cur_rot: 0,
            cur_x: 4,
            cur_y: 0,
            next_piece: 2,
            score: 0i64,
            lines: 0i64,
            level: 1i64,
            game_over: false,
            paused: false,
            drop_timer: 0.0,
            drop_interval: 0.6,
        }
    }

    fn check_collision(self, px: i32, py: i32, rot: i32) -> bool {
        let b = self.board as *raw u8
        var i = 0
        while i < 4 {
            let dx = get_tetromino_offset(self.cur_piece, rot, i, false)
            let dy = get_tetromino_offset(self.cur_piece, rot, i, true)
            let x = px + dx
            let y = py + dy

            // Wall collisions
            if x < 0 || x >= 10 || y >= 20 {
                return true
            }
            if y >= 0 {
                let off = (y as usize) * 10usize + (x as usize)
                if b[off] != 0u8 {
                    return true
                }
            }
            i = i + 1
        }
        false
    }

    fn lock_piece(var self) {
        let b = self.board as *raw var u8
        var i = 0
        while i < 4 {
            let dx = get_tetromino_offset(self.cur_piece, self.cur_rot, i, false)
            let dy = get_tetromino_offset(self.cur_piece, self.cur_rot, i, true)
            let x = self.cur_x + dx
            let y = self.cur_y + dy
            if y >= 0 && y < 20 && x >= 0 && x < 10 {
                let off = (y as usize) * 10usize + (x as usize)
                b[off] = (self.cur_piece + 1) as u8
            }
            i = i + 1
        }

        // Line clears
        var cleared = 0i64
        var row = 19
        while row >= 0 {
            var full = true
            var col = 0
            while col < 10 {
                let off = (row as usize) * 10usize + (col as usize)
                if b[off] == 0u8 {
                    full = false
                    break
                }
                col = col + 1
            }

            if full {
                cleared = cleared + 1i64
                // Shift down
                var r = row
                while r > 0 {
                    var c = 0
                    while c < 10 {
                        let dst = (r as usize) * 10usize + (c as usize)
                        let src = ((r - 1) as usize) * 10usize + (c as usize)
                        b[dst] = b[src]
                        c = c + 1
                    }
                    r = r - 1
                }
                var c = 0
                while c < 10 {
                    b[c as usize] = 0u8
                    c = c + 1
                }
            } else {
                row = row - 1
            }
        }

        if cleared > 0i64 {
            self.lines = self.lines + cleared
            if cleared == 1i64 { self.score = self.score + (100i64 * self.level) }
            else if cleared == 2i64 { self.score = self.score + (300i64 * self.level) }
            else if cleared == 3i64 { self.score = self.score + (500i64 * self.level) }
            else { self.score = self.score + (800i64 * self.level) }

            self.level = 1i64 + (self.lines / 10i64)
            self.drop_interval = 0.6 / (self.level as f64)
            if self.drop_interval < 0.08 { self.drop_interval = 0.08 }
        }

        // Spawn next piece
        self.cur_piece = self.next_piece
        self.cur_rot = 0
        self.cur_x = 4
        self.cur_y = 0
        self.next_piece = (self.next_piece + 3) % 7

        if self.check_collision(self.cur_x, self.cur_y, self.cur_rot) {
            self.game_over = true
        }
    }

    fn drop(var self) {
        if !self.check_collision(self.cur_x, self.cur_y + 1, self.cur_rot) {
            self.cur_y = self.cur_y + 1
        } else {
            self.lock_piece()
        }
    }

    fn hard_drop(var self) {
        while !self.check_collision(self.cur_x, self.cur_y + 1, self.cur_rot) {
            self.cur_y = self.cur_y + 1
            self.score = self.score + 2i64
        }
        self.lock_piece()
    }

    fn render(self, var con: Console) {
        con.clear()

        // Draw title
        con.print_str(6usize, 0usize, "RAD ARCADE: TETRIS", Color.bright_yellow(), Color.default())

        // Draw game board frame (well is 10 wide, 20 high; each block is 2 cols: 20 cols wide)
        let bx = 3usize
        let by = 1usize
        con.draw_box(bx, by, 22usize, 22usize, Color.cyan(), Color.default())
        // Explicit bottom border to ensure visibility on all terminals
        con.print_str(bx, by + 21usize, "+--------------------+", Color.bright_cyan(), Color.default())

        // Draw locked blocks
        let b = self.board as *raw u8
        var y = 0
        while y < 20 {
            var x = 0
            while x < 10 {
                let off = (y as usize) * 10usize + (x as usize)
                let val = b[off] as i32
                if val > 0 {
                    let col = get_piece_color(val - 1)
                    let sx = bx + 1usize + ((x as usize) * 2usize)
                    let sy = by + 1usize + (y as usize)
                    con.set_cell(sx, sy, 91u8, col, Color.default()) // '['
                    con.set_cell(sx + 1usize, sy, 93u8, col, Color.default()) // ']'
                }
                x = x + 1
            }
            y = y + 1
        }

        // Draw current falling piece
        if !self.game_over {
            let col = get_piece_color(self.cur_piece)
            var i = 0
            while i < 4 {
                let dx = get_tetromino_offset(self.cur_piece, self.cur_rot, i, false)
                let dy = get_tetromino_offset(self.cur_piece, self.cur_rot, i, true)
                let x = self.cur_x + dx
                let y = self.cur_y + dy
                if y >= 0 && y < 20 && x >= 0 && x < 10 {
                    let sx = bx + 1usize + ((x as usize) * 2usize)
                    let sy = by + 1usize + (y as usize)
                    con.set_cell(sx, sy, 91u8, col, Color.default())
                    con.set_cell(sx + 1usize, sy, 93u8, col, Color.default())
                }
                i = i + 1
            }
        }

        // Draw sidebar (stats & next piece)
        let sx = 28usize
        con.draw_box(sx, 1usize, 18usize, 5usize, Color.bright_blue(), Color.default())
        con.print_str(sx + 2usize, 1usize, " NEXT ", Color.white(), Color.default())
        // Draw next piece preview
        let ncol = get_piece_color(self.next_piece)
        var ni = 0
        while ni < 4 {
            let dx = get_tetromino_offset(self.next_piece, 0, ni, false)
            let dy = get_tetromino_offset(self.next_piece, 0, ni, true)
            let px = sx + 7usize + ((dx as usize) * 2usize)
            let py = 3usize + (dy as usize)
            con.set_cell(px, py, 91u8, ncol, Color.default())
            con.set_cell(px + 1usize, py, 93u8, ncol, Color.default())
            ni = ni + 1
        }

        // Stats Box
        con.draw_box(sx, 7usize, 18usize, 8usize, Color.bright_blue(), Color.default())
        con.print_str(sx + 2usize, 7usize, " STATS ", Color.white(), Color.default())
        con.print_str(sx + 2usize, 9usize, "Score:", Color.yellow(), Color.default())
        let s_str = int_to_str(self.score as i32)
        con.print_str(sx + 9usize, 9usize, s_str.as_ptr() as str, Color.bright_white(), Color.default())

        con.print_str(sx + 2usize, 11usize, "Lines:", Color.yellow(), Color.default())
        let l_str = int_to_str(self.lines as i32)
        con.print_str(sx + 9usize, 11usize, l_str.as_ptr() as str, Color.bright_white(), Color.default())

        con.print_str(sx + 2usize, 13usize, "Level:", Color.yellow(), Color.default())
        let lv_str = int_to_str(self.level as i32)
        con.print_str(sx + 9usize, 13usize, lv_str.as_ptr() as str, Color.bright_white(), Color.default())

        // Instructions
        con.print_str(sx, 16usize, "Left/Right: Move", Color.white(), Color.default())
        con.print_str(sx, 17usize, "Up / W:     Rotate", Color.white(), Color.default())
        con.print_str(sx, 18usize, "Down / S:   Soft Drop", Color.white(), Color.default())
        con.print_str(sx, 19usize, "Space:      Hard Drop", Color.white(), Color.default())
        con.print_str(sx, 20usize, "P: Pause    Q: Quit", Color.white(), Color.default())

        if self.paused {
            con.print_str(bx + 7usize, by + 10usize, " PAUSED ", Color.bright_yellow(), Color.blue())
        }

        if self.game_over {
            con.print_str(bx + 5usize, by + 9usize, " GAME OVER ", Color.bright_white(), Color.red())
            con.print_str(bx + 3usize, by + 11usize, "Press 'R' Restart", Color.bright_yellow(), Color.default())
        }

        con.present()
    }

    fn destroy(var self) {
        if (self.board as usize) != 0usize {
            free(self.board as *raw u8)
            self.board = 0usize as *raw var u8
        }
    }
}

fn main() {
    var term = TerminalSession.new()
    term.enable_raw_mode()
    term.enter_alternate_screen()
    term.hide_cursor()

    var kbd = KeyboardReader.new()
    var con = Console.new(50usize, 24usize)
    var timer = FrameTimer.new(60u32)
    var game = TetrisGame.new()

    var running = true
    while running {
        let dt = timer.tick()

        // Handle user input
        // Drain and handle all pending user input
        while true {
            let evt = kbd.read_key(0)
            if evt.code == KEY_NONE {
                break
            }
            if (evt.code == KEY_ESC || evt.is_char(113u8) || evt.is_ctrl(99u8) || evt.is_eof()) && !evt.is_release { // Esc, 'q', Ctrl+C, EOF
                running = false
            } else if evt.is_char(112u8) { // 'p'
                game.paused = !game.paused
            } else if evt.is_char(114u8) && game.game_over { // 'r' restart
                game.destroy()
                game = TetrisGame.new()
            } else if !game.paused && !game.game_over && !evt.is_release {
                if evt.code == KEY_LEFT || evt.is_char(97u8) { // Left / 'a'
                    if !game.check_collision(game.cur_x - 1, game.cur_y, game.cur_rot) {
                        game.cur_x = game.cur_x - 1
                    }
                } else if evt.code == KEY_RIGHT || evt.is_char(100u8) { // Right / 'd'
                    if !game.check_collision(game.cur_x + 1, game.cur_y, game.cur_rot) {
                        game.cur_x = game.cur_x + 1
                    }
                } else if evt.code == KEY_UP || evt.is_char(119u8) { // Up / 'w' rotate
                    let next_rot = (game.cur_rot + 1) % 4
                    if !game.check_collision(game.cur_x, game.cur_y, next_rot) {
                        game.cur_rot = next_rot
                    }
                } else if evt.code == KEY_DOWN || evt.is_char(115u8) { // Down / 's'
                    game.drop()
                } else if evt.is_char(32u8) { // Space (hard drop)
                    game.hard_drop()
                }
            }
        }

        // Piece falling logic
        if !game.paused && !game.game_over {
            game.drop_timer = game.drop_timer + dt
            if game.drop_timer >= game.drop_interval {
                game.drop_timer = 0.0
                game.drop()
            }
        }

        game.render(con)
        timer.pace()
    }

    game.destroy()
    con.close_console()
    kbd.close_reader()
    term.close()
}
