extern "C" {
    fn cpp_fill_buffer(buf: *raw u8, len: i32) -> void;
    fn cpp_sum_array(arr: *raw i64, count: i64) -> i64;
    fn malloc(size: usize) -> *raw u8;
    fn free(ptr: *raw u8) -> void;
}

fn main() -> i32 {
    let buf = malloc(16usize);
    cpp_fill_buffer(buf, 10);
    println("buf={}", buf as str);
    free(buf);

    let nums = malloc(64usize) as *raw i64;
    nums[0] = 10;
    nums[1] = 20;
    nums[2] = 30;
    nums[3] = 40;
    nums[4] = 50;
    let sum = cpp_sum_array(nums, 5);
    println("sum={}", sum);
    free(nums as *raw u8);
    0
}
