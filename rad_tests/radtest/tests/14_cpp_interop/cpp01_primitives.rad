extern "C" {
    fn cpp_add_i32(a: i32, b: i32) -> i32;
    fn cpp_mul_i64(a: i64, b: i64) -> i64;
    fn cpp_hypot_f64(x: f64, y: f64) -> f64;
    fn cpp_bool_logic(cond1: i32, cond2: i32) -> i32;
}

fn main() -> i32 {
    let s = cpp_add_i32(100, 42);
    let m = cpp_mul_i64(1000000, 25);
    let h = cpp_hypot_f64(3.0, 4.0);
    let b = cpp_bool_logic(1, 0);

    println("s={}", s);
    println("m={}", m);
    println("h={}", h);
    println("b={}", b);
    0
}
