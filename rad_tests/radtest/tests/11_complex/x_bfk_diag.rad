// [brainfuck] Interpreter over an int-coded program. Ops: 1='+',2='-',3='>',4='<',5='.',6='[',7=']'
// Program below prints "Hi\n": 72 x(+), print, 33 x(+)? no wait: computed 'H'=72, then '+'*33 -> 90+16=106.. keep simple: '+' x72, '.', '+' x33, '.', '+' x10, '.'
fn run(prog: *raw var i32, plen: i32, cells: *raw var i32) {
    var pc = 0;
    var dp = 0;
    while pc < plen {
        let op = prog[pc];
        if op == 1 {
            cells[dp] = cells[dp] + 1;
        } else {
            if op == 2 {
                cells[dp] = cells[dp] - 1;
            } else {
                if op == 3 {
                    dp = dp + 1;
                } else {
                    if op == 4 {
                        dp = dp - 1;
                    } else {
                        if op == 5 {
                            let ch = cells[dp];
                            printf("%c", ch);
                        }
                    }
                }
            }
        }
        pc = pc + 1;
    }
}
fn main() {
    var prog = Vec.new();
    var k = 0;
    while k < 72 {
        prog.push(1);
        k = k + 1;
    }
    prog.push(5);
    k = 0;
    while k < 33 {
        prog.push(1);
        k = k + 1;
    }
    prog.push(5);
    k = 0;
    while k < 10 {
        prog.push(1);
        k = k + 1;
    }
    prog.push(5);
    var cells = Vec.new();
    var z = 0;
    while z < 16 {
        cells.push(0);
        z = z + 1;
    }
    let p = prog.ptr;
    let c = cells.ptr;
    let n = prog.len;
    run(p, n, c);
    printf("\n");
}
