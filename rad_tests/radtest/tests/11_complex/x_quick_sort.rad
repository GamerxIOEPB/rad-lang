// [quicksort] Classic in-place quicksort over a Vec.
fn quicksort(p: *raw var i32, lo: i32, hi: i32) {
    var l = lo;
    var h = hi;
    let pivot = p[lo];
    while l <= h {
        while p[l] < pivot {
            l = l + 1;
        }
        while p[h] > pivot {
            h = h - 1;
        }
        if l <= h {
            let tmp = p[l];
            p[l] = p[h];
            p[h] = tmp;
            l = l + 1;
            h = h - 1;
        }
    }
    if lo < h {
        quicksort(p, lo, h);
    }
    if l < hi {
        quicksort(p, l, hi);
    }
}
fn main() {
    var v = Vec.new();
    v.push(5);
    v.push(12);
    v.push(1);
    v.push(9);
    v.push(7);
    v.push(2);
    let p = v.ptr;
    let n = 6;
    quicksort(p, 0, n - 1);
    var k = 0;
    while k < n {
        printf("%d ", p[k]);
        k = k + 1;
    }
    printf("\n");
}
