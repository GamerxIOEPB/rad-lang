// [matrix] 3x3 A*B where A=B=[[0..8 row-major]].
fn main() {
    let n = 3;
    var a = Vec.new();
    var b = Vec.new();
    var idx = 0;
    while idx < n * n {
        a.push(idx);
        b.push(idx);
        idx = idx + 1;
    }
    var c = Vec.new();
    var i = 0;
    while i < n {
        var j = 0;
        while j < n {
            var s = 0;
            var k = 0;
            while k < n {
                let av = a.ptr[i * n + k];
                let bv = b.ptr[k * n + j];
                s = s + av * bv;
                k = k + 1;
            }
            c.push(s);
            j = j + 1;
        }
        i = i + 1;
    }
    let p = c.ptr;
    printf("%d %d %d\n", p[0], p[1], p[2]);
    printf("%d %d %d\n", p[3], p[4], p[5]);
    printf("%d %d %d\n", p[6], p[7], p[8]);
}
