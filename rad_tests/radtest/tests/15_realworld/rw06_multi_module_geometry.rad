fn main() -> i32 {
    let r1 = Rect { x: 0, y: 0, w: 10, h: 10 };
    let r2 = Rect { x: 5, y: 5, w: 10, h: 10 };
    let r3 = Rect { x: 20, y: 20, w: 5, h: 5 };

    println("r1 area: {}", rect_area(r1));
    println("r2 area: {}", rect_area(r2));
    println("r3 area: {}", rect_area(r3));

    let hit_1_2 = rect_intersects(r1, r2);
    let hit_1_3 = rect_intersects(r1, r3);

    println("intersect 1&2: {}", hit_1_2);
    println("intersect 1&3: {}", hit_1_3);
    0
}
