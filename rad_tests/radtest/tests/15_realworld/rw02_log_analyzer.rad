fn str_len(s: str) -> usize {
    let p = s as *raw u8;
    var i = 0usize;
    while p[i] != 0u8 {
        i = i + 1usize;
    }
    return i;
}

fn str_starts_with(s: str, prefix: str) -> bool {
    let ps = s as *raw u8;
    let pp = prefix as *raw u8;
    var i = 0usize;
    while pp[i] != 0u8 {
        if ps[i] == 0u8 || ps[i] != pp[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn str_ends_with(s: str, suffix: str) -> bool {
    let s_len = str_len(s);
    let suf_len = str_len(suffix);
    if s_len < suf_len || s_len == 0usize {
        return false;
    }
    let ps = s as *raw u8;
    let p_suf = suffix as *raw u8;
    let start = s_len - suf_len;
    var i = 0usize;
    while i < suf_len {
        if ps[start + i] != p_suf[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

struct LogEntry {
    level: String,
    status: i64,
    bytes: i64,
}

fn parse_log_line(line: str) -> LogEntry {
    var entry = LogEntry {
        level: String.new(),
        status: 200,
        bytes: 0,
    };
    if str_starts_with(line, "[INFO]") {
        entry.level = String.from_str("INFO");
    } else if str_starts_with(line, "[WARN]") {
        entry.level = String.from_str("WARN");
    } else if str_starts_with(line, "[ERROR]") {
        entry.level = String.from_str("ERROR");
    } else {
        entry.level = String.from_str("UNKNOWN");
    }

    if str_ends_with(line, " 500") {
        entry.status = 500;
        entry.bytes = 128;
    } else if str_ends_with(line, " 404") {
        entry.status = 404;
        entry.bytes = 256;
    } else {
        entry.status = 200;
        entry.bytes = 1024;
    }
    return entry;
}

fn main() -> i32 {
    var lines = Vec.new();
    lines.push(String.from_str("[INFO] GET /index.html 200"));
    lines.push(String.from_str("[INFO] GET /api/v1/users 200"));
    lines.push(String.from_str("[WARN] GET /missing 404"));
    lines.push(String.from_str("[INFO] POST /submit 200"));
    lines.push(String.from_str("[ERROR] POST /checkout 500"));
    lines.push(String.from_str("[INFO] GET /dashboard 200"));
    lines.push(String.from_str("[ERROR] GET /database 500"));

    var total_requests = 0i64;
    var status_200 = 0i64;
    var status_404 = 0i64;
    var status_500 = 0i64;
    var total_bytes = 0i64;
    var error_count = 0i64;

    var i = 0usize;
    while i < lines.len {
        let entry = parse_log_line(lines.ptr[i].as_ptr() as str);
        total_requests = total_requests + 1;
        total_bytes = total_bytes + entry.bytes;

        if entry.status == 200 {
            status_200 = status_200 + 1;
        } else if entry.status == 404 {
            status_404 = status_404 + 1;
        } else if entry.status == 500 {
            status_500 = status_500 + 1;
            error_count = error_count + 1;
        }
        i = i + 1usize;
    }

    println("Total: {}", total_requests);
    println("Status 200: {}", status_200);
    println("Status 404: {}", status_404);
    println("Status 500: {}", status_500);
    println("Total bytes: {}", total_bytes);
    println("Errors: {}", error_count);
    0
}
