struct Mat2x2 {
    m00: f64,
    m01: f64,
    m10: f64,
    m11: f64,
}

struct Vec2 {
    x: f64,
    y: f64,
}

fn mat_det(m: Mat2x2) -> f64 {
    m.m00 * m.m11 - m.m01 * m.m10
}

fn mat_mul_vec(m: Mat2x2, v: Vec2) -> Vec2 {
    Vec2 {
        x: m.m00 * v.x + m.m01 * v.y,
        y: m.m10 * v.x + m.m11 * v.y,
    }
}

fn mat_mul_mat(a: Mat2x2, b: Mat2x2) -> Mat2x2 {
    Mat2x2 {
        m00: a.m00 * b.m00 + a.m01 * b.m10,
        m01: a.m00 * b.m01 + a.m01 * b.m11,
        m10: a.m10 * b.m00 + a.m11 * b.m10,
        m11: a.m10 * b.m01 + a.m11 * b.m11,
    }
}

fn main() -> i32 {
    // Scaling matrix (sx=2.0, sy=3.0)
    let s = Mat2x2 {
        m00: 2.0,
        m01: 0.0,
        m10: 0.0,
        m11: 3.0,
    };

    // Shear matrix (kx=0.5, ky=0.0)
    let sh = Mat2x2 {
        m00: 1.0,
        m01: 0.5,
        m10: 0.0,
        m11: 1.0,
    };

    let combo = mat_mul_mat(s, sh);
    let det = mat_det(combo);

    let v = Vec2 { x: 4.0, y: 2.0 };
    let transformed = mat_mul_vec(combo, v);

    println("det: {}", det);
    println("transformed: ({}, {})", transformed.x, transformed.y);
    0
}
