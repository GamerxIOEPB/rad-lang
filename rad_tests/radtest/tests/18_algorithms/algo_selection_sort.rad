fn selection_sort(var arr: []i64) {
    let n = arr.len
    for i in 0..n {
        var min_idx = i
        for j in (i + 1usize)..n {
            if arr[j] < arr[min_idx] {
                min_idx = j
            }
        }
        if min_idx != i {
            swap(arr[i], arr[min_idx])
        }
    }
}

fn main() -> i32 {
    var arr = [29, 10, 14, 37, 13]
    selection_sort(arr)
    for x in arr {
        println(x)
    }
    return 0
}
