fn merge(var arr: []i64, l: usize, m: usize, r: usize) {
    let n1 = m - l + 1usize
    let n2 = r - m

    var left = [0, 0, 0, 0, 0, 0, 0, 0]
    var right = [0, 0, 0, 0, 0, 0, 0, 0]

    for i in 0..n1 {
        left[i] = arr[l + i]
    }
    for j in 0..n2 {
        right[j] = arr[m + 1usize + j]
    }

    var i = 0usize
    var j = 0usize
    var k = l

    while i < n1 && j < n2 {
        if left[i] <= right[j] {
            arr[k] = left[i]
            i = i + 1usize
        } else {
            arr[k] = right[j]
            j = j + 1usize
        }
        k = k + 1usize
    }

    while i < n1 {
        arr[k] = left[i]
        i = i + 1usize
        k = k + 1usize
    }

    while j < n2 {
        arr[k] = right[j]
        j = j + 1usize
        k = k + 1usize
    }
}

fn merge_sort(var arr: []i64, l: usize, r: usize) {
    if l < r {
        let m = l + (r - l) / 2usize
        merge_sort(arr, l, m)
        merge_sort(arr, m + 1usize, r)
        merge(arr, l, m, r)
    }
}

fn main() -> i32 {
    var arr = [38, 27, 43, 3, 9, 82, 10]
    merge_sort(arr, 0usize, arr.len - 1usize)
    for x in arr {
        println(x)
    }
    return 0
}
