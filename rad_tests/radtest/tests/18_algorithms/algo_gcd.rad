fn gcd(var a: i64, var b: i64) -> i64 {
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

fn lcm(a: i64, b: i64) -> i64 {
    let g = gcd(a, b)
    if g == 0 {
        return 0
    }
    return (a / g) * b
}

fn main() -> i32 {
    println(gcd(48, 18))
    println(lcm(48, 18))
    println(gcd(101, 103))
    println(gcd(54, 24))
    return 0
}
