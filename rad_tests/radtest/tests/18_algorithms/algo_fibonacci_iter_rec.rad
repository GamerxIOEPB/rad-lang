fn fib_rec(n: i64) -> i64 {
    if n <= 1 {
        return n
    }
    return fib_rec(n - 1) + fib_rec(n - 2)
}

fn fib_iter(n: i64) -> i64 {
    if n <= 1 {
        return n
    }
    var a = 0
    var b = 1
    for i in 2..(n + 1) {
        let next = a + b
        a = b
        b = next
    }
    return b
}

fn main() -> i32 {
    for i in 0..11 {
        let r = fib_rec(i)
        let it = fib_iter(i)
        if r == it {
            println(r)
        } else {
            println(-1)
        }
    }
    return 0
}
