fn fact_rec(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    return n * fact_rec(n - 1)
}

fn fact_iter(n: i64) -> i64 {
    var res = 1
    for i in 2..(n + 1) {
        res = res * i
    }
    return res
}

fn main() -> i32 {
    for i in 1..9 {
        let r = fact_rec(i)
        let it = fact_iter(i)
        if r == it {
            println(r)
        } else {
            println(-1)
        }
    }
    return 0
}
