// [Vec] Iterate via the ptr field; squares 1..25.
fn main() {
    var v = Vec.new();
    var k = 1;
    while k <= 5 {
        v.push(k * k);
        k = k + 1;
    }
    let p = v.ptr;
    var sum = 0;
    var idx = 0;
    while idx < v.len {
        let e = p[idx];
        sum = sum + e;
        idx = idx + 1;
    }
    println("sum={sum}");
}
