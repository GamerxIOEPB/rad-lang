// [arith] Operator precedence, integer division and modulo.
fn main() {
    let a = 10;
    let b = 3;
    let s1 = a + b;
    let s2 = a - b;
    let s3 = a * b;
    let s4 = a / b;
    let s5 = a % b;
    let s6 = a + b * 2 - a / b;
    let s7 = (a + b) * 2;
    printf("%d %d %d %d %d %d %d\n", s1, s2, s3, s4, s5, s6, s7);
}
