// [early-return] Multiple return paths.
fn classify(n: i32) -> str {
    if n > 0 {
        return "pos";
    }
    if n < 0 {
        return "neg";
    }
    return "zero";
}
fn main() {
    let p = classify(5);
    let n = classify(-3);
    let z = classify(0);
    printf("%s %s %s\n", p, n, z);
}
