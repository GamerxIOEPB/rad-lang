// [forward-ref] is_even defined BEFORE the is_odd it calls.
fn is_even(n: i32) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}
fn is_odd(n: i32) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}
fn main() {
    if is_even(10) {
        println("even10");
    }
    if is_odd(7) {
        println("odd7");
    }
}
