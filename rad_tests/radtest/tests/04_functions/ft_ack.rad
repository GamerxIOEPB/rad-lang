// [ackermann] Deep recursion. A(2,3)=9, A(3,3)=61.
fn ack(m: i32, n: i32) -> i32 {
    if m == 0 {
        return n + 1;
    }
    if n == 0 {
        return ack(m - 1, 1);
    }
    return ack(m - 1, ack(m, n - 1));
}
fn main() {
    let a = ack(2, 3);
    printf("a23=%d\n", a);
    let b = ack(3, 3);
    printf("a33=%d\n", b);
}
