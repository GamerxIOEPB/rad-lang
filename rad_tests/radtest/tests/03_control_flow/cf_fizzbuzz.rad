// [fizzbuzz] The classic.
fn main() {
    var n = 1;
    while n <= 15 {
        if n % 15 == 0 {
            printf("FizzBuzz");
        } else if n % 3 == 0 {
            printf("Fizz");
        } else if n % 5 == 0 {
            printf("Buzz");
        } else {
            printf("%d", n);
        }
        printf("\n");
        n = n + 1;
    }
}
