// [structs_field_separators] Positive tests for struct fields separated by newlines, commas, and semicolons.

struct PointNewline {
    x: i32
    y: i32
}

struct PointComma { x: i32, y: i32 }

struct PointSemi { x: i32; y: i32 }

struct PointMixed {
    pub a: i32;
    pub b: i32,
    c: i32
}

fn main() -> i32 {
    let p1 = PointNewline { x: 10, y: 20 }
    let p2 = PointComma { x: 30, y: 40 }
    let p3 = PointSemi { x: 50, y: 60 }
    let p4 = PointMixed { a: 1, b: 2, c: 3 }

    println("p1: {},{}", p1.x, p1.y)
    println("p2: {},{}", p2.x, p2.y)
    println("p3: {},{}", p3.x, p3.y)
    println("p4: {},{},{}", p4.a, p4.b, p4.c)

    return 0;
}
