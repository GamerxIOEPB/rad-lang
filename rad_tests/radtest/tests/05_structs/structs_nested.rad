// [nested-struct] Struct with struct-typed fields.
struct Point {
    x: i64,
    y: i64,
}
struct Line {
    a: Point,
    b: Point,
}
fn main() {
    let l = Line { a: Point { x: 1i64, y: 2i64 }, b: Point { x: 5i64, y: 6i64 } };
    let ax = l.a.x;
    let by = l.b.y;
    println("ax={ax} by={by}");
}
