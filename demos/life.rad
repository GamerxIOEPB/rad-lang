// ==============================================================================
// Rad Graphics Demo 3: Conway's Game of Life Cellular Automaton (60 FPS)
// Dynamically adjusts to terminal/display resolution and runs continuously.
// Controls: 'g' spawn glider, 'r' randomize cluster, 'c' clear, 'q' quit.
// ==============================================================================

import gfx;

struct Rng {
    pub state: u64,
}

impl Rng {
    pub fn new(seed: u64) -> Rng {
        return Rng { state: seed };
    }

    pub fn next(var self) -> u64 {
        self.state = self.state ^ (self.state << 13u64);
        self.state = self.state ^ (self.state >> 7u64);
        self.state = self.state ^ (self.state << 17u64);
        return self.state;
    }

    pub fn range(var self, min_val: i64, max_val: i64) -> i64 {
        let span = (max_val - min_val) + 1i64;
        let r = (self.next() % (span as u64)) as i64;
        return min_val + r;
    }
}

fn spawn_glider(grid: *raw var u8, width: usize, gx: usize, gy: usize) {
    grid[(gy * width) + gx + 1usize] = 1u8;
    grid[((gy + 1usize) * width) + gx + 2usize] = 1u8;
    grid[((gy + 2usize) * width) + gx] = 1u8;
    grid[((gy + 2usize) * width) + gx + 1usize] = 1u8;
    grid[((gy + 2usize) * width) + gx + 2usize] = 1u8;
}

fn spawn_lwss(grid: *raw var u8, width: usize, gx: usize, gy: usize) {
    // 5x4 lightweight spaceship flying horizontally
    grid[(gy * width) + gx + 1usize] = 1u8;
    grid[(gy * width) + gx + 4usize] = 1u8;
    grid[((gy + 1usize) * width) + gx] = 1u8;
    grid[((gy + 2usize) * width) + gx] = 1u8;
    grid[((gy + 2usize) * width) + gx + 4usize] = 1u8;
    grid[((gy + 3usize) * width) + gx] = 1u8;
    grid[((gy + 3usize) * width) + gx + 1usize] = 1u8;
    grid[((gy + 3usize) * width) + gx + 2usize] = 1u8;
    grid[((gy + 3usize) * width) + gx + 3usize] = 1u8;
}

fn spawn_r_pentomino(grid: *raw var u8, width: usize, gx: usize, gy: usize) {
    // R-pentomino chaotic grower
    grid[(gy * width) + gx + 1usize] = 1u8;
    grid[(gy * width) + gx + 2usize] = 1u8;
    grid[((gy + 1usize) * width) + gx] = 1u8;
    grid[((gy + 1usize) * width) + gx + 1usize] = 1u8;
    grid[((gy + 2usize) * width) + gx + 1usize] = 1u8;
}

fn spawn_blinker(grid: *raw var u8, width: usize, gx: usize, gy: usize) {
    grid[(gy * width) + gx] = 1u8;
    grid[(gy * width) + gx + 1usize] = 1u8;
    grid[(gy * width) + gx + 2usize] = 1u8;
}

pub fn main() -> i32 {
    // Dynamically auto-detect terminal resolution:
    var window = Window.open_autores("Rad Conway's Game of Life");
    var width = window.width;
    var height = window.height;
    var total_cells = width * height;

    var canvas = Canvas.new(width, height);

    var rng = Rng.new(9876543219876543u64);

    var cur_grid = malloc(total_cells) as *raw var u8;
    var next_grid = malloc(total_cells) as *raw var u8;
    var age_grid = malloc(total_cells) as *raw var u8;

    // Start with a clean grid
    var idx = 0usize;
    while idx < total_cells {
        cur_grid[idx] = 0u8;
        next_grid[idx] = 0u8;
        age_grid[idx] = 0u8;
        idx = idx + 1usize;
    }

    // Seed famous Conway life forms scaled to detected resolution:
    if width > 30usize && height > 20usize {
        // 1. Gliders sailing across the field
        spawn_glider(cur_grid, width, 4usize, 4usize);
        spawn_glider(cur_grid, width, width - 12usize, 6usize);

        // 2. Spaceship gliding across middle
        spawn_lwss(cur_grid, width, 6usize, height / 3usize);

        // 3. R-pentomino in center (generates rich organic growth)
        spawn_r_pentomino(cur_grid, width, width / 2usize, height / 2usize);

        // 4. Oscillators
        spawn_blinker(cur_grid, width, width / 4usize, height / 4usize);
        spawn_blinker(cur_grid, width, (width * 3usize) / 4usize, (height * 3usize) / 4usize);
    }

    // Runs continuously until user presses 'q' / 'Q' / ESC
    while window.is_open() {
        let ev_opt = window.poll_event();
        match ev_opt {
            Option.Some(ev) => {
                if ev.is_close() || ev.is_key(113u8) || ev.is_key(81u8) || ev.is_key(27u8) { // 'q', 'Q', ESC
                    window.close();
                } else if ev.is_key(103u8) { // 'g' spawn new glider at random position
                    if width > 8usize && height > 8usize {
                        let rx = rng.range(2i64, (width as i64) - 6i64) as usize;
                        let ry = rng.range(2i64, (height as i64) - 6i64) as usize;
                        spawn_glider(cur_grid, width, rx, ry);
                    }
                } else if ev.is_key(114u8) { // 'r' randomize center cluster
                    let y_start = height / 4usize;
                    let y_end = (height * 3usize) / 4usize;
                    let x_start = width / 4usize;
                    let x_end = (width * 3usize) / 4usize;
                    var cy = y_start;
                    while cy < y_end {
                        var cx = x_start;
                        while cx < x_end {
                            let c_idx = (cy * width) + cx;
                            if rng.range(0i64, 100i64) < 30i64 {
                                cur_grid[c_idx] = 1u8;
                                age_grid[c_idx] = 1u8;
                            } else {
                                cur_grid[c_idx] = 0u8;
                                age_grid[c_idx] = 0u8;
                            }
                            cx = cx + 1usize;
                        }
                        cy = cy + 1usize;
                    }
                } else if ev.is_key(99u8) { // 'c' clear
                    idx = 0usize;
                    while idx < total_cells {
                        cur_grid[idx] = 0u8;
                        age_grid[idx] = 0u8;
                        idx = idx + 1usize;
                    }
                }
            },
            Option.None => {},
            _ => {},
        }

        if !window.is_open() {
            break;
        }

        // Dynamically adjust on terminal resize
        if window.check_resize() {
            free(cur_grid);
            free(next_grid);
            free(age_grid);
            canvas.destroy();

            width = window.width;
            height = window.height;
            total_cells = width * height;
            canvas = Canvas.new(width, height);
            cur_grid = malloc(total_cells) as *raw var u8;
            next_grid = malloc(total_cells) as *raw var u8;
            age_grid = malloc(total_cells) as *raw var u8;

            idx = 0usize;
            while idx < total_cells {
                cur_grid[idx] = 0u8;
                next_grid[idx] = 0u8;
                age_grid[idx] = 0u8;
                idx = idx + 1usize;
            }

            if width > 30usize && height > 20usize {
                spawn_glider(cur_grid, width, 4usize, 4usize);
                spawn_glider(cur_grid, width, width - 12usize, 6usize);
                spawn_lwss(cur_grid, width, 6usize, height / 3usize);
                spawn_r_pentomino(cur_grid, width, width / 2usize, height / 2usize);
            }
        }

        canvas.clear(Color.rgb(0u8, 0u8, 0u8)); // Crisp pitch black background

        // Compute next generation according to standard Conway B3/S23 rules
        var y = 0usize;
        while y < height {
            var x = 0usize;
            while x < width {
                let left = (x + width - 1usize) % width;
                let right = (x + 1usize) % width;
                let up = (y + height - 1usize) % height;
                let down = (y + 1usize) % height;

                var neighbors = 0i32;
                if cur_grid[(up * width) + left] > 0u8 { neighbors = neighbors + 1; }
                if cur_grid[(up * width) + x] > 0u8 { neighbors = neighbors + 1; }
                if cur_grid[(up * width) + right] > 0u8 { neighbors = neighbors + 1; }
                if cur_grid[(y * width) + left] > 0u8 { neighbors = neighbors + 1; }
                if cur_grid[(y * width) + right] > 0u8 { neighbors = neighbors + 1; }
                if cur_grid[(down * width) + left] > 0u8 { neighbors = neighbors + 1; }
                if cur_grid[(down * width) + x] > 0u8 { neighbors = neighbors + 1; }
                if cur_grid[(down * width) + right] > 0u8 { neighbors = neighbors + 1; }

                let cell_idx = (y * width) + x;
                let is_alive = cur_grid[cell_idx] > 0u8;

                if is_alive && (neighbors == 2 || neighbors == 3) {
                    next_grid[cell_idx] = 1u8;
                    let old_age = age_grid[cell_idx];
                    if old_age < 250u8 {
                        age_grid[cell_idx] = old_age + 1u8;
                    }
                } else if !is_alive && neighbors == 3 {
                    next_grid[cell_idx] = 1u8;
                    age_grid[cell_idx] = 1u8;
                } else {
                    next_grid[cell_idx] = 0u8;
                    age_grid[cell_idx] = 0u8;
                }

                // Render current alive cell
                if is_alive {
                    let a = age_grid[cell_idx];
                    var col = Color.rgb(60u8, 255u8, 80u8); // Vibrant neon green
                    if a > 10u8 {
                        col = Color.rgb(0u8, 210u8, 255u8); // Long-lived: cyan
                    } else if a > 4u8 {
                        col = Color.rgb(40u8, 240u8, 160u8); // Maturing: seafoam green
                    }
                    canvas.set_pixel(x, y, col);
                }

                x = x + 1usize;
            }
            y = y + 1usize;
        }

        // Copy next_grid back to cur_grid
        idx = 0usize;
        while idx < total_cells {
            cur_grid[idx] = next_grid[idx];
            idx = idx + 1usize;
        }

        window.draw_canvas(canvas);
        Window.sleep_frame(25u64); // 25 FPS update rate for clear biological evolution
    }

    free(cur_grid);
    free(next_grid);
    free(age_grid);
    canvas.destroy();
    window.close();

    println("Conway's Game of Life finished successfully!");
    return 0;
}
