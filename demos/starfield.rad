// ==============================================================================
// Rad Graphics Demo 1: 3D Perspective Warp Starfield (60 FPS)
// Uses rad-gfx Window and Canvas with 24-bit TrueColor display.
// Controls: '+' speed up, '-' slow down, 'q' quit.
// ==============================================================================

import gfx;

struct Rng {
    pub state: u64,
}

impl Rng {
    pub fn new(seed: u64) -> Rng {
        return Rng { state: seed };
    }

    pub fn next(var self) -> u64 {
        self.state = self.state ^ (self.state << 13u64);
        self.state = self.state ^ (self.state >> 7u64);
        self.state = self.state ^ (self.state << 17u64);
        return self.state;
    }

    pub fn range(var self, min_val: i64, max_val: i64) -> i64 {
        let span = (max_val - min_val) + 1i64;
        let r = (self.next() % (span as u64)) as i64;
        return min_val + r;
    }
}

pub fn main() -> i32 {
    let width = 70usize;
    let height = 36usize;
    let cx = (width as i64) / 2i64;
    let cy = (height as i64) / 2i64;

    var window = Window.open(width, height, "Rad 3D Warp Starfield");
    var canvas = Canvas.new(width, height);

    let num_stars = 100usize;
    let max_depth = 1000i64;
    var speed = 20i64;

    var rng = Rng.new(8817264546332525288u64);

    let star_x = malloc(num_stars * 8usize) as *raw var i64;
    let star_y = malloc(num_stars * 8usize) as *raw var i64;
    let star_z = malloc(num_stars * 8usize) as *raw var i64;
    let star_pz = malloc(num_stars * 8usize) as *raw var i64;

    var i = 0usize;
    while i < num_stars {
        star_x[i] = rng.range(-600i64, 600i64);
        star_y[i] = rng.range(-300i64, 300i64);
        star_z[i] = rng.range(50i64, max_depth);
        star_pz[i] = star_z[i];
        i = i + 1usize;
    }

    var frame = 0u64;
    let max_frames = 180u64; // Runs 180 frames (~3 sec) or until 'q'

    while window.is_open() && frame < max_frames {
        // Poll user events
        let ev_opt = window.poll_event();
        match ev_opt {
            Option.Some(ev) => {
                if ev.is_close() || ev.is_key(113u8) { // 'q'
                    window.close();
                } else if ev.is_key(43u8) || ev.is_key(61u8) { // '+' or '='
                    speed = speed + 4i64;
                } else if ev.is_key(45u8) && speed > 4i64 { // '-'
                    speed = speed - 4i64;
                }
            },
            Option.None => {},
            _ => {},
        }

        if !window.is_open() {
            break;
        }

        canvas.clear(Color.rgb(4u8, 4u8, 12u8)); // Deep space blue

        // Update and draw stars
        i = 0usize;
        while i < num_stars {
            star_pz[i] = star_z[i];
            star_z[i] = star_z[i] - speed;

            if star_z[i] <= 15i64 {
                star_x[i] = rng.range(-600i64, 600i64);
                star_y[i] = rng.range(-300i64, 300i64);
                star_z[i] = max_depth;
                star_pz[i] = max_depth;
            }

            let z = star_z[i];
            let pz = star_pz[i];

            let sx = cx + ((star_x[i] * 40i64) / z);
            let sy = cy + ((star_y[i] * 20i64) / z);
            let psx = cx + ((star_x[i] * 40i64) / pz);
            let psy = cy + ((star_y[i] * 20i64) / pz);

            // Brightness scales as star gets closer
            let factor = ((max_depth - z) * 230i64) / max_depth;
            let b = (25i64 + factor) as u8;
            let star_col = Color.rgb(b, b, 255u8);

            if sx >= 0i64 && sx < (width as i64) && sy >= 0i64 && sy < (height as i64) {
                if speed > 15i64 && (sx != psx || sy != psy) {
                    canvas.draw_line(psx, psy, sx, sy, star_col);
                } else {
                    canvas.set_pixel(sx as usize, sy as usize, star_col);
                }
            }

            i = i + 1usize;
        }

        window.draw_canvas(canvas);
        Window.sleep_frame(60u64);
        frame = frame + 1u64;
    }

    free(star_x as *raw var u8);
    free(star_y as *raw var u8);
    free(star_z as *raw var u8);
    free(star_pz as *raw var u8);
    canvas.destroy();
    window.close();

    println("Starfield demo finished successfully!");
    return 0;
}
