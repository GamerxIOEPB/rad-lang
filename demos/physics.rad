// ==============================================================================
// Rad Graphics Demo 2: 2D Multi-Body Particle Physics Simulation (60 FPS)
// Dynamically adjusts to terminal/display resolution and runs continuously.
// Controls: 'g' toggle gravity, 'r' reset/scramble, 'q' quit.
// ==============================================================================

import gfx;

struct Rng {
    pub state: u64,
}

impl Rng {
    pub fn new(seed: u64) -> Rng {
        return Rng { state: seed };
    }

    pub fn next(var self) -> u64 {
        self.state = self.state ^ (self.state << 13u64);
        self.state = self.state ^ (self.state >> 7u64);
        self.state = self.state ^ (self.state << 17u64);
        return self.state;
    }

    pub fn range(var self, min_val: i64, max_val: i64) -> i64 {
        let span = (max_val - min_val) + 1i64;
        let r = (self.next() % (span as u64)) as i64;
        return min_val + r;
    }
}

pub fn main() -> i32 {
    // Dynamically auto-detect terminal resolution:
    var window = Window.open_autores("Rad 2D Physics Demo");
    var width = window.width;
    var height = window.height;

    var canvas = Canvas.new(width, height);

    var rng = Rng.new(12345678901234567u64);

    // Number of particles scaled to resolution
    var num_balls = (width * height) / 180usize;
    if num_balls < 12usize {
        num_balls = 12usize;
    }
    if num_balls > 40usize {
        num_balls = 40usize;
    }

    let ball_px = malloc(num_balls * 8usize) as *raw var i64;
    let ball_py = malloc(num_balls * 8usize) as *raw var i64;
    let ball_vx = malloc(num_balls * 8usize) as *raw var i64;
    let ball_vy = malloc(num_balls * 8usize) as *raw var i64;
    let ball_rad = malloc(num_balls * 8usize) as *raw var i64;
    let ball_cr = malloc(num_balls) as *raw var u8;
    let ball_cg = malloc(num_balls) as *raw var u8;
    let ball_cb = malloc(num_balls) as *raw var u8;

    // Initialize colored balls
    var i = 0usize;
    while i < num_balls {
        ball_cr[i] = (rng.range(60i64, 255i64)) as u8;
        ball_cg[i] = (rng.range(60i64, 255i64)) as u8;
        ball_cb[i] = (rng.range(60i64, 255i64)) as u8;

        ball_px[i] = rng.range(8i64, (width as i64) - 8i64) * 100i64;
        ball_py[i] = rng.range(4i64, (height as i64) / 2i64) * 100i64;
        ball_vx[i] = rng.range(-150i64, 150i64);
        ball_vy[i] = rng.range(-60i64, 80i64);
        ball_rad[i] = rng.range(2i64, 3i64);
        i = i + 1usize;
    }

    var gravity = 25i64;

    // Runs continuously until user presses 'q' / 'Q' / ESC
    while window.is_open() {
        let ev_opt = window.poll_event();
        match ev_opt {
            Option.Some(ev) => {
                if ev.is_close() || ev.is_key(113u8) || ev.is_key(81u8) || ev.is_key(27u8) { // 'q', 'Q', ESC
                    window.close();
                } else if ev.is_key(103u8) { // 'g' toggle gravity
                    if gravity > 0i64 { gravity = 0i64; } else { gravity = 25i64; }
                } else if ev.is_key(114u8) { // 'r' scramble
                    i = 0usize;
                    while i < num_balls {
                        ball_vx[i] = rng.range(-180i64, 180i64);
                        ball_vy[i] = rng.range(-220i64, -40i64);
                        i = i + 1usize;
                    }
                }
            },
            Option.None => {},
            _ => {},
        }

        if !window.is_open() {
            break;
        }

        // Dynamically adjust on terminal resize
        if window.check_resize() {
            width = window.width;
            height = window.height;
            canvas.destroy();
            canvas = Canvas.new(width, height);
        }

        canvas.clear(Color.rgb(8u8, 10u8, 18u8)); // Dark navy background

        // Draw boundary box around arena
        canvas.draw_rect(0usize, 0usize, width, height, Color.rgb(50u8, 70u8, 110u8));

        // Physics step & rendering
        i = 0usize;
        while i < num_balls {
            // Apply gravity
            ball_vy[i] = ball_vy[i] + gravity;

            // Update position
            ball_px[i] = ball_px[i] + ball_vx[i];
            ball_py[i] = ball_py[i] + ball_vy[i];

            let cur_x = ball_px[i] / 100i64;
            let cur_y = ball_py[i] / 100i64;
            let rad = ball_rad[i];

            // Left / right wall bounce with restitution damping
            if cur_x - rad < 1i64 {
                ball_px[i] = (1i64 + rad) * 100i64;
                ball_vx[i] = (-ball_vx[i] * 85i64) / 100i64;
            } else if cur_x + rad >= (width as i64) - 1i64 {
                ball_px[i] = ((width as i64) - 2i64 - rad) * 100i64;
                ball_vx[i] = (-ball_vx[i] * 85i64) / 100i64;
            }

            // Floor / ceiling bounce
            if cur_y - rad < 1i64 {
                ball_py[i] = (1i64 + rad) * 100i64;
                ball_vy[i] = -ball_vy[i];
            } else if cur_y + rad >= (height as i64) - 1i64 {
                ball_py[i] = ((height as i64) - 2i64 - rad) * 100i64;
                ball_vy[i] = (-ball_vy[i] * 82i64) / 100i64;
                // Floor friction
                ball_vx[i] = (ball_vx[i] * 96i64) / 100i64;
            }

            // Render ball
            let draw_x = ball_px[i] / 100i64;
            let draw_y = ball_py[i] / 100i64;
            let ball_col = Color.rgb(ball_cr[i], ball_cg[i], ball_cb[i]);
            canvas.fill_circle(draw_x, draw_y, rad, ball_col);

            // Glowing center highlight
            canvas.set_pixel(draw_x as usize, draw_y as usize, Color.white());

            i = i + 1usize;
        }

        window.draw_canvas(canvas);
        Window.sleep_frame(60u64);
    }

    free(ball_px as *raw var u8);
    free(ball_py as *raw var u8);
    free(ball_vx as *raw var u8);
    free(ball_vy as *raw var u8);
    free(ball_rad as *raw var u8);
    free(ball_cr);
    free(ball_cg);
    free(ball_cb);
    canvas.destroy();
    window.close();

    println("Physics simulation finished successfully!");
    return 0;
}
