// ==============================================================================
// Rad Graphics Demo 4: 3D TrueColor Raycaster Engine (Wolfenstein / Doom Style)
// Pure-Rad 2.5D Real-Time DDA Raycaster running at 60 FPS in the terminal.
// Features: Texture mapping, depth fog lighting, floor/ceiling gradients,
//           real-time 2D minimap with FOV cone, wall sliding collisions & TUI menu.
// Controls: [W/S] or [Up/Down] Move, [A/D] Strafe, [Left/Right] Rotate,
//           [Space] Sprint, [M] Toggle Minimap, [S] Settings Menu, [Q] Quit.
// ==============================================================================

import gfx;

// Constants & Native Math Primitives
fn rad_pi() -> f64 { return 3.141592653589793; }
fn rad_two_pi() -> f64 { return 6.283185307179586; }
fn rad_half_pi() -> f64 { return 1.5707963267948966; }

fn rad_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn rad_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0; }
    var guess: f64 = x;
    var i = 0;
    while i < 12 {
        guess = 0.5 * (guess + (x / guess));
        i = i + 1;
    }
    return guess;
}

fn rad_sin(x_in: f64) -> f64 {
    var x = x_in;
    let pi_val = rad_pi();
    let two_pi_val = rad_two_pi();
    let half_pi_val = rad_half_pi();
    while x > pi_val { x = x - two_pi_val; }
    while x < (0.0 - pi_val) { x = x + two_pi_val; }
    if x > half_pi_val {
        x = pi_val - x;
    } else if x < (0.0 - half_pi_val) {
        x = (0.0 - pi_val) - x;
    }
    let x2 = x * x;
    let t1 = x;
    let t3 = (t1 * x2) / 6.0;
    let t5 = (t3 * x2) / 20.0;
    let t7 = (t5 * x2) / 42.0;
    let t9 = (t7 * x2) / 72.0;
    return ((t1 - t3) + t5) - (t7 - t9);
}

fn rad_cos(x: f64) -> f64 {
    return rad_sin(x + rad_half_pi());
}

fn rad_fract(x: f64) -> f64 {
    var int_part = (x as i64) as f64;
    if x < int_part {
        int_part = int_part - 1.0;
    }
    return x - int_part;
}



// -----------------------------------------------------------------------------
// Maze Configuration (24 x 24 layout)
// -----------------------------------------------------------------------------
const MAP_W: usize = 24usize;
const MAP_H: usize = 24usize;

// Wall Types
const WALL_NONE: u8    = 0u8;
const WALL_CYBER: u8   = 1u8; // Titanium Slate + Glowing Cyan Traces
const WALL_BRICK: u8   = 2u8; // Red Terracotta Brick with Mortar Seams
const WALL_STONE: u8   = 3u8; // Granite Block with Emerald Moss
const WALL_WOOD: u8    = 4u8; // Cedar Wood Panels
const WALL_HAZARD: u8  = 5u8; // Yellow & Black Caution Hazard Stripes

fn init_maze_map() -> *raw var u8 {
    let total = MAP_W * MAP_H;
    let m = malloc(total) as *raw var u8;
    var i = 0usize;
    while i < total {
        m[i] = WALL_NONE;
        i = i + 1usize;
    }

    // Outer perimeter: Cyber titanium
    var x = 0usize;
    while x < MAP_W {
        m[x] = WALL_CYBER;
        m[((MAP_H - 1usize) * MAP_W) + x] = WALL_CYBER;
        x = x + 1usize;
    }
    var y = 0usize;
    while y < MAP_H {
        m[y * MAP_W] = WALL_CYBER;
        m[(y * MAP_W) + (MAP_W - 1usize)] = WALL_CYBER;
        y = y + 1usize;
    }

    // Central Courtyard Pillars (Hazard Caution)
    m[(10usize * MAP_W) + 10usize] = WALL_HAZARD;
    m[(10usize * MAP_W) + 13usize] = WALL_HAZARD;
    m[(13usize * MAP_W) + 10usize] = WALL_HAZARD;
    m[(13usize * MAP_W) + 13usize] = WALL_HAZARD;

    // West Sector: Red Brick Corridors
    y = 2usize;
    while y <= 8usize {
        m[(y * MAP_W) + 5usize] = WALL_BRICK;
        y = y + 1usize;
    }
    x = 2usize;
    while x <= 5usize {
        m[(5usize * MAP_W) + x] = WALL_BRICK;
        x = x + 1usize;
    }

    // North Sector: Mossy Stone Hallway
    x = 8usize;
    while x <= 18usize {
        if x != 12usize && x != 13usize {
            m[(4usize * MAP_W) + x] = WALL_STONE;
        }
        x = x + 1usize;
    }
    y = 2usize;
    while y <= 6usize {
        m[(y * MAP_W) + 8usize] = WALL_STONE;
        m[(y * MAP_W) + 18usize] = WALL_STONE;
        y = y + 1usize;
    }

    // East Sector: Wood Panel Archives
    y = 7usize;
    while y <= 16usize {
        if y != 11usize && y != 12usize {
            m[(y * MAP_W) + 19usize] = WALL_WOOD;
        }
        y = y + 1usize;
    }
    x = 15usize;
    while x <= 21usize {
        if x != 18usize {
            m[(9usize * MAP_W) + x] = WALL_WOOD;
            m[(14usize * MAP_W) + x] = WALL_WOOD;
        }
        x = x + 1usize;
    }

    // South Sector: Tech Control Rooms (Cyber Titanium)
    x = 4usize;
    while x <= 16usize {
        if x != 9usize && x != 10usize {
            m[(17usize * MAP_W) + x] = WALL_CYBER;
        }
        x = x + 1usize;
    }
    y = 17usize;
    while y <= 21usize {
        m[(y * MAP_W) + 4usize] = WALL_CYBER;
        m[(y * MAP_W) + 16usize] = WALL_CYBER;
        y = y + 1usize;
    }
    m[(19usize * MAP_W) + 10usize] = WALL_HAZARD;

    return m;
}

// -----------------------------------------------------------------------------
// Texture Atlas (5 textures x 16 x 16 RGB pixels)
// -----------------------------------------------------------------------------
const TEX_SIZE: usize = 16usize;
const NUM_TEX: usize = 5usize;

fn init_texture_atlas() -> *raw var u8 {
    // 5 textures * 16 * 16 * 3 bytes (RGB)
    let total_bytes = NUM_TEX * TEX_SIZE * TEX_SIZE * 3usize;
    let atlas = malloc(total_bytes) as *raw var u8;

    var tex_id = 0usize;
    while tex_id < NUM_TEX {
        var ty = 0usize;
        while ty < TEX_SIZE {
            var tx = 0usize;
            while tx < TEX_SIZE {
                let p_idx = ((tex_id * TEX_SIZE * TEX_SIZE) + (ty * TEX_SIZE) + tx) * 3usize;
                var r = 0u8;
                var g = 0u8;
                var b = 0u8;

                if tex_id == 0usize {
                    // Texture 1: Cyber Titanium Slate with Neon Cyan Circuit Traces
                    r = 26u8; g = 32u8; b = 44u8; // Dark slate
                    if tx == 0usize || tx == 15usize || ty == 0usize || ty == 15usize {
                        r = 65u8; g = 80u8; b = 105u8; // Titanium edge bevel
                    } else if ty == 7usize || tx == 8usize {
                        r = 20u8; g = 220u8; b = 255u8; // Glowing neon cyan circuit line
                    } else if (tx >= 6usize && tx <= 9usize) && (ty >= 5usize && ty <= 8usize) {
                        r = 180u8; g = 250u8; b = 255u8; // Glowing center microprocessor
                    }
                } else if tex_id == 1usize {
                    // Texture 2: Terracotta Red Brick with Mortar Seams
                    let is_horiz_mortar = (ty == 0usize || ty == 7usize || ty == 15usize);
                    var is_vert_mortar = false;
                    if ty < 7usize {
                        if tx == 0usize || tx == 15usize { is_vert_mortar = true; }
                    } else if ty > 7usize && ty < 15usize {
                        if tx == 7usize || tx == 8usize { is_vert_mortar = true; }
                    }
                    if is_horiz_mortar || is_vert_mortar {
                        r = 95u8; g = 90u8; b = 85u8; // Cement mortar
                    } else {
                        // Brick texture variation
                        let grain = ((tx * 7usize + ty * 13usize) % 25usize) as u8;
                        r = 180u8 + grain;
                        g = 55u8 + (grain / 2u8);
                        b = 40u8;
                    }
                } else if tex_id == 2usize {
                    // Texture 3: Granite Stone Block with Emerald Moss
                    let is_block_border = (tx == 0usize || tx == 15usize || ty == 0usize || ty == 15usize);
                    if is_block_border {
                        r = 50u8; g = 55u8; b = 60u8; // Dark grout
                    } else {
                        let is_moss = (ty >= 9usize && ((tx + ty) % 3usize == 0usize || tx % 4usize == 0usize));
                        if is_moss {
                            r = 45u8; g = 150u8; b = 60u8; // Emerald moss
                        } else {
                            let stone_var = ((tx * 11usize + ty * 17usize) % 30usize) as u8;
                            r = 115u8 + stone_var;
                            g = 120u8 + stone_var;
                            b = 130u8 + stone_var;
                        }
                    }
                } else if tex_id == 3usize {
                    // Texture 4: Cedar Wood Planks
                    let is_seam = (tx == 0usize || tx == 5usize || tx == 10usize || tx == 15usize);
                    if is_seam {
                        r = 60u8; g = 38u8; b = 18u8; // Dark plank seam
                    } else {
                        let grain = ((tx * 3usize + ty * 9usize) % 20usize) as u8;
                        r = 145u8 + grain;
                        g = 95u8 + (grain / 2u8);
                        b = 50u8;
                    }
                } else if tex_id == 4usize {
                    // Texture 5: Hazard Caution Stripes (Yellow & Black)
                    if (tx + ty) % 6usize < 3usize {
                        r = 245u8; g = 215u8; b = 25u8; // Hazard Yellow
                    } else {
                        r = 25u8; g = 25u8; b = 28u8;   // Carbon Black
                    }
                }

                atlas[p_idx] = r;
                atlas[p_idx + 1usize] = g;
                atlas[p_idx + 2usize] = b;

                tx = tx + 1usize;
            }
            ty = ty + 1usize;
        }
        tex_id = tex_id + 1usize;
    }

    return atlas;
}

// -----------------------------------------------------------------------------
// Engine Settings State
// -----------------------------------------------------------------------------
struct EngineSettings {
    pub fov_deg: i64,      // 45 to 90 degrees
    pub fog_dist: f64,     // 6.0 to 20.0 meters
    pub speed_level: i64,  // 0: Slow (0.7x), 1: Normal (1.0x), 2: Fast (1.4x)
    pub show_minimap: bool,
}

impl EngineSettings {
    pub fn default() -> EngineSettings {
        return EngineSettings {
            fov_deg: 66i64,
            fog_dist: 13.0,
            speed_level: 1i64,
            show_minimap: true,
        };
    }

    pub fn get_fov_rad(self) -> f64 {
        return (self.fov_deg as f64) * (rad_pi() / 180.0);
    }

    pub fn get_move_speed(self) -> f64 {
        if self.speed_level == 0i64 { return 0.035; }
        if self.speed_level == 2i64 { return 0.075; }
        return 0.050;
    }

    pub fn speed_name(self) -> str {
        if self.speed_level == 0i64 { return "0.7x (Slow)"; }
        if self.speed_level == 2i64 { return "1.4x (Fast)"; }
        return "1.0x (Normal)";
    }
}

// -----------------------------------------------------------------------------
// Player Collision & Movement
// -----------------------------------------------------------------------------
fn is_maze_wall(map: *raw var u8, gx: i32, gy: i32) -> bool {
    if gx < 0 || gx >= (MAP_W as i32) || gy < 0 || gy >= (MAP_H as i32) {
        return true;
    }
    let cell = map[(gy as usize) * MAP_W + (gx as usize)];
    return cell > 0u8;
}

// -----------------------------------------------------------------------------
// Main Entry Point
// -----------------------------------------------------------------------------
pub fn main() -> i32 {
    var window = Window.open_autores("Rad 3D Raycaster Engine");

    // Proper half-block resolution: terminal rows - 2 gives exact fit with Row 1 HUD
    var canvas_w = window.width;
    var canvas_h = 44usize;
    if window.rows > 2usize {
        canvas_h = (window.rows - 2usize) * 2usize;
    }
    if canvas_h < 24usize { canvas_h = 24usize; }
    if canvas_w < 40usize { canvas_w = 40usize; }
    var canvas = Canvas.new(canvas_w, canvas_h);

    let map = init_maze_map();
    let tex_atlas = init_texture_atlas();
    var settings = EngineSettings.default();

    // Player initial state
    var pos_x: f64 = 2.5;
    var pos_y: f64 = 2.5;
    var angle: f64 = 0.0; // Facing east
    let rot_speed: f64 = 0.035; // Calibrated smooth camera turning

    // Professional shooter movement & camera controller (Quake/Source style)
    var fps_ctrl = FpsController.new(settings.get_move_speed(), rot_speed);

    var in_menu = false;
    var menu_selected = 0i64; // 0: FOV, 1: Fog, 2: Speed, 3: Minimap, 4: Resume, 5: Quit
    var menu_cooldown: u64 = 0u64;

    // Frame timing
    var frame_count = 0u64;

    var running = true;
    while running && window.is_open() {
        frame_count = frame_count + 1u64;

        // Auto-handle terminal resize dynamically
        if window.check_resize() {
            canvas_w = window.width;
            canvas_h = 44usize;
            if window.rows > 2usize {
                canvas_h = (window.rows - 2usize) * 2usize;
            }
            if canvas_h < 24usize { canvas_h = 24usize; }
            if canvas_w < 40usize { canvas_w = 40usize; }
            canvas.destroy();
            canvas = Canvas.new(canvas_w, canvas_h);
        }

        // Process discrete input events (menu, toggles, quit)
        var has_more_events = true;
        while has_more_events {
            let ev_opt = window.poll_event();
            match ev_opt {
                Option.Some(ev) => {
                    if ev.is_close() || ev.is_key(113u8) || ev.is_key(81u8) {
                        running = false;
                        window.close();
                        break;
                    }

                    if in_menu {
                        if ev.is_up() {
                            if frame_count >= menu_cooldown {
                                menu_selected = menu_selected - 1i64;
                                if menu_selected < 0i64 { menu_selected = 5i64; }
                                menu_cooldown = frame_count + 6u64;
                            }
                        } else if ev.is_down() {
                            if frame_count >= menu_cooldown {
                                menu_selected = menu_selected + 1i64;
                                if menu_selected > 5i64 { menu_selected = 0i64; }
                                menu_cooldown = frame_count + 6u64;
                            }
                        } else if ev.is_left() {
                            if frame_count >= menu_cooldown {
                                if menu_selected == 0i64 {
                                    if settings.fov_deg > 45i64 { settings.fov_deg = settings.fov_deg - 5i64; }
                                } else if menu_selected == 1i64 {
                                    if settings.fog_dist > 6.0 { settings.fog_dist = settings.fog_dist - 1.0; }
                                } else if menu_selected == 2i64 {
                                    settings.speed_level = settings.speed_level - 1i64;
                                    if settings.speed_level < 0i64 { settings.speed_level = 2i64; }
                                } else if menu_selected == 3i64 {
                                    settings.show_minimap = !settings.show_minimap;
                                }
                                menu_cooldown = frame_count + 6u64;
                            }
                        } else if ev.is_right() {
                            if frame_count >= menu_cooldown {
                                if menu_selected == 0i64 {
                                    if settings.fov_deg < 90i64 { settings.fov_deg = settings.fov_deg + 5i64; }
                                } else if menu_selected == 1i64 {
                                    if settings.fog_dist < 20.0 { settings.fog_dist = settings.fog_dist + 1.0; }
                                } else if menu_selected == 2i64 {
                                    settings.speed_level = settings.speed_level + 1i64;
                                    if settings.speed_level > 2i64 { settings.speed_level = 0i64; }
                                } else if menu_selected == 3i64 {
                                    settings.show_minimap = !settings.show_minimap;
                                }
                                menu_cooldown = frame_count + 6u64;
                            }
                        } else if ev.is_key(10u8) || ev.is_key(13u8) { // Enter
                            if menu_selected == 4i64 {
                                in_menu = false;
                            } else if menu_selected == 5i64 {
                                running = false;
                                window.close();
                                break;
                            } else if menu_selected == 3i64 {
                                settings.show_minimap = !settings.show_minimap;
                            }
                        } else if ev.is_key(112u8) || ev.is_key(80u8) || ev.is_key(27u8) { // 'p', Esc
                            in_menu = false;
                        }
                    } else {
                        if ev.is_key(109u8) || ev.is_key(77u8) { // 'm', 'M' (Toggle minimap)
                            settings.show_minimap = !settings.show_minimap;
                        } else if ev.is_key(112u8) || ev.is_key(80u8) || ev.is_key(111u8) || ev.is_key(79u8) { // 'p', 'P', 'o', 'O'
                            in_menu = true;
                            menu_selected = 0i64;
                        } else {
                            fps_ctrl.handle_event(ev, frame_count);
                        }
                    }
                },
                Option.None => {
                    has_more_events = false;
                }
            }
        }

        if !running || !window.is_open() {
            break;
        }

        // Continuous Player Movement Physics (Simultaneous WASD + Arrow Keys via FpsController)
        if !in_menu {
            fps_ctrl.move_speed = settings.get_move_speed();
            fps_ctrl.turn_speed = rot_speed;
            fps_ctrl.update(window, frame_count);

            let vel_forward = fps_ctrl.vel_forward;
            let vel_strafe = fps_ctrl.vel_strafe;
            let vel_turn = fps_ctrl.vel_turn;

            if rad_abs(vel_turn) > 0.0001 {
                angle = angle + vel_turn;
                let two_pi_val = rad_two_pi();
                while angle >= two_pi_val { angle = angle - two_pi_val; }
                while angle < 0.0 { angle = angle + two_pi_val; }
            }

            if rad_abs(vel_forward) > 0.0001 || rad_abs(vel_strafe) > 0.0001 {
                let forward_dx = rad_cos(angle) * vel_forward;
                let forward_dy = rad_sin(angle) * vel_forward;
                let strafe_dx = rad_cos(angle + rad_half_pi()) * vel_strafe;
                let strafe_dy = rad_sin(angle + rad_half_pi()) * vel_strafe;

                let dx = forward_dx + strafe_dx;
                let dy = forward_dy + strafe_dy;
                let margin = 0.22;

                var check_x = pos_x + dx;
                if dx > 0.0 { check_x = check_x + margin; } else { check_x = check_x - margin; }
                if !is_maze_wall(map, check_x as i32, pos_y as i32) {
                    pos_x = pos_x + dx;
                }

                var check_y = pos_y + dy;
                if dy > 0.0 { check_y = check_y + margin; } else { check_y = check_y - margin; }
                if !is_maze_wall(map, pos_x as i32, check_y as i32) {
                    pos_y = pos_y + dy;
                }
            }
        }

        // ---------------------------------------------------------------------
        // Render 3D DDA Raycaster Scene
        // ---------------------------------------------------------------------
        let fov = settings.get_fov_rad();
        let half_fov = fov * 0.5;
        let horizon = canvas_h / 2usize;
        let fog_max = settings.fog_dist;

        // Render each vertical screen column
        var col = 0usize;
        while col < canvas_w {
            let col_ratio = (col as f64) / (canvas_w as f64);
            let ray_angle = (angle - half_fov) + (col_ratio * fov);

            let ray_dir_x = rad_cos(ray_angle);
            let ray_dir_y = rad_sin(ray_angle);

            // DDA Setup
            var map_x = pos_x as i32;
            var map_y = pos_y as i32;

            var delta_dist_x = 1000000.0;
            if rad_abs(ray_dir_x) > 0.00001 {
                delta_dist_x = rad_abs(1.0 / ray_dir_x);
            }
            var delta_dist_y = 1000000.0;
            if rad_abs(ray_dir_y) > 0.00001 {
                delta_dist_y = rad_abs(1.0 / ray_dir_y);
            }

            var step_x = 0;
            var side_dist_x: f64 = 0.0;
            if ray_dir_x < 0.0 {
                step_x = 0 - 1;
                side_dist_x = (pos_x - (map_x as f64)) * delta_dist_x;
            } else {
                step_x = 1;
                side_dist_x = (((map_x as f64) + 1.0) - pos_x) * delta_dist_x;
            }

            var step_y = 0;
            var side_dist_y: f64 = 0.0;
            if ray_dir_y < 0.0 {
                step_y = 0 - 1;
                side_dist_y = (pos_y - (map_y as f64)) * delta_dist_y;
            } else {
                step_y = 1;
                side_dist_y = (((map_y as f64) + 1.0) - pos_y) * delta_dist_y;
            }

            // Perform DDA
            var hit = false;
            var side = 0; // 0 = NS, 1 = EW
            var hit_type = 1usize;
            var dist_traveled = 0;

            while !hit && dist_traveled < 28 {
                if side_dist_x < side_dist_y {
                    side_dist_x = side_dist_x + delta_dist_x;
                    map_x = map_x + step_x;
                    side = 0;
                } else {
                    side_dist_y = side_dist_y + delta_dist_y;
                    map_y = map_y + step_y;
                    side = 1;
                }

                if map_x >= 0 && map_x < (MAP_W as i32) && map_y >= 0 && map_y < (MAP_H as i32) {
                    let cell = map[(map_y as usize) * MAP_W + (map_x as usize)];
                    if cell > 0u8 {
                        hit = true;
                        hit_type = cell as usize;
                    }
                } else {
                    hit = true;
                    hit_type = 1usize;
                }
                dist_traveled = dist_traveled + 1;
            }

            var rdx = ray_dir_x;
            if rad_abs(rdx) < 0.0001 {
                if rdx < 0.0 { rdx = -0.0001; } else { rdx = 0.0001; }
            }
            var rdy = ray_dir_y;
            if rad_abs(rdy) < 0.0001 {
                if rdy < 0.0 { rdy = -0.0001; } else { rdy = 0.0001; }
            }

            // Perpendicular Wall Distance (correcting fisheye)
            var perp_dist: f64 = 1.0;
            if side == 0 {
                perp_dist = ((map_x as f64) - pos_x + ((1.0 - (step_x as f64)) * 0.5)) / rdx;
            } else {
                perp_dist = ((map_y as f64) - pos_y + ((1.0 - (step_y as f64)) * 0.5)) / rdy;
            }
            if perp_dist < 0.12 { perp_dist = 0.12; }

            // Fisheye correction factor
            var corrected_dist = perp_dist * rad_cos(ray_angle - angle);
            if corrected_dist < 0.05 { corrected_dist = 0.05; }

            // Wall height on canvas
            let line_height_f = ((canvas_h as f64) * 0.95) / corrected_dist;
            var line_height = line_height_f as i64;
            if line_height < 1i64 { line_height = 1i64; }

            let draw_start = ((canvas_h as i64) - line_height) / 2i64;
            let draw_end = draw_start + line_height;

            // Texture X coordinate calculation
            var wall_x: f64 = 0.0;
            if side == 0 {
                wall_x = pos_y + (perp_dist * ray_dir_y);
            } else {
                wall_x = pos_x + (perp_dist * ray_dir_x);
            }
            wall_x = rad_fract(wall_x);

            var tex_x = (wall_x * 16.0) as usize;
            if tex_x >= 16usize { tex_x = 15usize; }
            if (side == 0 && ray_dir_x > 0.0) || (side == 1 && ray_dir_y < 0.0) {
                tex_x = 15usize - tex_x;
            }

            // Distance Fog & Shading
            var fog_factor = 1.0 - (perp_dist / fog_max);
            if fog_factor < 0.0 { fog_factor = 0.0; }
            if fog_factor > 1.0 { fog_factor = 1.0; }

            // Directional Wall Shadow: EW walls are 25% darker
            if side == 1 {
                fog_factor = fog_factor * 0.75;
            }

            let tex_offset = (hit_type - 1usize) * TEX_SIZE * TEX_SIZE;

            // Draw Column Pixels
            var y = 0usize;
            while y < canvas_h {
                let yi = y as i64;
                if yi < draw_start {
                    // Ceiling: Cosmic midnight gradient
                    var horiz_f = horizon as f64;
                    if horiz_f < 1.0 { horiz_f = 1.0; }
                    let ceil_ratio = (y as f64) / horiz_f;
                    let cr = (14.0 + (ceil_ratio * 14.0)) as u8;
                    let cg = (18.0 + (ceil_ratio * 16.0)) as u8;
                    let cb = (32.0 + (ceil_ratio * 16.0)) as u8;
                    canvas.set_pixel_rgb(col, y, cr, cg, cb);
                } else if yi <= draw_end {
                    // Wall Texture Pixel
                    var tex_y = (((yi - draw_start) * 16i64) / line_height) as usize;
                    if tex_y >= 16usize { tex_y = 15usize; }

                    let p_idx = (tex_offset + (tex_y * TEX_SIZE) + tex_x) * 3usize;
                    let base_r = tex_atlas[p_idx] as f64;
                    let base_g = tex_atlas[p_idx + 1usize] as f64;
                    let base_b = tex_atlas[p_idx + 2usize] as f64;

                    // Blend with deep obsidian fog (12, 16, 26)
                    let final_r = ((base_r * fog_factor) + (12.0 * (1.0 - fog_factor))) as u8;
                    let final_g = ((base_g * fog_factor) + (16.0 * (1.0 - fog_factor))) as u8;
                    let final_b = ((base_b * fog_factor) + (26.0 * (1.0 - fog_factor))) as u8;

                    canvas.set_pixel_rgb(col, y, final_r, final_g, final_b);
                } else {
                    // Floor: Tiled stone pavement gradient
                    var dy = (y as f64) - (horizon as f64);
                    if dy < 1.0 { dy = 1.0; }
                    let floor_dist = ((canvas_h as f64) * 0.5) / dy;
                    var floor_fog = 1.0 - (floor_dist / fog_max);
                    if floor_fog < 0.0 { floor_fog = 0.0; }
                    if floor_fog > 1.0 { floor_fog = 1.0; }

                    let fr = (18.0 + (floor_fog * 18.0)) as u8;
                    let fg = (22.0 + (floor_fog * 20.0)) as u8;
                    let fb = (32.0 + (floor_fog * 22.0)) as u8;
                    canvas.set_pixel_rgb(col, y, fr, fg, fb);
                }

                y = y + 1usize;
            }

            col = col + 1usize;
        }

        // ---------------------------------------------------------------------
        // Render 2D Minimap Overlay (Top-Right Corner)
        // ---------------------------------------------------------------------
        if settings.show_minimap && canvas_w >= 50usize && canvas_h >= 24usize {
            var map_scale = 1usize;
            if canvas_w >= 120usize && canvas_h >= 64usize {
                map_scale = 2usize;
            }
            let mm_w = MAP_W * map_scale;
            let mm_h = MAP_H * map_scale;
            let mm_x = canvas_w - mm_w - 2usize;
            let mm_y = 1usize;

            // Minimap border & background
            canvas.fill_rect_rgb(mm_x, mm_y, mm_w, mm_h, 10u8, 14u8, 22u8);
            canvas.draw_rect_rgb(mm_x, mm_y, mm_w, mm_h, 65u8, 90u8, 125u8);

            // Draw maze walls
            var my = 0usize;
            while my < MAP_H {
                var mx = 0usize;
                while mx < MAP_W {
                    let cell = map[(my * MAP_W) + mx];
                    if cell > 0u8 {
                        var wr = 80u8;
                        var wg = 90u8;
                        var wb = 110u8;
                        if cell == WALL_CYBER {
                            wr = 20u8; wg = 180u8; wb = 230u8; // Cyan
                        } else if cell == WALL_BRICK {
                            wr = 200u8; wg = 65u8; wb = 45u8;  // Red
                        } else if cell == WALL_STONE {
                            wr = 55u8; wg = 170u8; wb = 75u8;  // Mossy Green
                        } else if cell == WALL_WOOD {
                            wr = 160u8; wg = 105u8; wb = 55u8; // Cedar
                        } else if cell == WALL_HAZARD {
                            wr = 240u8; wg = 210u8; wb = 30u8; // Yellow
                        }
                        canvas.fill_rect_rgb(mm_x + (mx * map_scale), mm_y + (my * map_scale), map_scale, map_scale, wr, wg, wb);
                    }
                    mx = mx + 1usize;
                }
                my = my + 1usize;
            }

            // Draw player position & FOV cone
            let p_pixel_x = mm_x + ((pos_x * (map_scale as f64)) as usize);
            let p_pixel_y = mm_y + ((pos_y * (map_scale as f64)) as usize);

            // Draw 5 FOV rays on minimap
            var ri = 0i64;
            while ri < 5i64 {
                let ray_frac = (ri as f64) / 4.0;
                let c_ray_angle = (angle - half_fov) + (ray_frac * fov);
                let ray_len = 3.5 * (map_scale as f64);
                let end_rx = (p_pixel_x as f64) + (rad_cos(c_ray_angle) * ray_len);
                let end_ry = (p_pixel_y as f64) + (rad_sin(c_ray_angle) * ray_len);
                canvas.draw_line_rgb(p_pixel_x as i64, p_pixel_y as i64, end_rx as i64, end_ry as i64, 90u8, 190u8, 255u8);
                ri = ri + 1i64;
            }

            // Draw player beacon dot
            if map_scale > 1usize {
                canvas.fill_rect_rgb(p_pixel_x - 1usize, p_pixel_y - 1usize, 3usize, 3usize, 120u8, 255u8, 120u8);
            } else {
                canvas.set_pixel_rgb(p_pixel_x, p_pixel_y, 120u8, 255u8, 120u8);
            }
        }

        // ---------------------------------------------------------------------
        // Render Settings Modal Overlay (Background Box on Canvas)
        // ---------------------------------------------------------------------
        var menu_x = 2usize;
        var menu_y = 1usize;
        let menu_w = 48usize;
        let menu_h = 24usize;
        if in_menu {
            if canvas_w > menu_w { menu_x = (canvas_w - menu_w) / 2usize; }
            if canvas_h > menu_h { menu_y = (canvas_h - menu_h) / 2usize; }

            // Semi-transparent dark slate dialog with cyan border
            canvas.fill_rect_rgb(menu_x, menu_y, menu_w, menu_h, 14u8, 18u8, 28u8);
            canvas.draw_rect_rgb(menu_x, menu_y, menu_w, menu_h, 0u8, 210u8, 255u8);
            canvas.draw_rect_rgb(menu_x + 1usize, menu_y + 1usize, menu_w - 2usize, menu_h - 2usize, 30u8, 60u8, 90u8);
        }

        // ---------------------------------------------------------------------
        // Render Row 1 Dedicated HUD (Zero-Flicker ANSI Status Line)
        // ---------------------------------------------------------------------
        var hud = String.new();
        hud.push_str("\x1b[1;44;97m RAD 3D ENGINE \x1b[0m ");
        hud.push_str("\x1b[1;36mPOS:\x1b[0m (");
        push_f64_str(hud, pos_x, 1usize);
        hud.push_str(", ");
        push_f64_str(hud, pos_y, 1usize);
        hud.push_str(") ");

        let deg = ((angle * 180.0) / rad_pi()) as i64;
        hud.push_str("\x1b[1;33mDIR:\x1b[0m ");
        push_i64_str(hud, deg);
        hud.push_str("° ");

        hud.push_str("\x1b[1;32mFOV:\x1b[0m ");
        push_i64_str(hud, settings.fov_deg);
        hud.push_str("° ");

        hud.push_str("\x1b[1;35mFOG:\x1b[0m ");
        push_f64_str(hud, settings.fog_dist, 1usize);
        hud.push_str("m ");

        hud.push_str("\x1b[90m| [WASD] Move [←/→] Look [Space] Boost [M] Map [P] Settings [Q] Quit\x1b[0m");

        // Present Canvas starting at terminal row 2 down with atomic header (zero flicker)
        window.draw_canvas_with_header(hud.as_ptr() as str, canvas);
        hud.drop();

        // Render Crisp Overlay Text for Settings Modal
        if in_menu {
            let r0 = 2usize + (menu_y / 2usize);
            let c0 = 1usize + menu_x;
            var ov = window.begin_overlay();

            // Dialog Title (centered)
            ov = window.add_overlay_text(ov, r0 + 1usize, c0 + 13usize, "RAD 3D ENGINE SETTINGS", 0u8, 240u8, 255u8, 20u8, 45u8, 75u8);

            // Option 0: Field of View
            var fov_r = 180u8; var fov_g = 190u8; var fov_b = 205u8;
            if menu_selected == 0i64 { fov_r = 255u8; fov_g = 240u8; fov_b = 60u8; }
            var fov_s = String.from_str("1. FOV Angle:        < ");
            push_i64_str(fov_s, settings.fov_deg);
            fov_s.push_str(" deg >");
            ov = window.add_overlay_text(ov, r0 + 3usize, c0 + 6usize, fov_s.as_ptr() as str, fov_r, fov_g, fov_b, 14u8, 18u8, 28u8);
            fov_s.drop();

            // Option 1: Fog Distance
            var fog_r = 180u8; var fog_g = 190u8; var fog_b = 205u8;
            if menu_selected == 1i64 { fog_r = 255u8; fog_g = 240u8; fog_b = 60u8; }
            var fog_s = String.from_str("2. Fog Distance:     < ");
            push_f64_str(fog_s, settings.fog_dist, 1usize);
            fog_s.push_str(" m >");
            ov = window.add_overlay_text(ov, r0 + 4usize, c0 + 6usize, fog_s.as_ptr() as str, fog_r, fog_g, fog_b, 14u8, 18u8, 28u8);
            fog_s.drop();

            // Option 2: Movement Speed
            var spd_r = 180u8; var spd_g = 190u8; var spd_b = 205u8;
            if menu_selected == 2i64 { spd_r = 255u8; spd_g = 240u8; spd_b = 60u8; }
            var spd_s = String.from_str("3. Walk Speed:       < ");
            spd_s.push_str(settings.speed_name());
            spd_s.push_str(" >");
            ov = window.add_overlay_text(ov, r0 + 5usize, c0 + 6usize, spd_s.as_ptr() as str, spd_r, spd_g, spd_b, 14u8, 18u8, 28u8);
            spd_s.drop();

            // Option 3: Minimap Toggle
            var map_r = 180u8; var map_g = 190u8; var map_b = 205u8;
            if menu_selected == 3i64 { map_r = 255u8; map_g = 240u8; map_b = 60u8; }
            var map_s = String.from_str("4. Minimap Overlay:  [ ");
            if settings.show_minimap { map_s.push_str("ENABLED "); } else { map_s.push_str("DISABLED"); }
            map_s.push_str(" ]");
            ov = window.add_overlay_text(ov, r0 + 6usize, c0 + 6usize, map_s.as_ptr() as str, map_r, map_g, map_b, 14u8, 18u8, 28u8);
            map_s.drop();

            // Option 4: Resume
            var res_r = 140u8; var res_g = 150u8; var res_b = 170u8;
            if menu_selected == 4i64 { res_r = 80u8; res_g = 255u8; res_b = 120u8; }
            ov = window.add_overlay_text(ov, r0 + 8usize, c0 + 13usize, "[ RESUME (Esc/Enter) ]", res_r, res_g, res_b, 14u8, 18u8, 28u8);

            // Option 5: Exit
            var exit_r = 140u8; var exit_g = 150u8; var exit_b = 170u8;
            if menu_selected == 5i64 { exit_r = 255u8; exit_g = 80u8; exit_b = 80u8; }
            ov = window.add_overlay_text(ov, r0 + 9usize, c0 + 14usize, "[ EXIT TO TERMINAL ]", exit_r, exit_g, exit_b, 14u8, 18u8, 28u8);

            // Footer hint
            ov = window.add_overlay_text(ov, r0 + 11usize, c0 + 3usize, "[↑/↓] Select   [←/→] Adjust   [Enter] Confirm", 110u8, 140u8, 180u8, 14u8, 18u8, 28u8);

            window.flush_overlay(ov);
        }
        window.tick_input();
        Window.sleep_frame(60u64);
    }

    // Cleanup & Terminal Restoration
    free(map);
    free(tex_atlas);
    canvas.destroy();
    window.close();

    println("3D Raycaster Engine finished cleanly.");
    return 0;
}
