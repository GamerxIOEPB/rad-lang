import rad_kv

fn main() -> i32 {
    let db_path = "/tmp/test_kv_engine.kv"
    let _ = syscall1(87i64, db_path as *raw u8) // SYS_unlink

    printf("1. Opening KvStore...\n")
    var db = KvStore.open(db_path)
    if db.fd < 0i64 {
        printf("Failed to open DB\n")
        return 1
    }

    printf("2. Writing keys...\n")
    let s1 = db.set("username", "alice")
    let s2 = db.set("role", "developer")
    let s3 = db.set("language", "rad")
    if !s1 || !s2 || !s3 {
        printf("Set failed\n")
        return 1
    }

    printf("3. Reading keys...\n")
    let u = db.get("username")
    match u {
        Option.Some(val) => printf("  username = %s\n", val.as_ptr() as str),
        _ => { printf("Missing username\n"); return 1; }
    }

    printf("4. Updating key...\n")
    let _ = db.set("role", "architect")
    let r = db.get("role")
    match r {
        Option.Some(val) => printf("  updated role = %s\n", val.as_ptr() as str),
        _ => { printf("Missing role\n"); return 1; }
    }

    printf("5. Deleting key...\n")
    let _ = db.delete("language")
    if db.contains_key("language") {
        printf("Key language was not deleted\n")
        return 1
    }

    printf("6. Closing and Reopening for persistence check...\n")
    db.close()

    var db2 = KvStore.open(db_path)
    let u2 = db2.get("username")
    match u2 {
        Option.Some(val) => printf("  reopened username = %s\n", val.as_ptr() as str),
        _ => { printf("Persistence check failed for username\n"); return 1; }
    }

    let r2 = db2.get("role")
    match r2 {
        Option.Some(val) => printf("  reopened role = %s\n", val.as_ptr() as str),
        _ => { printf("Persistence check failed for role\n"); return 1; }
    }

    if db2.contains_key("language") {
        printf("Tombstone replay failed\n")
        return 1
    }

    db2.close()
    let _ = syscall1(87i64, db_path as *raw u8) // SYS_unlink
    printf("rad-kv tests PASSED successfully!\n")
    return 0
}
