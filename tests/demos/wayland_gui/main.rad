// ==============================================================================
// Rad Universal Desktop GUI: Pure-Rad Native Showcase Application (std::gui)
// 100% Pure Rad implementation with zero external C bridge files, zero
// wayland-scanner, zero libwayland-client, zero libX11.
// Automatically detects and supports Wayland and X11 display servers natively.
// Features dynamic themes, flexbox layout, interactive widgets (buttons,
// sliders, checkboxes, toggle switches, progress bars), pointer telemetry,
// and hardware-independent software rasterizer.
// ==============================================================================

extern "C" {
    fn usleep(usec: u32) -> i32;
    fn getenv(name: str) -> *raw u8;
    fn signal(sig: i32, handler: usize) -> usize;
}

import std/gui;

// ------------------------------------------------------------------------------
// Visual Themes Helper
// ------------------------------------------------------------------------------

fn get_theme(idx: i32) -> UiTheme {
    if idx == 0 {
        return UiTheme::cyberpunk();
    } else if idx == 1 {
        return UiTheme::dark();
    } else {
        return UiTheme::emerald();
    }
}

fn theme_button_label(idx: i32) -> str {
    if idx == 0 { return "Theme: Cyberpunk Neon"; }
    if idx == 1 { return "Theme: Slate Modern"; }
    return "Theme: Matrix Emerald";
}

// ------------------------------------------------------------------------------
// Geometry Helpers
// ------------------------------------------------------------------------------

fn point_in_rect(px: f32, py: f32, rx: i32, ry: i32, rw: i32, rh: i32) -> bool {
    let x0 = rx as f32;
    let y0 = ry as f32;
    let x1 = (rx + rw) as f32;
    let y1 = (ry + rh) as f32;
    return px >= x0 && px <= x1 && py >= y0 && py <= y1;
}

// ------------------------------------------------------------------------------
// Application State
// ------------------------------------------------------------------------------

pub struct AppState {
    pub width: i32,
    pub height: i32,
    pub counter: i64,
    pub auto_tick: bool,
    pub turbo_mode: bool,
    pub slider_speed: f32,
    pub theme_idx: i32,
    pub frame_count: i64,
    pub click_count: i64,
    pub hover_btn: i32,
    pub mouse_x: f32,
    pub mouse_y: f32,
    pub mouse_down: bool,
    pub last_event: str,
    pub last_key: u32,
}

impl AppState {
    pub fn new(w: i32, h: i32) -> AppState {
        return AppState {
            width: w,
            height: h,
            counter: 42i64,
            auto_tick: false,
            turbo_mode: false,
            slider_speed: 40.0,
            theme_idx: 0i32,
            frame_count: 0i64,
            click_count: 0i64,
            hover_btn: 0i32,
            mouse_x: 0.0,
            mouse_y: 0.0,
            mouse_down: false,
            last_event: "WINDOW_EVENT_INIT",
            last_key: 0u32,
        };
    }

    pub fn update_hover(var self) {
        let mx = self.mouse_x;
        let my = self.mouse_y;

        // Button 1: Increment (+ Inc) [x=44, y=260, w=115, h=34]
        // Button 2: Decrement (- Dec) [x=169, y=260, w=115, h=34]
        // Button 3: Reset (0)         [x=44, y=300, w=240, h=32]
        // Button 4: Auto-Tick Toggle  [x=214, y=340, w=70, h=24]
        // Button 5: Theme Cycle       [x=44, y=104, w=240, h=34]
        // Button 6: Close Window [X]  [x=870, y=12, w=36, h=32]
        // Button 7: Turbo Checkbox    [x=44, y=372, w=240, h=22]
        if point_in_rect(mx, my, 44, 260, 115, 34) {
            self.hover_btn = 1i32;
        } else if point_in_rect(mx, my, 169, 260, 115, 34) {
            self.hover_btn = 2i32;
        } else if point_in_rect(mx, my, 44, 300, 240, 32) {
            self.hover_btn = 3i32;
        } else if point_in_rect(mx, my, 214, 340, 70, 24) {
            self.hover_btn = 4i32;
        } else if point_in_rect(mx, my, 44, 104, 240, 34) {
            self.hover_btn = 5i32;
        } else if point_in_rect(mx, my, 870, 12, 36, 32) {
            self.hover_btn = 6i32;
        } else if point_in_rect(mx, my, 44, 372, 240, 22) {
            self.hover_btn = 7i32;
        } else {
            self.hover_btn = 0i32;
        }
    }

    pub fn handle_click(var self, var win: Window) {
        self.click_count = self.click_count + 1i64;
        let btn = self.hover_btn;
        var step = 1i64;
        if self.turbo_mode {
            step = 5i64;
        }

        if btn == 1i32 {
            self.counter = self.counter + step;
        } else if btn == 2i32 {
            self.counter = self.counter - step;
        } else if btn == 3i32 {
            self.counter = 0i64;
        } else if btn == 4i32 {
            self.auto_tick = !self.auto_tick;
        } else if btn == 5i32 {
            self.theme_idx = (self.theme_idx + 1i32) % 3i32;
        } else if btn == 6i32 {
            win.close();
        } else if btn == 7i32 {
            self.turbo_mode = !self.turbo_mode;
        }
    }

    pub fn render_frame(var self, var win: Window) {
        let theme = get_theme(self.theme_idx);

        // 1. Clear background
        win.clear(theme.bg);

        // 2. Render Top Header Bar (0, 0, width, 56)
        win.draw_rect(0, 0, self.width, 56, theme.panel_bg);
        win.draw_rect(0, 55, self.width, 1, theme.card_border);

        // Title text & subtitle
        win.draw_text(24, 12, "RAD DESKTOP GUI", theme.text_accent, 2);

        let detected = win.backend_type;
        var backend_name = "Wayland Native (KDE Plasma)";
        if detected == WINDOW_BACKEND_X11 {
            backend_name = "X11 Native (Unix Core)";
        } else if detected == WINDOW_BACKEND_HEADLESS {
            backend_name = "Headless Buffer";
        }
        win.draw_text(290, 20, backend_name, theme.text_secondary, 1);

        // Status Badges
        var badge_text = "WL-NATIVE";
        if detected == WINDOW_BACKEND_X11 {
            badge_text = "X11-NATIVE";
        }
        win.ui_badge(500, 14, badge_text, theme.card_bg, theme.text_primary);
        win.ui_badge(630, 14, "XRGB8888", theme.card_bg, theme.text_primary);
        win.ui_badge(750, 14, "60 FPS", theme.card_bg, theme.text_accent);

        // Close button [X]
        var close_bg = theme.btn_bg;
        if self.hover_btn == 6i32 {
            close_bg = 0xEE3344u32; // bright red on hover
        }
        win.draw_rect_rounded(870, 12, 36, 32, 4, close_bg);
        win.draw_text(882, 20, "X", 0xFFFFFFu32, 1);

        // 3. Left Control Panel (24, 76, 280, 550)
        win.ui_panel(24, 76, 280, 550, "CONTROL PANEL", theme);

        // Theme Switcher Button
        let theme_label = theme_button_label(self.theme_idx);
        let is_hover5 = self.hover_btn == 5i32;
        let is_down5 = is_hover5 && self.mouse_down;
        win.ui_button_styled(44, 104, 240, 34, theme_label, is_hover5, is_down5, theme);

        // Section: Reactive Counter
        win.draw_text(44, 150, "REACTIVE COUNTER", theme.text_secondary, 1);
        win.ui_card(44, 170, 240, 78, theme);
        let cnt_w = win.i64_width(self.counter, 3);
        let cnt_x = 44 + (240 - cnt_w) / 2;
        win.draw_i64(cnt_x, 186, self.counter, theme.text_accent, 3);

        // Counter Buttons
        let is_hover1 = self.hover_btn == 1i32;
        let is_down1 = is_hover1 && self.mouse_down;
        win.ui_button_styled(44, 260, 115, 34, "+ Inc", is_hover1, is_down1, theme);

        let is_hover2 = self.hover_btn == 2i32;
        let is_down2 = is_hover2 && self.mouse_down;
        win.ui_button_styled(169, 260, 115, 34, "- Dec", is_hover2, is_down2, theme);

        let is_hover3 = self.hover_btn == 3i32;
        let is_down3 = is_hover3 && self.mouse_down;
        win.ui_button_styled(44, 300, 240, 32, "Reset (0)", is_hover3, is_down3, theme);

        // Toggle Switch for Auto-Tick
        win.draw_text(44, 344, "Auto-Tick Loop", theme.text_primary, 1);
        win.ui_toggle(214, 340, 70, 24, self.auto_tick, theme);

        // Checkbox for Turbo Mode
        var check_label = "Turbo Step (+1)";
        if self.turbo_mode { check_label = "Turbo Step (+5)"; }
        win.ui_checkbox(44, 372, 20, check_label, self.turbo_mode, theme);

        // Interactive Slider for Wave Speed
        win.draw_text(44, 404, "WAVE SPEED SLIDER", theme.text_secondary, 1);
        self.slider_speed = win.ui_slider(44, 424, 240, 24, self.slider_speed, 10.0, 100.0, theme);

        // Dynamic Progress Bar based on counter
        var mut_progress = ((self.counter % 100i64) as f32) / 100.0;
        if mut_progress < 0.0 { mut_progress = -mut_progress; }
        win.ui_progress_bar(44, 456, 240, 10, mut_progress, theme);

        // Telemetry Stats in Left Panel
        win.draw_text(44, 478, "SYSTEM TELEMETRY", theme.text_secondary, 1);
        win.draw_rect(44, 496, 240, 1, theme.card_border);

        win.draw_formatted(44, 506, "Frame: ", self.frame_count, "", theme.text_primary, 1);
        win.draw_formatted(44, 526, "Clicks: ", self.click_count, "", theme.text_primary, 1);
        win.draw_formatted(44, 546, "Speed: ", self.slider_speed as i64, " %", theme.text_accent, 1);

        if detected == WINDOW_BACKEND_WAYLAND {
            win.draw_text(44, 566, "Compositor: KDE Wayland", theme.text_primary, 1);
            win.draw_text(44, 586, "Memory: Linux memfd SHM", theme.text_primary, 1);
        } else if detected == WINDOW_BACKEND_X11 {
            win.draw_text(44, 566, "Server: X.Org X11 Unix", theme.text_primary, 1);
            win.draw_text(44, 586, "Protocol: X11 Core Wire", theme.text_primary, 1);
        } else {
            win.draw_text(44, 566, "Server: Headless Fallback", theme.text_primary, 1);
            win.draw_text(44, 586, "Memory: Heap Framebuffer", theme.text_primary, 1);
        }

        // 4. Right Panel Showcase: Card 1 - Real-time Telemetry (324, 76, 572, 160)
        win.ui_panel(324, 76, 572, 160, "DESKTOP EVENT & POINTER TELEMETRY", theme);

        let mx_val = self.mouse_x as i64;
        let my_val = self.mouse_y as i64;
        win.draw_xy(344, 124, "Cursor Position: ", mx_val, my_val, theme.text_primary, 1);

        var mouse_btn_str = "Mouse Button: RELEASED (IDLE)";
        var mouse_btn_col = theme.text_secondary;
        if self.mouse_down {
            mouse_btn_str = "Mouse Button: PRESSED [ACTIVE]";
            mouse_btn_col = theme.text_accent;
        }
        win.draw_text(344, 146, mouse_btn_str, mouse_btn_col, 1);

        win.draw_text(344, 168, self.last_event, theme.text_primary, 1);
        win.draw_formatted(344, 190, "Last Key Code: ", self.last_key as i64, " (ESC/Q to exit)", theme.text_secondary, 1);

        // Visual radar crosshair on the right of Card 1
        win.ui_card(770, 92, 110, 128, theme);
        win.draw_circle(825, 156, 40, theme.card_border);
        win.draw_circle(825, 156, 20, theme.card_border);

        // Scaled cursor position mapped into radar box
        let radar_x = 770 + ((self.mouse_x / (self.width as f32)) * 110.0) as i32;
        let radar_y = 92 + ((self.mouse_y / (self.height as f32)) * 128.0) as i32;
        win.draw_circle(radar_x, radar_y, 4, theme.accent_glow);

        // 5. Right Panel Showcase: Card 2 - std/gui Flexbox Layout Engine (324, 252, 572, 170)
        win.ui_panel(324, 252, 572, 170, "FLEXBOX ENGINE (std::gui::LayoutBox)", theme);

        // Compute layout using Rad std::gui LayoutBox with flexible sizing
        var root_box = LayoutBox::row(532.0, 96.0);
        root_box.x = 344.0;
        root_box.y = 302.0;

        let box_a = LayoutBox::flex_item(1.0);
        let box_b = LayoutBox::flex_item(1.0);
        let box_c = LayoutBox::flex_item(1.0);
        root_box.add_child(box_a);
        root_box.add_child(box_b);
        root_box.add_child(box_c);
        root_box.compute_layout(532.0, 96.0);

        let pad_gap = 12i32;
        let item_w = (532i32 - pad_gap * 2) / 3i32;

        let x1 = 344;
        let y1 = 302;
        win.ui_card(x1, y1, item_w, 96, theme);
        win.draw_text(x1 + 12, y1 + 14, "ACTOR MODEL", theme.text_accent, 1);
        win.draw_text(x1 + 12, y1 + 38, "Lock-free Mailbox", theme.text_primary, 1);
        win.draw_text(x1 + 12, y1 + 60, "1M+ Concurrency", theme.text_secondary, 1);

        let x2 = x1 + item_w + pad_gap;
        let y2 = 302;
        win.ui_card(x2, y2, item_w, 96, theme);
        win.draw_text(x2 + 12, y2 + 14, "DETERMINISTIC ARC", theme.text_accent, 1);
        win.draw_text(x2 + 12, y2 + 38, "Zero GC Latency", theme.text_primary, 1);
        win.draw_text(x2 + 12, y2 + 60, "Static Elision", theme.text_secondary, 1);

        let x3 = x2 + item_w + pad_gap;
        let y3 = 302;
        win.ui_card(x3, y3, item_w, 96, theme);
        win.draw_text(x3 + 12, y3 + 14, "NATIVE LINKER", theme.text_accent, 1);
        win.draw_text(x3 + 12, y3 + 38, "ELF & Mach-O & PE", theme.text_primary, 1);
        win.draw_text(x3 + 12, y3 + 60, "Zero C++ Bridge", theme.text_secondary, 1);

        // 6. Right Panel Showcase: Card 3 - Dynamic Vector Graphics & Visualizer (324, 438, 572, 188)
        win.ui_panel(324, 438, 572, 188, "HARDWARE-ACCELERATED VECTOR GRAPHICS ENGINE", theme);

        // Animated Equalizer Bars - controlled by interactive slider speed!
        var bar_i = 0usize;
        let speed_factor = ((self.slider_speed as i64) / 10i64) + 1i64;
        while bar_i < 24usize {
            let bi = bar_i as i64;
            let wave_phase = (self.frame_count * speed_factor + bi * 14i64) % 100i64;
            var bar_h = 15i32 + (wave_phase as i32);
            if bar_h > 100i32 {
                bar_h = 200i32 - bar_h;
            }
            if bar_h < 10i32 { bar_h = 10i32; }

            let bx = 344 + (bar_i as i32) * 16;
            let by = 590 - bar_h;

            var bar_col = theme.btn_bg;
            if (bar_i % 2usize) == 0usize {
                bar_col = theme.text_accent;
            } else {
                bar_col = theme.accent_glow;
            }

            win.draw_rect_rounded(bx, by, 11, bar_h, 3, bar_col);
            bar_i = bar_i + 1usize;
        }

        // Concentric spinning visualizer on right of Card 3
        let spin_cx = 810;
        let spin_cy = 530;
        win.draw_circle(spin_cx, spin_cy, 48, theme.card_bg);
        win.draw_circle(spin_cx, spin_cy, 36, theme.card_border);
        win.draw_circle(spin_cx, spin_cy, 24, theme.panel_bg);
        win.draw_circle(spin_cx, spin_cy, 12, theme.text_accent);

        // 7. Bottom Status Bar (0, 642, width, 38)
        win.draw_rect(0, 642, self.width, 38, theme.panel_bg);
        win.draw_rect(0, 642, self.width, 1, theme.card_border);

        win.draw_text(24, 654, "[ESC/Q] Exit  [SPACE] Inc  [T] Theme  [A] Auto  [S] Shot", theme.text_secondary, 1);
        win.draw_text(490, 654, "RAD v0.2.4  |  Universal Native GUI  |  100% Pure Rad", theme.text_accent, 1);
    }
}

// ------------------------------------------------------------------------------
// Main Entrypoint
// ------------------------------------------------------------------------------

fn main() -> i32 {
    let _ = signal(13i32, 1usize); // SIGPIPE -> SIG_IGN

    let win_w = 920i32;
    let win_h = 680i32;
    let win_title = "Rad Desktop GUI - Pure Rad Universal Window";

    println("==================================================================");
    println("Rad Native Desktop GUI Showcase (100% Pure Rad std::gui)");
    println("Detecting active display server (Wayland / X11 / Headless)...");

    let detected = detect_display_backend();
    var detected_str = "Headless Fallback";
    if detected == WINDOW_BACKEND_WAYLAND {
        detected_str = "Wayland Unix Socket";
    } else if detected == WINDOW_BACKEND_X11 {
        detected_str = "X11 Unix Socket (:0)";
    }
    println(f"Connecting via {detected_str}...");

    var win = Window::open(win_title, win_w, win_h);
    if !win.is_open() {
        println("ERROR: Could not open window on any display backend.");
        return 1i32;
    }

    println("Window opened and surface mapped successfully!");
    println("Zero C++ bridge, zero external library link flags.");
    println("SHM Framebuffer allocated: 920x680 (XRGB8888)");
    println("Entering interactive 60 FPS event loop...");

    var app = AppState::new(win_w, win_h);

    // Check for test mode: RAD_DEMO_FRAMES environment variable
    var max_frames = 0i64;
    let env_frames = getenv("RAD_DEMO_FRAMES");
    if (env_frames as usize) != 0usize {
        var parsed_frames = 0i64;
        let p = env_frames;
        var pi = 0usize;
        while p[pi] >= 48u8 && p[pi] <= 57u8 {
            parsed_frames = parsed_frames * 10i64 + ((p[pi] - 48u8) as i64);
            pi = pi + 1usize;
        }
        if parsed_frames > 0i64 {
            max_frames = parsed_frames;
            print("Automated test mode: limiting to ");
            print(max_frames);
            println(" frames.");
        }
    }
    if max_frames == 0i64 {
        println("Interactive mode active: window will remain open indefinitely.");
        println("Press ESC or click the Close button [x] to exit.");
    }

    while win.is_open() {
        // 1. Process all pending events
        while true {
            let ev = win.poll_event();
            if ev.event_type == WINDOW_EVENT_NONE {
                break;
            }

            if ev.event_type == WINDOW_EVENT_CLOSE {
                app.last_event = "WINDOW_EVENT_CLOSE";
                win.close();
            } else if ev.event_type == WINDOW_EVENT_MOUSE_MOVE {
                app.mouse_x = ev.x;
                app.mouse_y = ev.y;
                app.last_event = "WINDOW_EVENT_MOUSE_MOVE";
                app.update_hover();
            } else if ev.event_type == WINDOW_EVENT_MOUSE_DOWN {
                app.mouse_x = ev.x;
                app.mouse_y = ev.y;
                app.mouse_down = true;
                app.last_event = "WINDOW_EVENT_MOUSE_DOWN";
                app.update_hover();
                app.handle_click(win);
                if app.hover_btn == 6i32 {
                    win.close();
                }
            } else if ev.event_type == WINDOW_EVENT_MOUSE_UP {
                app.mouse_x = ev.x;
                app.mouse_y = ev.y;
                app.mouse_down = false;
                app.last_event = "WINDOW_EVENT_MOUSE_UP";
                app.update_hover();
            } else if ev.event_type == WINDOW_EVENT_KEY_DOWN {
                app.last_key = ev.key_code;
                app.last_event = "WINDOW_EVENT_KEY_DOWN";
                if ev.key_code == 1u32 || ev.key_code == 16u32 || ev.key_code == 24u32 || ev.key_code == 9u32 {
                    // ESC / Q (evdev 1 & 16 on Wayland; 9 & 24 on X11)
                    win.close();
                } else if ev.key_code == 57u32 || ev.key_code == 65u32 {
                    // KEY_SPACE: Increment counter
                    var step = 1i64;
                    if app.turbo_mode { step = 5i64; }
                    app.counter = app.counter + step;
                } else if ev.key_code == 20u32 || ev.key_code == 28u32 {
                    // KEY_T: Cycle theme
                    app.theme_idx = (app.theme_idx + 1i32) % 3i32;
                } else if ev.key_code == 30u32 || ev.key_code == 38u32 {
                    // KEY_A: Toggle auto-tick
                    app.auto_tick = !app.auto_tick;
                } else if ev.key_code == 31u32 || ev.key_code == 39u32 {
                    // KEY_S: Capture screenshot
                    let _ = win.save_bmp("tests/demos/wayland_gui/screenshot.bmp");
                    println("Screenshot captured: tests/demos/wayland_gui/screenshot.bmp");
                }
            }
        }

        // 2. Update application state
        app.frame_count = app.frame_count + 1i64;
        if app.auto_tick && (app.frame_count % 10i64) == 0i64 {
            var step = 1i64;
            if app.turbo_mode { step = 5i64; }
            app.counter = app.counter + step;
        }

        // 3. Render current frame
        app.render_frame(win);

        // 4. Present frame to compositor/display server
        win.present();

        // 5. If running in automated benchmark/test mode, check frame limit
        if max_frames > 0i64 && app.frame_count >= max_frames {
            println("Test frame count reached! Exiting demo cleanly...");
            break;
        }

        // 6. Frame timing (~60 FPS -> 16,000 microseconds)
        let _ = usleep(16000u32);
    }

    println("Saving final frame screenshot to tests/demos/wayland_gui/screenshot.bmp...");
    let _ = win.save_bmp("tests/demos/wayland_gui/screenshot.bmp");

    println("Cleaning up window resources...");
    win.destroy();
    println("Pure-Rad Desktop GUI demo completed successfully!");
    return 0i32;
}
