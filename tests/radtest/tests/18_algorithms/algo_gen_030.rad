fn main() {
    var arr = [10i64, 23i64, 36i64, 49i64, 62i64, 75i64]
    let n = arr.len
    var a = 0usize
    while a < n {
        var b = 0usize
        while b < n - 1usize - a {
            if arr[b] > arr[b + 1usize] {
                let tmp = arr[b]
                arr[b] = arr[b + 1usize]
                arr[b + 1usize] = tmp
            }
            b = b + 1usize
        }
        a = a + 1usize
    }
    println(f"sorted: [{arr[0]}, {arr[1]}, {arr[2]}, {arr[3]}, {arr[4]}, {arr[5]}]")
}
