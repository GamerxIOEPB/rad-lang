fn main() {
    var hits: i64 = 0i64
    var x: i64 = 0i64
    while x < 7i64 {
        var y: i64 = 0i64
        while y < 7i64 {
            if y == 2i64 {
                y = y + 1i64
                continue
            }
            if x == 2i64 {
                break
            }
            hits = hits + 1i64
            y = y + 1i64
        }
        x = x + 1i64
    }
    println(f"hits: {hits}")
}
