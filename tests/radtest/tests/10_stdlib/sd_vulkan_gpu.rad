import std/gpu;

fn main() -> i32 {
    println("--- Rad Vulkan & GPGPU Compute Pipeline ---");

    // 1. Direct Vulkan Pipeline (Zero external C libraries)
    var vk = VulkanContext::init("RadVulkanShowcase");
    let dev_count = vk.enumerate_devices().len;
    println(f"Vulkan physical devices enumerated: {dev_count}");

    // Keep the generic device-vector return type inferred, but split the
    // chained method/index expression so the element type is explicit.
    let devices = vk.enumerate_devices();
    let dev0: VkPhysicalDeviceInfo = devices.ptr[0];
    let dev_name = dev0.device_name.as_ptr() as str;
    println(f"Primary GPU: {dev_name}");

    let swapchain: VkSwapchainKHR = vk.create_swapchain(1920u32, 1080u32, 44u32); // VK_FORMAT_B8G8R8A8_UNORM
    let sc_w = swapchain.width;
    let sc_h = swapchain.height;
    println(f"Vulkan swapchain created: {sc_w}x{sc_h}");

    // 2. Pure-Rad SPIR-V Bytecode Builder
    let gemm_sm = SpirvModule::build_gemm_compute();
    let words = gemm_sm.word_count();
    let bytes = gemm_sm.byte_size();
    println(f"SPIR-V GEMM compute module compiled: {words} words ({bytes} bytes)");

    let sha_sm = SpirvModule::build_sha256_compute();
    let sha_words = sha_sm.word_count();
    println(f"SPIR-V SHA-256 compute module compiled: {sha_words} words");

    let curve_sm = SpirvModule::build_curve_vertex();
    let curve_words = curve_sm.word_count();
    println(f"SPIR-V curve raster vertex module compiled: {curve_words} words");

    // 3. GPGPU Compute Dispatch: Matrix Multiplication
    let kernel_gemm = GpuComputeKernel::new_gemm();
    var mat_a = Vec.new();
    var mat_b = Vec.new();
    // 2x2 matrix multiplication: [[1, 2], [3, 4]] * [[5, 6], [7, 8]]
    // Expected: [[19, 22], [43, 50]]
    mat_a.push(1i64); mat_a.push(2i64);
    mat_a.push(3i64); mat_a.push(4i64);

    mat_b.push(5i64); mat_b.push(6i64);
    mat_b.push(7i64); mat_b.push(8i64);

    let mat_c = kernel_gemm.dispatch_matmul_i64(2usize, 2usize, 2usize, mat_a, mat_b);
    let c00 = mat_c.ptr[0];
    let c01 = mat_c.ptr[1];
    let c10 = mat_c.ptr[2];
    let c11 = mat_c.ptr[3];
    println(f"GEMM Dispatch result: [[{c00}, {c01}], [{c10}, {c11}]]");

    // 4. GPGPU Cryptographic SHA-256 Dispatch
    let kernel_sha = GpuComputeKernel::new_sha256();
    var raw_data = Vec.new();
    raw_data.push(82u8); raw_data.push(65u8); raw_data.push(68u8); // "RAD"
    let hash_digest = kernel_sha.dispatch_sha256(raw_data);
    let hash_len = hash_digest.len;
    println(f"GPU SHA-256 hash digest generated: {hash_len} bytes");

    // 5. GPU-Accelerated 2D Bézier Curve Rasterization
    let kernel_curve = GpuComputeKernel::new_curve_raster();
    let curve_pts = kernel_curve.dispatch_curve_raster(0.0f32, 0.0f32, 50.0f32, 100.0f32, 100.0f32, 0.0f32, 4usize);
    let pt_count = curve_pts.len / 2usize;
    println(f"GPU curve tessellated: {pt_count} points");

    println("Vulkan & GPU compute pipeline verified successfully.");
    return 0;
}
