// [std] User-Defined Generic Structs & Methods
struct Pair<A, B> {
    pub first: A,
    pub second: B,
}

impl<A, B> Pair<A, B> {
    pub fn new(a: A, b: B) -> Pair<A, B> {
        return Pair<A, B> {
            first: a,
            second: b,
        }
    }

    pub fn get_first(self) -> A {
        return self.first
    }

    pub fn get_second(self) -> B {
        return self.second
    }
}

struct Queue<T> {
    pub items: Vec<T>,
}

impl<T> Queue<T> {
    pub fn new() -> Queue<T> {
        return Queue<T> {
            items: Vec.new(),
        }
    }

    pub fn push(var self, val: T) {
        self.items.push(val)
    }

    pub fn count(self) -> usize {
        return self.items.len
    }

    pub fn get(self, idx: usize) -> T {
        return self.items.ptr[idx]
    }
}

fn main() {
    let p = Pair<i64, str>.new(100, "generic Rad");
    println("p.first={p.first}");
    println("p.second={p.second}");
    let f1 = p.get_first();
    let f2 = p.get_second();
    println("p.get_first()={f1}");
    println("p.get_second()={f2}");

    var q = Queue<i64>.new();
    q.push(10);
    q.push(20);
    q.push(30);
    let qc = q.count();
    let q0 = q.get(0usize);
    let q1 = q.get(1usize);
    let q2 = q.get(2usize);
    println("q.count()={qc}");
    println("q.get(0)={q0}");
    println("q.get(1)={q1}");
    println("q.get(2)={q2}");
}
