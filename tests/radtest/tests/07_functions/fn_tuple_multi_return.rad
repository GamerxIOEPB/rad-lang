fn divmod(a: i64, b: i64) -> (i64, i64) {
    return (a / b, a % b);
}

fn stats(val: f64) -> (f64, str) {
    return (val * 2.0, "scaled");
}

fn triple(x: i64) -> (i64, i64, i64) {
    return (x, x * 2, x * 3);
}

fn main() -> i32 {
    let (q, r) = divmod(100i64, 7i64);
    println("divmod: {} {}", q, r);

    let (q2, r2): (i64, i64) = divmod(45i64, 6i64);
    println("typed: {} {}", q2, r2);

    let (q3: i64, r3: i64) = divmod(19i64, 4i64);
    println("elem_typed: {} {}", q3, r3);

    var (m1, m2) = (10i64, 20i64);
    m1 = m1 + 1i64;
    m2 = m2 + 2i64;
    println("mut: {} {}", m1, m2);

    let (d, label) = stats(1.5);
    println("stats: {} {}", d, label);

    let (a, b, c) = triple(5i64);
    println("triple: {} {} {}", a, b, c);

    return 0;
}
