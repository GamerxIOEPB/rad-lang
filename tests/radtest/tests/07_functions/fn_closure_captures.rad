fn main() {
    // 1. Single captured variable
    let base = 10
    let add_base = |x| x + base
    println(add_base(5))

    // 2. Multiple captured variables
    let a = 20
    let b = 30
    let sum_ab = |x| x + a + b
    println(sum_ab(2))

    // 3. Nested closures capturing from outer lambda and enclosing function
    let offset = 100
    let make_adder = |x: i64| -> i64 {
        let inner = |y: i64| -> i64 {
            return x + y + offset
        }
        return inner(5)
    }
    println(make_adder(10))

    // 4. In-place mutation of captured variable
    var counter = 0
    let inc = |step: i64| {
        counter = counter + step
    }
    inc(5)
    inc(10)
    println(counter)
}
