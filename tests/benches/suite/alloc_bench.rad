// ==============================================================================
// Benchmark: Allocation & Vector Iteration (1,000,000 elements x 10 runs)
// ==============================================================================

import std/time

extern "C" {
    fn malloc(size: usize) -> *raw var i64;
    fn free(ptr: *raw var i64);
}

fn main() -> i32 {
    let n = 1000000usize;
    let iterations = 10usize;
    let t0 = Instant.now();

    var total_sum = 0i64;
    var iter = 0usize;
    while iter < iterations {
        let p = malloc(n * 8usize);
        let iter_i64 = iter as i64;
        var i = 0usize;
        while i < n {
            p[i] = (i as i64) + iter_i64;
            i = i + 1usize;
        }
        var s = 0i64;
        i = 0usize;
        while i < n {
            s = s + p[i];
            i = i + 1usize;
        }
        total_sum = total_sum + s;
        free(p);
        iter = iter + 1usize;
    }

    let elapsed_ms = t0.elapsed().as_millis();
    printf("RAD_ALLOC_RESULT: %llu ms (sum: %lld)\n", elapsed_ms, total_sum);
    return 0;
}
