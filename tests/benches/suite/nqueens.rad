import std/time

extern "C" {
    fn printf(fmt: *raw u8, ...) -> i32;
}

fn solve_nqueens(cols: i64, diag1: i64, diag2: i64, mask: i64) -> i64 {
    if cols == mask {
        return 1i64;
    }
    var count = 0i64;
    var valid = mask & (~(cols | diag1 | diag2));
    while valid != 0i64 {
        let bit = valid & (0i64 - valid);
        valid = valid - bit;
        count = count + solve_nqueens(cols | bit, (diag1 | bit) << 1, (diag2 | bit) >> 1, mask);
    }
    return count;
}

fn main() -> i32 {
    let mask = (1i64 << 14) - 1i64;
    let t0 = Instant.now();
    let solutions = solve_nqueens(0i64, 0i64, 0i64, mask);
    let elapsed_ms = t0.elapsed().as_millis();

    printf("RAD_NQUEENS_RESULT: %llu ms (solutions: %lld)\n", elapsed_ms, solutions);
    return 0;
}
