import std/time

extern "C" {
    fn malloc(size: usize) -> *raw f64;
    fn free(ptr: *raw f64);
    fn printf(fmt: *raw u8, ...) -> i32;
}

fn main() -> i32 {
    let n = 512usize;
    let total_elements = n * n;
    let byte_size = total_elements * 8usize; // sizeof(f64) = 8

    let a = malloc(byte_size);
    let b = malloc(byte_size);
    let c = malloc(byte_size);

    if a == (0usize as *raw f64) || b == (0usize as *raw f64) || c == (0usize as *raw f64) {
        printf("Memory allocation failed\n");
        return 1;
    }

    var i = 0usize;
    while i < total_elements {
        a[i] = ((i % 100usize) as f64) * 0.01;
        b[i] = (((i + 50usize) % 100usize) as f64) * 0.01;
        c[i] = 0.0;
        i = i + 1usize;
    }

    let t0 = Instant.now();

    // Cache-friendly contiguous iteration over B: row, k, col
    var row = 0usize;
    while row < n {
        let row_offset = row * n;
        var k = 0usize;
        while k < n {
            let a_val = a[row_offset + k];
            let b_row = k * n;
            var col = 0usize;
            while col < n {
                c[row_offset + col] = c[row_offset + col] + a_val * b[b_row + col];
                col = col + 1usize;
            }
            k = k + 1usize;
        }
        row = row + 1usize;
    }

    let elapsed_ms = t0.elapsed().as_millis();

    // Checksum: sample middle elements
    var checksum = 0.0;
    var idx = 0usize;
    while idx < total_elements {
        checksum = checksum + c[idx];
        idx = idx + 1024usize;
    }

    printf("RAD_MATMUL_RESULT: %llu ms (checksum: %lld)\n", elapsed_ms, checksum as i64);

    free(a);
    free(b);
    free(c);

    return 0;
}
