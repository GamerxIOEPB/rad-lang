// Isolated String allocator stress. Keep separate from Vec because their
// current compiler lowering emits the same unmangled constructor symbol.
import alloc/string;

fn main() -> i32 {
    var text = String.new();
    var n = 0usize;
    while n < 8192usize {
        text.push_str("Rad!");
        n = n + 1usize;
    }

    let data = text.as_ptr() as *raw u8;
    if text.len() != 32768usize ||
       data[0usize] != 82u8 ||
       data[1usize] != 97u8 ||
       data[32767usize] != 33u8 ||
       data[32768usize] != 0u8 {
        println("FAIL: String growth/content/NUL boundary");
        text.drop();
        return 1;
    }

    text.drop();
    println("String allocator stress tests passed");
    return 0;
}
