// ==============================================================================
// tests/test_control_flow.rad — Native Rad Integration Test Suite for Control Flow
// Tests if/else if/else, while loops, break, continue, and nested loops.
// ==============================================================================

fn classify_num(n: i64) -> i64 {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    } else if n < 10 {
        return 1;
    } else {
        return 2;
    }
}

fn sum_with_continue(max_val: i64) -> i64 {
    var sum = 0;
    var i = 0;
    while i < max_val {
        i = i + 1;
        // Skip even numbers
        if i % 2 == 0 {
            continue;
        }
        sum = sum + i;
    }
    return sum;
}

fn sum_with_break(limit: i64) -> i64 {
    var sum = 0;
    var i = 0;
    while true {
        i = i + 1;
        sum = sum + i;
        if sum >= limit {
            break;
        }
    }
    return sum;
}

fn collatz_steps(start: i64) -> i64 {
    var n = start;
    var steps = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

fn main() -> i32 {
    var suite = TestSuite.new("Control Flow Primitives");

    // 1. If/else classification
    suite.check_eq_i64("Classify negative", classify_num(-42), -1);
    suite.check_eq_i64("Classify zero", classify_num(0), 0);
    suite.check_eq_i64("Classify small", classify_num(7), 1);
    suite.check_eq_i64("Classify large", classify_num(100), 2);

    // 2. Loop with continue (sum of odds up to 10: 1+3+5+7+9 = 25)
    suite.check_eq_i64("Sum of odd numbers with continue", sum_with_continue(10), 25);

    // 3. Loop with break
    suite.check_true("Sum with break meets limit", sum_with_break(50) >= 50);

    // 4. Nested loops with break
    var found_i = 0;
    var found_j = 0;
    var i = 0;
    while i < 10 {
        var j = 0;
        var inner_break = false;
        while j < 10 {
            if i * j == 42 {
                found_i = i;
                found_j = j;
                inner_break = true;
                break;
            }
            j = j + 1;
        }
        if inner_break {
            break;
        }
        i = i + 1;
    }
    suite.check_eq_i64("Nested loop break found product", found_i * found_j, 42);

    // 5. Collatz Conjecture (start=27 takes 111 steps)
    suite.check_eq_i64("Collatz steps for 27", collatz_steps(27), 111);

    return suite.print_summary();
}
