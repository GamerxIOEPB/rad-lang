// ==============================================================================
// tests/test_stdlib.rad — Native Rad Integration Test Suite for Standard Library
// Tests std::path, std::fs, and std::net primitives.
// ==============================================================================

extern "C" {
    fn socket(domain: i32, socket_type: i32, protocol: i32) -> i32;
    fn close(fd: i32) -> i32;
}

import std::path;
import std::fs;
import std::net;
import std::random;
import std::math;
import std::channel;
import std::collections;
import std::regex;
import std::log;

fn main() -> i32 {
    var suite = TestSuite.new("Standard Library (Phase 1 & System Primitives)");

    // 1. std::path::Path
    let joined = Path.join("home/user", "projects/rad");
    suite.check_eq_str("Path.join", joined.as_ptr() as str, "home/user/projects/rad");

    let norm = Path.normalize("a/b/../c/./d");
    suite.check_eq_str("Path.normalize", norm.as_ptr() as str, "a/c/d");

    let ext = Path.extension("src/main.rad");
    suite.check_eq_str("Path.extension", ext.as_ptr() as str, "rad");

    let fname = Path.file_name("path/to/my_file.txt");
    suite.check_eq_str("Path.file_name", fname.as_ptr() as str, "my_file.txt");

    let parent_dir = Path.parent("path/to/my_file.txt");
    suite.check_eq_str("Path.parent", parent_dir.as_ptr() as str, "path/to");

    suite.check_true("Path.has_extension true", Path.has_extension("code.rad", "rad"));
    suite.check_false("Path.has_extension false", Path.has_extension("code.c", "rad"));

    let replaced_ext = Path.with_extension("document.txt", "pdf");
    suite.check_eq_str("Path.with_extension", replaced_ext.as_ptr() as str, "document.pdf");

    suite.check_true("Path.is_absolute", Path.is_absolute("/usr/bin/rad"));
    suite.check_false("Path.is_absolute on relative", Path.is_absolute("src/main.rad"));
    suite.check_true("Path.is_relative", Path.is_relative("src/main.rad"));

    // 2. std::fs::Fs
    let makefile_exists = Fs.exists("Makefile");
    suite.check_true("Fs.exists Makefile", makefile_exists);

    let mk_size = Fs.file_size("Makefile");
    suite.check_true("Fs.file_size Makefile > 0", mk_size > 0i64);

    let mk_meta_opt = Fs.metadata("Makefile");
    var is_file = false;
    var is_dir = true;
    match mk_meta_opt {
        Option::Some(m) => {
            is_file = m.is_regular_file;
            is_dir = m.is_directory;
        },
        Option::None => {}
    }
    suite.check_true("Fs.metadata.is_regular_file", is_file);
    suite.check_false("Fs.metadata.is_directory", is_dir);

    let src_entries = Fs.read_dir("src");
    suite.check_true("Fs.read_dir src has entries", src_entries.len() > 0usize);

    // 3. std::net
    let resolved_opt = lookup_host("localhost");
    var has_resolved = false;
    match resolved_opt {
        Option::Some(ip) => {
            has_resolved = true;
            suite.check_eq_str("lookup_host('localhost')", ip.as_ptr() as str, "127.0.0.1");
        },
        Option::None => {
            suite.check_true("lookup_host failed", false);
        }
    }
    suite.check_true("Resolved localhost", has_resolved);

    // Native UDP socket lifetime. (The Option<UdpSocket> wrapper path is
    // currently covered by a separate compiler regression, not executed here.)
    let udp_fd = socket(2, 2, 0);
    suite.check_true("UDP socket() succeeded", udp_fd >= 0);
    var udp_closed = false;
    if udp_fd >= 0 {
        let close_result = close(udp_fd);
        udp_closed = close_result == 0;
    }
    suite.check_true("UDP socket close succeeded", udp_closed);

    // 4. std::random
    var rng = Rng.new();
    let r_i64 = rng.gen_range_i64(10i64, 50i64);
    suite.check_true("Rng.gen_range_i64 >= 10", r_i64 >= 10i64);
    suite.check_true("Rng.gen_range_i64 <= 50", r_i64 <= 50i64);

    // 5. std::math
    let v1 = Vec2.new(3.0, 4.0);
    let v_len = v1.length();
    suite.check_true("Vec2.length == 5.0", v_len >= 4.99 && v_len <= 5.01);
    // Mat4.identity/get are exercised by lib/rad/rad-math/tests/test_math.rad.

    // Arena allocation/reset/destruction is exercised in tests/quality/memory_safety.rad.

    // 7. std::channel
    var ch: Channel<i64> = Channel.new();
    let _s1 = ch.send(42i64);
    let c_val = ch.recv();
    var ch_ok = false;
    match c_val {
        Option::Some(v) => {
            if v == 42i64 { ch_ok = true; }
        },
        Option::None => {}
    }
    suite.check_true("Channel send/recv 42", ch_ok);
    ch.close();
    ch.destroy();

    // 8. std::collections::LinkedList
    var list: LinkedList<i64> = LinkedList.new();
    list.push_back(100i64);
    list.push_front(50i64);
    suite.check_eq_i64("LinkedList.len == 2", list.len() as i64, 2i64);
    let l_val = list.pop_front();
    var list_ok = false;
    match l_val {
        Option::Some(v) => {
            if v == 50i64 { list_ok = true; }
        },
        Option::None => {}
    }
    suite.check_true("LinkedList pop_front == 50", list_ok);
    list.destroy();

    // 9. std::regex
    let re = Regex.compile("^user_[0-9]+$");
    suite.check_true("Regex match user_123", re.is_match("user_123"));
    suite.check_false("Regex match user_abc", re.is_match("user_abc"));

    // 10. std::log
    log_info("STDLIB_TEST", "Logging std::log test message");
    suite.check_true("std::log executed without panic", true);

    return suite.print_summary();
}
