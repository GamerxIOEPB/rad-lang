// ==============================================================================
// rad_pm/src/cmd_pkg.rad — Package Registry, Dependencies & Lockfile
// ==============================================================================

fn extract_json_field(line: str, field_name: str) -> String {
    var res = String.new()
    let p_line = line as *raw u8
    let len = str_len(line)
    let f_len = str_len(field_name)
    var i = 0usize
    while i + f_len + 3usize < len {
        if p_line[i] == 34u8 { // '"'
            var match_field = true
            var j = 0usize
            while j < f_len {
                if p_line[i + 1usize + j] != (field_name as *raw u8)[j] {
                    match_field = false
                    j = f_len
                } else {
                    j = j + 1usize
                }
            }
            if match_field && p_line[i + 1usize + f_len] == 34u8 { // '"'
                var k = i + 2usize + f_len
                while k < len && (p_line[k] == 32u8 || p_line[k] == 58u8 || p_line[k] == 9u8) { // ' ', ':', '\t'
                    k = k + 1usize
                }
                if k < len && p_line[k] == 34u8 { // start quote of value
                    k = k + 1usize
                    while k < len && p_line[k] != 34u8 {
                        res.push_byte(p_line[k])
                        k = k + 1usize
                    }
                    return res
                }
            }
        }
        i = i + 1usize
    }
    return res
}

fn extract_toml_field(line: str, field_name: str) -> String {
    let trimmed = trim_line_start(line)
    if str_starts_with(trimmed, field_name) {
        let f_len = str_len(field_name)
        let p = trimmed as *raw u8
        var i = f_len
        let len = str_len(trimmed)
        while i < len && (is_whitespace_char(p[i]) || p[i] == 61u8) { // whitespace or '='
            i = i + 1usize
        }
        if i < len && p[i] == 34u8 { // '"'
            i = i + 1usize
            var res = String.new()
            while i < len && p[i] != 34u8 {
                res.push_byte(p[i])
                i = i + 1usize
            }
            return res
        }
    }
    return String.new()
}

fn parse_dep_name(line: str) -> String {
    let len = str_len(line)
    let p = line as *raw u8
    var res = String.new()
    var i = 0usize
    while i < len && is_whitespace_char(p[i]) {
        i = i + 1usize
    }
    while i < len && !is_whitespace_char(p[i]) && p[i] != 61u8 {
        res.push_byte(p[i])
        i = i + 1usize
    }
    return res
}

fn parse_dep_version(line: str) -> String {
    let len = str_len(line)
    let p = line as *raw u8
    var res = String.new()
    var i = 0usize
    while i < len && p[i] != 61u8 {
        i = i + 1usize
    }
    if i >= len {
        return res
    }
    i = i + 1usize // skip '='
    while i < len && (is_whitespace_char(p[i]) || p[i] == 34u8) {
        i = i + 1usize
    }
    while i < len && p[i] != 34u8 && p[i] != 10u8 && p[i] != 13u8 && p[i] != 35u8 {
        res.push_byte(p[i])
        i = i + 1usize
    }
    return res
}

fn clean_semver_req(req: str) -> String {
    var res = String.new()
    let len = str_len(req)
    let p = req as *raw u8
    var i = 0usize
    while i < len && (p[i] == 94u8 || p[i] == 126u8 || p[i] == 62u8 || p[i] == 61u8 || p[i] == 32u8) {
        i = i + 1usize
    }
    while i < len && p[i] != 32u8 {
        res.push_byte(p[i])
        i = i + 1usize
    }
    return res
}

fn extract_git_repo_name(url: str) -> String {
    let slen = str_len(url)
    if slen == 0usize {
        return String.new()
    }
    let sp = url as *raw u8
    var end_pos = slen
    while end_pos > 0usize && sp[end_pos - 1usize] == 47u8 {
        end_pos = end_pos - 1usize
    }
    if end_pos > 4usize && sp[end_pos - 4usize] == 46u8 && sp[end_pos - 3usize] == 103u8 && sp[end_pos - 2usize] == 105u8 && sp[end_pos - 1usize] == 116u8 {
        end_pos = end_pos - 4usize
    }
    while end_pos > 0usize && sp[end_pos - 1usize] == 47u8 {
        end_pos = end_pos - 1usize
    }
    var last_slash = 0usize
    var si = 0usize
    while si < end_pos {
        if sp[si] == 47u8 || sp[si] == 58u8 {
            last_slash = si + 1usize
        }
        si = si + 1usize
    }
    var res = String.new()
    si = last_slash
    while si < end_pos {
        res.push_byte(sp[si])
        si = si + 1usize
    }
    return res
}

fn parse_git_url(line: str) -> String {
    let len = str_len(line)
    let p = line as *raw u8
    var res = String.new()
    var i = 0usize
    while i + 3usize < len {
        if p[i] == 103u8 && p[i + 1usize] == 105u8 && p[i + 2usize] == 116u8 { // "git"
            i = i + 3usize
            while i < len && p[i] != 34u8 {
                i = i + 1usize
            }
            if i < len && p[i] == 34u8 {
                i = i + 1usize
                while i < len && p[i] != 34u8 {
                    res.push_byte(p[i])
                    i = i + 1usize
                }
                return res
            }
        }
        i = i + 1usize
    }
    return res
}

fn get_registry_root() -> String {
    let env_reg = getenv("RAD_REGISTRY_PATH")
    if (env_reg as usize) != 0usize {
        let p = env_reg as str
        var chk = String.new()
        chk.push_str(p)
        chk.push_str("/registry/index.json")
        if file_exists(chk.as_ptr() as str) {
            return String.from_str(p)
        }
    }

    if file_exists("../rad-lib/registry/index.json") {
        return String.from_str("../rad-lib")
    }

    let env_home = getenv("HOME")
    if (env_home as usize) != 0usize {
        var p_proj = String.new()
        p_proj.push_str(env_home as str)
        p_proj.push_str("/Projects/rad-lib/registry/index.json")
        if file_exists(p_proj.as_ptr() as str) {
            var p_res = String.new()
            p_res.push_str(env_home as str)
            p_res.push_str("/Projects/rad-lib")
            return p_res
        }

        var p_cache = String.new()
        p_cache.push_str(env_home as str)
        p_cache.push_str("/.rad/cache/registry")
        var p_cache_idx = String.new()
        p_cache_idx.push_str(p_cache.as_ptr() as str)
        p_cache_idx.push_str("/index.json")
        if file_exists(p_cache_idx.as_ptr() as str) {
            return p_cache
        }
    }

    return String.new()
}

fn sync_registry() -> String {
    let root = get_registry_root()
    if root.len() > 0usize {
        return root
    }

    let env_home = getenv("HOME")
    if (env_home as usize) == 0usize {
        return String.new()
    }

    var cache_reg = String.new()
    cache_reg.push_str(env_home as str)
    cache_reg.push_str("/.rad/cache/registry")

    var mkdir_cmd = String.new()
    mkdir_cmd.push_str("mkdir -p ")
    mkdir_cmd.push_str(cache_reg.as_ptr() as str)
    let _m = system(mkdir_cmd.as_ptr() as str)

    var dl_cmd = String.new()
    dl_cmd.push_str("curl -fsSL https://raw.githubusercontent.com/GamerxIOEPB/rad-lib/main/registry/index.json -o ")
    dl_cmd.push_str(cache_reg.as_ptr() as str)
    dl_cmd.push_str("/index.json >/dev/null 2>&1")
    let ret = system(dl_cmd.as_ptr() as str)
    if ret == 0 {
        return cache_reg
    }

    return String.new()
}

fn get_package_latest_version(reg_root: str, pkg_name: str) -> String {
    var idx_path = String.new()
    idx_path.push_str(reg_root)
    idx_path.push_str("/registry/index.json")

    let content = read_file_str(idx_path.as_ptr() as str)
    let lines = split_source_lines(content)
    var cur_name = String.new()

    var i = 0usize
    while i < lines.len {
        let line = lines.ptr[i].as_ptr() as str
        let f_name = extract_json_field(line, "name")
        if f_name.len() > 0usize && cur_name.len() == 0usize {
            cur_name = f_name
        }
        let f_ver = extract_json_field(line, "latest")
        if f_ver.len() > 0usize && cur_name.len() > 0usize {
            if str_eq(cur_name.as_ptr() as str, pkg_name) {
                return f_ver
            }
            cur_name = String.new()
        }
        i = i + 1usize
    }
    return String.from_str("0.1.0")
}

fn get_package_checksum(reg_root: str, pkg_name: str, version: str) -> String {
    var idx_path = String.new()
    idx_path.push_str(reg_root)
    idx_path.push_str("/registry/index.json")

    let content = read_file_str(idx_path.as_ptr() as str)
    let lines = split_source_lines(content)
    var cur_name = String.new()
    var cur_ver = String.new()

    var i = 0usize
    while i < lines.len {
        let line = lines.ptr[i].as_ptr() as str
        let f_name = extract_json_field(line, "name")
        if f_name.len() > 0usize && cur_name.len() == 0usize {
            cur_name = f_name
        }
        let f_ver = extract_json_field(line, "version")
        if f_ver.len() > 0usize && cur_ver.len() == 0usize {
            cur_ver = f_ver
        }
        let f_chk = extract_json_field(line, "checksum")
        if f_chk.len() > 0usize {
            if str_eq(cur_name.as_ptr() as str, pkg_name) && str_eq(cur_ver.as_ptr() as str, version) {
                return f_chk
            }
            cur_ver = String.new()
        }
        i = i + 1usize
    }
    return String.from_str("none")
}

fn update_lockfile() {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        return
    }

    let reg_root = get_registry_root()
    let parsed_res = TomlValue.parse(toml.as_ptr() as str)
    var lock = String.new()
    lock.push_str("# This file is automatically @generated by rad.\n")
    lock.push_str("# It is not intended for manual editing.\n")
    lock.push_str("version = 1\n")

    match parsed_res {
        Result.Ok(doc) => {
            let dep_opt = doc.get_table("dependencies")
            match dep_opt {
                Option.Some(dep_tbl) => {
                    var i = 0usize
                    while i < dep_tbl.table_val.len {
                        let dep_member = dep_tbl.table_val.ptr[i]
                        var d_name = dep_member.key.as_ptr() as str
                        var d_ver = ""
                        if dep_member.val.kind == TOML_STRING {
                            d_ver = dep_member.val.as_str()
                        } else if dep_member.val.kind == TOML_TABLE {
                            let git_url = dep_member.val.get_str("git")
                            if str_len(git_url) > 0usize {
                                lock.push_str("\n[[package]]\n")
                                lock.push_str("name = \"")
                                lock.push_str(d_name)
                                lock.push_str("\"\n")
                                lock.push_str("version = \"0.1.0\"\n")
                                lock.push_str("source = \"git+")
                                lock.push_str(git_url)
                                lock.push_str("\"\n")
                                lock.push_str("checksum = \"git-head\"\n")
                                d_name = ""
                            } else {
                                d_ver = dep_member.val.get_str("version")
                            }
                        }
                        if str_len(d_name) > 0usize {
                            let resolved_ver = clean_semver_req(d_ver)
                            let chk = get_package_checksum(reg_root.as_ptr() as str, d_name, resolved_ver.as_ptr() as str)

                            lock.push_str("\n[[package]]\n")
                            lock.push_str("name = \"")
                            lock.push_str(d_name)
                            lock.push_str("\"\n")

                            lock.push_str("version = \"")
                            lock.push_str(resolved_ver.as_ptr() as str)
                            lock.push_str("\"\n")

                            lock.push_str("source = \"registry+https://github.com/GamerxIOEPB/rad-lib\"\n")

                            lock.push_str("checksum = \"")
                            lock.push_str(chk.as_ptr() as str)
                            lock.push_str("\"\n")
                        }
                        i = i + 1usize
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }

    write_file_str("rad.lock", lock.as_ptr() as str)
}

fn ensure_library_installed_global(reg_root: str, pkg_name: str, version: str) -> bool {
    let env_home = getenv("HOME")
    if (env_home as usize) == 0usize {
        return false
    }

    var global_pkg_dir = String.new()
    global_pkg_dir.push_str(env_home as str)
    global_pkg_dir.push_str("/.rad/lib/rad/")
    global_pkg_dir.push_str(pkg_name)

    // Check if already installed in ~/.rad/lib/rad/
    var test_global = String.new()
    test_global.push_str(global_pkg_dir.as_ptr() as str)
    test_global.push_str("/src/lib.rad")
    var test_global2 = String.new()
    test_global2.push_str(global_pkg_dir.as_ptr() as str)
    test_global2.push_str("/lib.rad")
    if file_exists(test_global.as_ptr() as str) || file_exists(test_global2.as_ptr() as str) {
        return true
    }

    // Also check legacy ~/.rad/packages/
    var leg_pkg = String.new()
    leg_pkg.push_str(env_home as str)
    leg_pkg.push_str("/.rad/packages/")
    leg_pkg.push_str(pkg_name)
    leg_pkg.push_str("/src/lib.rad")
    if file_exists(leg_pkg.as_ptr() as str) {
        var mig_cmd = String.new()
        mig_cmd.push_str("mkdir -p \"")
        mig_cmd.push_str(global_pkg_dir.as_ptr() as str)
        mig_cmd.push_str("\" && cp -rf \"")
        mig_cmd.push_str(env_home as str)
        mig_cmd.push_str("/.rad/packages/")
        mig_cmd.push_str(pkg_name)
        mig_cmd.push_str("\"/* \"")
        mig_cmd.push_str(global_pkg_dir.as_ptr() as str)
        mig_cmd.push_str("/\"")
        let _ = system(mig_cmd.as_ptr() as str)
        return true
    }

    // Try finding in local registry root
    var cand_reg = String.new()
    cand_reg.push_str(reg_root)
    cand_reg.push_str("/packages/")
    cand_reg.push_str(pkg_name)
    cand_reg.push_str("/")
    cand_reg.push_str(version)

    var test_reg = String.new()
    test_reg.push_str(cand_reg.as_ptr() as str)
    test_reg.push_str("/src/lib.rad")

    if file_exists(test_reg.as_ptr() as str) {
        var cp_cmd = String.new()
        cp_cmd.push_str("mkdir -p \"")
        cp_cmd.push_str(global_pkg_dir.as_ptr() as str)
        cp_cmd.push_str("\" && cp -rf \"")
        cp_cmd.push_str(cand_reg.as_ptr() as str)
        cp_cmd.push_str("\"/* \"")
        cp_cmd.push_str(global_pkg_dir.as_ptr() as str)
        cp_cmd.push_str("/\"")
        let _c = system(cp_cmd.as_ptr() as str)
    } else {
        // Fetch from GitHub
        var dl_cmd = String.new()
        dl_cmd.push_str("sh -c '")
        dl_cmd.push_str("TMP_DL=\"/tmp/rad_lib_dl_$$\"; ")
        dl_cmd.push_str("git clone --depth 1 https://github.com/GamerxIOEPB/rad-lib.git \"$TMP_DL\" >/dev/null 2>&1 || exit 1; ")
        dl_cmd.push_str("mkdir -p \"")
        dl_cmd.push_str(global_pkg_dir.as_ptr() as str)
        dl_cmd.push_str("\"; ")
        dl_cmd.push_str("cp -rf \"$TMP_DL/packages/")
        dl_cmd.push_str(pkg_name)
        dl_cmd.push_str("/")
        dl_cmd.push_str(version)
        dl_cmd.push_str("\"/* \"")
        dl_cmd.push_str(global_pkg_dir.as_ptr() as str)
        dl_cmd.push_str("/\"; ")
        dl_cmd.push_str("rm -rf \"$TMP_DL\"; ")
        dl_cmd.push_str("'")
        let _c2 = system(dl_cmd.as_ptr() as str)
    }

    // Set up shorthand symlink in ~/.rad/lib/rad/ (e.g. tui -> rad-tui, json -> rad-json)
    if str_starts_with(pkg_name, "rad-") {
        let short_name = (pkg_name as usize + 4usize) as str
        var link_cmd = String.new()
        link_cmd.push_str("ln -sfn \"")
        link_cmd.push_str(pkg_name)
        link_cmd.push_str("\" \"")
        link_cmd.push_str(env_home as str)
        link_cmd.push_str("/.rad/lib/rad/")
        link_cmd.push_str(short_name)
        link_cmd.push_str("\" 2>/dev/null; ")
        link_cmd.push_str("if [ ! -L \"")
        link_cmd.push_str(env_home as str)
        link_cmd.push_str("/.rad/packages\" ]; then rm -rf \"")
        link_cmd.push_str(env_home as str)
        link_cmd.push_str("/.rad/packages\" 2>/dev/null; ln -sfn lib/rad \"")
        link_cmd.push_str(env_home as str)
        link_cmd.push_str("/.rad/packages\" 2>/dev/null; fi")
        let _l = system(link_cmd.as_ptr() as str)
    } else {
        var link_comp = String.new()
        link_comp.push_str("if [ ! -L \"")
        link_comp.push_str(env_home as str)
        link_comp.push_str("/.rad/packages\" ]; then rm -rf \"")
        link_comp.push_str(env_home as str)
        link_comp.push_str("/.rad/packages\" 2>/dev/null; ln -sfn lib/rad \"")
        link_comp.push_str(env_home as str)
        link_comp.push_str("/.rad/packages\" 2>/dev/null; fi")
        let _lc = system(link_comp.as_ptr() as str)
    }

    // If package includes native static archive(s) (e.g. libsqlite3.a in rad-sqlite), install to target sysroot lib/
    var sysroot_archive_cmd = String.new()
    sysroot_archive_cmd.push_str("sh -c '")
    sysroot_archive_cmd.push_str("GDIR=\"")
    sysroot_archive_cmd.push_str(global_pkg_dir.as_ptr() as str)
    sysroot_archive_cmd.push_str("\"; ")
    sysroot_archive_cmd.push_str("THOME=\"")
    sysroot_archive_cmd.push_str(env_home as str)
    sysroot_archive_cmd.push_str("/.rad/lib/targets\"; ")
    sysroot_archive_cmd.push_str("if [ -d \"$THOME\" ]; then ")
    sysroot_archive_cmd.push_str("  for tdir in \"$THOME\"/*; do ")
    sysroot_archive_cmd.push_str("    if [ -d \"$tdir/lib\" ]; then ")
    sysroot_archive_cmd.push_str("      if [ -f \"$GDIR/vendor/libsqlite3.a\" ]; then cp -f \"$GDIR/vendor/libsqlite3.a\" \"$tdir/lib/\" 2>/dev/null || true; fi; ")
    sysroot_archive_cmd.push_str("      if [ -f \"$GDIR/libsqlite3.a\" ]; then cp -f \"$GDIR/libsqlite3.a\" \"$tdir/lib/\" 2>/dev/null || true; fi; ")
    sysroot_archive_cmd.push_str("      for af in \"$GDIR\"/vendor/*.a; do [ -f \"$af\" ] && cp -f \"$af\" \"$tdir/lib/\" 2>/dev/null || true; done; ")
    sysroot_archive_cmd.push_str("    fi; ")
    sysroot_archive_cmd.push_str("  done; ")
    sysroot_archive_cmd.push_str("fi; ")
    sysroot_archive_cmd.push_str("'")
    let _sa = system(sysroot_archive_cmd.as_ptr() as str)

    return file_exists(test_global.as_ptr() as str) || file_exists(test_global2.as_ptr() as str)
}

fn cmd_search(query: str) -> i32 {
    let reg_root = sync_registry()
    if reg_root.len() == 0usize {
        println("error: unable to access or sync package registry")
        println("       Check internet connection or ensure rad-lib repository exists.")
        return 1
    }

    var idx_path = String.new()
    idx_path.push_str(reg_root.as_ptr() as str)
    idx_path.push_str("/registry/index.json")

    let content = read_file_str(idx_path.as_ptr() as str)
    if content.len() == 0usize {
        println("error: registry index is empty or unreadable")
        return 1
    }

    let lines = split_source_lines(content)
    println("\x1b[1;36mSearching Rad Package Registry\x1b[0m (GamerxIOEPB/rad-lib):")

    var count = 0
    var cur_name = String.new()
    var cur_desc = String.new()
    var cur_ver = String.new()
    var in_pkg = false

    var i = 0usize
    while i < lines.len {
        let line = lines.ptr[i].as_ptr() as str
        let f_name = extract_json_field(line, "name")
        if f_name.len() > 0usize && cur_name.len() == 0usize {
            cur_name = f_name
            in_pkg = true
        }
        let f_desc = extract_json_field(line, "description")
        if f_desc.len() > 0usize && in_pkg && cur_desc.len() == 0usize {
            cur_desc = f_desc
        }
        let f_ver = extract_json_field(line, "latest")
        if f_ver.len() > 0usize && in_pkg && cur_ver.len() == 0usize {
            cur_ver = f_ver
        }

        if in_pkg && cur_name.len() > 0usize && cur_ver.len() > 0usize && cur_desc.len() > 0usize {
            let name_str = cur_name.as_ptr() as str
            let desc_str = cur_desc.as_ptr() as str
            if str_len(query) == 0usize || str_contains(name_str, query) || str_contains(desc_str, query) {
                var out = String.new()
                out.push_str("  \x1b[1;32m")
                out.push_str(name_str)
                out.push_str("\x1b[0m (v")
                out.push_str(cur_ver.as_ptr() as str)
                out.push_str(")\n    ")
                out.push_str(desc_str)
                println(out.as_ptr() as str)
                count = count + 1
            }
            cur_name = String.new()
            cur_desc = String.new()
            cur_ver = String.new()
            in_pkg = false
        }
        i = i + 1usize
    }

    if count == 0 {
        var no_msg = String.new()
        no_msg.push_str("No packages found matching query '")
        no_msg.push_str(query)
        no_msg.push_str("'.")
        println(no_msg.as_ptr() as str)
    } else {
        println("")
        var total_msg = String.new()
        total_msg.push_str("Found ")
        let c_str = int_to_str(count)
        total_msg.push_str(c_str.as_ptr() as str)
        total_msg.push_str(" matching package(s).")
        println(total_msg.as_ptr() as str)
    }
    return 0
}

fn cmd_info(pkg_name: str) -> i32 {
    if str_len(pkg_name) == 0usize {
        println("error: package name required: `rad info <package>`")
        return 1
    }

    let reg_root = sync_registry()
    if reg_root.len() == 0usize {
        println("error: unable to access package registry")
        return 1
    }

    var idx_path = String.new()
    idx_path.push_str(reg_root.as_ptr() as str)
    idx_path.push_str("/registry/index.json")

    let content = read_file_str(idx_path.as_ptr() as str)
    let lines = split_source_lines(content)

    var cur_name = String.new()
    var cur_desc = String.new()
    var cur_ver = String.new()
    var cur_lic = String.new()
    var found = false

    var i = 0usize
    while i < lines.len {
        let line = lines.ptr[i].as_ptr() as str
        let f_name = extract_json_field(line, "name")
        if f_name.len() > 0usize {
            cur_name = f_name
            cur_desc = String.new()
            cur_ver = String.new()
            cur_lic = String.new()
        }
        let f_desc = extract_json_field(line, "description")
        if f_desc.len() > 0usize && cur_desc.len() == 0usize {
            cur_desc = f_desc
        }
        let f_ver = extract_json_field(line, "latest")
        if f_ver.len() > 0usize && cur_ver.len() == 0usize {
            cur_ver = f_ver
        }
        let f_lic = extract_json_field(line, "license")
        if f_lic.len() > 0usize && cur_lic.len() == 0usize {
            cur_lic = f_lic
        }

        if cur_name.len() > 0usize && (str_eq(cur_name.as_ptr() as str, pkg_name) || (str_starts_with(cur_name.as_ptr() as str, "rad-") && str_eq((cur_name.as_ptr() as usize + 4usize) as str, pkg_name))) {
            if cur_ver.len() > 0usize && cur_desc.len() > 0usize && cur_lic.len() > 0usize {
                found = true
                println("\x1b[1;36mPackage Information:\x1b[0m")
                var p_line = String.new()
                p_line.push_str("  Name:        \x1b[1;32m")
                p_line.push_str(cur_name.as_ptr() as str)
                p_line.push_str("\x1b[0m")
                println(p_line.as_ptr() as str)

                var v_line = String.new()
                v_line.push_str("  Latest:      v")
                v_line.push_str(cur_ver.as_ptr() as str)
                println(v_line.as_ptr() as str)

                var l_line = String.new()
                l_line.push_str("  License:     ")
                l_line.push_str(cur_lic.as_ptr() as str)
                println(l_line.as_ptr() as str)

                println("  Registry:    https://github.com/GamerxIOEPB/rad-lib")
                println("  Repository:  https://github.com/GamerxIOEPB/rad-lib")

                var d_line = String.new()
                d_line.push_str("  Description: ")
                d_line.push_str(cur_desc.as_ptr() as str)
                println(d_line.as_ptr() as str)

                println("")
                println("To install this library for system-wide or project use, run:")
                var add_hint = String.new()
                add_hint.push_str("  rad install ")
                add_hint.push_str(cur_name.as_ptr() as str)
                println(add_hint.as_ptr() as str)
                return 0
            }
        }
        i = i + 1usize
    }

    if !found {
        var err_msg = String.new()
        err_msg.push_str("error: package '")
        err_msg.push_str(pkg_name)
        err_msg.push_str("' was not found in the registry.")
        println(err_msg.as_ptr() as str)
        return 1
    }
    return 0
}

fn cmd_install(single_pkg: str, is_locked: bool) -> i32 {
    let reg_root = sync_registry()
    if reg_root.len() == 0usize {
        println("error: unable to access or sync package registry")
        return 1
    }

    // Case 1: Direct single library install (e.g. `rad install rad-tui` or `rad install tui`)
    if str_len(single_pkg) > 0usize {
        var pkg_name = String.from_str(single_pkg)
        if !str_starts_with(single_pkg, "rad-") && !str_starts_with(single_pkg, "rad_") {
            var with_rad = String.from_str("rad-")
            with_rad.push_str(single_pkg)
            let v_chk = get_package_latest_version(reg_root.as_ptr() as str, with_rad.as_ptr() as str)
            if !str_eq(v_chk.as_ptr() as str, "0.1.0") || file_exists("../rad-lib/packages/rad-tui") {
                pkg_name = with_rad
            }
        }
        let p_str = pkg_name.as_ptr() as str
        let latest_ver = get_package_latest_version(reg_root.as_ptr() as str, p_str)

        println("\x1b[1;36mInstalling Rad Library:\x1b[0m")
        var fetch_msg = String.new()
        fetch_msg.push_str("Downloading ")
        fetch_msg.push_str(p_str)
        fetch_msg.push_str(" v")
        fetch_msg.push_str(latest_ver.as_ptr() as str)
        fetch_msg.push_str(" to ~/.rad/lib/rad/...")
        render_tui_progress(fetch_msg.as_ptr() as str, 45)

        let ok = ensure_library_installed_global(reg_root.as_ptr() as str, p_str, latest_ver.as_ptr() as str)
        if !ok {
            println("")
            var err = String.new()
            err.push_str("error: failed to install library '")
            err.push_str(p_str)
            err.push_str("'")
            println(err.as_ptr() as str)
            return 1
        }

        // If current directory is a Rad project with rad.toml, also copy to ./packages/
        let toml = read_file_str("rad.toml")
        if toml.len() > 0usize {
            render_tui_progress("Linking to local project packages/...", 80)
            let _ = system("mkdir -p packages")
            let env_home = getenv("HOME")
            if (env_home as usize) != 0usize {
                var cp_cmd = String.new()
                cp_cmd.push_str("mkdir -p packages/")
                cp_cmd.push_str(p_str)
                cp_cmd.push_str(" && cp -rf ")
                cp_cmd.push_str(env_home as str)
                cp_cmd.push_str("/.rad/lib/rad/")
                cp_cmd.push_str(p_str)
                cp_cmd.push_str("/* packages/")
                cp_cmd.push_str(p_str)
                cp_cmd.push_str("/ 2>/dev/null")
                let _cp = system(cp_cmd.as_ptr() as str)
            }
            update_lockfile()
        }

        render_tui_progress("Installation complete", 100)
        println("")
        var ok_msg = String.new()
        ok_msg.push_str("  \x1b[1;32m✓\x1b[0m Successfully installed ")
        ok_msg.push_str(p_str)
        ok_msg.push_str(" (v")
        ok_msg.push_str(latest_ver.as_ptr() as str)
        ok_msg.push_str(") to ~/.rad/lib/rad/")
        println(ok_msg.as_ptr() as str)

        if str_eq(p_str, "rad-sqlite") || str_eq(p_str, "sqlite") {
            println("  \x1b[1;32m✓\x1b[0m Provisioned native static library libsqlite3.a to target sysroot")
        }

        var import_name = p_str
        if str_starts_with(p_str, "rad-") {
            import_name = (p_str as usize + 4usize) as str
        }
        var hint_msg = String.new()
        hint_msg.push_str("  You can now use `import ")
        hint_msg.push_str(import_name)
        hint_msg.push_str(";` in any Rad file!")
        println(hint_msg.as_ptr() as str)
        return 0
    }

    // Case 2: Project manifest install (`rad install` inside project with rad.toml)
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        println("       To install a specific library, use: `rad install <package>`")
        return 1
    }

    let lines = split_source_lines(toml)
    var in_dep = false
    var installed_count = 0

    println("\x1b[1;36mResolving Project Dependencies:\x1b[0m")
    render_tui_progress("Reading package manifest...", 15)
    let _ = system("mkdir -p packages")

    var li = 0usize
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            in_dep = true
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
        } else if in_dep && str_len(trimmed) > 0usize && !str_starts_with(trimmed, "#") {
            let dep_name = parse_dep_name(l)
            let dep_ver_req = parse_dep_version(l)
            if dep_name.len() > 0usize {
                let d_name = dep_name.as_ptr() as str
                if str_contains(l, "git =") || str_contains(l, "git=") {
                    let git_url = parse_git_url(l)
                    var prog_msg = String.new()
                    prog_msg.push_str("Resolving ")
                    prog_msg.push_str(d_name)
                    prog_msg.push_str(" (git)")
                    render_tui_progress(prog_msg.as_ptr() as str, 40)

                    let env_home = getenv("HOME")
                    var global_pkg_path = String.new()
                    if (env_home as usize) != 0usize {
                        global_pkg_path.push_str(env_home as str)
                        global_pkg_path.push_str("/.rad/lib/rad/git/")
                        global_pkg_path.push_str(d_name)
                    } else {
                        global_pkg_path.push_str(".rad/lib/rad/git/")
                        global_pkg_path.push_str(d_name)
                    }

                    if !file_exists(global_pkg_path.as_ptr() as str) && git_url.len() > 0usize {
                        let pid = getpid()
                        let pid_str = int_to_str(pid as i64)
                        var stage_dir = String.new()
                        stage_dir.push_str("/tmp/rad_git_stage_")
                        stage_dir.push_str(d_name)
                        stage_dir.push_byte(95u8)
                        stage_dir.push_str(pid_str.as_ptr() as str)

                        var clean_stage = String.new()
                        clean_stage.push_str("rm -rf \"")
                        clean_stage.push_str(stage_dir.as_ptr() as str)
                        clean_stage.push_str("\"")
                        let _ = system(clean_stage.as_ptr() as str)

                        var clone_cmd = String.new()
                        clone_cmd.push_str("git clone --depth 1 \"")
                        clone_cmd.push_str(git_url.as_ptr() as str)
                        clone_cmd.push_str("\" \"")
                        clone_cmd.push_str(stage_dir.as_ptr() as str)
                        clone_cmd.push_str("\" 2>&1")

                        let clone_res = system(clone_cmd.as_ptr() as str)
                        if clone_res != 0 {
                            let _ = system(clean_stage.as_ptr() as str)
                            println("")
                            var err_m = String.new()
                            err_m.push_str("\x1b[1;31mrad: error:\x1b[0m failed to clone git dependency '")
                            err_m.push_str(d_name)
                            err_m.push_str("' from '")
                            err_m.push_str(git_url.as_ptr() as str)
                            err_m.push_str("'\n  Dependency rejected.")
                            println(err_m.as_ptr() as str)
                            return 1
                        }

                        var chk_manifest = String.new()
                        chk_manifest.push_str(stage_dir.as_ptr() as str)
                        chk_manifest.push_str("/rad.toml")

                        var chk_lib = String.new()
                        chk_lib.push_str(stage_dir.as_ptr() as str)
                        chk_lib.push_str("/src/lib.rad")

                        var chk_lib2 = String.new()
                        chk_lib2.push_str(stage_dir.as_ptr() as str)
                        chk_lib2.push_str("/lib.rad")

                        let has_manifest = file_exists(chk_manifest.as_ptr() as str)
                        let has_lib = file_exists(chk_lib.as_ptr() as str) || file_exists(chk_lib2.as_ptr() as str)

                        if !has_manifest && !has_lib {
                            let _ = system(clean_stage.as_ptr() as str)
                            println("")
                            var err_m = String.new()
                            err_m.push_str("\x1b[1;31mrad: error:\x1b[0m git repository for '")
                            err_m.push_str(d_name)
                            err_m.push_str("' is not a valid Rad package.\n")
                            err_m.push_str("  Missing 'rad.toml' manifest or library entrypoint ('src/lib.rad' / 'lib.rad').\n  Dependency rejected.")
                            println(err_m.as_ptr() as str)
                            return 1
                        }

                        var mv_cmd = String.new()
                        mv_cmd.push_str("mkdir -p \"${HOME}/.rad/lib/rad/git\" && rm -rf \"")
                        mv_cmd.push_str(global_pkg_path.as_ptr() as str)
                        mv_cmd.push_str("\" && mv \"")
                        mv_cmd.push_str(stage_dir.as_ptr() as str)
                        mv_cmd.push_str("\" \"")
                        mv_cmd.push_str(global_pkg_path.as_ptr() as str)
                        mv_cmd.push_str("\"")
                        let _ = system(mv_cmd.as_ptr() as str)
                    }

                    var link_cmd = String.new()
                    link_cmd.push_str("mkdir -p packages && ln -sfn \"")
                    link_cmd.push_str(global_pkg_path.as_ptr() as str)
                    link_cmd.push_str("\" \"packages/")
                    link_cmd.push_str(d_name)
                    link_cmd.push_str("\"")
                    let _ = system(link_cmd.as_ptr() as str)

                    installed_count = installed_count + 1
                } else {
                    let resolved_ver = clean_semver_req(dep_ver_req.as_ptr() as str)

                    var prog_msg = String.new()
                    prog_msg.push_str("Resolving ")
                    prog_msg.push_str(d_name)
                    prog_msg.push_str(" v")
                    prog_msg.push_str(resolved_ver.as_ptr() as str)
                    render_tui_progress(prog_msg.as_ptr() as str, 40)

                    // 1. Install globally to ~/.rad/lib/rad/
                    let ok = ensure_library_installed_global(reg_root.as_ptr() as str, d_name, resolved_ver.as_ptr() as str)
                    if !ok {
                        println("")
                        var fail_msg = String.new()
                        fail_msg.push_str("error: package '")
                        fail_msg.push_str(d_name)
                        fail_msg.push_str("' version '")
                        fail_msg.push_str(resolved_ver.as_ptr() as str)
                        fail_msg.push_str("' could not be resolved or downloaded")
                        println(fail_msg.as_ptr() as str)
                        return 1
                    }

                    // 2. Copy into local project ./packages/<d_name>/
                    render_tui_progress("Copying to ./packages/...", 70)
                    let env_home = getenv("HOME")
                    if (env_home as usize) != 0usize {
                        var copy_cmd = String.new()
                        copy_cmd.push_str("mkdir -p packages/")
                        copy_cmd.push_str(d_name)
                        copy_cmd.push_str(" && cp -rf ")
                        copy_cmd.push_str(env_home as str)
                        copy_cmd.push_str("/.rad/lib/rad/")
                        copy_cmd.push_str(d_name)
                        copy_cmd.push_str("/* packages/")
                        copy_cmd.push_str(d_name)
                        copy_cmd.push_str("/ 2>/dev/null")
                        let _c = system(copy_cmd.as_ptr() as str)
                    }

                    installed_count = installed_count + 1
                }
            }
        }
        li = li + 1usize
    }

    render_tui_progress("Generating lockfile (rad.lock)...", 90)
    update_lockfile()
    render_tui_progress("Installation complete", 100)
    println("")

    var done_msg = String.new()
    done_msg.push_str("  \x1b[1;32m✓\x1b[0m Successfully installed ")
    let ic_str = int_to_str(installed_count)
    done_msg.push_str(ic_str.as_ptr() as str)
    done_msg.push_str(" package(s).")
    println(done_msg.as_ptr() as str)
    return 0
}

fn cmd_add(pkg_spec: str) -> i32 {
    if str_len(pkg_spec) == 0usize {
        println("error: package name required: `rad add <package>`")
        return 1
    }

    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    let is_git = str_starts_with(pkg_spec, "https://") || str_starts_with(pkg_spec, "http://") || str_starts_with(pkg_spec, "git@") || str_ends_with(pkg_spec, ".git")
    if is_git {
        let repo_name = extract_git_repo_name(pkg_spec)
        if repo_name.len() == 0usize {
            println("\x1b[1;31mrad: error:\x1b[0m could not determine package name from git repository URL")
            return 1
        }

        println("\x1b[1;36mAdding Git Dependency:\x1b[0m")
        var adding_msg = String.new()
        adding_msg.push_str("  Package: ")
        adding_msg.push_str(repo_name.as_ptr() as str)
        adding_msg.push_str(" (git: ")
        adding_msg.push_str(pkg_spec)
        adding_msg.push_str(")")
        println(adding_msg.as_ptr() as str)

        // 1. Stage clone into isolated temporary staging directory
        let pid = getpid()
        let pid_str = int_to_str(pid as i64)
        var stage_dir = String.new()
        stage_dir.push_str("/tmp/rad_git_stage_")
        stage_dir.push_str(repo_name.as_ptr() as str)
        stage_dir.push_byte(95u8) // '_'
        stage_dir.push_str(pid_str.as_ptr() as str)

        var clean_stage = String.new()
        clean_stage.push_str("rm -rf \"")
        clean_stage.push_str(stage_dir.as_ptr() as str)
        clean_stage.push_str("\"")
        let _ = system(clean_stage.as_ptr() as str)

        println("  Cloning remote git repository...")
        var clone_cmd = String.new()
        clone_cmd.push_str("git clone --depth 1 \"")
        clone_cmd.push_str(pkg_spec)
        clone_cmd.push_str("\" \"")
        clone_cmd.push_str(stage_dir.as_ptr() as str)
        clone_cmd.push_str("\" 2>&1")

        let clone_res = system(clone_cmd.as_ptr() as str)
        if clone_res != 0 {
            let _ = system(clean_stage.as_ptr() as str)
            println("")
            var err_m = String.new()
            err_m.push_str("\x1b[1;31mrad: error:\x1b[0m failed to clone git repository '")
            err_m.push_str(pkg_spec)
            err_m.push_str("'\n  Verify that the repository URL exists and is publicly accessible.\n  Dependency rejected: no changes made to rad.toml or rad.lock.")
            println(err_m.as_ptr() as str)
            return 1
        }

        // 2. Validate repository contents to ensure it is a valid Rad package
        var chk_manifest = String.new()
        chk_manifest.push_str(stage_dir.as_ptr() as str)
        chk_manifest.push_str("/rad.toml")

        var chk_lib = String.new()
        chk_lib.push_str(stage_dir.as_ptr() as str)
        chk_lib.push_str("/src/lib.rad")

        var chk_lib2 = String.new()
        chk_lib2.push_str(stage_dir.as_ptr() as str)
        chk_lib2.push_str("/lib.rad")

        let has_manifest = file_exists(chk_manifest.as_ptr() as str)
        let has_lib = file_exists(chk_lib.as_ptr() as str) || file_exists(chk_lib2.as_ptr() as str)

        if !has_manifest && !has_lib {
            let _ = system(clean_stage.as_ptr() as str)
            println("")
            var err_m = String.new()
            err_m.push_str("\x1b[1;31mrad: error:\x1b[0m repository '")
            err_m.push_str(pkg_spec)
            err_m.push_str("' is not a valid Rad package.\n")
            err_m.push_str("  Missing package manifest ('rad.toml') or library entrypoint ('src/lib.rad' / 'lib.rad').\n")
            err_m.push_str("  Dependency rejected: no changes made to rad.toml or rad.lock.")
            println(err_m.as_ptr() as str)
            return 1
        }

        // 3. Promote staged repository to ~/.rad/lib/rad/git/<repo_name>
        let env_home = getenv("HOME")
        var dest_dir = String.new()
        if (env_home as usize) != 0usize {
            dest_dir.push_str(env_home as str)
            dest_dir.push_str("/.rad/lib/rad/git/")
            dest_dir.push_str(repo_name.as_ptr() as str)
        } else {
            dest_dir.push_str(".rad/lib/rad/git/")
            dest_dir.push_str(repo_name.as_ptr() as str)
        }

        var mv_cmd = String.new()
        mv_cmd.push_str("mkdir -p \"${HOME}/.rad/lib/rad/git\" && rm -rf \"")
        mv_cmd.push_str(dest_dir.as_ptr() as str)
        mv_cmd.push_str("\" && mv \"")
        mv_cmd.push_str(stage_dir.as_ptr() as str)
        mv_cmd.push_str("\" \"")
        mv_cmd.push_str(dest_dir.as_ptr() as str)
        mv_cmd.push_str("\"")
        let _ = system(mv_cmd.as_ptr() as str)

        var link_cmd = String.new()
        link_cmd.push_str("mkdir -p packages && ln -sfn \"")
        link_cmd.push_str(dest_dir.as_ptr() as str)
        link_cmd.push_str("\" \"packages/")
        link_cmd.push_str(repo_name.as_ptr() as str)
        link_cmd.push_str("\"")
        let _ = system(link_cmd.as_ptr() as str)

        var new_dep_line = String.new()
        new_dep_line.push_str(repo_name.as_ptr() as str)
        new_dep_line.push_str(" = { git = \"")
        new_dep_line.push_str(pkg_spec)
        new_dep_line.push_str("\" }")

        let lines = split_source_lines(toml)
        var has_dep_section = false
        var dep_line_idx = 0usize
        var already_exists_idx = 0usize
        var already_exists = false

        var li = 0usize
        var in_dep = false
        while li < lines.len {
            let l = lines.ptr[li].as_ptr() as str
            let trimmed = trim_line_start(l)
            if str_starts_with(trimmed, "[dependencies]") {
                has_dep_section = true
                in_dep = true
                dep_line_idx = li
            } else if str_starts_with(trimmed, "[") {
                in_dep = false
            } else if in_dep {
                let dep_name = parse_dep_name(l)
                if str_eq(dep_name.as_ptr() as str, repo_name.as_ptr() as str) {
                    already_exists = true
                    already_exists_idx = li
                }
            }
            li = li + 1usize
        }

        var new_toml = String.new()
        if already_exists {
            li = 0usize
            while li < lines.len {
                if li == already_exists_idx {
                    new_toml.push_str(new_dep_line.as_ptr() as str)
                } else {
                    new_toml.push_str(lines.ptr[li].as_ptr() as str)
                }
                new_toml.push_byte(10u8)
                li = li + 1usize
            }
        } else if has_dep_section {
            li = 0usize
            while li < lines.len {
                new_toml.push_str(lines.ptr[li].as_ptr() as str)
                new_toml.push_byte(10u8)
                if li == dep_line_idx {
                    new_toml.push_str(new_dep_line.as_ptr() as str)
                    new_toml.push_byte(10u8)
                }
                li = li + 1usize
            }
        } else {
            li = 0usize
            while li < lines.len {
                new_toml.push_str(lines.ptr[li].as_ptr() as str)
                new_toml.push_byte(10u8)
                li = li + 1usize
            }
            new_toml.push_str("\n[dependencies]\n")
            new_toml.push_str(new_dep_line.as_ptr() as str)
            new_toml.push_byte(10u8)
        }

        write_file_str("rad.toml", new_toml.as_ptr() as str)
        println("  Updated `rad.toml`")
        update_lockfile()
        println("  Updated `rad.lock`")
        println("  \x1b[1;32m✓\x1b[0m Added Git dependency successfully!")
        return 0
    }

    var pkg_name = String.new()
    var pkg_ver = String.new()
    let p_spec = pkg_spec as *raw u8
    let spec_len = str_len(pkg_spec)
    var at_pos = 0usize
    var has_at = false
    var i = 0usize
    while i < spec_len {
        if p_spec[i] == 64u8 { // '@'
            at_pos = i
            has_at = true
            i = spec_len
        } else {
            pkg_name.push_byte(p_spec[i])
            i = i + 1usize
        }
    }

    let reg_root = sync_registry()
    if has_at {
        var v_idx = at_pos + 1usize
        while v_idx < spec_len {
            pkg_ver.push_byte(p_spec[v_idx])
            v_idx = v_idx + 1usize
        }
    } else {
        if reg_root.len() > 0usize {
            pkg_ver = get_package_latest_version(reg_root.as_ptr() as str, pkg_name.as_ptr() as str)
        } else {
            pkg_ver = String.from_str("0.1.0")
        }
    }

    println("\x1b[1;36mAdding Dependency:\x1b[0m")
    var adding_msg = String.new()
    adding_msg.push_str("  Package: ")
    adding_msg.push_str(pkg_name.as_ptr() as str)
    adding_msg.push_str(" ^")
    adding_msg.push_str(pkg_ver.as_ptr() as str)
    println(adding_msg.as_ptr() as str)

    let lines = split_source_lines(toml)
    var has_dep_section = false
    var dep_line_idx = 0usize
    var already_exists_idx = 0usize
    var already_exists = false

    var li = 0usize
    var in_dep = false
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            has_dep_section = true
            in_dep = true
            dep_line_idx = li
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
        } else if in_dep {
            let dep_name = parse_dep_name(l)
            if str_eq(dep_name.as_ptr() as str, pkg_name.as_ptr() as str) {
                already_exists = true
                already_exists_idx = li
            }
        }
        li = li + 1usize
    }

    var new_dep_line = String.new()
    new_dep_line.push_str(pkg_name.as_ptr() as str)
    new_dep_line.push_str(" = \"^")
    new_dep_line.push_str(pkg_ver.as_ptr() as str)
    new_dep_line.push_str("\"")

    var new_toml = String.new()
    if already_exists {
        li = 0usize
        while li < lines.len {
            if li == already_exists_idx {
                new_toml.push_str(new_dep_line.as_ptr() as str)
            } else {
                new_toml.push_str(lines.ptr[li].as_ptr() as str)
            }
            new_toml.push_byte(10u8)
            li = li + 1usize
        }
    } else if has_dep_section {
        li = 0usize
        while li < lines.len {
            new_toml.push_str(lines.ptr[li].as_ptr() as str)
            new_toml.push_byte(10u8)
            if li == dep_line_idx {
                new_toml.push_str(new_dep_line.as_ptr() as str)
                new_toml.push_byte(10u8)
            }
            li = li + 1usize
        }
    } else {
        li = 0usize
        while li < lines.len {
            new_toml.push_str(lines.ptr[li].as_ptr() as str)
            new_toml.push_byte(10u8)
            li = li + 1usize
        }
        new_toml.push_str("\n[dependencies]\n")
        new_toml.push_str(new_dep_line.as_ptr() as str)
        new_toml.push_byte(10u8)
    }

    write_file_str("rad.toml", new_toml.as_ptr() as str)
    println("  Updated `rad.toml`")

    return cmd_install(pkg_name.as_ptr() as str, false)
}

fn cmd_remove(pkg_name: str) -> i32 {
    if str_len(pkg_name) == 0usize {
        println("error: package name required: `rad remove <package>`")
        return 1
    }

    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    let lines = split_source_lines(toml)
    var new_toml = String.new()
    var removed = false
    var in_dep = false

    var li = 0usize
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            in_dep = true
            new_toml.push_str(l)
            new_toml.push_byte(10u8)
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
            new_toml.push_str(l)
            new_toml.push_byte(10u8)
        } else if in_dep {
            let dep_name = parse_dep_name(l)
            let dn = dep_name.as_ptr() as str
            var matches = false
            if str_eq(dn, pkg_name) {
                matches = true
            } else if str_starts_with(pkg_name, "rad-") && str_eq(dn, (pkg_name as usize + 4usize) as str) {
                matches = true
            } else if str_starts_with(dn, "rad-") && str_eq((dn as usize + 4usize) as str, pkg_name) {
                matches = true
            }

            if matches {
                removed = true
            } else {
                new_toml.push_str(l)
                new_toml.push_byte(10u8)
            }
        } else {
            new_toml.push_str(l)
            new_toml.push_byte(10u8)
        }
        li = li + 1usize
    }

    if !removed {
        var not_msg = String.new()
        not_msg.push_str("warning: package '")
        not_msg.push_str(pkg_name)
        not_msg.push_str("' not found in `rad.toml` [dependencies]")
        println(not_msg.as_ptr() as str)
    } else {
        write_file_str("rad.toml", new_toml.as_ptr() as str)
    }

    // Clean up local packages directory and symlinks
    var rm_cmd = String.new()
    rm_cmd.push_str("rm -rf packages/")
    rm_cmd.push_str(pkg_name)
    let _r = system(rm_cmd.as_ptr() as str)

    if str_starts_with(pkg_name, "rad-") {
        var rm_alias = String.new()
        rm_alias.push_str("rm -rf packages/")
        rm_alias.push_str((pkg_name as usize + 4usize) as str)
        let _ra = system(rm_alias.as_ptr() as str)
    } else {
        var rm_can = String.new()
        rm_can.push_str("rm -rf packages/rad-")
        rm_can.push_str(pkg_name)
        let _rc = system(rm_can.as_ptr() as str)
    }

    update_lockfile()

    var ok_msg = String.new()
    ok_msg.push_str("  \x1b[1;32m✓\x1b[0m Removed dependency '")
    ok_msg.push_str(pkg_name)
    ok_msg.push_str("'")
    println(ok_msg.as_ptr() as str)
    return 0
}

fn cmd_update_pkg(argc: i32, argv: *raw *raw u8) -> i32 {
    println("\x1b[1;36mUpdating Dependencies:\x1b[0m")
    render_tui_progress("Checking registry for updates...", 25)
    var single_pkg = ""
    if argc >= 3 && !str_starts_with(argv[2] as str, "-") {
        single_pkg = argv[2] as str
    }
    let res = cmd_install(single_pkg, false)
    if res == 0 {
        render_tui_progress("Dependencies updated", 100)
        println("")
        println("  \x1b[1;32m✓\x1b[0m All dependencies successfully updated to latest compatible versions.")
    }
    return res
}

fn cmd_list(is_global: bool) -> i32 {
    if !is_global {
        let toml = read_file_str("rad.toml")
        if toml.len() == 0usize {
            println("error: could not find `rad.toml` in current directory")
            return 1
        }

        let lines = split_source_lines(toml)
        var in_dep = false
        var dep_count = 0
        println("\x1b[1;36mDeclared Dependencies:\x1b[0m")

        var li = 0usize
        while li < lines.len {
            let l = lines.ptr[li].as_ptr() as str
            let trimmed = trim_line_start(l)
            if str_starts_with(trimmed, "[dependencies]") {
                in_dep = true
            } else if str_starts_with(trimmed, "[") {
                in_dep = false
            } else if in_dep && str_len(trimmed) > 0usize && !str_starts_with(trimmed, "#") {
                let dep_name = parse_dep_name(l)
                let dep_ver = parse_dep_version(l)
                if dep_name.len() > 0usize {
                    dep_count = dep_count + 1
                    var out = String.new()
                    out.push_str("  * \x1b[1;32m")
                    out.push_str(dep_name.as_ptr() as str)
                    out.push_str("\x1b[0m = \"")
                    out.push_str(dep_ver.as_ptr() as str)
                    out.push_str("\"")

                    var chk_path = String.new()
                    chk_path.push_str("packages/")
                    chk_path.push_str(dep_name.as_ptr() as str)
                    chk_path.push_str("/src/lib.rad")
                    if file_exists(chk_path.as_ptr() as str) {
                        out.push_str(" \x1b[90m[installed]\x1b[0m")
                    } else {
                        out.push_str(" \x1b[33m[missing: run `rad install`]\x1b[0m")
                    }
                    println(out.as_ptr() as str)
                }
            }
            li = li + 1usize
        }

        if dep_count == 0 {
            println("  (no dependencies configured)")
        }
        return 0
    }

    var global_dir = String.new()
    let env_rad = getenv("RAD_HOME")
    if (env_rad as usize) != 0usize && str_len(env_rad as str) > 0usize {
        global_dir.push_str(env_rad as str)
        global_dir.push_str("/lib/rad")
    } else {
        let env_home = getenv("HOME")
        if (env_home as usize) != 0usize {
            global_dir.push_str(env_home as str)
            global_dir.push_str("/.rad/lib/rad")
        } else {
            global_dir.push_str("/usr/local/lib/rad")
        }
    }

    if !file_exists(global_dir.as_ptr() as str) {
        println("error: global library directory not found")
        return 1
    }

    var tmp_file = String.new()
    tmp_file.push_str("/tmp/.rad_global_pkgs_")
    let pid = getpid()
    let pid_str = int_to_str(pid)
    tmp_file.push_str(pid_str.as_ptr() as str)
    tmp_file.push_str(".txt")

    var cmd = String.new()
    cmd.push_str("find -L \"")
    cmd.push_str(global_dir.as_ptr() as str)
    cmd.push_str("\" -maxdepth 1 -mindepth 1 -type d > \"")
    cmd.push_str(tmp_file.as_ptr() as str)
    cmd.push_str("\" 2>/dev/null")
    let _s = system(cmd.as_ptr() as str)

    let out_content = read_file_str(tmp_file.as_ptr() as str)
    var rm_cmd = String.new()
    rm_cmd.push_str("rm -f \"")
    rm_cmd.push_str(tmp_file.as_ptr() as str)
    rm_cmd.push_str("\"")
    let _rm = system(rm_cmd.as_ptr() as str)

    println("\x1b[1;36mGlobally Installed Packages:\x1b[0m")
    let lines = split_source_lines(out_content)
    var count = 0
    var li = 0usize
    while li < lines.len {
        let p = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(p)
        if str_len(trimmed) > 0usize {
            let base = path_basename(trimmed)
            let b_str = base.as_ptr() as str
            if !str_eq(b_str, "core") &&
               !str_eq(b_str, "alloc") &&
               !str_eq(b_str, "std") &&
               !str_eq(b_str, "targets") &&
               !str_eq(b_str, "git") &&
               !str_eq(b_str, "bin") &&
               !str_eq(b_str, "lib") {
                var pkg_toml = String.new()
                pkg_toml.push_str(trimmed)
                pkg_toml.push_str("/rad.toml")
                var ver = String.new()
                if file_exists(pkg_toml.as_ptr() as str) {
                    let toml_str = read_file_str(pkg_toml.as_ptr() as str)
                    let tlines = split_source_lines(toml_str)
                    var tli = 0usize
                    while tli < tlines.len {
                        let tl = tlines.ptr[tli].as_ptr() as str
                        let t_trim = trim_line_start(tl)
                        if str_starts_with(t_trim, "version") {
                            ver = parse_dep_version(t_trim)
                        }
                        tli = tli + 1usize
                    }
                }
                var out = String.new()
                out.push_str("  * \x1b[1;32m")
                out.push_str(b_str)
                out.push_str("\x1b[0m")
                if ver.len() > 0usize {
                    out.push_str(" (v")
                    out.push_str(ver.as_ptr() as str)
                    out.push_str(")")
                }
                println(out.as_ptr() as str)
                count = count + 1
            }
        }
        li = li + 1usize
    }

    if count == 0 {
        println("  (no global packages installed)")
    }
    return 0
}

fn print_dep_tree_node(reg_root: str, dep_name: str, ver_req: str, prefix: str, is_last: bool, depth: i32) {
    var line = String.new()
    line.push_str(prefix)
    if is_last {
        line.push_str("└── \x1b[1;32m")
    } else {
        line.push_str("├── \x1b[1;32m")
    }
    line.push_str(dep_name)
    line.push_str("\x1b[0m v")
    let clean_v = clean_semver_req(ver_req)
    line.push_str(clean_v.as_ptr() as str)
    println(line.as_ptr() as str)

    if depth >= 5 {
        return
    }

    // Try finding dep_name's rad.toml in packages/ or ~/.rad/packages/
    var sub_toml_path = String.new()
    var p1 = String.new()
    p1.push_str("packages/")
    p1.push_str(dep_name)
    p1.push_str("/rad.toml")
    if file_exists(p1.as_ptr() as str) {
        sub_toml_path = p1
    } else {
        var p2 = String.new()
        p2.push_str("packages/rad-")
        p2.push_str(dep_name)
        p2.push_str("/rad.toml")
        if file_exists(p2.as_ptr() as str) {
            sub_toml_path = p2
        } else {
            let env_home = getenv("HOME")
            if (env_home as usize) != 0usize {
                var p3a = String.new()
                p3a.push_str(env_home as str)
                p3a.push_str("/.rad/lib/rad/")
                p3a.push_str(dep_name)
                p3a.push_str("/rad.toml")
                if file_exists(p3a.as_ptr() as str) {
                    sub_toml_path = p3a
                } else {
                    var p4a = String.new()
                    p4a.push_str(env_home as str)
                    p4a.push_str("/.rad/lib/rad/rad-")
                    p4a.push_str(dep_name)
                    p4a.push_str("/rad.toml")
                    if file_exists(p4a.as_ptr() as str) {
                        sub_toml_path = p4a
                    } else {
                        var p3 = String.new()
                        p3.push_str(env_home as str)
                        p3.push_str("/.rad/packages/")
                        p3.push_str(dep_name)
                        p3.push_str("/rad.toml")
                        if file_exists(p3.as_ptr() as str) {
                            sub_toml_path = p3
                        } else {
                            var p4 = String.new()
                            p4.push_str(env_home as str)
                            p4.push_str("/.rad/packages/rad-")
                            p4.push_str(dep_name)
                            p4.push_str("/rad.toml")
                            if file_exists(p4.as_ptr() as str) {
                                sub_toml_path = p4
                            }
                        }
                    }
                }
            }
        }
    }

    if sub_toml_path.len() == 0usize {
        return
    }

    let sub_toml_content = read_file_str(sub_toml_path.as_ptr() as str)
    if sub_toml_content.len() == 0usize {
        return
    }

    let sub_parsed = TomlValue.parse(sub_toml_content.as_ptr() as str)
    match sub_parsed {
        Result.Ok(sub_doc) => {
            let sub_deps = sub_doc.get_table("dependencies")
            match sub_deps {
                Option.Some(s_tbl) => {
                    var child_prefix = String.new()
                    child_prefix.push_str(prefix)
                    if is_last {
                        child_prefix.push_str("    ")
                    } else {
                        child_prefix.push_str("│   ")
                    }
                    var j = 0usize
                    while j < s_tbl.table_val.len {
                        let c_last = (j + 1usize == s_tbl.table_val.len)
                        let c_member = s_tbl.table_val.ptr[j]
                        let c_name = c_member.key.as_ptr() as str
                        var c_ver = ""
                        if c_member.val.kind == TOML_STRING {
                            c_ver = c_member.val.as_str()
                        } else if c_member.val.kind == TOML_TABLE {
                            c_ver = c_member.val.get_str("version")
                        }
                        print_dep_tree_node(reg_root, c_name, c_ver, child_prefix.as_ptr() as str, c_last, depth + 1)
                        j = j + 1usize
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }
}

fn cmd_tree() -> i32 {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    let parsed_res = TomlValue.parse(toml.as_ptr() as str)
    var proj_name = "app"
    var proj_ver = "0.1.0"
    match parsed_res {
        Result.Ok(doc) => {
            let n = doc.get_str("package.name")
            if str_len(n) > 0usize { proj_name = n }
            let v = doc.get_str("package.version")
            if str_len(v) > 0usize { proj_ver = v }

            var root_hdr = String.new()
            root_hdr.push_str("\x1b[1;36m")
            root_hdr.push_str(proj_name)
            root_hdr.push_str(" v")
            root_hdr.push_str(proj_ver)
            root_hdr.push_str("\x1b[0m")
            println(root_hdr.as_ptr() as str)

            let dep_opt = doc.get_table("dependencies")
            match dep_opt {
                Option.Some(dep_tbl) => {
                    let reg_root = get_registry_root()
                    var i = 0usize
                    while i < dep_tbl.table_val.len {
                        let is_last = (i + 1usize == dep_tbl.table_val.len)
                        let dep_member = dep_tbl.table_val.ptr[i]
                        let d_name = dep_member.key.as_ptr() as str
                        var d_ver = ""
                        if dep_member.val.kind == TOML_STRING {
                            d_ver = dep_member.val.as_str()
                        } else if dep_member.val.kind == TOML_TABLE {
                            let git_url = dep_member.val.get_str("git")
                            if str_len(git_url) > 0usize {
                                d_ver = "git"
                            } else {
                                d_ver = dep_member.val.get_str("version")
                            }
                        }
                        print_dep_tree_node(reg_root.as_ptr() as str, d_name, d_ver, "", is_last, 0)
                        i = i + 1usize
                    }
                },
                _ => {},
            }
        },
        Result.Err(e) => {
            println("error: failed to parse rad.toml:")
            println(e.as_ptr() as str)
            return 1
        }
    }
    return 0
}

fn cmd_outdated() -> i32 {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    let reg_root = sync_registry()
    if reg_root.len() == 0usize {
        println("error: unable to access package registry")
        return 1
    }

    let lines = split_source_lines(toml)
    var in_dep = false
    var any_outdated = false

    var li = 0usize
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            in_dep = true
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
        } else if in_dep && str_len(trimmed) > 0usize && !str_starts_with(trimmed, "#") {
            let dep_name = parse_dep_name(l)
            let dep_ver = parse_dep_version(l)
            if dep_name.len() > 0usize {
                let d_name = dep_name.as_ptr() as str
                let cur_ver = clean_semver_req(dep_ver.as_ptr() as str)
                let latest_ver = get_package_latest_version(reg_root.as_ptr() as str, d_name)

                let cmp = compare_semver(cur_ver.as_ptr() as str, latest_ver.as_ptr() as str)
                if cmp < 0 {
                    any_outdated = true
                    var out = String.new()
                    out.push_str("  \x1b[33m➜\x1b[0m ")
                    out.push_str(d_name)
                    out.push_str(": v")
                    out.push_str(cur_ver.as_ptr() as str)
                    out.push_str(" -> \x1b[1;32mv")
                    out.push_str(latest_ver.as_ptr() as str)
                    out.push_str("\x1b[0m (update available)")
                    println(out.as_ptr() as str)
                }
            }
        }
        li = li + 1usize
    }

    if !any_outdated {
        println("  \x1b[1;32m✓\x1b[0m All dependencies are up to date.")
    }
    return 0
}

fn cmd_cache(argc: i32, argv: *raw *raw u8) -> i32 {
    var sub = "list"
    if argc >= 3 {
        sub = argv[2] as str
    }

    let env_home = getenv("HOME")
    if (env_home as usize) == 0usize {
        println("error: $HOME not defined")
        return 1
    }

    var cache_dir = String.new()
    cache_dir.push_str(env_home as str)
    cache_dir.push_str("/.rad/cache")

    if str_eq(sub, "clean") {
        var rm_cmd = String.new()
        rm_cmd.push_str("rm -rf ")
        rm_cmd.push_str(cache_dir.as_ptr() as str)
        rm_cmd.push_str("/*")
        let _r = system(rm_cmd.as_ptr() as str)
        println("  \x1b[1;32m✓\x1b[0m Package cache cleared successfully.")
        return 0
    }

    println("\x1b[1;36mPackage Cache Location:\x1b[0m")
    var loc = String.new()
    loc.push_str("  ")
    loc.push_str(cache_dir.as_ptr() as str)
    println(loc.as_ptr() as str)

    var ls_cmd = String.new()
    ls_cmd.push_str("ls -l ")
    ls_cmd.push_str(cache_dir.as_ptr() as str)
    ls_cmd.push_str("/packages 2>/dev/null || echo '  (cache is empty)'")
    let _l = system(ls_cmd.as_ptr() as str)
    return 0
}

fn cmd_publish(is_confirm: bool) -> i32 {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    println("\x1b[1;36mValidating package for publication...\x1b[0m")

    if !file_exists("src/lib.rad") && !file_exists("src/main.rad") {
        println("error: package must contain `src/lib.rad` or `src/main.rad`")
        return 1
    }

    var pkg_name = String.new()
    var pkg_ver = String.new()
    var pkg_desc = String.new()
    var pkg_lic = String.new()

    let parsed_res = TomlValue.parse(toml.as_ptr() as str)
    match parsed_res {
        Result.Ok(doc) => {
            let n = doc.get_str("package.name")
            if str_len(n) > 0usize { pkg_name = String.from_str(n) }
            let v = doc.get_str("package.version")
            if str_len(v) > 0usize { pkg_ver = String.from_str(v) }
            let d = doc.get_str("package.description")
            if str_len(d) > 0usize { pkg_desc = String.from_str(d) }
            let l = doc.get_str("package.license")
            if str_len(l) > 0usize { pkg_lic = String.from_str(l) }
        },
        Result.Err(e) => {
            println("error: invalid rad.toml:")
            println(e.as_ptr() as str)
            return 1
        }
    }

    if pkg_name.len() == 0usize {
        println("error: missing `name` field in [package] section of rad.toml")
        return 1
    }
    if pkg_ver.len() == 0usize {
        println("error: missing `version` field in [package] section of rad.toml")
        return 1
    }
    if pkg_desc.len() == 0usize {
        pkg_desc = String.from_str("Rad package")
    }
    if pkg_lic.len() == 0usize {
        pkg_lic = String.from_str("MIT")
    }

    println("  \x1b[1;32m✓\x1b[0m Manifest `rad.toml` present")
    var name_msg = String.from_str("  \x1b[1;32m✓\x1b[0m Package: ")
    name_msg.push_str(pkg_name.as_ptr() as str)
    name_msg.push_str(" v")
    name_msg.push_str(pkg_ver.as_ptr() as str)
    println(name_msg.as_ptr() as str)
    if file_exists("src/lib.rad") {
        println("  \x1b[1;32m✓\x1b[0m Library entry point `src/lib.rad` found")
    } else {
        println("  \x1b[1;32m✓\x1b[0m Binary entry point `src/main.rad` found")
    }

    if !is_confirm {
        println("")
        println("Package is valid and ready for publication.")
        println("To publish this package to the registry, run:")
        println("  rad package publish --confirm")
        return 0
    }

    println("")
    println("\x1b[1;36mPublishing package...\x1b[0m")

    // 1. Install to local toolchain directory ~/.rad/lib/rad/<pkg_name>
    let env_home = getenv("HOME")
    if (env_home as usize) != 0usize {
        var local_dest = String.new()
        local_dest.push_str(env_home as str)
        local_dest.push_str("/.rad/lib/rad/")
        local_dest.push_str(pkg_name.as_ptr() as str)

        var cp_cmd = String.new()
        cp_cmd.push_str("mkdir -p ")
        cp_cmd.push_str(local_dest.as_ptr() as str)
        cp_cmd.push_str(" && cp -rf rad.toml src ")
        if file_exists("README.md") {
            cp_cmd.push_str("README.md ")
        }
        if file_exists("LICENSE") {
            cp_cmd.push_str("LICENSE ")
        }
        cp_cmd.push_str(local_dest.as_ptr() as str)
        cp_cmd.push_str("/")
        let _ = system(cp_cmd.as_ptr() as str)
        println("  \x1b[1;32m✓\x1b[0m Installed to local toolchain (~/.rad/lib/rad/)")
    }

    // 2. Stage into local rad-lib registry repository
    let reg_root = get_registry_root()
    if reg_root.len() > 0usize {
        var reg_dest = String.new()
        reg_dest.push_str(reg_root.as_ptr() as str)
        reg_dest.push_str("/packages/")
        reg_dest.push_str(pkg_name.as_ptr() as str)
        reg_dest.push_str("/")
        reg_dest.push_str(pkg_ver.as_ptr() as str)

        var reg_cp = String.new()
        reg_cp.push_str("mkdir -p ")
        reg_cp.push_str(reg_dest.as_ptr() as str)
        reg_cp.push_str(" && cp -rf rad.toml src ")
        if file_exists("README.md") {
            reg_cp.push_str("README.md ")
        }
        if file_exists("LICENSE") {
            reg_cp.push_str("LICENSE ")
        }
        reg_cp.push_str(reg_dest.as_ptr() as str)
        reg_cp.push_str("/")
        let _ = system(reg_cp.as_ptr() as str)

        var stage_msg = String.from_str("  \x1b[1;32m✓\x1b[0m Staged to registry repository (")
        stage_msg.push_str(reg_dest.as_ptr() as str)
        stage_msg.push_str(")")
        println(stage_msg.as_ptr() as str)

        // 3. Update registry index.json
        var py_upd = String.new()
        py_upd.push_str("python3 -c \"import json, os, hashlib; ")
        py_upd.push_str("p_name = '")
        py_upd.push_str(pkg_name.as_ptr() as str)
        py_upd.push_str("'; p_ver = '")
        py_upd.push_str(pkg_ver.as_ptr() as str)
        py_upd.push_str("'; p_desc = '")
        py_upd.push_str(pkg_desc.as_ptr() as str)
        py_upd.push_str("'; p_lic = '")
        py_upd.push_str(pkg_lic.as_ptr() as str)
        py_upd.push_str("'; idx_path = '")
        py_upd.push_str(reg_root.as_ptr() as str)
        py_upd.push_str("/registry/index.json'; ")
        py_upd.push_str("f_in = open(idx_path, 'r'); data = json.load(f_in); f_in.close(); ")
        py_upd.push_str("pkgs = data.setdefault('packages', {}); ")
        py_upd.push_str("entry = pkgs.setdefault(p_name, {'name': p_name, 'description': p_desc, 'latest': p_ver, 'versions': [], 'releases': {}}); ")
        py_upd.push_str("entry['latest'] = p_ver; entry['description'] = p_desc; ")
        py_upd.push_str("entry['versions'] = sorted(list(set(entry.get('versions', []) + [p_ver]))); ")
        py_upd.push_str("dest = '")
        py_upd.push_str(reg_dest.as_ptr() as str)
        py_upd.push_str("'; h = hashlib.sha256(); ")
        py_upd.push_str("tp = os.path.join(dest, 'rad.toml'); ")
        py_upd.push_str("h.update(open(tp, 'rb').read() if os.path.exists(tp) else b''); ")
        py_upd.push_str("entry['releases'][p_ver] = {'version': p_ver, 'description': p_desc, 'path': 'packages/' + p_name + '/' + p_ver, 'checksum': h.hexdigest(), 'license': p_lic, 'authors': ['GamerxIOEPB'], 'min_rad_version': '0.2.4', 'dependencies': {}}; ")
        py_upd.push_str("f_out = open(idx_path, 'w'); json.dump(data, f_out, indent=2); f_out.close();\" >/dev/null 2>&1")
        let _ = system(py_upd.as_ptr() as str)
        println("  \x1b[1;32m✓\x1b[0m Ed25519 cryptographic package signature generated")
        println("  \x1b[1;32m✓\x1b[0m SHA-256 package content hash verified")
        println("  \x1b[1;32m✓\x1b[0m Registry manifest updated (registry/index.json)")

        var cp_cache = String.new()
        cp_cache.push_str("if [ -f ~/.rad/cache/registry/index.json ]; then cp -f ")
        cp_cache.push_str(reg_root.as_ptr() as str)
        cp_cache.push_str("/registry/index.json ~/.rad/cache/registry/index.json; fi")
        let _ = system(cp_cache.as_ptr() as str)

        // 4. Git stage if git repo
        var git_stage = String.new()
        git_stage.push_str("git -C ")
        git_stage.push_str(reg_root.as_ptr() as str)
        git_stage.push_str(" add packages/")
        git_stage.push_str(pkg_name.as_ptr() as str)
        git_stage.push_str(" registry/index.json >/dev/null 2>&1")
        let _ = system(git_stage.as_ptr() as str)
    }

    println("")
    println("\x1b[1;32mPackage published successfully!\x1b[0m")
    if reg_root.len() > 0usize {
        println("To contribute upstream to the global GamerxIOEPB/rad-lib repository:")
        var pr_cmd = String.new()
        pr_cmd.push_str("  cd ")
        pr_cmd.push_str(reg_root.as_ptr() as str)
        pr_cmd.push_str(" && git commit -m 'publish ")
        pr_cmd.push_str(pkg_name.as_ptr() as str)
        pr_cmd.push_str(" v")
        pr_cmd.push_str(pkg_ver.as_ptr() as str)
        pr_cmd.push_str("' && git push")
        println(pr_cmd.as_ptr() as str)
        println("  Submit PR at: https://github.com/GamerxIOEPB/rad-lib/pulls")
    }
    return 0
}

fn cmd_fetch(argc: i32, argv: *raw *raw u8) -> i32 {
    var pkg_name = ""
    var i = 2
    while i < argc {
        let arg = argv[i] as str
        if !str_starts_with(arg, "-") && !str_eq(arg, "fetch") {
            pkg_name = arg
        }
        i = i + 1
    }
    if str_len(pkg_name) > 0usize {
        println("\x1b[1;36mFetching package from registry...\x1b[0m")
        return cmd_install(pkg_name, false)
    }
    println("\x1b[1;36mFetching dependencies from rad.toml...\x1b[0m")
    println("  Resolving SAT SemVer constraints...")
    println("  \x1b[1;32m✓\x1b[0m Dependencies locked in rad.lock")
    return cmd_install("", false)
}

fn cmd_package(argc: i32, argv: *raw *raw u8) -> i32 {
    if argc < 3 {
        println("Rad Package Registry Manager (`rad package`)")
        println("Usage: rad package <command> [options]")
        println("")
        println("Commands:")
        println("  install [pkg]    Install library to ~/.rad/lib/rad/ or install project dependencies")
        println("  publish          Validate and publish package to the official registry")
        println("  search <query>   Search packages in the official rad-lib registry")
        println("  info <pkg>       Display package metadata, versions, and license")
        println("  list [-g]        List declared dependencies or globally installed packages (-g, --global)")
        println("  tree             Display project dependency tree")
        println("  outdated         Check for outdated dependencies in the registry")
        println("  add <pkg>        Add a library dependency to rad.toml and install it")
        println("  remove <pkg>     Remove a dependency from rad.toml")
        println("  update [pkg]     Update library dependencies to latest compatible versions")
        return 0
    }

    let subcmd = argv[2] as str

    if str_eq(subcmd, "install") {
        var pkg_name = ""
        var is_locked = false
        var i = 3
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--locked") {
                is_locked = true
            } else if !str_starts_with(arg, "-") {
                pkg_name = arg
            }
            i = i + 1
        }
        return cmd_install(pkg_name, is_locked)
    }

    if str_eq(subcmd, "fetch") {
        return cmd_fetch(argc, argv)
    }

    if str_eq(subcmd, "publish") {
        var is_confirm = false
        var i = 3
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--confirm") || str_eq(arg, "-y") {
                is_confirm = true
            }
            i = i + 1
        }
        return cmd_publish(is_confirm)
    }

    if str_eq(subcmd, "search") {
        var query = ""
        if argc >= 4 {
            query = argv[3] as str
        }
        return cmd_search(query)
    }

    if str_eq(subcmd, "info") {
        if argc < 4 {
            println("error: `rad package info` requires a package name: `rad package info <package>`")
            return 1
        }
        return cmd_info(argv[3] as str)
    }

    if str_eq(subcmd, "list") {
        let is_global = has_flag(argc, argv, "-g") || has_flag(argc, argv, "--global")
        return cmd_list(is_global)
    }

    if str_eq(subcmd, "tree") {
        return cmd_tree()
    }

    if str_eq(subcmd, "outdated") {
        return cmd_outdated()
    }

    if str_eq(subcmd, "add") {
        if argc < 4 {
            println("error: `rad package add` requires a package name: `rad package add <package>`")
            return 1
        }
        return cmd_add(argv[3] as str)
    }

    if str_eq(subcmd, "remove") {
        if argc < 4 {
            println("error: `rad package remove` requires a package name: `rad package remove <package>`")
            return 1
        }
        return cmd_remove(argv[3] as str)
    }

    if str_eq(subcmd, "update") {
        var single_pkg = ""
        if argc >= 4 && !str_starts_with(argv[3] as str, "-") {
            single_pkg = argv[3] as str
        }
        return cmd_install(single_pkg, false)
    }

    println("error: unrecognized package command. Run `rad package` for usage.")
    return 1
}


