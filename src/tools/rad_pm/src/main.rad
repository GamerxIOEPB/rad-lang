// ==============================================================================
// rad — Rad Package Manager & Build Tool
// Written in pure Rad, manages rad.toml projects, and orchestrates radc.
// ==============================================================================

fn str_len(s: str) -> usize {
    if (s as usize) == 0usize {
        return 0usize
    }
    let p: *raw u8 = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

fn str_eq(a: str, b: str) -> bool {
    if (a as usize) == 0usize && (b as usize) == 0usize {
        return true
    }
    if (a as usize) == 0usize || (b as usize) == 0usize {
        return false
    }
    let pa: *raw u8 = a as *raw u8
    let pb: *raw u8 = b as *raw u8
    var i = 0usize
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] {
            return false
        }
        i = i + 1usize
    }
    return pa[i] == pb[i]
}

fn str_starts_with(s: str, prefix: str) -> bool {
    if (s as usize) == 0usize || (prefix as usize) == 0usize {
        return false
    }
    let ps: *raw u8 = s as *raw u8
    let pp: *raw u8 = prefix as *raw u8
    var i = 0usize
    while pp[i] != 0u8 {
        if ps[i] == 0u8 || ps[i] != pp[i] {
            return false
        }
        i = i + 1usize
    }
    return true
}

fn str_ends_with(s: str, suffix: str) -> bool {
    let s_len = str_len(s)
    let suf_len = str_len(suffix)
    if s_len < suf_len || s_len == 0usize {
        return false
    }
    let ps: *raw u8 = s as *raw u8
    let p_suf: *raw u8 = suffix as *raw u8
    let start = s_len - suf_len
    var i = 0usize
    while i < suf_len {
        if ps[start + i] != p_suf[i] {
            return false
        }
        i = i + 1usize
    }
    return true
}

extern "C" {
    fn access(path: str, mode: i32) -> i32;
}

fn file_exists(path: str) -> bool {
    return access(path, 0) == 0
}

fn path_basename(path: str) -> String {
    let len = str_len(path)
    if len == 0usize {
        return String.from_str("app")
    }
    let p: *raw u8 = path as *raw u8
    var last_slash = 0usize
    var has_slash = false
    var i = 0usize
    while i < len {
        if p[i] == 47u8 { // '/'
            last_slash = i + 1usize
            has_slash = true
        }
        i = i + 1usize
    }
    if !has_slash || last_slash >= len {
        return String.from_str(path)
    }
    var res = String.new()
    i = last_slash
    while i < len {
        res.push_byte(p[i])
        i = i + 1usize
    }
    return res
}

fn write_file_str(path: str, content: str) -> bool {
    let fp = fopen(path, "wb")
    if (fp as usize) == 0usize {
        return false
    }
    let p: *raw var u8 = content as *raw var u8
    let len = str_len(content)
    let _w = fwrite(p, 1usize, len, fp)
    let _c = fclose(fp)
    return true
}

fn read_file_str(path: str) -> String {
    var res = String.new()
    let fp = fopen(path, "rb")
    if (fp as usize) == 0usize {
        return res
    }
    fseek(fp, 0i64, 2)
    let size = ftell(fp) as usize
    fseek(fp, 0i64, 0)
    if size == 0usize {
        let _c = fclose(fp)
        return res
    }
    var buf = malloc(size + 1usize) as *raw var u8
    let read_bytes = fread(buf, 1usize, size, fp) as usize
    buf[read_bytes] = 0u8
    let _c2 = fclose(fp)

    var i = 0usize
    while i < read_bytes {
        res.push_byte(buf[i])
        i = i + 1usize
    }
    free(buf)
    return res
}

fn is_executable_radc(candidate: str) -> bool {
    if str_len(candidate) == 0usize {
        return false
    }
    var cmd = String.new()
    cmd.push_str(candidate)
    cmd.push_str(" --version >/dev/null 2>&1")
    let ret = system(cmd.as_ptr() as str)
    return ret == 0
}

fn find_radc_compiler(argv0: str) -> String {
    // 1. Check if radc lives right next to the running rad binary (sibling path)
    let len = str_len(argv0)
    if len > 0usize {
        let p: *raw u8 = argv0 as *raw u8
        var last_slash = 0usize
        var has_slash = false
        var i = 0usize
        while i < len {
            if p[i] == 47u8 { // '/'
                last_slash = i
                has_slash = true
            }
            i = i + 1usize
        }
        if has_slash {
            var sibling = String.new()
            i = 0usize
            while i <= last_slash {
                sibling.push_byte(p[i])
                i = i + 1usize
            }
            sibling.push_str("radc")
            if is_executable_radc(sibling.as_ptr() as str) {
                return sibling
            }
        }
    }

    // 2. Check $RAD_HOME/bin/radc
    let env_rad_home = getenv("RAD_HOME")
    if (env_rad_home as usize) != 0usize {
        var p_rad = String.new()
        p_rad.push_str(env_rad_home as str)
        p_rad.push_str("/bin/radc")
        if is_executable_radc(p_rad.as_ptr() as str) {
            return p_rad
        }
    }

    // 3. Check $HOME/.rad/bin/radc
    let env_home = getenv("HOME")
    if (env_home as usize) != 0usize {
        var p_home = String.new()
        p_home.push_str(env_home as str)
        p_home.push_str("/.rad/bin/radc")
        if is_executable_radc(p_home.as_ptr() as str) {
            return p_home
        }
    }

    // 4. Check if radc is in PATH
    if is_executable_radc("radc") {
        return String.from_str("radc")
    }

    // 5. Check repository development paths (verified executable)
    if is_executable_radc("bin/radc") {
        return String.from_str("bin/radc")
    }
    if is_executable_radc("./target/release/radc") {
        return String.from_str("./target/release/radc")
    }
    if is_executable_radc("./target/radc") {
        return String.from_str("./target/radc")
    }

    return String.from_str("radc")
}

// ------------------------------------------------------------------------------
// Package Management Subcommands
// ------------------------------------------------------------------------------

fn cmd_new(name: str, is_lib: bool) -> i32 {
    println("Creating new Rad package...")
    let pkg_name = path_basename(name)

    // 1. Create directory structure
    var mkdir_cmd = String.new()
    mkdir_cmd.push_str("mkdir -p ")
    mkdir_cmd.push_str(name)
    mkdir_cmd.push_str("/src")
    let _s1 = system(mkdir_cmd.as_ptr() as str)

    // 2. Create rad.toml
    var toml_path = String.new()
    toml_path.push_str(name)
    toml_path.push_str("/rad.toml")

    var toml_content = String.new()
    toml_content.push_str("[package]\nname = \"")
    toml_content.push_str(pkg_name.as_ptr() as str)
    toml_content.push_str("\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[dependencies]\n")
    write_file_str(toml_path.as_ptr() as str, toml_content.as_ptr() as str)

    // 3. Create .gitignore
    var gitignore_path = String.new()
    gitignore_path.push_str(name)
    gitignore_path.push_str("/.gitignore")
    write_file_str(gitignore_path.as_ptr() as str, "/target\n*.ll\n*.o\n")

    // 4. Create src/main.rad or src/lib.rad
    var src_path = String.new()
    src_path.push_str(name)
    if is_lib {
        src_path.push_str("/src/lib.rad")
        write_file_str(src_path.as_ptr() as str, "pub fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n")
        println("Created library package successfully!")
    } else {
        src_path.push_str("/src/main.rad")
        write_file_str(src_path.as_ptr() as str, "fn main() -> i32 {\n    println(\"Hello from Rad Package!\")\n    0\n}\n")
        println("Created binary (application) package successfully!")
    }

    return 0
}

fn cmd_init(target_dir: str, is_lib: bool) -> i32 {
    var base_dir = String.new()
    var pkg_name = String.new()
    if str_len(target_dir) > 0usize && !str_eq(target_dir, ".") {
        base_dir.push_str(target_dir)
        pkg_name = path_basename(target_dir)
    } else {
        base_dir.push_str(".")
        pkg_name = String.from_str("app")
    }

    var msg = String.new()
    msg.push_str("Initializing Rad package in ")
    msg.push_str(base_dir.as_ptr() as str)
    msg.push_str("...")
    println(msg.as_ptr() as str)

    var mkdir_cmd = String.new()
    mkdir_cmd.push_str("mkdir -p ")
    mkdir_cmd.push_str(base_dir.as_ptr() as str)
    mkdir_cmd.push_str("/src")
    let _m = system(mkdir_cmd.as_ptr() as str)

    var toml_path = String.new()
    if str_eq(base_dir.as_ptr() as str, ".") {
        toml_path.push_str("rad.toml")
    } else {
        toml_path.push_str(base_dir.as_ptr() as str)
        toml_path.push_str("/rad.toml")
    }

    let fp_toml = fopen(toml_path.as_ptr() as str, "rb")
    if (fp_toml as usize) != 0usize {
        let _c1 = fclose(fp_toml)
    } else {
        var toml_content = String.new()
        toml_content.push_str("[package]\nname = \"")
        toml_content.push_str(pkg_name.as_ptr() as str)
        toml_content.push_str("\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[dependencies]\n")
        let _w1 = write_file_str(toml_path.as_ptr() as str, toml_content.as_ptr() as str)
    }

    var gitignore_path = String.new()
    if str_eq(base_dir.as_ptr() as str, ".") {
        gitignore_path.push_str(".gitignore")
    } else {
        gitignore_path.push_str(base_dir.as_ptr() as str)
        gitignore_path.push_str("/.gitignore")
    }
    let fp_git = fopen(gitignore_path.as_ptr() as str, "rb")
    if (fp_git as usize) != 0usize {
        let _c2 = fclose(fp_git)
    } else {
        let _w2 = write_file_str(gitignore_path.as_ptr() as str, "/target\n*.ll\n*.o\n")
    }

    var src_file = String.new()
    if str_eq(base_dir.as_ptr() as str, ".") {
        if is_lib {
            src_file.push_str("src/lib.rad")
        } else {
            src_file.push_str("src/main.rad")
        }
    } else {
        src_file.push_str(base_dir.as_ptr() as str)
        if is_lib {
            src_file.push_str("/src/lib.rad")
        } else {
            src_file.push_str("/src/main.rad")
        }
    }

    let fp_src = fopen(src_file.as_ptr() as str, "rb")
    if (fp_src as usize) != 0usize {
        let _c3 = fclose(fp_src)
    } else {
        if is_lib {
            let _w3 = write_file_str(src_file.as_ptr() as str, "pub fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n")
        } else {
            let _w4 = write_file_str(src_file.as_ptr() as str, "fn main() -> i32 {\n    println(\"Hello from Rad Package!\")\n    0\n}\n")
        }
    }

    println("Initialized package successfully!")
    return 0
}

fn cmd_clean() -> i32 {
    println("Cleaning target directory...")
    let _r = system("rm -rf target")
    println("Clean complete.")
    return 0
}

// ------------------------------------------------------------------------------
// Rad Binary Package Manager & rad-lib Registry Integration
// ------------------------------------------------------------------------------

fn str_contains(haystack: str, needle: str) -> bool {
    if (haystack as usize) == 0usize || (needle as usize) == 0usize {
        return false
    }
    let h_len = str_len(haystack)
    let n_len = str_len(needle)
    if n_len == 0usize {
        return true
    }
    if h_len < n_len {
        return false
    }
    let ph = haystack as *raw u8
    let pn = needle as *raw u8
    var i = 0usize
    let max_i = h_len - n_len
    while i <= max_i {
        var match_found = true
        var j = 0usize
        while j < n_len {
            if ph[i + j] != pn[j] {
                match_found = false
                j = n_len
            } else {
                j = j + 1usize
            }
        }
        if match_found {
            return true
        }
        i = i + 1usize
    }
    return false
}

fn has_flag(argc: i32, argv: *raw *raw u8, flag: str) -> bool {
    var i = 2
    while i < argc {
        if str_eq(argv[i] as str, flag) {
            return true
        }
        i = i + 1
    }
    return false
}

fn extract_json_field(line: str, field_name: str) -> String {
    var res = String.new()
    let p_line = line as *raw u8
    let len = str_len(line)
    let f_len = str_len(field_name)
    var i = 0usize
    while i + f_len + 3usize < len {
        if p_line[i] == 34u8 { // '"'
            var match_field = true
            var j = 0usize
            while j < f_len {
                if p_line[i + 1usize + j] != (field_name as *raw u8)[j] {
                    match_field = false
                    j = f_len
                } else {
                    j = j + 1usize
                }
            }
            if match_field && p_line[i + 1usize + f_len] == 34u8 { // '"'
                var k = i + 2usize + f_len
                while k < len && (p_line[k] == 32u8 || p_line[k] == 58u8 || p_line[k] == 9u8) { // ' ', ':', '\t'
                    k = k + 1usize
                }
                if k < len && p_line[k] == 34u8 { // start quote of value
                    k = k + 1usize
                    while k < len && p_line[k] != 34u8 {
                        res.push_byte(p_line[k])
                        k = k + 1usize
                    }
                    return res
                }
            }
        }
        i = i + 1usize
    }
    return res
}

fn extract_toml_field(line: str, field_name: str) -> String {
    let trimmed = trim_line_start(line)
    if str_starts_with(trimmed, field_name) {
        let f_len = str_len(field_name)
        let p = trimmed as *raw u8
        var i = f_len
        let len = str_len(trimmed)
        while i < len && (is_whitespace_char(p[i]) || p[i] == 61u8) { // whitespace or '='
            i = i + 1usize
        }
        if i < len && p[i] == 34u8 { // '"'
            i = i + 1usize
            var res = String.new()
            while i < len && p[i] != 34u8 {
                res.push_byte(p[i])
                i = i + 1usize
            }
            return res
        }
    }
    return String.new()
}

fn parse_dep_name(line: str) -> String {
    let len = str_len(line)
    let p = line as *raw u8
    var res = String.new()
    var i = 0usize
    while i < len && is_whitespace_char(p[i]) {
        i = i + 1usize
    }
    while i < len && !is_whitespace_char(p[i]) && p[i] != 61u8 {
        res.push_byte(p[i])
        i = i + 1usize
    }
    return res
}

fn parse_dep_version(line: str) -> String {
    let len = str_len(line)
    let p = line as *raw u8
    var res = String.new()
    var i = 0usize
    while i < len && p[i] != 61u8 {
        i = i + 1usize
    }
    if i >= len {
        return res
    }
    i = i + 1usize // skip '='
    while i < len && (is_whitespace_char(p[i]) || p[i] == 34u8) {
        i = i + 1usize
    }
    while i < len && p[i] != 34u8 && p[i] != 10u8 && p[i] != 13u8 && p[i] != 35u8 {
        res.push_byte(p[i])
        i = i + 1usize
    }
    return res
}

fn clean_semver_req(req: str) -> String {
    var res = String.new()
    let len = str_len(req)
    let p = req as *raw u8
    var i = 0usize
    while i < len && (p[i] == 94u8 || p[i] == 126u8 || p[i] == 62u8 || p[i] == 61u8 || p[i] == 32u8) {
        i = i + 1usize
    }
    while i < len && p[i] != 32u8 {
        res.push_byte(p[i])
        i = i + 1usize
    }
    return res
}

fn get_registry_root() -> String {
    let env_reg = getenv("RAD_REGISTRY_PATH")
    if (env_reg as usize) != 0usize {
        let p = env_reg as str
        var chk = String.new()
        chk.push_str(p)
        chk.push_str("/registry/index.json")
        if file_exists(chk.as_ptr() as str) {
            return String.from_str(p)
        }
    }

    if file_exists("../rad-lib/registry/index.json") {
        return String.from_str("../rad-lib")
    }

    let env_home = getenv("HOME")
    if (env_home as usize) != 0usize {
        var p_proj = String.new()
        p_proj.push_str(env_home as str)
        p_proj.push_str("/Projects/rad-lib/registry/index.json")
        if file_exists(p_proj.as_ptr() as str) {
            var p_res = String.new()
            p_res.push_str(env_home as str)
            p_res.push_str("/Projects/rad-lib")
            return p_res
        }

        var p_cache = String.new()
        p_cache.push_str(env_home as str)
        p_cache.push_str("/.rad/cache/registry")
        var p_cache_idx = String.new()
        p_cache_idx.push_str(p_cache.as_ptr() as str)
        p_cache_idx.push_str("/index.json")
        if file_exists(p_cache_idx.as_ptr() as str) {
            return p_cache
        }
    }

    return String.new()
}

fn sync_registry() -> String {
    let root = get_registry_root()
    if root.len() > 0usize {
        return root
    }

    let env_home = getenv("HOME")
    if (env_home as usize) == 0usize {
        return String.new()
    }

    var cache_reg = String.new()
    cache_reg.push_str(env_home as str)
    cache_reg.push_str("/.rad/cache/registry")

    var mkdir_cmd = String.new()
    mkdir_cmd.push_str("mkdir -p ")
    mkdir_cmd.push_str(cache_reg.as_ptr() as str)
    let _m = system(mkdir_cmd.as_ptr() as str)

    var dl_cmd = String.new()
    dl_cmd.push_str("curl -fsSL https://raw.githubusercontent.com/GamerxIOEPB/rad-lib/main/registry/index.json -o ")
    dl_cmd.push_str(cache_reg.as_ptr() as str)
    dl_cmd.push_str("/index.json >/dev/null 2>&1")
    let ret = system(dl_cmd.as_ptr() as str)
    if ret == 0 {
        return cache_reg
    }

    return String.new()
}

fn get_package_latest_version(reg_root: str, pkg_name: str) -> String {
    var idx_path = String.new()
    idx_path.push_str(reg_root)
    idx_path.push_str("/registry/index.json")

    let content = read_file_str(idx_path.as_ptr() as str)
    let lines = split_source_lines(content)
    var cur_name = String.new()

    var i = 0usize
    while i < lines.len {
        let line = lines.ptr[i].as_ptr() as str
        let f_name = extract_json_field(line, "name")
        if f_name.len() > 0usize && cur_name.len() == 0usize {
            cur_name = f_name
        }
        let f_ver = extract_json_field(line, "latest")
        if f_ver.len() > 0usize && cur_name.len() > 0usize {
            if str_eq(cur_name.as_ptr() as str, pkg_name) {
                return f_ver
            }
            cur_name = String.new()
        }
        i = i + 1usize
    }
    return String.from_str("0.1.0")
}

fn get_package_checksum(reg_root: str, pkg_name: str, version: str) -> String {
    var idx_path = String.new()
    idx_path.push_str(reg_root)
    idx_path.push_str("/registry/index.json")

    let content = read_file_str(idx_path.as_ptr() as str)
    let lines = split_source_lines(content)
    var cur_name = String.new()
    var cur_ver = String.new()

    var i = 0usize
    while i < lines.len {
        let line = lines.ptr[i].as_ptr() as str
        let f_name = extract_json_field(line, "name")
        if f_name.len() > 0usize && cur_name.len() == 0usize {
            cur_name = f_name
        }
        let f_ver = extract_json_field(line, "version")
        if f_ver.len() > 0usize && cur_ver.len() == 0usize {
            cur_ver = f_ver
        }
        let f_chk = extract_json_field(line, "checksum")
        if f_chk.len() > 0usize {
            if str_eq(cur_name.as_ptr() as str, pkg_name) && str_eq(cur_ver.as_ptr() as str, version) {
                return f_chk
            }
            cur_ver = String.new()
        }
        i = i + 1usize
    }
    return String.from_str("none")
}

fn update_lockfile() {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        return
    }

    let reg_root = get_registry_root()
    let parsed_res = TomlValue.parse(toml.as_ptr() as str)
    var lock = String.new()
    lock.push_str("# This file is automatically @generated by rad.\n")
    lock.push_str("# It is not intended for manual editing.\n")
    lock.push_str("version = 1\n")

    match parsed_res {
        Result.Ok(doc) => {
            let dep_opt = doc.get_table("dependencies")
            match dep_opt {
                Option.Some(dep_tbl) => {
                    var i = 0usize
                    while i < dep_tbl.table_val.len {
                        let dep_member = dep_tbl.table_val.ptr[i]
                        let d_name = dep_member.key.as_ptr() as str
                        var d_ver = ""
                        if dep_member.val.kind == TOML_STRING {
                            d_ver = dep_member.val.as_str()
                        } else if dep_member.val.kind == TOML_TABLE {
                            d_ver = dep_member.val.get_str("version")
                        }
                        if str_len(d_name) > 0usize {
                            let resolved_ver = clean_semver_req(d_ver)
                            let chk = get_package_checksum(reg_root.as_ptr() as str, d_name, resolved_ver.as_ptr() as str)

                            lock.push_str("\n[[package]]\n")
                            lock.push_str("name = \"")
                            lock.push_str(d_name)
                            lock.push_str("\"\n")

                            lock.push_str("version = \"")
                            lock.push_str(resolved_ver.as_ptr() as str)
                            lock.push_str("\"\n")

                            lock.push_str("source = \"registry+https://github.com/GamerxIOEPB/rad-lib\"\n")

                            lock.push_str("checksum = \"")
                            lock.push_str(chk.as_ptr() as str)
                            lock.push_str("\"\n")
                        }
                        i = i + 1usize
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }

    write_file_str("rad.lock", lock.as_ptr() as str)
}

fn ensure_library_installed_global(reg_root: str, pkg_name: str, version: str) -> bool {
    let env_home = getenv("HOME")
    if (env_home as usize) == 0usize {
        return false
    }

    var global_pkg_dir = String.new()
    global_pkg_dir.push_str(env_home as str)
    global_pkg_dir.push_str("/.rad/packages/")
    global_pkg_dir.push_str(pkg_name)

    // Check if already installed
    var test_global = String.new()
    test_global.push_str(global_pkg_dir.as_ptr() as str)
    test_global.push_str("/src/lib.rad")
    if file_exists(test_global.as_ptr() as str) {
        return true
    }

    // Try finding in local registry root
    var cand_reg = String.new()
    cand_reg.push_str(reg_root)
    cand_reg.push_str("/packages/")
    cand_reg.push_str(pkg_name)
    cand_reg.push_str("/")
    cand_reg.push_str(version)

    var test_reg = String.new()
    test_reg.push_str(cand_reg.as_ptr() as str)
    test_reg.push_str("/src/lib.rad")

    if file_exists(test_reg.as_ptr() as str) {
        var cp_cmd = String.new()
        cp_cmd.push_str("mkdir -p \"")
        cp_cmd.push_str(global_pkg_dir.as_ptr() as str)
        cp_cmd.push_str("\" && cp -rf \"")
        cp_cmd.push_str(cand_reg.as_ptr() as str)
        cp_cmd.push_str("\"/* \"")
        cp_cmd.push_str(global_pkg_dir.as_ptr() as str)
        cp_cmd.push_str("/\"")
        let _c = system(cp_cmd.as_ptr() as str)
    } else {
        // Fetch from GitHub
        var dl_cmd = String.new()
        dl_cmd.push_str("sh -c '")
        dl_cmd.push_str("TMP_DL=\"/tmp/rad_lib_dl_$$\"; ")
        dl_cmd.push_str("git clone --depth 1 https://github.com/GamerxIOEPB/rad-lib.git \"$TMP_DL\" >/dev/null 2>&1 || exit 1; ")
        dl_cmd.push_str("mkdir -p \"")
        dl_cmd.push_str(global_pkg_dir.as_ptr() as str)
        dl_cmd.push_str("\"; ")
        dl_cmd.push_str("cp -rf \"$TMP_DL/packages/")
        dl_cmd.push_str(pkg_name)
        dl_cmd.push_str("/")
        dl_cmd.push_str(version)
        dl_cmd.push_str("\"/* \"")
        dl_cmd.push_str(global_pkg_dir.as_ptr() as str)
        dl_cmd.push_str("/\"; ")
        dl_cmd.push_str("rm -rf \"$TMP_DL\"; ")
        dl_cmd.push_str("'")
        let _c2 = system(dl_cmd.as_ptr() as str)
    }

    // Set up shorthand symlink (e.g. tui -> rad-tui, json -> rad-json)
    if str_starts_with(pkg_name, "rad-") {
        let short_name = (pkg_name as usize + 4usize) as str
        var link_cmd = String.new()
        link_cmd.push_str("ln -sfn \"")
        link_cmd.push_str(pkg_name)
        link_cmd.push_str("\" \"")
        link_cmd.push_str(env_home as str)
        link_cmd.push_str("/.rad/packages/")
        link_cmd.push_str(short_name)
        link_cmd.push_str("\" 2>/dev/null")
        let _l = system(link_cmd.as_ptr() as str)
    }

    return file_exists(test_global.as_ptr() as str)
}

fn cmd_search(query: str) -> i32 {
    let reg_root = sync_registry()
    if reg_root.len() == 0usize {
        println("error: unable to access or sync package registry")
        println("       Check internet connection or ensure rad-lib repository exists.")
        return 1
    }

    var idx_path = String.new()
    idx_path.push_str(reg_root.as_ptr() as str)
    idx_path.push_str("/registry/index.json")

    let content = read_file_str(idx_path.as_ptr() as str)
    if content.len() == 0usize {
        println("error: registry index is empty or unreadable")
        return 1
    }

    let lines = split_source_lines(content)
    println("\x1b[1;36mSearching Rad Package Registry\x1b[0m (GamerxIOEPB/rad-lib):")

    var count = 0
    var cur_name = String.new()
    var cur_desc = String.new()
    var cur_ver = String.new()
    var in_pkg = false

    var i = 0usize
    while i < lines.len {
        let line = lines.ptr[i].as_ptr() as str
        let f_name = extract_json_field(line, "name")
        if f_name.len() > 0usize && cur_name.len() == 0usize {
            cur_name = f_name
            in_pkg = true
        }
        let f_desc = extract_json_field(line, "description")
        if f_desc.len() > 0usize && in_pkg && cur_desc.len() == 0usize {
            cur_desc = f_desc
        }
        let f_ver = extract_json_field(line, "latest")
        if f_ver.len() > 0usize && in_pkg && cur_ver.len() == 0usize {
            cur_ver = f_ver
        }

        if in_pkg && cur_name.len() > 0usize && cur_ver.len() > 0usize && cur_desc.len() > 0usize {
            let name_str = cur_name.as_ptr() as str
            let desc_str = cur_desc.as_ptr() as str
            if str_len(query) == 0usize || str_contains(name_str, query) || str_contains(desc_str, query) {
                var out = String.new()
                out.push_str("  \x1b[1;32m")
                out.push_str(name_str)
                out.push_str("\x1b[0m (v")
                out.push_str(cur_ver.as_ptr() as str)
                out.push_str(")\n    ")
                out.push_str(desc_str)
                println(out.as_ptr() as str)
                count = count + 1
            }
            cur_name = String.new()
            cur_desc = String.new()
            cur_ver = String.new()
            in_pkg = false
        }
        i = i + 1usize
    }

    if count == 0 {
        var no_msg = String.new()
        no_msg.push_str("No packages found matching query '")
        no_msg.push_str(query)
        no_msg.push_str("'.")
        println(no_msg.as_ptr() as str)
    } else {
        println("")
        var total_msg = String.new()
        total_msg.push_str("Found ")
        let c_str = int_to_str(count)
        total_msg.push_str(c_str.as_ptr() as str)
        total_msg.push_str(" matching package(s).")
        println(total_msg.as_ptr() as str)
    }
    return 0
}

fn cmd_info(pkg_name: str) -> i32 {
    if str_len(pkg_name) == 0usize {
        println("error: package name required: `rad info <package>`")
        return 1
    }

    let reg_root = sync_registry()
    if reg_root.len() == 0usize {
        println("error: unable to access package registry")
        return 1
    }

    var idx_path = String.new()
    idx_path.push_str(reg_root.as_ptr() as str)
    idx_path.push_str("/registry/index.json")

    let content = read_file_str(idx_path.as_ptr() as str)
    let lines = split_source_lines(content)

    var cur_name = String.new()
    var cur_desc = String.new()
    var cur_ver = String.new()
    var cur_lic = String.new()
    var found = false

    var i = 0usize
    while i < lines.len {
        let line = lines.ptr[i].as_ptr() as str
        let f_name = extract_json_field(line, "name")
        if f_name.len() > 0usize {
            cur_name = f_name
            cur_desc = String.new()
            cur_ver = String.new()
            cur_lic = String.new()
        }
        let f_desc = extract_json_field(line, "description")
        if f_desc.len() > 0usize && cur_desc.len() == 0usize {
            cur_desc = f_desc
        }
        let f_ver = extract_json_field(line, "latest")
        if f_ver.len() > 0usize && cur_ver.len() == 0usize {
            cur_ver = f_ver
        }
        let f_lic = extract_json_field(line, "license")
        if f_lic.len() > 0usize && cur_lic.len() == 0usize {
            cur_lic = f_lic
        }

        if cur_name.len() > 0usize && (str_eq(cur_name.as_ptr() as str, pkg_name) || (str_starts_with(cur_name.as_ptr() as str, "rad-") && str_eq((cur_name.as_ptr() as usize + 4usize) as str, pkg_name))) {
            if cur_ver.len() > 0usize && cur_desc.len() > 0usize && cur_lic.len() > 0usize {
                found = true
                println("\x1b[1;36mPackage Information:\x1b[0m")
                var p_line = String.new()
                p_line.push_str("  Name:        \x1b[1;32m")
                p_line.push_str(cur_name.as_ptr() as str)
                p_line.push_str("\x1b[0m")
                println(p_line.as_ptr() as str)

                var v_line = String.new()
                v_line.push_str("  Latest:      v")
                v_line.push_str(cur_ver.as_ptr() as str)
                println(v_line.as_ptr() as str)

                var l_line = String.new()
                l_line.push_str("  License:     ")
                l_line.push_str(cur_lic.as_ptr() as str)
                println(l_line.as_ptr() as str)

                println("  Registry:    https://github.com/GamerxIOEPB/rad-lib")
                println("  Repository:  https://github.com/GamerxIOEPB/rad-lib")

                var d_line = String.new()
                d_line.push_str("  Description: ")
                d_line.push_str(cur_desc.as_ptr() as str)
                println(d_line.as_ptr() as str)

                println("")
                println("To install this library for system-wide or project use, run:")
                var add_hint = String.new()
                add_hint.push_str("  rad install ")
                add_hint.push_str(cur_name.as_ptr() as str)
                println(add_hint.as_ptr() as str)
                return 0
            }
        }
        i = i + 1usize
    }

    if !found {
        var err_msg = String.new()
        err_msg.push_str("error: package '")
        err_msg.push_str(pkg_name)
        err_msg.push_str("' was not found in the registry.")
        println(err_msg.as_ptr() as str)
        return 1
    }
    return 0
}

fn cmd_install(single_pkg: str, is_locked: bool) -> i32 {
    let reg_root = sync_registry()
    if reg_root.len() == 0usize {
        println("error: unable to access or sync package registry")
        return 1
    }

    // Case 1: Direct single library install (e.g. `rad install rad-tui` or `rad install tui`)
    if str_len(single_pkg) > 0usize {
        var pkg_name = String.from_str(single_pkg)
        if !str_starts_with(single_pkg, "rad-") && !str_starts_with(single_pkg, "rad_") {
            var with_rad = String.from_str("rad-")
            with_rad.push_str(single_pkg)
            let v_chk = get_package_latest_version(reg_root.as_ptr() as str, with_rad.as_ptr() as str)
            if !str_eq(v_chk.as_ptr() as str, "0.1.0") || file_exists("../rad-lib/packages/rad-tui") {
                pkg_name = with_rad
            }
        }
        let p_str = pkg_name.as_ptr() as str
        let latest_ver = get_package_latest_version(reg_root.as_ptr() as str, p_str)

        println("\x1b[1;36mInstalling Rad Library:\x1b[0m")
        var fetch_msg = String.new()
        fetch_msg.push_str("Downloading ")
        fetch_msg.push_str(p_str)
        fetch_msg.push_str(" v")
        fetch_msg.push_str(latest_ver.as_ptr() as str)
        fetch_msg.push_str(" to ~/.rad/packages/...")
        render_tui_progress(fetch_msg.as_ptr() as str, 45)

        let ok = ensure_library_installed_global(reg_root.as_ptr() as str, p_str, latest_ver.as_ptr() as str)
        if !ok {
            println("")
            var err = String.new()
            err.push_str("error: failed to install library '")
            err.push_str(p_str)
            err.push_str("'")
            println(err.as_ptr() as str)
            return 1
        }

        // If current directory is a Rad project with rad.toml, also copy to ./packages/
        let toml = read_file_str("rad.toml")
        if toml.len() > 0usize {
            render_tui_progress("Linking to local project packages/...", 80)
            let _ = system("mkdir -p packages")
            let env_home = getenv("HOME")
            if (env_home as usize) != 0usize {
                var cp_cmd = String.new()
                cp_cmd.push_str("mkdir -p packages/")
                cp_cmd.push_str(p_str)
                cp_cmd.push_str(" && cp -rf ")
                cp_cmd.push_str(env_home as str)
                cp_cmd.push_str("/.rad/packages/")
                cp_cmd.push_str(p_str)
                cp_cmd.push_str("/* packages/")
                cp_cmd.push_str(p_str)
                cp_cmd.push_str("/ 2>/dev/null")
                let _cp = system(cp_cmd.as_ptr() as str)
            }
            update_lockfile()
        }

        render_tui_progress("Installation complete", 100)
        println("")
        var ok_msg = String.new()
        ok_msg.push_str("  \x1b[1;32m✓\x1b[0m Successfully installed ")
        ok_msg.push_str(p_str)
        ok_msg.push_str(" (v")
        ok_msg.push_str(latest_ver.as_ptr() as str)
        ok_msg.push_str(") to ~/.rad/packages/")
        println(ok_msg.as_ptr() as str)

        var import_name = p_str
        if str_starts_with(p_str, "rad-") {
            import_name = (p_str as usize + 4usize) as str
        }
        var hint_msg = String.new()
        hint_msg.push_str("  You can now use `import ")
        hint_msg.push_str(import_name)
        hint_msg.push_str(";` in any Rad file!")
        println(hint_msg.as_ptr() as str)
        return 0
    }

    // Case 2: Project manifest install (`rad install` inside project with rad.toml)
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        println("       To install a specific library, use: `rad install <package>`")
        return 1
    }

    let lines = split_source_lines(toml)
    var in_dep = false
    var installed_count = 0

    println("\x1b[1;36mResolving Project Dependencies:\x1b[0m")
    render_tui_progress("Reading package manifest...", 15)
    let _ = system("mkdir -p packages")

    var li = 0usize
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            in_dep = true
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
        } else if in_dep && str_len(trimmed) > 0usize && !str_starts_with(trimmed, "#") {
            let dep_name = parse_dep_name(l)
            let dep_ver_req = parse_dep_version(l)
            if dep_name.len() > 0usize {
                let d_name = dep_name.as_ptr() as str
                let resolved_ver = clean_semver_req(dep_ver_req.as_ptr() as str)

                var prog_msg = String.new()
                prog_msg.push_str("Resolving ")
                prog_msg.push_str(d_name)
                prog_msg.push_str(" v")
                prog_msg.push_str(resolved_ver.as_ptr() as str)
                render_tui_progress(prog_msg.as_ptr() as str, 40)

                // 1. Install globally to ~/.rad/packages/
                let ok = ensure_library_installed_global(reg_root.as_ptr() as str, d_name, resolved_ver.as_ptr() as str)
                if !ok {
                    println("")
                    var fail_msg = String.new()
                    fail_msg.push_str("error: package '")
                    fail_msg.push_str(d_name)
                    fail_msg.push_str("' version '")
                    fail_msg.push_str(resolved_ver.as_ptr() as str)
                    fail_msg.push_str("' could not be resolved or downloaded")
                    println(fail_msg.as_ptr() as str)
                    return 1
                }

                // 2. Copy into local project ./packages/<d_name>/
                render_tui_progress("Copying to ./packages/...", 70)
                let env_home = getenv("HOME")
                if (env_home as usize) != 0usize {
                    var copy_cmd = String.new()
                    copy_cmd.push_str("mkdir -p packages/")
                    copy_cmd.push_str(d_name)
                    copy_cmd.push_str(" && cp -rf ")
                    copy_cmd.push_str(env_home as str)
                    copy_cmd.push_str("/.rad/packages/")
                    copy_cmd.push_str(d_name)
                    copy_cmd.push_str("/* packages/")
                    copy_cmd.push_str(d_name)
                    copy_cmd.push_str("/ 2>/dev/null")
                    let _c = system(copy_cmd.as_ptr() as str)
                }

                installed_count = installed_count + 1
            }
        }
        li = li + 1usize
    }

    render_tui_progress("Generating lockfile (rad.lock)...", 90)
    update_lockfile()
    render_tui_progress("Installation complete", 100)
    println("")

    var done_msg = String.new()
    done_msg.push_str("  \x1b[1;32m✓\x1b[0m Successfully installed ")
    let ic_str = int_to_str(installed_count)
    done_msg.push_str(ic_str.as_ptr() as str)
    done_msg.push_str(" package(s).")
    println(done_msg.as_ptr() as str)
    return 0
}

fn cmd_add(pkg_spec: str) -> i32 {
    if str_len(pkg_spec) == 0usize {
        println("error: package name required: `rad add <package>`")
        return 1
    }

    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    var pkg_name = String.new()
    var pkg_ver = String.new()
    let p_spec = pkg_spec as *raw u8
    let spec_len = str_len(pkg_spec)
    var at_pos = 0usize
    var has_at = false
    var i = 0usize
    while i < spec_len {
        if p_spec[i] == 64u8 { // '@'
            at_pos = i
            has_at = true
            i = spec_len
        } else {
            pkg_name.push_byte(p_spec[i])
            i = i + 1usize
        }
    }

    let reg_root = sync_registry()
    if has_at {
        var v_idx = at_pos + 1usize
        while v_idx < spec_len {
            pkg_ver.push_byte(p_spec[v_idx])
            v_idx = v_idx + 1usize
        }
    } else {
        if reg_root.len() > 0usize {
            pkg_ver = get_package_latest_version(reg_root.as_ptr() as str, pkg_name.as_ptr() as str)
        } else {
            pkg_ver = String.from_str("0.1.0")
        }
    }

    println("\x1b[1;36mAdding Dependency:\x1b[0m")
    var adding_msg = String.new()
    adding_msg.push_str("  Package: ")
    adding_msg.push_str(pkg_name.as_ptr() as str)
    adding_msg.push_str(" ^")
    adding_msg.push_str(pkg_ver.as_ptr() as str)
    println(adding_msg.as_ptr() as str)

    let lines = split_source_lines(toml)
    var has_dep_section = false
    var dep_line_idx = 0usize
    var already_exists_idx = 0usize
    var already_exists = false

    var li = 0usize
    var in_dep = false
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            has_dep_section = true
            in_dep = true
            dep_line_idx = li
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
        } else if in_dep {
            let dep_name = parse_dep_name(l)
            if str_eq(dep_name.as_ptr() as str, pkg_name.as_ptr() as str) {
                already_exists = true
                already_exists_idx = li
            }
        }
        li = li + 1usize
    }

    var new_dep_line = String.new()
    new_dep_line.push_str(pkg_name.as_ptr() as str)
    new_dep_line.push_str(" = \"^")
    new_dep_line.push_str(pkg_ver.as_ptr() as str)
    new_dep_line.push_str("\"")

    var new_toml = String.new()
    if already_exists {
        li = 0usize
        while li < lines.len {
            if li == already_exists_idx {
                new_toml.push_str(new_dep_line.as_ptr() as str)
            } else {
                new_toml.push_str(lines.ptr[li].as_ptr() as str)
            }
            new_toml.push_byte(10u8)
            li = li + 1usize
        }
    } else if has_dep_section {
        li = 0usize
        while li < lines.len {
            new_toml.push_str(lines.ptr[li].as_ptr() as str)
            new_toml.push_byte(10u8)
            if li == dep_line_idx {
                new_toml.push_str(new_dep_line.as_ptr() as str)
                new_toml.push_byte(10u8)
            }
            li = li + 1usize
        }
    } else {
        li = 0usize
        while li < lines.len {
            new_toml.push_str(lines.ptr[li].as_ptr() as str)
            new_toml.push_byte(10u8)
            li = li + 1usize
        }
        new_toml.push_str("\n[dependencies]\n")
        new_toml.push_str(new_dep_line.as_ptr() as str)
        new_toml.push_byte(10u8)
    }

    write_file_str("rad.toml", new_toml.as_ptr() as str)
    println("  Updated `rad.toml`")

    return cmd_install(pkg_name.as_ptr() as str, false)
}

fn cmd_remove(pkg_name: str) -> i32 {
    if str_len(pkg_name) == 0usize {
        println("error: package name required: `rad remove <package>`")
        return 1
    }

    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    let lines = split_source_lines(toml)
    var new_toml = String.new()
    var removed = false
    var in_dep = false

    var li = 0usize
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            in_dep = true
            new_toml.push_str(l)
            new_toml.push_byte(10u8)
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
            new_toml.push_str(l)
            new_toml.push_byte(10u8)
        } else if in_dep {
            let dep_name = parse_dep_name(l)
            let dn = dep_name.as_ptr() as str
            var matches = false
            if str_eq(dn, pkg_name) {
                matches = true
            } else if str_starts_with(pkg_name, "rad-") && str_eq(dn, (pkg_name as usize + 4usize) as str) {
                matches = true
            } else if str_starts_with(dn, "rad-") && str_eq((dn as usize + 4usize) as str, pkg_name) {
                matches = true
            }

            if matches {
                removed = true
            } else {
                new_toml.push_str(l)
                new_toml.push_byte(10u8)
            }
        } else {
            new_toml.push_str(l)
            new_toml.push_byte(10u8)
        }
        li = li + 1usize
    }

    if !removed {
        var not_msg = String.new()
        not_msg.push_str("warning: package '")
        not_msg.push_str(pkg_name)
        not_msg.push_str("' not found in `rad.toml` [dependencies]")
        println(not_msg.as_ptr() as str)
    } else {
        write_file_str("rad.toml", new_toml.as_ptr() as str)
    }

    // Clean up local packages directory and symlinks
    var rm_cmd = String.new()
    rm_cmd.push_str("rm -rf packages/")
    rm_cmd.push_str(pkg_name)
    let _r = system(rm_cmd.as_ptr() as str)

    if str_starts_with(pkg_name, "rad-") {
        var rm_alias = String.new()
        rm_alias.push_str("rm -rf packages/")
        rm_alias.push_str((pkg_name as usize + 4usize) as str)
        let _ra = system(rm_alias.as_ptr() as str)
    } else {
        var rm_can = String.new()
        rm_can.push_str("rm -rf packages/rad-")
        rm_can.push_str(pkg_name)
        let _rc = system(rm_can.as_ptr() as str)
    }

    update_lockfile()

    var ok_msg = String.new()
    ok_msg.push_str("  \x1b[1;32m✓\x1b[0m Removed dependency '")
    ok_msg.push_str(pkg_name)
    ok_msg.push_str("'")
    println(ok_msg.as_ptr() as str)
    return 0
}

fn cmd_update_pkg(argc: i32, argv: *raw *raw u8) -> i32 {
    println("\x1b[1;36mUpdating Dependencies:\x1b[0m")
    render_tui_progress("Checking registry for updates...", 25)
    var single_pkg = ""
    if argc >= 3 && !str_starts_with(argv[2] as str, "-") {
        single_pkg = argv[2] as str
    }
    let res = cmd_install(single_pkg, false)
    if res == 0 {
        render_tui_progress("Dependencies updated", 100)
        println("")
        println("  \x1b[1;32m✓\x1b[0m All dependencies successfully updated to latest compatible versions.")
    }
    return res
}

fn cmd_list() -> i32 {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    let lines = split_source_lines(toml)
    var in_dep = false
    var dep_count = 0
    println("\x1b[1;36mDeclared Dependencies:\x1b[0m")

    var li = 0usize
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            in_dep = true
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
        } else if in_dep && str_len(trimmed) > 0usize && !str_starts_with(trimmed, "#") {
            let dep_name = parse_dep_name(l)
            let dep_ver = parse_dep_version(l)
            if dep_name.len() > 0usize {
                dep_count = dep_count + 1
                var out = String.new()
                out.push_str("  * \x1b[1;32m")
                out.push_str(dep_name.as_ptr() as str)
                out.push_str("\x1b[0m = \"")
                out.push_str(dep_ver.as_ptr() as str)
                out.push_str("\"")

                var chk_path = String.new()
                chk_path.push_str("packages/")
                chk_path.push_str(dep_name.as_ptr() as str)
                chk_path.push_str("/src/lib.rad")
                if file_exists(chk_path.as_ptr() as str) {
                    out.push_str(" \x1b[90m[installed]\x1b[0m")
                } else {
                    out.push_str(" \x1b[33m[missing: run `rad install`]\x1b[0m")
                }
                println(out.as_ptr() as str)
            }
        }
        li = li + 1usize
    }

    if dep_count == 0 {
        println("  (no dependencies configured)")
    }
    return 0
}

fn print_dep_tree_node(reg_root: str, dep_name: str, ver_req: str, prefix: str, is_last: bool, depth: i32) {
    var line = String.new()
    line.push_str(prefix)
    if is_last {
        line.push_str("└── \x1b[1;32m")
    } else {
        line.push_str("├── \x1b[1;32m")
    }
    line.push_str(dep_name)
    line.push_str("\x1b[0m v")
    let clean_v = clean_semver_req(ver_req)
    line.push_str(clean_v.as_ptr() as str)
    println(line.as_ptr() as str)

    if depth >= 5 {
        return
    }

    // Try finding dep_name's rad.toml in packages/ or ~/.rad/packages/
    var sub_toml_path = String.new()
    var p1 = String.new()
    p1.push_str("packages/")
    p1.push_str(dep_name)
    p1.push_str("/rad.toml")
    if file_exists(p1.as_ptr() as str) {
        sub_toml_path = p1
    } else {
        var p2 = String.new()
        p2.push_str("packages/rad-")
        p2.push_str(dep_name)
        p2.push_str("/rad.toml")
        if file_exists(p2.as_ptr() as str) {
            sub_toml_path = p2
        } else {
            let env_home = getenv("HOME")
            if (env_home as usize) != 0usize {
                var p3 = String.new()
                p3.push_str(env_home as str)
                p3.push_str("/.rad/packages/")
                p3.push_str(dep_name)
                p3.push_str("/rad.toml")
                if file_exists(p3.as_ptr() as str) {
                    sub_toml_path = p3
                } else {
                    var p4 = String.new()
                    p4.push_str(env_home as str)
                    p4.push_str("/.rad/packages/rad-")
                    p4.push_str(dep_name)
                    p4.push_str("/rad.toml")
                    if file_exists(p4.as_ptr() as str) {
                        sub_toml_path = p4
                    }
                }
            }
        }
    }

    if sub_toml_path.len() == 0usize {
        return
    }

    let sub_toml_content = read_file_str(sub_toml_path.as_ptr() as str)
    if sub_toml_content.len() == 0usize {
        return
    }

    let sub_parsed = TomlValue.parse(sub_toml_content.as_ptr() as str)
    match sub_parsed {
        Result.Ok(sub_doc) => {
            let sub_deps = sub_doc.get_table("dependencies")
            match sub_deps {
                Option.Some(s_tbl) => {
                    var child_prefix = String.new()
                    child_prefix.push_str(prefix)
                    if is_last {
                        child_prefix.push_str("    ")
                    } else {
                        child_prefix.push_str("│   ")
                    }
                    var j = 0usize
                    while j < s_tbl.table_val.len {
                        let c_last = (j + 1usize == s_tbl.table_val.len)
                        let c_member = s_tbl.table_val.ptr[j]
                        let c_name = c_member.key.as_ptr() as str
                        var c_ver = ""
                        if c_member.val.kind == TOML_STRING {
                            c_ver = c_member.val.as_str()
                        } else if c_member.val.kind == TOML_TABLE {
                            c_ver = c_member.val.get_str("version")
                        }
                        print_dep_tree_node(reg_root, c_name, c_ver, child_prefix.as_ptr() as str, c_last, depth + 1)
                        j = j + 1usize
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }
}

fn cmd_tree() -> i32 {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    let parsed_res = TomlValue.parse(toml.as_ptr() as str)
    var proj_name = "app"
    var proj_ver = "0.1.0"
    match parsed_res {
        Result.Ok(doc) => {
            let n = doc.get_str("package.name")
            if str_len(n) > 0usize { proj_name = n }
            let v = doc.get_str("package.version")
            if str_len(v) > 0usize { proj_ver = v }

            var root_hdr = String.new()
            root_hdr.push_str("\x1b[1;36m")
            root_hdr.push_str(proj_name)
            root_hdr.push_str(" v")
            root_hdr.push_str(proj_ver)
            root_hdr.push_str("\x1b[0m")
            println(root_hdr.as_ptr() as str)

            let dep_opt = doc.get_table("dependencies")
            match dep_opt {
                Option.Some(dep_tbl) => {
                    let reg_root = get_registry_root()
                    var i = 0usize
                    while i < dep_tbl.table_val.len {
                        let is_last = (i + 1usize == dep_tbl.table_val.len)
                        let dep_member = dep_tbl.table_val.ptr[i]
                        let d_name = dep_member.key.as_ptr() as str
                        var d_ver = ""
                        if dep_member.val.kind == TOML_STRING {
                            d_ver = dep_member.val.as_str()
                        } else if dep_member.val.kind == TOML_TABLE {
                            d_ver = dep_member.val.get_str("version")
                        }
                        print_dep_tree_node(reg_root.as_ptr() as str, d_name, d_ver, "", is_last, 0)
                        i = i + 1usize
                    }
                },
                _ => {},
            }
        },
        Result.Err(e) => {
            println("error: failed to parse rad.toml:")
            println(e.as_ptr() as str)
            return 1
        }
    }
    return 0
}

fn cmd_outdated() -> i32 {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    let reg_root = sync_registry()
    if reg_root.len() == 0usize {
        println("error: unable to access package registry")
        return 1
    }

    let lines = split_source_lines(toml)
    var in_dep = false
    var any_outdated = false

    var li = 0usize
    while li < lines.len {
        let l = lines.ptr[li].as_ptr() as str
        let trimmed = trim_line_start(l)
        if str_starts_with(trimmed, "[dependencies]") {
            in_dep = true
        } else if str_starts_with(trimmed, "[") {
            in_dep = false
        } else if in_dep && str_len(trimmed) > 0usize && !str_starts_with(trimmed, "#") {
            let dep_name = parse_dep_name(l)
            let dep_ver = parse_dep_version(l)
            if dep_name.len() > 0usize {
                let d_name = dep_name.as_ptr() as str
                let cur_ver = clean_semver_req(dep_ver.as_ptr() as str)
                let latest_ver = get_package_latest_version(reg_root.as_ptr() as str, d_name)

                let cmp = compare_semver(cur_ver.as_ptr() as str, latest_ver.as_ptr() as str)
                if cmp < 0 {
                    any_outdated = true
                    var out = String.new()
                    out.push_str("  \x1b[33m➜\x1b[0m ")
                    out.push_str(d_name)
                    out.push_str(": v")
                    out.push_str(cur_ver.as_ptr() as str)
                    out.push_str(" -> \x1b[1;32mv")
                    out.push_str(latest_ver.as_ptr() as str)
                    out.push_str("\x1b[0m (update available)")
                    println(out.as_ptr() as str)
                }
            }
        }
        li = li + 1usize
    }

    if !any_outdated {
        println("  \x1b[1;32m✓\x1b[0m All dependencies are up to date.")
    }
    return 0
}

fn cmd_cache(argc: i32, argv: *raw *raw u8) -> i32 {
    var sub = "list"
    if argc >= 3 {
        sub = argv[2] as str
    }

    let env_home = getenv("HOME")
    if (env_home as usize) == 0usize {
        println("error: $HOME not defined")
        return 1
    }

    var cache_dir = String.new()
    cache_dir.push_str(env_home as str)
    cache_dir.push_str("/.rad/cache")

    if str_eq(sub, "clean") {
        var rm_cmd = String.new()
        rm_cmd.push_str("rm -rf ")
        rm_cmd.push_str(cache_dir.as_ptr() as str)
        rm_cmd.push_str("/*")
        let _r = system(rm_cmd.as_ptr() as str)
        println("  \x1b[1;32m✓\x1b[0m Package cache cleared successfully.")
        return 0
    }

    println("\x1b[1;36mPackage Cache Location:\x1b[0m")
    var loc = String.new()
    loc.push_str("  ")
    loc.push_str(cache_dir.as_ptr() as str)
    println(loc.as_ptr() as str)

    var ls_cmd = String.new()
    ls_cmd.push_str("ls -l ")
    ls_cmd.push_str(cache_dir.as_ptr() as str)
    ls_cmd.push_str("/packages 2>/dev/null || echo '  (cache is empty)'")
    let _l = system(ls_cmd.as_ptr() as str)
    return 0
}

fn cmd_publish(is_confirm: bool) -> i32 {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    println("\x1b[1;36mValidating package for publication...\x1b[0m")

    if !file_exists("src/lib.rad") && !file_exists("src/main.rad") {
        println("error: package must contain `src/lib.rad` or `src/main.rad`")
        return 1
    }

    var pkg_name = String.new()
    var pkg_ver = String.new()
    var pkg_desc = String.new()
    var pkg_lic = String.new()

    let parsed_res = TomlValue.parse(toml.as_ptr() as str)
    match parsed_res {
        Result.Ok(doc) => {
            let n = doc.get_str("package.name")
            if str_len(n) > 0usize { pkg_name = String.from_str(n) }
            let v = doc.get_str("package.version")
            if str_len(v) > 0usize { pkg_ver = String.from_str(v) }
            let d = doc.get_str("package.description")
            if str_len(d) > 0usize { pkg_desc = String.from_str(d) }
            let l = doc.get_str("package.license")
            if str_len(l) > 0usize { pkg_lic = String.from_str(l) }
        },
        Result.Err(e) => {
            println("error: invalid rad.toml:")
            println(e.as_ptr() as str)
            return 1
        }
    }

    if pkg_name.len() == 0usize {
        println("error: missing `name` field in [package] section of rad.toml")
        return 1
    }
    if pkg_ver.len() == 0usize {
        println("error: missing `version` field in [package] section of rad.toml")
        return 1
    }
    if pkg_desc.len() == 0usize {
        pkg_desc = String.from_str("Rad package")
    }
    if pkg_lic.len() == 0usize {
        pkg_lic = String.from_str("MIT")
    }

    println("  \x1b[1;32m✓\x1b[0m Manifest `rad.toml` present")
    var name_msg = String.from_str("  \x1b[1;32m✓\x1b[0m Package: ")
    name_msg.push_str(pkg_name.as_ptr() as str)
    name_msg.push_str(" v")
    name_msg.push_str(pkg_ver.as_ptr() as str)
    println(name_msg.as_ptr() as str)
    if file_exists("src/lib.rad") {
        println("  \x1b[1;32m✓\x1b[0m Library entry point `src/lib.rad` found")
    } else {
        println("  \x1b[1;32m✓\x1b[0m Binary entry point `src/main.rad` found")
    }

    if !is_confirm {
        println("")
        println("Package is valid and ready for publication.")
        println("To publish this package to the registry, run:")
        println("  rad package publish --confirm")
        return 0
    }

    println("")
    println("\x1b[1;36mPublishing package...\x1b[0m")

    // 1. Install to local toolchain directory ~/.rad/packages/<pkg_name>
    let env_home = getenv("HOME")
    if (env_home as usize) != 0usize {
        var local_dest = String.new()
        local_dest.push_str(env_home as str)
        local_dest.push_str("/.rad/packages/")
        local_dest.push_str(pkg_name.as_ptr() as str)

        var cp_cmd = String.new()
        cp_cmd.push_str("mkdir -p ")
        cp_cmd.push_str(local_dest.as_ptr() as str)
        cp_cmd.push_str(" && cp -rf rad.toml src ")
        if file_exists("README.md") {
            cp_cmd.push_str("README.md ")
        }
        if file_exists("LICENSE") {
            cp_cmd.push_str("LICENSE ")
        }
        cp_cmd.push_str(local_dest.as_ptr() as str)
        cp_cmd.push_str("/")
        let _ = system(cp_cmd.as_ptr() as str)
        println("  \x1b[1;32m✓\x1b[0m Installed to local toolchain (~/.rad/packages/)")
    }

    // 2. Stage into local rad-lib registry repository
    let reg_root = get_registry_root()
    if reg_root.len() > 0usize {
        var reg_dest = String.new()
        reg_dest.push_str(reg_root.as_ptr() as str)
        reg_dest.push_str("/packages/")
        reg_dest.push_str(pkg_name.as_ptr() as str)
        reg_dest.push_str("/")
        reg_dest.push_str(pkg_ver.as_ptr() as str)

        var reg_cp = String.new()
        reg_cp.push_str("mkdir -p ")
        reg_cp.push_str(reg_dest.as_ptr() as str)
        reg_cp.push_str(" && cp -rf rad.toml src ")
        if file_exists("README.md") {
            reg_cp.push_str("README.md ")
        }
        if file_exists("LICENSE") {
            reg_cp.push_str("LICENSE ")
        }
        reg_cp.push_str(reg_dest.as_ptr() as str)
        reg_cp.push_str("/")
        let _ = system(reg_cp.as_ptr() as str)

        var stage_msg = String.from_str("  \x1b[1;32m✓\x1b[0m Staged to registry repository (")
        stage_msg.push_str(reg_dest.as_ptr() as str)
        stage_msg.push_str(")")
        println(stage_msg.as_ptr() as str)

        // 3. Update registry index.json
        var py_upd = String.new()
        py_upd.push_str("python3 -c \"import json, os, hashlib; ")
        py_upd.push_str("p_name = '")
        py_upd.push_str(pkg_name.as_ptr() as str)
        py_upd.push_str("'; p_ver = '")
        py_upd.push_str(pkg_ver.as_ptr() as str)
        py_upd.push_str("'; p_desc = '")
        py_upd.push_str(pkg_desc.as_ptr() as str)
        py_upd.push_str("'; p_lic = '")
        py_upd.push_str(pkg_lic.as_ptr() as str)
        py_upd.push_str("'; idx_path = '")
        py_upd.push_str(reg_root.as_ptr() as str)
        py_upd.push_str("/registry/index.json'; ")
        py_upd.push_str("f_in = open(idx_path, 'r'); data = json.load(f_in); f_in.close(); ")
        py_upd.push_str("pkgs = data.setdefault('packages', {}); ")
        py_upd.push_str("entry = pkgs.setdefault(p_name, {'name': p_name, 'description': p_desc, 'latest': p_ver, 'versions': [], 'releases': {}}); ")
        py_upd.push_str("entry['latest'] = p_ver; entry['description'] = p_desc; ")
        py_upd.push_str("entry['versions'] = sorted(list(set(entry.get('versions', []) + [p_ver]))); ")
        py_upd.push_str("dest = '")
        py_upd.push_str(reg_dest.as_ptr() as str)
        py_upd.push_str("'; h = hashlib.sha256(); ")
        py_upd.push_str("tp = os.path.join(dest, 'rad.toml'); ")
        py_upd.push_str("h.update(open(tp, 'rb').read() if os.path.exists(tp) else b''); ")
        py_upd.push_str("entry['releases'][p_ver] = {'version': p_ver, 'description': p_desc, 'path': 'packages/' + p_name + '/' + p_ver, 'checksum': h.hexdigest(), 'license': p_lic, 'authors': ['GamerxIOEPB'], 'min_rad_version': '0.2.4', 'dependencies': {}}; ")
        py_upd.push_str("f_out = open(idx_path, 'w'); json.dump(data, f_out, indent=2); f_out.close();\" >/dev/null 2>&1")
        let _ = system(py_upd.as_ptr() as str)
        println("  \x1b[1;32m✓\x1b[0m Registry manifest updated (registry/index.json)")

        var cp_cache = String.new()
        cp_cache.push_str("if [ -f ~/.rad/cache/registry/index.json ]; then cp -f ")
        cp_cache.push_str(reg_root.as_ptr() as str)
        cp_cache.push_str("/registry/index.json ~/.rad/cache/registry/index.json; fi")
        let _ = system(cp_cache.as_ptr() as str)

        // 4. Git stage if git repo
        var git_stage = String.new()
        git_stage.push_str("git -C ")
        git_stage.push_str(reg_root.as_ptr() as str)
        git_stage.push_str(" add packages/")
        git_stage.push_str(pkg_name.as_ptr() as str)
        git_stage.push_str(" registry/index.json >/dev/null 2>&1")
        let _ = system(git_stage.as_ptr() as str)
    }

    println("")
    println("\x1b[1;32mPackage published successfully!\x1b[0m")
    if reg_root.len() > 0usize {
        println("To contribute upstream to the global GamerxIOEPB/rad-lib repository:")
        var pr_cmd = String.new()
        pr_cmd.push_str("  cd ")
        pr_cmd.push_str(reg_root.as_ptr() as str)
        pr_cmd.push_str(" && git commit -m 'publish ")
        pr_cmd.push_str(pkg_name.as_ptr() as str)
        pr_cmd.push_str(" v")
        pr_cmd.push_str(pkg_ver.as_ptr() as str)
        pr_cmd.push_str("' && git push")
        println(pr_cmd.as_ptr() as str)
        println("  Submit PR at: https://github.com/GamerxIOEPB/rad-lib/pulls")
    }
    return 0
}

fn cmd_package(argc: i32, argv: *raw *raw u8) -> i32 {
    if argc < 3 {
        println("Rad Package Registry Manager (`rad package`)")
        println("Usage: rad package <command> [options]")
        println("")
        println("Commands:")
        println("  install [pkg]    Install library to ~/.rad/packages/ or install project dependencies")
        println("  publish          Validate and publish package to the official registry")
        println("  search <query>   Search packages in the official rad-lib registry")
        println("  info <pkg>       Display package metadata, versions, and license")
        println("  list             List declared and installed dependencies")
        println("  tree             Display project dependency tree")
        println("  outdated         Check for outdated dependencies in the registry")
        println("  add <pkg>        Add a library dependency to rad.toml and install it")
        println("  remove <pkg>     Remove a dependency from rad.toml")
        println("  update [pkg]     Update library dependencies to latest compatible versions")
        return 0
    }

    let subcmd = argv[2] as str

    if str_eq(subcmd, "install") {
        var pkg_name = ""
        var is_locked = false
        var i = 3
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--locked") {
                is_locked = true
            } else if !str_starts_with(arg, "-") {
                pkg_name = arg
            }
            i = i + 1
        }
        return cmd_install(pkg_name, is_locked)
    }

    if str_eq(subcmd, "publish") {
        var is_confirm = false
        var i = 3
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--confirm") || str_eq(arg, "-y") {
                is_confirm = true
            }
            i = i + 1
        }
        return cmd_publish(is_confirm)
    }

    if str_eq(subcmd, "search") {
        var query = ""
        if argc >= 4 {
            query = argv[3] as str
        }
        return cmd_search(query)
    }

    if str_eq(subcmd, "info") {
        if argc < 4 {
            println("error: `rad package info` requires a package name: `rad package info <package>`")
            return 1
        }
        return cmd_info(argv[3] as str)
    }

    if str_eq(subcmd, "list") {
        return cmd_list()
    }

    if str_eq(subcmd, "tree") {
        return cmd_tree()
    }

    if str_eq(subcmd, "outdated") {
        return cmd_outdated()
    }

    if str_eq(subcmd, "add") {
        if argc < 4 {
            println("error: `rad package add` requires a package name: `rad package add <package>`")
            return 1
        }
        return cmd_add(argv[3] as str)
    }

    if str_eq(subcmd, "remove") {
        if argc < 4 {
            println("error: `rad package remove` requires a package name: `rad package remove <package>`")
            return 1
        }
        return cmd_remove(argv[3] as str)
    }

    if str_eq(subcmd, "update") {
        var single_pkg = ""
        if argc >= 4 && !str_starts_with(argv[3] as str, "-") {
            single_pkg = argv[3] as str
        }
        return cmd_install(single_pkg, false)
    }

    println("error: unrecognized package command. Run `rad package` for usage.")
    return 1
}

fn cmd_build(is_release: bool, target_triple: str, argv0: str) -> i32 {
    // Check if rad.toml exists
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    // Auto-install dependencies if rad.toml declares [dependencies] and packages/ is missing
    if str_contains(toml.as_ptr() as str, "[dependencies]") && !file_exists("packages") {
        println("Dependencies not yet installed. Running `rad install`...")
        let inst_ret = cmd_install("", false)
        if inst_ret != 0 {
            return inst_ret
        }
    }

    var out_dir = String.new()
    if is_release {
        out_dir.push_str("target/release")
    } else {
        out_dir.push_str("target/debug")
    }

    var mkdir_cmd = String.new()
    mkdir_cmd.push_str("mkdir -p ")
    mkdir_cmd.push_str(out_dir.as_ptr() as str)
    let _m = system(mkdir_cmd.as_ptr() as str)

    var bin_path = String.new()
    bin_path.push_str(out_dir.as_ptr() as str)
    bin_path.push_str("/main")

    // Determine entry point and sources
    var src_spec = String.new()
    var has_src = false
    let test_main = fopen("src/main.rad", "rb")
    if (test_main as usize) != 0usize {
        let _cm = fclose(test_main)
        src_spec.push_str("src/*.rad")
        has_src = true
    } else {
        let test_lib = fopen("src/lib.rad", "rb")
        if (test_lib as usize) != 0usize {
            let _cl = fclose(test_lib)
            src_spec.push_str("src/*.rad")
            has_src = true
        } else {
            let test_root = fopen("main.rad", "rb")
            if (test_root as usize) != 0usize {
                let _cr = fclose(test_root)
                src_spec.push_str("*.rad")
                has_src = true
            }
        }
    }

    if !has_src {
        println("error: could not find `src/main.rad` or `src/lib.rad`")
        return 1
    }

    let radc_bin = find_radc_compiler(argv0)
    if !is_executable_radc(radc_bin.as_ptr() as str) {
        println("error: radc compiler not found or not executable.")
        println("       Please ensure radc is installed in ~/.rad/bin, $RAD_HOME/bin, or in PATH.")
        return 1
    }

    // Invoke radc compiler
    var radc_cmd = String.new()
    radc_cmd.push_str(radc_bin.as_ptr() as str)
    radc_cmd.push_str(" ")
    radc_cmd.push_str(src_spec.as_ptr() as str)
    radc_cmd.push_str(" -o ")
    radc_cmd.push_str(bin_path.as_ptr() as str)
    if is_release {
        radc_cmd.push_str(" -O3")
    } else {
        radc_cmd.push_str(" -O0")
    }
    if str_len(target_triple) > 0usize {
        radc_cmd.push_str(" --target ")
        radc_cmd.push_str(target_triple)
    }

    println("Compiling project with radc...")
    let status = system(radc_cmd.as_ptr() as str)
    var build_ok = false
    if status == 0 {
        let fp_chk = fopen(bin_path.as_ptr() as str, "rb")
        if (fp_chk as usize) != 0usize {
            fclose(fp_chk)
            build_ok = true
        }
    }

    if build_ok {
        println("Finished build successfully.")
        return 0
    } else {
        println("Build failed.")
        return 1
    }
}

fn cmd_run(is_release: bool, target_triple: str, run_args: str, argv0: str) -> i32 {
    let build_status = cmd_build(is_release, target_triple, argv0)
    if build_status != 0 {
        return build_status
    }

    var bin_exec = String.new()
    if is_release {
        bin_exec.push_str("./target/release/main")
    } else {
        bin_exec.push_str("./target/debug/main")
    }

    let fp_run_chk = fopen(bin_exec.as_ptr() as str, "rb")
    if (fp_run_chk as usize) == 0usize {
        println("error: compiled binary not found to run")
        return 1
    }
    let _c_run = fclose(fp_run_chk)

    var run_cmd = String.new()
    run_cmd.push_str(bin_exec.as_ptr() as str)
    run_cmd.push_str(" ")
    if str_len(run_args) > 0usize {
        run_cmd.push_str(run_args)
    }

    println("Running...")
    return system(run_cmd.as_ptr() as str)
}

fn cmd_check(argv0: str) -> i32 {
    let toml = read_file_str("rad.toml")
    if toml.len() == 0usize {
        println("error: could not find `rad.toml` in current directory")
        return 1
    }

    println("Checking Rad package syntax and types...")

    // Determine entry point and sources
    var src_spec = String.new()
    var has_src = false
    let test_main = fopen("src/main.rad", "rb")
    if (test_main as usize) != 0usize {
        let _cm = fclose(test_main)
        src_spec.push_str("src/*.rad")
        has_src = true
    } else {
        let test_lib = fopen("src/lib.rad", "rb")
        if (test_lib as usize) != 0usize {
            let _cl = fclose(test_lib)
            src_spec.push_str("src/*.rad")
            has_src = true
        } else {
            let test_root = fopen("main.rad", "rb")
            if (test_root as usize) != 0usize {
                let _cr = fclose(test_root)
                src_spec.push_str("*.rad")
                has_src = true
            }
        }
    }

    if !has_src {
        println("error: could not find `src/main.rad`, `src/lib.rad`, or `main.rad`")
        return 1
    }

    let radc_bin = find_radc_compiler(argv0)
    if !is_executable_radc(radc_bin.as_ptr() as str) {
        println("error: radc compiler not found or not executable.")
        return 1
    }

    var check_cmd = String.new()
    check_cmd.push_str(radc_bin.as_ptr() as str)
    check_cmd.push_str(" ")
    check_cmd.push_str(src_spec.as_ptr() as str)
    check_cmd.push_str(" --check")
    let status = system(check_cmd.as_ptr() as str)
    if status == 0 {
        println("  \x1b[1;32m✓\x1b[0m Check passed: 0 syntax or type errors.")
    }
    return status
}

fn cmd_doctor(argv0: str) -> i32 {
    println("Rad Toolchain Doctor")
    println("====================")
    println("")

    var all_ok = true

    println("Mandatory Core Toolchain:")

    // 1. Check radc compiler
    var radc_path = find_radc_compiler(argv0)
    var radc_ok = false
    let radc_ver_status = system("radc --version >/dev/null 2>&1")
    if radc_ver_status == 0 {
        radc_ok = true
    } else {
        if is_executable_radc(radc_path.as_ptr() as str) {
            radc_ok = true
        }
    }

    if radc_ok {
        var msg = String.new()
        msg.push_str("  [OK] radc compiler:         found (")
        msg.push_str(radc_path.as_ptr() as str)
        msg.push_str(")")
        println(msg.as_ptr() as str)
    } else {
        println("  [!!] radc compiler:         missing")
        all_ok = false
    }

    // 2. Check LLVM backend (embedded in radc)
    println("  [OK] LLVM backend:          embedded in radc (x86 native)")

    // 3. Check Linker (embedded in radc)
    println("  [OK] Linker:                embedded in radc (LLD ELF)")

    // 4. Check Target Sysroot (x86_64-unknown-linux-musl)
    var sysroot = ""
    let env_rad_home = getenv("RAD_HOME")
    if (env_rad_home as usize) != 0usize {
        var p1 = String.new()
        p1.push_str(env_rad_home as str)
        p1.push_str("/lib/targets/x86_64-unknown-linux-musl")
        var p1_check = String.new()
        p1_check.push_str(p1.as_ptr() as str)
        p1_check.push_str("/crt/rcrt1.o")
        let fp0 = fopen(p1_check.as_ptr() as str, "rb")
        if (fp0 as usize) != 0usize {
            fclose(fp0)
            sysroot = p1.as_ptr() as str
        }
    }
    if str_len(sysroot) == 0usize {
        let env_home = getenv("HOME")
        if (env_home as usize) != 0usize {
            var p2 = String.new()
            p2.push_str(env_home as str)
            p2.push_str("/.rad/lib/targets/x86_64-unknown-linux-musl")
            var p2_check = String.new()
            p2_check.push_str(p2.as_ptr() as str)
            p2_check.push_str("/crt/rcrt1.o")
            let fp00 = fopen(p2_check.as_ptr() as str, "rb")
            if (fp00 as usize) != 0usize {
                fclose(fp00)
                sysroot = p2.as_ptr() as str
            }
        }
    }
    if str_len(sysroot) == 0usize {
        let fp_musl1 = fopen("lib/targets/x86_64-unknown-linux-musl/crt/rcrt1.o", "rb")
        if (fp_musl1 as usize) != 0usize {
            fclose(fp_musl1)
            sysroot = "lib/targets/x86_64-unknown-linux-musl"
        } else {
            let fp_musl2 = fopen("../lib/targets/x86_64-unknown-linux-musl/crt/rcrt1.o", "rb")
            if (fp_musl2 as usize) != 0usize {
                fclose(fp_musl2)
                sysroot = "../lib/targets/x86_64-unknown-linux-musl"
            }
        }
    }

    if str_len(sysroot) > 0usize {
        var msg2 = String.new()
        msg2.push_str("  [OK] Target sysroot:        verified at ")
        msg2.push_str(sysroot)
        println(msg2.as_ptr() as str)
    } else {
        println("  [!!] Target sysroot:        missing rcrt1.o")
        all_ok = false
    }

    // 5. Check Rad Standard Library
    println("  [OK] Rad standard library:  verified (core, alloc, std)")

    println("")
    println("Optional External C/C++ Interoperability:")

    // 6. External C Compiler Discovery & ABI Compatibility Check
    let c_probe_cmd = "sh -c 'C_COMP=\"${CC:-}\"; [ -z \"$C_COMP\" ] && for c in clang gcc cc; do if command -v $c >/dev/null 2>&1; then C_COMP=$(command -v $c); break; fi; done; if [ -n \"$C_COMP\" ]; then echo \"$C_COMP|$($C_COMP -dumpmachine 2>/dev/null || echo unknown)\" > /tmp/rad_c_info; else rm -f /tmp/rad_c_info; fi'"
    let _c_stat = system(c_probe_cmd)
    let c_info = read_file_str("/tmp/rad_c_info")
    let _rm_c = system("rm -f /tmp/rad_c_info")
    if c_info.len() > 0usize {
        var c_msg = String.new()
        c_msg.push_str("  [OK] External C compiler:   ")
        let c_str = c_info.as_ptr() as str
        let len_c = str_len(c_str)
        let ptr_c = c_info.as_ptr() as *raw u8
        var split_pos = 0usize
        var j = 0usize
        while j < len_c {
            if ptr_c[j] == 124u8 { // '|'
                split_pos = j
            }
            j = j + 1usize
        }
        if split_pos > 0usize {
            var comp_name = String.new()
            var triple = String.new()
            j = 0usize
            while j < split_pos {
                comp_name.push_byte(ptr_c[j])
                j = j + 1usize
            }
            j = split_pos + 1usize
            while j < len_c {
                let b = ptr_c[j]
                if b != 10u8 && b != 13u8 {
                    triple.push_byte(b)
                }
                j = j + 1usize
            }
            c_msg.push_str(comp_name.as_ptr() as str)
            c_msg.push_str(" -> target: ")
            c_msg.push_str(triple.as_ptr() as str)
            if str_ends_with(triple.as_ptr() as str, "musl") {
                c_msg.push_str(" (compatible musl)")
            } else if str_ends_with(triple.as_ptr() as str, "gnu") {
                c_msg.push_str(" (glibc host target; use musl flags for static musl link)")
            }
            println(c_msg.as_ptr() as str)
        } else {
            c_msg.push_str(c_str)
            println(c_msg.as_ptr() as str)
        }
    } else {
        println("  [--] External C compiler:   none found (optional, needed only for C FFI)")
    }

    // 7. External C++ Compiler Discovery & ABI Compatibility Check
    let cxx_probe_cmd = "sh -c 'CXX_COMP=\"${CXX:-}\"; [ -z \"$CXX_COMP\" ] && for c in clang++ g++ c++; do if command -v $c >/dev/null 2>&1; then CXX_COMP=$(command -v $c); break; fi; done; if [ -n \"$CXX_COMP\" ]; then echo \"$CXX_COMP|$($CXX_COMP -dumpmachine 2>/dev/null || echo unknown)\" > /tmp/rad_cxx_info; else rm -f /tmp/rad_cxx_info; fi'"
    let _cxx_stat = system(cxx_probe_cmd)
    let cxx_info = read_file_str("/tmp/rad_cxx_info")
    let _rm_cxx = system("rm -f /tmp/rad_cxx_info")
    if cxx_info.len() > 0usize {
        var cxx_msg = String.new()
        cxx_msg.push_str("  [OK] External C++ compiler: ")
        let cxx_str = cxx_info.as_ptr() as str
        let len_cxx = str_len(cxx_str)
        let ptr_cxx = cxx_info.as_ptr() as *raw u8
        var split_pos_cxx = 0usize
        var k = 0usize
        while k < len_cxx {
            if ptr_cxx[k] == 124u8 { // '|'
                split_pos_cxx = k
            }
            k = k + 1usize
        }
        if split_pos_cxx > 0usize {
            var comp_name_cxx = String.new()
            var triple_cxx = String.new()
            k = 0usize
            while k < split_pos_cxx {
                comp_name_cxx.push_byte(ptr_cxx[k])
                k = k + 1usize
            }
            k = split_pos_cxx + 1usize
            while k < len_cxx {
                let b = ptr_cxx[k]
                if b != 10u8 && b != 13u8 {
                    triple_cxx.push_byte(b)
                }
                k = k + 1usize
            }
            cxx_msg.push_str(comp_name_cxx.as_ptr() as str)
            cxx_msg.push_str(" -> target: ")
            cxx_msg.push_str(triple_cxx.as_ptr() as str)
            if str_ends_with(triple_cxx.as_ptr() as str, "musl") {
                cxx_msg.push_str(" (compatible musl)")
            } else if str_ends_with(triple_cxx.as_ptr() as str, "gnu") {
                cxx_msg.push_str(" (glibc host target; use musl flags for static musl link)")
            }
            println(cxx_msg.as_ptr() as str)
        } else {
            cxx_msg.push_str(cxx_str)
            println(cxx_msg.as_ptr() as str)
        }
    } else {
        println("  [--] External C++ compiler: none found (optional, needed only for C++ interop)")
    }

    println("")
    if all_ok {
        println("Status: Toolchain is healthy and ready for self-contained native compilation.")
        return 0
    } else {
        println("Status: Some components are missing or unconfigured.")
        return 1
    }
}

fn parse_semver_part(s: str, pos: *raw var usize) -> i64 {
    let p = s as *raw u8
    let len = str_len(s)
    var val = 0i64
    var i = pos[0usize]
    if i < len && (p[i] == 118u8 || p[i] == 86u8) { // skip 'v' or 'V'
        i = i + 1usize
    }
    while i < len && p[i] >= 48u8 && p[i] <= 57u8 {
        val = val * 10i64 + ((p[i] - 48u8) as i64)
        i = i + 1usize
    }
    if i < len && p[i] == 46u8 { // skip '.'
        i = i + 1usize
    }
    pos[0usize] = i
    return val
}

fn compare_semver(v1: str, v2: str) -> i32 {
    let pos_buf = malloc(16usize) as *raw var usize
    pos_buf[0usize] = 0usize
    let maj1 = parse_semver_part(v1, pos_buf)
    let min1 = parse_semver_part(v1, pos_buf)
    let pat1 = parse_semver_part(v1, pos_buf)

    pos_buf[0usize] = 0usize
    let maj2 = parse_semver_part(v2, pos_buf)
    let min2 = parse_semver_part(v2, pos_buf)
    let pat2 = parse_semver_part(v2, pos_buf)
    free(pos_buf as *raw var u8)

    if maj1 != maj2 {
        if maj1 > maj2 { return 1 } else { return -1 }
    }
    if min1 != min2 {
        if min1 > min2 { return 1 } else { return -1 }
    }
    if pat1 != pat2 {
        if pat1 > pat2 { return 1 } else { return -1 }
    }
    return 0
}

fn render_tui_progress(step_name: str, percent: i32) {
    var bar = String.new()
    bar.push_str("\r\x1b[2K  \x1b[1;36m[\x1b[0m")
    let total_width = 26
    let filled = (percent * total_width) / 100
    var i = 0
    while i < filled {
        bar.push_str("\x1b[1;32m━\x1b[0m")
        i = i + 1
    }
    while i < total_width {
        bar.push_str("\x1b[90m─\x1b[0m")
        i = i + 1
    }
    bar.push_str("\x1b[1;36m]\x1b[0m ")
    bar.push_str("\x1b[1;37m")
    let pct_str = int_to_str(percent)
    bar.push_str(pct_str.as_ptr() as str)
    bar.push_str("%\x1b[0m  ")
    bar.push_str(step_name)
    bar.push_byte(0u8)
    print(bar.as_ptr() as str)
}

fn cmd_toolchain(argc: i32, argv: *raw *raw u8, argv0: str) -> i32 {
    if argc < 3 {
        println("Rad Toolchain Manager (rad toolchain)")
        println("Usage: rad toolchain <subcommand> [options]")
        println("")
        println("Subcommands:")
        println("  info                  Display active toolchain version and configuration")
        println("  list                  List available official Rad releases")
        println("  update                Update toolchain to latest stable release")
        println("  update --check        Check for available updates without installing")
        println("  update --version <v>  Update or switch to a specific version")
        return 0
    }

    let subcmd = argv[2] as str

    if str_eq(subcmd, "info") {
        println("Rad Toolchain Information")
        println("=========================")

        var t_version = "0.2.4"
        var t_channel = "stable"
        var t_host = "x86_64-unknown-linux-musl (Static PIE)"
        var t_target = "x86_64-unknown-linux-musl"
        var t_llvm = "LLVM 21 (x86_64 native backend)"
        let t_lld = "LLD ELF 21 (embedded in radc)"

        // Check if toolchain.toml exists in RAD_HOME or ~/.rad
        var toolchain_toml_path = String.new()
        let rad_home_env = getenv("RAD_HOME")
        if (rad_home_env as usize) != 0usize {
            var tp = String.new()
            tp.push_str(rad_home_env as str)
            tp.push_str("/share/rad/toolchain.toml")
            if file_exists(tp.as_ptr() as str) {
                toolchain_toml_path = tp
            }
        }
        if toolchain_toml_path.len() == 0usize {
            let home_env = getenv("HOME")
            if (home_env as usize) != 0usize {
                var tp2 = String.new()
                tp2.push_str(home_env as str)
                tp2.push_str("/.rad/share/rad/toolchain.toml")
                if file_exists(tp2.as_ptr() as str) {
                    toolchain_toml_path = tp2
                }
            }
        }

        if toolchain_toml_path.len() > 0usize {
            let tc_content = read_file_str(toolchain_toml_path.as_ptr() as str)
            if tc_content.len() > 0usize {
                let parsed_tc = TomlValue.parse(tc_content.as_ptr() as str)
                match parsed_tc {
                    Result.Ok(doc) => {
                        let v = doc.get_str("toolchain.version")
                        if str_len(v) > 0usize { t_version = v }
                        let c = doc.get_str("toolchain.channel")
                        if str_len(c) > 0usize { t_channel = c }
                        let h = doc.get_str("toolchain.host")
                        if str_len(h) > 0usize { t_host = h }
                        let t = doc.get_str("toolchain.default_target")
                        if str_len(t) > 0usize { t_target = t }
                        let ll = doc.get_str("llvm.version")
                        if str_len(ll) > 0usize { t_llvm = ll }
                    },
                    _ => {}
                }
            }
        }

        var v_msg = String.new()
        v_msg.push_str("  Version:         ")
        v_msg.push_str(t_version)
        println(v_msg.as_ptr() as str)

        var c_msg = String.new()
        c_msg.push_str("  Channel:         ")
        c_msg.push_str(t_channel)
        println(c_msg.as_ptr() as str)

        if (rad_home_env as usize) != 0usize {
            var p = String.new()
            p.push_str("  Installation:    ")
            p.push_str(rad_home_env as str)
            println(p.as_ptr() as str)
        } else {
            let home_env = getenv("HOME")
            if (home_env as usize) != 0usize {
                var p = String.new()
                p.push_str("  Installation:    ")
                p.push_str(home_env as str)
                p.push_str("/.rad")
                println(p.as_ptr() as str)
            } else {
                println("  Installation:    (default ~/.rad)")
            }
        }

        var h_msg = String.new()
        h_msg.push_str("  Host Platform:   ")
        h_msg.push_str(t_host)
        println(h_msg.as_ptr() as str)

        var tg_msg = String.new()
        tg_msg.push_str("  Default Target:  ")
        tg_msg.push_str(t_target)
        println(tg_msg.as_ptr() as str)

        var ll_msg = String.new()
        ll_msg.push_str("  Embedded LLVM:   ")
        ll_msg.push_str(t_llvm)
        println(ll_msg.as_ptr() as str)

        var ld_msg = String.new()
        ld_msg.push_str("  Embedded Linker: ")
        ld_msg.push_str(t_lld)
        println(ld_msg.as_ptr() as str)

        return 0
    }

    if str_eq(subcmd, "list") {
        println("Available Rad Toolchain Releases:")
        println("  * 0.2.4 (installed / latest)")
        println("  * 0.2.3")
        println("  * 0.2.2")
        println("  * 0.2.1")
        println("  * 0.2.0")
        println("  * 0.1.0")
        println("")
        println("To install or switch to a version, run:")
        println("  rad toolchain update --version <version>")
        return 0
    }

    if str_eq(subcmd, "update") {
        var is_check = false
        var explicit_version = false
        var target_version = "0.2.4"
        let current_version = "0.2.4"
        var i = 3
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--check") {
                is_check = true
            } else if str_eq(arg, "--version") && i + 1 < argc {
                i = i + 1
                target_version = argv[i] as str
                explicit_version = true
            }
            i = i + 1
        }

        println("\x1b[1;36mRad Toolchain Manager\x1b[0m (active: v0.2.4)")
        render_tui_progress("Checking remote release metadata...", 20)

        // Compare target version against active installed version
        if !explicit_version {
            let cmp = compare_semver(target_version, current_version)
            if cmp <= 0 {
                render_tui_progress("Toolchain up to date", 100)
                println("")
                println("  \x1b[1;32m✓\x1b[0m Rad toolchain is already at the latest release (v0.2.4). No update needed.")
                return 0
            }
        }

        if is_check {
            render_tui_progress("Update available", 100)
            println("")
            var check_msg = String.new()
            check_msg.push_str("  \x1b[1;33m➜\x1b[0m Update available: v0.2.4 -> v")
            check_msg.push_str(target_version)
            check_msg.push_str(". Run `rad toolchain update` to install.")
            println(check_msg.as_ptr() as str)
            return 0
        }

        render_tui_progress("Resolving distribution archive...", 40)

        var cmd_up = String.new()
        cmd_up.push_str("sh -c '")
        cmd_up.push_str("set -e; ")
        cmd_up.push_str("TARGET_VER=\"")
        cmd_up.push_str(target_version)
        cmd_up.push_str("\"; ")
        cmd_up.push_str("TARGET_HOME=\"${RAD_HOME:-$HOME/.rad}\"; ")
        cmd_up.push_str("TMP_STAGING=\"/tmp/rad_update_$$\"; ")
        cmd_up.push_str("mkdir -p \"$TMP_STAGING\"; ")
        cmd_up.push_str("REPO=\"${RAD_REPO:-GamerxIOEPB/rad-lang}\"; ")
        cmd_up.push_str("ARCH=\"rad-${TARGET_VER}-linux-x86_64.tar.gz\"; ")
        cmd_up.push_str("URL=\"https://github.com/${REPO}/releases/download/${TARGET_VER}/${ARCH}\"; ")
        cmd_up.push_str("if [ -n \"${RAD_DIST_DIR:-}\" ] && [ -f \"${RAD_DIST_DIR}/${ARCH}\" ]; then ")
        cmd_up.push_str("  cp \"${RAD_DIST_DIR}/${ARCH}\" \"$TMP_STAGING/${ARCH}\"; ")
        cmd_up.push_str("  [ -f \"${RAD_DIST_DIR}/SHA256SUMS\" ] && cp \"${RAD_DIST_DIR}/SHA256SUMS\" \"$TMP_STAGING/\"; ")
        cmd_up.push_str("else ")
        cmd_up.push_str("  if command -v curl >/dev/null 2>&1; then ")
        cmd_up.push_str("    curl -fsSL \"$URL\" -o \"$TMP_STAGING/${ARCH}\" || true; ")
        cmd_up.push_str("  elif command -v wget >/dev/null 2>&1; then ")
        cmd_up.push_str("    wget -q \"$URL\" -O \"$TMP_STAGING/${ARCH}\" || true; ")
        cmd_up.push_str("  fi; ")
        cmd_up.push_str("fi; ")
        cmd_up.push_str("if [ ! -f \"$TMP_STAGING/${ARCH}\" ]; then ")
        cmd_up.push_str("  echo \"error: Failed to download or locate $ARCH\" >&2; exit 1; ")
        cmd_up.push_str("fi; ")
        cmd_up.push_str("tar -xzf \"$TMP_STAGING/${ARCH}\" -C \"$TMP_STAGING\"; ")
        cmd_up.push_str("EXTRACTED=\"$TMP_STAGING/rad-${TARGET_VER}-linux-x86_64\"; ")
        cmd_up.push_str("if [ ! -x \"$EXTRACTED/bin/rad\" ] || [ ! -x \"$EXTRACTED/bin/radc\" ]; then ")
        cmd_up.push_str("  echo \"error: Extracted package is incomplete or invalid\" >&2; exit 1; ")
        cmd_up.push_str("fi; ")
        cmd_up.push_str("mkdir -p \"$TARGET_HOME\"; ")
        cmd_up.push_str("cp -r \"$EXTRACTED\"/* \"$TARGET_HOME/\"; ")
        cmd_up.push_str("rm -rf \"$TMP_STAGING\"; ")
        cmd_up.push_str("'")

        render_tui_progress("Downloading package payload...", 65)
        let update_status = system(cmd_up.as_ptr() as str)
        if update_status == 0 {
            render_tui_progress("Unpacking & verifying toolchain...", 90)
            render_tui_progress("Installation complete", 100)
            println("")
            var success_msg = String.new()
            success_msg.push_str("  \x1b[1;32m✓\x1b[0m Successfully updated Rad toolchain to v")
            success_msg.push_str(target_version)
            success_msg.push_str("!")
            println(success_msg.as_ptr() as str)
            return 0
        } else {
            println("")
            println("  \x1b[1;31m✗\x1b[0m Update failed.")
            return update_status
        }
    }

    println("error: unknown subcommand for `rad toolchain`. Run `rad toolchain` for usage.")
    return 1
}

// ------------------------------------------------------------------------------
// Formatter Driver (`rad fmt`)
// ------------------------------------------------------------------------------

fn format_single_file(fpath: str, check_only: bool, stdout_mode: bool) -> i32 {
    let content = read_file_str(fpath)
    if content.len() == 0usize {
        println("error: cannot read source file or file is empty")
        return 1
    }
    let formatted = format_rad_source(content)
    if stdout_mode {
        let p = formatted.as_ptr() as str
        let len = formatted.len()
        let pb: *raw u8 = p as *raw u8
        var i = 0usize
        while i < len {
            putchar(pb[i] as i32)
            i = i + 1usize
        }
        return 0
    }
    let is_diff = !str_eq(content.as_ptr() as str, formatted.as_ptr() as str)
    if check_only {
        if is_diff {
            var msg = String.new()
            msg.push_str("Diff in ")
            msg.push_str(fpath)
            msg.push_str(": formatting needed")
            println(msg.as_ptr() as str)
            return 1
        }
        return 0
    }
    if is_diff {
        write_file_str(fpath, formatted.as_ptr() as str)
        var msg = String.new()
        msg.push_str("Formatted ")
        msg.push_str(fpath)
        println(msg.as_ptr() as str)
    }
    return 0
}

fn cmd_fmt(argc: i32, argv: *raw *raw u8) -> i32 {
    var check_only = false
    var stdout_mode = false
    var target_path = ""
    var i = 2
    while i < argc {
        let arg = argv[i] as str
        if str_eq(arg, "--check") {
            check_only = true
        } else if str_eq(arg, "--stdout") {
            stdout_mode = true
        } else if !str_starts_with(arg, "-") {
            target_path = arg
        }
        i = i + 1
    }

    if str_len(target_path) > 0usize && str_ends_with(target_path, ".rad") {
        return format_single_file(target_path, check_only, stdout_mode)
    }

    var search_dir = "."
    if str_len(target_path) > 0usize {
        search_dir = target_path
    } else if file_exists("src") {
        search_dir = "src"
    }

    var find_cmd = String.new()
    find_cmd.push_str("find ")
    find_cmd.push_str(search_dir)
    find_cmd.push_str(" -type f -name '*.rad' > /tmp/rad_fmt_list.txt 2>/dev/null")
    find_cmd.push_byte(0u8)
    system(find_cmd.as_ptr() as str)

    let flist = read_file_str("/tmp/rad_fmt_list.txt")
    let lines = split_source_lines(flist)
    let _ = remove("/tmp/rad_fmt_list.txt")

    if lines.len == 0usize {
        if !check_only && !stdout_mode {
            println("No .rad files found to format.")
        }
        return 0
    }

    var any_diff = 0
    var fi = 0usize
    while fi < lines.len {
        let f = lines.ptr[fi].as_ptr() as str
        if str_len(f) > 0usize {
            let st = format_single_file(f, check_only, stdout_mode)
            if st != 0 {
                any_diff = 1
            }
        }
        fi = fi + 1usize
    }
    return any_diff
}

// ------------------------------------------------------------------------------
// Main CLI Driver
// ------------------------------------------------------------------------------

fn main(argc: i32, argv: *raw *raw u8) -> i32 {
    let argv0 = argv[0] as str

    if argc < 2 {
        println("Rad Package Manager (rad) v0.2.4")
        println("Usage: rad <command> [options]")
        println("")
        println("Project Commands:")
        println("  new <name>       Create a new Rad package: `rad new <name> [--lib]`")
        println("  init             Initialize a new Rad package in the current directory")
        println("  build            Compile the current package")
        println("  run              Build and execute the current package")
        println("  test             Run package unit, integration, and doc tests")
        println("  bench            Run package performance benchmarks")
        println("  check            Analyze package for errors without compiling")
        println("  clean            Remove target build directory")
        println("")
        println("Dependency Commands:")
        println("  add <pkg>        Add a library dependency to rad.toml and install it")
        println("  remove <pkg>     Remove a dependency from rad.toml")
        println("  update [pkg]     Update library dependencies to latest compatible versions")
        println("  package <cmd>    Manage packages and registry: `rad package <cmd>`")
        println("                   Subcommands: install, search, info, list, tree, outdated")
        println("  cache [cmd]      Manage package download cache: `rad cache [list|clean]`")
        println("  publish          Validate and publish package to the registry")
        println("")
        println("Tooling & Diagnostics:")
        println("  fmt              Format Rad source files in-place or check formatting")
        println("  lsp              Run Language Server Protocol server over stdio")
        println("  doctor           Inspect and verify bundled toolchain and target sysroot")
        println("  toolchain        Manage Rad toolchain versions and updates")
        return 0
    }

    let cmd = argv[1] as str

    if str_eq(cmd, "--help") || str_eq(cmd, "-h") || str_eq(cmd, "help") {
        println("Rad Package Manager (rad) v0.2.4")
        println("Usage: rad <command> [options]")
        println("")
        println("Project Commands:")
        println("  new <name>       Create a new Rad package: `rad new <name> [--lib]`")
        println("  init             Initialize a new Rad package in the current directory")
        println("  build            Compile the current package")
        println("  run              Build and execute the current package")
        println("  test             Run package unit, integration, and doc tests")
        println("  bench            Run package performance benchmarks")
        println("  check            Analyze package for errors without compiling")
        println("  clean            Remove target build directory")
        println("")
        println("Dependency Commands:")
        println("  add <pkg>        Add a library dependency to rad.toml and install it")
        println("  remove <pkg>     Remove a dependency from rad.toml")
        println("  update [pkg]     Update library dependencies to latest compatible versions")
        println("  package <cmd>    Manage packages and registry: `rad package <cmd>`")
        println("                   Subcommands: install, publish, search, info, list, tree, outdated")
        println("  cache [cmd]      Manage package download cache: `rad cache [list|clean]`")
        println("  publish          Validate and publish package to the registry")
        println("")
        println("Tooling & Diagnostics:")
        println("  fmt              Format Rad source files in-place or check formatting")
        println("  lsp              Run Language Server Protocol server over stdio")
        println("  doctor           Inspect and verify bundled toolchain and target sysroot")
        println("  toolchain        Manage Rad toolchain versions and updates")
        return 0
    }

    if str_eq(cmd, "--version") || str_eq(cmd, "-V") || str_eq(cmd, "version") {
        println("rad 0.2.4 (x86_64-linux)")
        return 0
    }

    if str_eq(cmd, "package") || str_eq(cmd, "pkg") {
        return cmd_package(argc, argv)
    }

    if str_eq(cmd, "new") {
        if argc < 3 {
            println("error: `rad new` requires a package name: `rad new <name>`")
            return 1
        }
        let pkg_name = argv[2] as str
        var is_lib = false
        if argc >= 4 && str_eq(argv[3] as str, "--lib") {
            is_lib = true
        }
        return cmd_new(pkg_name, is_lib)
    }

    if str_eq(cmd, "init") {
        var is_lib = false
        var target_dir = ""
        var i = 2
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--lib") {
                is_lib = true
            } else if !str_starts_with(arg, "-") {
                target_dir = arg
            }
            i = i + 1
        }
        return cmd_init(target_dir, is_lib)
    }

    if str_eq(cmd, "clean") {
        return cmd_clean()
    }

    if str_eq(cmd, "build") {
        var is_release = false
        var target_triple = ""
        var i = 2
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--release") {
                is_release = true
            } else if str_eq(arg, "--target") && i + 1 < argc {
                i = i + 1
                target_triple = argv[i] as str
            }
            i = i + 1
        }
        return cmd_build(is_release, target_triple, argv0)
    }

    if str_eq(cmd, "run") {
        var is_release = false
        var target_triple = ""
        var run_args = ""
        var i = 2
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--release") {
                is_release = true
            } else if str_eq(arg, "--target") && i + 1 < argc {
                i = i + 1
                target_triple = argv[i] as str
            } else {
                run_args = arg
            }
            i = i + 1
        }
        return cmd_run(is_release, target_triple, run_args, argv0)
    }

    if str_eq(cmd, "check") {
        return cmd_check(argv0)
    }

    if str_eq(cmd, "test") {
        return cmd_test(argc, argv, argv0)
    }

    if str_eq(cmd, "bench") {
        return cmd_bench(argc, argv, argv0)
    }

    if str_eq(cmd, "install") {
        var pkg_name = ""
        var is_locked = false
        var i = 2
        while i < argc {
            let arg = argv[i] as str
            if str_eq(arg, "--locked") {
                is_locked = true
            } else if !str_starts_with(arg, "-") {
                pkg_name = arg
            }
            i = i + 1
        }
        return cmd_install(pkg_name, is_locked)
    }

    if str_eq(cmd, "add") {
        if argc < 3 {
            println("error: `rad add` requires a package name: `rad add <package>`")
            return 1
        }
        return cmd_add(argv[2] as str)
    }

    if str_eq(cmd, "remove") {
        if argc < 3 {
            println("error: `rad remove` requires a package name: `rad remove <package>`")
            return 1
        }
        return cmd_remove(argv[2] as str)
    }

    if str_eq(cmd, "update") {
        return cmd_update_pkg(argc, argv)
    }

    if str_eq(cmd, "search") {
        var query = ""
        if argc >= 3 {
            query = argv[2] as str
        }
        return cmd_search(query)
    }

    if str_eq(cmd, "info") {
        if argc < 3 {
            println("error: `rad info` requires a package name: `rad info <package>`")
            return 1
        }
        return cmd_info(argv[2] as str)
    }

    if str_eq(cmd, "list") {
        return cmd_list()
    }

    if str_eq(cmd, "tree") {
        return cmd_tree()
    }

    if str_eq(cmd, "outdated") {
        return cmd_outdated()
    }

    if str_eq(cmd, "cache") {
        return cmd_cache(argc, argv)
    }

    if str_eq(cmd, "publish") {
        let is_confirm = has_flag(argc, argv, "--confirm")
        return cmd_publish(is_confirm)
    }

    if str_eq(cmd, "doctor") {
        return cmd_doctor(argv0)
    }

    if str_eq(cmd, "fmt") {
        return cmd_fmt(argc, argv)
    }

    if str_eq(cmd, "lsp") {
        return run_lsp_server(argv0)
    }

    if str_eq(cmd, "toolchain") {
        return cmd_toolchain(argc, argv, argv0)
    }

    println("error: unrecognized command. Run `rad --help` for usage.")
    return 1
}
