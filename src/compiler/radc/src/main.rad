// ==============================================================================
// radc/src/main.rad - Self-Hosted Rad Compiler Entry Point & CLI Driver
// ==============================================================================

import util;
import token;
import ast;
import parser;
import codegen;
import linker;

struct CompilerOptions {
    input_paths: Vec<String>,
    extra_objects: Vec<String>,
    output_path: String,
    emit_llvm: bool,
    check_only: bool,
    opt_level: String,
    target_triple: String,
    linker_cmd: String,
    show_version: bool,
    compile_only: bool,
    cli_color_mode: i32,      // 0 = auto, 1 = always, 2 = never
    cli_json_format: bool,
    test_mode: bool,
    debug_info: bool,
    strip_symbols: bool,
    enable_lto: bool,
}

fn parse_cli_args(argc: i32, argv: *raw *raw u8) -> CompilerOptions {
    var input_paths = Vec.new()
    var extra_objects = Vec.new()
    var output_path = String.new()
    var emit_llvm = false
    var check_only = false
    var opt_level = String.from_str("2")
    var target_triple = String.from_str("x86_64-unknown-linux-gnu")
    var linker_cmd = String.new()
    var show_version = false
    var compile_only = false
    var color_mode = 0i32
    var json_format = false
    var test_mode = false
    var debug_info = false
    var strip_symbols = false
    var enable_lto = false

    var i = 1usize
    let total = argc as usize

    while i < total {
        let arg = argv[i] as str
        if str_eq(arg, "-V") || str_eq(arg, "--version") {
            show_version = true
        } else if str_eq(arg, "-g") || str_eq(arg, "--debug") {
            debug_info = true
        } else if str_eq(arg, "-s") || str_eq(arg, "--strip") {
            strip_symbols = true
        } else if str_eq(arg, "-flto") || str_eq(arg, "--lto") {
            enable_lto = true
        } else if str_eq(arg, "-Oz") || str_eq(arg, "-Os") {
            opt_level = String.from_str("z")
            strip_symbols = true
        } else if str_eq(arg, "-c") {
            compile_only = true
        } else if str_eq(arg, "-o") && i + 1usize < total {
            i = i + 1usize
            output_path = String.from_str(argv[i] as str)
        } else if str_eq(arg, "--emit-llvm") || str_eq(arg, "--emit-ir") {
            emit_llvm = true
        } else if str_eq(arg, "--check") {
            check_only = true
        } else if str_eq(arg, "--error-format=json") {
            json_format = true
        } else if str_eq(arg, "--error-format") && i + 1usize < total {
            i = i + 1usize
            if str_eq(argv[i] as str, "json") {
                json_format = true
            }
        } else if str_eq(arg, "--color=always") {
            color_mode = 1i32
        } else if str_eq(arg, "--color=never") {
            color_mode = 2i32
        } else if str_eq(arg, "--color=auto") {
            color_mode = 0i32
        } else if str_eq(arg, "--color") && i + 1usize < total {
            i = i + 1usize
            let cval = argv[i] as str
            if str_eq(cval, "always") {
                color_mode = 1i32
            } else if str_eq(cval, "never") {
                color_mode = 2i32
            } else {
                color_mode = 0i32
            }
        } else if str_eq(arg, "--test") || str_eq(arg, "--bench") {
            test_mode = true
        } else if str_starts_with(arg, "-O") {
            let p = arg as *raw u8
            opt_level = String.new()
            if str_len(arg) >= 3usize {
                opt_level.push_byte(p[2usize])
            } else {
                opt_level.push_byte(50u8) // '2'
            }
            opt_level.push_byte(0u8)
        } else if str_eq(arg, "--target") && i + 1usize < total {
            i = i + 1usize
            target_triple = String.from_str(argv[i] as str)
        } else if str_eq(arg, "--linker") && i + 1usize < total {
            i = i + 1usize
            linker_cmd = String.from_str(argv[i] as str)
        } else if str_eq(arg, "-L") && i + 1usize < total {
            i = i + 1usize
            var lflag = String.from_str("-L")
            lflag.push_str(argv[i] as str)
            extra_objects.push(lflag)
        } else if str_eq(arg, "-l") && i + 1usize < total {
            i = i + 1usize
            var lflag = String.from_str("-l")
            lflag.push_str(argv[i] as str)
            extra_objects.push(lflag)
        } else if str_starts_with(arg, "-l") || str_starts_with(arg, "-L") {
            extra_objects.push(String.from_str(arg))
        } else if !str_starts_with(arg, "-") {
            if str_ends_with(arg, ".o") || str_ends_with(arg, ".a") || str_ends_with(arg, ".so") {
                extra_objects.push(String.from_str(arg))
            } else {
                let path_str = normalize_path(arg)
                input_paths.push(path_str)
            }
        }
        i = i + 1usize
    }

    if output_path.len() == 0usize {
        if input_paths.len > 0usize {
            let first = input_paths.ptr[0usize].as_ptr() as str
            var stem = String.new()
            let slen = str_len(first)
            var end_pos = str_len(first)
            if str_ends_with(first, ".rad") && slen >= 4usize {
                end_pos = slen - 4usize
            }
            let p = first as *raw u8
            var k = 0usize
            while k < end_pos {
                stem.push_byte(p[k])
                k = k + 1usize
            }
            stem.push_byte(0u8)
            output_path = stem
        } else {
            output_path = String.from_str("a.out")
        }
    }

    return CompilerOptions {
        input_paths: input_paths,
        extra_objects: extra_objects,
        output_path: output_path,
        emit_llvm: emit_llvm,
        check_only: check_only,
        opt_level: opt_level,
        target_triple: target_triple,
        linker_cmd: linker_cmd,
        show_version: show_version,
        compile_only: compile_only,
        cli_color_mode: color_mode,
        cli_json_format: json_format,
        test_mode: test_mode,
        debug_info: debug_info,
        strip_symbols: strip_symbols,
        enable_lto: enable_lto,
    }
}

fn try_path_with_rad(cand: String) -> String {
    let s = cand.as_ptr() as str
    if file_exists(s) && str_ends_with(s, ".rad") {
        return cand
    }
    if !str_ends_with(s, ".rad") {
        var with_rad = String.new()
        with_rad.push_str(s)
        with_rad.push_str(".rad")
        with_rad.push_byte(0u8)
        if file_exists(with_rad.as_ptr() as str) {
            return with_rad
        }

        var with_src_lib = String.new()
        with_src_lib.push_str(s)
        with_src_lib.push_str("/src/lib.rad")
        with_src_lib.push_byte(0u8)
        if file_exists(with_src_lib.as_ptr() as str) {
            return with_src_lib
        }

        var with_ver_src_lib = String.new()
        with_ver_src_lib.push_str(s)
        with_ver_src_lib.push_str("/0.1.0/src/lib.rad")
        with_ver_src_lib.push_byte(0u8)
        if file_exists(with_ver_src_lib.as_ptr() as str) {
            return with_ver_src_lib
        }

        var with_lib = String.new()
        with_lib.push_str(s)
        with_lib.push_str("/lib.rad")
        with_lib.push_byte(0u8)
        if file_exists(with_lib.as_ptr() as str) {
            return with_lib
        }
    }
    return String.new()
}

fn resolve_import_raw(spec: str, current_file: str) -> String {
    if str_eq(spec, "std") || str_eq(spec, "core") || str_eq(spec, "alloc") {
        return String.new()
    }

    let cur_dir = get_dirname(current_file)

    // 1. Explicit relative or absolute path (starts with "./", "../", "/")
    if str_starts_with(spec, "./") || str_starts_with(spec, "../") || str_starts_with(spec, "/") {
        var cand = String.new()
        if str_starts_with(spec, "/") {
            cand.push_str(spec)
        } else {
            var rel = spec
            if str_starts_with(spec, "./") {
                rel = (spec as usize + 2usize) as str
            }
            if !str_eq(cur_dir.as_ptr() as str, ".") {
                cand.push_str(cur_dir.as_ptr() as str)
                cand.push_byte(47u8) // '/'
            }
            cand.push_str(rel)
        }
        cand.push_byte(0u8)
        return try_path_with_rad(cand)
    }

    // 2. Relative to current file directory: <cur_dir>/<spec> or <cur_dir>/<spec>.rad
    var loc_cand = String.new()
    if !str_eq(cur_dir.as_ptr() as str, ".") {
        loc_cand.push_str(cur_dir.as_ptr() as str)
        loc_cand.push_byte(47u8) // '/'
    }
    loc_cand.push_str(spec)
    loc_cand.push_byte(0u8)
    let loc_found = try_path_with_rad(loc_cand)
    if loc_found.len() > 0usize {
        return loc_found
    }

    // 2.5 Search project and global packages
    // e.g. spec = "tui", "rad-tui", "rad_tui" or "tui/widgets"
    var base_pkg = String.new()
    var sub_mod = String.new()
    let s_len = str_len(spec)
    let p_spec = spec as *raw u8
    var slash_idx = 0usize
    var has_slash = false
    var si = 0usize
    while si < s_len {
        if p_spec[si] == 47u8 { // '/'
            slash_idx = si
            has_slash = true
            si = s_len
        } else {
            si = si + 1usize
        }
    }
    if has_slash {
        var k = 0usize
        while k < slash_idx {
            base_pkg.push_byte(p_spec[k])
            k = k + 1usize
        }
        k = slash_idx + 1usize
        while k < s_len {
            sub_mod.push_byte(p_spec[k])
            k = k + 1usize
        }
    } else {
        base_pkg.push_str(spec)
    }

    let b_str = base_pkg.as_ptr() as str
    var pkg_names = Vec.new()
    pkg_names.push(base_pkg)
    if !str_starts_with(b_str, "rad-") && !str_starts_with(b_str, "rad_") {
        var p_dash = String.from_str("rad-")
        p_dash.push_str(b_str)
        p_dash.push_byte(0u8)
        pkg_names.push(p_dash)

        var p_under = String.from_str("rad_")
        p_under.push_str(b_str)
        p_under.push_byte(0u8)
        pkg_names.push(p_under)
    } else if str_starts_with(b_str, "rad-") {
        let stripped = (b_str as usize + 4usize) as str
        pkg_names.push(String.from_str(stripped))
        var p_under = String.from_str("rad_")
        p_under.push_str(stripped)
        p_under.push_byte(0u8)
        pkg_names.push(p_under)
    } else if str_starts_with(b_str, "rad_") {
        let stripped = (b_str as usize + 4usize) as str
        pkg_names.push(String.from_str(stripped))
        var p_dash = String.from_str("rad-")
        p_dash.push_str(stripped)
        p_dash.push_byte(0u8)
        pkg_names.push(p_dash)
    }

    var pi = 0usize
    while pi < pkg_names.len {
        let pname = pkg_names.ptr[pi].as_ptr() as str

        if has_slash {
            let sm = sub_mod.as_ptr() as str

            // 1. Primary: Local ./lib/rad/<pname>/...
            var cl1 = String.from_str("lib/rad/")
            cl1.push_str(pname)
            cl1.push_str("/src/")
            cl1.push_str(sm)
            cl1.push_byte(0u8)
            let fl1 = try_path_with_rad(cl1)
            if fl1.len() > 0usize { return fl1 }

            var cl2 = String.from_str("lib/rad/")
            cl2.push_str(pname)
            cl2.push_byte(47u8)
            cl2.push_str(sm)
            cl2.push_byte(0u8)
            let fl2 = try_path_with_rad(cl2)
            if fl2.len() > 0usize { return fl2 }

            // 2. Primary: Global ~/.rad/lib/rad/<pname>/...
            let home_val = getenv("HOME")
            if (home_val as usize) != 0usize && str_len(home_val) > 0usize {
                var cl3 = String.from_str(home_val)
                cl3.push_str("/.rad/lib/rad/")
                cl3.push_str(pname)
                cl3.push_str("/src/")
                cl3.push_str(sm)
                cl3.push_byte(0u8)
                let fl3 = try_path_with_rad(cl3)
                if fl3.len() > 0usize { return fl3 }

                var cl4 = String.from_str(home_val)
                cl4.push_str("/.rad/lib/rad/")
                cl4.push_str(pname)
                cl4.push_byte(47u8)
                cl4.push_str(sm)
                cl4.push_byte(0u8)
                let fl4 = try_path_with_rad(cl4)
                if fl4.len() > 0usize { return fl4 }
            }

            // 3. Fallback: Local ./packages/<pname>/src/<sub_mod>.rad
            var c1 = String.from_str("packages/")
            c1.push_str(pname)
            c1.push_str("/src/")
            c1.push_str(sm)
            c1.push_byte(0u8)
            let f1 = try_path_with_rad(c1)
            if f1.len() > 0usize { return f1 }

            // Local ./packages/<pname>/<sub_mod>.rad
            var c2 = String.from_str("packages/")
            c2.push_str(pname)
            c2.push_byte(47u8)
            c2.push_str(sm)
            c2.push_byte(0u8)
            let f2 = try_path_with_rad(c2)
            if f2.len() > 0usize { return f2 }

            // Global ~/.rad/packages/<pname>/src/<sub_mod>.rad
            if (home_val as usize) != 0usize && str_len(home_val) > 0usize {
                var c3 = String.from_str(home_val)
                c3.push_str("/.rad/packages/")
                c3.push_str(pname)
                c3.push_str("/src/")
                c3.push_str(sm)
                c3.push_byte(0u8)
                let f3 = try_path_with_rad(c3)
                if f3.len() > 0usize { return f3 }

                var c4 = String.from_str(home_val)
                c4.push_str("/.rad/packages/")
                c4.push_str(pname)
                c4.push_byte(47u8)
                c4.push_str(sm)
                c4.push_byte(0u8)
                let f4 = try_path_with_rad(c4)
                if f4.len() > 0usize { return f4 }
            }
        } else {
            // 1. Primary: Local ./lib/rad/<pname>
            var cand_l1 = String.from_str("lib/rad/")
            cand_l1.push_str(pname)
            cand_l1.push_byte(0u8)
            let found_l1 = try_path_with_rad(cand_l1)
            if found_l1.len() > 0usize { return found_l1 }

            // 2. Primary: Global ~/.rad/lib/rad/<pname>/...
            let home_val = getenv("HOME")
            if (home_val as usize) != 0usize && str_len(home_val) > 0usize {
                var cand_gl = String.from_str(home_val)
                cand_gl.push_str("/.rad/lib/rad/")
                cand_gl.push_str(pname)
                cand_gl.push_byte(0u8)
                let found_gl = try_path_with_rad(cand_gl)
                if found_gl.len() > 0usize { return found_gl }

                var cand_glc = String.from_str(home_val)
                cand_glc.push_str("/.rad/lib/rad/")
                cand_glc.push_str(pname)
                cand_glc.push_str("/current")
                cand_glc.push_byte(0u8)
                let found_glc = try_path_with_rad(cand_glc)
                if found_glc.len() > 0usize { return found_glc }
            }

            // 3. Primary: RAD_HOME/lib/rad/<pname>/...
            let rad_home_val = getenv("RAD_HOME")
            if (rad_home_val as usize) != 0usize && str_len(rad_home_val) > 0usize {
                var cand_rl = String.from_str(rad_home_val)
                cand_rl.push_str("/lib/rad/")
                cand_rl.push_str(pname)
                cand_rl.push_byte(0u8)
                let found_rl = try_path_with_rad(cand_rl)
                if found_rl.len() > 0usize { return found_rl }
            }

            // 4. Fallback: Local ./packages/<pname>
            var cand_p1 = String.from_str("packages/")
            cand_p1.push_str(pname)
            cand_p1.push_byte(0u8)
            let found_p1 = try_path_with_rad(cand_p1)
            if found_p1.len() > 0usize { return found_p1 }

            // Fallback: Global ~/.rad/packages/<pname>/...
            if (home_val as usize) != 0usize && str_len(home_val) > 0usize {
                var cand_gp = String.from_str(home_val)
                cand_gp.push_str("/.rad/packages/")
                cand_gp.push_str(pname)
                cand_gp.push_byte(0u8)
                let found_gp = try_path_with_rad(cand_gp)
                if found_gp.len() > 0usize { return found_gp }

                var cand_gpc = String.from_str(home_val)
                cand_gpc.push_str("/.rad/packages/")
                cand_gpc.push_str(pname)
                cand_gpc.push_str("/current")
                cand_gpc.push_byte(0u8)
                let found_gpc = try_path_with_rad(cand_gpc)
                if found_gpc.len() > 0usize { return found_gpc }
            }

            // Fallback: RAD_HOME/packages/<pname>/...
            if (rad_home_val as usize) != 0usize && str_len(rad_home_val) > 0usize {
                var cand_rp = String.from_str(rad_home_val)
                cand_rp.push_str("/packages/")
                cand_rp.push_str(pname)
                cand_rp.push_byte(0u8)
                let found_rp = try_path_with_rad(cand_rp)
                if found_rp.len() > 0usize { return found_rp }
            }
        }

        pi = pi + 1usize
    }

    // 3. Search Standard Library paths
    var sub = spec
    if str_starts_with(spec, "std/") {
        sub = (spec as usize + 4usize) as str
    } else if str_starts_with(spec, "core/") {
        sub = (spec as usize + 5usize) as str
    } else if str_starts_with(spec, "alloc/") {
        sub = (spec as usize + 6usize) as str
    }

    var std_roots = Vec.new()

    let rad_home = getenv("RAD_HOME")
    if (rad_home as usize) != 0usize && str_len(rad_home) > 0usize {
        std_roots.push(String.from_str(rad_home))
    }

    let home = getenv("HOME")
    if (home as usize) != 0usize && str_len(home) > 0usize {
        var dr = String.new()
        dr.push_str(home)
        dr.push_str("/.rad")
        dr.push_byte(0u8)
        std_roots.push(dr)
    }

    std_roots.push(String.from_str("."))

    var ri = 0usize
    while ri < std_roots.len {
        let root = std_roots.ptr[ri].as_ptr() as str

        // std/src/<sub_path>.rad
        var p1 = String.new()
        if !str_eq(root, ".") {
            p1.push_str(root)
            p1.push_str("/lib/rad/std/src/")
        } else {
            p1.push_str("lib/rad/std/src/")
        }
        p1.push_str(sub)
        p1.push_byte(0u8)
        let f1 = try_path_with_rad(p1)
        if f1.len() > 0usize { return f1 }

        // core/src/<sub_path>.rad
        var p2 = String.new()
        if !str_eq(root, ".") {
            p2.push_str(root)
            p2.push_str("/lib/rad/core/src/")
        } else {
            p2.push_str("lib/rad/core/src/")
        }
        p2.push_str(sub)
        p2.push_byte(0u8)
        let f2 = try_path_with_rad(p2)
        if f2.len() > 0usize { return f2 }

        // alloc/src/<sub_path>.rad
        var p3 = String.new()
        if !str_eq(root, ".") {
            p3.push_str(root)
            p3.push_str("/lib/rad/alloc/src/")
        } else {
            p3.push_str("lib/rad/alloc/src/")
        }
        p3.push_str(sub)
        p3.push_byte(0u8)
        let f3 = try_path_with_rad(p3)
        if f3.len() > 0usize { return f3 }

        // os/linux/<sub_path>.rad
        var p4 = String.new()
        if !str_eq(root, ".") {
            p4.push_str(root)
            p4.push_str("/lib/rad/std/src/os/linux/")
        } else {
            p4.push_str("lib/rad/std/src/os/linux/")
        }
        p4.push_str(sub)
        p4.push_byte(0u8)
        let f4 = try_path_with_rad(p4)
        if f4.len() > 0usize { return f4 }

        ri = ri + 1usize
    }

    return String.new()
}

fn resolve_import(spec: str, current_file: str) -> String {
    let p = resolve_import_raw(spec, current_file)
    if p.len() > 0usize {
        return normalize_path(p.as_ptr() as str)
    }
    return String.new()
}

fn main(argc: i32, argv: *raw *raw u8) -> i32 {
    let opts = parse_cli_args(argc, argv)

    if opts.show_version {
        println("radc 0.2.4 (self-hosted x86_64-linux)")
        return 0
    }

    if opts.input_paths.len == 0usize {
        println("radc - Rad Compiler")
        println("Usage: radc <file1.rad> [file2.rad ...] [options]")
        println("")
        println("Options:")
        println("  -o <path>                    Set output binary path")
        println("  -c                           Compile to object file (.o) without linking")
        println("  --emit-llvm                  Emit textual LLVM IR (.ll) without linking")
        println("  --check                      Check source syntax and structure without code generation")
        println("  --test                       Enable test mode (compiles #[test] and #[cfg(test)])")
        println("  --color <auto|always|never>  Set ANSI terminal color mode (default: auto)")
        println("  --error-format=json          Emit structured JSON diagnostics")
        println("  -O0, -O1, -O2, -O3, -Oz      Set optimization level (default: -O2)")
        println("  -flto, --lto                 Enable link-time optimization (LTO)")
        println("  -s, --strip                  Strip symbol and debug tables")
        println("  -g, --debug                  Emit DWARF debug metadata")
        println("  --target <t>                 Target triple (default: x86_64-unknown-linux-gnu)")
        println("  --linker <cmd>               Custom linker command override")
        println("  -V, --version                Print compiler version")
        return 0
    }

    // When --test is passed or test suite is detected, automatically include rad-test library if not explicitly provided
    var needs_test_lib = opts.test_mode
    if !needs_test_lib {
        var fi = 0usize
        while fi < opts.input_paths.len {
            let path_str = opts.input_paths.ptr[fi].as_ptr() as str
            if str_contains(path_str, "test_") || str_contains(path_str, "tests/") {
                needs_test_lib = true
                break
            }
            let src = read_file_string(path_str)
            if str_contains(src.as_ptr() as str, "TestSuite") {
                needs_test_lib = true
                break
            }
            fi = fi + 1usize
        }
    }
    if needs_test_lib {
        var already_has_test_lib = false
        var ci = 0usize
        while ci < opts.input_paths.len {
            let inp = opts.input_paths.ptr[ci].as_ptr() as str
            if str_contains(inp, "rad-test") || str_contains(inp, "rad_test") {
                already_has_test_lib = true
                break
            }
            ci = ci + 1usize
        }
        if !already_has_test_lib {
            var rad_test_path = String.new()
            let home = getenv("HOME")
            if (home as usize) != 0usize && str_len(home) > 0usize {
                var p1b = String.new()
                p1b.push_str(home)
                p1b.push_str("/.rad/lib/rad/rad-test/src/lib.rad")
                p1b.push_byte(0u8)
                let f1b = fopen(p1b.as_ptr() as str, "rb")
                if (f1b as usize) != 0usize {
                    fclose(f1b)
                    rad_test_path = p1b
                }
            }
            if rad_test_path.len() == 0usize {
                let rad_home = getenv("RAD_HOME")
                if (rad_home as usize) != 0usize && str_len(rad_home) > 0usize {
                    var p0 = String.new()
                    p0.push_str(rad_home)
                    p0.push_str("/lib/rad/rad-test/src/lib.rad")
                    p0.push_byte(0u8)
                    let f0 = fopen(p0.as_ptr() as str, "rb")
                    if (f0 as usize) != 0usize {
                        fclose(f0)
                        rad_test_path = p0
                    }
                }
            }
            if rad_test_path.len() == 0usize {
                if (home as usize) != 0usize && str_len(home) > 0usize {
                    var p1 = String.new()
                    p1.push_str(home)
                    p1.push_str("/.rad/packages/rad-test/src/lib.rad")
                    p1.push_byte(0u8)
                    let f1 = fopen(p1.as_ptr() as str, "rb")
                    if (f1 as usize) != 0usize {
                        fclose(f1)
                        rad_test_path = p1
                    }
                }
            }
            if rad_test_path.len() == 0usize {
                let f2 = fopen("lib/rad/rad-test/src/lib.rad", "rb")
                if (f2 as usize) != 0usize {
                    fclose(f2)
                    rad_test_path = String.from_str("lib/rad/rad-test/src/lib.rad")
                }
            }
            if rad_test_path.len() == 0usize {
                let f3 = fopen("/home/abhinav/Projects/rad-lib/packages/rad-test/0.1.0/src/lib.rad", "rb")
                if (f3 as usize) != 0usize {
                    fclose(f3)
                    rad_test_path = String.from_str("/home/abhinav/Projects/rad-lib/packages/rad-test/0.1.0/src/lib.rad")
                }
            }
            if rad_test_path.len() > 0usize {
                opts.input_paths.push(rad_test_path)
            }
        }
    }

    // Step 1: Lex and Parse all input files into a unified AST arena
    var parser = Parser {
        tokens: Vec.new(),
        pos: 0usize,
        exprs: Vec.new(),
        stmts: Vec.new(),
        functions: Vec.new(),
        structs: Vec.new(),
        traits: Vec.new(),
        trait_impls: Vec.new(),
        const_names: Vec.new(),
        const_values: Vec.new(),
        filename: String.new(),
        error_count: 0i64,
        source: String.new(),
        source_files: Vec.new(),
        expr_source_ids: Vec.new(),
        stmt_source_ids: Vec.new(),
        current_source_id: 0usize,
        moved_vars: Vec.new(),
        imported_modules: Vec.new(),
        diagnostics: Vec.new(),
        color_mode: opts.cli_color_mode,
        json_format: opts.cli_json_format,
        test_mode: opts.test_mode,
        cur_is_test: false,
        cur_is_async: false,
    }
    parser.const_names.push(String.from_str("Option::None"))
    parser.const_values.push(0i64)
    parser.const_names.push(String.from_str("Option::Some"))
    parser.const_values.push(1i64)
    parser.const_names.push(String.from_str("Result::Ok"))
    parser.const_values.push(0i64)
    parser.const_names.push(String.from_str("Result::Err"))
    parser.const_values.push(1i64)
    // Reserve index 0 as sentinel NULL_EXPR and NULL_STMT so expr_id/stmt_id > 0
    parser.exprs.push(Expr {
        kind: 0,
        op: 0,
        int_val: 0i64,
        str_val: String.new(),
        target_type: String.new(),
        left: 0usize,
        right: 0usize,
        args: Vec.new(),
        field_name: String.new(),
        expr_line: 0i64,
        expr_col: 0i64,
    })
    parser.stmts.push(Stmt {
        kind: 0,
        name: String.new(),
        type_name: String.new(),
        expr_id: 0usize,
        index_expr: 0usize,
        then_stmts: Vec.new(),
        else_stmts: Vec.new(),
        body_stmts: Vec.new(),
        stmt_line: 0i64,
        stmt_col: 0i64,
    })

    // Source IDs share the same indices as their AST arena entries; reserve
    // index zero for the null expression/statement sentinels.
    parser.expr_source_ids.push(0usize)
    parser.stmt_source_ids.push(0usize)

    var loaded_files = Vec.new()
    var file_idx = 0usize
    while file_idx < opts.input_paths.len {
        let fpath = opts.input_paths.ptr[file_idx].as_ptr() as str

        var already = false
        var li = 0usize
        while li < loaded_files.len {
            if str_eq(loaded_files.ptr[li].as_ptr() as str, fpath) {
                already = true
                break
            }
            li = li + 1usize
        }
        if already {
            file_idx = file_idx + 1usize
            continue
        }
        loaded_files.push(String.from_str(fpath))

        let fp = fopen(fpath, "rb")
        if (fp as usize) == 0usize {
            var err = String.new()
            err.push_str("error: cannot read input file '")
            err.push_str(fpath)
            err.push_str("'")
            println(err.as_ptr() as str)
            return 1
        }
        fseek(fp, 0i64, 2)
        let fsize = ftell(fp) as usize
        fclose(fp)
        if fsize == 0usize {
            var err = String.new()
            err.push_str("error: source file is empty: '")
            err.push_str(fpath)
            err.push_str("'")
            println(err.as_ptr() as str)
            return 1
        }
        let source = read_file_string(fpath)
        let source_id = parser.source_files.len
        parser.source_files.push(SourceFile {
            file_path: String.from_str(fpath),
            file_text: source,
        })
        parser.current_source_id = source_id
        let tokens = lex_source(source)
        parser.tokens = tokens
        parser.pos = 0usize
        parser.filename = String.from_str(fpath)
        parser.source = source
        parser.imported_modules = Vec.new()
        parser.parse_program()
        if parser.error_count > 0i64 {
            return 1
        }

        // Process and queue imported modules
        var mi = 0usize
        while mi < parser.imported_modules.len {
            let spec = parser.imported_modules.ptr[mi].as_ptr() as str
            let resolved = resolve_import(spec, fpath)
            if resolved.len() > 0usize {
                let r_str = resolved.as_ptr() as str
                var known = false
                var ki = 0usize
                while ki < loaded_files.len {
                    if str_eq(loaded_files.ptr[ki].as_ptr() as str, r_str) {
                        known = true
                        break
                    }
                    ki = ki + 1usize
                }
                if !known {
                    var qi = 0usize
                    while qi < opts.input_paths.len {
                        if str_eq(opts.input_paths.ptr[qi].as_ptr() as str, r_str) {
                            known = true
                            break
                        }
                        qi = qi + 1usize
                    }
                }
                if !known {
                    opts.input_paths.push(resolved)
                }
            } else {
                if !str_eq(spec, "std") && !str_eq(spec, "core") && !str_eq(spec, "alloc") {
                    var err = String.new()
                    err.push_str("error: could not resolve import '")
                    err.push_str(spec)
                    err.push_str("' in ")
                    err.push_str(fpath)
                    println(err.as_ptr() as str)
                    return 1
                }
            }
            mi = mi + 1usize
        }

        file_idx = file_idx + 1usize
    }

    if parser.error_count > 0i64 {
        return 1
    }

    var main_src = String.from_str("main.rad")
    if opts.input_paths.len > 0usize {
        main_src = opts.input_paths.ptr[0usize]
    }

    // Step 2: Direct SSA LLVM IR Generation & Semantic Analysis
    var codegen = Codegen {
        parser: parser,
        target: opts.target_triple,
        ir: String.new(),
        fn_allocas: String.new(),
        allocated_vars: Vec.new(),
        ssa_counter: 1,
        label_counter: 0,
        strings: Vec.new(),
        current_ret_type: String.new(),
        loop_cond_labels: Vec.new(),
        loop_end_labels: Vec.new(),
        current_func_idx: 0usize,
        active_defers: Vec.new(),
        active_drops_var: Vec.new(),
        active_drops_type: Vec.new(),
        debug_info: opts.debug_info,
        source_file: main_src,
    }
    codegen.parser.filename = main_src
    let ir = codegen.generate()
    if codegen.parser.error_count > 0i64 {
        return 1
    }

    if opts.check_only {
        if !opts.cli_json_format {
            println("Check complete: 0 errors.")
        }
        return 0
    }

    if ir.len() == 0usize {
        return 1
    }

    if opts.output_path.len() > 0usize {
        var chk_path = String.new()
        chk_path.push_str(opts.output_path.as_ptr() as str)
        chk_path.push_str("/.")
        chk_path.push_byte(0u8)
        let fp_dir = fopen(chk_path.as_ptr() as str, "rb")
        if (fp_dir as usize) != 0usize {
            fclose(fp_dir)
            var err = String.new()
            err.push_str("error: output path '")
            err.push_str(opts.output_path.as_ptr() as str)
            err.push_str("' is an existing directory")
            println(err.as_ptr() as str)
            return 1
        }
    }

    if opts.emit_llvm {
        var ll_path = String.new()
        ll_path.push_str(opts.output_path.as_ptr() as str)
        if !str_ends_with(ll_path.as_ptr() as str, ".ll") {
            ll_path.push_str(".ll")
        }
        write_file_string(ll_path.as_ptr() as str, ir)
        return 0
    }

    if opts.compile_only {
        var obj_out = String.new()
        if opts.output_path.len() > 0usize {
            obj_out.push_str(opts.output_path.as_ptr() as str)
        } else {
            obj_out.push_str("output.o")
        }
        let err_buf = malloc(2048usize) as *raw var u8
        var opt_num = 2i32
        let opt_s = opts.opt_level.as_ptr() as str
        if str_eq(opt_s, "0") {
            opt_num = 0i32
        } else if str_eq(opt_s, "1") {
            opt_num = 1i32
        } else if str_eq(opt_s, "3") {
            opt_num = 3i32
        }

        let r = rad_llvm_emit_obj(ir.as_ptr() as str, ir.len(), obj_out.as_ptr() as str, opt_num, opts.target_triple.as_ptr() as str, err_buf as *raw u8, 2048usize)
        if r != 0 {
            if str_len(err_buf as str) > 0usize {
                println(err_buf as str)
            }
            var tmp_ll = String.new()
            tmp_ll.push_str(obj_out.as_ptr() as str)
            tmp_ll.push_str(".tmp.ll")
            write_file_string(tmp_ll.as_ptr() as str, ir)
            var llc_cmd = String.new()
            llc_cmd.push_str("rad-llc -filetype=obj -relocation-model=pic -O")
            llc_cmd.push_str(opts.opt_level.as_ptr() as str)
            llc_cmd.push_str(" ")
            llc_cmd.push_str(tmp_ll.as_ptr() as str)
            llc_cmd.push_str(" -o ")
            llc_cmd.push_str(obj_out.as_ptr() as str)
            let st = run_cmd(llc_cmd.as_ptr() as str)
            let _ = remove(tmp_ll.as_ptr() as str)
            return st
        }
        return 0
    }

    // Step 3: Write temporary IR and invoke Mode A Linker Cascade
    var tmp_ir_path = String.new()
    tmp_ir_path.push_str(opts.output_path.as_ptr() as str)
    tmp_ir_path.push_str(".tmp.ll")

    if !write_file_string(tmp_ir_path.as_ptr() as str, ir) {
        println("error: cannot write temporary LLVM IR file")
        return 1
    }

    let link_status = invoke_linker(tmp_ir_path, opts.output_path, opts.opt_level, opts.linker_cmd, opts.extra_objects, opts.strip_symbols, opts.enable_lto, opts.target_triple)

    // Clean up temporary LLVM IR
    let _ = remove(tmp_ir_path.as_ptr() as str)
    return link_status
}
