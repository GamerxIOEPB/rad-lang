        header.push_str("define void @__rad_defer_pop_and_run(ptr %node) {\nentry:\n  %cur = load ptr, ptr @__rad_defer_head, align 8\n  %is_top = icmp eq ptr %cur, %node\n  br i1 %is_top, label %unlink, label %read_thunk\nunlink:\n  %next = load ptr, ptr %node, align 8\n  store ptr %next, ptr @__rad_defer_head, align 8\n  br label %read_thunk\nread_thunk:\n  %t_slot = getelementptr inbounds i8, ptr %node, i64 8\n  %thunk = load ptr, ptr %t_slot, align 8\n  %e_slot = getelementptr inbounds i8, ptr %node, i64 16\n  %env = load ptr, ptr %e_slot, align 8\n  %is_null = icmp eq ptr %thunk, null\n  br i1 %is_null, label %done, label %run\nrun:\n  call void %thunk(ptr %env)\n  br label %done\ndone:\n  ret void\n}\n\n")
        header.push_str("@__rad_panic_cleanup_hook = global ptr null, align 8\n")
        header.push_str("define void @__rad_register_panic_hook(ptr %hook) {\nentry:\n  store ptr %hook, ptr @__rad_panic_cleanup_hook, align 8\n  ret void\n}\n\n")
        header.push_str("define void @__rad_run_panic_hook() {\nentry:\n  br label %defer_loop\ndefer_loop:\n  %head = load ptr, ptr @__rad_defer_head, align 8\n  %d_null = icmp eq ptr %head, null\n  br i1 %d_null, label %after_defers, label %run_defer\nrun_defer:\n  %next = load ptr, ptr %head, align 8\n  store ptr %next, ptr @__rad_defer_head, align 8\n  %t_slot = getelementptr inbounds i8, ptr %head, i64 8\n  %thunk = load ptr, ptr %t_slot, align 8\n  %e_slot = getelementptr inbounds i8, ptr %head, i64 16\n  %env = load ptr, ptr %e_slot, align 8\n  %t_null = icmp eq ptr %thunk, null\n  br i1 %t_null, label %defer_loop, label %call_thunk\ncall_thunk:\n  call void %thunk(ptr %env)\n  br label %defer_loop\nafter_defers:\n  %h = load ptr, ptr @__rad_panic_cleanup_hook, align 8\n  %is_null = icmp eq ptr %h, null\n  br i1 %is_null, label %done, label %call_hook\ncall_hook:\n  call void %h()\n  br label %done\ndone:\n  ret void\n}\n\n")

        header.push_str("@__rad_terminal_guard_buf = global [128 x i8] zeroinitializer, align 8\n")
        header.push_str("define ptr @__rad_get_terminal_guard() {\nentry:\n  ret ptr @__rad_terminal_guard_buf\n}\n\n")

        if !str_starts_with(self.target.as_ptr() as str, "wasm32") {
            header.push_str("define void @__rad_sigreturn_trampoline() {\nentry:\n  call void asm sideeffect \"mov $$15, %rax\\0Asyscall\", \"\"()\n  ret void\n}\n\n")
        } else {
            header.push_str("define void @__rad_sigreturn_trampoline() {\nentry:\n  ret void\n}\n\n")
        }

        header.push_str("@.panic_bounds_fmt = private unnamed_addr constant [64 x i8] c\"rad runtime panic: index out of bounds: index %lld >= len %lld\\0A\\00\", align 1\n")
        header.push_str("define void @__rad_panic_bounds(i64 %idx, i64 %len) {\nentry:\n  call void @__rad_run_panic_hook()\n  %fmt = getelementptr inbounds [64 x i8], ptr @.panic_bounds_fmt, i32 0, i32 0\n  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %fmt, i64 %idx, i64 %len)\n  call void @exit(i32 1)\n  ret void\n}\n\n")

        header.push_str("@.panic_div_fmt = private unnamed_addr constant [46 x i8] c\"rad runtime panic: attempt to divide by zero\\0A\\00\", align 1\n")
        header.push_str("define void @__rad_panic_div_zero() {\nentry:\n  call void @__rad_run_panic_hook()\n  %fmt = getelementptr inbounds [46 x i8], ptr @.panic_div_fmt, i32 0, i32 0\n  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %fmt)\n  call void @exit(i32 1)\n  ret void\n}\n\n")

        header.push_str("@.contract_panic_msg = private unnamed_addr constant [49 x i8] c\"rad runtime panic: contract precondition failed\\0A\\00\", align 1\n")
        header.push_str("define void @__rad_contract_violation() {\nentry:\n  call void @__rad_run_panic_hook()\n  %fmt = getelementptr inbounds [49 x i8], ptr @.contract_panic_msg, i32 0, i32 0\n  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %fmt)\n  call void @exit(i32 101)\n  ret void\n}\n\n")

        header.push_str("define i64 @__rad_jit_call0(ptr %fn) {\nentry:\n  %res = call i64 %fn()\n  ret i64 %res\n}\n\n")
        header.push_str("define i64 @__rad_jit_call1(ptr %fn, i64 %a1) {\nentry:\n  %res = call i64 %fn(i64 %a1)\n  ret i64 %res\n}\n\n")
        header.push_str("define i64 @__rad_jit_call2(ptr %fn, i64 %a1, i64 %a2) {\nentry:\n  %res = call i64 %fn(i64 %a1, i64 %a2)\n  ret i64 %res\n}\n\n")

        header.push_str("define ptr @vec_from(ptr %slice) {\nentry:\n  %is_null = icmp eq ptr %slice, null\n  br i1 %is_null, label %ret_empty, label %do_copy\nret_empty:\n  %empty_vec = call ptr @new()\n  ret ptr %empty_vec\ndo_copy:\n  %len_ptr = getelementptr inbounds i8, ptr %slice, i64 16\n  %len = load i64, ptr %len_ptr, align 8\n  %obj = call ptr @malloc(i64 24)\n  %cap = shl i64 %len, 1\n  %adj_cap_cond = icmp ult i64 %cap, 16\n  %adj_cap = select i1 %adj_cap_cond, i64 16, i64 %cap\n  %bytes = shl i64 %adj_cap, 3\n  %buf = call ptr @malloc(i64 %bytes)\n  store ptr %buf, ptr %obj, align 8\n  %cap_slot = getelementptr inbounds i8, ptr %obj, i64 8\n  store i64 %adj_cap, ptr %cap_slot, align 8\n  %len_slot = getelementptr inbounds i8, ptr %obj, i64 16\n  store i64 %len, ptr %len_slot, align 8\n  %src_buf = load ptr, ptr %slice, align 8\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %do_copy ], [ %next_i, %body ]\n  %is_done = icmp uge i64 %i, %len\n  br i1 %is_done, label %exit, label %body\nbody:\n  %src_slot = getelementptr inbounds i64, ptr %src_buf, i64 %i\n  %val = load i64, ptr %src_slot, align 8\n  %dst_slot = getelementptr inbounds i64, ptr %buf, i64 %i\n  store i64 %val, ptr %dst_slot, align 8\n  %next_i = add i64 %i, 1\n  br label %loop\nexit:\n  ret ptr %obj\n}\n\n")

        var has_user_for_each = false
        var has_user_map = false
        var has_user_filter = false
        var c_fi = 0usize
        while c_fi < self.parser.functions.len {
            let fn_n = self.parser.functions.ptr[c_fi].fn_name.as_ptr() as str
            if str_eq(fn_n, "for_each") || str_eq(fn_n, "Vec__for_each") { has_user_for_each = true }
            if str_eq(fn_n, "map") || str_eq(fn_n, "Vec__map") { has_user_map = true }
            if str_eq(fn_n, "filter") || str_eq(fn_n, "Vec__filter") { has_user_filter = true }
            c_fi = c_fi + 1usize
        }
        if !has_user_for_each {
            header.push_str("define void @for_each(ptr %vec, ptr %f) {\nentry:\n  %is_null = icmp eq ptr %vec, null\n  br i1 %is_null, label %exit, label %chk_f\nchk_f:\n  %f_null = icmp eq ptr %f, null\n  br i1 %f_null, label %exit, label %load_meta\nload_meta:\n  %buf_slot = getelementptr inbounds i8, ptr %vec, i64 0\n  %buf_ptr = load ptr, ptr %buf_slot, align 8\n  %len_slot = getelementptr inbounds i8, ptr %vec, i64 16\n  %len = load i64, ptr %len_slot, align 8\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %load_meta ], [ %next_i, %body ]\n  %done = icmp uge i64 %i, %len\n  br i1 %done, label %exit, label %body\nbody:\n  %item_slot = getelementptr inbounds i64, ptr %buf_ptr, i64 %i\n  %item = load i64, ptr %item_slot, align 8\n  call void %f(i64 %item)\n  %next_i = add i64 %i, 1\n  br label %loop\nexit:\n  ret void\n}\n\n")
            header.push_str("define void @Vec__for_each(ptr %vec, ptr %f) {\nentry:\n  call void @for_each(ptr %vec, ptr %f)\n  ret void\n}\n\n")
        }
        if !has_user_map {
            header.push_str("define ptr @map(ptr %vec, ptr %f) {\nentry:\n  %res = call ptr @new()\n  %is_null = icmp eq ptr %vec, null\n  br i1 %is_null, label %exit, label %chk_f\nchk_f:\n  %f_null = icmp eq ptr %f, null\n  br i1 %f_null, label %exit, label %load_meta\nload_meta:\n  %buf_slot = getelementptr inbounds i8, ptr %vec, i64 0\n  %buf_ptr = load ptr, ptr %buf_slot, align 8\n  %len_slot = getelementptr inbounds i8, ptr %vec, i64 16\n  %len = load i64, ptr %len_slot, align 8\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %load_meta ], [ %next_i, %body ]\n  %done = icmp uge i64 %i, %len\n  br i1 %done, label %exit, label %body\nbody:\n  %item_slot = getelementptr inbounds i64, ptr %buf_ptr, i64 %i\n  %item = load i64, ptr %item_slot, align 8\n  %mapped = call i64 %f(i64 %item)\n  call void @push(ptr %res, i64 %mapped)\n  %next_i = add i64 %i, 1\n  br label %loop\nexit:\n  ret ptr %res\n}\n\n")
            header.push_str("define ptr @Vec__map(ptr %vec, ptr %f) {\nentry:\n  %r = call ptr @map(ptr %vec, ptr %f)\n  ret ptr %r\n}\n\n")
        }
        if !has_user_filter {
            header.push_str("define ptr @filter(ptr %vec, ptr %f) {\nentry:\n  %res = call ptr @new()\n  %is_null = icmp eq ptr %vec, null\n  br i1 %is_null, label %exit, label %chk_f\nchk_f:\n  %f_null = icmp eq ptr %f, null\n  br i1 %f_null, label %exit, label %load_meta\nload_meta:\n  %buf_slot = getelementptr inbounds i8, ptr %vec, i64 0\n  %buf_ptr = load ptr, ptr %buf_slot, align 8\n  %len_slot = getelementptr inbounds i8, ptr %vec, i64 16\n  %len = load i64, ptr %len_slot, align 8\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %load_meta ], [ %next_i, %l_next ]\n  %done = icmp uge i64 %i, %len\n  br i1 %done, label %exit, label %body\nbody:\n  %item_slot = getelementptr inbounds i64, ptr %buf_ptr, i64 %i\n  %item = load i64, ptr %item_slot, align 8\n  %keep = call i64 %f(i64 %item)\n  %keep_b = icmp ne i64 %keep, 0\n  br i1 %keep_b, label %do_push, label %l_next\ndo_push:\n  call void @push(ptr %res, i64 %item)\n  br label %l_next\nl_next:\n  %next_i = add i64 %i, 1\n  br label %loop\nexit:\n  ret ptr %res\n}\n\n")
            header.push_str("define ptr @Vec__filter(ptr %vec, ptr %f) {\nentry:\n  %r = call ptr @filter(ptr %vec, ptr %f)\n  ret ptr %r\n}\n\n")
        }

        var fn_ir = String.new()
        var f_idx = 0usize
        while f_idx < self.parser.functions.len {
            let func = self.parser.functions.ptr[f_idx]
            if !func.has_body {
                f_idx = f_idx + 1usize
                continue
            }

            let mutated = Vec.new()
            var mi = 0usize
            while mi < func.body.len {
                self.collect_mutated_vars(func.body.ptr[mi], mutated)
                mi = mi + 1usize
            }
            mi = 0usize
            while mi < func.body.len {
                self.check_unused_var_mutability(func.body.ptr[mi], mutated)
                mi = mi + 1usize
            }

            self.current_func_idx = f_idx
            let fname = self.parser.functions.ptr[f_idx].fn_name.as_ptr() as str

            var has_test_main = false
            if self.parser.test_mode {
                var c_idx = 0usize
                while c_idx < self.parser.functions.len {
                    if str_eq(self.parser.functions.ptr[c_idx].fn_name.as_ptr() as str, "rad_test_main") {
                        has_test_main = true
                        break
                    }
                    c_idx = c_idx + 1usize
                }
            }

            let is_main_entry = (str_eq(fname, "rad_test_main") && self.parser.test_mode) || (str_eq(fname, "main") && !has_test_main)
            let is_user_main = str_eq(fname, "main") && has_test_main

            fn_ir.push_str("define ")
            if is_main_entry {
                fn_ir.push_str("i32 @main(i32 %argc, ptr %argv)")
            } else if is_user_main {
                fn_ir.push_str("i32 @__user_main(i32 %argc, ptr %argv)")
            } else {
                let is_cap_lambda = str_starts_with(fname, "__rad_lambda_") && self.is_lambda_capturing(f_idx)
                fn_ir.push_str(self.emit_llvm_type(func.ret_type.as_ptr() as str))
                fn_ir.push_str(" @")
                fn_ir.push_str(fname)
                fn_ir.push_str("(")
                if is_cap_lambda {
                    fn_ir.push_str("ptr %__env")
                }
                var p_idx = 0usize
                while p_idx < func.param_names.len {
                    if p_idx > 0usize || is_cap_lambda { fn_ir.push_str(", ") }
                    let p_ty = func.param_types.ptr[p_idx].as_ptr() as str
                    fn_ir.push_str(self.emit_llvm_type(p_ty))
                    fn_ir.push_str(" %")
                    fn_ir.push_str(func.param_names.ptr[p_idx].as_ptr() as str)
                    p_idx = p_idx + 1usize
                }
                fn_ir.push_str(")")
            }
            if self.debug_info {
                fn_ir.push_str(" !dbg !")
                fn_ir.push_str(int_to_str(1000 + (f_idx as i32) * 2).as_ptr() as str)
            }
            fn_ir.push_str(" {\nentry:\n")

            self.fn_allocas = String.new()
            self.allocated_vars = Vec.new()
            self.fn_defer_metas = Vec.new()
            self.pending_defer_thunks = Vec.new()

            if str_starts_with(fname, "__rad_lambda_") && self.is_lambda_capturing(f_idx) {
                let caps = self.get_lambda_caps(f_idx)
                var ci = 0usize
                while ci < caps.len {
                    let cname = caps.ptr[ci].as_ptr() as str
                    self.allocated_vars.push(String.from_str(cname))
                    let gep_reg = self.alloc_ssa()
                    self.fn_allocas.push_str("  %")
                    self.fn_allocas.push_str(int_to_str(gep_reg).as_ptr() as str)
                    self.fn_allocas.push_str(" = getelementptr inbounds ptr, ptr %__env, i64 ")
                    self.fn_allocas.push_str(int_to_str(ci as i32).as_ptr() as str)
                    self.fn_allocas.push_str("\n")
                    self.fn_allocas.push_str("  %")
                    self.fn_allocas.push_str(cname)
                    self.fn_allocas.push_str(".addr = load ptr, ptr %")
                    self.fn_allocas.push_str(int_to_str(gep_reg).as_ptr() as str)
                    self.fn_allocas.push_str(", align 8\n")
                    ci = ci + 1usize
                }
            }

            if is_main_entry || is_user_main {
                self.allocated_vars.push(String.from_str("argc"))
                self.allocated_vars.push(String.from_str("argv"))
                self.fn_allocas.push_str("  %argc.addr = alloca i32, align 4\n")
                self.fn_allocas.push_str("  store i32 %argc, ptr %argc.addr, align 4\n")
                self.fn_allocas.push_str("  %argv.addr = alloca ptr, align 8\n")
                self.fn_allocas.push_str("  store ptr %argv, ptr %argv.addr, align 8\n")
            }

            // Allocate local stack slots for parameters
            if !is_main_entry && !is_user_main {
                var pi = 0usize
                while pi < func.param_names.len {
                    let pname = func.param_names.ptr[pi].as_ptr() as str
                    let p_ty = func.param_types.ptr[pi].as_ptr() as str
                    let llvm_ty = self.emit_llvm_type(p_ty)
                    self.allocated_vars.push(String.from_str(pname))

                    self.fn_allocas.push_str("  %")
                    self.fn_allocas.push_str(pname)
                    self.fn_allocas.push_str(".addr = alloca ")
                    self.fn_allocas.push_str(llvm_ty)
                    self.fn_allocas.push_str(", align 8\n")

                    self.fn_allocas.push_str("  store ")
                    self.fn_allocas.push_str(llvm_ty)
                    self.fn_allocas.push_str(" %")
                    self.fn_allocas.push_str(pname)
                    self.fn_allocas.push_str(", ptr %")
                    self.fn_allocas.push_str(pname)
                    self.fn_allocas.push_str(".addr, align 8\n")

                    pi = pi + 1usize
                }
            }

            // Allocate stack slots for local variables in body
            var bi = 0usize
            while bi < func.body.len {
                self.collect_allocas_stmt(func.body.ptr[bi])
                bi = bi + 1usize
            }

            fn_ir.push_str(self.fn_allocas.as_ptr() as str)

            // Emit function body statements
            self.current_ret_type = String.from_str(self.emit_llvm_type(func.ret_type.as_ptr() as str))
            self.ir = String.new()
            self.active_defers = Vec.new()
            self.active_drops_var = Vec.new()
            self.active_drops_type = Vec.new()
            self.loop_drop_stack = Vec.new()
            self.loop_defer_stack = Vec.new()
            self.loop_cond_labels = Vec.new()
            self.loop_end_labels = Vec.new()
            var si = 0usize
            var has_returned = false
            while si < func.body.len {
                let stmt_id = func.body.ptr[si]
                let is_last = (si + 1usize == func.body.len)
                let sk = self.parser.stmts.ptr[stmt_id].kind
                if !has_returned {
                    if is_last && !str_eq(func.ret_type.as_ptr() as str, "void") && sk == STMT_EXPR {
                        let r = self.emit_expr(self.parser.stmts.ptr[stmt_id].expr_id)
                        self.emit_defers_from(0usize)
                        self.emit_drops_from(0usize, "")
                        let ret_ty = self.current_ret_type.as_ptr() as str
                        if str_eq(ret_ty, "void") {
                            self.ir.push_str("  ret void\n")
                        } else if str_eq(ret_ty, "i32") {
                            let tr = self.alloc_ssa()
                            self.ir.push_str("  %")
                            self.ir.push_str(int_to_str(tr).as_ptr() as str)
                            self.ir.push_str(" = trunc i64 %")
                            self.ir.push_str(int_to_str(r).as_ptr() as str)
                            self.ir.push_str(" to i32\n")
                            self.ir.push_str("  ret i32 %")
                            self.ir.push_str(int_to_str(tr).as_ptr() as str)
                            self.ir.push_str("\n")
                        } else if str_eq(ret_ty, "ptr") {
                            var final_reg = r + 0
                            if !self.is_expr_ptr(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = inttoptr i64 %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to ptr\n")
                                final_reg = cvt
                            }
                            self.ir.push_str("  ret ptr %")
                            self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                            self.ir.push_str("\n")
                        } else if str_eq(ret_ty, "float") {
                            var final_reg = r + 0
                            if !self.is_expr_float(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = sitofp i64 %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to float\n")
                                final_reg = cvt
                            } else if !self.is_expr_f32(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = fptrunc double %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to float\n")
                                final_reg = cvt
                            }
                            self.ir.push_str("  ret float %")
                            self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                            self.ir.push_str("\n")
                        } else if str_eq(ret_ty, "double") {
                            var final_reg = r + 0
                            if !self.is_expr_float(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = sitofp i64 %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to double\n")
                                final_reg = cvt
                            } else if self.is_expr_f32(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = fpext float %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to double\n")
                                final_reg = cvt
                            }
                            self.ir.push_str("  ret double %")
                            self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                            self.ir.push_str("\n")
                        } else {
                            var final_reg = r + 0
                            if self.is_expr_ptr(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = ptrtoint ptr %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to i64\n")
                                final_reg = cvt
                            } else if self.is_expr_float(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                if self.is_expr_f32(self.parser.stmts.ptr[stmt_id].expr_id) {
                                    self.ir.push_str(" = fptosi float %")
                                } else {
                                    self.ir.push_str(" = fptosi double %")
                                }
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to i64\n")
                                final_reg = cvt
                            }
                            self.ir.push_str("  ret i64 %")
                            self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                            self.ir.push_str("\n")
                        }
                        has_returned = true
                    } else {
                        self.emit_stmt(stmt_id)
                        if self.stmt_terminates(stmt_id) {
                            has_returned = true
                        }
                    }
                }
                si = si + 1usize
            }
            if !has_returned {
                self.emit_defers_from(0usize)
                self.emit_drops_from(0usize, "")
            }
            if self.ir.len() > 0usize {
                if self.debug_info {
                    let loc_id = 1000 + (f_idx as i32) * 2 + 1
                    var tag = String.new()
                    tag.push_str(", !dbg !")
                    tag.push_str(int_to_str(loc_id).as_ptr() as str)

                    let ir_p: *raw u8 = self.ir.as_ptr()
                    let ir_len = self.ir.len()
                    var line_start = 0usize
                    var cur = 0usize
                    while cur < ir_len {
                        if ir_p[cur] == 10u8 { // '\n'
                            var has_call = false
                            var scan = line_start
                            while scan + 4usize <= cur {
                                if ir_p[scan] == 99u8 && ir_p[scan + 1usize] == 97u8 && ir_p[scan + 2usize] == 108u8 && ir_p[scan + 3usize] == 108u8 && ir_p[scan + 4usize] == 32u8 {
                                    has_call = true
                                    break
                                }
                                scan = scan + 1usize
                            }
                            var b = line_start
                            while b < cur {
                                fn_ir.push_byte(ir_p[b])
                                b = b + 1usize
                            }
                            if has_call {
                                fn_ir.push_str(tag.as_ptr() as str)
                            }
                            fn_ir.push_byte(10u8) // '\n'
                            line_start = cur + 1usize
                        }
                        cur = cur + 1usize
                    }
                } else {
                    fn_ir.push_str(self.ir.as_ptr() as str)
                }
            }

            if !has_returned {
                let ret_ty = self.current_ret_type.as_ptr() as str
                if is_main_entry || is_user_main || str_eq(fname, "main") {
                    fn_ir.push_str("  ret i32 0\n")
                } else if str_eq(func.ret_type.as_ptr() as str, "void") {
                    fn_ir.push_str("  ret void\n")
                } else if str_eq(ret_ty, "i32") {
                    fn_ir.push_str("  ret i32 0\n")
                } else if str_eq(ret_ty, "ptr") {
                    fn_ir.push_str("  ret ptr null\n")
                } else if str_eq(ret_ty, "double") {
                    fn_ir.push_str("  ret double 0.0\n")
                } else if str_eq(ret_ty, "float") {
                    fn_ir.push_str("  ret float 0.0\n")
                } else {
                    fn_ir.push_str("  ret i64 0\n")
                }
            }
            fn_ir.push_str("}\n\n")

            var dti = 0usize
            while dti < self.pending_defer_thunks.len {
                let d_stmt_id = self.pending_defer_thunks.ptr[dti]
                var cap_vars = Vec.new()
                var mi_d = 0usize
                while mi_d < self.fn_defer_metas.len {
                    if self.fn_defer_metas.ptr[mi_d].stmt_id == d_stmt_id {
                        cap_vars = self.fn_defer_metas.ptr[mi_d].cap_vars
                        break
                    }
                    mi_d = mi_d + 1usize
                }
                fn_ir.push_str("define void @__rad_defer_thunk_")
                fn_ir.push_str(int_to_str(d_stmt_id as i32).as_ptr() as str)
                fn_ir.push_str("(ptr %__env) {\nentry:\n")

                self.fn_allocas = String.new()
                self.allocated_vars = Vec.new()
                self.ssa_counter = 0
                self.label_counter = 0
                self.current_ret_type = String.from_str("void")
                self.ir = String.new()
                self.active_defers = Vec.new()
                self.active_drops_var = Vec.new()
                self.active_drops_type = Vec.new()
                self.loop_drop_stack = Vec.new()
                self.loop_defer_stack = Vec.new()
                self.loop_cond_labels = Vec.new()
                self.loop_end_labels = Vec.new()

                var ci = 0usize
                while ci < cap_vars.len {
                    let cname = cap_vars.ptr[ci].as_ptr() as str
                    self.allocated_vars.push(String.from_str(cname))
                    self.fn_allocas.push_str("  %__cap_gep_")
                    self.fn_allocas.push_str(int_to_str(ci as i32).as_ptr() as str)
                    self.fn_allocas.push_str(" = getelementptr inbounds ptr, ptr %__env, i64 ")
                    self.fn_allocas.push_str(int_to_str(ci as i32).as_ptr() as str)
                    self.fn_allocas.push_str("\n  %")
                    self.fn_allocas.push_str(cname)
                    self.fn_allocas.push_str(".addr = load ptr, ptr %__cap_gep_")
                    self.fn_allocas.push_str(int_to_str(ci as i32).as_ptr() as str)
                    self.fn_allocas.push_str(", align 8\n")
                    ci = ci + 1usize
                }

                let dsp = self.parser.stmts.ptr
                var dbi = 0usize
                while dbi < dsp[d_stmt_id].body_stmts.len {
                    self.collect_allocas_stmt(dsp[d_stmt_id].body_stmts.ptr[dbi])
                    dbi = dbi + 1usize
                }
                fn_ir.push_str(self.fn_allocas.as_ptr() as str)

                var dsi = 0usize
                while dsi < dsp[d_stmt_id].body_stmts.len {
                    self.emit_stmt(dsp[d_stmt_id].body_stmts.ptr[dsi])
                    dsi = dsi + 1usize
                }
                self.emit_defers_from(0usize)
                self.emit_drops_from(0usize, "")
                if self.ir.len() > 0usize {
                    fn_ir.push_str(self.ir.as_ptr() as str)
                }
                fn_ir.push_str("  ret void\n}\n\n")
                dti = dti + 1usize
            }

            f_idx = f_idx + 1usize
        }

        // Global string constant table
        var str_table = String.new()
        var s_idx = 0usize
        while s_idx < self.strings.len {
            let entry = self.strings.ptr[s_idx]
            str_table.push_str("@.str.")
            str_table.push_str(int_to_str(s_idx as i32).as_ptr() as str)
            str_table.push_str(" = private unnamed_addr constant [")
            str_table.push_str(int_to_str(entry.byte_len as i32).as_ptr() as str)
            str_table.push_str(" x i8] c\"")
            
            let p: *raw u8 = entry.content.as_ptr()
            if (p as usize) != 0usize && entry.byte_len > 1usize {
                let content_len = entry.byte_len - 1usize
                var b_idx = 0usize
                while b_idx < content_len {
                    let ch_byte: u8 = p[b_idx]
                    if ch_byte >= 32u8 && ch_byte <= 126u8 && ch_byte != 34u8 && ch_byte != 92u8 {
                        str_table.push_byte(ch_byte)
                    } else {
                        str_table.push_byte(92u8) // '\\'
                        let hi = ch_byte >> 4u8
                        let lo = ch_byte & 15u8
                        if hi < 10u8 { str_table.push_byte(hi + 48u8) } else { str_table.push_byte(hi - 10u8 + 65u8) }
                        if lo < 10u8 { str_table.push_byte(lo + 48u8) } else { str_table.push_byte(lo - 10u8 + 65u8) }
                    }
                    b_idx = b_idx + 1usize
                }
            }
            str_table.push_str("\\00\", align 1\n")
            s_idx = s_idx + 1usize
        }
        if self.strings.len > 0usize {
            str_table.push_str("\n")
        }

        if self.parser.error_count > 0i64 {
            return String.new()
        }

        var full_module = String.new()
        if header.len() > 0usize {
            full_module.push_str(header.as_ptr() as str)
        }
        if str_table.len() > 0usize {
            full_module.push_str(str_table.as_ptr() as str)
        }
        if fn_ir.len() > 0usize {
            full_module.push_str(fn_ir.as_ptr() as str)
        }

        if self.debug_info {
            var dbg_file = self.source_file.as_ptr() as str
            if str_len(dbg_file) == 0usize {
                dbg_file = "main.rad"
            }
            full_module.push_str("!llvm.dbg.cu = !{!0}\n")
            full_module.push_str("!llvm.module.flags = !{!1, !2}\n\n")
            full_module.push_str("!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !3, producer: \"radc 0.2.5\", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false, nameTableKind: None)\n")
            full_module.push_str("!1 = !{i32 7, !\"Dwarf Version\", i32 5}\n")
            full_module.push_str("!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n")
            full_module.push_str("!3 = !DIFile(filename: \"")
            full_module.push_str(dbg_file)
            full_module.push_str("\", directory: \".\")\n")
            full_module.push_str("!4 = !DISubroutineType(types: !5)\n")
            full_module.push_str("!5 = !{null}\n")

            var dfi = 0usize
            while dfi < self.parser.functions.len {
                let dfn = self.parser.functions.ptr[dfi]
                if dfn.body.len > 0usize {
                    var dfname = dfn.fn_name.as_ptr() as str
                    if has_test_main && str_eq(dfname, "main") {
                        dfname = "__user_main"
                    }
                    let sub_id = 1000 + (dfi as i32) * 2
                    let loc_id = sub_id + 1
                    full_module.push_str("!")
                    full_module.push_str(int_to_str(sub_id).as_ptr() as str)
                    full_module.push_str(" = distinct !DISubprogram(name: \"")
                    full_module.push_str(dfname)
                    full_module.push_str("\", scope: !3, file: !3, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)\n")
                    full_module.push_str("!")
                    full_module.push_str(int_to_str(loc_id).as_ptr() as str)
                    full_module.push_str(" = !DILocation(line: 1, column: 1, scope: !")
                    full_module.push_str(int_to_str(sub_id).as_ptr() as str)
                    full_module.push_str(")\n")
                }
                dfi = dfi + 1usize
            }
        }
        return full_module
    }
}
