// ==============================================================================
// radc/src/codegen.rad — Direct SSA LLVM IR Generator
// ==============================================================================

struct StringEntry {
    content: String,
    byte_len: usize,
}

struct Codegen {
    parser: Parser,
    target: String,
    ir: String,
    fn_allocas: String,
    allocated_vars: Vec<String>,
    ssa_counter: i32,
    label_counter: i32,
    strings: Vec<StringEntry>,
    current_ret_type: String,
    loop_cond_labels: Vec<i32>,
    loop_end_labels: Vec<i32>,
    current_func_idx: usize,
    active_defers: Vec<usize>,
    active_drops_var: Vec<String>,
    active_drops_type: Vec<String>,
    debug_info: bool,
    source_file: String,
}

impl Codegen {
    fn alloc_ssa(var self) -> i32 {
        let id = self.ssa_counter
        self.ssa_counter = self.ssa_counter + 1
        return id
    }

    fn alloc_label(var self) -> i32 {
        let id = self.label_counter
        self.label_counter = self.label_counter + 1
        return id
    }

    fn emit_str(var self, s: str) {
        if (s as usize) != 0usize && str_len(s) > 0usize {
            self.ir.push_str(s)
        }
    }

    fn intern_string(var self, str_val: String) -> usize {
        var i = 0usize
        let target = str_val.as_ptr() as str
        while i < self.strings.len {
            if str_eq(self.strings.ptr[i].content.as_ptr() as str, target) {
                return i
            }
            i = i + 1usize
        }
        let id = self.strings.len
        let slen = str_len(target) + 1usize
        self.strings.push(StringEntry {
            content: str_val,
            byte_len: slen,
        })
        return id
    }

    fn emit_llvm_type(self, ty: str) -> str {
        var t = ty;
        while str_starts_with(t, " ") {
            t = (t as usize + 1usize) as str;
        }
        if str_starts_with(t, "var ") {
            t = (t as usize + 4usize) as str;
            while str_starts_with(t, " ") {
                t = (t as usize + 1usize) as str;
            }
        }
        if str_eq(t, "void") {
            return "void"
        }
        if str_starts_with(t, "*") || str_starts_with(t, "str") || str_starts_with(t, "ptr") || str_eq(t, "Vec") || str_eq(t, "String") || str_starts_with(t, "[]") || str_starts_with(t, "var []") || str_starts_with(t, "[") || str_starts_with(t, "dyn ") || self.is_struct_name(t) {
            return "ptr"
        }
        if str_eq(t, "f64") {
            return "double"
        }
        if str_eq(t, "f32") {
            return "float"
        }
        if str_eq(t, "i32") || str_eq(t, "bool") || str_eq(t, "u32") {
            return "i32"
        }
        return "i64"
    }

    fn find_var_type_in_stmts(self, stmt_id: usize, vname: str) -> str {
        let sp = self.parser.stmts.ptr
        let k = sp[stmt_id].kind
        if k == STMT_LET || k == STMT_VAR {
            if str_eq(sp[stmt_id].name.as_ptr() as str, vname) {
                let st_ty = sp[stmt_id].type_name.as_ptr() as str
                if str_len(st_ty) > 0usize {
                    return st_ty
                }
                let init_e = sp[stmt_id].expr_id
                if init_e != 0usize {
                    if self.is_expr_float(init_e) {
                        return "f64"
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_ARRAY_LITERAL {
                        return "[]i64"
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_IDENT {
                        let id_name = self.parser.exprs.ptr[init_e].str_val.as_ptr() as str
                        let raw_t = self.get_raw_var_type(id_name)
                        if str_starts_with(raw_t, "Option<") {
                            let plen = str_len(raw_t)
                            if plen > 8usize {
                                var inner = String.new()
                                let cp = raw_t as *raw u8
                                var ci = 7usize
                                while ci < plen && cp[ci] != 62u8 {
                                    inner.push_byte(cp[ci])
                                    ci = ci + 1usize
                                }
                                inner.push_byte(0u8)
                                return inner.as_ptr() as str
                            }
                        }
                        if str_len(raw_t) > 0usize {
                            return raw_t
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_CAST {
                        let c_ty = self.parser.exprs.ptr[init_e].target_type.as_ptr() as str
                        if str_len(c_ty) > 0usize {
                            return c_ty
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_FIELD_ACCESS {
                        let fname = self.parser.exprs.ptr[init_e].field_name.as_ptr() as str
                        let recv_id = self.parser.exprs.ptr[init_e].left
                        let parent_struct = self.get_expr_struct_name(recv_id)
                        if str_len(parent_struct) > 0usize {
                            var si = 0usize
                            while si < self.parser.structs.len {
                                let sdef = self.parser.structs.ptr[si]
                                if self.match_struct_name(sdef.struct_name.as_ptr() as str, parent_struct) {
                                    var fi = 0usize
                                    while fi < sdef.field_names.len {
                                        if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                            return sdef.field_types.ptr[fi].as_ptr() as str
                                        }
                                        fi = fi + 1usize
                                    }
                                }
                                si = si + 1usize
                            }
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_METHOD_CALL {
                        let recv_id = self.parser.exprs.ptr[init_e].left
                        let member = self.parser.exprs.ptr[init_e].str_val.as_ptr() as str
                        let struct_name = self.get_expr_struct_name(recv_id)
                        if str_len(struct_name) > 0usize {
                            if str_eq(member, "new") {
                                return struct_name
                            }
                            var mangled = String.new()
                            mangled.push_str(struct_name)
                            mangled.push_str("__")
                            mangled.push_str(member)
                            mangled.push_byte(0u8)
                            var fi = 0usize
                            while fi < self.parser.functions.len {
                                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, mangled.as_ptr() as str) {
                                    let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                    if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                        if str_starts_with(raw_r, "Option<") {
                                            let plen = str_len(raw_r)
                                            if plen > 8usize {
                                                var inner = String.new()
                                                let cp = raw_r as *raw u8
                                                var ci = 7usize
                                                while ci < plen && cp[ci] != 62u8 {
                                                    inner.push_byte(cp[ci])
                                                    ci = ci + 1usize
                                                }
                                                inner.push_byte(0u8)
                                                return inner.as_ptr() as str
                                            }
                                        }
                                        return raw_r
                                    }
                                    break
                                }
                                fi = fi + 1usize
                            }
                        }
                        if self.parser.exprs.ptr[recv_id].kind == EXPR_IDENT {
                            let rname = self.parser.exprs.ptr[recv_id].str_val.as_ptr() as str
                            if str_eq(rname, "Vec") {
                                return "Vec"
                            }
                            if str_eq(rname, "String") {
                                return "String"
                            }
                            if self.is_struct_name(rname) {
                                if str_eq(member, "new") {
                                    return rname
                                }
                                var mangled = String.new()
                                mangled.push_str(rname)
                                mangled.push_str("__")
                                mangled.push_str(member)
                                mangled.push_byte(0u8)
                                var fi = 0usize
                                while fi < self.parser.functions.len {
                                    if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, mangled.as_ptr() as str) {
                                        let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                        if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                            return raw_r
                                        }
                                        break
                                    }
                                    fi = fi + 1usize
                                }
                                return rname
                            }
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_INDEX {
                        let idx_ty = self.get_expr_struct_name(init_e)
                        if str_len(idx_ty) > 0usize {
                            return idx_ty
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_IDENT {
                        let rhs_name = self.parser.exprs.ptr[init_e].str_val.as_ptr() as str
                        let rhs_ty = self.get_raw_var_type(rhs_name)
                        if str_len(rhs_ty) > 0usize && !str_eq(rhs_ty, "i64") {
                            return rhs_ty
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_CALL {
                        let callee = self.parser.exprs.ptr[init_e].left
                        if self.parser.exprs.ptr[callee].kind == EXPR_IDENT {
                            let cname = self.parser.exprs.ptr[callee].str_val.as_ptr() as str
                            if str_eq(cname, "input") {
                                return "String"
                            }
                            if self.is_struct_name(cname) {
                                return cname
                            }
                            var fi = 0usize
                            while fi < self.parser.functions.len {
                                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, cname) {
                                    let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                    if str_len(raw_r) > 0usize && !str_eq(raw_r, "i64") && !str_eq(raw_r, "void") {
                                        if str_starts_with(raw_r, "Option<") {
                                            let plen = str_len(raw_r)
                                            if plen > 8usize {
                                                var inner = String.new()
                                                let cp = raw_r as *raw u8
                                                var ci = 7usize
                                                while ci < plen && cp[ci] != 62u8 {
                                                    inner.push_byte(cp[ci])
                                                    ci = ci + 1usize
                                                }
                                                inner.push_byte(0u8)
                                                return inner.as_ptr() as str
                                            }
                                        }
                                        return raw_r
                                    }
                                    break
                                }
                                fi = fi + 1usize
                            }
                        } else if self.parser.exprs.ptr[callee].kind == EXPR_FIELD_ACCESS {
                            let recv_id = self.parser.exprs.ptr[callee].left
                            if self.parser.exprs.ptr[recv_id].kind == EXPR_IDENT {
                                let rname = self.parser.exprs.ptr[recv_id].str_val.as_ptr() as str
                                if str_eq(rname, "Vec") {
                                    return "Vec"
                                }
                                if str_eq(rname, "String") {
                                    return "String"
                                }
                                if self.is_struct_name(rname) {
                                    return rname
                                }
                            }
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_METHOD_CALL {
                        let m_recv = self.parser.exprs.ptr[init_e].left
                        let m_name = self.parser.exprs.ptr[init_e].str_val.as_ptr() as str
                        let recv_ty = self.get_expr_struct_name(m_recv)
                        if str_len(recv_ty) > 0usize {
                            let base_ty = self.clean_type_name(recv_ty)
                            var bm = String.new()
                            bm.push_str(base_ty)
                            bm.push_str("__")
                            bm.push_str(m_name)
                            bm.push_byte(0u8)
                            let bm_name = bm.as_ptr() as str
                            var fi = 0usize
                            while fi < self.parser.functions.len {
                                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, bm_name) {
                                    let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                    if str_contains(recv_ty, "<") {
                                        var si = 0usize
                                        while si < self.parser.structs.len {
                                            let sdef = self.parser.structs.ptr[si]
                                            if self.match_struct_name(sdef.struct_name.as_ptr() as str, base_ty) {
                                                var fld_i = 0usize
                                                while fld_i < sdef.field_names.len {
                                                    if str_eq(sdef.field_types.ptr[fld_i].as_ptr() as str, raw_r) {
                                                        let mono = self.get_monomorphized_field_type(sdef, recv_ty, fld_i)
                                                        if str_len(mono) > 0usize {
                                                            return mono
                                                        }
                                                    }
                                                    fld_i = fld_i + 1usize
                                                }
                                                break
                                            }
                                            si = si + 1usize
                                        }
                                    }
                                    if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                        return raw_r
                                    }
                                    break
                                }
                                fi = fi + 1usize
                            }
                        }
                    }
                }
                return "i64"
            }
        }
        if k == STMT_IF {
            var i = 0usize
            while i < sp[stmt_id].then_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].then_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
            var j = 0usize
            while j < sp[stmt_id].else_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].else_stmts.ptr[j], vname)
                if str_len(ty) > 0usize { return ty }
                j = j + 1usize
            }
        }
        if k == STMT_WHILE {
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].body_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
        }
        if k == STMT_FOR_RANGE {
            if str_eq(sp[stmt_id].name.as_ptr() as str, vname) {
                return "usize"
            }
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].body_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
        }
        if k == STMT_FOR_IN {
            if str_eq(sp[stmt_id].name.as_ptr() as str, vname) {
                let st_ty = sp[stmt_id].type_name.as_ptr() as str
                if str_len(st_ty) > 0usize {
                    return st_ty
                }
                let coll_id = sp[stmt_id].expr_id
                if coll_id != 0usize && coll_id < self.parser.exprs.len {
                    let ep = self.parser.exprs.ptr
                    if ep[coll_id].kind == EXPR_IDENT {
                        let cname = ep[coll_id].str_val.as_ptr() as str
                        let raw_coll_ty = self.get_raw_var_type(cname)
                        if str_starts_with(raw_coll_ty, "Vec<") {
                            let plen = str_len(raw_coll_ty)
                            if plen > 5usize {
                                var inner = String.new()
                                let cp = raw_coll_ty as *raw u8
                                var ci = 4usize
                                while ci < plen && cp[ci] != 62u8 {
                                    inner.push_byte(cp[ci])
                                    ci = ci + 1usize
                                }
                                inner.push_byte(0u8)
                                return inner.as_ptr() as str
                            }
                        } else if str_starts_with(raw_coll_ty, "[]") {
                            return (raw_coll_ty as usize + 2usize) as str
                        } else if str_eq(raw_coll_ty, "Vec") {
                            if self.current_func_idx < self.parser.functions.len {
                                let cur_fn = self.parser.functions.ptr[self.current_func_idx]
                                var bi = 0usize
                                while bi < cur_fn.body.len {
                                    let bs = cur_fn.body.ptr[bi]
                                    if sp[bs].kind == STMT_EXPR {
                                        let eid = sp[bs].expr_id
                                        if ep[eid].kind == EXPR_METHOD_CALL {
                                            let recv = ep[eid].left
                                            let mname = ep[eid].str_val.as_ptr() as str
                                            if ep[recv].kind == EXPR_IDENT && str_eq(ep[recv].str_val.as_ptr() as str, cname) && str_eq(mname, "push") && ep[eid].args.len > 0usize {
                                                let arg0 = ep[eid].args.ptr[0usize]
                                                if ep[arg0].kind == EXPR_STR {
                                                    return "String"
                                                }
                                                if ep[arg0].kind == EXPR_CALL {
                                                    let c_callee = ep[arg0].left
                                                    if ep[c_callee].kind == EXPR_IDENT {
                                                        let cfn = ep[c_callee].str_val.as_ptr() as str
                                                        if self.is_struct_name(cfn) {
                                                            return cfn
                                                        }
                                                    }
                                                }
                                                if ep[arg0].kind == EXPR_METHOD_CALL {
                                                    let mrecv = ep[arg0].left
                                                    if ep[mrecv].kind == EXPR_IDENT && str_eq(ep[mrecv].str_val.as_ptr() as str, "String") {
                                                        return "String"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    bi = bi + 1usize
                                }
                            }
                        }
                    }
                }
                return "i64"
            }
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].body_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
        }
        if k == STMT_DEFER {
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].body_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
        }
        return ""
    }

    fn get_raw_var_type(self, vname: str) -> str {
        if str_eq(vname, "argv") {
            return "*raw *raw u8"
        }
        if self.current_func_idx < self.parser.functions.len {
            let cur_fn = self.parser.functions.ptr[self.current_func_idx]
            var pi = 0usize
            while pi < cur_fn.param_names.len {
                if str_eq(cur_fn.param_names.ptr[pi].as_ptr() as str, vname) {
                    return cur_fn.param_types.ptr[pi].as_ptr() as str
                }
                pi = pi + 1usize
            }
            var bi = 0usize
            while bi < cur_fn.body.len {
                let ty = self.find_var_type_in_stmts(cur_fn.body.ptr[bi], vname)
                if str_len(ty) > 0usize {
                    return ty
                }
                bi = bi + 1usize
            }
        }
        var si = 0usize
        while si < self.parser.stmts.len {
            let sk = self.parser.stmts.ptr[si].kind
            if (sk == STMT_LET || sk == STMT_VAR) && str_eq(self.parser.stmts.ptr[si].name.as_ptr() as str, vname) {
                let st_ty = self.parser.stmts.ptr[si].type_name.as_ptr() as str
                if str_len(st_ty) > 0usize {
                    return st_ty
                }
                let init_e = self.parser.stmts.ptr[si].expr_id
                if init_e != 0usize && self.is_expr_float(init_e) {
                    return "f64"
                }
                if init_e != 0usize && self.parser.exprs.ptr[init_e].kind == EXPR_ARRAY_LITERAL {
                    return "[]i64"
                }
            }
            si = si + 1usize
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            var pi = 0usize
            while pi < self.parser.functions.ptr[fi].param_names.len {
                if str_eq(self.parser.functions.ptr[fi].param_names.ptr[pi].as_ptr() as str, vname) {
                    return self.parser.functions.ptr[fi].param_types.ptr[pi].as_ptr() as str
                }
                pi = pi + 1usize
            }
            fi = fi + 1usize
        }
        return ""
    }

    fn get_var_type(self, vname: str) -> str {
        let raw: str = self.get_raw_var_type(vname)
        if str_len(raw) > 0usize {
            let lt = self.emit_llvm_type(raw)
            if str_eq(lt, "void") {
                return "i64"
            }
            return lt
        }
        return "i64"
    }

    fn clean_type_name(self, ty: str) -> str {
        if str_len(ty) == 0usize {
            return ""
        }
        var s = ty
        var changed = true
        while changed {
            changed = false
            while str_starts_with(s, " ") {
                s = (s as usize + 1usize) as str
                changed = true
            }
            if str_starts_with(s, "*") || str_starts_with(s, "&") {
                s = (s as usize + 1usize) as str
                changed = true
            } else if str_starts_with(s, "raw ") {
                s = (s as usize + 4usize) as str
                changed = true
            } else if str_starts_with(s, "const ") {
                s = (s as usize + 6usize) as str
                changed = true
            } else if str_starts_with(s, "var ") {
                s = (s as usize + 4usize) as str
                changed = true
            }
        }
        while str_starts_with(s, " ") {
            s = (s as usize + 1usize) as str
        }
        var i = 0usize
        let p = s as *raw u8
        while p[i] != 0u8 {
            if p[i] == 60u8 { // '<'
                var base = String.new()
                var k = 0usize
                while k < i {
                    base.push_byte(p[k])
                    k = k + 1usize
                }
                base.push_byte(0u8)
                return base.as_ptr() as str
            }
            i = i + 1usize
        }
        return s
    }

    fn get_expr_struct_name(self, expr_id: usize) -> str {
        if expr_id == 0usize || expr_id >= self.parser.exprs.len {
            return ""
        }
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            if self.is_struct_name(vname) {
                return vname
            }
            let raw = self.get_raw_var_type(vname)
            if str_starts_with(raw, "*") || str_starts_with(raw, "&") || str_starts_with(raw, "raw ") || str_starts_with(raw, "var ") {
                return self.clean_type_name(raw)
            }
            return raw
        }
        if k == EXPR_FIELD_ACCESS {
            let recv_id = ep[expr_id].left
            let parent_struct = self.get_expr_struct_name(recv_id)
            let fname = ep[expr_id].field_name.as_ptr() as str
            if str_starts_with(parent_struct, "Vec<") && str_eq(fname, "ptr") {
                return ""
            }
            if str_len(parent_struct) > 0usize {
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if self.match_struct_name(sdef.struct_name.as_ptr() as str, parent_struct) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                if str_starts_with(fty, "Vec<") {
                                    return fty
                                }
                                return self.clean_type_name(fty)
                            }
                            fi = fi + 1usize
                        }
                    }
                    si = si + 1usize
                }
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[expr_id].left
            let member = ep[expr_id].str_val.as_ptr() as str
            var parent_struct = self.get_expr_struct_name(recv_id)
            if str_len(parent_struct) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                parent_struct = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            if str_starts_with(parent_struct, "dyn ") {
                let trait_name = (parent_struct as usize + 4usize) as str
                var ti = 0usize
                while ti < self.parser.traits.len {
                    if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                        var mi = 0usize
                        while mi < self.parser.traits.ptr[ti].methods.len {
                            if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, member) {
                                return self.clean_type_name(self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str)
                            }
                            mi = mi + 1usize
                        }
                    }
                    ti = ti + 1usize
                }
            }
            if str_len(parent_struct) > 0usize {
                var mangled = String.new()
                mangled.push_str(parent_struct)
                mangled.push_str("__")
                mangled.push_str(member)
                mangled.push_byte(0u8)
                let m_name = mangled.as_ptr() as str
                var fi = 0usize
                while fi < self.parser.functions.len {
                    if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, m_name) {
                        return self.clean_type_name(self.parser.functions.ptr[fi].ret_type.as_ptr() as str)
                    }
                    fi = fi + 1usize
                }
                let base_ty = self.clean_type_name(parent_struct)
                if !str_eq(base_ty, parent_struct) && str_len(base_ty) > 0usize {
                    var bm = String.new()
                    bm.push_str(base_ty)
                    bm.push_str("__")
                    bm.push_str(member)
                    bm.push_byte(0u8)
                    let bm_name = bm.as_ptr() as str
                    fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, bm_name) {
                            return self.clean_type_name(self.parser.functions.ptr[fi].ret_type.as_ptr() as str)
                        }
                        fi = fi + 1usize
                    }
                }
            }
            var fi = 0usize
            while fi < self.parser.functions.len {
                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, member) {
                    return self.clean_type_name(self.parser.functions.ptr[fi].ret_type.as_ptr() as str)
                }
                fi = fi + 1usize
            }
        }
        if k == EXPR_CALL {
            let callee_id = ep[expr_id].left
            if ep[callee_id].kind == EXPR_IDENT {
                let cname = ep[callee_id].str_val.as_ptr() as str
                if self.is_struct_name(cname) {
                    return cname
                }
                var fi = 0usize
                while fi < self.parser.functions.len {
                    if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, cname) {
                        return self.clean_type_name(self.parser.functions.ptr[fi].ret_type.as_ptr() as str)
                    }
                    fi = fi + 1usize
                }
            }
        }
        if k == EXPR_CAST {
            return self.clean_type_name(ep[expr_id].target_type.as_ptr() as str)
        }
        if k == EXPR_INDEX {
            let coll_id = ep[expr_id].left
            var coll_ty = ""
            if ep[coll_id].kind == EXPR_FIELD_ACCESS && str_eq(ep[coll_id].field_name.as_ptr() as str, "ptr") {
                coll_ty = self.get_expr_struct_name(ep[coll_id].left)
            } else {
                coll_ty = self.get_expr_struct_name(coll_id)
            }
            if str_len(coll_ty) == 0usize && ep[coll_id].kind == EXPR_IDENT {
                coll_ty = self.get_raw_var_type(ep[coll_id].str_val.as_ptr() as str)
            }
            if str_starts_with(coll_ty, "Vec<") {
                let plen = str_len(coll_ty)
                if plen > 5usize {
                    var inner = String.new()
                    let cp = coll_ty as *raw u8
                    var ci = 4usize
                    var depth = 1
                    while ci < plen && depth > 0 {
                        if cp[ci] == 60u8 {
                            depth = depth + 1
                        } else if cp[ci] == 62u8 {
                            depth = depth - 1
                        }
                        if depth > 0 {
                            inner.push_byte(cp[ci])
                        }
                        ci = ci + 1usize
                    }
                    inner.push_byte(0u8)
                    return inner.as_ptr() as str
                }
            } else if str_starts_with(coll_ty, "[]") {
                return (coll_ty as usize + 2usize) as str
            } else if str_len(coll_ty) > 0usize && self.is_struct_name(coll_ty) {
                return coll_ty
            }
        }
        if k == EXPR_TRY || k == EXPR_AWAIT {
            return self.get_expr_struct_name(ep[expr_id].left)
        }
        return ""
    }

    fn get_monomorphized_field_type(self, sdef: StructDef, s_type: str, fi: usize) -> str {
        if fi >= sdef.field_types.len {
            return ""
        }
        let raw_fty = sdef.field_types.ptr[fi].as_ptr() as str
        if !str_contains(s_type, "<") {
            return raw_fty
        }
        let p = s_type as *raw u8
        let slen = str_len(s_type)
        var start_lt = 0usize
        while start_lt < slen && p[start_lt] != 60u8 { // '<'
            start_lt = start_lt + 1usize
        }
        if start_lt >= slen {
            return raw_fty
        }
        start_lt = start_lt + 1usize
        var cur_arg = String.new()
        var arg_idx = 0usize
        var depth = 0i64
        var pos = start_lt
        while pos < slen {
            let b = p[pos]
            if b == 60u8 { // '<'
                depth = depth + 1i64
                cur_arg.push_byte(b)
            } else if b == 62u8 { // '>'
                if depth == 0i64 {
                    if arg_idx == fi {
                        cur_arg.push_byte(0u8)
                        return cur_arg.as_ptr() as str
                    }
                    break
                } else {
                    depth = depth - 1i64
                    cur_arg.push_byte(b)
                }
            } else if b == 44u8 && depth == 0i64 { // ','
                if arg_idx == fi {
                    cur_arg.push_byte(0u8)
                    return cur_arg.as_ptr() as str
                }
                arg_idx = arg_idx + 1usize
                cur_arg = String.new()
            } else if b != 32u8 || cur_arg.len() > 0usize {
                cur_arg.push_byte(b)
            }
            pos = pos + 1usize
        }
        return raw_fty
    }

    fn is_expr_float(self, id: usize) -> bool {
        let ep = self.parser.exprs.ptr
        let k = ep[id].kind
        if k == EXPR_FLOAT {
            return true
        }
        if k == EXPR_IDENT {
            let vname = ep[id].str_val.as_ptr() as str
            let ty = self.get_var_type(vname)
            return str_eq(ty, "double") || str_eq(ty, "float")
        }
        if k == EXPR_BINARY {
            let op = ep[id].op
            if op == TOK_EQEQ || op == TOK_NEQ || op == TOK_LT || op == TOK_LEQ || op == TOK_GT || op == TOK_GEQ || op == TOK_ANDAND || op == TOK_OROR ||
               op == TOK_AMP || op == TOK_PIPE || op == TOK_CARET || op == TOK_SHL || op == TOK_SHR || op == TOK_PERCENT {
                return false
            }
            return self.is_expr_float(ep[id].left) || self.is_expr_float(ep[id].right)
        }
        if k == EXPR_CAST {
            let tgt = ep[id].target_type.as_ptr() as str
            return str_eq(tgt, "f64") || str_eq(tgt, "f32")
        }
        if k == EXPR_UNARY {
            return self.is_expr_float(ep[id].left)
        }
        if k == EXPR_TRY || k == EXPR_AWAIT {
            return self.is_expr_float(ep[id].left)
        }
        if k == EXPR_FIELD_ACCESS {
            let fname = ep[id].field_name.as_ptr() as str
            let recv_id = ep[id].left
            var s_type = self.get_expr_struct_name(recv_id)
            if str_len(s_type) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                s_type = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            var si = 0usize
            while si < self.parser.structs.len {
                let sdef = self.parser.structs.ptr[si]
                if str_len(s_type) == 0usize || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                    var fi = 0usize
                    while fi < sdef.field_names.len {
                        if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                            let fty = self.get_monomorphized_field_type(sdef, s_type, fi)
                            return str_eq(fty, "f64") || str_eq(fty, "f32")
                        }
                        fi = fi + 1usize
                    }
                }
                si = si + 1usize
            }
        }
        if k == EXPR_INDEX {
            let left_id = ep[id].left
            if ep[left_id].kind == EXPR_IDENT {
                let raw_ty = self.get_raw_var_type(ep[left_id].str_val.as_ptr() as str)
                if str_ends_with(raw_ty, "f64") || str_ends_with(raw_ty, "f32") {
                    return true
                }
            } else if ep[left_id].kind == EXPR_FIELD_ACCESS {
                let fname = ep[left_id].field_name.as_ptr() as str
                let recv_id = ep[left_id].left
                let s_type = self.get_expr_struct_name(recv_id)
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if str_len(s_type) == 0usize || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                if str_ends_with(fty, "f64") || str_ends_with(fty, "f32") {
                                    return true
                                }
                            }
                            fi = fi + 1usize
                        }
                    }
                    si = si + 1usize
                }
            }
        }
        if k == EXPR_CALL {
            let callee_id = ep[id].left
            if ep[callee_id].kind == EXPR_IDENT {
                let fname = ep[callee_id].str_val.as_ptr() as str
                let rty = self.get_func_ret_type(fname)
                return str_eq(rty, "double") || str_eq(rty, "float")
            }
            if ep[callee_id].kind == EXPR_FIELD_ACCESS {
                let member = ep[callee_id].field_name.as_ptr() as str
                let rty = self.get_func_ret_type(member)
                return str_eq(rty, "double") || str_eq(rty, "float")
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[id].left
            let member = ep[id].str_val.as_ptr() as str
            var raw_ty = self.get_expr_struct_name(recv_id)
            if str_len(raw_ty) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                raw_ty = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            if str_starts_with(raw_ty, "dyn ") {
                let trait_name = (raw_ty as usize + 4usize) as str
                var ti = 0usize
                while ti < self.parser.traits.len {
                    if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                        var mi = 0usize
                        while mi < self.parser.traits.ptr[ti].methods.len {
                            if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, member) {
                                let rty = self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str
                                return str_eq(rty, "f64") || str_eq(rty, "f32")
                            }
                            mi = mi + 1usize
                        }
                    }
                    ti = ti + 1usize
                }
            }
            if str_len(raw_ty) > 0usize && !str_eq(raw_ty, "String") && !str_eq(raw_ty, "Vec") {
                var mangled = String.new()
                mangled.push_str(raw_ty)
                mangled.push_str("__")
                mangled.push_str(member)
                let rty = self.get_func_ret_type(mangled.as_ptr() as str)
                if str_eq(rty, "double") || str_eq(rty, "float") {
                    return true
                }
            }
            let rty = self.get_func_ret_type(member)
            return str_eq(rty, "double") || str_eq(rty, "float")
        }
        return false
    }

    fn is_expr_f32(self, id: usize) -> bool {
        let ep = self.parser.exprs.ptr
        let k = ep[id].kind
        if k == EXPR_IDENT {
            let vname = ep[id].str_val.as_ptr() as str
            let ty = self.get_var_type(vname)
            return str_eq(ty, "float")
        }
        if k == EXPR_CAST {
            let tgt = ep[id].target_type.as_ptr() as str
            return str_eq(tgt, "f32")
        }
        if k == EXPR_CALL {
            let callee_id = ep[id].left
            if ep[callee_id].kind == EXPR_IDENT {
                let fname = ep[callee_id].str_val.as_ptr() as str
                let rty = self.get_func_ret_type(fname)
                return str_eq(rty, "float")
            }
            if ep[callee_id].kind == EXPR_FIELD_ACCESS {
                let member = ep[callee_id].field_name.as_ptr() as str
                let rty = self.get_func_ret_type(member)
                return str_eq(rty, "float")
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[id].left
            let member = ep[id].str_val.as_ptr() as str
            var raw_ty = self.get_expr_struct_name(recv_id)
            if str_len(raw_ty) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                raw_ty = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            if str_starts_with(raw_ty, "dyn ") {
                let trait_name = (raw_ty as usize + 4usize) as str
                var ti = 0usize
                while ti < self.parser.traits.len {
                    if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                        var mi = 0usize
                        while mi < self.parser.traits.ptr[ti].methods.len {
                            if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, member) {
                                let rty = self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str
                                return str_eq(rty, "f32")
                            }
                            mi = mi + 1usize
                        }
                    }
                    ti = ti + 1usize
                }
            }
            if str_len(raw_ty) > 0usize && !str_eq(raw_ty, "String") && !str_eq(raw_ty, "Vec") {
                var mangled = String.new()
                mangled.push_str(raw_ty)
                mangled.push_str("__")
                mangled.push_str(member)
                let rty = self.get_func_ret_type(mangled.as_ptr() as str)
                if str_eq(rty, "float") {
                    return true
                }
            }
            let rty = self.get_func_ret_type(member)
            return str_eq(rty, "float")
        }
        return false
    }

    fn get_raw_func_param_type(self, fname: str, param_idx: usize) -> str {
        var fi = 0usize
        while fi < self.parser.functions.len {
            if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, fname) {
                if param_idx < self.parser.functions.ptr[fi].param_types.len {
                    return self.parser.functions.ptr[fi].param_types.ptr[param_idx].as_ptr() as str
                }
            }
            fi = fi + 1usize
        }
        return ""
    }

    fn get_func_param_type(self, fname: str, param_idx: usize) -> str {
        var fi = 0usize
        while fi < self.parser.functions.len {
            if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, fname) {
                if param_idx < self.parser.functions.ptr[fi].param_types.len {
                    return self.emit_llvm_type(self.parser.functions.ptr[fi].param_types.ptr[param_idx].as_ptr() as str)
                }
            }
            fi = fi + 1usize
        }
        if str_eq(fname, "puts") || str_eq(fname, "println") || str_eq(fname, "print") || str_eq(fname, "system") || str_eq(fname, "free") || str_eq(fname, "fclose") || str_eq(fname, "ftell") || str_eq(fname, "getenv") || (str_eq(fname, "printf") && param_idx == 0usize) || str_eq(fname, "atexit") || str_eq(fname, "__rad_register_panic_hook") {
            return "ptr"
        }
        if str_eq(fname, "fopen") {
            return "ptr"
        }
        if str_eq(fname, "fread") || str_eq(fname, "fwrite") {
            if param_idx == 0usize || param_idx == 3usize { return "ptr" }
            return "i64"
        }
        if str_eq(fname, "fseek") {
            if param_idx == 0usize { return "ptr" }
            if param_idx == 1usize { return "i64" }
            return "i32"
        }
        if str_eq(fname, "malloc") {
            return "i64"
        }
        if str_eq(fname, "realloc") {
            if param_idx == 0usize { return "ptr" }
            return "i64"
        }
        if str_starts_with(fname, "syscall") {
            return "i64"
        }
        return "i64"
    }

    fn get_func_ret_type(self, fname: str) -> str {
        if str_starts_with(fname, "syscall") {
            return "i64"
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, fname) {
                return self.emit_llvm_type(self.parser.functions.ptr[fi].ret_type.as_ptr() as str)
            }
            fi = fi + 1usize
        }
        if str_eq(fname, "malloc") || str_eq(fname, "realloc") || str_eq(fname, "fopen") || str_eq(fname, "getenv") || str_eq(fname, "input") || str_eq(fname, "__rad_get_terminal_guard") {
            return "ptr"
        }
        if str_starts_with(fname, "__rad_") {
            return "void"
        }
        if str_eq(fname, "atexit") {
            return "i32"
        }
        if str_eq(fname, "fread") || str_eq(fname, "fwrite") || str_eq(fname, "ftell") {
            return "i64"
        }
        if str_eq(fname, "main") || str_eq(fname, "rad_test_main") || str_eq(fname, "println") || str_eq(fname, "print") || str_eq(fname, "puts") || str_eq(fname, "system") || str_eq(fname, "fclose") || str_eq(fname, "printf") || str_eq(fname, "remove") {
            return "i32"
        }
        return "i64"
    }

    fn match_struct_name(self, sdef_name: str, target: str) -> bool {
        if str_eq(sdef_name, target) {
            return true
        }
        let t_len = str_len(target)
        let s_len = str_len(sdef_name)
        if t_len > s_len {
            let b = (target as *raw u8)[s_len]
            if (b == 60u8 || b == 32u8) && str_starts_with(target, sdef_name) {
                return true
            }
        }
        return false
    }

    fn is_struct_name(self, name: str) -> bool {
        if str_starts_with(name, "dyn ") {
            return true
        }
        var si = 0usize
        while si < self.parser.structs.len {
            if self.match_struct_name(self.parser.structs.ptr[si].struct_name.as_ptr() as str, name) {
                return true
            }
            si = si + 1usize
        }
        return false
    }

    fn get_struct_field_idx(self, field_name: str) -> i64 {
        if str_eq(field_name, "kind") { return 0i64 }
        if str_eq(field_name, "ptr") { return 0i64 }
        if str_eq(field_name, "cap") { return 1i64 }
        if str_eq(field_name, "len") { return 2i64 }

        // Token
        if str_eq(field_name, "text") { return 1i64 }
        if str_eq(field_name, "int_val") { return 2i64 }
        if str_eq(field_name, "line") { return 3i64 }
        if str_eq(field_name, "col") { return 4i64 }
        if str_eq(field_name, "len") { return 5i64 }

        // Expr
        if str_eq(field_name, "op") { return 1i64 }
        if str_eq(field_name, "int_val") { return 2i64 }
        if str_eq(field_name, "str_val") { return 3i64 }
        if str_eq(field_name, "target_type") { return 4i64 }
        if str_eq(field_name, "left") { return 5i64 }
        if str_eq(field_name, "right") { return 6i64 }
        if str_eq(field_name, "args") { return 7i64 }
        if str_eq(field_name, "field_name") { return 8i64 }
        if str_eq(field_name, "expr_line") { return 9i64 }
        if str_eq(field_name, "expr_col") { return 10i64 }

        // Stmt
        if str_eq(field_name, "name") { return 1i64 }
        if str_eq(field_name, "type_name") { return 2i64 }
        if str_eq(field_name, "expr_id") { return 3i64 }
        if str_eq(field_name, "index_expr") { return 4i64 }
        if str_eq(field_name, "then_stmts") { return 5i64 }
        if str_eq(field_name, "else_stmts") { return 6i64 }
        if str_eq(field_name, "body_stmts") { return 7i64 }
        if str_eq(field_name, "stmt_line") { return 8i64 }
        if str_eq(field_name, "stmt_col") { return 9i64 }

        // FunctionDef
        if str_eq(field_name, "fn_name") { return 0i64 }
        if str_eq(field_name, "param_names") { return 1i64 }
        if str_eq(field_name, "param_types") { return 2i64 }
        if str_eq(field_name, "ret_type") { return 3i64 }
        if str_eq(field_name, "body") { return 4i64 }
        if str_eq(field_name, "is_test") { return 5i64 }
        if str_eq(field_name, "is_async") { return 6i64 }

        // TraitMethodDef
        if str_eq(field_name, "method_name") { return 0i64 }

        // TraitDef
        if str_eq(field_name, "trait_name") { return 0i64 }
        if str_eq(field_name, "methods") { return 1i64 }

        // TraitImplDef
        if str_eq(field_name, "target_struct_name") { return 1i64 }

        // StructDef
        if str_eq(field_name, "struct_name") { return 0i64 }
        if str_eq(field_name, "field_names") { return 1i64 }
        if str_eq(field_name, "field_types") { return 2i64 }

        // Parser
        if str_eq(field_name, "tokens") { return 0i64 }
        if str_eq(field_name, "pos") { return 1i64 }
        if str_eq(field_name, "exprs") { return 2i64 }
        if str_eq(field_name, "stmts") { return 3i64 }
        if str_eq(field_name, "functions") { return 4i64 }
        if str_eq(field_name, "structs") { return 5i64 }
        if str_eq(field_name, "traits") { return 6i64 }
        if str_eq(field_name, "trait_impls") { return 7i64 }
        if str_eq(field_name, "const_names") { return 8i64 }
        if str_eq(field_name, "const_values") { return 9i64 }
        if str_eq(field_name, "filename") { return 10i64 }
        if str_eq(field_name, "error_count") { return 11i64 }
        if str_eq(field_name, "source") { return 12i64 }
        if str_eq(field_name, "moved_vars") { return 13i64 }
        if str_eq(field_name, "imported_modules") { return 14i64 }
        if str_eq(field_name, "diagnostics") { return 15i64 }
        if str_eq(field_name, "color_mode") { return 16i64 }
        if str_eq(field_name, "json_format") { return 17i64 }
        if str_eq(field_name, "test_mode") { return 18i64 }
        if str_eq(field_name, "cur_is_test") { return 19i64 }
        if str_eq(field_name, "cur_is_async") { return 20i64 }

        // StringEntry
        if str_eq(field_name, "content") { return 0i64 }
        if str_eq(field_name, "byte_len") { return 1i64 }

        // Codegen
        if str_eq(field_name, "parser") { return 0i64 }
        if str_eq(field_name, "target") { return 1i64 }
        if str_eq(field_name, "ir") { return 2i64 }
        if str_eq(field_name, "fn_allocas") { return 3i64 }
        if str_eq(field_name, "allocated_vars") { return 4i64 }
        if str_eq(field_name, "ssa_counter") { return 5i64 }
        if str_eq(field_name, "label_counter") { return 6i64 }
        if str_eq(field_name, "strings") { return 7i64 }
        if str_eq(field_name, "current_ret_type") { return 8i64 }
        if str_eq(field_name, "loop_cond_labels") { return 9i64 }
        if str_eq(field_name, "loop_end_labels") { return 10i64 }
        if str_eq(field_name, "current_func_idx") { return 11i64 }
        if str_eq(field_name, "active_defers") { return 12i64 }
        if str_eq(field_name, "active_drops_var") { return 13i64 }
        if str_eq(field_name, "active_drops_type") { return 14i64 }
        if str_eq(field_name, "debug_info") { return 15i64 }
        if str_eq(field_name, "source_file") { return 16i64 }

        // CompilerOptions
        if str_eq(field_name, "input_paths") { return 0i64 }
        if str_eq(field_name, "extra_objects") { return 1i64 }
        if str_eq(field_name, "output_path") { return 2i64 }
        if str_eq(field_name, "emit_llvm") { return 3i64 }
        if str_eq(field_name, "check_only") { return 4i64 }
        if str_eq(field_name, "opt_level") { return 5i64 }
        if str_eq(field_name, "target_triple") { return 6i64 }
        if str_eq(field_name, "linker_cmd") { return 7i64 }
        if str_eq(field_name, "show_version") { return 8i64 }
        if str_eq(field_name, "compile_only") { return 9i64 }
        if str_eq(field_name, "cli_color_mode") { return 10i64 }
        if str_eq(field_name, "cli_json_format") { return 11i64 }
        if str_eq(field_name, "test_mode") { return 12i64 }

        var si = 0usize
        while si < self.parser.structs.len {
            let sdef = self.parser.structs.ptr[si]
            var fi = 0usize
            while fi < sdef.field_names.len {
                if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, field_name) {
                    return fi as i64
                }
                fi = fi + 1usize
            }
            si = si + 1usize
        }
        return -1i64
    }

    fn find_similar_ident(self, target: str) -> str {
        var best_cand = ""
        var best_dist = 999i32
        var vi = 0usize
        while vi < self.allocated_vars.len {
            let cand = self.allocated_vars.ptr[vi].as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            vi = vi + 1usize
        }
        if self.current_func_idx < self.parser.functions.len {
            let cur_fn = self.parser.functions.ptr[self.current_func_idx]
            var pi = 0usize
            while pi < cur_fn.param_names.len {
                let cand = cur_fn.param_names.ptr[pi].as_ptr() as str
                if is_name_similar(target, cand) {
                    let d = levenshtein_dist(target, cand)
                    if d < best_dist {
                        best_dist = d
                        best_cand = cand
                    }
                }
                pi = pi + 1usize
            }
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            let cand = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            fi = fi + 1usize
        }
        var ci = 0usize
        while ci < self.parser.const_names.len {
            let cand = self.parser.const_names.ptr[ci].as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            ci = ci + 1usize
        }
        if is_name_similar(target, "println") && 1i32 < best_dist { best_cand = "println"; best_dist = 1i32 }
        if is_name_similar(target, "print") && 1i32 < best_dist { best_cand = "print"; best_dist = 1i32 }
        if is_name_similar(target, "eprintln") && 1i32 < best_dist { best_cand = "eprintln"; best_dist = 1i32 }
        if is_name_similar(target, "assert") && 1i32 < best_dist { best_cand = "assert"; best_dist = 1i32 }
        return best_cand
    }

    fn find_similar_field(self, fname: str, s_type: str) -> str {
        var best_cand = ""
        var best_dist = 999i32
        if str_len(s_type) > 0usize {
            var si = 0usize
            while si < self.parser.structs.len {
                let sdef = self.parser.structs.ptr[si]
                if self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                    var fld_i = 0usize
                    while fld_i < sdef.field_names.len {
                        let cand = sdef.field_names.ptr[fld_i].as_ptr() as str
                        if is_name_similar(fname, cand) {
                            let d = levenshtein_dist(fname, cand)
                            if d < best_dist {
                                best_dist = d
                                best_cand = cand
                            }
                        }
                        fld_i = fld_i + 1usize
                    }
                    break
                }
                si = si + 1usize
            }
        }
        return best_cand
    }

    fn is_expr_ptr(self, id: usize) -> bool {
        let ep = self.parser.exprs.ptr
        let k = ep[id].kind
        if k == EXPR_ARRAY_LITERAL {
            return true
        }
        if k == EXPR_STR {
            return true
        }
        if k == EXPR_IDENT {
            let vname = ep[id].str_val.as_ptr() as str
            var is_alloc = false
            var ai = 0usize
            while ai < self.allocated_vars.len {
                if str_eq(self.allocated_vars.ptr[ai].as_ptr() as str, vname) {
                    is_alloc = true
                    break
                }
                ai = ai + 1usize
            }
            if is_alloc {
                return str_eq(self.get_var_type(vname), "ptr")
            }
            var fi = 0usize
            while fi < self.parser.functions.len {
                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, vname) {
                    return true
                }
                fi = fi + 1usize
            }
            if str_starts_with(vname, "__rad_") {
                return true
            }
            return false
        }
        if k == EXPR_CAST {
            let target_ty = self.emit_llvm_type(ep[id].target_type.as_ptr() as str)
            return str_eq(target_ty, "ptr")
        }
        if k == EXPR_TRY || k == EXPR_AWAIT {
            return self.is_expr_ptr(ep[id].left)
        }
        if k == EXPR_CALL {
            let callee_id = ep[id].left
            if ep[callee_id].kind == EXPR_IDENT {
                let fname = ep[callee_id].str_val.as_ptr() as str
                if self.is_struct_name(fname) {
                    return true
                }
                if str_eq(self.get_func_ret_type(fname), "ptr") {
                    return true
                }
            }
            if ep[callee_id].kind == EXPR_FIELD_ACCESS {
                let recv_id = ep[callee_id].left
                let type_s = ep[recv_id].str_val.as_ptr() as str
                let member_s = ep[callee_id].field_name.as_ptr() as str
                var full_name = String.new()
                full_name.push_str(type_s)
                full_name.push_str("__")
                full_name.push_str(member_s)
                if str_eq(self.get_func_ret_type(full_name.as_ptr() as str), "ptr") {
                    return true
                }
                if str_eq(self.get_func_ret_type(member_s), "ptr") {
                    return true
                }
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[id].left
            let member = ep[id].str_val.as_ptr() as str
            if str_eq(member, "as_ptr") || str_eq(member, "new") || str_eq(member, "from_str") || str_eq(member, "as_str") || str_eq(member, "to_string") {
                return true
            }
            var is_static = false
            if ep[recv_id].kind == EXPR_IDENT {
                let p_recv: *raw u8 = ep[recv_id].str_val.as_ptr()
                if (p_recv as usize) != 0usize && (p_recv[0usize] >= 65u8 && p_recv[0usize] <= 90u8) {
                    is_static = true
                } else {
                    let vname = ep[recv_id].str_val.as_ptr() as str
                    let is_var = str_len(self.get_raw_var_type(vname)) > 0usize
                    if !is_var {
                        is_static = true
                    }
                }
            }
            if is_static {
                let type_s = ep[recv_id].str_val.as_ptr() as str
                var mangled = String.new()
                mangled.push_str(type_s)
                mangled.push_str("__")
                mangled.push_str(member)
                if str_eq(self.get_func_ret_type(mangled.as_ptr() as str), "ptr") {
                    return true
                }
            }
            if !is_static {
                var raw_ty = self.get_expr_struct_name(recv_id)
                if str_len(raw_ty) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                    raw_ty = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
                }
                if str_starts_with(raw_ty, "dyn ") {
                    let trait_name = (raw_ty as usize + 4usize) as str
                    var ti = 0usize
                    while ti < self.parser.traits.len {
                        if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                            var mi = 0usize
                            while mi < self.parser.traits.ptr[ti].methods.len {
                                if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, member) {
                                    let rty = self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str
                                    let lty = self.emit_llvm_type(rty)
                                    return str_eq(lty, "ptr")
                                }
                                mi = mi + 1usize
                            }
                        }
                        ti = ti + 1usize
                    }
                }
                if str_len(raw_ty) > 0usize {
                    var mangled = String.new()
                    mangled.push_str(raw_ty)
                    mangled.push_str("__")
                    mangled.push_str(member)
                    if str_eq(self.get_func_ret_type(mangled.as_ptr() as str), "ptr") {
                        return true
                    }
                }
            }
            if str_eq(self.get_func_ret_type(member), "ptr") {
                return true
            }
            var fi = 0usize
            while fi < self.parser.functions.len {
                let fn_str = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                if str_ends_with(fn_str, member) {
                    let flen = str_len(fn_str)
                    let mlen = str_len(member)
                    if flen > mlen + 2usize {
                        let p = fn_str as *raw u8
                        if p[flen - mlen - 1usize] == 95u8 && p[flen - mlen - 2usize] == 95u8 {
                            if str_eq(self.get_func_ret_type(fn_str), "ptr") {
                                return true
                            }
                        }
                    }
                }
                fi = fi + 1usize
            }
        }
        if k == EXPR_FIELD_ACCESS {
            let fname = ep[id].field_name.as_ptr() as str
            if str_eq(fname, "ptr") {
                return true
            }
            let recv_id = ep[id].left
            var s_type = self.get_expr_struct_name(recv_id)
            if str_len(s_type) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                s_type = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            var si = 0usize
            while si < self.parser.structs.len {
                let sdef = self.parser.structs.ptr[si]
                if str_len(s_type) == 0usize || str_starts_with(s_type, "*") || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                    var fi = 0usize
                    while fi < sdef.field_names.len {
                        if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                            let fty = self.get_monomorphized_field_type(sdef, s_type, fi)
                            let lty = self.emit_llvm_type(fty)
                            return str_eq(lty, "ptr") || str_eq(fty, "str") || str_eq(fty, "String") || str_starts_with(fty, "*raw")
                        }
                        fi = fi + 1usize
                    }
                }
                si = si + 1usize
            }
        }
        if k == EXPR_INDEX {
            let left_id = ep[id].left
            if ep[left_id].kind == EXPR_IDENT {
                let raw_ty = self.get_raw_var_type(ep[left_id].str_val.as_ptr() as str)
                if str_starts_with(raw_ty, "*raw *raw") || str_starts_with(raw_ty, "**") {
                    return true
                }
            }
        }
        return false
    }

    fn is_expr_string_obj(self, expr_id: usize) -> bool {
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_AWAIT {
            return self.is_expr_string_obj(ep[expr_id].left)
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            let raw_ty = self.get_raw_var_type(vname)
            return str_eq(raw_ty, "String")
        }
        if k == EXPR_CALL {
            let callee = ep[expr_id].left
            if ep[callee].kind == EXPR_IDENT {
                let cname = ep[callee].str_val.as_ptr() as str
                if str_eq(cname, "input") {
                    return true
                }
            }
        }
        if k == EXPR_METHOD_CALL {
            let mname = ep[expr_id].str_val.as_ptr() as str
            if str_eq(mname, "new") || str_eq(mname, "from_str") {
                let recv = ep[expr_id].left
                if ep[recv].kind == EXPR_IDENT {
                    let rname = ep[recv].str_val.as_ptr() as str
                    if str_eq(rname, "String") {
                        return true
                    }
                }
            }
        }
        if k == EXPR_FIELD_ACCESS {
            let recv_id = ep[expr_id].left
            let fname = ep[expr_id].field_name.as_ptr() as str
            if ep[recv_id].kind == EXPR_IDENT {
                let s_type = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if str_len(s_type) == 0usize || str_starts_with(s_type, "*") || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                return str_eq(fty, "String")
                            }
                            fi = fi + 1usize
                        }
                    }
                    si = si + 1usize
                }
            }
        }
        return false
    }

    fn stmt_terminates(self, stmt_id: usize) -> bool {
        let sp = self.parser.stmts.ptr
        let k = sp[stmt_id].kind
        if k == STMT_RETURN || k == STMT_BREAK || k == STMT_CONTINUE {
            return true
        }
        if k == STMT_IF {
            if sp[stmt_id].else_stmts.len == 0usize {
                return false
            }
            var then_term = false
            var ti = 0usize
            while ti < sp[stmt_id].then_stmts.len {
                if self.stmt_terminates(sp[stmt_id].then_stmts.ptr[ti]) {
                    then_term = true
                }
                ti = ti + 1usize
            }
            if !then_term {
                return false
            }
            var else_term = false
            var ei = 0usize
            while ei < sp[stmt_id].else_stmts.len {
                if self.stmt_terminates(sp[stmt_id].else_stmts.ptr[ei]) {
                    else_term = true
                }
                ei = ei + 1usize
            }
            return else_term
        }
        return false
    }

    fn get_lvalue_ptr(var self, expr_id: usize) -> i32 {
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            let p_reg = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(p_reg).as_ptr() as str)
            self.ir.push_str(" = getelementptr inbounds i64, ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, i64 0\n")
            return p_reg
        }
        if k == EXPR_INDEX {
            let left_id = ep[expr_id].left
            let right_id = ep[expr_id].right
            var arr_reg = self.emit_expr(left_id)
            if !self.is_expr_ptr(left_id) {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = inttoptr i64 %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(" to ptr\n")
                arr_reg = cvt
            }
            let idx_reg = self.emit_expr(right_id)
            var is_vec = false
            if ep[left_id].kind == EXPR_IDENT {
                let raw_ty = self.get_raw_var_type(ep[left_id].str_val.as_ptr() as str)
                if str_starts_with(raw_ty, "Vec") || str_starts_with(raw_ty, "[]") || str_starts_with(raw_ty, "var []") || str_starts_with(raw_ty, "[") {
                    is_vec = true
                }
            } else if ep[left_id].kind == EXPR_ARRAY_LITERAL {
                is_vec = true
            }
            if is_vec {
                let len_gep = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(len_gep).as_ptr() as str)
                self.ir.push_str(" = getelementptr inbounds i64, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", i64 2\n")
                let len_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(len_reg).as_ptr() as str)
                self.ir.push_str(" = load i64, ptr %")
                self.ir.push_str(int_to_str(len_gep).as_ptr() as str)
                self.ir.push_str(", align 8\n")

                let is_neg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(is_neg).as_ptr() as str)
                self.ir.push_str(" = icmp slt i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str(", 0\n")

                let is_oob = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(is_oob).as_ptr() as str)
                self.ir.push_str(" = icmp sge i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str(", %")
                self.ir.push_str(int_to_str(len_reg).as_ptr() as str)
                self.ir.push_str("\n")

                let bad = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(bad).as_ptr() as str)
                self.ir.push_str(" = or i1 %")
                self.ir.push_str(int_to_str(is_neg).as_ptr() as str)
                self.ir.push_str(", %")
                self.ir.push_str(int_to_str(is_oob).as_ptr() as str)
                self.ir.push_str("\n")

                let p_lbl = self.alloc_label()
                let ok_lbl = self.alloc_label()
                self.ir.push_str("  br i1 %")
                self.ir.push_str(int_to_str(bad).as_ptr() as str)
                self.ir.push_str(", label %panic_bounds_")
                self.ir.push_str(int_to_str(p_lbl).as_ptr() as str)
                self.ir.push_str(", label %ok_bounds_")
                self.ir.push_str(int_to_str(ok_lbl).as_ptr() as str)
                self.ir.push_str("\n")

                self.ir.push_str("panic_bounds_")
                self.ir.push_str(int_to_str(p_lbl).as_ptr() as str)
                self.ir.push_str(":\n")
                self.ir.push_str("  call void @__rad_panic_bounds(i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str(", i64 %")
                self.ir.push_str(int_to_str(len_reg).as_ptr() as str)
                self.ir.push_str(")\n  unreachable\n")

                self.ir.push_str("ok_bounds_")
                self.ir.push_str(int_to_str(ok_lbl).as_ptr() as str)
                self.ir.push_str(":\n")

                let buf_load = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(buf_load).as_ptr() as str)
                self.ir.push_str(" = load ptr, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", align 8\n")
                arr_reg = buf_load
            }
            let gep = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(gep).as_ptr() as str)
            self.ir.push_str(" = getelementptr inbounds i64, ptr %")
            self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
            self.ir.push_str(", i64 %")
            self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
            self.ir.push_str("\n")
            return gep
        }
        return 0
    }

    fn coerce_to_trait_object(var self, val_reg: i32, concrete_struct: str, trait_name: str) -> i32 {
        let obj_p = val_reg
        let fat = self.alloc_ssa()
        self.emit_str("  %")
        self.emit_str(int_to_str(fat).as_ptr() as str)
        self.emit_str(" = call ptr @malloc(i64 16)\n")

        let gep_d = self.alloc_ssa()
        self.emit_str("  %")
        self.emit_str(int_to_str(gep_d).as_ptr() as str)
        self.emit_str(" = getelementptr inbounds ptr, ptr %")
        self.emit_str(int_to_str(fat).as_ptr() as str)
        self.emit_str(", i64 0\n")

        self.emit_str("  store ptr %")
        self.emit_str(int_to_str(obj_p).as_ptr() as str)
        self.emit_str(", ptr %")
        self.emit_str(int_to_str(gep_d).as_ptr() as str)
        self.emit_str(", align 8\n")

        let gep_v = self.alloc_ssa()
        self.emit_str("  %")
        self.emit_str(int_to_str(gep_v).as_ptr() as str)
        self.emit_str(" = getelementptr inbounds ptr, ptr %")
        self.emit_str(int_to_str(fat).as_ptr() as str)
        self.emit_str(", i64 1\n")

        self.emit_str("  store ptr @_vtable_")
        self.emit_str(concrete_struct)
        self.emit_str("_")
        self.emit_str(trait_name)
        self.emit_str(", ptr %")
        self.emit_str(int_to_str(gep_v).as_ptr() as str)
        self.emit_str(", align 8\n")

        return fat
    }

    fn emit_expr(var self, expr_id: usize) -> i32 {
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind

        if k == EXPR_AWAIT {
            return self.emit_expr(ep[expr_id].left)
        }

        if k == EXPR_ARRAY_LITERAL {
            let n_elems = ep[expr_id].args.len
            let elem_bytes = n_elems * 8usize
            var alloc_bytes = elem_bytes
            if alloc_bytes == 0usize { alloc_bytes = 8usize }

            let buf_reg = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(buf_reg).as_ptr() as str)
            self.ir.push_str(" = call ptr @malloc(i64 ")
            self.ir.push_str(int_to_str(alloc_bytes as i32).as_ptr() as str)
            self.ir.push_str(")\n")

            var ei = 0usize
            while ei < n_elems {
                let e_id = ep[expr_id].args.ptr[ei]
                var v_reg = self.emit_expr(e_id)
                let is_fl = self.is_expr_float(e_id)
                let is_pt = self.is_expr_ptr(e_id)
                if is_fl && self.is_expr_f32(e_id) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = fpext float %")
                    self.ir.push_str(int_to_str(v_reg).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    v_reg = cvt
                }
                let gep = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                if is_fl {
                    self.ir.push_str(" = getelementptr inbounds double, ptr %")
                } else if is_pt {
                    self.ir.push_str(" = getelementptr inbounds ptr, ptr %")
                } else {
                    self.ir.push_str(" = getelementptr inbounds i64, ptr %")
                }
                self.ir.push_str(int_to_str(buf_reg).as_ptr() as str)
                self.ir.push_str(", i64 ")
                self.ir.push_str(int_to_str(ei as i32).as_ptr() as str)
                self.ir.push_str("\n")
                if is_fl {
                    self.ir.push_str("  store double %")
                } else if is_pt {
                    self.ir.push_str("  store ptr %")
                } else {
                    self.ir.push_str("  store i64 %")
                }
                self.ir.push_str(int_to_str(v_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(", align 8\n")
                ei = ei + 1usize
            }

            let slice_reg = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(slice_reg).as_ptr() as str)
            self.ir.push_str(" = call ptr @malloc(i64 24)\n")

            self.ir.push_str("  store ptr %")
            self.ir.push_str(int_to_str(buf_reg).as_ptr() as str)
            self.ir.push_str(", ptr %")
            self.ir.push_str(int_to_str(slice_reg).as_ptr() as str)
            self.ir.push_str(", align 8\n")

            let cap_gep = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(cap_gep).as_ptr() as str)
            self.ir.push_str(" = getelementptr inbounds i64, ptr %")
            self.ir.push_str(int_to_str(slice_reg).as_ptr() as str)
            self.ir.push_str(", i64 1\n")
            self.ir.push_str("  store i64 ")
            self.ir.push_str(int_to_str(n_elems as i32).as_ptr() as str)
            self.ir.push_str(", ptr %")
            self.ir.push_str(int_to_str(cap_gep).as_ptr() as str)
            self.ir.push_str(", align 8\n")

            let len_gep = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(len_gep).as_ptr() as str)
            self.ir.push_str(" = getelementptr inbounds i64, ptr %")
            self.ir.push_str(int_to_str(slice_reg).as_ptr() as str)
            self.ir.push_str(", i64 2\n")
            self.ir.push_str("  store i64 ")
            self.ir.push_str(int_to_str(n_elems as i32).as_ptr() as str)
            self.ir.push_str(", ptr %")
            self.ir.push_str(int_to_str(len_gep).as_ptr() as str)
            self.ir.push_str(", align 8\n")

            return slice_reg
        }
        if k == EXPR_FLOAT {
            let res = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(res).as_ptr() as str)
            self.ir.push_str(" = fadd double 0.0, ")
            let f_raw = ep[expr_id].str_val.as_ptr() as str
            self.ir.push_str(f_raw)
            if !str_contains(f_raw, ".") {
                self.ir.push_str(".0")
            }
            self.ir.push_str("\n")
            return res
        }
        if k == EXPR_INT {
            let res = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(res).as_ptr() as str)
            self.ir.push_str(" = add i64 0, ")
            self.ir.push_str(i64_to_str(ep[expr_id].int_val).as_ptr() as str)
            self.ir.push_str("\n")
            return res
        }
        if k == EXPR_STR {
            let s_id = self.intern_string(ep[expr_id].str_val)
            let s_entry = self.strings.ptr[s_id]
            let res = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(res).as_ptr() as str)
            self.ir.push_str(" = getelementptr inbounds [")
            self.ir.push_str(int_to_str(s_entry.byte_len as i32).as_ptr() as str)
            self.ir.push_str(" x i8], ptr @.str.")
            self.ir.push_str(int_to_str(s_id as i32).as_ptr() as str)
            self.ir.push_str(", i32 0, i32 0\n")
            return res
        }
        if k == EXPR_BOOL {
            let res = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(res).as_ptr() as str)
            self.ir.push_str(" = add i64 0, ")
            self.ir.push_str(int_to_str(ep[expr_id].int_val as i32).as_ptr() as str)
            self.ir.push_str("\n")
            return res
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str

            var ci = 0usize
            var is_const = false
            var const_val = 0i64
            while ci < self.parser.const_names.len {
                if str_eq(self.parser.const_names.ptr[ci].as_ptr() as str, vname) {
                    is_const = true
                    const_val = self.parser.const_values.ptr[ci]
                    break
                }
                ci = ci + 1usize
            }

            if is_const {
                let res = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(res).as_ptr() as str)
                self.ir.push_str(" = add i64 0, ")
                self.ir.push_str(i64_to_str(const_val).as_ptr() as str)
                self.ir.push_str("\n")
                return res
            }

            // Semantic check: check if identifier was declared/allocated
            var is_alloc = false
            var ai = 0usize
            while ai < self.allocated_vars.len {
                if str_eq(self.allocated_vars.ptr[ai].as_ptr() as str, vname) {
                    is_alloc = true
                    break
                }
                ai = ai + 1usize
            }

            if !is_alloc {
                var is_func = false
                var fi = 0usize
                while fi < self.parser.functions.len {
                    if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, vname) {
                        is_func = true
                        break
                    }
                    fi = fi + 1usize
                }
                if !is_func && str_starts_with(vname, "__rad_") {
                    is_func = true
                }

                if is_func {
                    let fn_ptr = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(fn_ptr).as_ptr() as str)
                    self.ir.push_str(" = bitcast ptr @")
                    self.ir.push_str(vname)
                    self.ir.push_str(" to ptr\n")
                    return fn_ptr
                }

                var err = String.new()
                err.push_str("unresolved identifier '")
                err.push_str(vname)
                err.push_str("'")
                let sug = self.find_similar_ident(vname)
                if str_len(sug) > 0usize {
                    err.push_str(" (did you mean '")
                    err.push_str(sug)
                    err.push_str("'?)")
                }
                let diag_source_id_1 = self.parser.expr_source_ids.ptr[expr_id]
                self.parser.report_error_span_for_source(diag_source_id_1, "E0020", err.as_ptr() as str, ep[expr_id].expr_line, ep[expr_id].expr_col, str_len(vname) as i64)
            }

            let llvm_ty = self.get_var_type(vname)
            let res = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(res).as_ptr() as str)
            self.ir.push_str(" = load ")
            self.ir.push_str(llvm_ty)
            self.ir.push_str(", ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, align 8\n")
            if str_eq(llvm_ty, "i32") {
                let ext = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(ext).as_ptr() as str)
                self.ir.push_str(" = sext i32 %")
                self.ir.push_str(int_to_str(res).as_ptr() as str)
                self.ir.push_str(" to i64\n")
                return ext
            }
            return res
        }
        if k == EXPR_BINARY {
            let left_id = ep[expr_id].left
            let right_id = ep[expr_id].right
            var left_reg = self.emit_expr(left_id)
            var right_reg = self.emit_expr(right_id)
            let bin_op = ep[expr_id].op
            let l_is_float = self.is_expr_float(left_id)
            let r_is_float = self.is_expr_float(right_id)

            if l_is_float || r_is_float {
                if !l_is_float {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = sitofp i64 %")
                    self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    left_reg = cvt
                } else if self.is_expr_f32(left_id) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = fpext float %")
                    self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    left_reg = cvt
                }
                if !r_is_float {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = sitofp i64 %")
                    self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    right_reg = cvt
                } else if self.is_expr_f32(right_id) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = fpext float %")
                    self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    right_reg = cvt
                }
                if bin_op == TOK_EQEQ || bin_op == TOK_NEQ || bin_op == TOK_LT || bin_op == TOK_LEQ || bin_op == TOK_GT || bin_op == TOK_GEQ {
                    let cmp_reg = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
                    self.ir.push_str(" = ")
                    if bin_op == TOK_EQEQ {
                        self.ir.push_str("fcmp oeq double %")
                    } else if bin_op == TOK_NEQ {
                        self.ir.push_str("fcmp one double %")
                    } else if bin_op == TOK_LT {
                        self.ir.push_str("fcmp olt double %")
                    } else if bin_op == TOK_LEQ {
                        self.ir.push_str("fcmp ole double %")
                    } else if bin_op == TOK_GT {
                        self.ir.push_str("fcmp ogt double %")
                    } else if bin_op == TOK_GEQ {
                        self.ir.push_str("fcmp oge double %")
                    }
                    self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                    self.ir.push_str(", %")
                    self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                    self.ir.push_str("\n")

                    let res = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(res).as_ptr() as str)
                    self.ir.push_str(" = zext i1 %")
                    self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
                    self.ir.push_str(" to i64\n")
                    return res
                } else {
                    let res = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(res).as_ptr() as str)
                    self.ir.push_str(" = ")
                    if bin_op == TOK_PLUS {
                        self.ir.push_str("fadd double %")
                    } else if bin_op == TOK_MINUS {
                        self.ir.push_str("fsub double %")
                    } else if bin_op == TOK_STAR {
                        self.ir.push_str("fmul double %")
                    } else if bin_op == TOK_SLASH {
                        self.ir.push_str("fdiv double %")
                    }
                    self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                    self.ir.push_str(", %")
                    self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                    self.ir.push_str("\n")
                    return res
                }
            }

            if (bin_op == TOK_EQEQ || bin_op == TOK_NEQ) && self.is_expr_ptr(left_id) && self.is_expr_ptr(right_id) {
                let cmp_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
                self.ir.push_str(" = call i32 @strcmp(ptr %")
                self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                self.ir.push_str(")\n")
                let test_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(test_reg).as_ptr() as str)
                if bin_op == TOK_EQEQ {
                    self.ir.push_str(" = icmp eq i32 %")
                } else {
                    self.ir.push_str(" = icmp ne i32 %")
                }
                self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
                self.ir.push_str(", 0\n")
                let res = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(res).as_ptr() as str)
                self.ir.push_str(" = zext i1 %")
                self.ir.push_str(int_to_str(test_reg).as_ptr() as str)
                self.ir.push_str(" to i64\n")
                return res
            }

            if bin_op == TOK_EQEQ || bin_op == TOK_NEQ || bin_op == TOK_LT || bin_op == TOK_LEQ || bin_op == TOK_GT || bin_op == TOK_GEQ {
                if self.is_expr_ptr(left_id) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = ptrtoint ptr %")
                    self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                    self.ir.push_str(" to i64\n")
                    left_reg = cvt
                }
                if self.is_expr_ptr(right_id) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = ptrtoint ptr %")
                    self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                    self.ir.push_str(" to i64\n")
                    right_reg = cvt
                }
                let cmp_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
                self.ir.push_str(" = ")
                if bin_op == TOK_EQEQ {
                    self.ir.push_str("icmp eq i64 %")
                } else if bin_op == TOK_NEQ {
                    self.ir.push_str("icmp ne i64 %")
                } else if bin_op == TOK_LT {
                    self.ir.push_str("icmp slt i64 %")
                } else if bin_op == TOK_LEQ {
                    self.ir.push_str("icmp sle i64 %")
                } else if bin_op == TOK_GT {
                    self.ir.push_str("icmp sgt i64 %")
                } else if bin_op == TOK_GEQ {
                    self.ir.push_str("icmp sge i64 %")
                }
                self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                self.ir.push_str(", %")
                self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                self.ir.push_str("\n")

                let res = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(res).as_ptr() as str)
                self.ir.push_str(" = zext i1 %")
                self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
                self.ir.push_str(" to i64\n")
                return res
            } else {
                if bin_op == TOK_SLASH || bin_op == TOK_PERCENT {
                    let chk_zero = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(chk_zero).as_ptr() as str)
                    self.ir.push_str(" = icmp eq i64 %")
                    self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                    self.ir.push_str(", 0\n")
                    let p_lbl = self.alloc_label()
                    let ok_lbl = self.alloc_label()
                    self.ir.push_str("  br i1 %")
                    self.ir.push_str(int_to_str(chk_zero).as_ptr() as str)
                    self.ir.push_str(", label %panic_div_")
                    self.ir.push_str(int_to_str(p_lbl).as_ptr() as str)
                    self.ir.push_str(", label %ok_div_")
                    self.ir.push_str(int_to_str(ok_lbl).as_ptr() as str)
                    self.ir.push_str("\n")
                    self.ir.push_str("panic_div_")
                    self.ir.push_str(int_to_str(p_lbl).as_ptr() as str)
                    self.ir.push_str(":\n")
                    self.ir.push_str("  call void @__rad_panic_div_zero()\n  unreachable\n")
                    self.ir.push_str("ok_div_")
                    self.ir.push_str(int_to_str(ok_lbl).as_ptr() as str)
                    self.ir.push_str(":\n")
                }

                let res = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(res).as_ptr() as str)
                self.ir.push_str(" = ")

                if bin_op == TOK_PLUS {
                    self.ir.push_str("add nsw i64 %")
                } else if bin_op == TOK_MINUS {
                    self.ir.push_str("sub nsw i64 %")
                } else if bin_op == TOK_STAR {
                    self.ir.push_str("mul nsw i64 %")
                } else if bin_op == TOK_SLASH {
                    self.ir.push_str("sdiv i64 %")
                } else if bin_op == TOK_PERCENT {
                    self.ir.push_str("srem i64 %")
                } else if bin_op == TOK_ANDAND || bin_op == TOK_AMP {
                    self.ir.push_str("and i64 %")
                } else if bin_op == TOK_OROR || bin_op == TOK_PIPE {
                    self.ir.push_str("or i64 %")
                } else if bin_op == TOK_CARET {
                    self.ir.push_str("xor i64 %")
                } else if bin_op == TOK_SHL {
                    self.ir.push_str("shl i64 %")
                } else if bin_op == TOK_SHR {
                    self.ir.push_str("ashr i64 %")
                }

                self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                self.ir.push_str(", %")
                self.ir.push_str(int_to_str(right_reg).as_ptr() as str)
                self.ir.push_str("\n")
                return res
            }
        }
        if k == EXPR_UNARY {
            let sub_id = ep[expr_id].left
            let sub_reg = self.emit_expr(sub_id)
            let un_op = ep[expr_id].op
            let is_f = self.is_expr_float(sub_id)
            let res = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(res).as_ptr() as str)
            if un_op == TOK_MINUS {
                if is_f {
                    self.ir.push_str(" = fsub double 0.0, %")
                } else {
                    self.ir.push_str(" = sub nsw i64 0, %")
                }
                self.ir.push_str(int_to_str(sub_reg).as_ptr() as str)
                self.ir.push_str("\n")
                return res
            } else if un_op == TOK_NOT {
                self.ir.push_str(" = icmp eq i64 %")
                self.ir.push_str(int_to_str(sub_reg).as_ptr() as str)
                self.ir.push_str(", 0\n")
                let ext = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(ext).as_ptr() as str)
                self.ir.push_str(" = zext i1 %")
                self.ir.push_str(int_to_str(res).as_ptr() as str)
                self.ir.push_str(" to i64\n")
                return ext
            } else if un_op == TOK_TILDE {
                self.ir.push_str(" = xor i64 %")
                self.ir.push_str(int_to_str(sub_reg).as_ptr() as str)
                self.ir.push_str(", -1\n")
                return res
            } else {
                return res
            }
        }
        if k == EXPR_CALL {
            let ep_sub = self.parser.exprs.ptr
            let callee_id = ep_sub[expr_id].left
            var callee_name = "unknown"
            if ep_sub[callee_id].kind == EXPR_IDENT {
                let s = ep_sub[callee_id].str_val.as_ptr() as str
                if (s as usize) != 0usize && str_len(s) > 0usize {
                    callee_name = s
                }
            } else if ep_sub[callee_id].kind == EXPR_FIELD_ACCESS {
                let recv_id = ep_sub[callee_id].left
                let type_s = ep_sub[recv_id].str_val.as_ptr() as str
                let member_s = ep_sub[callee_id].field_name.as_ptr() as str
                var full_name = String.new()
                if (type_s as usize) != 0usize && str_len(type_s) > 0usize {
                    full_name.push_str(type_s)
                }
                full_name.push_str("__")
                if (member_s as usize) != 0usize && str_len(member_s) > 0usize {
                    full_name.push_str(member_s)
                }
                full_name.push_byte(0u8)
                callee_name = full_name.as_ptr() as str
            }

            var is_known = false
            var f_k = 0usize
            while f_k < self.parser.functions.len {
                if str_eq(self.parser.functions.ptr[f_k].fn_name.as_ptr() as str, callee_name) {
                    is_known = true
                    break
                }
                f_k = f_k + 1usize
            }
            if !is_known {
                if str_eq(callee_name, "puts") || str_eq(callee_name, "printf") || str_eq(callee_name, "println") || str_eq(callee_name, "print") ||
                   str_eq(callee_name, "malloc") || str_eq(callee_name, "free") || str_eq(callee_name, "realloc") ||
                   str_eq(callee_name, "exit") || str_eq(callee_name, "fopen") || str_eq(callee_name, "fclose") ||
                   str_eq(callee_name, "fread") || str_eq(callee_name, "fwrite") || str_eq(callee_name, "fseek") ||
                   str_eq(callee_name, "ftell") || str_eq(callee_name, "getenv") || str_eq(callee_name, "strcmp") ||
                   str_eq(callee_name, "isatty") || str_eq(callee_name, "input") ||
                   str_eq(callee_name, "dprintf") || str_eq(callee_name, "eprintln") || str_eq(callee_name, "system") ||
                   str_eq(callee_name, "sqrt") || str_eq(callee_name, "remove") || str_starts_with(callee_name, "syscall") || self.is_struct_name(callee_name) || str_eq(callee_name, "swap") ||
                   str_eq(callee_name, "atexit") || str_starts_with(callee_name, "__rad_") {
                    is_known = true
                }
            }
            if !is_known {
                var err = String.new()
                err.push_str("unresolved identifier '")
                err.push_str(callee_name)
                err.push_str("'")
                let sug = self.find_similar_ident(callee_name)
                if str_len(sug) > 0usize {
                    err.push_str(" (did you mean '")
                    err.push_str(sug)
                    err.push_str("'?)")
                }
                let diag_source_id_2 = self.parser.expr_source_ids.ptr[callee_id]
                self.parser.report_error_span_for_source(diag_source_id_2, "E0020", err.as_ptr() as str, ep[callee_id].expr_line, ep[callee_id].expr_col, str_len(callee_name) as i64)
            }

            if str_eq(callee_name, "swap") {
                if ep_sub[expr_id].args.len == 2usize {
                    let a0 = ep_sub[expr_id].args.ptr[0usize]
                    let a1 = ep_sub[expr_id].args.ptr[1usize]
                    let p0 = self.get_lvalue_ptr(a0)
                    let p1 = self.get_lvalue_ptr(a1)
                    let v0 = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(v0).as_ptr() as str)
                    self.ir.push_str(" = load i64, ptr %")
                    self.ir.push_str(int_to_str(p0).as_ptr() as str)
                    self.ir.push_str(", align 8\n")

                    let v1 = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(v1).as_ptr() as str)
                    self.ir.push_str(" = load i64, ptr %")
                    self.ir.push_str(int_to_str(p1).as_ptr() as str)
                    self.ir.push_str(", align 8\n")

                    self.ir.push_str("  store i64 %")
                    self.ir.push_str(int_to_str(v1).as_ptr() as str)
                    self.ir.push_str(", ptr %")
                    self.ir.push_str(int_to_str(p0).as_ptr() as str)
                    self.ir.push_str(", align 8\n")

                    self.ir.push_str("  store i64 %")
                    self.ir.push_str(int_to_str(v0).as_ptr() as str)
                    self.ir.push_str(", ptr %")
                    self.ir.push_str(int_to_str(p1).as_ptr() as str)
                    self.ir.push_str(", align 8\n")
                    return 0
                }
            }

            if str_eq(callee_name, "input") {
                var p_reg: i32 = 0
                if ep_sub[expr_id].args.len > 0usize {
                    let p_expr = ep_sub[expr_id].args.ptr[0usize]
                    let raw_p = self.emit_expr(p_expr)
                    if self.is_expr_string_obj(p_expr) {
                        let buf_r = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(buf_r).as_ptr() as str)
                        self.emit_str(" = call ptr @as_ptr(ptr %")
                        self.emit_str(int_to_str(raw_p).as_ptr() as str)
                        self.emit_str(")\n")
                        p_reg = buf_r
                    } else if !self.is_expr_ptr(p_expr) {
                        let cvt = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(cvt).as_ptr() as str)
                        self.emit_str(" = inttoptr i64 %")
                        self.emit_str(int_to_str(raw_p).as_ptr() as str)
                        self.emit_str(" to ptr\n")
                        p_reg = cvt
                    } else {
                        p_reg = raw_p
                    }
                }
                let in_res = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(in_res).as_ptr() as str)
                if p_reg != 0 {
                    self.emit_str(" = call ptr @input(ptr %")
                    self.emit_str(int_to_str(p_reg).as_ptr() as str)
                    self.emit_str(")\n")
                } else {
                    self.emit_str(" = call ptr @input(ptr null)\n")
                }
                return in_res
            }

            if self.is_struct_name(callee_name) {
                var s_def_idx = 0usize
                var found_sdef = false
                while s_def_idx < self.parser.structs.len {
                    if self.match_struct_name(self.parser.structs.ptr[s_def_idx].struct_name.as_ptr() as str, callee_name) {
                        found_sdef = true
                        break
                    }
                    s_def_idx = s_def_idx + 1usize
                }

                var arg_regs = Vec.new()
                let args_len = ep_sub[expr_id].args.len
                var i = 0usize
                while i < args_len {
                    let a_expr = ep_sub[expr_id].args.ptr[i]
                    let r = self.emit_expr(a_expr)
                    arg_regs.push(r)
                    i = i + 1usize
                }

                let num_fields = arg_regs.len
                let size_bytes = num_fields * 8usize
                let obj_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(obj_reg).as_ptr() as str)
                self.emit_str(" = call ptr @malloc(i64 ")
                self.emit_str(int_to_str(size_bytes as i32).as_ptr() as str)
                self.emit_str(")\n")

                var fi = 0usize
                while fi < arg_regs.len {
                    let gep = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(gep).as_ptr() as str)
                    self.emit_str(" = getelementptr inbounds i64, ptr %")
                    self.emit_str(int_to_str(obj_reg).as_ptr() as str)
                    self.emit_str(", i64 ")
                    self.emit_str(int_to_str(fi as i32).as_ptr() as str)
                    self.emit_str("\n")

                    var field_is_flt = self.is_expr_float(ep_sub[expr_id].args.ptr[fi])
                    if found_sdef && fi < self.parser.structs.ptr[s_def_idx].field_types.len {
                        let fty = self.parser.structs.ptr[s_def_idx].field_types.ptr[fi].as_ptr() as str
                        if str_eq(fty, "f64") || str_eq(fty, "f32") {
                            field_is_flt = true
                        }
                    }

                    var val_reg = arg_regs.ptr[fi]
                    if field_is_flt {
                        if !self.is_expr_float(ep_sub[expr_id].args.ptr[fi]) {
                            let cvt = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(cvt).as_ptr() as str)
                            self.emit_str(" = sitofp i64 %")
                            self.emit_str(int_to_str(val_reg).as_ptr() as str)
                            self.emit_str(" to double\n")
                            val_reg = cvt
                        } else if self.is_expr_f32(ep_sub[expr_id].args.ptr[fi]) {
                            let cvt = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(cvt).as_ptr() as str)
                            self.emit_str(" = fpext float %")
                            self.emit_str(int_to_str(val_reg).as_ptr() as str)
                            self.emit_str(" to double\n")
                            val_reg = cvt
                        }
                        self.emit_str("  store double %")
                        self.emit_str(int_to_str(val_reg).as_ptr() as str)
                        self.emit_str(", ptr %")
                        self.emit_str(int_to_str(gep).as_ptr() as str)
                        self.emit_str(", align 8\n")
                    } else {
                        let a_is_ptr = self.is_expr_ptr(ep_sub[expr_id].args.ptr[fi])
                        if a_is_ptr {
                            let cvt = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(cvt).as_ptr() as str)
                            self.emit_str(" = ptrtoint ptr %")
                            self.emit_str(int_to_str(val_reg).as_ptr() as str)
                            self.emit_str(" to i64\n")
                            val_reg = cvt
                        }
                        self.emit_str("  store i64 %")
                        self.emit_str(int_to_str(val_reg).as_ptr() as str)
                        self.emit_str(", ptr %")
                        self.emit_str(int_to_str(gep).as_ptr() as str)
                        self.emit_str(", align 8\n")
                    }
                    fi = fi + 1usize
                }
                return obj_reg
            }

            if str_starts_with(callee_name, "syscall") {
                var s_arg_regs = Vec.new()
                let s_args_len = ep_sub[expr_id].args.len
                var si = 0usize
                while si < s_args_len {
                    let a_expr = ep_sub[expr_id].args.ptr[si]
                    var r = self.emit_expr(a_expr)
                    if self.is_expr_ptr(a_expr) {
                        let cvt = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(cvt).as_ptr() as str)
                        self.emit_str(" = ptrtoint ptr %")
                        self.emit_str(int_to_str(r).as_ptr() as str)
                        self.emit_str(" to i64\n")
                        r = cvt
                    }
                    s_arg_regs.push(r)
                    si = si + 1usize
                }

                let ret_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(ret_reg).as_ptr() as str)
                self.emit_str(" = call i64 asm sideeffect ")

                let is_arm = str_starts_with(self.target.as_ptr() as str, "aarch64")
                if is_arm {
                    self.emit_str("\"svc #0\", \"={x0},{x8}")
                    if s_arg_regs.len > 1usize { self.emit_str(",{x0}") }
                    if s_arg_regs.len > 2usize { self.emit_str(",{x1}") }
                    if s_arg_regs.len > 3usize { self.emit_str(",{x2}") }
                    if s_arg_regs.len > 4usize { self.emit_str(",{x3}") }
                    if s_arg_regs.len > 5usize { self.emit_str(",{x4}") }
                    if s_arg_regs.len > 6usize { self.emit_str(",{x5}") }
                    self.emit_str(",~{memory}\"(")
                } else {
                    self.emit_str("\"syscall\", \"={rax},{rax}")
                    if s_arg_regs.len > 1usize { self.emit_str(",{rdi}") }
                    if s_arg_regs.len > 2usize { self.emit_str(",{rsi}") }
                    if s_arg_regs.len > 3usize { self.emit_str(",{rdx}") }
                    if s_arg_regs.len > 4usize { self.emit_str(",{r10}") }
                    if s_arg_regs.len > 5usize { self.emit_str(",{r8}") }
                    if s_arg_regs.len > 6usize { self.emit_str(",{r9}") }
                    self.emit_str(",~{rcx},~{r11},~{memory}\"(")
                }

                var sj = 0usize
                while sj < s_arg_regs.len {
                    if sj > 0usize { self.emit_str(", ") }
                    self.emit_str("i64 %")
                    self.emit_str(int_to_str(s_arg_regs.ptr[sj]).as_ptr() as str)
                    sj = sj + 1usize
                }
                self.emit_str(")\n")
                return ret_reg
            }

            if str_eq(callee_name, "printf") && ep_sub[expr_id].args.len > 0usize {
                let fmt_arg = ep_sub[expr_id].args.ptr[0usize]
                if ep_sub[fmt_arg].kind == EXPR_STR {
                    let raw_s = ep_sub[fmt_arg].str_val.as_ptr() as str
                    let p_raw = raw_s as *raw u8
                    let raw_len = str_len(raw_s)
                    var conv_fmt = String.new()
                    var ci = 0usize
                    while ci < raw_len {
                        if p_raw[ci] == 37u8 && ci + 1usize < raw_len && (p_raw[ci + 1usize] == 100u8 || p_raw[ci + 1usize] == 105u8) {
                            conv_fmt.push_byte(37u8) // '%'
                            conv_fmt.push_byte(108u8) // 'l'
                            conv_fmt.push_byte(108u8) // 'l'
                            conv_fmt.push_byte(100u8) // 'd'
                            ci = ci + 2usize
                        } else {
                            conv_fmt.push_byte(p_raw[ci])
                            ci = ci + 1usize
                        }
                    }
                    conv_fmt.push_byte(0u8)
                    ep_sub[fmt_arg].str_val = conv_fmt
                }
            }

            var arg_regs = Vec.new()
            let args_len = ep_sub[expr_id].args.len
            var i = 0usize
            while i < args_len {
                let a_expr = ep_sub[expr_id].args.ptr[i]
                var r = self.emit_expr(a_expr)
                let raw_pty = self.get_raw_func_param_type(callee_name, i)
                if str_starts_with(raw_pty, "dyn ") {
                    let target_trait = (raw_pty as usize + 4usize) as str
                    var a_struct = self.get_expr_struct_name(a_expr)
                    if str_len(a_struct) == 0usize && ep_sub[a_expr].kind == EXPR_IDENT {
                        a_struct = self.get_raw_var_type(ep_sub[a_expr].str_val.as_ptr() as str)
                    }
                    if str_len(a_struct) > 0usize && !str_starts_with(a_struct, "dyn ") {
                        r = self.coerce_to_trait_object(r, a_struct, target_trait)
                    }
                }
                var pty: str = self.get_func_param_type(callee_name, i)
                var a_is_ptr = self.is_expr_ptr(a_expr)
                if str_eq(callee_name, "println") || str_eq(callee_name, "print") {
                    if self.is_expr_string_obj(a_expr) {
                        let str_buf = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(str_buf).as_ptr() as str)
                        self.emit_str(" = call ptr @as_ptr(ptr %")
                        self.emit_str(int_to_str(r).as_ptr() as str)
                        self.emit_str(")\n")
                        r = str_buf
                        pty = "ptr"
                        a_is_ptr = true
                    } else if a_is_ptr {
                        pty = "ptr"
                    } else if self.is_expr_float(a_expr) {
                        pty = "double"
                    } else {
                        pty = "i64"
                    }
                } else if str_eq(callee_name, "printf") && i > 0usize {
                    if self.is_expr_string_obj(a_expr) {
                        let str_buf = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(str_buf).as_ptr() as str)
                        self.emit_str(" = call ptr @as_ptr(ptr %")
                        self.emit_str(int_to_str(r).as_ptr() as str)
                        self.emit_str(")\n")
                        r = str_buf
                        pty = "ptr"
                        a_is_ptr = true
                    } else if a_is_ptr {
                        pty = "ptr"
                    } else if self.is_expr_float(a_expr) {
                        pty = "double"
                    } else {
                        pty = "i64"
                    }
                }
                if str_eq(pty, "ptr") && !a_is_ptr {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = inttoptr i64 %")
                    self.emit_str(int_to_str(r).as_ptr() as str)
                    self.emit_str(" to ptr\n")
                    r = cvt
                } else if str_eq(pty, "i64") && a_is_ptr {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = ptrtoint ptr %")
                    self.emit_str(int_to_str(r).as_ptr() as str)
                    self.emit_str(" to i64\n")
                    r = cvt
                } else if str_eq(pty, "i32") && !a_is_ptr {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = trunc i64 %")
                    self.emit_str(int_to_str(r).as_ptr() as str)
                    self.emit_str(" to i32\n")
                    r = cvt
                } else if (str_eq(pty, "i8") || str_eq(pty, "i16")) && !a_is_ptr {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = trunc i64 %")
                    self.emit_str(int_to_str(r).as_ptr() as str)
                    self.emit_str(" to ")
                    self.emit_str(pty)
                    self.emit_str("\n")
                    r = cvt
                } else if str_eq(pty, "float") {
                    if !self.is_expr_float(a_expr) {
                        let cvt = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(cvt).as_ptr() as str)
                        self.emit_str(" = sitofp i64 %")
                        self.emit_str(int_to_str(r).as_ptr() as str)
                        self.emit_str(" to float\n")
                        r = cvt
                    } else if !self.is_expr_f32(a_expr) {
                        let cvt = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(cvt).as_ptr() as str)
                        self.emit_str(" = fptrunc double %")
                        self.emit_str(int_to_str(r).as_ptr() as str)
                        self.emit_str(" to float\n")
                        r = cvt
                    }
                } else if str_eq(pty, "double") {
                    if !self.is_expr_float(a_expr) {
                        let cvt = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(cvt).as_ptr() as str)
                        self.emit_str(" = sitofp i64 %")
                        self.emit_str(int_to_str(r).as_ptr() as str)
                        self.emit_str(" to double\n")
                        r = cvt
                    } else if self.is_expr_f32(a_expr) {
                        let cvt = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(cvt).as_ptr() as str)
                        self.emit_str(" = fpext float %")
                        self.emit_str(int_to_str(r).as_ptr() as str)
                        self.emit_str(" to double\n")
                        r = cvt
                    }
                }
                arg_regs.push(r)
                i = i + 1usize
            }

            var fmt_gep_reg = 0
            if (str_eq(callee_name, "println") || str_eq(callee_name, "print")) && arg_regs.len > 1usize {
                let fmt_expr = ep_sub[expr_id].args.ptr[0usize]
                var raw_fmt = ""
                if self.parser.exprs.ptr[fmt_expr].kind == EXPR_STR {
                    raw_fmt = self.parser.exprs.ptr[fmt_expr].str_val.as_ptr() as str
                }
                let p_raw: *raw u8 = raw_fmt as *raw u8
                let raw_len = str_len(raw_fmt)
                var final_fmt = String.new()
                var ri = 0usize
                var arg_idx = 1usize
                while ri < raw_len {
                    if p_raw[ri] == 123u8 && ri + 1usize < raw_len && p_raw[ri + 1usize] == 125u8 {
                        if arg_idx < ep_sub[expr_id].args.len {
                            let curr_arg = ep_sub[expr_id].args.ptr[arg_idx]
                            if self.is_expr_ptr(curr_arg) {
                                final_fmt.push_byte(37u8) // '%'
                                final_fmt.push_byte(115u8) // 's'
                            } else if self.is_expr_float(curr_arg) {
                                final_fmt.push_byte(37u8) // '%'
                                final_fmt.push_byte(102u8) // 'f'
                            } else {
                                final_fmt.push_byte(37u8) // '%'
                                final_fmt.push_byte(108u8) // 'l'
                                final_fmt.push_byte(108u8) // 'l'
                                final_fmt.push_byte(100u8) // 'd'
                            }
                            arg_idx = arg_idx + 1usize
                        }
                        ri = ri + 2usize
                    } else {
                        final_fmt.push_byte(p_raw[ri])
                        ri = ri + 1usize
                    }
                }
                if str_eq(callee_name, "println") {
                    final_fmt.push_byte(10u8) // '\n'
                }
                final_fmt.push_byte(0u8)  // '\0'

                let fmt_id = self.intern_string(final_fmt)
                let fmt_entry = self.strings.ptr[fmt_id]
                fmt_gep_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(fmt_gep_reg).as_ptr() as str)
                self.emit_str(" = getelementptr inbounds [")
                self.emit_str(int_to_str(fmt_entry.byte_len as i32).as_ptr() as str)
                self.emit_str(" x i8], ptr @.str.")
                self.emit_str(int_to_str(fmt_id as i32).as_ptr() as str)
                self.emit_str(", i32 0, i32 0\n")
            }

            let call_ret_ty = self.get_func_ret_type(callee_name)
            if str_eq(call_ret_ty, "void") {
                if (str_eq(callee_name, "println") || str_eq(callee_name, "print")) && fmt_gep_reg != 0 {
                    self.emit_str("  call i32 (ptr, ...) @printf(ptr %")
                    self.emit_str(int_to_str(fmt_gep_reg).as_ptr() as str)
                    var pj = 1usize
                    while pj < arg_regs.len {
                        let curr_arg = ep_sub[expr_id].args.ptr[pj]
                        if self.is_expr_ptr(curr_arg) {
                            self.emit_str(", ptr %")
                        } else if self.is_expr_float(curr_arg) {
                            self.emit_str(", double %")
                        } else {
                            self.emit_str(", i64 %")
                        }
                        self.emit_str(int_to_str(arg_regs.ptr[pj]).as_ptr() as str)
                        pj = pj + 1usize
                    }
                    self.emit_str(")\n")
                    if str_eq(callee_name, "print") {
                        let flush_reg = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(flush_reg).as_ptr() as str)
                        self.emit_str(" = call i32 @fflush(ptr null)\n")
                    }
                } else if str_eq(callee_name, "println") {
                    if arg_regs.len > 0usize {
                        let first_arg = ep_sub[expr_id].args.ptr[0usize]
                        if self.is_expr_float(first_arg) {
                            self.emit_str("  call i32 (ptr, ...) @printf(ptr @.fprint_fmt, double %")
                            self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                            self.emit_str(")\n")
                        } else if self.is_expr_ptr(first_arg) {
                            self.emit_str("  call i32 @puts(ptr %")
                            self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                            self.emit_str(")\n")
                        } else {
                            self.emit_str("  call i32 (ptr, ...) @printf(ptr @.iprint_fmt, i64 %")
                            self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                            self.emit_str(")\n")
                        }
                    } else {
                        self.emit_str("  call i32 @puts(ptr @.empty_str)\n")
                    }
                } else if str_eq(callee_name, "print") {
                    if arg_regs.len > 0usize {
                        let first_arg = ep_sub[expr_id].args.ptr[0usize]
                        if self.is_expr_float(first_arg) {
                            self.emit_str("  call i32 (ptr, ...) @printf(ptr @.fprint_nonl_fmt, double %")
                            self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                            self.emit_str(")\n")
                        } else if self.is_expr_ptr(first_arg) {
                            self.emit_str("  call i32 (ptr, ...) @printf(ptr @.sprint_nonl_fmt, ptr %")
                            self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                            self.emit_str(")\n")
                        } else {
                            self.emit_str("  call i32 (ptr, ...) @printf(ptr @.iprint_nonl_fmt, i64 %")
                            self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                            self.emit_str(")\n")
                        }
                        let flush_reg = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(flush_reg).as_ptr() as str)
                        self.emit_str(" = call i32 @fflush(ptr null)\n")
                    } else {
                        let flush_reg = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(flush_reg).as_ptr() as str)
                        self.emit_str(" = call i32 @fflush(ptr null)\n")
                    }
                } else {
                    self.emit_str("  call void @")
                    self.emit_str(callee_name)
                    self.emit_str("(")
                    var j = 0usize
                    while j < arg_regs.len {
                        if j > 0usize { self.emit_str(", ") }
                        let pty = self.get_func_param_type(callee_name, j)
                        self.emit_str(pty)
                        self.emit_str(" %")
                        self.emit_str(int_to_str(arg_regs.ptr[j]).as_ptr() as str)
                        j = j + 1usize
                    }
                    self.emit_str(")\n")
                }
                return 0
            }
            let res = self.alloc_ssa()
            self.emit_str("  %")
            self.emit_str(int_to_str(res).as_ptr() as str)
            self.emit_str(" = call ")
            self.emit_str(call_ret_ty)
            if (str_eq(callee_name, "println") || str_eq(callee_name, "print")) && fmt_gep_reg != 0 {
                self.emit_str(" (ptr, ...) @printf(ptr %")
                self.emit_str(int_to_str(fmt_gep_reg).as_ptr() as str)
                var pj = 1usize
                while pj < arg_regs.len {
                    let curr_arg = ep_sub[expr_id].args.ptr[pj]
                    if self.is_expr_ptr(curr_arg) {
                        self.emit_str(", ptr %")
                    } else if self.is_expr_float(curr_arg) {
                        self.emit_str(", double %")
                    } else {
                        self.emit_str(", i64 %")
                    }
                    self.emit_str(int_to_str(arg_regs.ptr[pj]).as_ptr() as str)
                    pj = pj + 1usize
                }
                self.emit_str(")\n")
                if str_eq(callee_name, "print") {
                    let flush_reg = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(flush_reg).as_ptr() as str)
                    self.emit_str(" = call i32 @fflush(ptr null)\n")
                }
            } else if str_eq(callee_name, "printf") {
                self.emit_str(" (ptr, ...) @printf(ptr %")
                if arg_regs.len > 0usize {
                    self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                }
                var pj = 1usize
                while pj < arg_regs.len {
                    let curr_arg = ep_sub[expr_id].args.ptr[pj]
                    if self.is_expr_ptr(curr_arg) {
                        self.emit_str(", ptr %")
                    } else if self.is_expr_float(curr_arg) {
                        self.emit_str(", double %")
                    } else {
                        self.emit_str(", i64 %")
                    }
                    self.emit_str(int_to_str(arg_regs.ptr[pj]).as_ptr() as str)
                    pj = pj + 1usize
                }
                self.emit_str(")\n")
            } else if str_eq(callee_name, "println") {
                if arg_regs.len > 0usize {
                    let first_arg = ep_sub[expr_id].args.ptr[0usize]
                    if self.is_expr_float(first_arg) {
                        self.emit_str(" (ptr, ...) @printf(ptr @.fprint_fmt, double %")
                        self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                        self.emit_str(")\n")
                    } else if self.is_expr_ptr(first_arg) {
                        self.emit_str(" @puts(ptr %")
                        self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                        self.emit_str(")\n")
                    } else {
                        self.emit_str(" (ptr, ...) @printf(ptr @.iprint_fmt, i64 %")
                        self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                        self.emit_str(")\n")
                    }
                } else {
                    self.emit_str(" @puts(ptr @.empty_str)\n")
                }
            } else if str_eq(callee_name, "print") {
                if arg_regs.len > 0usize {
                    let first_arg = ep_sub[expr_id].args.ptr[0usize]
                    if self.is_expr_float(first_arg) {
                        self.emit_str(" (ptr, ...) @printf(ptr @.fprint_nonl_fmt, double %")
                        self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                        self.emit_str(")\n")
                    } else if self.is_expr_ptr(first_arg) {
                        self.emit_str(" (ptr, ...) @printf(ptr @.sprint_nonl_fmt, ptr %")
                        self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                        self.emit_str(")\n")
                    } else {
                        self.emit_str(" (ptr, ...) @printf(ptr @.iprint_nonl_fmt, i64 %")
                        self.emit_str(int_to_str(arg_regs.ptr[0usize]).as_ptr() as str)
                        self.emit_str(")\n")
                    }
                    let flush_reg = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(flush_reg).as_ptr() as str)
                    self.emit_str(" = call i32 @fflush(ptr null)\n")
                } else {
                    let flush_reg = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(flush_reg).as_ptr() as str)
                    self.emit_str(" = call i32 @fflush(ptr null)\n")
                }
            } else {
                self.emit_str(" @")
                self.emit_str(callee_name)
                self.emit_str("(")
                var j = 0usize
                while j < arg_regs.len {
                    if j > 0usize { self.emit_str(", ") }
                    let pty = self.get_func_param_type(callee_name, j)
                    self.emit_str(pty)
                    self.emit_str(" %")
                    self.emit_str(int_to_str(arg_regs.ptr[j]).as_ptr() as str)
                    j = j + 1usize
                }
                self.emit_str(")\n")
            }
            if str_eq(call_ret_ty, "i32") {
                let ext = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(ext).as_ptr() as str)
                self.emit_str(" = sext i32 %")
                self.emit_str(int_to_str(res).as_ptr() as str)
                self.emit_str(" to i64\n")
                return ext
            }
            if str_eq(call_ret_ty, "i8") || str_eq(call_ret_ty, "i16") {
                let ext = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(ext).as_ptr() as str)
                self.emit_str(" = sext ")
                self.emit_str(call_ret_ty)
                self.emit_str(" %")
                self.emit_str(int_to_str(res).as_ptr() as str)
                self.emit_str(" to i64\n")
                return ext
            }
            return res
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[expr_id].left
            let member = ep[expr_id].str_val.as_ptr() as str
            var is_static = false
            if ep[recv_id].kind == EXPR_IDENT {
                let p_recv: *raw u8 = ep[recv_id].str_val.as_ptr()
                if (p_recv as usize) != 0usize && (p_recv[0usize] >= 65u8 && p_recv[0usize] <= 90u8) {
                    is_static = true
                } else {
                    let vname = ep[recv_id].str_val.as_ptr() as str
                    let is_var = str_len(self.get_raw_var_type(vname)) > 0usize
                    if !is_var {
                        is_static = true
                    }
                }
            }

            var callee_name: str = (member as usize) as str
            if is_static {
                let type_s = ep[recv_id].str_val.as_ptr() as str
                if str_eq(type_s, "Vec") && str_eq(member, "from") {
                    callee_name = "vec_from"
                }
                let clean_type_s = self.clean_type_name(type_s)
                if !str_eq(clean_type_s, "String") && !str_eq(clean_type_s, "Vec") {
                    var mangled = String.new()
                    mangled.push_str(type_s)
                    mangled.push_str("__")
                    mangled.push_str(member)
                    mangled.push_byte(0u8)
                    let m_str = mangled.as_ptr() as str
                    var found_static = false
                    var fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, m_str) {
                            callee_name = m_str
                            found_static = true
                            break
                        }
                        fi = fi + 1usize
                    }
                    if !found_static {
                        let base_ty = self.clean_type_name(type_s)
                        if !str_eq(base_ty, type_s) && str_len(base_ty) > 0usize {
                            var b_mangled = String.new()
                            b_mangled.push_str(base_ty)
                            b_mangled.push_str("__")
                            b_mangled.push_str(member)
                            b_mangled.push_byte(0u8)
                            let bm_str = b_mangled.as_ptr() as str
                            fi = 0usize
                            while fi < self.parser.functions.len {
                                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, bm_str) {
                                    callee_name = bm_str
                                    break
                                }
                                fi = fi + 1usize
                            }
                        }
                    }
                }
            } else {
                var raw_ty = self.get_expr_struct_name(recv_id)
                if str_len(raw_ty) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                    let vname = ep[recv_id].str_val.as_ptr() as str
                    let vty = self.get_raw_var_type(vname)
                    if self.is_struct_name(vty) {
                        raw_ty = vty
                    }
                }
                if str_starts_with(raw_ty, "dyn ") {
                    let trait_name = (raw_ty as usize + 4usize) as str
                    var tr_idx = 0usize
                    var found_tr = false
                    while tr_idx < self.parser.traits.len {
                        if str_eq(self.parser.traits.ptr[tr_idx].trait_name.as_ptr() as str, trait_name) {
                            found_tr = true
                            break
                        }
                        tr_idx = tr_idx + 1usize
                    }
                    if found_tr {
                        let tr_def = self.parser.traits.ptr[tr_idx]
                        var m_idx = 0usize
                        var found_m = false
                        while m_idx < tr_def.methods.len {
                            if str_eq(tr_def.methods.ptr[m_idx].method_name.as_ptr() as str, member) {
                                found_m = true
                                break
                            }
                            m_idx = m_idx + 1usize
                        }
                        if found_m {
                            let m_def = tr_def.methods.ptr[m_idx]
                            let ret_llvm = self.emit_llvm_type(m_def.ret_type.as_ptr() as str)
                            var fat_reg = self.emit_expr(recv_id)
                            if !self.is_expr_ptr(recv_id) {
                                let cvt = self.alloc_ssa()
                                self.emit_str("  %")
                                self.emit_str(int_to_str(cvt).as_ptr() as str)
                                self.emit_str(" = inttoptr i64 %")
                                self.emit_str(int_to_str(fat_reg).as_ptr() as str)
                                self.emit_str(" to ptr\n")
                                fat_reg = cvt
                            }

                            // Load data_ptr
                            let gep_d = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(gep_d).as_ptr() as str)
                            self.emit_str(" = getelementptr inbounds ptr, ptr %")
                            self.emit_str(int_to_str(fat_reg).as_ptr() as str)
                            self.emit_str(", i64 0\n")
                            let data_ptr = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(data_ptr).as_ptr() as str)
                            self.emit_str(" = load ptr, ptr %")
                            self.emit_str(int_to_str(gep_d).as_ptr() as str)
                            self.emit_str(", align 8\n")

                            // Load vtable_ptr
                            let gep_v = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(gep_v).as_ptr() as str)
                            self.emit_str(" = getelementptr inbounds ptr, ptr %")
                            self.emit_str(int_to_str(fat_reg).as_ptr() as str)
                            self.emit_str(", i64 1\n")
                            let vt_ptr = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(vt_ptr).as_ptr() as str)
                            self.emit_str(" = load ptr, ptr %")
                            self.emit_str(int_to_str(gep_v).as_ptr() as str)
                            self.emit_str(", align 8\n")

                            // Load fn_ptr
                            let gep_fn = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(gep_fn).as_ptr() as str)
                            self.emit_str(" = getelementptr inbounds ptr, ptr %")
                            self.emit_str(int_to_str(vt_ptr).as_ptr() as str)
                            self.emit_str(", i64 ")
                            self.emit_str(int_to_str(m_idx as i32).as_ptr() as str)
                            self.emit_str("\n")
                            let fn_ptr = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(fn_ptr).as_ptr() as str)
                            self.emit_str(" = load ptr, ptr %")
                            self.emit_str(int_to_str(gep_fn).as_ptr() as str)
                            self.emit_str(", align 8\n")

                            var call_arg_regs = Vec.new()
                            var call_arg_types = Vec.new()
                            call_arg_regs.push(data_ptr)
                            call_arg_types.push("ptr")

                            var ai = 0usize
                            while ai < ep[expr_id].args.len {
                                let a_expr = ep[expr_id].args.ptr[ai]
                                let ar = self.emit_expr(a_expr)
                                var aty = "i64"
                                if self.is_expr_float(a_expr) {
                                    aty = "double"
                                } else if self.is_expr_ptr(a_expr) {
                                    aty = "ptr"
                                }
                                call_arg_regs.push(ar)
                                call_arg_types.push(aty)
                                ai = ai + 1usize
                            }

                            if str_eq(ret_llvm, "void") {
                                self.emit_str("  call void %")
                                self.emit_str(int_to_str(fn_ptr).as_ptr() as str)
                                self.emit_str("(")
                                var ki = 0usize
                                while ki < call_arg_regs.len {
                                    if ki > 0usize { self.emit_str(", ") }
                                    self.emit_str(call_arg_types.ptr[ki])
                                    self.emit_str(" %")
                                    self.emit_str(int_to_str(call_arg_regs.ptr[ki]).as_ptr() as str)
                                    ki = ki + 1usize
                                }
                                self.emit_str(")\n")
                                return 0
                            }

                            let res = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(res).as_ptr() as str)
                            self.emit_str(" = call ")
                            self.emit_str(ret_llvm)
                            self.emit_str(" %")
                            self.emit_str(int_to_str(fn_ptr).as_ptr() as str)
                            self.emit_str("(")
                            var ki = 0usize
                            while ki < call_arg_regs.len {
                                if ki > 0usize { self.emit_str(", ") }
                                self.emit_str(call_arg_types.ptr[ki])
                                self.emit_str(" %")
                                self.emit_str(int_to_str(call_arg_regs.ptr[ki]).as_ptr() as str)
                                ki = ki + 1usize
                            }
                            self.emit_str(")\n")
                            return res
                        }
                    }
                }
                var found_mangled = false
                let clean_raw = self.clean_type_name(raw_ty)
                if str_len(raw_ty) > 0usize && !str_eq(clean_raw, "String") && !str_eq(clean_raw, "Vec") {
                    var mangled = String.new()
                    mangled.push_str(raw_ty)
                    mangled.push_str("__")
                    mangled.push_str(member)
                    mangled.push_byte(0u8)
                    let m_str = mangled.as_ptr() as str
                    var fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, m_str) {
                            callee_name = m_str
                            found_mangled = true
                            break
                        }
                        fi = fi + 1usize
                    }
                    if !found_mangled {
                        let base_ty = self.clean_type_name(raw_ty)
                        if !str_eq(base_ty, raw_ty) && str_len(base_ty) > 0usize {
                            var b_mangled = String.new()
                            b_mangled.push_str(base_ty)
                            b_mangled.push_str("__")
                            b_mangled.push_str(member)
                            b_mangled.push_byte(0u8)
                            let bm_str = b_mangled.as_ptr() as str
                            fi = 0usize
                            while fi < self.parser.functions.len {
                                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, bm_str) {
                                    callee_name = bm_str
                                    found_mangled = true
                                    break
                                }
                                fi = fi + 1usize
                            }
                        }
                    }
                }
                if !found_mangled {
                    var standalone_found = false
                    var fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, member) {
                            standalone_found = true
                            break
                        }
                        fi = fi + 1usize
                    }
                    if !standalone_found && !str_eq(clean_raw, "Vec") && !str_eq(clean_raw, "String") {
                        var candidate = ""
                        var c_count = 0
                        fi = 0usize
                        while fi < self.parser.functions.len {
                            let fn_str = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                            if str_ends_with(fn_str, member) {
                                let flen = str_len(fn_str)
                                let mlen = str_len(member)
                                if flen > mlen + 2usize {
                                    let p = fn_str as *raw u8
                                    if p[flen - mlen - 1usize] == 95u8 && p[flen - mlen - 2usize] == 95u8 {
                                        candidate = fn_str
                                        c_count = c_count + 1
                                    }
                                }
                            }
                            fi = fi + 1usize
                        }
                        if c_count == 1 {
                            callee_name = candidate
                        }
                    }
                }
            }

            var arg_regs = Vec.new()
            var arg_is_ptrs = Vec.new()
            if !is_static {
                var r_reg = self.emit_expr(recv_id)
                if !self.is_expr_ptr(recv_id) {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = inttoptr i64 %")
                    self.emit_str(int_to_str(r_reg).as_ptr() as str)
                    self.emit_str(" to ptr\n")
                    r_reg = cvt
                }
                arg_regs.push(r_reg)
                arg_is_ptrs.push(1)
            }
            var i = 0usize
            while i < ep[expr_id].args.len {
                let a_id = ep[expr_id].args.ptr[i]
                var a = self.emit_expr(a_id)
                if !is_static && str_eq(member, "push") && i == 0usize {
                    var recv_ty = self.get_expr_struct_name(recv_id)
                    if str_len(recv_ty) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                        recv_ty = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
                    }
                    if str_starts_with(recv_ty, "Vec<dyn ") {
                        let t_len = str_len(recv_ty)
                        if t_len > 9usize {
                            var tr_name = String.new()
                            let cp = recv_ty as *raw u8
                            var ci = 8usize
                            while ci < t_len && cp[ci] != 62u8 {
                                tr_name.push_byte(cp[ci])
                                ci = ci + 1usize
                            }
                            tr_name.push_byte(0u8)
                            let tr_str = tr_name.as_ptr() as str
                            let a_struct = self.get_expr_struct_name(a_id)
                            if str_len(a_struct) > 0usize && !str_starts_with(a_struct, "dyn ") {
                                a = self.coerce_to_trait_object(a, a_struct, tr_str)
                            }
                        }
                    }
                }
                arg_regs.push(a)
                if self.is_expr_ptr(a_id) {
                    arg_is_ptrs.push(1)
                } else {
                    arg_is_ptrs.push(0)
                }
                i = i + 1usize
            }
            var final_types = Vec.new()
            var j = 0usize
            while j < arg_regs.len {
                var pty = self.get_func_param_type(callee_name, j)
                var cur_r = arg_regs.ptr[j]
                let is_p = arg_is_ptrs.ptr[j]
                var is_flt = false
                if !is_static && j == 0usize {
                    pty = "ptr"
                } else {
                    var ai = j
                    if !is_static { ai = j - 1usize }
                    let a_id = ep[expr_id].args.ptr[ai]
                    is_flt = self.is_expr_float(a_id)
                }

                if str_eq(pty, "float") {
                    if !is_flt {
                        let cvt = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(cvt).as_ptr() as str)
                        self.emit_str(" = sitofp i64 %")
                        self.emit_str(int_to_str(cur_r).as_ptr() as str)
                        self.emit_str(" to float\n")
                        cur_r = cvt
                    } else {
                        var ai = j
                        if !is_static { ai = j - 1usize }
                        let a_id = ep[expr_id].args.ptr[ai]
                        if !self.is_expr_f32(a_id) {
                            let cvt = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(cvt).as_ptr() as str)
                            self.emit_str(" = fptrunc double %")
                            self.emit_str(int_to_str(cur_r).as_ptr() as str)
                            self.emit_str(" to float\n")
                            cur_r = cvt
                        }
                    }
                    pty = "float"
                } else if str_eq(pty, "double") || is_flt {
                    if !is_flt {
                        let cvt = self.alloc_ssa()
                        self.emit_str("  %")
                        self.emit_str(int_to_str(cvt).as_ptr() as str)
                        self.emit_str(" = sitofp i64 %")
                        self.emit_str(int_to_str(cur_r).as_ptr() as str)
                        self.emit_str(" to double\n")
                        cur_r = cvt
                    } else {
                        var ai = j
                        if !is_static { ai = j - 1usize }
                        let a_id = ep[expr_id].args.ptr[ai]
                        if self.is_expr_f32(a_id) {
                            let cvt = self.alloc_ssa()
                            self.emit_str("  %")
                            self.emit_str(int_to_str(cvt).as_ptr() as str)
                            self.emit_str(" = fpext float %")
                            self.emit_str(int_to_str(cur_r).as_ptr() as str)
                            self.emit_str(" to double\n")
                            cur_r = cvt
                        }
                    }
                    pty = "double"
                } else if str_eq(pty, "ptr") && is_p == 0 {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = inttoptr i64 %")
                    self.emit_str(int_to_str(cur_r).as_ptr() as str)
                    self.emit_str(" to ptr\n")
                    cur_r = cvt
                } else if (str_eq(pty, "i64") || str_eq(pty, "i32")) && is_p == 1 {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = ptrtoint ptr %")
                    self.emit_str(int_to_str(cur_r).as_ptr() as str)
                    self.emit_str(" to i64\n")
                    cur_r = cvt
                    pty = "i64"
                } else if is_p == 1 {
                    pty = "ptr"
                } else if str_eq(pty, "i32") && is_p == 0 {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = trunc i64 %")
                    self.emit_str(int_to_str(cur_r).as_ptr() as str)
                    self.emit_str(" to i32\n")
                    cur_r = cvt
                } else if (str_eq(pty, "i8") || str_eq(pty, "i16")) && is_p == 0 {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = trunc i64 %")
                    self.emit_str(int_to_str(cur_r).as_ptr() as str)
                    self.emit_str(" to ")
                    self.emit_str(pty)
                    self.emit_str("\n")
                    cur_r = cvt
                }
                arg_regs.ptr[j] = cur_r
                final_types.push(pty as i64)
                j = j + 1usize
            }

            var ret_ty: str = self.get_func_ret_type(callee_name)
            if str_eq(member, "as_ptr") || (is_static && (str_eq(member, "new") || str_eq(member, "from_str"))) {
                ret_ty = "ptr"
            }
            if str_eq(ret_ty, "void") {
                self.emit_str("  call void @")
                self.emit_str(callee_name)
                self.emit_str("(")
                var k = 0usize
                while k < arg_regs.len {
                    if k > 0usize { self.emit_str(", ") }
                    let pty = final_types.ptr[k] as str
                    self.emit_str(pty)
                    self.emit_str(" %")
                    self.emit_str(int_to_str(arg_regs.ptr[k]).as_ptr() as str)
                    k = k + 1usize
                }
                self.emit_str(")\n")
                if str_eq(member, "drop") && !is_static && ep[recv_id].kind == EXPR_IDENT {
                    let drop_vname = ep[recv_id].str_val.as_ptr() as str
                    var di = 0usize
                    while di < self.active_drops_var.len {
                        if str_eq(self.active_drops_var.ptr[di].as_ptr() as str, drop_vname) {
                            self.active_drops_var.ptr[di] = String.new()
                        }
                        di = di + 1usize
                    }
                }
                return 0
            }
            let res = self.alloc_ssa()
            self.emit_str("  %")
            self.emit_str(int_to_str(res).as_ptr() as str)
            self.emit_str(" = call ")
            self.emit_str(ret_ty)
            self.emit_str(" @")
            self.emit_str(callee_name)
            self.emit_str("(")
            var k = 0usize
            while k < arg_regs.len {
                if k > 0usize { self.emit_str(", ") }
                let pty = final_types.ptr[k] as str
                self.emit_str(pty)
                self.emit_str(" %")
                self.emit_str(int_to_str(arg_regs.ptr[k]).as_ptr() as str)
                k = k + 1usize
            }
            self.emit_str(")\n")
            if str_eq(ret_ty, "i32") {
                let ext = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(ext).as_ptr() as str)
                self.emit_str(" = sext i32 %")
                self.emit_str(int_to_str(res).as_ptr() as str)
                self.emit_str(" to i64\n")
                return ext
            }
            return res
        }
        if k == EXPR_FIELD_ACCESS {
            let recv_id = ep[expr_id].left
            var r_reg = self.emit_expr(recv_id)
            let fname = ep[expr_id].field_name.as_ptr() as str
            if str_eq(fname, "ptr") {
                if !self.is_expr_ptr(recv_id) {
                    let cvt = self.alloc_ssa()
                    self.emit_str("  %")
                    self.emit_str(int_to_str(cvt).as_ptr() as str)
                    self.emit_str(" = inttoptr i64 %")
                    self.emit_str(int_to_str(r_reg).as_ptr() as str)
                    self.emit_str(" to ptr\n")
                    r_reg = cvt
                }
                let load_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" = load ptr, ptr %")
                self.emit_str(int_to_str(r_reg).as_ptr() as str)
                self.emit_str(", align 8\n")
                return load_reg
            }

            var f_idx = -1i64
            let s_type = self.get_expr_struct_name(recv_id)
            if str_len(s_type) > 0usize {
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                f_idx = fi as i64
                                break
                            }
                            fi = fi + 1usize
                        }
                        break
                    }
                    si = si + 1usize
                }
            }
            if f_idx < 0i64 {
                f_idx = self.get_struct_field_idx(fname)
            }
            if f_idx < 0i64 {
                var err = String.new()
                err.push_str("no field '")
                err.push_str(fname)
                err.push_str("'")
                let sug = self.find_similar_field(fname, s_type)
                if str_len(sug) > 0usize {
                    err.push_str(" (did you mean '")
                    err.push_str(sug)
                    err.push_str("'?)")
                }
                self.parser.report_error("E0023", err.as_ptr() as str, ep[expr_id].expr_line, ep[expr_id].expr_col)
            }
            if !self.is_expr_ptr(recv_id) {
                let cvt = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(cvt).as_ptr() as str)
                self.emit_str(" = inttoptr i64 %")
                self.emit_str(int_to_str(r_reg).as_ptr() as str)
                self.emit_str(" to ptr\n")
                r_reg = cvt
            }
            let gep = self.alloc_ssa()
            self.emit_str("  %")
            self.emit_str(int_to_str(gep).as_ptr() as str)
            self.emit_str(" = getelementptr inbounds i64, ptr %")
            self.emit_str(int_to_str(r_reg).as_ptr() as str)
            self.emit_str(", i64 ")
            self.emit_str(int_to_str(f_idx as i32).as_ptr() as str)
            self.emit_str("\n")

            let field_is_float = self.is_expr_float(expr_id)
            let field_is_ptr = self.is_expr_ptr(expr_id)

            let load_reg = self.alloc_ssa()
            self.emit_str("  %")
            self.emit_str(int_to_str(load_reg).as_ptr() as str)
            if field_is_float {
                self.emit_str(" = load double, ptr %")
            } else if field_is_ptr {
                self.emit_str(" = load ptr, ptr %")
            } else {
                self.emit_str(" = load i64, ptr %")
            }
            self.emit_str(int_to_str(gep).as_ptr() as str)
            self.emit_str(", align 8\n")
            return load_reg
        }
        if k == EXPR_INDEX {
            let left_id = ep[expr_id].left
            var arr_reg = self.emit_expr(left_id)
            if !self.is_expr_ptr(left_id) {
                let cvt = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(cvt).as_ptr() as str)
                self.emit_str(" = inttoptr i64 %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(" to ptr\n")
                arr_reg = cvt
            }
            let idx_reg = self.emit_expr(ep[expr_id].right)

            var is_ptr_elem = false
            var is_byte = false
            var is_i32 = false
            var is_i16 = false
            var is_vec = false
            var is_float_elem = false
            if ep[left_id].kind == EXPR_IDENT {
                let raw_ty = self.get_raw_var_type(ep[left_id].str_val.as_ptr() as str)
                if str_ends_with(raw_ty, "f64") || str_ends_with(raw_ty, "f32") {
                    is_float_elem = true
                }
                if str_starts_with(raw_ty, "Vec") || str_starts_with(raw_ty, "[]") || str_starts_with(raw_ty, "var []") || str_starts_with(raw_ty, "[") {
                    is_vec = true
                } else if str_starts_with(raw_ty, "*raw *raw") || str_starts_with(raw_ty, "**") {
                    is_ptr_elem = true
                }
                if str_ends_with(raw_ty, "u8") || str_ends_with(raw_ty, "i8") || str_eq(raw_ty, "str") || str_ends_with(raw_ty, "bool") {
                    is_byte = true
                } else if str_ends_with(raw_ty, "u32") {
                    is_i32 = true
                } else if str_ends_with(raw_ty, "u16") || str_ends_with(raw_ty, "i16") {
                    is_i16 = true
                }
            } else if ep[left_id].kind == EXPR_ARRAY_LITERAL {
                is_vec = true
            } else if ep[left_id].kind == EXPR_CAST {
                let tgt = ep[left_id].target_type.as_ptr() as str
                if str_ends_with(tgt, "f64") || str_ends_with(tgt, "f32") {
                    is_float_elem = true
                } else if str_ends_with(tgt, "u8") || str_ends_with(tgt, "i8") || str_eq(tgt, "str") || str_ends_with(tgt, "bool") {
                    is_byte = true
                } else if str_ends_with(tgt, "u32") {
                    is_i32 = true
                } else if str_ends_with(tgt, "u16") || str_ends_with(tgt, "i16") {
                    is_i16 = true
                }
            } else if ep[left_id].kind == EXPR_FIELD_ACCESS {
                let fname = ep[left_id].field_name.as_ptr() as str
                let recv_id = ep[left_id].left
                let s_type = self.get_expr_struct_name(recv_id)
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if str_len(s_type) == 0usize || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                if str_ends_with(fty, "f64") || str_ends_with(fty, "f32") {
                                    is_float_elem = true
                                }
                                if str_starts_with(fty, "Vec") || str_starts_with(fty, "[]") || str_starts_with(fty, "var []") || str_starts_with(fty, "[") {
                                    is_vec = true
                                } else if str_starts_with(fty, "*raw *raw") || str_starts_with(fty, "**") {
                                    is_ptr_elem = true
                                }
                                if str_ends_with(fty, "u8") || str_ends_with(fty, "i8") || str_eq(fty, "str") || str_ends_with(fty, "bool") {
                                    is_byte = true
                                } else if str_ends_with(fty, "u32") {
                                    is_i32 = true
                                } else if str_ends_with(fty, "u16") || str_ends_with(fty, "i16") {
                                    is_i16 = true
                                }
                                break
                            }
                            fi = fi + 1usize
                        }
                    }
                    si = si + 1usize
                }
            }

            if is_vec {
                let len_gep = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(len_gep).as_ptr() as str)
                self.emit_str(" = getelementptr inbounds i64, ptr %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(", i64 2\n")
                let len_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(len_reg).as_ptr() as str)
                self.emit_str(" = load i64, ptr %")
                self.emit_str(int_to_str(len_gep).as_ptr() as str)
                self.emit_str(", align 8\n")

                let is_neg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(is_neg).as_ptr() as str)
                self.emit_str(" = icmp slt i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str(", 0\n")

                let is_oob = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(is_oob).as_ptr() as str)
                self.emit_str(" = icmp sge i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str(", %")
                self.emit_str(int_to_str(len_reg).as_ptr() as str)
                self.emit_str("\n")

                let bad = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(bad).as_ptr() as str)
                self.emit_str(" = or i1 %")
                self.emit_str(int_to_str(is_neg).as_ptr() as str)
                self.emit_str(", %")
                self.emit_str(int_to_str(is_oob).as_ptr() as str)
                self.emit_str("\n")

                let p_lbl = self.alloc_label()
                let ok_lbl = self.alloc_label()
                self.emit_str("  br i1 %")
                self.emit_str(int_to_str(bad).as_ptr() as str)
                self.emit_str(", label %panic_bounds_")
                self.emit_str(int_to_str(p_lbl).as_ptr() as str)
                self.emit_str(", label %ok_bounds_")
                self.emit_str(int_to_str(ok_lbl).as_ptr() as str)
                self.emit_str("\n")

                self.emit_str("panic_bounds_")
                self.emit_str(int_to_str(p_lbl).as_ptr() as str)
                self.emit_str(":\n")
                self.emit_str("  call void @__rad_panic_bounds(i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str(", i64 %")
                self.emit_str(int_to_str(len_reg).as_ptr() as str)
                self.emit_str(")\n  unreachable\n")

                self.emit_str("ok_bounds_")
                self.emit_str(int_to_str(ok_lbl).as_ptr() as str)
                self.emit_str(":\n")

                let buf_load = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(buf_load).as_ptr() as str)
                self.emit_str(" = load ptr, ptr %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(", align 8\n")
                arr_reg = buf_load
            }

            if is_float_elem {
                let gep = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(" = getelementptr inbounds double, ptr %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(", i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str("\n")

                let load_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" = load double, ptr %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(", align 8\n")
                return load_reg
            } else if is_ptr_elem {
                let gep = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(" = getelementptr inbounds ptr, ptr %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(", i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str("\n")

                let load_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" = load ptr, ptr %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(", align 8\n")
                return load_reg
            } else if is_byte {
                let gep = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(" = getelementptr inbounds i8, ptr %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(", i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str("\n")

                let load_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" = load i8, ptr %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(", align 1\n")

                let zext_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(zext_reg).as_ptr() as str)
                self.emit_str(" = zext i8 %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" to i64\n")
                return zext_reg
            } else if is_i32 {
                let gep = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(" = getelementptr inbounds i32, ptr %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(", i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str("\n")

                let load_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" = load i32, ptr %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(", align 4\n")

                let zext_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(zext_reg).as_ptr() as str)
                self.emit_str(" = zext i32 %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" to i64\n")
                return zext_reg
            } else if is_i16 {
                let gep = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(" = getelementptr inbounds i16, ptr %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(", i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str("\n")

                let load_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" = load i16, ptr %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(", align 2\n")

                let zext_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(zext_reg).as_ptr() as str)
                self.emit_str(" = zext i16 %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" to i64\n")
                return zext_reg
            } else {
                let gep = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(" = getelementptr inbounds i64, ptr %")
                self.emit_str(int_to_str(arr_reg).as_ptr() as str)
                self.emit_str(", i64 %")
                self.emit_str(int_to_str(idx_reg).as_ptr() as str)
                self.emit_str("\n")

                let load_reg = self.alloc_ssa()
                self.emit_str("  %")
                self.emit_str(int_to_str(load_reg).as_ptr() as str)
                self.emit_str(" = load i64, ptr %")
                self.emit_str(int_to_str(gep).as_ptr() as str)
                self.emit_str(", align 8\n")
                return load_reg
            }
        }
        if k == EXPR_CAST {
            let left_id = ep[expr_id].left
            let left_reg = self.emit_expr(left_id)
            let src_is_ptr = self.is_expr_ptr(left_id)
            let src_is_float = self.is_expr_float(left_id)
            let target_raw = ep[expr_id].target_type.as_ptr() as str
            let target_ty = self.emit_llvm_type(target_raw)

            if str_eq(target_ty, "double") || str_eq(target_ty, "float") {
                if src_is_float {
                    if str_eq(target_ty, "float") {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        self.ir.push_str(" = fptrunc double %")
                        self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                        self.ir.push_str(" to float\n")
                        return cvt
                    }
                    return left_reg
                }
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = sitofp i64 %")
                self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                self.ir.push_str(" to ")
                self.ir.push_str(target_ty)
                self.ir.push_str("\n")
                return cvt
            }
            if src_is_float {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                if self.is_expr_f32(left_id) {
                    self.ir.push_str(" = fptosi float %")
                } else {
                    self.ir.push_str(" = fptosi double %")
                }
                self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                self.ir.push_str(" to i64\n")
                return cvt
            }
            if str_eq(target_raw, "u8") || str_eq(target_raw, "i8") {
                let trunc_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(trunc_reg).as_ptr() as str)
                self.ir.push_str(" = trunc i64 %")
                self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                self.ir.push_str(" to i8\n")

                let ext_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(ext_reg).as_ptr() as str)
                if str_eq(target_raw, "u8") {
                    self.ir.push_str(" = zext i8 %")
                } else {
                    self.ir.push_str(" = sext i8 %")
                }
                self.ir.push_str(int_to_str(trunc_reg).as_ptr() as str)
                self.ir.push_str(" to i64\n")
                return ext_reg
            }
            if str_eq(target_ty, "ptr") {
                if src_is_ptr {
                    return left_reg
                }
                let ptr_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(ptr_reg).as_ptr() as str)
                self.ir.push_str(" = inttoptr i64 %")
                self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                self.ir.push_str(" to ptr\n")
                return ptr_reg
            }
            if str_eq(target_ty, "i64") {
                if src_is_ptr {
                    let ext = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(ext).as_ptr() as str)
                    self.ir.push_str(" = ptrtoint ptr %")
                    self.ir.push_str(int_to_str(left_reg).as_ptr() as str)
                    self.ir.push_str(" to i64\n")
                    return ext
                }
                return left_reg
            }
            return left_reg
        }
        if k == EXPR_TRY {
            let inner_id = ep[expr_id].left
            let inner_reg = self.emit_expr(inner_id)
            let is_ptr = self.is_expr_ptr(inner_id)

            let cond_reg = self.alloc_ssa()
            if is_ptr {
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cond_reg).as_ptr() as str)
                self.ir.push_str(" = icmp eq ptr %")
                self.ir.push_str(int_to_str(inner_reg).as_ptr() as str)
                self.ir.push_str(", null\n")
            } else {
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cond_reg).as_ptr() as str)
                self.ir.push_str(" = icmp eq i64 %")
                self.ir.push_str(int_to_str(inner_reg).as_ptr() as str)
                self.ir.push_str(", 0\n")
            }

            let early_ret_lbl = self.alloc_label()
            let continue_lbl = self.alloc_label()

            self.ir.push_str("  br i1 %")
            self.ir.push_str(int_to_str(cond_reg).as_ptr() as str)
            self.ir.push_str(", label %try.ret.")
            self.ir.push_str(int_to_str(early_ret_lbl).as_ptr() as str)
            self.ir.push_str(", label %try.cont.")
            self.ir.push_str(int_to_str(continue_lbl).as_ptr() as str)
            self.ir.push_str("\n")

            // Early return block
            self.ir.push_str("try.ret.")
            self.ir.push_str(int_to_str(early_ret_lbl).as_ptr() as str)
            self.ir.push_str(":\n")
            self.emit_defers_from(0usize)
            let ret_ty = self.current_ret_type.as_ptr() as str
            if str_eq(ret_ty, "void") {
                self.ir.push_str("  ret void\n")
            } else if str_eq(ret_ty, "ptr") {
                self.ir.push_str("  ret ptr null\n")
            } else if str_eq(ret_ty, "i32") {
                self.ir.push_str("  ret i32 0\n")
            } else if str_eq(ret_ty, "double") {
                self.ir.push_str("  ret double 0.0\n")
            } else if str_eq(ret_ty, "float") {
                self.ir.push_str("  ret float 0.0\n")
            } else {
                self.ir.push_str("  ret i64 0\n")
            }

            // Continuation block
            self.ir.push_str("try.cont.")
            self.ir.push_str(int_to_str(continue_lbl).as_ptr() as str)
            self.ir.push_str(":\n")

            return inner_reg
        }
        return 0
    }

    fn struct_has_drop(self, type_name: str) -> bool {
        let clean = self.clean_type_name(type_name)
        if str_len(clean) == 0usize || str_eq(clean, "void") || str_eq(clean, "i32") || str_eq(clean, "i64") || str_eq(clean, "bool") || str_eq(clean, "f64") || str_eq(clean, "f32") {
            return false
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            let fn_str = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
            if str_ends_with(fn_str, "__drop") && str_starts_with(fn_str, clean) {
                return true
            }
            fi = fi + 1usize
        }
        return false
    }

    fn emit_drops_from(var self, from_idx: usize, skip_var: str) {
        if self.active_drops_var.len <= from_idx {
            return
        }
        var i = self.active_drops_var.len
        while i > from_idx {
            i = i - 1usize
            let vname = self.active_drops_var.ptr[i].as_ptr() as str
            if str_len(vname) == 0usize {
                continue
            }
            let vty = self.active_drops_type.ptr[i].as_ptr() as str
            if str_len(skip_var) > 0usize && str_eq(vname, skip_var) {
                continue
            }
            let clean = self.clean_type_name(vty)
            var drop_fn_name = ""
            var fi = 0usize
            while fi < self.parser.functions.len {
                let fn_str = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                if str_ends_with(fn_str, "__drop") && str_starts_with(fn_str, clean) {
                    drop_fn_name = fn_str
                    break
                }
                fi = fi + 1usize
            }
            if str_len(drop_fn_name) == 0usize {
                continue
            }

            let inst_ptr = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(inst_ptr).as_ptr() as str)
            self.ir.push_str(" = load ptr, ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, align 8\n")

            let check_null = self.alloc_ssa()
            let drop_lbl = self.alloc_label()
            let cont_lbl = self.alloc_label()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(check_null).as_ptr() as str)
            self.ir.push_str(" = icmp ne ptr %")
            self.ir.push_str(int_to_str(inst_ptr).as_ptr() as str)
            self.ir.push_str(", null\n")
            self.ir.push_str("  br i1 %")
            self.ir.push_str(int_to_str(check_null).as_ptr() as str)
            self.ir.push_str(", label %drop.")
            self.ir.push_str(int_to_str(drop_lbl).as_ptr() as str)
            self.ir.push_str(", label %drop.")
            self.ir.push_str(int_to_str(cont_lbl).as_ptr() as str)
            self.ir.push_str("\ndrop.")
            self.ir.push_str(int_to_str(drop_lbl).as_ptr() as str)
            self.ir.push_str(":\n")
            self.ir.push_str("  call void @")
            self.ir.push_str(drop_fn_name)
            self.ir.push_str("(ptr %")
            self.ir.push_str(int_to_str(inst_ptr).as_ptr() as str)
            self.ir.push_str(")\n")
            self.ir.push_str("  store ptr null, ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, align 8\n")
            self.ir.push_str("  br label %drop.")
            self.ir.push_str(int_to_str(cont_lbl).as_ptr() as str)
            self.ir.push_str("\ndrop.")
            self.ir.push_str(int_to_str(cont_lbl).as_ptr() as str)
            self.ir.push_str(":\n")
        }
    }

    fn pop_drops_to(var self, to_idx: usize) {
        while self.active_drops_var.len > to_idx {
            let _p1 = self.active_drops_var.pop()
            let _p2 = self.active_drops_type.pop()
        }
    }

    fn emit_defers_from(var self, from_idx: usize) {
        if self.active_defers.len <= from_idx {
            return
        }
        var i = self.active_defers.len
        while i > from_idx {
            i = i - 1usize
            let def_stmt_id = self.active_defers.ptr[i]
            let sp = self.parser.stmts.ptr
            var di = 0usize
            while di < sp[def_stmt_id].body_stmts.len {
                self.emit_stmt(sp[def_stmt_id].body_stmts.ptr[di])
                di = di + 1usize
            }
        }
    }

    fn emit_stmt(var self, stmt_id: usize) {
        let sp = self.parser.stmts.ptr
        let k = sp[stmt_id].kind

        if k == STMT_LET || k == STMT_VAR {
            let vname = sp[stmt_id].name.as_ptr() as str
            if sp[stmt_id].expr_id != 0usize {
                let init_expr = sp[stmt_id].expr_id
                let raw_ty = self.get_raw_var_type(vname)
                let ik = self.parser.exprs.ptr[init_expr].kind
                if (str_eq(raw_ty, "i32") || str_eq(raw_ty, "i64")) && ik == EXPR_STR {
                    var err = String.new()
                    err.push_str("type mismatch: cannot assign string literal to integer variable '")
                    err.push_str(vname)
                    err.push_str("'")
                    self.parser.report_error("E0021", err.as_ptr() as str, sp[stmt_id].stmt_line, sp[stmt_id].stmt_col)
                }
                var r = self.emit_expr(init_expr)
                if str_starts_with(raw_ty, "dyn ") {
                    let target_trait = (raw_ty as usize + 4usize) as str
                    let src_struct = self.get_expr_struct_name(init_expr)
                    if str_len(src_struct) > 0usize && !str_starts_with(src_struct, "dyn ") {
                        r = self.coerce_to_trait_object(r, src_struct, target_trait)
                    }
                }
                if self.is_struct_name(raw_ty) && ik == EXPR_IDENT {
                    var s_idx = 0usize
                    var num_f = 2usize
                    while s_idx < self.parser.structs.len {
                        if self.match_struct_name(self.parser.structs.ptr[s_idx].struct_name.as_ptr() as str, raw_ty) {
                            num_f = self.parser.structs.ptr[s_idx].field_names.len
                            break
                        }
                        s_idx = s_idx + 1usize
                    }
                    let sz = num_f * 8usize
                    let clone_reg = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(clone_reg).as_ptr() as str)
                    self.ir.push_str(" = call ptr @malloc(i64 ")
                    self.ir.push_str(int_to_str(sz as i32).as_ptr() as str)
                    self.ir.push_str(")\n")

                    var src_ptr = r
                    let src_vname = self.parser.exprs.ptr[init_expr].str_val.as_ptr() as str
                    let src_is_ptr = str_eq(self.get_var_type(src_vname), "ptr")
                    if !src_is_ptr {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        self.ir.push_str(" = inttoptr i64 %")
                        self.ir.push_str(int_to_str(r).as_ptr() as str)
                        self.ir.push_str(" to ptr\n")
                        src_ptr = cvt
                    }

                    var f = 0usize
                    while f < num_f {
                        let gep_src = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(gep_src).as_ptr() as str)
                        self.ir.push_str(" = getelementptr inbounds i64, ptr %")
                        self.ir.push_str(int_to_str(src_ptr).as_ptr() as str)
                        self.ir.push_str(", i64 ")
                        self.ir.push_str(int_to_str(f as i32).as_ptr() as str)
                        self.ir.push_str("\n")

                        let val_load = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(val_load).as_ptr() as str)
                        self.ir.push_str(" = load i64, ptr %")
                        self.ir.push_str(int_to_str(gep_src).as_ptr() as str)
                        self.ir.push_str(", align 8\n")

                        let gep_dst = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(gep_dst).as_ptr() as str)
                        self.ir.push_str(" = getelementptr inbounds i64, ptr %")
                        self.ir.push_str(int_to_str(clone_reg).as_ptr() as str)
                        self.ir.push_str(", i64 ")
                        self.ir.push_str(int_to_str(f as i32).as_ptr() as str)
                        self.ir.push_str("\n")

                        self.ir.push_str("  store i64 %")
                        self.ir.push_str(int_to_str(val_load).as_ptr() as str)
                        self.ir.push_str(", ptr %")
                        self.ir.push_str(int_to_str(gep_dst).as_ptr() as str)
                        self.ir.push_str(", align 8\n")

                        f = f + 1usize
                    }
                    r = clone_reg
                }
                let llvm_ty = self.get_var_type(vname)
                var init_is_ptr = self.is_expr_ptr(init_expr)
                if self.is_struct_name(raw_ty) && ik == EXPR_IDENT {
                    init_is_ptr = true
                }
                let init_is_float = self.is_expr_float(init_expr)
                if (str_eq(llvm_ty, "double") || str_eq(llvm_ty, "float")) && !init_is_float {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = sitofp i64 %")
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(" to ")
                    self.ir.push_str(llvm_ty)
                    self.ir.push_str("\n")
                    r = cvt
                } else if str_eq(llvm_ty, "double") && self.is_expr_f32(init_expr) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = fpext float %")
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    r = cvt
                } else if str_eq(llvm_ty, "float") && init_is_float && !self.is_expr_f32(init_expr) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = fptrunc double %")
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(" to float\n")
                    r = cvt
                } else if (!str_eq(llvm_ty, "double") && !str_eq(llvm_ty, "float")) && init_is_float {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    if self.is_expr_f32(sp[stmt_id].expr_id) {
                        self.ir.push_str(" = fptosi float %")
                    } else {
                        self.ir.push_str(" = fptosi double %")
                    }
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(" to i64\n")
                    r = cvt
                } else if str_eq(llvm_ty, "ptr") && !init_is_ptr {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = inttoptr i64 %")
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(" to ptr\n")
                    r = cvt
                } else if str_eq(llvm_ty, "i64") && init_is_ptr {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = ptrtoint ptr %")
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(" to i64\n")
                    r = cvt
                } else if str_eq(llvm_ty, "i32") && !init_is_ptr {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = trunc i64 %")
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(" to i32\n")
                    r = cvt
                }
                if r == 0 {
                    self.ir.push_str("  store ")
                    self.ir.push_str(llvm_ty)
                    if str_eq(llvm_ty, "ptr") {
                        self.ir.push_str(" null, ptr %")
                    } else if str_eq(llvm_ty, "double") {
                        self.ir.push_str(" 0.0, ptr %")
                    } else {
                        self.ir.push_str(" 0, ptr %")
                    }
                    self.ir.push_str(vname)
                    self.ir.push_str(".addr, align 8\n")
                } else {
                    self.ir.push_str("  store ")
                    self.ir.push_str(llvm_ty)
                    self.ir.push_str(" %")
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(", ptr %")
                    self.ir.push_str(vname)
                    self.ir.push_str(".addr, align 8\n")
                }
            }
            var raw_drop_ty = self.get_raw_var_type(vname)
            if str_len(raw_drop_ty) == 0usize && sp[stmt_id].expr_id != 0usize {
                raw_drop_ty = self.get_expr_struct_name(sp[stmt_id].expr_id)
            }
            if self.struct_has_drop(raw_drop_ty) {
                self.active_drops_var.push(String.from_str(vname))
                self.active_drops_type.push(String.from_str(raw_drop_ty))
            }
        } else if k == STMT_ASSIGN {
            let vname = sp[stmt_id].name.as_ptr() as str
            let init_expr = sp[stmt_id].expr_id

            // Semantic check: ensure variable was declared
            var is_alloc = false
            var ai = 0usize
            while ai < self.allocated_vars.len {
                if str_eq(self.allocated_vars.ptr[ai].as_ptr() as str, vname) {
                    is_alloc = true
                    break
                }
                ai = ai + 1usize
            }
            if !is_alloc {
                var err = String.new()
                err.push_str("cannot assign to undeclared variable '")
                err.push_str(vname)
                err.push_str("' (declare with 'let' or 'var' first)")
                let sug = self.find_similar_ident(vname)
                if str_len(sug) > 0usize {
                    err.push_str(" (did you mean '")
                    err.push_str(sug)
                    err.push_str("'?)")
                }
                let diag_source_id_3 = self.parser.stmt_source_ids.ptr[stmt_id]
                self.parser.report_error_span_for_source(diag_source_id_3, "E0020", err.as_ptr() as str, sp[stmt_id].stmt_line, sp[stmt_id].stmt_col, str_len(vname) as i64)
                let _r = self.emit_expr(init_expr)
                return
            }

            let raw_ty = self.get_raw_var_type(vname)
            let ik = self.parser.exprs.ptr[init_expr].kind
            if (str_eq(raw_ty, "i32") || str_eq(raw_ty, "i64")) && ik == EXPR_STR {
                var err = String.new()
                err.push_str("type mismatch: cannot assign string literal to integer variable '")
                err.push_str(vname)
                err.push_str("'")
                self.parser.report_error("E0023", err.as_ptr() as str, sp[stmt_id].stmt_line, sp[stmt_id].stmt_col)
            }
            var r = self.emit_expr(init_expr)
            if str_starts_with(raw_ty, "dyn ") {
                let target_trait = (raw_ty as usize + 4usize) as str
                let src_struct = self.get_expr_struct_name(init_expr)
                if str_len(src_struct) > 0usize && !str_starts_with(src_struct, "dyn ") {
                    r = self.coerce_to_trait_object(r, src_struct, target_trait)
                }
            }
            let llvm_ty = self.get_var_type(vname)
            let init_is_ptr = self.is_expr_ptr(init_expr)
            let init_is_float = self.is_expr_float(init_expr)
            if (str_eq(llvm_ty, "double") || str_eq(llvm_ty, "float")) && !init_is_float {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = sitofp i64 %")
                self.ir.push_str(int_to_str(r).as_ptr() as str)
                self.ir.push_str(" to ")
                self.ir.push_str(llvm_ty)
                self.ir.push_str("\n")
                r = cvt
            } else if str_eq(llvm_ty, "double") && self.is_expr_f32(init_expr) {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = fpext float %")
                self.ir.push_str(int_to_str(r).as_ptr() as str)
                self.ir.push_str(" to double\n")
                r = cvt
            } else if str_eq(llvm_ty, "float") && init_is_float && !self.is_expr_f32(init_expr) {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = fptrunc double %")
                self.ir.push_str(int_to_str(r).as_ptr() as str)
                self.ir.push_str(" to float\n")
                r = cvt
            } else if (!str_eq(llvm_ty, "double") && !str_eq(llvm_ty, "float")) && init_is_float {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                if self.is_expr_f32(sp[stmt_id].expr_id) {
                    self.ir.push_str(" = fptosi float %")
                } else {
                    self.ir.push_str(" = fptosi double %")
                }
                self.ir.push_str(int_to_str(r).as_ptr() as str)
                self.ir.push_str(" to i64\n")
                r = cvt
            } else if str_eq(llvm_ty, "ptr") && !init_is_ptr {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = inttoptr i64 %")
                self.ir.push_str(int_to_str(r).as_ptr() as str)
                self.ir.push_str(" to ptr\n")
                r = cvt
            } else if str_eq(llvm_ty, "i64") && init_is_ptr {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = ptrtoint ptr %")
                self.ir.push_str(int_to_str(r).as_ptr() as str)
                self.ir.push_str(" to i64\n")
                r = cvt
            } else if str_eq(llvm_ty, "i32") && !init_is_ptr {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = trunc i64 %")
                self.ir.push_str(int_to_str(r).as_ptr() as str)
                self.ir.push_str(" to i32\n")
                r = cvt
            }
            if r == 0 {
                self.ir.push_str("  store ")
                self.ir.push_str(llvm_ty)
                if str_eq(llvm_ty, "ptr") {
                    self.ir.push_str(" null, ptr %")
                } else if str_eq(llvm_ty, "double") {
                    self.ir.push_str(" 0.0, ptr %")
                } else {
                    self.ir.push_str(" 0, ptr %")
                }
                self.ir.push_str(vname)
                self.ir.push_str(".addr, align 8\n")
            } else {
                self.ir.push_str("  store ")
                self.ir.push_str(llvm_ty)
                self.ir.push_str(" %")
                self.ir.push_str(int_to_str(r).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(vname)
                self.ir.push_str(".addr, align 8\n")
            }
            var raw_drop_ty = self.get_raw_var_type(vname)
            if str_len(raw_drop_ty) == 0usize && sp[stmt_id].expr_id != 0usize {
                raw_drop_ty = self.get_expr_struct_name(sp[stmt_id].expr_id)
            }
            if self.struct_has_drop(raw_drop_ty) {
                var found = false
                var di = 0usize
                while di < self.active_drops_var.len {
                    if str_eq(self.active_drops_var.ptr[di].as_ptr() as str, vname) {
                        found = true
                        break
                    }
                    di = di + 1usize
                }
                if !found {
                    self.active_drops_var.push(String.from_str(vname))
                    self.active_drops_type.push(String.from_str(raw_drop_ty))
                }
            }
        } else if k == STMT_ASSIGN_INDEX {
            let val_expr = sp[stmt_id].expr_id
            var val_reg = self.emit_expr(val_expr)
            let idx_reg = self.emit_expr(sp[stmt_id].index_expr)
            var arr_reg = 0
            var is_byte = false
            var is_i32 = false
            var is_i16 = false
            var is_vec = false
            let vname = sp[stmt_id].name.as_ptr() as str
            if str_len(vname) > 0usize {
                let raw_ty = self.get_raw_var_type(vname)
                if str_starts_with(raw_ty, "Vec") || str_starts_with(raw_ty, "[]") || str_starts_with(raw_ty, "var []") || str_starts_with(raw_ty, "[") {
                    is_vec = true
                }
                if str_ends_with(raw_ty, "u8") || str_ends_with(raw_ty, "i8") || str_eq(raw_ty, "str") || str_ends_with(raw_ty, "bool") {
                    is_byte = true
                } else if str_ends_with(raw_ty, "u32") {
                    is_i32 = true
                } else if str_ends_with(raw_ty, "u16") || str_ends_with(raw_ty, "i16") {
                    is_i16 = true
                }
            }
            if self.parser.exprs.ptr[val_expr].kind == EXPR_CAST {
                let tgt = self.parser.exprs.ptr[val_expr].target_type.as_ptr() as str
                if str_eq(tgt, "u8") || str_eq(tgt, "i8") {
                    is_byte = true
                } else if str_eq(tgt, "u32") {
                    is_i32 = true
                } else if str_eq(tgt, "u16") || str_eq(tgt, "i16") {
                    is_i16 = true
                }
            }
            if sp[stmt_id].then_stmts.len > 0usize {
                let arr_expr = sp[stmt_id].then_stmts.ptr[0usize]
                if self.parser.exprs.ptr[arr_expr].kind == EXPR_IDENT {
                    let raw_ty = self.get_raw_var_type(self.parser.exprs.ptr[arr_expr].str_val.as_ptr() as str)
                    if str_starts_with(raw_ty, "Vec") || str_starts_with(raw_ty, "[]") || str_starts_with(raw_ty, "var []") || str_starts_with(raw_ty, "[") {
                        is_vec = true
                    }
                    if str_ends_with(raw_ty, "u8") || str_ends_with(raw_ty, "i8") || str_eq(raw_ty, "str") || str_ends_with(raw_ty, "bool") {
                        is_byte = true
                    } else if str_ends_with(raw_ty, "u32") {
                        is_i32 = true
                    } else if str_ends_with(raw_ty, "u16") || str_ends_with(raw_ty, "i16") {
                        is_i16 = true
                    }
                } else if self.parser.exprs.ptr[arr_expr].kind == EXPR_FIELD_ACCESS {
                    let fname = self.parser.exprs.ptr[arr_expr].field_name.as_ptr() as str
                    let recv_id = self.parser.exprs.ptr[arr_expr].left
                    var s_type = ""
                    if self.parser.exprs.ptr[recv_id].kind == EXPR_IDENT {
                        s_type = self.get_raw_var_type(self.parser.exprs.ptr[recv_id].str_val.as_ptr() as str)
                    }
                    var si = 0usize
                    while si < self.parser.structs.len {
                        let sdef = self.parser.structs.ptr[si]
                        if str_len(s_type) == 0usize || str_starts_with(s_type, "*") || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                            var fi = 0usize
                            while fi < sdef.field_names.len {
                                if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                    let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                    if str_starts_with(fty, "Vec") || str_starts_with(fty, "[]") || str_starts_with(fty, "var []") || str_starts_with(fty, "[") {
                                        is_vec = true
                                    }
                                    if str_ends_with(fty, "u8") || str_ends_with(fty, "i8") || str_eq(fty, "str") || str_ends_with(fty, "bool") {
                                        is_byte = true
                                    } else if str_ends_with(fty, "u32") {
                                        is_i32 = true
                                    } else if str_ends_with(fty, "u16") || str_ends_with(fty, "i16") {
                                        is_i16 = true
                                    }
                                    break
                                }
                                fi = fi + 1usize
                            }
                        }
                        si = si + 1usize
                    }
                } else if self.parser.exprs.ptr[arr_expr].kind == EXPR_CAST {
                    let tgt = self.parser.exprs.ptr[arr_expr].target_type.as_ptr() as str
                    if str_ends_with(tgt, "u8") || str_ends_with(tgt, "i8") || str_eq(tgt, "str") || str_ends_with(tgt, "bool") {
                        is_byte = true
                    } else if str_ends_with(tgt, "u32") {
                        is_i32 = true
                    } else if str_ends_with(tgt, "u16") || str_ends_with(tgt, "i16") {
                        is_i16 = true
                    }
                }
                arr_reg = self.emit_expr(arr_expr)
                if !self.is_expr_ptr(arr_expr) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = inttoptr i64 %")
                    self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                    self.ir.push_str(" to ptr\n")
                    arr_reg = cvt
                }
            } else {
                arr_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(" = load ptr, ptr %")
                self.ir.push_str(vname)
                self.ir.push_str(".addr, align 8\n")
            }

            if is_vec {
                let len_gep = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(len_gep).as_ptr() as str)
                self.ir.push_str(" = getelementptr inbounds i64, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", i64 2\n")
                let len_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(len_reg).as_ptr() as str)
                self.ir.push_str(" = load i64, ptr %")
                self.ir.push_str(int_to_str(len_gep).as_ptr() as str)
                self.ir.push_str(", align 8\n")

                let is_neg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(is_neg).as_ptr() as str)
                self.ir.push_str(" = icmp slt i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str(", 0\n")

                let is_oob = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(is_oob).as_ptr() as str)
                self.ir.push_str(" = icmp sge i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str(", %")
                self.ir.push_str(int_to_str(len_reg).as_ptr() as str)
                self.ir.push_str("\n")

                let bad = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(bad).as_ptr() as str)
                self.ir.push_str(" = or i1 %")
                self.ir.push_str(int_to_str(is_neg).as_ptr() as str)
                self.ir.push_str(", %")
                self.ir.push_str(int_to_str(is_oob).as_ptr() as str)
                self.ir.push_str("\n")

                let p_lbl = self.alloc_label()
                let ok_lbl = self.alloc_label()
                self.ir.push_str("  br i1 %")
                self.ir.push_str(int_to_str(bad).as_ptr() as str)
                self.ir.push_str(", label %panic_bounds_")
                self.ir.push_str(int_to_str(p_lbl).as_ptr() as str)
                self.ir.push_str(", label %ok_bounds_")
                self.ir.push_str(int_to_str(ok_lbl).as_ptr() as str)
                self.ir.push_str("\n")

                self.ir.push_str("panic_bounds_")
                self.ir.push_str(int_to_str(p_lbl).as_ptr() as str)
                self.ir.push_str(":\n")
                self.ir.push_str("  call void @__rad_panic_bounds(i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str(", i64 %")
                self.ir.push_str(int_to_str(len_reg).as_ptr() as str)
                self.ir.push_str(")\n  unreachable\n")

                self.ir.push_str("ok_bounds_")
                self.ir.push_str(int_to_str(ok_lbl).as_ptr() as str)
                self.ir.push_str(":\n")

                let buf_load = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(buf_load).as_ptr() as str)
                self.ir.push_str(" = load ptr, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", align 8\n")
                arr_reg = buf_load
            }

            if is_byte {
                let gep = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(" = getelementptr inbounds i8, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str("\n")

                let trunc_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(trunc_reg).as_ptr() as str)
                self.ir.push_str(" = trunc i64 %")
                self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                self.ir.push_str(" to i8\n")

                self.ir.push_str("  store i8 %")
                self.ir.push_str(int_to_str(trunc_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(", align 1\n")
            } else if is_i32 {
                let gep = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(" = getelementptr inbounds i32, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str("\n")

                let trunc_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(trunc_reg).as_ptr() as str)
                self.ir.push_str(" = trunc i64 %")
                self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                self.ir.push_str(" to i32\n")

                self.ir.push_str("  store i32 %")
                self.ir.push_str(int_to_str(trunc_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(", align 4\n")
            } else if is_i16 {
                let gep = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(" = getelementptr inbounds i16, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str("\n")

                let trunc_reg = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(trunc_reg).as_ptr() as str)
                self.ir.push_str(" = trunc i64 %")
                self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                self.ir.push_str(" to i16\n")

                self.ir.push_str("  store i16 %")
                self.ir.push_str(int_to_str(trunc_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(", align 2\n")
            } else if self.is_expr_float(val_expr) {
                if self.is_expr_f32(val_expr) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = fpext float %")
                    self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    val_reg = cvt
                }
                let gep = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(" = getelementptr inbounds double, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str("\n")

                self.ir.push_str("  store double %")
                self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(", align 8\n")
            } else {
                let gep = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(" = getelementptr inbounds i64, ptr %")
                self.ir.push_str(int_to_str(arr_reg).as_ptr() as str)
                self.ir.push_str(", i64 %")
                self.ir.push_str(int_to_str(idx_reg).as_ptr() as str)
                self.ir.push_str("\n")

                if self.is_expr_ptr(val_expr) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = ptrtoint ptr %")
                    self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                    self.ir.push_str(" to i64\n")
                    val_reg = cvt
                }

                self.ir.push_str("  store i64 %")
                self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(", align 8\n")
            }
        } else if k == STMT_ASSIGN_FIELD {
            let fname = sp[stmt_id].name.as_ptr() as str
            let recv_expr = sp[stmt_id].index_expr
            let val_expr = sp[stmt_id].expr_id
            var recv_reg = self.emit_expr(recv_expr)
            var val_reg = self.emit_expr(val_expr)

            var f_idx = -1i64
            let s_type = self.get_expr_struct_name(recv_expr)
            if str_len(s_type) > 0usize {
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                f_idx = fi as i64
                                break
                            }
                            fi = fi + 1usize
                        }
                        break
                    }
                    si = si + 1usize
                }
            }
            if f_idx < 0i64 {
                f_idx = self.get_struct_field_idx(fname)
            }
            if f_idx < 0i64 {
                var err = String.new()
                err.push_str("no field '")
                err.push_str(fname)
                err.push_str("'")
                let sug = self.find_similar_field(fname, s_type)
                if str_len(sug) > 0usize {
                    err.push_str(" (did you mean '")
                    err.push_str(sug)
                    err.push_str("'?)")
                }
                self.parser.report_error("E0023", err.as_ptr() as str, sp[stmt_id].stmt_line, sp[stmt_id].stmt_col)
            }

            if !self.is_expr_ptr(recv_expr) {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = inttoptr i64 %")
                self.ir.push_str(int_to_str(recv_reg).as_ptr() as str)
                self.ir.push_str(" to ptr\n")
                recv_reg = cvt
            }

            let gep = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(gep).as_ptr() as str)
            self.ir.push_str(" = getelementptr inbounds i64, ptr %")
            self.ir.push_str(int_to_str(recv_reg).as_ptr() as str)
            self.ir.push_str(", i64 ")
            self.ir.push_str(int_to_str(f_idx as i32).as_ptr() as str)
            self.ir.push_str("\n")

            var field_is_float = false
            var si = 0usize
            while si < self.parser.structs.len {
                let sdef = self.parser.structs.ptr[si]
                var fi = 0usize
                while fi < sdef.field_names.len {
                    if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                        let fty = sdef.field_types.ptr[fi].as_ptr() as str
                        if str_eq(fty, "f64") || str_eq(fty, "f32") {
                            field_is_float = true
                        }
                        break
                    }
                    fi = fi + 1usize
                }
                si = si + 1usize
            }

            if field_is_float {
                if !self.is_expr_float(val_expr) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = sitofp i64 %")
                    self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    val_reg = cvt
                } else if self.is_expr_f32(val_expr) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = fpext float %")
                    self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                    self.ir.push_str(" to double\n")
                    val_reg = cvt
                }
                self.ir.push_str("  store double %")
                self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(", align 8\n")
            } else {
                if self.is_expr_ptr(val_expr) {
                    let cvt = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                    self.ir.push_str(" = ptrtoint ptr %")
                    self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                    self.ir.push_str(" to i64\n")
                    val_reg = cvt
                }

                self.ir.push_str("  store i64 %")
                self.ir.push_str(int_to_str(val_reg).as_ptr() as str)
                self.ir.push_str(", ptr %")
                self.ir.push_str(int_to_str(gep).as_ptr() as str)
                self.ir.push_str(", align 8\n")
            }
        } else if k == STMT_IF {
            let cond_reg = self.emit_expr(sp[stmt_id].expr_id)
            let bool_reg = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(bool_reg).as_ptr() as str)
            self.ir.push_str(" = icmp ne i64 %")
            self.ir.push_str(int_to_str(cond_reg).as_ptr() as str)
            self.ir.push_str(", 0\n")

            let lbl_then = self.alloc_label()
            let lbl_else = self.alloc_label()
            let lbl_merge = self.alloc_label()

            self.ir.push_str("  br i1 %")
            self.ir.push_str(int_to_str(bool_reg).as_ptr() as str)
            self.ir.push_str(", label %if.then.")
            self.ir.push_str(int_to_str(lbl_then).as_ptr() as str)
            self.ir.push_str(", label %if.else.")
            self.ir.push_str(int_to_str(lbl_else).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("if.then.")
            self.ir.push_str(int_to_str(lbl_then).as_ptr() as str)
            self.ir.push_str(":\n")
            var shadowed_names = Vec.new()
            var shadowed_saved = Vec.new()
            var si = 0usize
            while si < sp[stmt_id].then_stmts.len {
                let ts_id = sp[stmt_id].then_stmts.ptr[si]
                let t_k = sp[ts_id].kind
                if t_k == STMT_LET || t_k == STMT_VAR {
                    let sname = sp[ts_id].name.as_ptr() as str
                    var was_declared = false
                    var vi = 0usize
                    while vi < stmt_id {
                        let vk = sp[vi].kind
                        if vk == STMT_LET || vk == STMT_VAR {
                            if str_eq(sp[vi].name.as_ptr() as str, sname) {
                                was_declared = true
                                break
                            }
                        }
                        vi = vi + 1usize
                    }
                    if was_declared {
                        shadowed_names.push(String.from_str(sname))
                        let l_ty = self.get_var_type(sname)
                        let saved_r = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(saved_r).as_ptr() as str)
                        self.ir.push_str(" = load ")
                        self.ir.push_str(l_ty)
                        self.ir.push_str(", ptr %")
                        self.ir.push_str(sname)
                        self.ir.push_str(".addr, align 8\n")
                        shadowed_saved.push(saved_r)
                    }
                }
                si = si + 1usize
            }

            let prev_defers_then = self.active_defers.len
            let prev_drops_then = self.active_drops_var.len
            var i = 0usize
            var then_terminates = false
            while i < sp[stmt_id].then_stmts.len {
                let sid = sp[stmt_id].then_stmts.ptr[i]
                if !then_terminates {
                    self.emit_stmt(sid)
                    if self.stmt_terminates(sid) {
                        then_terminates = true
                    }
                }
                i = i + 1usize
            }
            if !then_terminates {
                self.emit_drops_from(prev_drops_then, "")
                self.emit_defers_from(prev_defers_then)
                var ri = 0usize
                while ri < shadowed_names.len {
                    let sname = shadowed_names.ptr[ri].as_ptr() as str
                    let saved_r = shadowed_saved.ptr[ri]
                    let l_ty = self.get_var_type(sname)
                    self.ir.push_str("  store ")
                    self.ir.push_str(l_ty)
                    self.ir.push_str(" %")
                    self.ir.push_str(int_to_str(saved_r).as_ptr() as str)
                    self.ir.push_str(", ptr %")
                    self.ir.push_str(sname)
                    self.ir.push_str(".addr, align 8\n")
                    ri = ri + 1usize
                }
                self.ir.push_str("  br label %if.merge.")
                self.ir.push_str(int_to_str(lbl_merge).as_ptr() as str)
                self.ir.push_str("\n")
            }
            self.pop_drops_to(prev_drops_then)
            while self.active_defers.len > prev_defers_then {
                let _pop_d = self.active_defers.pop()
            }

            self.ir.push_str("if.else.")
            self.ir.push_str(int_to_str(lbl_else).as_ptr() as str)
            self.ir.push_str(":\n")
            let prev_defers_else = self.active_defers.len
            let prev_drops_else = self.active_drops_var.len
            var j = 0usize
            var else_terminates = false
            while j < sp[stmt_id].else_stmts.len {
                let sid = sp[stmt_id].else_stmts.ptr[j]
                if !else_terminates {
                    self.emit_stmt(sid)
                    if self.stmt_terminates(sid) {
                        else_terminates = true
                    }
                }
                j = j + 1usize
            }
            if !else_terminates {
                self.emit_drops_from(prev_drops_else, "")
                self.emit_defers_from(prev_defers_else)
                self.ir.push_str("  br label %if.merge.")
                self.ir.push_str(int_to_str(lbl_merge).as_ptr() as str)
                self.ir.push_str("\n")
            }
            self.pop_drops_to(prev_drops_else)
            while self.active_defers.len > prev_defers_else {
                let _pop_d = self.active_defers.pop()
            }

            if !then_terminates || !else_terminates {
                self.ir.push_str("if.merge.")
                self.ir.push_str(int_to_str(lbl_merge).as_ptr() as str)
                self.ir.push_str(":\n")
            }
        } else if k == STMT_WHILE {
            let lbl_cond = self.alloc_label()
            let lbl_body = self.alloc_label()
            let lbl_end = self.alloc_label()

            self.loop_cond_labels.push(lbl_cond)
            self.loop_end_labels.push(lbl_end)

            self.ir.push_str("  br label %while.cond.")
            self.ir.push_str(int_to_str(lbl_cond).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("while.cond.")
            self.ir.push_str(int_to_str(lbl_cond).as_ptr() as str)
            self.ir.push_str(":\n")
            let cond_reg = self.emit_expr(sp[stmt_id].expr_id)
            let bool_reg = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(bool_reg).as_ptr() as str)
            self.ir.push_str(" = icmp ne i64 %")
            self.ir.push_str(int_to_str(cond_reg).as_ptr() as str)
            self.ir.push_str(", 0\n")
            self.ir.push_str("  br i1 %")
            self.ir.push_str(int_to_str(bool_reg).as_ptr() as str)
            self.ir.push_str(", label %while.body.")
            self.ir.push_str(int_to_str(lbl_body).as_ptr() as str)
            self.ir.push_str(", label %while.end.")
            self.ir.push_str(int_to_str(lbl_end).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("while.body.")
            self.ir.push_str(int_to_str(lbl_body).as_ptr() as str)
            self.ir.push_str(":\n")
            let prev_defers_while = self.active_defers.len
            let prev_drops_while = self.active_drops_var.len
            var i = 0usize
            var body_terminates = false
            while i < sp[stmt_id].body_stmts.len {
                let sid = sp[stmt_id].body_stmts.ptr[i]
                if !body_terminates {
                    self.emit_stmt(sid)
                    if self.stmt_terminates(sid) {
                        body_terminates = true
                    }
                }
                i = i + 1usize
            }
            if !body_terminates {
                self.emit_drops_from(prev_drops_while, "")
                self.emit_defers_from(prev_defers_while)
                self.ir.push_str("  br label %while.cond.")
                self.ir.push_str(int_to_str(lbl_cond).as_ptr() as str)
                self.ir.push_str("\n")
            }
            self.pop_drops_to(prev_drops_while)
            while self.active_defers.len > prev_defers_while {
                let _pop_d = self.active_defers.pop()
            }

            self.ir.push_str("while.end.")
            self.ir.push_str(int_to_str(lbl_end).as_ptr() as str)
            self.ir.push_str(":\n")

            let _pop_cond = self.loop_cond_labels.pop()
            let _pop_end = self.loop_end_labels.pop()
        } else if k == STMT_FOR_RANGE {
            let vname = sp[stmt_id].name.as_ptr() as str
            let range_expr = sp[stmt_id].expr_id
            let start_reg = self.emit_expr(self.parser.exprs.ptr[range_expr].left)
            let end_reg = self.emit_expr(self.parser.exprs.ptr[range_expr].right)

            self.ir.push_str("  store i64 %")
            self.ir.push_str(int_to_str(start_reg).as_ptr() as str)
            self.ir.push_str(", ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, align 8\n")

            let lbl_check = self.alloc_label()
            let lbl_body = self.alloc_label()
            let lbl_inc = self.alloc_label()
            let lbl_end = self.alloc_label()

            self.loop_cond_labels.push(lbl_inc)
            self.loop_end_labels.push(lbl_end)

            self.ir.push_str("  br label %for.check.")
            self.ir.push_str(int_to_str(lbl_check).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("for.check.")
            self.ir.push_str(int_to_str(lbl_check).as_ptr() as str)
            self.ir.push_str(":\n")
            let cur_val = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(cur_val).as_ptr() as str)
            self.ir.push_str(" = load i64, ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, align 8\n")

            let cmp_reg = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
            self.ir.push_str(" = icmp slt i64 %")
            self.ir.push_str(int_to_str(cur_val).as_ptr() as str)
            self.ir.push_str(", %")
            self.ir.push_str(int_to_str(end_reg).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("  br i1 %")
            self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
            self.ir.push_str(", label %for.body.")
            self.ir.push_str(int_to_str(lbl_body).as_ptr() as str)
            self.ir.push_str(", label %while.end.")
            self.ir.push_str(int_to_str(lbl_end).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("for.body.")
            self.ir.push_str(int_to_str(lbl_body).as_ptr() as str)
            self.ir.push_str(":\n")
            let prev_defers_for = self.active_defers.len
            let prev_drops_for = self.active_drops_var.len
            var bi = 0usize
            var body_terminates = false
            while bi < sp[stmt_id].body_stmts.len {
                let sid = sp[stmt_id].body_stmts.ptr[bi]
                if !body_terminates {
                    self.emit_stmt(sid)
                    if self.stmt_terminates(sid) {
                        body_terminates = true
                    }
                }
                bi = bi + 1usize
            }
            if !body_terminates {
                self.emit_drops_from(prev_drops_for, "")
                self.emit_defers_from(prev_defers_for)
                self.ir.push_str("  br label %while.cond.")
                self.ir.push_str(int_to_str(lbl_inc).as_ptr() as str)
                self.ir.push_str("\n")
            }
            self.pop_drops_to(prev_drops_for)
            while self.active_defers.len > prev_defers_for {
                let _pop_d = self.active_defers.pop()
            }

            self.ir.push_str("while.cond.")
            self.ir.push_str(int_to_str(lbl_inc).as_ptr() as str)
            self.ir.push_str(":\n")
            let prev_val = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(prev_val).as_ptr() as str)
            self.ir.push_str(" = load i64, ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, align 8\n")
            let next_val = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(next_val).as_ptr() as str)
            self.ir.push_str(" = add i64 %")
            self.ir.push_str(int_to_str(prev_val).as_ptr() as str)
            self.ir.push_str(", 1\n")
            self.ir.push_str("  store i64 %")
            self.ir.push_str(int_to_str(next_val).as_ptr() as str)
            self.ir.push_str(", ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, align 8\n")
            self.ir.push_str("  br label %for.check.")
            self.ir.push_str(int_to_str(lbl_check).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("while.end.")
            self.ir.push_str(int_to_str(lbl_end).as_ptr() as str)
            self.ir.push_str(":\n")

            let _pop_c = self.loop_cond_labels.pop()
            let _pop_e = self.loop_end_labels.pop()
        } else if k == STMT_FOR_IN {
            let vname = sp[stmt_id].name.as_ptr() as str
            let coll_expr = sp[stmt_id].expr_id
            var coll_reg = self.emit_expr(coll_expr)
            if !self.is_expr_ptr(coll_expr) {
                let cvt = self.alloc_ssa()
                self.ir.push_str("  %")
                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                self.ir.push_str(" = inttoptr i64 %")
                self.ir.push_str(int_to_str(coll_reg).as_ptr() as str)
                self.ir.push_str(" to ptr\n")
                coll_reg = cvt
            }

            let lbl_check = self.alloc_label()
            let lbl_body = self.alloc_label()
            let lbl_inc = self.alloc_label()
            let lbl_end = self.alloc_label()

            var idx_name = String.new()
            idx_name.push_str("_for_idx_")
            idx_name.push_str(int_to_str(stmt_id as i32).as_ptr() as str)

            self.ir.push_str("  store i64 0, ptr %")
            self.ir.push_str(idx_name.as_ptr() as str)
            self.ir.push_str(".addr, align 8\n")

            self.loop_cond_labels.push(lbl_inc)
            self.loop_end_labels.push(lbl_end)

            self.ir.push_str("  br label %for.check.")
            self.ir.push_str(int_to_str(lbl_check).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("for.check.")
            self.ir.push_str(int_to_str(lbl_check).as_ptr() as str)
            self.ir.push_str(":\n")
            let cur_idx = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(cur_idx).as_ptr() as str)
            self.ir.push_str(" = load i64, ptr %")
            self.ir.push_str(idx_name.as_ptr() as str)
            self.ir.push_str(".addr, align 8\n")

            let len_gep = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(len_gep).as_ptr() as str)
            self.ir.push_str(" = getelementptr inbounds i64, ptr %")
            self.ir.push_str(int_to_str(coll_reg).as_ptr() as str)
            self.ir.push_str(", i64 2\n")
            let len_val = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(len_val).as_ptr() as str)
            self.ir.push_str(" = load i64, ptr %")
            self.ir.push_str(int_to_str(len_gep).as_ptr() as str)
            self.ir.push_str(", align 8\n")

            let cmp_reg = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
            self.ir.push_str(" = icmp slt i64 %")
            self.ir.push_str(int_to_str(cur_idx).as_ptr() as str)
            self.ir.push_str(", %")
            self.ir.push_str(int_to_str(len_val).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("  br i1 %")
            self.ir.push_str(int_to_str(cmp_reg).as_ptr() as str)
            self.ir.push_str(", label %for.body.")
            self.ir.push_str(int_to_str(lbl_body).as_ptr() as str)
            self.ir.push_str(", label %while.end.")
            self.ir.push_str(int_to_str(lbl_end).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("for.body.")
            self.ir.push_str(int_to_str(lbl_body).as_ptr() as str)
            self.ir.push_str(":\n")
            let elem_ty = self.get_var_type(vname)
            let is_ptr = str_eq(elem_ty, "ptr")
            let buf_ptr = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(buf_ptr).as_ptr() as str)
            self.ir.push_str(" = load ptr, ptr %")
            self.ir.push_str(int_to_str(coll_reg).as_ptr() as str)
            self.ir.push_str(", align 8\n")
            let elem_gep = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(elem_gep).as_ptr() as str)
            if is_ptr {
                self.ir.push_str(" = getelementptr inbounds ptr, ptr %")
            } else {
                self.ir.push_str(" = getelementptr inbounds i64, ptr %")
            }
            self.ir.push_str(int_to_str(buf_ptr).as_ptr() as str)
            self.ir.push_str(", i64 %")
            self.ir.push_str(int_to_str(cur_idx).as_ptr() as str)
            self.ir.push_str("\n")
            let elem_val = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(elem_val).as_ptr() as str)
            if is_ptr {
                self.ir.push_str(" = load ptr, ptr %")
            } else {
                self.ir.push_str(" = load i64, ptr %")
            }
            self.ir.push_str(int_to_str(elem_gep).as_ptr() as str)
            self.ir.push_str(", align 8\n")
            if is_ptr {
                self.ir.push_str("  store ptr %")
            } else {
                self.ir.push_str("  store i64 %")
            }
            self.ir.push_str(int_to_str(elem_val).as_ptr() as str)
            self.ir.push_str(", ptr %")
            self.ir.push_str(vname)
            self.ir.push_str(".addr, align 8\n")

            let prev_defers_for_in = self.active_defers.len
            let prev_drops_for_in = self.active_drops_var.len
            var bi = 0usize
            var body_terminates = false
            while bi < sp[stmt_id].body_stmts.len {
                let sid = sp[stmt_id].body_stmts.ptr[bi]
                if !body_terminates {
                    self.emit_stmt(sid)
                    if self.stmt_terminates(sid) {
                        body_terminates = true
                    }
                }
                bi = bi + 1usize
            }
            if !body_terminates {
                self.emit_drops_from(prev_drops_for_in, "")
                self.emit_defers_from(prev_defers_for_in)
                self.ir.push_str("  br label %while.cond.")
                self.ir.push_str(int_to_str(lbl_inc).as_ptr() as str)
                self.ir.push_str("\n")
            }
            self.pop_drops_to(prev_drops_for_in)
            while self.active_defers.len > prev_defers_for_in {
                let _pop_d = self.active_defers.pop()
            }

            self.ir.push_str("while.cond.")
            self.ir.push_str(int_to_str(lbl_inc).as_ptr() as str)
            self.ir.push_str(":\n")
            let prev_idx = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(prev_idx).as_ptr() as str)
            self.ir.push_str(" = load i64, ptr %")
            self.ir.push_str(idx_name.as_ptr() as str)
            self.ir.push_str(".addr, align 8\n")
            let next_idx = self.alloc_ssa()
            self.ir.push_str("  %")
            self.ir.push_str(int_to_str(next_idx).as_ptr() as str)
            self.ir.push_str(" = add i64 %")
            self.ir.push_str(int_to_str(prev_idx).as_ptr() as str)
            self.ir.push_str(", 1\n")
            self.ir.push_str("  store i64 %")
            self.ir.push_str(int_to_str(next_idx).as_ptr() as str)
            self.ir.push_str(", ptr %")
            self.ir.push_str(idx_name.as_ptr() as str)
            self.ir.push_str(".addr, align 8\n")
            self.ir.push_str("  br label %for.check.")
            self.ir.push_str(int_to_str(lbl_check).as_ptr() as str)
            self.ir.push_str("\n")

            self.ir.push_str("while.end.")
            self.ir.push_str(int_to_str(lbl_end).as_ptr() as str)
            self.ir.push_str(":\n")

            let _pop_c = self.loop_cond_labels.pop()
            let _pop_e = self.loop_end_labels.pop()
        } else if k == STMT_BREAK {
            if self.loop_end_labels.len > 0usize {
                let end_lbl = self.loop_end_labels.ptr[self.loop_end_labels.len - 1usize]
                self.ir.push_str("  br label %while.end.")
                self.ir.push_str(int_to_str(end_lbl).as_ptr() as str)
                self.ir.push_str("\n")
            }
        } else if k == STMT_CONTINUE {
            if self.loop_cond_labels.len > 0usize {
                let cond_lbl = self.loop_cond_labels.ptr[self.loop_cond_labels.len - 1usize]
                self.ir.push_str("  br label %while.cond.")
                self.ir.push_str(int_to_str(cond_lbl).as_ptr() as str)
                self.ir.push_str("\n")
            }
        } else if k == STMT_RETURN {
            if sp[stmt_id].expr_id != 0usize {
                let ret_eid = sp[stmt_id].expr_id
                var skip_vname = ""
                if self.parser.exprs.ptr[ret_eid].kind == EXPR_IDENT {
                    skip_vname = self.parser.exprs.ptr[ret_eid].str_val.as_ptr() as str
                }
                let r = self.emit_expr(ret_eid)
                self.emit_drops_from(0usize, skip_vname)
                self.emit_defers_from(0usize)
                let ret_ty = self.current_ret_type.as_ptr() as str
                if str_eq(ret_ty, "void") {
                    self.ir.push_str("  ret void\n")
                } else if str_eq(ret_ty, "i32") {
                    let tr = self.alloc_ssa()
                    self.ir.push_str("  %")
                    self.ir.push_str(int_to_str(tr).as_ptr() as str)
                    self.ir.push_str(" = trunc i64 %")
                    self.ir.push_str(int_to_str(r).as_ptr() as str)
                    self.ir.push_str(" to i32\n")
                    self.ir.push_str("  ret i32 %")
                    self.ir.push_str(int_to_str(tr).as_ptr() as str)
                    self.ir.push_str("\n")
                } else if str_eq(ret_ty, "ptr") {
                    var final_reg = r + 0
                    if !self.is_expr_ptr(sp[stmt_id].expr_id) {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        self.ir.push_str(" = inttoptr i64 %")
                        self.ir.push_str(int_to_str(r).as_ptr() as str)
                        self.ir.push_str(" to ptr\n")
                        final_reg = cvt
                    }
                    self.ir.push_str("  ret ptr %")
                    self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                    self.ir.push_str("\n")
                } else if str_eq(ret_ty, "float") {
                    var final_reg = r + 0
                    if !self.is_expr_float(sp[stmt_id].expr_id) {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        self.ir.push_str(" = sitofp i64 %")
                        self.ir.push_str(int_to_str(r).as_ptr() as str)
                        self.ir.push_str(" to float\n")
                        final_reg = cvt
                    } else if !self.is_expr_f32(sp[stmt_id].expr_id) {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        self.ir.push_str(" = fptrunc double %")
                        self.ir.push_str(int_to_str(r).as_ptr() as str)
                        self.ir.push_str(" to float\n")
                        final_reg = cvt
                    }
                    self.ir.push_str("  ret float %")
                    self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                    self.ir.push_str("\n")
                } else if str_eq(ret_ty, "double") {
                    var final_reg = r + 0
                    if !self.is_expr_float(sp[stmt_id].expr_id) {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        self.ir.push_str(" = sitofp i64 %")
                        self.ir.push_str(int_to_str(r).as_ptr() as str)
                        self.ir.push_str(" to double\n")
                        final_reg = cvt
                    } else if self.is_expr_f32(sp[stmt_id].expr_id) {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        self.ir.push_str(" = fpext float %")
                        self.ir.push_str(int_to_str(r).as_ptr() as str)
                        self.ir.push_str(" to double\n")
                        final_reg = cvt
                    }
                    self.ir.push_str("  ret double %")
                    self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                    self.ir.push_str("\n")
                } else {
                    var final_reg = r + 0
                    if self.is_expr_ptr(sp[stmt_id].expr_id) {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        self.ir.push_str(" = ptrtoint ptr %")
                        self.ir.push_str(int_to_str(r).as_ptr() as str)
                        self.ir.push_str(" to i64\n")
                        final_reg = cvt
                    } else if self.is_expr_float(sp[stmt_id].expr_id) {
                        let cvt = self.alloc_ssa()
                        self.ir.push_str("  %")
                        self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                        if self.is_expr_f32(sp[stmt_id].expr_id) {
                            self.ir.push_str(" = fptosi float %")
                        } else {
                            self.ir.push_str(" = fptosi double %")
                        }
                        self.ir.push_str(int_to_str(r).as_ptr() as str)
                        self.ir.push_str(" to i64\n")
                        final_reg = cvt
                    }
                    self.ir.push_str("  ret i64 %")
                    self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                    self.ir.push_str("\n")
                }
            } else {
                self.emit_drops_from(0usize, "")
                self.emit_defers_from(0usize)
                self.ir.push_str("  ret void\n")
            }
        } else if k == STMT_DEFER {
            self.active_defers.push(stmt_id)
        } else if k == STMT_EXPR {
            self.emit_expr(sp[stmt_id].expr_id)
        }
    }

    fn allocate_local_var(var self, name: str) {
        var found = false
        var i = 0usize
        while i < self.allocated_vars.len {
            if str_eq(self.allocated_vars.ptr[i].as_ptr() as str, name) {
                found = true
                break
            }
            i = i + 1usize
        }
        if !found {
            self.allocated_vars.push(String.from_str(name))
            let llvm_ty = self.get_var_type(name)
            self.fn_allocas.push_str("  %")
            self.fn_allocas.push_str(name)
            self.fn_allocas.push_str(".addr = alloca ")
            self.fn_allocas.push_str(llvm_ty)
            self.fn_allocas.push_str(", align 8\n")
        }
    }

    fn collect_allocas_stmt(var self, stmt_id: usize) {
        let sp = self.parser.stmts.ptr
        let k = sp[stmt_id].kind
        if k == STMT_LET || k == STMT_VAR {
            let vname = sp[stmt_id].name.as_ptr() as str
            self.allocate_local_var(vname)
        } else if k == STMT_IF {
            var i = 0usize
            while i < sp[stmt_id].then_stmts.len {
                self.collect_allocas_stmt(sp[stmt_id].then_stmts.ptr[i])
                i = i + 1usize
            }
            i = 0usize
            while i < sp[stmt_id].else_stmts.len {
                self.collect_allocas_stmt(sp[stmt_id].else_stmts.ptr[i])
                i = i + 1usize
            }
        } else if k == STMT_WHILE {
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.collect_allocas_stmt(sp[stmt_id].body_stmts.ptr[i])
                i = i + 1usize
            }
        } else if k == STMT_FOR_RANGE {
            let vname = sp[stmt_id].name.as_ptr() as str
            self.allocate_local_var(vname)
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.collect_allocas_stmt(sp[stmt_id].body_stmts.ptr[i])
                i = i + 1usize
            }
        } else if k == STMT_FOR_IN {
            let vname = sp[stmt_id].name.as_ptr() as str
            self.allocate_local_var(vname)
            var idx_name = String.new()
            idx_name.push_str("_for_idx_")
            idx_name.push_str(int_to_str(stmt_id as i32).as_ptr() as str)
            self.allocate_local_var(idx_name.as_ptr() as str)
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.collect_allocas_stmt(sp[stmt_id].body_stmts.ptr[i])
                i = i + 1usize
            }
        } else if k == STMT_DEFER {
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.collect_allocas_stmt(sp[stmt_id].body_stmts.ptr[i])
                i = i + 1usize
            }
        }
    }

    fn collect_mutations_in_expr(self, expr_id: usize, var mutated: Vec<String>) {
        if expr_id == 0usize {
            return
        }
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_METHOD_CALL {
            let left_id = ep[expr_id].left
            if ep[left_id].kind == EXPR_IDENT {
                mutated.push(ep[left_id].str_val)
            }
            self.collect_mutations_in_expr(left_id, mutated)
            var ai = 0usize
            while ai < ep[expr_id].args.len {
                self.collect_mutations_in_expr(ep[expr_id].args.ptr[ai], mutated)
                ai = ai + 1usize
            }
        } else if k == EXPR_CALL {
            let callee_id = ep[expr_id].left
            if ep[callee_id].kind == EXPR_IDENT {
                let cname = ep[callee_id].str_val.as_ptr() as str
                if str_eq(cname, "swap") {
                    var si = 0usize
                    while si < ep[expr_id].args.len {
                        let arg_id = ep[expr_id].args.ptr[si]
                        if ep[arg_id].kind == EXPR_IDENT {
                            mutated.push(ep[arg_id].str_val)
                        } else if ep[arg_id].kind == EXPR_UNARY && ep[ep[arg_id].left].kind == EXPR_IDENT {
                            mutated.push(ep[ep[arg_id].left].str_val)
                        }
                        si = si + 1usize
                    }
                }
            }
            var ai = 0usize
            while ai < ep[expr_id].args.len {
                self.collect_mutations_in_expr(ep[expr_id].args.ptr[ai], mutated)
                ai = ai + 1usize
            }
        } else if k == EXPR_BINARY {
            self.collect_mutations_in_expr(ep[expr_id].left, mutated)
            self.collect_mutations_in_expr(ep[expr_id].right, mutated)
        } else if k == EXPR_UNARY || k == EXPR_CAST || k == EXPR_FIELD_ACCESS || k == EXPR_AWAIT {
            if k == EXPR_FIELD_ACCESS && ep[ep[expr_id].left].kind == EXPR_IDENT {
                mutated.push(ep[ep[expr_id].left].str_val)
            }
            self.collect_mutations_in_expr(ep[expr_id].left, mutated)
        } else if k == EXPR_INDEX {
            self.collect_mutations_in_expr(ep[expr_id].left, mutated)
            self.collect_mutations_in_expr(ep[expr_id].right, mutated)
        } else if k == EXPR_ARRAY_LITERAL {
            var ai = 0usize
            while ai < ep[expr_id].args.len {
                self.collect_mutations_in_expr(ep[expr_id].args.ptr[ai], mutated)
                ai = ai + 1usize
            }
        } else if k == EXPR_RANGE {
            self.collect_mutations_in_expr(ep[expr_id].left, mutated)
            self.collect_mutations_in_expr(ep[expr_id].right, mutated)
        }
    }

    fn collect_mutated_vars(self, stmt_id: usize, var mutated: Vec<String>) {
        let sp = self.parser.stmts.ptr
        let k = sp[stmt_id].kind
        if k == STMT_ASSIGN {
            mutated.push(sp[stmt_id].name)
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
        } else if k == STMT_ASSIGN_INDEX {
            mutated.push(sp[stmt_id].name)
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
            self.collect_mutations_in_expr(sp[stmt_id].index_expr, mutated)
            if sp[stmt_id].then_stmts.len > 0usize {
                self.collect_mutations_in_expr(sp[stmt_id].then_stmts.ptr[0usize], mutated)
            }
        } else if k == STMT_ASSIGN_FIELD {
            let recv = sp[stmt_id].index_expr
            if self.parser.exprs.ptr[recv].kind == EXPR_IDENT {
                mutated.push(self.parser.exprs.ptr[recv].str_val)
            }
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
            self.collect_mutations_in_expr(recv, mutated)
        } else if k == STMT_EXPR || k == STMT_RETURN {
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
        } else if k == STMT_LET || k == STMT_VAR {
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
        } else if k == STMT_IF {
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
            var i = 0usize
            while i < sp[stmt_id].then_stmts.len {
                self.collect_mutated_vars(sp[stmt_id].then_stmts.ptr[i], mutated)
                i = i + 1usize
            }
            i = 0usize
            while i < sp[stmt_id].else_stmts.len {
                self.collect_mutated_vars(sp[stmt_id].else_stmts.ptr[i], mutated)
                i = i + 1usize
            }
        } else if k == STMT_WHILE {
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.collect_mutated_vars(sp[stmt_id].body_stmts.ptr[i], mutated)
                i = i + 1usize
            }
        } else if k == STMT_FOR_RANGE {
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
            self.collect_mutations_in_expr(sp[stmt_id].index_expr, mutated)
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.collect_mutated_vars(sp[stmt_id].body_stmts.ptr[i], mutated)
                i = i + 1usize
            }
        } else if k == STMT_FOR_IN {
            self.collect_mutations_in_expr(sp[stmt_id].expr_id, mutated)
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.collect_mutated_vars(sp[stmt_id].body_stmts.ptr[i], mutated)
                i = i + 1usize
            }
        } else if k == STMT_DEFER {
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.collect_mutated_vars(sp[stmt_id].body_stmts.ptr[i], mutated)
                i = i + 1usize
            }
        }
    }

    fn check_unused_var_mutability(var self, stmt_id: usize, mutated: Vec<String>) {
        let sp = self.parser.stmts.ptr
        let k = sp[stmt_id].kind
        if k == STMT_VAR {
            let vname = sp[stmt_id].name.as_ptr() as str
            if !str_starts_with(vname, "_") {
                var was_mutated = false
                var mi = 0usize
                while mi < mutated.len {
                    if str_eq(mutated.ptr[mi].as_ptr() as str, vname) {
                        was_mutated = true
                        break
                    }
                    mi = mi + 1usize
                }
                if !was_mutated {
                    var warn_msg = String.new()
                    warn_msg.push_str("variable does not need to be mutable: 'var ")
                    warn_msg.push_str(vname)
                    warn_msg.push_str("' (consider using 'let ")
                    warn_msg.push_str(vname)
                    warn_msg.push_str("')")
                    let span = 4i64 + str_len(vname) as i64
                    self.parser.report_warning_span("W0001", warn_msg.as_ptr() as str, sp[stmt_id].stmt_line, sp[stmt_id].stmt_col, span)
                }
            }
        } else if k == STMT_IF {
            var i = 0usize
            while i < sp[stmt_id].then_stmts.len {
                self.check_unused_var_mutability(sp[stmt_id].then_stmts.ptr[i], mutated)
                i = i + 1usize
            }
            i = 0usize
            while i < sp[stmt_id].else_stmts.len {
                self.check_unused_var_mutability(sp[stmt_id].else_stmts.ptr[i], mutated)
                i = i + 1usize
            }
        } else if k == STMT_WHILE || k == STMT_FOR_RANGE || k == STMT_FOR_IN || k == STMT_DEFER {
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                self.check_unused_var_mutability(sp[stmt_id].body_stmts.ptr[i], mutated)
                i = i + 1usize
            }
        }
    }

    fn generate(var self) -> String {
        var header = String.new()
        header.push_str("; ModuleID = 'radc_compiled'\n")
        header.push_str("source_filename = \"rad\"\n")
        if str_starts_with(self.target.as_ptr() as str, "wasm32") {
            header.push_str("target datalayout = \"e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128\"\n")
            header.push_str("target triple = \"wasm32-unknown-unknown\"\n\n")
        } else {
            header.push_str("target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"\n")
            header.push_str("target triple = \"")
            header.push_str(self.target.as_ptr() as str)
            header.push_str("\"\n\n")
        }

        header.push_str("declare ptr @malloc(i64)\n")
        header.push_str("declare void @free(ptr)\n")
        header.push_str("declare ptr @realloc(ptr, i64)\n")
        header.push_str("declare i32 @system(ptr)\n")
        header.push_str("declare i32 @puts(ptr)\n")
        header.push_str("declare i32 @printf(ptr, ...)\n")
        header.push_str("declare ptr @fopen(ptr, ptr)\n")
        header.push_str("declare i32 @fclose(ptr)\n")
        header.push_str("declare i64 @fread(ptr, i64, i64, ptr)\n")
        header.push_str("declare i64 @fwrite(ptr, i64, i64, ptr)\n")
        header.push_str("declare i32 @fseek(ptr, i64, i32)\n")
        header.push_str("declare i64 @ftell(ptr)\n")
        header.push_str("declare ptr @getenv(ptr)\n")
        header.push_str("declare i32 @strcmp(ptr, ptr)\n")
        header.push_str("declare void @exit(i32)\n")
        header.push_str("declare i32 @dprintf(i32, ptr, ...)\n")
        header.push_str("declare double @sqrt(double)\n")
        header.push_str("declare i32 @remove(ptr)\n")
        header.push_str("declare i32 @getchar()\n")
        header.push_str("declare i32 @fflush(ptr)\n")
        header.push_str("declare i32 @atexit(ptr)\n\n")

        // Emit extern function declarations
        var ext_i = 0usize
        while ext_i < self.parser.functions.len {
            let func = self.parser.functions.ptr[ext_i]
            if func.body.len == 0usize {
                let fname = func.fn_name.as_ptr() as str
                if !str_eq(fname, "malloc") && !str_eq(fname, "free") && !str_eq(fname, "realloc") &&
                   !str_eq(fname, "system") && !str_eq(fname, "puts") && !str_eq(fname, "printf") &&
                   !str_eq(fname, "fopen") && !str_eq(fname, "fclose") && !str_eq(fname, "fread") &&
                   !str_eq(fname, "fwrite") && !str_eq(fname, "fseek") && !str_eq(fname, "ftell") &&
                   !str_eq(fname, "getenv") && !str_eq(fname, "strcmp") && !str_eq(fname, "exit") &&
                   !str_eq(fname, "dprintf") && !str_eq(fname, "sqrt") && !str_eq(fname, "remove") &&
                   !str_eq(fname, "getchar") && !str_eq(fname, "fflush") && !str_eq(fname, "input") &&
                   !str_starts_with(fname, "__rad_") && !str_eq(fname, "atexit") &&
                   !str_starts_with(fname, "atomic_") &&
                   !str_starts_with(fname, "syscall") {
                    var already_declared = false
                    var prev_i = 0usize
                    while prev_i < ext_i {
                        if str_eq(self.parser.functions.ptr[prev_i].fn_name.as_ptr() as str, fname) {
                            already_declared = true
                            break
                        }
                        prev_i = prev_i + 1usize
                    }
                    if !already_declared {
                        header.push_str("declare ")
                        header.push_str(self.emit_llvm_type(func.ret_type.as_ptr() as str))
                        header.push_str(" @")
                        header.push_str(fname)
                        header.push_str("(")
                        var pi = 0usize
                        while pi < func.param_types.len {
                            if pi > 0usize {
                                header.push_str(", ")
                            }
                            header.push_str(self.emit_llvm_type(func.param_types.ptr[pi].as_ptr() as str))
                            pi = pi + 1usize
                        }
                        header.push_str(")\n")
                    }
                }
            }
            ext_i = ext_i + 1usize
        }
        header.push_str("\n")

        // Emit vtables for trait implementations
        var vti = 0usize
        while vti < self.parser.trait_impls.len {
            let t_impl = self.parser.trait_impls.ptr[vti]
            let t_name = t_impl.trait_name.as_ptr() as str
            let s_name = t_impl.target_struct_name.as_ptr() as str
            var tr_idx = 0usize
            var found_tr = false
            while tr_idx < self.parser.traits.len {
                if str_eq(self.parser.traits.ptr[tr_idx].trait_name.as_ptr() as str, t_name) {
                    found_tr = true
                    break
                }
                tr_idx = tr_idx + 1usize
            }
            if found_tr {
                let tr_def = self.parser.traits.ptr[tr_idx]
                let m_count = tr_def.methods.len
                if m_count > 0usize {
                    header.push_str("@_vtable_")
                    header.push_str(s_name)
                    header.push_str("_")
                    header.push_str(t_name)
                    header.push_str(" = internal constant [")
                    header.push_str(int_to_str(m_count as i32).as_ptr() as str)
                    header.push_str(" x ptr] [")
                    var mi = 0usize
                    while mi < m_count {
                        if mi > 0usize {
                            header.push_str(", ")
                        }
                        header.push_str("ptr @")
                        header.push_str(s_name)
                        header.push_str("__")
                        header.push_str(tr_def.methods.ptr[mi].method_name.as_ptr() as str)
                        mi = mi + 1usize
                    }
                    header.push_str("]\n")
                }
            }
            vti = vti + 1usize
        }
        header.push_str("\n")

        header.push_str("@.empty_str = private unnamed_addr constant [1 x i8] c\"\\00\", align 1\n")
        header.push_str("@.fprint_fmt = private unnamed_addr constant [4 x i8] c\"%f\\0A\\00\", align 1\n")
        header.push_str("@.iprint_fmt = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\", align 1\n")
        header.push_str("@.fprint_nonl_fmt = private unnamed_addr constant [3 x i8] c\"%f\\00\", align 1\n")
        header.push_str("@.iprint_nonl_fmt = private unnamed_addr constant [5 x i8] c\"%lld\\00\", align 1\n")
        header.push_str("@.sprint_nonl_fmt = private unnamed_addr constant [3 x i8] c\"%s\\00\", align 1\n\n")

        header.push_str("define ptr @new() {\nentry:\n  %obj = call ptr @malloc(i64 24)\n  %buf = call ptr @malloc(i64 512)\n  store i8 0, ptr %buf, align 1\n  store ptr %buf, ptr %obj, align 8\n  %cap_ptr = getelementptr inbounds i8, ptr %obj, i64 8\n  store i64 64, ptr %cap_ptr, align 8\n  %len_ptr = getelementptr inbounds i8, ptr %obj, i64 16\n  store i64 0, ptr %len_ptr, align 8\n  ret ptr %obj\n}\n\n")

        header.push_str("define ptr @as_ptr(ptr %obj) {\nentry:\n  %is_null = icmp eq ptr %obj, null\n  br i1 %is_null, label %ret_empty, label %load_buf\nret_empty:\n  ret ptr @.empty_str\nload_buf:\n  %buf = load ptr, ptr %obj, align 8\n  %buf_is_null = icmp eq ptr %buf, null\n  br i1 %buf_is_null, label %ret_empty, label %ret_buf\nret_buf:\n  ret ptr %buf\n}\n\n")

        header.push_str("define i64 @len(ptr %obj) {\nentry:\n  %is_null = icmp eq ptr %obj, null\n  br i1 %is_null, label %ret_zero, label %load_len\nret_zero:\n  ret i64 0\nload_len:\n  %len_ptr = getelementptr inbounds i8, ptr %obj, i64 16\n  %len = load i64, ptr %len_ptr, align 8\n  ret i64 %len\n}\n\n")

        header.push_str("define void @push_byte(ptr %obj, i64 %b) {\nentry:\n  %is_null = icmp eq ptr %obj, null\n  br i1 %is_null, label %exit, label %do_push\ndo_push:\n  %buf_slot = getelementptr inbounds i8, ptr %obj, i64 0\n  %cap_slot = getelementptr inbounds i8, ptr %obj, i64 8\n  %len_slot = getelementptr inbounds i8, ptr %obj, i64 16\n  %buf = load ptr, ptr %buf_slot, align 8\n  %cap = load i64, ptr %cap_slot, align 8\n  %len = load i64, ptr %len_slot, align 8\n  %len_p2 = add i64 %len, 2\n  %needs_grow = icmp uge i64 %len_p2, %cap\n  br i1 %needs_grow, label %grow, label %write_byte\ngrow:\n  %new_cap = shl i64 %cap, 1\n  %adj_cap_cond = icmp ult i64 %new_cap, 512\n  %adj_cap = select i1 %adj_cap_cond, i64 512, i64 %new_cap\n  %new_buf = call ptr @realloc(ptr %buf, i64 %adj_cap)\n  store ptr %new_buf, ptr %buf_slot, align 8\n  store i64 %adj_cap, ptr %cap_slot, align 8\n  br label %write_byte\nwrite_byte:\n  %cur_buf = phi ptr [ %buf, %do_push ], [ %new_buf, %grow ]\n  %byte_i8 = trunc i64 %b to i8\n  %b_ptr = getelementptr inbounds i8, ptr %cur_buf, i64 %len\n  store i8 %byte_i8, ptr %b_ptr, align 1\n  %new_len = add i64 %len, 1\n  %term_ptr = getelementptr inbounds i8, ptr %cur_buf, i64 %new_len\n  store i8 0, ptr %term_ptr, align 1\n  store i64 %new_len, ptr %len_slot, align 8\n  br label %exit\nexit:\n  ret void\n}\n\n")

        header.push_str("define void @push(ptr %obj, i64 %item) {\nentry:\n  %is_null = icmp eq ptr %obj, null\n  br i1 %is_null, label %exit, label %do_push\ndo_push:\n  %buf_slot = getelementptr inbounds i8, ptr %obj, i64 0\n  %cap_slot = getelementptr inbounds i8, ptr %obj, i64 8\n  %len_slot = getelementptr inbounds i8, ptr %obj, i64 16\n  %buf = load ptr, ptr %buf_slot, align 8\n  %cap = load i64, ptr %cap_slot, align 8\n  %len = load i64, ptr %len_slot, align 8\n  %needs_grow = icmp uge i64 %len, %cap\n  br i1 %needs_grow, label %grow, label %write_item\ngrow:\n  %new_cap = shl i64 %cap, 1\n  %adj_cap_cond = icmp ult i64 %new_cap, 64\n  %adj_cap = select i1 %adj_cap_cond, i64 64, i64 %new_cap\n  %bytes = shl i64 %adj_cap, 3\n  %new_buf = call ptr @realloc(ptr %buf, i64 %bytes)\n  store ptr %new_buf, ptr %buf_slot, align 8\n  store i64 %adj_cap, ptr %cap_slot, align 8\n  br label %write_item\nwrite_item:\n  %cur_buf = phi ptr [ %buf, %do_push ], [ %new_buf, %grow ]\n  %slot = getelementptr inbounds i64, ptr %cur_buf, i64 %len\n  store i64 %item, ptr %slot, align 8\n  %new_len = add i64 %len, 1\n  store i64 %new_len, ptr %len_slot, align 8\n  br label %exit\nexit:\n  ret void\n}\n\n")

        header.push_str("define i64 @pop(ptr %obj) {\nentry:\n  %is_null = icmp eq ptr %obj, null\n  br i1 %is_null, label %exit_zero, label %do_pop\ndo_pop:\n  %len_slot = getelementptr inbounds i8, ptr %obj, i64 16\n  %len = load i64, ptr %len_slot, align 8\n  %is_empty = icmp eq i64 %len, 0\n  br i1 %is_empty, label %exit_zero, label %do_dec\ndo_dec:\n  %new_len = sub i64 %len, 1\n  store i64 %new_len, ptr %len_slot, align 8\n  %buf_slot = getelementptr inbounds i8, ptr %obj, i64 0\n  %buf = load ptr, ptr %buf_slot, align 8\n  %slot = getelementptr inbounds i64, ptr %buf, i64 %new_len\n  %val = load i64, ptr %slot, align 8\n  ret i64 %val\nexit_zero:\n  ret i64 0\n}\n\n")

        header.push_str("define void @push_str(ptr %obj, ptr %src) {\nentry:\n  %is_null = icmp eq ptr %src, null\n  br i1 %is_null, label %exit, label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %next_i, %body ]\n  %char_ptr = getelementptr inbounds i8, ptr %src, i64 %i\n  %ch = load i8, ptr %char_ptr, align 1\n  %is_end = icmp eq i8 %ch, 0\n  br i1 %is_end, label %exit, label %body\nbody:\n  %ch_i64 = zext i8 %ch to i64\n  call void @push_byte(ptr %obj, i64 %ch_i64)\n  %next_i = add i64 %i, 1\n  br label %loop\nexit:\n  ret void\n}\n\n")

        header.push_str("define ptr @from_str(ptr %src) {\nentry:\n  %s = call ptr @new()\n  call void @push_str(ptr %s, ptr %src)\n  ret ptr %s\n}\n\n")

        var has_user_input = false
        var fi_chk_in = 0usize
        while fi_chk_in < self.parser.functions.len {
            if str_eq(self.parser.functions.ptr[fi_chk_in].fn_name.as_ptr() as str, "input") {
                has_user_input = true
                break
            }
            fi_chk_in = fi_chk_in + 1usize
        }
        if !has_user_input {
            header.push_str("define ptr @input(ptr %prompt) {\nentry:\n  %has_prompt = icmp ne ptr %prompt, null\n  br i1 %has_prompt, label %print_p, label %do_read\nprint_p:\n  %p_res = call i32 (ptr, ...) @printf(ptr @.sprint_nonl_fmt, ptr %prompt)\n  br label %do_read\ndo_read:\n  %f_res = call i32 @fflush(ptr null)\n  %s = call ptr @new()\n  br label %loop\nloop:\n  %ch = call i32 @getchar()\n  %is_eof = icmp eq i32 %ch, -1\n  br i1 %is_eof, label %done, label %check_nl\ncheck_nl:\n  %is_nl = icmp eq i32 %ch, 10\n  br i1 %is_nl, label %done, label %check_cr\ncheck_cr:\n  %is_cr = icmp eq i32 %ch, 13\n  br i1 %is_cr, label %loop, label %push_c\npush_c:\n  %ch_i64 = sext i32 %ch to i64\n  call void @push_byte(ptr %s, i64 %ch_i64)\n  br label %loop\ndone:\n  ret ptr %s\n}\n\n")
        }

        var has_user_get = false
        var fi_chk = 0usize
        while fi_chk < self.parser.functions.len {
            if str_eq(self.parser.functions.ptr[fi_chk].fn_name.as_ptr() as str, "get") {
                has_user_get = true
                break
            }
            fi_chk = fi_chk + 1usize
        }
        if !has_user_get {
            header.push_str("define i64 @get(ptr %obj, i64 %idx) {\nentry:\n  %buf_slot = getelementptr inbounds i8, ptr %obj, i64 0\n  %buf = load ptr, ptr %buf_slot, align 8\n  %slot = getelementptr inbounds i64, ptr %buf, i64 %idx\n  %val = load i64, ptr %slot, align 8\n  ret i64 %val\n}\n\n")
        }

        header.push_str("define void @insert(ptr %obj, ptr %key, i64 %val) {\nentry:\n  ret void\n}\n\n")

        header.push_str("define void @drop(ptr %obj) {\nentry:\n  %is_null = icmp eq ptr %obj, null\n  br i1 %is_null, label %exit, label %do_drop\ndo_drop:\n  %buf_slot = getelementptr inbounds i8, ptr %obj, i64 0\n  %buf = load ptr, ptr %buf_slot, align 8\n  %buf_is_null = icmp eq ptr %buf, null\n  br i1 %buf_is_null, label %zero_fields, label %free_buf\nfree_buf:\n  call void @free(ptr %buf)\n  store ptr null, ptr %buf_slot, align 8\n  br label %zero_fields\nzero_fields:\n  %cap_slot = getelementptr inbounds i8, ptr %obj, i64 8\n  store i64 0, ptr %cap_slot, align 8\n  %len_slot = getelementptr inbounds i8, ptr %obj, i64 16\n  store i64 0, ptr %len_slot, align 8\n  br label %exit\nexit:\n  ret void\n}\n\n")

        header.push_str("define i64 @atomic_load_i64(ptr %p) {\nentry:\n  %v = load atomic i64, ptr %p seq_cst, align 8\n  ret i64 %v\n}\n\n")
        header.push_str("define void @atomic_store_i64(ptr %p, i64 %v) {\nentry:\n  store atomic i64 %v, ptr %p seq_cst, align 8\n  ret void\n}\n\n")
        header.push_str("define i64 @atomic_fetch_add_i64(ptr %p, i64 %v) {\nentry:\n  %res = atomicrmw add ptr %p, i64 %v seq_cst\n  ret i64 %res\n}\n\n")
        header.push_str("define i64 @atomic_fetch_sub_i64(ptr %p, i64 %v) {\nentry:\n  %res = atomicrmw sub ptr %p, i64 %v seq_cst\n  ret i64 %res\n}\n\n")
        header.push_str("define i64 @atomic_compare_exchange_i64(ptr %p, i64 %expected, i64 %desired) {\nentry:\n  %pair = cmpxchg ptr %p, i64 %expected, i64 %desired seq_cst seq_cst\n  %old = extractvalue { i64, i1 } %pair, 0\n  ret i64 %old\n}\n\n")
        header.push_str("define i32 @atomic_load_i32(ptr %p) {\nentry:\n  %v = load atomic i32, ptr %p seq_cst, align 4\n  ret i32 %v\n}\n\n")
        header.push_str("define void @atomic_store_i32(ptr %p, i32 %v) {\nentry:\n  store atomic i32 %v, ptr %p seq_cst, align 4\n  ret void\n}\n\n")
        header.push_str("define i32 @atomic_fetch_add_i32(ptr %p, i32 %v) {\nentry:\n  %res = atomicrmw add ptr %p, i32 %v seq_cst\n  ret i32 %res\n}\n\n")
        header.push_str("define i32 @atomic_fetch_sub_i32(ptr %p, i32 %v) {\nentry:\n  %res = atomicrmw sub ptr %p, i32 %v seq_cst\n  ret i32 %res\n}\n\n")
        header.push_str("define i32 @atomic_compare_exchange_i32(ptr %p, i32 %expected, i32 %desired) {\nentry:\n  %pair = cmpxchg ptr %p, i32 %expected, i32 %desired seq_cst seq_cst\n  %old = extractvalue { i32, i1 } %pair, 0\n  ret i32 %old\n}\n\n")

        header.push_str("define i64 @now() {\nentry:\n  ret i64 0\n}\n\n")

        header.push_str("define i64 @Some(i64 %v) {\nentry:\n  ret i64 %v\n}\n\n")

        header.push_str("define i64 @None() {\nentry:\n  ret i64 0\n}\n\n")

        header.push_str("define i64 @Ok(i64 %v) {\nentry:\n  ret i64 %v\n}\n\n")

        header.push_str("define i64 @Err(i64 %v) {\nentry:\n  ret i64 %v\n}\n\n")

        header.push_str("define i64 @On(i64 %v) {\nentry:\n  ret i64 %v\n}\n\n")

        header.push_str("define i64 @Just(i64 %v) {\nentry:\n  ret i64 %v\n}\n\n")

        header.push_str("@.eprint_fmt = private unnamed_addr constant [4 x i8] c\"%s\\0A\\00\", align 1\n")
        header.push_str("define void @eprintln(ptr %msg) {\nentry:\n  %fmt = getelementptr inbounds [4 x i8], ptr @.eprint_fmt, i32 0, i32 0\n  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %fmt, ptr %msg)\n  ret void\n}\n\n")

        header.push_str("@__rad_panic_cleanup_hook = global ptr null, align 8\n")
        header.push_str("define void @__rad_register_panic_hook(ptr %hook) {\nentry:\n  store ptr %hook, ptr @__rad_panic_cleanup_hook, align 8\n  ret void\n}\n\n")
        header.push_str("define void @__rad_run_panic_hook() {\nentry:\n  %h = load ptr, ptr @__rad_panic_cleanup_hook, align 8\n  %is_null = icmp eq ptr %h, null\n  br i1 %is_null, label %done, label %call_hook\ncall_hook:\n  call void %h()\n  br label %done\ndone:\n  ret void\n}\n\n")

        header.push_str("@__rad_terminal_guard_buf = global [128 x i8] zeroinitializer, align 8\n")
        header.push_str("define ptr @__rad_get_terminal_guard() {\nentry:\n  ret ptr @__rad_terminal_guard_buf\n}\n\n")

        if !str_starts_with(self.target.as_ptr() as str, "wasm32") {
            header.push_str("define void @__rad_sigreturn_trampoline() {\nentry:\n  call void asm sideeffect \"mov $$15, %rax\\0Asyscall\", \"\"()\n  ret void\n}\n\n")
        } else {
            header.push_str("define void @__rad_sigreturn_trampoline() {\nentry:\n  ret void\n}\n\n")
        }

        header.push_str("@.panic_bounds_fmt = private unnamed_addr constant [64 x i8] c\"rad runtime panic: index out of bounds: index %lld >= len %lld\\0A\\00\", align 1\n")
        header.push_str("define void @__rad_panic_bounds(i64 %idx, i64 %len) {\nentry:\n  call void @__rad_run_panic_hook()\n  %fmt = getelementptr inbounds [64 x i8], ptr @.panic_bounds_fmt, i32 0, i32 0\n  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %fmt, i64 %idx, i64 %len)\n  call void @exit(i32 1)\n  ret void\n}\n\n")

        header.push_str("@.panic_div_fmt = private unnamed_addr constant [46 x i8] c\"rad runtime panic: attempt to divide by zero\\0A\\00\", align 1\n")
        header.push_str("define void @__rad_panic_div_zero() {\nentry:\n  call void @__rad_run_panic_hook()\n  %fmt = getelementptr inbounds [46 x i8], ptr @.panic_div_fmt, i32 0, i32 0\n  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %fmt)\n  call void @exit(i32 1)\n  ret void\n}\n\n")

        header.push_str("@.contract_panic_msg = private unnamed_addr constant [49 x i8] c\"rad runtime panic: contract precondition failed\\0A\\00\", align 1\n")
        header.push_str("define void @__rad_contract_violation() {\nentry:\n  call void @__rad_run_panic_hook()\n  %fmt = getelementptr inbounds [49 x i8], ptr @.contract_panic_msg, i32 0, i32 0\n  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr %fmt)\n  call void @exit(i32 101)\n  ret void\n}\n\n")

        header.push_str("define i64 @__rad_jit_call0(ptr %fn) {\nentry:\n  %res = call i64 %fn()\n  ret i64 %res\n}\n\n")
        header.push_str("define i64 @__rad_jit_call1(ptr %fn, i64 %a1) {\nentry:\n  %res = call i64 %fn(i64 %a1)\n  ret i64 %res\n}\n\n")
        header.push_str("define i64 @__rad_jit_call2(ptr %fn, i64 %a1, i64 %a2) {\nentry:\n  %res = call i64 %fn(i64 %a1, i64 %a2)\n  ret i64 %res\n}\n\n")

        header.push_str("define ptr @vec_from(ptr %slice) {\nentry:\n  %is_null = icmp eq ptr %slice, null\n  br i1 %is_null, label %ret_empty, label %do_copy\nret_empty:\n  %empty_vec = call ptr @new()\n  ret ptr %empty_vec\ndo_copy:\n  %len_ptr = getelementptr inbounds i8, ptr %slice, i64 16\n  %len = load i64, ptr %len_ptr, align 8\n  %obj = call ptr @malloc(i64 24)\n  %cap = shl i64 %len, 1\n  %adj_cap_cond = icmp ult i64 %cap, 16\n  %adj_cap = select i1 %adj_cap_cond, i64 16, i64 %cap\n  %bytes = shl i64 %adj_cap, 3\n  %buf = call ptr @malloc(i64 %bytes)\n  store ptr %buf, ptr %obj, align 8\n  %cap_slot = getelementptr inbounds i8, ptr %obj, i64 8\n  store i64 %adj_cap, ptr %cap_slot, align 8\n  %len_slot = getelementptr inbounds i8, ptr %obj, i64 16\n  store i64 %len, ptr %len_slot, align 8\n  %src_buf = load ptr, ptr %slice, align 8\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %do_copy ], [ %next_i, %body ]\n  %is_done = icmp uge i64 %i, %len\n  br i1 %is_done, label %exit, label %body\nbody:\n  %src_slot = getelementptr inbounds i64, ptr %src_buf, i64 %i\n  %val = load i64, ptr %src_slot, align 8\n  %dst_slot = getelementptr inbounds i64, ptr %buf, i64 %i\n  store i64 %val, ptr %dst_slot, align 8\n  %next_i = add i64 %i, 1\n  br label %loop\nexit:\n  ret ptr %obj\n}\n\n")

        var fn_ir = String.new()
        var f_idx = 0usize
        while f_idx < self.parser.functions.len {
            let func = self.parser.functions.ptr[f_idx]
            if func.body.len == 0usize {
                f_idx = f_idx + 1usize
                continue
            }

            let mutated = Vec.new()
            var mi = 0usize
            while mi < func.body.len {
                self.collect_mutated_vars(func.body.ptr[mi], mutated)
                mi = mi + 1usize
            }
            mi = 0usize
            while mi < func.body.len {
                self.check_unused_var_mutability(func.body.ptr[mi], mutated)
                mi = mi + 1usize
            }

            self.current_func_idx = f_idx
            let fname = self.parser.functions.ptr[f_idx].fn_name.as_ptr() as str

            var has_test_main = false
            if self.parser.test_mode {
                var c_idx = 0usize
                while c_idx < self.parser.functions.len {
                    if str_eq(self.parser.functions.ptr[c_idx].fn_name.as_ptr() as str, "rad_test_main") {
                        has_test_main = true
                        break
                    }
                    c_idx = c_idx + 1usize
                }
            }

            let is_main_entry = (str_eq(fname, "rad_test_main") && self.parser.test_mode) || (str_eq(fname, "main") && !has_test_main)
            let is_user_main = str_eq(fname, "main") && has_test_main

            fn_ir.push_str("define ")
            if is_main_entry {
                fn_ir.push_str("i32 @main(i32 %argc, ptr %argv)")
            } else if is_user_main {
                fn_ir.push_str("i32 @__user_main(i32 %argc, ptr %argv)")
            } else {
                fn_ir.push_str(self.emit_llvm_type(func.ret_type.as_ptr() as str))
                fn_ir.push_str(" @")
                fn_ir.push_str(fname)
                fn_ir.push_str("(")
                var p_idx = 0usize
                while p_idx < func.param_names.len {
                    if p_idx > 0usize { fn_ir.push_str(", ") }
                    let p_ty = func.param_types.ptr[p_idx].as_ptr() as str
                    fn_ir.push_str(self.emit_llvm_type(p_ty))
                    fn_ir.push_str(" %")
                    fn_ir.push_str(func.param_names.ptr[p_idx].as_ptr() as str)
                    p_idx = p_idx + 1usize
                }
                fn_ir.push_str(")")
            }
            if self.debug_info {
                fn_ir.push_str(" !dbg !")
                fn_ir.push_str(int_to_str(1000 + (f_idx as i32) * 2).as_ptr() as str)
            }
            fn_ir.push_str(" {\nentry:\n")

            self.fn_allocas = String.new()
            self.allocated_vars = Vec.new()

            if is_main_entry || is_user_main {
                self.allocated_vars.push(String.from_str("argc"))
                self.allocated_vars.push(String.from_str("argv"))
                self.fn_allocas.push_str("  %argc.addr = alloca i32, align 4\n")
                self.fn_allocas.push_str("  store i32 %argc, ptr %argc.addr, align 4\n")
                self.fn_allocas.push_str("  %argv.addr = alloca ptr, align 8\n")
                self.fn_allocas.push_str("  store ptr %argv, ptr %argv.addr, align 8\n")
            }

            // Allocate local stack slots for parameters
            if !is_main_entry && !is_user_main {
                var pi = 0usize
                while pi < func.param_names.len {
                    let pname = func.param_names.ptr[pi].as_ptr() as str
                    let p_ty = func.param_types.ptr[pi].as_ptr() as str
                    let llvm_ty = self.emit_llvm_type(p_ty)
                    self.allocated_vars.push(String.from_str(pname))

                    self.fn_allocas.push_str("  %")
                    self.fn_allocas.push_str(pname)
                    self.fn_allocas.push_str(".addr = alloca ")
                    self.fn_allocas.push_str(llvm_ty)
                    self.fn_allocas.push_str(", align 8\n")

                    self.fn_allocas.push_str("  store ")
                    self.fn_allocas.push_str(llvm_ty)
                    self.fn_allocas.push_str(" %")
                    self.fn_allocas.push_str(pname)
                    self.fn_allocas.push_str(", ptr %")
                    self.fn_allocas.push_str(pname)
                    self.fn_allocas.push_str(".addr, align 8\n")

                    pi = pi + 1usize
                }
            }

            // Allocate stack slots for local variables in body
            var bi = 0usize
            while bi < func.body.len {
                self.collect_allocas_stmt(func.body.ptr[bi])
                bi = bi + 1usize
            }

            fn_ir.push_str(self.fn_allocas.as_ptr() as str)

            // Emit function body statements
            self.current_ret_type = String.from_str(self.emit_llvm_type(func.ret_type.as_ptr() as str))
            self.ir = String.new()
            self.active_defers = Vec.new()
            self.active_drops_var = Vec.new()
            self.active_drops_type = Vec.new()
            var si = 0usize
            var has_returned = false
            while si < func.body.len {
                let stmt_id = func.body.ptr[si]
                let is_last = (si + 1usize == func.body.len)
                let sk = self.parser.stmts.ptr[stmt_id].kind
                if !has_returned {
                    if is_last && !str_eq(func.ret_type.as_ptr() as str, "void") && sk == STMT_EXPR {
                        let r = self.emit_expr(self.parser.stmts.ptr[stmt_id].expr_id)
                        self.emit_drops_from(0usize, "")
                        self.emit_defers_from(0usize)
                        let ret_ty = self.current_ret_type.as_ptr() as str
                        if str_eq(ret_ty, "void") {
                            self.ir.push_str("  ret void\n")
                        } else if str_eq(ret_ty, "i32") {
                            let tr = self.alloc_ssa()
                            self.ir.push_str("  %")
                            self.ir.push_str(int_to_str(tr).as_ptr() as str)
                            self.ir.push_str(" = trunc i64 %")
                            self.ir.push_str(int_to_str(r).as_ptr() as str)
                            self.ir.push_str(" to i32\n")
                            self.ir.push_str("  ret i32 %")
                            self.ir.push_str(int_to_str(tr).as_ptr() as str)
                            self.ir.push_str("\n")
                        } else if str_eq(ret_ty, "ptr") {
                            var final_reg = r + 0
                            if !self.is_expr_ptr(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = inttoptr i64 %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to ptr\n")
                                final_reg = cvt
                            }
                            self.ir.push_str("  ret ptr %")
                            self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                            self.ir.push_str("\n")
                        } else if str_eq(ret_ty, "float") {
                            var final_reg = r + 0
                            if !self.is_expr_float(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = sitofp i64 %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to float\n")
                                final_reg = cvt
                            } else if !self.is_expr_f32(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = fptrunc double %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to float\n")
                                final_reg = cvt
                            }
                            self.ir.push_str("  ret float %")
                            self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                            self.ir.push_str("\n")
                        } else if str_eq(ret_ty, "double") {
                            var final_reg = r + 0
                            if !self.is_expr_float(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = sitofp i64 %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to double\n")
                                final_reg = cvt
                            } else if self.is_expr_f32(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = fpext float %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to double\n")
                                final_reg = cvt
                            }
                            self.ir.push_str("  ret double %")
                            self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                            self.ir.push_str("\n")
                        } else {
                            var final_reg = r + 0
                            if self.is_expr_ptr(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                self.ir.push_str(" = ptrtoint ptr %")
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to i64\n")
                                final_reg = cvt
                            } else if self.is_expr_float(self.parser.stmts.ptr[stmt_id].expr_id) {
                                let cvt = self.alloc_ssa()
                                self.ir.push_str("  %")
                                self.ir.push_str(int_to_str(cvt).as_ptr() as str)
                                if self.is_expr_f32(self.parser.stmts.ptr[stmt_id].expr_id) {
                                    self.ir.push_str(" = fptosi float %")
                                } else {
                                    self.ir.push_str(" = fptosi double %")
                                }
                                self.ir.push_str(int_to_str(r).as_ptr() as str)
                                self.ir.push_str(" to i64\n")
                                final_reg = cvt
                            }
                            self.ir.push_str("  ret i64 %")
                            self.ir.push_str(int_to_str(final_reg).as_ptr() as str)
                            self.ir.push_str("\n")
                        }
                        has_returned = true
                    } else {
                        self.emit_stmt(stmt_id)
                        if self.stmt_terminates(stmt_id) {
                            has_returned = true
                        }
                    }
                }
                si = si + 1usize
            }
            if !has_returned {
                self.emit_drops_from(0usize, "")
                self.emit_defers_from(0usize)
            }
            if self.ir.len() > 0usize {
                if self.debug_info {
                    let loc_id = 1000 + (f_idx as i32) * 2 + 1
                    var tag = String.new()
                    tag.push_str(", !dbg !")
                    tag.push_str(int_to_str(loc_id).as_ptr() as str)

                    let ir_p: *raw u8 = self.ir.as_ptr()
                    let ir_len = self.ir.len()
                    var line_start = 0usize
                    var cur = 0usize
                    while cur < ir_len {
                        if ir_p[cur] == 10u8 { // '\n'
                            var has_call = false
                            var scan = line_start
                            while scan + 4usize <= cur {
                                if ir_p[scan] == 99u8 && ir_p[scan + 1usize] == 97u8 && ir_p[scan + 2usize] == 108u8 && ir_p[scan + 3usize] == 108u8 && ir_p[scan + 4usize] == 32u8 {
                                    has_call = true
                                    break
                                }
                                scan = scan + 1usize
                            }
                            var b = line_start
                            while b < cur {
                                fn_ir.push_byte(ir_p[b])
                                b = b + 1usize
                            }
                            if has_call {
                                fn_ir.push_str(tag.as_ptr() as str)
                            }
                            fn_ir.push_byte(10u8) // '\n'
                            line_start = cur + 1usize
                        }
                        cur = cur + 1usize
                    }
                } else {
                    fn_ir.push_str(self.ir.as_ptr() as str)
                }
            }

            if !has_returned {
                let ret_ty = self.current_ret_type.as_ptr() as str
                if is_main_entry || is_user_main || str_eq(fname, "main") {
                    fn_ir.push_str("  ret i32 0\n")
                } else if str_eq(func.ret_type.as_ptr() as str, "void") {
                    fn_ir.push_str("  ret void\n")
                } else if str_eq(ret_ty, "i32") {
                    fn_ir.push_str("  ret i32 0\n")
                } else if str_eq(ret_ty, "ptr") {
                    fn_ir.push_str("  ret ptr null\n")
                } else if str_eq(ret_ty, "double") {
                    fn_ir.push_str("  ret double 0.0\n")
                } else if str_eq(ret_ty, "float") {
                    fn_ir.push_str("  ret float 0.0\n")
                } else {
                    fn_ir.push_str("  ret i64 0\n")
                }
            }
            fn_ir.push_str("}\n\n")

            f_idx = f_idx + 1usize
        }

        // Global string constant table
        var str_table = String.new()
        var s_idx = 0usize
        while s_idx < self.strings.len {
            let entry = self.strings.ptr[s_idx]
            str_table.push_str("@.str.")
            str_table.push_str(int_to_str(s_idx as i32).as_ptr() as str)
            str_table.push_str(" = private unnamed_addr constant [")
            str_table.push_str(int_to_str(entry.byte_len as i32).as_ptr() as str)
            str_table.push_str(" x i8] c\"")
            
            let p: *raw u8 = entry.content.as_ptr()
            if (p as usize) != 0usize && entry.byte_len > 1usize {
                let content_len = entry.byte_len - 1usize
                var b_idx = 0usize
                while b_idx < content_len {
                    let ch_byte: u8 = p[b_idx]
                    if ch_byte >= 32u8 && ch_byte <= 126u8 && ch_byte != 34u8 && ch_byte != 92u8 {
                        str_table.push_byte(ch_byte)
                    } else {
                        str_table.push_byte(92u8) // '\\'
                        let hi = ch_byte >> 4u8
                        let lo = ch_byte & 15u8
                        if hi < 10u8 { str_table.push_byte(hi + 48u8) } else { str_table.push_byte(hi - 10u8 + 65u8) }
                        if lo < 10u8 { str_table.push_byte(lo + 48u8) } else { str_table.push_byte(lo - 10u8 + 65u8) }
                    }
                    b_idx = b_idx + 1usize
                }
            }
            str_table.push_str("\\00\", align 1\n")
            s_idx = s_idx + 1usize
        }
        if self.strings.len > 0usize {
            str_table.push_str("\n")
        }

        if self.parser.error_count > 0i64 {
            return String.new()
        }

        var full_module = String.new()
        if header.len() > 0usize {
            full_module.push_str(header.as_ptr() as str)
        }
        if str_table.len() > 0usize {
            full_module.push_str(str_table.as_ptr() as str)
        }
        if fn_ir.len() > 0usize {
            full_module.push_str(fn_ir.as_ptr() as str)
        }

        if self.debug_info {
            var dbg_file = self.source_file.as_ptr() as str
            if str_len(dbg_file) == 0usize {
                dbg_file = "main.rad"
            }
            full_module.push_str("!llvm.dbg.cu = !{!0}\n")
            full_module.push_str("!llvm.module.flags = !{!1, !2}\n\n")
            full_module.push_str("!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !3, producer: \"radc 0.2.4\", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false, nameTableKind: None)\n")
            full_module.push_str("!1 = !{i32 7, !\"Dwarf Version\", i32 5}\n")
            full_module.push_str("!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n")
            full_module.push_str("!3 = !DIFile(filename: \"")
            full_module.push_str(dbg_file)
            full_module.push_str("\", directory: \".\")\n")
            full_module.push_str("!4 = !DISubroutineType(types: !5)\n")
            full_module.push_str("!5 = !{null}\n")

            var dfi = 0usize
            while dfi < self.parser.functions.len {
                let dfn = self.parser.functions.ptr[dfi]
                if dfn.body.len > 0usize {
                    var dfname = dfn.fn_name.as_ptr() as str
                    if has_test_main && str_eq(dfname, "main") {
                        dfname = "__user_main"
                    }
                    let sub_id = 1000 + (dfi as i32) * 2
                    let loc_id = sub_id + 1
                    full_module.push_str("!")
                    full_module.push_str(int_to_str(sub_id).as_ptr() as str)
                    full_module.push_str(" = distinct !DISubprogram(name: \"")
                    full_module.push_str(dfname)
                    full_module.push_str("\", scope: !3, file: !3, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)\n")
                    full_module.push_str("!")
                    full_module.push_str(int_to_str(loc_id).as_ptr() as str)
                    full_module.push_str(" = !DILocation(line: 1, column: 1, scope: !")
                    full_module.push_str(int_to_str(sub_id).as_ptr() as str)
                    full_module.push_str(")\n")
                }
                dfi = dfi + 1usize
            }
        }
        return full_module
    }
}
