// ==============================================================================
// radc/src/ast.rad — Arena AST Definitions
// ==============================================================================

const EXPR_INT: i32 = 1
const EXPR_STR: i32 = 2
const EXPR_BOOL: i32 = 3
const EXPR_IDENT: i32 = 4
const EXPR_BINARY: i32 = 5
const EXPR_UNARY: i32 = 6
const EXPR_CALL: i32 = 7
const EXPR_METHOD_CALL: i32 = 8
const EXPR_FIELD_ACCESS: i32 = 9
const EXPR_INDEX: i32 = 10
const EXPR_CAST: i32 = 11
const EXPR_FLOAT: i32 = 12
const EXPR_ARRAY_LITERAL: i32 = 13
const EXPR_RANGE: i32 = 14
const EXPR_TRY: i32 = 15
const EXPR_AWAIT: i32 = 16
const EXPR_TUPLE: i32 = 17
const EXPR_FSTRING: i32 = 18
const EXPR_LAMBDA: i32 = 19

struct SourceFile {
    file_path: String,
    file_text: String,
}

struct Expr {
    kind: i32,
    op: i32,
    int_val: i64,
    str_val: String,
    target_type: String,
    left: usize,
    right: usize,
    args: Vec<usize>,
    field_name: String,
    expr_line: i64,
    expr_col: i64,
}

const STMT_LET: i32 = 1
const STMT_VAR: i32 = 2
const STMT_ASSIGN: i32 = 3
const STMT_ASSIGN_INDEX: i32 = 4
const STMT_IF: i32 = 5
const STMT_WHILE: i32 = 6
const STMT_RETURN: i32 = 7
const STMT_EXPR: i32 = 8
const STMT_BREAK: i32 = 9
const STMT_CONTINUE: i32 = 10
const STMT_ASSIGN_FIELD: i32 = 11
const STMT_FOR_RANGE: i32 = 12
const STMT_FOR_IN: i32 = 13
const STMT_DEFER: i32 = 14

struct Stmt {
    kind: i32,
    name: String,
    type_name: String,
    expr_id: usize,
    index_expr: usize,
    then_stmts: Vec<usize>,
    else_stmts: Vec<usize>,
    body_stmts: Vec<usize>,
    stmt_line: i64,
    stmt_col: i64,
}

struct FunctionDef {
    fn_name: String,
    param_names: Vec<String>,
    param_types: Vec<String>,
    ret_type: String,
    body: Vec<usize>,
    is_test: bool,
    is_async: bool,
    has_body: bool,
    source_id: usize,
}

struct TraitMethodDef {
    method_name: String,
    param_names: Vec<String>,
    param_types: Vec<String>,
    ret_type: String,
}

struct TraitDef {
    trait_name: String,
    methods: Vec<TraitMethodDef>,
}

struct TraitImplDef {
    trait_name: String,
    target_struct_name: String,
}

struct StructDef {
    struct_name: String,
    field_names: Vec<String>,
    field_types: Vec<String>,
}

struct MatchArm {
    is_wildcard: bool,
    cond_expr: usize,
    bound_var: String,
    stmts: Vec<usize>,
}

struct Diagnostic {
    code: String,
    severity: String,
    message: String,
    file: String,
    line: i64,
    col: i64,
    end_line: i64,
    end_col: i64,
    source_line: String,
    help: String,
}
