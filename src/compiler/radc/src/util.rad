// ==============================================================================
// radc/src/util.rad — String, Character, Number & File System Utilities
// ==============================================================================

fn str_len(s: str) -> usize {
    if (s as usize) == 0usize {
        return 0usize
    }
    let p = s as *raw u8
    var i = 0usize
    while p[i] != 0u8 {
        i = i + 1usize
    }
    return i
}

fn str_eq(a: str, b: str) -> bool {
    if (a as usize) == 0usize && (b as usize) == 0usize {
        return true
    }
    if (a as usize) == 0usize || (b as usize) == 0usize {
        return false
    }
    let pa = a as *raw u8
    let pb = b as *raw u8
    var i = 0usize
    while pa[i] != 0u8 && pb[i] != 0u8 {
        if pa[i] != pb[i] {
            return false
        }
        i = i + 1usize
    }
    return pa[i] == pb[i]
}

fn str_starts_with(s: str, prefix: str) -> bool {
    if (s as usize) == 0usize || (prefix as usize) == 0usize {
        return false
    }
    let ps = s as *raw u8
    let pp = prefix as *raw u8
    var i = 0usize
    while pp[i] != 0u8 {
        if ps[i] == 0u8 || ps[i] != pp[i] {
            return false
        }
        i = i + 1usize
    }
    return true
}

fn str_ends_with(s: str, suffix: str) -> bool {
    let s_len = str_len(s)
    let suf_len = str_len(suffix)
    if s_len < suf_len || s_len == 0usize {
        return false
    }
    let ps = s as *raw u8
    let p_suf = suffix as *raw u8
    let start = s_len - suf_len
    var i = 0usize
    while i < suf_len {
        if ps[start + i] != p_suf[i] {
            return false
        }
        i = i + 1usize
    }
    return true
}

fn str_contains(s: str, sub: str) -> bool {
    if (s as usize) == 0usize || (sub as usize) == 0usize {
        return false
    }
    let slen = str_len(s)
    let sublen = str_len(sub)
    if sublen > slen { return false }
    if sublen == 0usize { return true }
    let p_s = s as *raw u8
    let p_sub = sub as *raw u8
    var i = 0usize
    while i + sublen <= slen {
        var is_matched = true
        var j = 0usize
        while j < sublen {
            if p_s[i + j] != p_sub[j] {
                is_matched = false
                break
            }
            j = j + 1usize
        }
        if is_matched { return true }
        i = i + 1usize
    }
    return false
}

fn is_digit(ch: u8) -> bool {
    return ch >= 48u8 && ch <= 57u8
}

fn is_alpha(ch: u8) -> bool {
    return (ch >= 65u8 && ch <= 90u8) || (ch >= 97u8 && ch <= 122u8) || ch == 95u8
}

fn is_alnum(ch: u8) -> bool {
    return is_alpha(ch) || is_digit(ch)
}

fn int_to_str(v_in: i32) -> String {
    return i64_to_str(v_in as i64)
}

fn i64_to_str(v_in: i64) -> String {
    var v = v_in + 0i64
    var res = String.new()
    if v == 0i64 {
        res.push_byte(48u8)
        res.push_byte(0u8)
        return res
    }
    var is_neg = false
    if v < 0i64 {
        is_neg = true
        if v == -9223372036854775807i64 - 1i64 {
            res.push_str("-9223372036854775808")
            return res
        }
        v = 0i64 - v
    }
    var digits = Vec.new()
    while v > 0i64 {
        let d = (v % 10i64) as u8
        digits.push((d + 48u8) as i64)
        v = v / 10i64
    }
    if is_neg {
        res.push_byte(45u8) // '-'
    }
    var i = digits.len
    while i > 0usize {
        i = i - 1usize
        res.push_byte(digits.ptr[i] as u8)
    }
    res.push_byte(0u8)
    return res
}

fn parse_int(s: str) -> i64 {
    let p = s as *raw u8
    let len = str_len(s)
    var res = 0i64
    var i = 0usize
    var is_neg = false
    if len > 0usize && p[0usize] == 45u8 {
        is_neg = true
        i = 1usize
    }
    while i < len && is_digit(p[i]) {
        res = res * 10i64 + ((p[i] - 48u8) as i64)
        i = i + 1usize
    }
    if is_neg {
        return 0i64 - res
    }
    return res
}

fn read_file_string(path: str) -> String {
    var res = String.new()
    let fp = fopen(path, "rb")
    if (fp as usize) == 0usize {
        return res
    }
    fseek(fp, 0i64, 2)
    let size = ftell(fp) as usize
    fseek(fp, 0i64, 0)
    if size == 0usize {
        fclose(fp)
        return res
    }
    var buf: *raw var u8 = malloc(size + 1usize) as *raw var u8
    let read_bytes = fread(buf, 1usize, size, fp) as usize
    buf[read_bytes] = 0u8
    fclose(fp)

    var i = 0usize
    while i < read_bytes {
        res.push_byte(buf[i])
        i = i + 1usize
    }
    res.push_byte(0u8)
    free(buf)
    return res
}

fn write_file_string(path: str, content: String) -> bool {
    let fp = fopen(path, "wb")
    if (fp as usize) == 0usize {
        return false
    }
    let p = content.as_ptr() as *raw var u8
    let len = str_len(content.as_ptr() as str)
    fwrite(p, 1usize, len, fp)
    fclose(fp)
    return true
}

fn file_exists(path: str) -> bool {
    if (path as usize) == 0usize || str_len(path) == 0usize {
        return false
    }
    let fp = fopen(path, "rb")
    if (fp as usize) != 0usize {
        fclose(fp)
        return true
    }
    return false
}

fn get_dirname(path: str) -> String {
    var res = String.new()
    let slen = str_len(path)
    if slen == 0usize {
        res.push_byte(46u8) // '.'
        res.push_byte(0u8)
        return res
    }
    let p = path as *raw u8
    var last_slash: i64 = -1i64
    var i = 0usize
    while i < slen {
        if p[i] == 47u8 { // '/'
            last_slash = i as i64
        }
        i = i + 1usize
    }
    if last_slash < 0i64 {
        res.push_byte(46u8) // '.'
        res.push_byte(0u8)
        return res
    }
    if last_slash == 0i64 {
        res.push_byte(47u8) // '/'
        res.push_byte(0u8)
        return res
    }
    i = 0usize
    let limit = last_slash as usize
    while i < limit {
        res.push_byte(p[i])
        i = i + 1usize
    }
    res.push_byte(0u8)
    return res
}
