// radc/src/codegen_types.rad - Type Resolution & Layout Pass
import util;
import token;
import ast;
import parser;

impl Codegen {
    fn resolve_type_alias(self, ty: str) -> str {
        return self.parser.resolve_type_alias(ty)
    }

    fn extract_tuple_type_element(self, ty: str, target_idx: i64) -> str {
        let p = ty as *raw u8
        let tlen = str_len(ty)
        var i = 0usize
        if i < tlen && p[i] == 40u8 {
            i = i + 1usize
        }
        var cur_idx = 0i64
        while i < tlen && cur_idx <= target_idx {
            while i < tlen && (p[i] == 32u8 || p[i] == 9u8) {
                i = i + 1usize
            }
            let start = i
            var depth_paren = 0i64
            var depth_angle = 0i64
            while i < tlen {
                let c = p[i]
                if c == 40u8 { depth_paren = depth_paren + 1i64 }
                else if c == 41u8 {
                    if depth_paren == 0i64 { break }
                    depth_paren = depth_paren - 1i64
                }
                else if c == 60u8 { depth_angle = depth_angle + 1i64 }
                else if c == 62u8 {
                    if depth_angle > 0i64 { depth_angle = depth_angle - 1i64 }
                }
                else if c == 44u8 && depth_paren == 0i64 && depth_angle == 0i64 {
                    break
                }
                i = i + 1usize
            }
            if cur_idx == target_idx {
                var res = String.new()
                var end = i
                while end > start && (p[end - 1usize] == 32u8 || p[end - 1usize] == 9u8) {
                    end = end - 1usize
                }
                var k = start
                while k < end {
                    res.push_byte(p[k])
                    k = k + 1usize
                }
                res.push_byte(0u8)
                return res.as_ptr() as str
            }
            if i < tlen && p[i] == 44u8 {
                i = i + 1usize
            }
            cur_idx = cur_idx + 1i64
        }
        return ""
    }

    fn get_tuple_elem_type(self, recv_id: usize, elem_idx: i64) -> str {
        let ep = self.parser.exprs.ptr
        let k = ep[recv_id].kind
        if k == EXPR_TUPLE {
            if elem_idx >= 0i64 && (elem_idx as usize) < ep[recv_id].args.len {
                let arg_id = ep[recv_id].args.ptr[elem_idx as usize]
                if self.is_expr_ptr(arg_id) {
                    return "ptr"
                }
                if self.is_expr_float(arg_id) {
                    return "f64"
                }
                return "i64"
            }
        }
        var raw_t = self.get_expr_struct_name(recv_id)
        if str_len(raw_t) == 0usize && ep[recv_id].kind == EXPR_IDENT {
            raw_t = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
        }
        if str_len(raw_t) == 0usize && ep[recv_id].kind == EXPR_CALL {
            let callee = ep[recv_id].left
            if ep[callee].kind == EXPR_IDENT {
                raw_t = self.get_raw_func_ret_type(ep[callee].str_val.as_ptr() as str)
            }
        }
        if str_starts_with(raw_t, "(") {
            return self.extract_tuple_type_element(raw_t, elem_idx)
        }
        return ""
    }

    fn emit_llvm_type(self, ty: str) -> str {
        var t = ty;
        while str_starts_with(t, " ") {
            t = (t as usize + 1usize) as str;
        }
        if str_starts_with(t, "var ") {
            t = (t as usize + 4usize) as str;
            while str_starts_with(t, " ") {
                t = (t as usize + 1usize) as str;
            }
        }
        t = self.resolve_type_alias(t);
        while str_starts_with(t, " ") {
            t = (t as usize + 1usize) as str;
        }
        if str_starts_with(t, "var ") {
            t = (t as usize + 4usize) as str;
            while str_starts_with(t, " ") {
                t = (t as usize + 1usize) as str;
            }
        }
        if str_eq(t, "void") {
            return "void"
        }
        if str_starts_with(t, "(") || str_eq(t, "tuple") || str_starts_with(t, "*") || str_starts_with(t, "&") || str_starts_with(t, "fn") || str_starts_with(t, "closure") || str_starts_with(t, "str") || str_starts_with(t, "ptr") || str_eq(t, "Vec") || str_eq(t, "String") || str_starts_with(t, "[]") || str_starts_with(t, "var []") || str_starts_with(t, "[") || str_starts_with(t, "dyn ") || str_starts_with(t, "Option") || str_starts_with(t, "Result") || self.is_struct_name(t) {
            return "ptr"
        }
        if str_eq(t, "f64") {
            return "double"
        }
        if str_eq(t, "f32") {
            return "float"
        }
        if str_eq(t, "i32") || str_eq(t, "bool") || str_eq(t, "u32") {
            return "i32"
        }
        return "i64"
    }

    fn get_func_ptr_ret_type(self, fty: str) -> str {
        if !str_contains(fty, "->") {
            return "void"
        }
        let p = fty as *raw u8
        let flen = str_len(fty)
        var i = 0usize
        while i + 1usize < flen {
            if p[i] == 45u8 && p[i + 1usize] == 62u8 { // '->'
                var start = i + 2usize
                while start < flen && (p[start] == 32u8 || p[start] == 9u8) {
                    start = start + 1usize
                }
                var ret_ty = String.new()
                var j = start
                while j < flen {
                    ret_ty.push_byte(p[j])
                    j = j + 1usize
                }
                ret_ty.push_byte(0u8)
                let r_str = ret_ty.as_ptr() as str
                if str_eq(r_str, "void") {
                    return "void"
                }
                return self.emit_llvm_type(r_str)
            }
            i = i + 1usize
        }
        return "void"
    }

    fn parse_fn_ptr_param_type(self, fty: str, target_idx: usize) -> str {
        var start_i = 3usize
        if str_starts_with(fty, "closure(") {
            start_i = 8usize
        } else if !str_starts_with(fty, "fn(") {
            return ""
        }
        let p = fty as *raw u8
        let flen = str_len(fty)
        var i = start_i
        var cur_idx = 0usize
        var depth = 0i64
        var angle_depth = 0i64
        while i < flen && p[i] != 41u8 {
            while i < flen && (p[i] == 32u8 || p[i] == 9u8) {
                i = i + 1usize
            }
            let start = i
            while i < flen {
                let c = p[i]
                if c == 40u8 {
                    depth = depth + 1i64
                } else if c == 41u8 {
                    if depth == 0i64 { break }
                    depth = depth - 1i64
                } else if c == 60u8 {
                    angle_depth = angle_depth + 1i64
                } else if c == 62u8 {
                    if angle_depth > 0i64 { angle_depth = angle_depth - 1i64 }
                } else if c == 44u8 && depth == 0i64 && angle_depth == 0i64 {
                    break
                }
                i = i + 1usize
            }
            if cur_idx == target_idx {
                var end = i
                while end > start && (p[end - 1usize] == 32u8 || p[end - 1usize] == 9u8) {
                    end = end - 1usize
                }
                var res = String.new()
                var k = start
                while k < end {
                    res.push_byte(p[k])
                    k = k + 1usize
                }
                res.push_byte(0u8)
                return res.as_ptr() as str
            }
            if i < flen && p[i] == 44u8 {
                i = i + 1usize
            }
            cur_idx = cur_idx + 1usize
        }
        return ""
    }

    fn get_lambda_caps(self, fn_idx: usize) -> Vec<String> {
        var mi = 0usize
        while mi < self.closure_metas.len {
            if self.closure_metas.ptr[mi].fn_idx == fn_idx {
                return self.closure_metas.ptr[mi].cap_vars
            }
            mi = mi + 1usize
        }
        return Vec.new()
    }

    fn is_lambda_capturing(self, fn_idx: usize) -> bool {
        let caps = self.get_lambda_caps(fn_idx)
        return caps.len > 0usize
    }

    fn is_expr_closure(self, expr_id: usize) -> bool {
        if expr_id == 0usize || expr_id >= self.parser.exprs.len {
            return false
        }
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_LAMBDA {
            let fn_idx = ep[expr_id].int_val as usize
            return self.is_lambda_capturing(fn_idx)
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            let vty = self.get_raw_var_type(vname)
            if str_starts_with(vty, "closure(") {
                return true
            }
        }
        return false
    }

    fn extract_module_stem(self, fpath: str) -> String {
        let flen = str_len(fpath)
        if flen == 0usize {
            return String.new()
        }
        let p = fpath as *raw u8
        var last_slash = 0usize
        var has_slash = false
        var i = 0usize
        while i < flen {
            if p[i] == 47u8 || p[i] == 92u8 {
                last_slash = i + 1usize
                has_slash = true
            }
            i = i + 1usize
        }
        var start = 0usize
        if has_slash {
            start = last_slash
        }
        var end = flen
        var j = flen
        while j > start {
            if p[j - 1usize] == 46u8 {
                end = j - 1usize
                break
            }
            j = j - 1usize
        }
        var stem = String.new()
        var k = start
        while k < end {
            let c = p[k]
            if (c >= 97u8 && c <= 122u8) || (c >= 65u8 && c <= 90u8) || (c >= 48u8 && c <= 57u8) || c == 95u8 {
                stem.push_byte(c)
            } else if c == 45u8 {
                stem.push_byte(95u8)
            }
            k = k + 1usize
        }
        stem.push_byte(0u8)
        return stem
    }

    fn resolve_function_name(self, name: str, source_id: usize) -> str {
        if (name as usize) == 0usize || str_len(name) == 0usize {
            return name
        }
        if str_eq(name, "println") || str_eq(name, "print") || str_eq(name, "eprintln") || str_eq(name, "panic") ||
           str_eq(name, "size_of") || str_eq(name, "size_of_val") || str_eq(name, "null") || str_eq(name, "null_var") ||
           str_eq(name, "is_null") || str_eq(name, "ptr_read") || str_eq(name, "ptr_write") || str_eq(name, "read_volatile") ||
           str_eq(name, "write_volatile") || str_eq(name, "offset") || str_eq(name, "offset_var") || str_eq(name, "now") {
            return name
        }
        if !str_contains(name, "__") {
            if source_id < self.parser.source_files.len {
                let stem = self.extract_module_stem(self.parser.source_files.ptr[source_id].file_path.as_ptr() as str)
                let stem_s = stem.as_ptr() as str
                if str_len(stem_s) > 0usize {
                    var local_mangled = String.new()
                    local_mangled.push_str(stem_s)
                    local_mangled.push_str("__")
                    local_mangled.push_str(name)
                    local_mangled.push_byte(0u8)
                    let lm_s = local_mangled.as_ptr() as str
                    var fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, lm_s) {
                            return lm_s
                        }
                        fi = fi + 1usize
                    }
                }
            }
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, name) {
                return name
            }
            fi = fi + 1usize
        }
        if !str_contains(name, "__") {
            var suff = String.new()
            suff.push_str("__")
            suff.push_str(name)
            suff.push_byte(0u8)
            let suff_s = suff.as_ptr() as str
            let slen = str_len(suff_s)
            var match_fn = ""
            var match_cnt = 0usize
            fi = 0usize
            while fi < self.parser.functions.len {
                let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                if str_ends_with(fn_s, suff_s) {
                    let flen = str_len(fn_s)
                    var prefix_buf = String.new()
                    let p_fn = fn_s as *raw u8
                    var pi = 0usize
                    while pi < flen - slen {
                        prefix_buf.push_byte(p_fn[pi])
                        pi = pi + 1usize
                    }
                    prefix_buf.push_byte(0u8)
                    let p_str = prefix_buf.as_ptr() as str
                    var is_mod = false
                    var si = 0usize
                    while si < self.parser.source_files.len {
                        let fpath = self.parser.source_files.ptr[si].file_path.as_ptr() as str
                        let stem = self.extract_module_stem(fpath)
                        if str_eq(stem.as_ptr() as str, p_str) {
                            is_mod = true
                            break
                        }
                        si = si + 1usize
                    }
                    if is_mod && !self.is_struct_name(p_str) {
                        match_fn = fn_s
                        match_cnt = match_cnt + 1usize
                    }
                }
                fi = fi + 1usize
            }
            if match_cnt == 1usize {
                return match_fn
            }
        }
        return name
    }

    fn build_lambda_fn_type_str(self, fn_idx: usize) -> str {
        if fn_idx >= self.parser.functions.len {
            return "ptr"
        }
        let fdef = self.parser.functions.ptr[fn_idx]
        var s = String.new()
        if self.is_lambda_capturing(fn_idx) {
            s.push_str("closure(")
        } else {
            s.push_str("fn(")
        }
        var pi = 0usize
        while pi < fdef.param_types.len {
            if pi > 0usize { s.push_str(", ") }
            let pty = fdef.param_types.ptr[pi].as_ptr() as str
            if str_eq(pty, "__rad_infer") || str_len(pty) == 0usize {
                s.push_str("i64")
            } else {
                s.push_str(pty)
            }
            pi = pi + 1usize
        }
        s.push_str(")")
        let rty = fdef.ret_type.as_ptr() as str
        if !str_eq(rty, "void") && str_len(rty) > 0usize {
            s.push_str(" -> ")
            if str_eq(rty, "__rad_infer") {
                s.push_str("i64")
            } else {
                s.push_str(rty)
            }
        }
        s.push_byte(0u8)
        return s.as_ptr() as str
    }

    fn get_indirect_param_llvm_type(self, callee_id: usize, callee_name: str, param_idx: usize, a_expr: usize) -> str {
        let ep = self.parser.exprs.ptr
        if ep[callee_id].kind == EXPR_LAMBDA {
            let l_idx = ep[callee_id].int_val as usize
            if l_idx < self.parser.functions.len && param_idx < self.parser.functions.ptr[l_idx].param_types.len {
                let raw_pt = self.parser.functions.ptr[l_idx].param_types.ptr[param_idx].as_ptr() as str
                if !str_eq(raw_pt, "__rad_infer") && str_len(raw_pt) > 0usize {
                    return self.emit_llvm_type(raw_pt)
                }
            }
        }
        let vty = self.get_raw_var_type(callee_name)
        if str_starts_with(vty, "fn(") || str_starts_with(vty, "closure(") {
            let raw_pt = self.parse_fn_ptr_param_type(vty, param_idx)
            if str_len(raw_pt) > 0usize {
                return self.emit_llvm_type(raw_pt)
            }
        }
        if self.is_expr_ptr(a_expr) {
            return "ptr"
        }
        if self.is_expr_float(a_expr) {
            return "double"
        }
        return "i64"
    }

    fn get_indirect_ret_llvm_type(self, callee_id: usize, callee_name: str) -> str {
        let ep = self.parser.exprs.ptr
        if ep[callee_id].kind == EXPR_LAMBDA {
            let l_idx = ep[callee_id].int_val as usize
            if l_idx < self.parser.functions.len {
                let rty = self.parser.functions.ptr[l_idx].ret_type.as_ptr() as str
                if str_eq(rty, "__rad_infer") {
                    return "i64"
                }
                return self.emit_llvm_type(rty)
            }
        }
        let vty = self.get_raw_var_type(callee_name)
        if str_len(vty) > 0usize && (str_starts_with(vty, "fn") || str_starts_with(vty, "closure")) {
            return self.get_func_ptr_ret_type(vty)
        }
        return "i64"
    }

    fn clean_type_name(self, ty: str) -> str {
        if str_len(ty) == 0usize {
            return ""
        }
        var s = ty
        var changed = true
        while changed {
            changed = false
            while str_starts_with(s, " ") {
                s = (s as usize + 1usize) as str
                changed = true
            }
            if str_starts_with(s, "*") || str_starts_with(s, "&") {
                s = (s as usize + 1usize) as str
                changed = true
            } else if str_starts_with(s, "raw ") {
                s = (s as usize + 4usize) as str
                changed = true
            } else if str_starts_with(s, "const ") {
                s = (s as usize + 6usize) as str
                changed = true
            } else if str_starts_with(s, "var ") {
                s = (s as usize + 4usize) as str
                changed = true
            }
        }
        while str_starts_with(s, " ") {
            s = (s as usize + 1usize) as str
        }
        var i = 0usize
        let p = s as *raw u8
        while p[i] != 0u8 {
            if p[i] == 60u8 { // '<'
                var base = String.new()
                var k = 0usize
                while k < i {
                    base.push_byte(p[k])
                    k = k + 1usize
                }
                base.push_byte(0u8)
                return base.as_ptr() as str
            }
            i = i + 1usize
        }
        return s
    }

    fn extract_type_arg(self, s: str) -> str {
        let p = s as *raw u8
        let slen = str_len(s)
        var i = 0usize
        while i < slen && p[i] != 60u8 { // '<'
            i = i + 1usize
        }
        if i >= slen {
            return ""
        }
        var j = slen
        while j > i && p[j - 1usize] != 62u8 { // '>'
            j = j - 1usize
        }
        if j <= i + 1usize {
            return ""
        }
        var res = String.new()
        var k = i + 1usize
        while k < j - 1usize {
            res.push_byte(p[k])
            k = k + 1usize
        }
        res.push_byte(0u8)
        return res.as_ptr() as str
    }

    fn get_bin_op_str(self, op: i32) -> str {
        if op == TOK_PLUS { return "+" }
        if op == TOK_MINUS { return "-" }
        if op == TOK_STAR { return "*" }
        if op == TOK_SLASH { return "/" }
        if op == TOK_PERCENT { return "%" }
        if op == TOK_AMP { return "&" }
        if op == TOK_PIPE { return "|" }
        if op == TOK_CARET { return "^" }
        if op == TOK_SHL { return "<<" }
        if op == TOK_SHR { return ">>" }
        if op == TOK_ANDAND { return "&&" }
        if op == TOK_OROR { return "||" }
        return "binary op"
    }

}
