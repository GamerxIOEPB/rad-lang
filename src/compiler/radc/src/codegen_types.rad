// radc/src/codegen_types.rad - Type Resolution & Layout Pass
import util;
import token;
import ast;
import parser;

impl Codegen {
    fn resolve_type_alias(self, ty: str) -> str {
        return self.parser.resolve_type_alias(ty)
    }

    fn extract_tuple_type_element(self, ty: str, target_idx: i64) -> str {
        let p = ty as *raw u8
        let tlen = str_len(ty)
        var i = 0usize
        if i < tlen && p[i] == 40u8 {
            i = i + 1usize
        }
        var cur_idx = 0i64
        while i < tlen && cur_idx <= target_idx {
            while i < tlen && (p[i] == 32u8 || p[i] == 9u8) {
                i = i + 1usize
            }
            let start = i
            var depth_paren = 0i64
            var depth_angle = 0i64
            while i < tlen {
                let c = p[i]
                if c == 40u8 { depth_paren = depth_paren + 1i64 }
                else if c == 41u8 {
                    if depth_paren == 0i64 { break }
                    depth_paren = depth_paren - 1i64
                }
                else if c == 60u8 { depth_angle = depth_angle + 1i64 }
                else if c == 62u8 {
                    if depth_angle > 0i64 { depth_angle = depth_angle - 1i64 }
                }
                else if c == 44u8 && depth_paren == 0i64 && depth_angle == 0i64 {
                    break
                }
                i = i + 1usize
            }
            if cur_idx == target_idx {
                var res = String.new()
                var end = i
                while end > start && (p[end - 1usize] == 32u8 || p[end - 1usize] == 9u8) {
                    end = end - 1usize
                }
                var k = start
                while k < end {
                    res.push_byte(p[k])
                    k = k + 1usize
                }
                res.push_byte(0u8)
                return res.as_ptr() as str
            }
            if i < tlen && p[i] == 44u8 {
                i = i + 1usize
            }
            cur_idx = cur_idx + 1i64
        }
        return ""
    }

    fn get_tuple_elem_type(self, recv_id: usize, elem_idx: i64) -> str {
        let ep = self.parser.exprs.ptr
        let k = ep[recv_id].kind
        if k == EXPR_TUPLE {
            if elem_idx >= 0i64 && (elem_idx as usize) < ep[recv_id].args.len {
                let arg_id = ep[recv_id].args.ptr[elem_idx as usize]
                if self.is_expr_ptr(arg_id) {
                    return "ptr"
                }
                if self.is_expr_float(arg_id) {
                    return "f64"
                }
                return "i64"
            }
        }
        var raw_t = self.get_expr_struct_name(recv_id)
        if str_len(raw_t) == 0usize && ep[recv_id].kind == EXPR_IDENT {
            raw_t = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
        }
        if str_len(raw_t) == 0usize && ep[recv_id].kind == EXPR_CALL {
            let callee = ep[recv_id].left
            if ep[callee].kind == EXPR_IDENT {
                raw_t = self.get_raw_func_ret_type(ep[callee].str_val.as_ptr() as str)
            }
        }
        if str_starts_with(raw_t, "(") {
            return self.extract_tuple_type_element(raw_t, elem_idx)
        }
        return ""
    }

    fn emit_llvm_type(self, ty: str) -> str {
        var t = ty;
        while str_starts_with(t, " ") {
            t = (t as usize + 1usize) as str;
        }
        if str_starts_with(t, "var ") {
            t = (t as usize + 4usize) as str;
            while str_starts_with(t, " ") {
                t = (t as usize + 1usize) as str;
            }
        }
        t = self.resolve_type_alias(t);
        while str_starts_with(t, " ") {
            t = (t as usize + 1usize) as str;
        }
        if str_starts_with(t, "var ") {
            t = (t as usize + 4usize) as str;
            while str_starts_with(t, " ") {
                t = (t as usize + 1usize) as str;
            }
        }
        if str_eq(t, "void") {
            return "void"
        }
        if str_starts_with(t, "(") || str_eq(t, "tuple") || str_starts_with(t, "*") || str_starts_with(t, "&") || str_starts_with(t, "fn") || str_starts_with(t, "closure") || str_starts_with(t, "str") || str_starts_with(t, "ptr") || str_eq(t, "Vec") || str_eq(t, "String") || str_starts_with(t, "[]") || str_starts_with(t, "var []") || str_starts_with(t, "[") || str_starts_with(t, "dyn ") || str_starts_with(t, "Option") || str_starts_with(t, "Result") || self.is_struct_name(t) {
            return "ptr"
        }
        if str_eq(t, "f64") {
            return "double"
        }
        if str_eq(t, "f32") {
            return "float"
        }
        if str_eq(t, "i32") || str_eq(t, "bool") || str_eq(t, "u32") {
            return "i32"
        }
        return "i64"
    }

    fn get_func_ptr_ret_type(self, fty: str) -> str {
        if !str_contains(fty, "->") {
            return "void"
        }
        let p = fty as *raw u8
        let flen = str_len(fty)
        var i = 0usize
        while i + 1usize < flen {
            if p[i] == 45u8 && p[i + 1usize] == 62u8 { // '->'
                var start = i + 2usize
                while start < flen && (p[start] == 32u8 || p[start] == 9u8) {
                    start = start + 1usize
                }
                var ret_ty = String.new()
                var j = start
                while j < flen {
                    ret_ty.push_byte(p[j])
                    j = j + 1usize
                }
                ret_ty.push_byte(0u8)
                let r_str = ret_ty.as_ptr() as str
                if str_eq(r_str, "void") {
                    return "void"
                }
                return self.emit_llvm_type(r_str)
            }
            i = i + 1usize
        }
        return "void"
    }

    fn parse_fn_ptr_param_type(self, fty: str, target_idx: usize) -> str {
        var start_i = 3usize
        if str_starts_with(fty, "closure(") {
            start_i = 8usize
        } else if !str_starts_with(fty, "fn(") {
            return ""
        }
        let p = fty as *raw u8
        let flen = str_len(fty)
        var i = start_i
        var cur_idx = 0usize
        var depth = 0i64
        var angle_depth = 0i64
        while i < flen && p[i] != 41u8 {
            while i < flen && (p[i] == 32u8 || p[i] == 9u8) {
                i = i + 1usize
            }
            let start = i
            while i < flen {
                let c = p[i]
                if c == 40u8 {
                    depth = depth + 1i64
                } else if c == 41u8 {
                    if depth == 0i64 { break }
                    depth = depth - 1i64
                } else if c == 60u8 {
                    angle_depth = angle_depth + 1i64
                } else if c == 62u8 {
                    if angle_depth > 0i64 { angle_depth = angle_depth - 1i64 }
                } else if c == 44u8 && depth == 0i64 && angle_depth == 0i64 {
                    break
                }
                i = i + 1usize
            }
            if cur_idx == target_idx {
                var end = i
                while end > start && (p[end - 1usize] == 32u8 || p[end - 1usize] == 9u8) {
                    end = end - 1usize
                }
                var res = String.new()
                var k = start
                while k < end {
                    res.push_byte(p[k])
                    k = k + 1usize
                }
                res.push_byte(0u8)
                return res.as_ptr() as str
            }
            if i < flen && p[i] == 44u8 {
                i = i + 1usize
            }
            cur_idx = cur_idx + 1usize
        }
        return ""
    }

    fn get_lambda_caps(self, fn_idx: usize) -> Vec<String> {
        var mi = 0usize
        while mi < self.closure_metas.len {
            if self.closure_metas.ptr[mi].fn_idx == fn_idx {
                return self.closure_metas.ptr[mi].cap_vars
            }
            mi = mi + 1usize
        }
        return Vec.new()
    }

    fn is_lambda_capturing(self, fn_idx: usize) -> bool {
        let caps = self.get_lambda_caps(fn_idx)
        return caps.len > 0usize
    }

    fn is_expr_closure(self, expr_id: usize) -> bool {
        if expr_id == 0usize || expr_id >= self.parser.exprs.len {
            return false
        }
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_LAMBDA {
            let fn_idx = ep[expr_id].int_val as usize
            return self.is_lambda_capturing(fn_idx)
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            let vty = self.get_raw_var_type(vname)
            if str_starts_with(vty, "closure(") {
                return true
            }
        }
        return false
    }

    fn extract_module_stem(self, fpath: str) -> String {
        let flen = str_len(fpath)
        if flen == 0usize {
            return String.new()
        }
        let p = fpath as *raw u8
        var last_slash = 0usize
        var has_slash = false
        var i = 0usize
        while i < flen {
            if p[i] == 47u8 || p[i] == 92u8 {
                last_slash = i + 1usize
                has_slash = true
            }
            i = i + 1usize
        }
        var start = 0usize
        if has_slash {
            start = last_slash
        }
        var end = flen
        var j = flen
        while j > start {
            if p[j - 1usize] == 46u8 {
                end = j - 1usize
                break
            }
            j = j - 1usize
        }
        var stem = String.new()
        var k = start
        while k < end {
            let c = p[k]
            if (c >= 97u8 && c <= 122u8) || (c >= 65u8 && c <= 90u8) || (c >= 48u8 && c <= 57u8) || c == 95u8 {
                stem.push_byte(c)
            } else if c == 45u8 {
                stem.push_byte(95u8)
            }
            k = k + 1usize
        }
        stem.push_byte(0u8)
        return stem
    }

    fn resolve_function_name(self, name: str, source_id: usize) -> str {
        if (name as usize) == 0usize || str_len(name) == 0usize {
            return name
        }
        if str_eq(name, "println") || str_eq(name, "print") || str_eq(name, "eprintln") || str_eq(name, "panic") ||
           str_eq(name, "size_of") || str_eq(name, "size_of_val") || str_eq(name, "null") || str_eq(name, "null_var") ||
           str_eq(name, "is_null") || str_eq(name, "ptr_read") || str_eq(name, "ptr_write") || str_eq(name, "read_volatile") ||
           str_eq(name, "write_volatile") || str_eq(name, "offset") || str_eq(name, "offset_var") || str_eq(name, "now") {
            return name
        }
        if !str_contains(name, "__") {
            if source_id < self.parser.source_files.len {
                let stem = self.extract_module_stem(self.parser.source_files.ptr[source_id].file_path.as_ptr() as str)
                let stem_s = stem.as_ptr() as str
                if str_len(stem_s) > 0usize {
                    var local_mangled = String.new()
                    local_mangled.push_str(stem_s)
                    local_mangled.push_str("__")
                    local_mangled.push_str(name)
                    local_mangled.push_byte(0u8)
                    let lm_s = local_mangled.as_ptr() as str
                    var fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, lm_s) {
                            return lm_s
                        }
                        fi = fi + 1usize
                    }
                }
            }
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, name) {
                return name
            }
            fi = fi + 1usize
        }
        if !str_contains(name, "__") {
            var suff = String.new()
            suff.push_str("__")
            suff.push_str(name)
            suff.push_byte(0u8)
            let suff_s = suff.as_ptr() as str
            let slen = str_len(suff_s)
            var match_fn = ""
            var match_cnt = 0usize
            fi = 0usize
            while fi < self.parser.functions.len {
                let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                if str_ends_with(fn_s, suff_s) {
                    let flen = str_len(fn_s)
                    var prefix_buf = String.new()
                    let p_fn = fn_s as *raw u8
                    var pi = 0usize
                    while pi < flen - slen {
                        prefix_buf.push_byte(p_fn[pi])
                        pi = pi + 1usize
                    }
                    prefix_buf.push_byte(0u8)
                    let p_str = prefix_buf.as_ptr() as str
                    var is_mod = false
                    var si = 0usize
                    while si < self.parser.source_files.len {
                        let fpath = self.parser.source_files.ptr[si].file_path.as_ptr() as str
                        let stem = self.extract_module_stem(fpath)
                        if str_eq(stem.as_ptr() as str, p_str) {
                            is_mod = true
                            break
                        }
                        si = si + 1usize
                    }
                    if is_mod && !self.is_struct_name(p_str) {
                        match_fn = fn_s
                        match_cnt = match_cnt + 1usize
                    }
                }
                fi = fi + 1usize
            }
            if match_cnt == 1usize {
                return match_fn
            }
        }
        return name
    }

    fn build_lambda_fn_type_str(self, fn_idx: usize) -> str {
        if fn_idx >= self.parser.functions.len {
            return "ptr"
        }
        let fdef = self.parser.functions.ptr[fn_idx]
        var s = String.new()
        if self.is_lambda_capturing(fn_idx) {
            s.push_str("closure(")
        } else {
            s.push_str("fn(")
        }
        var pi = 0usize
        while pi < fdef.param_types.len {
            if pi > 0usize { s.push_str(", ") }
            let pty = fdef.param_types.ptr[pi].as_ptr() as str
            if str_eq(pty, "__rad_infer") || str_len(pty) == 0usize {
                s.push_str("i64")
            } else {
                s.push_str(pty)
            }
            pi = pi + 1usize
        }
        s.push_str(")")
        let rty = fdef.ret_type.as_ptr() as str
        if !str_eq(rty, "void") && str_len(rty) > 0usize {
            s.push_str(" -> ")
            if str_eq(rty, "__rad_infer") {
                s.push_str("i64")
            } else {
                s.push_str(rty)
            }
        }
        s.push_byte(0u8)
        return s.as_ptr() as str
    }

    fn get_indirect_param_llvm_type(self, callee_id: usize, callee_name: str, param_idx: usize, a_expr: usize) -> str {
        let ep = self.parser.exprs.ptr
        if ep[callee_id].kind == EXPR_LAMBDA {
            let l_idx = ep[callee_id].int_val as usize
            if l_idx < self.parser.functions.len && param_idx < self.parser.functions.ptr[l_idx].param_types.len {
                let raw_pt = self.parser.functions.ptr[l_idx].param_types.ptr[param_idx].as_ptr() as str
                if !str_eq(raw_pt, "__rad_infer") && str_len(raw_pt) > 0usize {
                    return self.emit_llvm_type(raw_pt)
                }
            }
        }
        let vty = self.get_raw_var_type(callee_name)
        if str_starts_with(vty, "fn(") || str_starts_with(vty, "closure(") {
            let raw_pt = self.parse_fn_ptr_param_type(vty, param_idx)
            if str_len(raw_pt) > 0usize {
                return self.emit_llvm_type(raw_pt)
            }
        }
        if self.is_expr_ptr(a_expr) {
            return "ptr"
        }
        if self.is_expr_float(a_expr) {
            return "double"
        }
        return "i64"
    }

    fn get_indirect_ret_llvm_type(self, callee_id: usize, callee_name: str) -> str {
        let ep = self.parser.exprs.ptr
        if ep[callee_id].kind == EXPR_LAMBDA {
            let l_idx = ep[callee_id].int_val as usize
            if l_idx < self.parser.functions.len {
                let rty = self.parser.functions.ptr[l_idx].ret_type.as_ptr() as str
                if str_eq(rty, "__rad_infer") {
                    return "i64"
                }
                return self.emit_llvm_type(rty)
            }
        }
        let vty = self.get_raw_var_type(callee_name)
        if str_len(vty) > 0usize && (str_starts_with(vty, "fn") || str_starts_with(vty, "closure")) {
            return self.get_func_ptr_ret_type(vty)
        }
        return "i64"
    }

    fn find_var_type_in_stmts(self, stmt_id: usize, vname: str) -> str {
        let sp = self.parser.stmts.ptr
        let k = sp[stmt_id].kind
        if k == STMT_LET || k == STMT_VAR {
            if str_eq(sp[stmt_id].name.as_ptr() as str, vname) {
                let st_ty = sp[stmt_id].type_name.as_ptr() as str
                if str_len(st_ty) > 0usize {
                    return st_ty
                }
                let init_e = sp[stmt_id].expr_id
                if init_e != 0usize {
                    if sp[stmt_id].index_expr == 1usize {
                        var opt_expr_id = init_e
                        if self.parser.exprs.ptr[init_e].kind == EXPR_CALL && self.parser.exprs.ptr[init_e].args.len > 0usize {
                            opt_expr_id = self.parser.exprs.ptr[init_e].args.ptr[0usize]
                        }
                        var inner_ty = self.get_expr_struct_name(opt_expr_id)
                        if str_len(inner_ty) == 0usize && self.parser.exprs.ptr[opt_expr_id].kind == EXPR_IDENT {
                            inner_ty = self.get_raw_var_type(self.parser.exprs.ptr[opt_expr_id].str_val.as_ptr() as str)
                        }
                        if str_starts_with(inner_ty, "Option<") {
                            let plen = str_len(inner_ty)
                            if plen > 8usize {
                                var inner = String.new()
                                let cp = inner_ty as *raw u8
                                var ci = 7usize
                                while ci < plen && cp[ci] != 62u8 {
                                    inner.push_byte(cp[ci])
                                    ci = ci + 1usize
                                }
                                inner.push_byte(0u8)
                                return inner.as_ptr() as str
                            }
                        }
                        if str_starts_with(inner_ty, "Result<") {
                            let plen = str_len(inner_ty)
                            if plen > 8usize {
                                var inner = String.new()
                                let cp = inner_ty as *raw u8
                                var ci = 7usize
                                while ci < plen && cp[ci] != 44u8 && cp[ci] != 62u8 {
                                    inner.push_byte(cp[ci])
                                    ci = ci + 1usize
                                }
                                inner.push_byte(0u8)
                                return inner.as_ptr() as str
                            }
                        }
                        if str_len(inner_ty) > 0usize && !str_eq(inner_ty, "Option") && !str_eq(inner_ty, "Result") {
                            return inner_ty
                        }
                    }
                    if self.is_expr_float(init_e) {
                        return "f64"
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_ARRAY_LITERAL {
                        if self.parser.exprs.ptr[init_e].args.len > 0usize {
                            let first_arg = self.parser.exprs.ptr[init_e].args.ptr[0usize]
                            if self.is_expr_float(first_arg) {
                                return "[]f64"
                            }
                        }
                        return "[]i64"
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_FSTRING {
                        return "String"
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_LAMBDA {
                        return self.build_lambda_fn_type_str(self.parser.exprs.ptr[init_e].int_val as usize)
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_TUPLE {
                        var tup_ty = String.new()
                        tup_ty.push_str("(")
                        var ai = 0usize
                        while ai < self.parser.exprs.ptr[init_e].args.len {
                            let a_id = self.parser.exprs.ptr[init_e].args.ptr[ai]
                            if self.is_expr_float(a_id) {
                                tup_ty.push_str("f64")
                            } else if self.is_expr_ptr(a_id) {
                                tup_ty.push_str("ptr")
                            } else {
                                tup_ty.push_str("i64")
                            }
                            if ai + 1usize < self.parser.exprs.ptr[init_e].args.len {
                                tup_ty.push_str(", ")
                            }
                            ai = ai + 1usize
                        }
                        tup_ty.push_str(")")
                        return tup_ty.as_ptr() as str
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_CALL {
                        let callee = self.parser.exprs.ptr[init_e].left
                        if self.parser.exprs.ptr[callee].kind == EXPR_IDENT {
                            let callee_name = self.parser.exprs.ptr[callee].str_val.as_ptr() as str
                            let ret_t = self.get_raw_func_ret_type(callee_name)
                            if str_len(ret_t) > 0usize && !str_eq(ret_t, "void") {
                                return ret_t
                            }
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_TRY {
                        let inner_id = self.parser.exprs.ptr[init_e].left
                        var inner_ty = self.get_expr_struct_name(inner_id)
                        if str_len(inner_ty) == 0usize && self.parser.exprs.ptr[inner_id].kind == EXPR_IDENT {
                            inner_ty = self.get_raw_var_type(self.parser.exprs.ptr[inner_id].str_val.as_ptr() as str)
                        }
                        if str_starts_with(inner_ty, "Option<") {
                            let plen = str_len(inner_ty)
                            if plen > 8usize {
                                var inner = String.new()
                                let cp = inner_ty as *raw u8
                                var ci = 7usize
                                while ci < plen && cp[ci] != 62u8 {
                                    inner.push_byte(cp[ci])
                                    ci = ci + 1usize
                                }
                                inner.push_byte(0u8)
                                return inner.as_ptr() as str
                            }
                        }
                        if str_starts_with(inner_ty, "Result<") {
                            let plen = str_len(inner_ty)
                            if plen > 8usize {
                                var inner = String.new()
                                let cp = inner_ty as *raw u8
                                var ci = 7usize
                                while ci < plen && cp[ci] != 44u8 && cp[ci] != 62u8 {
                                    inner.push_byte(cp[ci])
                                    ci = ci + 1usize
                                }
                                inner.push_byte(0u8)
                                return inner.as_ptr() as str
                            }
                        }
                        if str_len(inner_ty) > 0usize {
                            return inner_ty
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_IDENT {
                        let id_name = self.parser.exprs.ptr[init_e].str_val.as_ptr() as str
                        if str_eq(id_name, "None") || str_eq(id_name, "Option::None") {
                            return "Option"
                        }
                        let raw_t = self.get_raw_var_type(id_name)
                        if str_len(raw_t) > 0usize {
                            return raw_t
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_CAST {
                        let c_ty = self.parser.exprs.ptr[init_e].target_type.as_ptr() as str
                        if str_len(c_ty) > 0usize {
                            return c_ty
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_FIELD_ACCESS {
                        let fname = self.parser.exprs.ptr[init_e].field_name.as_ptr() as str
                        let recv_id = self.parser.exprs.ptr[init_e].left
                        let fname_p = fname as *raw u8
                        if str_len(fname) > 0usize && fname_p[0] >= 48u8 && fname_p[0] <= 57u8 {
                            let f_idx = parse_int(fname)
                            let elem_ty = self.get_tuple_elem_type(recv_id, f_idx)
                            if str_len(elem_ty) > 0usize {
                                return elem_ty
                            }
                        }
                        let parent_struct = self.get_expr_struct_name(recv_id)
                        if str_eq(parent_struct, "Option") {
                            return "Option"
                        }
                        if str_eq(parent_struct, "Result") {
                            return "Result"
                        }
                        if str_len(parent_struct) > 0usize {
                            var si = 0usize
                            while si < self.parser.structs.len {
                                let sdef = self.parser.structs.ptr[si]
                                if self.match_struct_name(sdef.struct_name.as_ptr() as str, parent_struct) {
                                    var fi = 0usize
                                    while fi < sdef.field_names.len {
                                        if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                            return sdef.field_types.ptr[fi].as_ptr() as str
                                        }
                                        fi = fi + 1usize
                                    }
                                }
                                si = si + 1usize
                            }
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_METHOD_CALL {
                        let recv_id = self.parser.exprs.ptr[init_e].left
                        let member = self.parser.exprs.ptr[init_e].str_val.as_ptr() as str
                        let clean_m = self.clean_type_name(member)
                        let struct_name = self.get_expr_struct_name(recv_id)
                        if str_starts_with(struct_name, "Option") {
                            if str_eq(clean_m, "is_some") || str_eq(clean_m, "is_none") {
                                return "bool"
                            }
                            if str_eq(clean_m, "unwrap") || str_eq(clean_m, "unwrap_or") {
                                if str_starts_with(struct_name, "Option<") {
                                    let plen = str_len(struct_name)
                                    if plen > 8usize {
                                        var inner = String.new()
                                        let cp = struct_name as *raw u8
                                        var ci = 7usize
                                        while ci < plen && cp[ci] != 62u8 {
                                            inner.push_byte(cp[ci])
                                            ci = ci + 1usize
                                        }
                                        inner.push_byte(0u8)
                                        return inner.as_ptr() as str
                                    }
                                }
                                return "i64"
                            }
                            if str_starts_with(struct_name, "Option<") {
                                let plen = str_len(struct_name)
                                if plen > 8usize {
                                    var inner = String.new()
                                    let cp = struct_name as *raw u8
                                    var ci = 7usize
                                    while ci < plen && cp[ci] != 62u8 {
                                        inner.push_byte(cp[ci])
                                        ci = ci + 1usize
                                    }
                                    inner.push_byte(0u8)
                                    let inner_ty = inner.as_ptr() as str
                                    var m_try = String.new()
                                    m_try.push_str(inner_ty)
                                    m_try.push_str("__")
                                    m_try.push_str(clean_m)
                                    m_try.push_byte(0u8)
                                    var fi_opt = 0usize
                                    while fi_opt < self.parser.functions.len {
                                        if str_eq(self.parser.functions.ptr[fi_opt].fn_name.as_ptr() as str, m_try.as_ptr() as str) {
                                            let raw_r = self.parser.functions.ptr[fi_opt].ret_type.as_ptr() as str
                                            if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                                return raw_r
                                            }
                                        }
                                        fi_opt = fi_opt + 1usize
                                    }
                                }
                            }
                            return "Option"
                        }
                        if str_eq(struct_name, "Result") {
                            return "Result"
                        }
                        if (str_eq(clean_m, "get") || str_eq(clean_m, "pop")) && (str_eq(struct_name, "Vec") || str_starts_with(struct_name, "Vec<")) {
                            if str_starts_with(struct_name, "Vec<") {
                                let plen = str_len(struct_name)
                                if plen > 5usize {
                                    var opt_t = String.new()
                                    opt_t.push_str("Option<")
                                    let cp = struct_name as *raw u8
                                    var ci = 4usize
                                    while ci < plen && cp[ci] != 62u8 {
                                        opt_t.push_byte(cp[ci])
                                        ci = ci + 1usize
                                    }
                                    opt_t.push_byte(62u8) // '>'
                                    opt_t.push_byte(0u8)
                                    return opt_t.as_ptr() as str
                                }
                            }
                            return "Option"
                        }
                        if str_len(struct_name) > 0usize {
                            if str_eq(clean_m, "new") {
                                return struct_name
                            }
                            if str_eq(struct_name, "String") && (str_eq(clean_m, "to_int") || str_eq(clean_m, "parse_int")) {
                                return "i64"
                            }
                            if str_eq(struct_name, "Vec") && (str_eq(clean_m, "map") || str_eq(clean_m, "filter")) {
                                return "Vec"
                            }
                            var mangled = String.new()
                            mangled.push_str(struct_name)
                            mangled.push_str("__")
                            mangled.push_str(clean_m)
                            mangled.push_byte(0u8)
                            var fi = 0usize
                            while fi < self.parser.functions.len {
                                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, mangled.as_ptr() as str) {
                                    let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                    if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                        return raw_r
                                    }
                                    break
                                }
                                fi = fi + 1usize
                            }
                            let base_ty = self.clean_type_name(struct_name)
                            if !str_eq(base_ty, struct_name) && str_len(base_ty) > 0usize {
                                var bm = String.new()
                                bm.push_str(base_ty)
                                bm.push_str("__")
                                bm.push_str(clean_m)
                                bm.push_byte(0u8)
                                fi = 0usize
                                while fi < self.parser.functions.len {
                                    if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, bm.as_ptr() as str) {
                                        let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                        if str_contains(struct_name, "<") {
                                            var si = 0usize
                                            while si < self.parser.structs.len {
                                                let sdef = self.parser.structs.ptr[si]
                                                if self.match_struct_name(sdef.struct_name.as_ptr() as str, base_ty) {
                                                    var fld_i = 0usize
                                                    while fld_i < sdef.field_names.len {
                                                        if str_eq(sdef.field_types.ptr[fld_i].as_ptr() as str, raw_r) {
                                                            let mono = self.get_monomorphized_field_type(sdef, struct_name, fld_i)
                                                            if str_len(mono) > 0usize {
                                                                return mono
                                                            }
                                                        }
                                                        fld_i = fld_i + 1usize
                                                    }
                                                    break
                                                }
                                                si = si + 1usize
                                            }
                                        }
                                        if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                            return raw_r
                                        }
                                        break
                                    }
                                    fi = fi + 1usize
                                }
                            }
                        }
                        var fi_std = 0usize
                        while fi_std < self.parser.functions.len {
                            if str_eq(self.parser.functions.ptr[fi_std].fn_name.as_ptr() as str, member) {
                                let raw_r = self.parser.functions.ptr[fi_std].ret_type.as_ptr() as str
                                if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                    return raw_r
                                }
                                break
                            }
                            fi_std = fi_std + 1usize
                        }
                        if self.parser.exprs.ptr[recv_id].kind == EXPR_IDENT {
                            let rname = self.parser.exprs.ptr[recv_id].str_val.as_ptr() as str
                            let rty = self.get_raw_var_type(rname)
                            if str_eq(rname, "Vec") || str_starts_with(rty, "Vec") {
                                if str_eq(clean_m, "get") || str_eq(clean_m, "pop") {
                                    return "Option"
                                }
                                return "Vec"
                            }
                            if str_eq(rname, "String") {
                                if str_eq(clean_m, "to_int") || str_eq(clean_m, "parse_int") {
                                    return "i64"
                                }
                                return "String"
                            }
                            if str_eq(rname, "Option") {
                                return "Option"
                            }
                            if str_eq(rname, "Result") {
                                return "Result"
                            }
                            if self.is_struct_name(rname) {
                                if str_eq(member, "new") {
                                    return rname
                                }
                                var mangled = String.new()
                                mangled.push_str(rname)
                                mangled.push_str("__")
                                mangled.push_str(member)
                                mangled.push_byte(0u8)
                                var fi = 0usize
                                while fi < self.parser.functions.len {
                                    if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, mangled.as_ptr() as str) {
                                        let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                        if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                            return raw_r
                                        }
                                        break
                                    }
                                    fi = fi + 1usize
                                }
                                return rname
                            }
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_INDEX {
                        let idx_ty = self.get_expr_struct_name(init_e)
                        if str_len(idx_ty) > 0usize {
                            return idx_ty
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_IDENT {
                        let rhs_name = self.parser.exprs.ptr[init_e].str_val.as_ptr() as str
                        let rhs_ty = self.get_raw_var_type(rhs_name)
                        if str_len(rhs_ty) > 0usize && !str_eq(rhs_ty, "i64") {
                            return rhs_ty
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_CALL {
                        let callee = self.parser.exprs.ptr[init_e].left
                        if self.parser.exprs.ptr[callee].kind == EXPR_IDENT {
                            let cname = self.parser.exprs.ptr[callee].str_val.as_ptr() as str
                            if str_eq(cname, "Some") || str_eq(cname, "None") {
                                return "Option"
                            }
                            if str_eq(cname, "Ok") || str_eq(cname, "Err") {
                                return "Result"
                            }
                            if str_eq(cname, "input") {
                                return "String"
                            }
                            if str_eq(cname, "parse_int") || str_eq(cname, "String__to_int") || str_eq(cname, "String__parse_int") {
                                return "i64"
                            }
                            if self.is_struct_name(cname) {
                                return cname
                            }
                            let resolved_cname = self.resolve_function_name(cname, 0usize)
                            var fi = 0usize
                            while fi < self.parser.functions.len {
                                let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                                if str_eq(fn_s, cname) || str_eq(fn_s, resolved_cname) {
                                    let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                    if str_len(raw_r) > 0usize && !str_eq(raw_r, "i64") && !str_eq(raw_r, "void") {
                                        return raw_r
                                    }
                                    break
                                }
                                fi = fi + 1usize
                            }
                        } else if self.parser.exprs.ptr[callee].kind == EXPR_FIELD_ACCESS {
                            let recv_id = self.parser.exprs.ptr[callee].left
                            if self.parser.exprs.ptr[recv_id].kind == EXPR_IDENT {
                                let rname = self.parser.exprs.ptr[recv_id].str_val.as_ptr() as str
                                if str_eq(rname, "Vec") {
                                    return "Vec"
                                }
                                if str_eq(rname, "String") {
                                    return "String"
                                }
                                if str_eq(rname, "Option") {
                                    return "Option"
                                }
                                if str_eq(rname, "Result") {
                                    return "Result"
                                }
                                if self.is_struct_name(rname) {
                                    return rname
                                }
                            }
                        }
                    }
                    if self.parser.exprs.ptr[init_e].kind == EXPR_METHOD_CALL {
                        let m_recv = self.parser.exprs.ptr[init_e].left
                        let m_name = self.parser.exprs.ptr[init_e].str_val.as_ptr() as str
                        if self.parser.exprs.ptr[m_recv].kind == EXPR_IDENT {
                            let rec_id = self.parser.exprs.ptr[m_recv].str_val.as_ptr() as str
                            if str_eq(rec_id, "Option") {
                                return "Option"
                            }
                            if str_eq(rec_id, "Result") {
                                return "Result"
                            }
                        }
                        let recv_ty = self.get_expr_struct_name(m_recv)
                        if str_len(recv_ty) > 0usize {
                            let base_ty = self.clean_type_name(recv_ty)
                            var bm = String.new()
                            bm.push_str(base_ty)
                            bm.push_str("__")
                            bm.push_str(m_name)
                            bm.push_byte(0u8)
                            let bm_name = bm.as_ptr() as str
                            var fi = 0usize
                            while fi < self.parser.functions.len {
                                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, bm_name) {
                                    let raw_r = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                                    if str_contains(recv_ty, "<") {
                                        var si = 0usize
                                        while si < self.parser.structs.len {
                                            let sdef = self.parser.structs.ptr[si]
                                            if self.match_struct_name(sdef.struct_name.as_ptr() as str, base_ty) {
                                                var fld_i = 0usize
                                                while fld_i < sdef.field_names.len {
                                                    if str_eq(sdef.field_types.ptr[fld_i].as_ptr() as str, raw_r) {
                                                        let mono = self.get_monomorphized_field_type(sdef, recv_ty, fld_i)
                                                        if str_len(mono) > 0usize {
                                                            return mono
                                                        }
                                                    }
                                                    fld_i = fld_i + 1usize
                                                }
                                                break
                                            }
                                            si = si + 1usize
                                        }
                                    }
                                    if str_len(raw_r) > 0usize && !str_eq(raw_r, "void") {
                                        return raw_r
                                    }
                                    break
                                }
                                fi = fi + 1usize
                            }
                        }
                    }
                }
                return "i64"
            }
        }
        if k == STMT_IF {
            var i = 0usize
            while i < sp[stmt_id].then_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].then_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
            var j = 0usize
            while j < sp[stmt_id].else_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].else_stmts.ptr[j], vname)
                if str_len(ty) > 0usize { return ty }
                j = j + 1usize
            }
        }
        if k == STMT_WHILE {
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].body_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
        }
        if k == STMT_FOR_RANGE {
            if str_eq(sp[stmt_id].name.as_ptr() as str, vname) {
                return "usize"
            }
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].body_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
        }
        if k == STMT_FOR_IN {
            if str_eq(sp[stmt_id].name.as_ptr() as str, vname) {
                let st_ty = sp[stmt_id].type_name.as_ptr() as str
                if str_len(st_ty) > 0usize {
                    return st_ty
                }
                let coll_id = sp[stmt_id].expr_id
                if coll_id != 0usize && coll_id < self.parser.exprs.len {
                    let ep = self.parser.exprs.ptr
                    if ep[coll_id].kind == EXPR_ARRAY_LITERAL {
                        if ep[coll_id].args.len > 0usize {
                            let first_arg = ep[coll_id].args.ptr[0usize]
                            if self.is_expr_float(first_arg) {
                                return "f64"
                            }
                        }
                    }
                    if ep[coll_id].kind == EXPR_IDENT {
                        let cname = ep[coll_id].str_val.as_ptr() as str
                        let raw_coll_ty = self.get_raw_var_type(cname)
                        if str_starts_with(raw_coll_ty, "Vec<") {
                            let plen = str_len(raw_coll_ty)
                            if plen > 5usize {
                                var inner = String.new()
                                let cp = raw_coll_ty as *raw u8
                                var ci = 4usize
                                while ci < plen && cp[ci] != 62u8 {
                                    inner.push_byte(cp[ci])
                                    ci = ci + 1usize
                                }
                                inner.push_byte(0u8)
                                return inner.as_ptr() as str
                            }
                        } else if str_starts_with(raw_coll_ty, "[]") {
                            return (raw_coll_ty as usize + 2usize) as str
                        } else if str_eq(raw_coll_ty, "Vec") {
                            if self.current_func_idx < self.parser.functions.len {
                                let cur_fn = self.parser.functions.ptr[self.current_func_idx]
                                var bi = 0usize
                                while bi < cur_fn.body.len {
                                    let bs = cur_fn.body.ptr[bi]
                                    if sp[bs].kind == STMT_EXPR {
                                        let eid = sp[bs].expr_id
                                        if ep[eid].kind == EXPR_METHOD_CALL {
                                            let recv = ep[eid].left
                                            let mname = ep[eid].str_val.as_ptr() as str
                                            if ep[recv].kind == EXPR_IDENT && str_eq(ep[recv].str_val.as_ptr() as str, cname) && str_eq(mname, "push") && ep[eid].args.len > 0usize {
                                                let arg0 = ep[eid].args.ptr[0usize]
                                                if ep[arg0].kind == EXPR_STR {
                                                    return "String"
                                                }
                                                if ep[arg0].kind == EXPR_CALL {
                                                    let c_callee = ep[arg0].left
                                                    if ep[c_callee].kind == EXPR_IDENT {
                                                        let cfn = ep[c_callee].str_val.as_ptr() as str
                                                        if self.is_struct_name(cfn) {
                                                            return cfn
                                                        }
                                                    }
                                                }
                                                if ep[arg0].kind == EXPR_METHOD_CALL {
                                                    let mrecv = ep[arg0].left
                                                    if ep[mrecv].kind == EXPR_IDENT && str_eq(ep[mrecv].str_val.as_ptr() as str, "String") {
                                                        return "String"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    bi = bi + 1usize
                                }
                            }
                        }
                    }
                }
                return "i64"
            }
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].body_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
        }
        if k == STMT_DEFER {
            var i = 0usize
            while i < sp[stmt_id].body_stmts.len {
                let ty = self.find_var_type_in_stmts(sp[stmt_id].body_stmts.ptr[i], vname)
                if str_len(ty) > 0usize { return ty }
                i = i + 1usize
            }
        }
        return ""
    }

    fn get_raw_var_type(self, vname: str) -> str {
        if str_eq(vname, "argv") {
            return "*raw *raw u8"
        }
        if self.current_func_idx < self.parser.functions.len {
            let cur_fn = self.parser.functions.ptr[self.current_func_idx]
            var pi = 0usize
            while pi < cur_fn.param_names.len {
                if str_eq(cur_fn.param_names.ptr[pi].as_ptr() as str, vname) {
                    return cur_fn.param_types.ptr[pi].as_ptr() as str
                }
                pi = pi + 1usize
            }
            var bi = 0usize
            while bi < cur_fn.body.len {
                let ty = self.find_var_type_in_stmts(cur_fn.body.ptr[bi], vname)
                if str_len(ty) > 0usize {
                    return ty
                }
                bi = bi + 1usize
            }
        }
        var si = 0usize
        while si < self.parser.stmts.len {
            let sk = self.parser.stmts.ptr[si].kind
            if (sk == STMT_LET || sk == STMT_VAR) && str_eq(self.parser.stmts.ptr[si].name.as_ptr() as str, vname) {
                let st_ty = self.parser.stmts.ptr[si].type_name.as_ptr() as str
                if str_len(st_ty) > 0usize {
                    return st_ty
                }
                let init_e = self.parser.stmts.ptr[si].expr_id
                if init_e != 0usize && self.is_expr_float(init_e) {
                    return "f64"
                }
                if init_e != 0usize && self.parser.exprs.ptr[init_e].kind == EXPR_ARRAY_LITERAL {
                    return "[]i64"
                }
                if init_e != 0usize && self.parser.exprs.ptr[init_e].kind == EXPR_FSTRING {
                    return "String"
                }
            }
            si = si + 1usize
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            var pi = 0usize
            while pi < self.parser.functions.ptr[fi].param_names.len {
                if str_eq(self.parser.functions.ptr[fi].param_names.ptr[pi].as_ptr() as str, vname) {
                    return self.parser.functions.ptr[fi].param_types.ptr[pi].as_ptr() as str
                }
                pi = pi + 1usize
            }
            fi = fi + 1usize
        }
        return ""
    }

    fn get_var_type(self, vname: str) -> str {
        let raw: str = self.get_raw_var_type(vname)
        if str_len(raw) > 0usize {
            let lt = self.emit_llvm_type(raw)
            if str_eq(lt, "void") {
                return "i64"
            }
            return lt
        }
        return "i64"
    }

    fn clean_type_name(self, ty: str) -> str {
        if str_len(ty) == 0usize {
            return ""
        }
        var s = ty
        var changed = true
        while changed {
            changed = false
            while str_starts_with(s, " ") {
                s = (s as usize + 1usize) as str
                changed = true
            }
            if str_starts_with(s, "*") || str_starts_with(s, "&") {
                s = (s as usize + 1usize) as str
                changed = true
            } else if str_starts_with(s, "raw ") {
                s = (s as usize + 4usize) as str
                changed = true
            } else if str_starts_with(s, "const ") {
                s = (s as usize + 6usize) as str
                changed = true
            } else if str_starts_with(s, "var ") {
                s = (s as usize + 4usize) as str
                changed = true
            }
        }
        while str_starts_with(s, " ") {
            s = (s as usize + 1usize) as str
        }
        var i = 0usize
        let p = s as *raw u8
        while p[i] != 0u8 {
            if p[i] == 60u8 { // '<'
                var base = String.new()
                var k = 0usize
                while k < i {
                    base.push_byte(p[k])
                    k = k + 1usize
                }
                base.push_byte(0u8)
                return base.as_ptr() as str
            }
            i = i + 1usize
        }
        return s
    }

    fn extract_type_arg(self, s: str) -> str {
        let p = s as *raw u8
        let slen = str_len(s)
        var i = 0usize
        while i < slen && p[i] != 60u8 { // '<'
            i = i + 1usize
        }
        if i >= slen {
            return ""
        }
        var j = slen
        while j > i && p[j - 1usize] != 62u8 { // '>'
            j = j - 1usize
        }
        if j <= i + 1usize {
            return ""
        }
        var res = String.new()
        var k = i + 1usize
        while k < j - 1usize {
            res.push_byte(p[k])
            k = k + 1usize
        }
        res.push_byte(0u8)
        return res.as_ptr() as str
    }

    fn get_expr_struct_name(self, expr_id: usize) -> str {
        if expr_id == 0usize || expr_id >= self.parser.exprs.len {
            return ""
        }
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_FSTRING {
            return "String"
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            if str_eq(vname, "Option") || str_eq(vname, "Result") || self.is_struct_name(vname) {
                return vname
            }
            let raw = self.get_raw_var_type(vname)
            if str_starts_with(raw, "*") || str_starts_with(raw, "&") || str_starts_with(raw, "raw ") || str_starts_with(raw, "var ") {
                return self.clean_type_name(raw)
            }
            return raw
        }
        if k == EXPR_FIELD_ACCESS {
            let recv_id = ep[expr_id].left
            let parent_struct = self.get_expr_struct_name(recv_id)
            let fname = ep[expr_id].field_name.as_ptr() as str
            if str_eq(parent_struct, "Option") && str_eq(fname, "None") {
                return "Option"
            }
            if str_starts_with(parent_struct, "Vec<") && str_eq(fname, "ptr") {
                return ""
            }
            if str_len(parent_struct) > 0usize {
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if self.match_struct_name(sdef.struct_name.as_ptr() as str, parent_struct) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                if str_starts_with(fty, "Vec<") {
                                    return fty
                                }
                                return self.clean_type_name(fty)
                            }
                            fi = fi + 1usize
                        }
                    }
                    si = si + 1usize
                }
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[expr_id].left
            let member = ep[expr_id].str_val.as_ptr() as str
            var parent_struct = self.get_expr_struct_name(recv_id)
            if str_len(parent_struct) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                parent_struct = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            if str_starts_with(parent_struct, "Option<") {
                let clean_m = self.clean_type_name(member)
                if !str_eq(clean_m, "unwrap") && !str_eq(clean_m, "unwrap_or") && !str_eq(clean_m, "is_some") && !str_eq(clean_m, "is_none") && !str_eq(clean_m, "ok_or") && !str_eq(clean_m, "expect") {
                    let plen = str_len(parent_struct)
                    if plen > 8usize {
                        var inner = String.new()
                        let cp = parent_struct as *raw u8
                        var ci = 7usize
                        while ci < plen && cp[ci] != 62u8 {
                            inner.push_byte(cp[ci])
                            ci = ci + 1usize
                        }
                        inner.push_byte(0u8)
                        parent_struct = inner.as_ptr() as str
                    }
                }
            }
            if str_starts_with(parent_struct, "dyn ") {
                let trait_name = (parent_struct as usize + 4usize) as str
                var ti = 0usize
                while ti < self.parser.traits.len {
                    if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                        var mi = 0usize
                        while mi < self.parser.traits.ptr[ti].methods.len {
                            if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, member) {
                                return self.clean_type_name(self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str)
                            }
                            mi = mi + 1usize
                        }
                    }
                    ti = ti + 1usize
                }
            }
            let clean_m = self.clean_type_name(member)
            if (str_eq(clean_m, "get") || str_eq(clean_m, "pop")) && (str_eq(parent_struct, "Vec") || str_starts_with(parent_struct, "Vec<")) {
                if str_starts_with(parent_struct, "Vec<") {
                    let plen = str_len(parent_struct)
                    if plen > 5usize {
                        var opt_t = String.new()
                        opt_t.push_str("Option<")
                        let cp = parent_struct as *raw u8
                        var ci = 4usize
                        while ci < plen && cp[ci] != 62u8 {
                            opt_t.push_byte(cp[ci])
                            ci = ci + 1usize
                        }
                        opt_t.push_byte(62u8) // '>'
                        opt_t.push_byte(0u8)
                        return opt_t.as_ptr() as str
                    }
                }
                return "Option"
            }
            if str_len(parent_struct) > 0usize {
                var mangled = String.new()
                mangled.push_str(parent_struct)
                mangled.push_str("__")
                mangled.push_str(clean_m)
                mangled.push_byte(0u8)
                let m_name = mangled.as_ptr() as str
                var fi = 0usize
                while fi < self.parser.functions.len {
                    if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, m_name) {
                        return self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                    }
                    fi = fi + 1usize
                }
                let base_ty = self.clean_type_name(parent_struct)
                if !str_eq(base_ty, parent_struct) && str_len(base_ty) > 0usize {
                    var bm = String.new()
                    bm.push_str(base_ty)
                    bm.push_str("__")
                    bm.push_str(clean_m)
                    bm.push_byte(0u8)
                    let bm_name = bm.as_ptr() as str
                    fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, bm_name) {
                            return self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                        }
                        fi = fi + 1usize
                    }
                }
            }
            var fi = 0usize
            while fi < self.parser.functions.len {
                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, member) {
                    return self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                }
                fi = fi + 1usize
            }
        }
        if k == EXPR_CALL {
            let callee_id = ep[expr_id].left
            if ep[callee_id].kind == EXPR_IDENT {
                let cname = ep[callee_id].str_val.as_ptr() as str
                if str_eq(cname, "Some") || str_eq(cname, "None") {
                    return "Option"
                }
                if str_eq(cname, "Ok") || str_eq(cname, "Err") {
                    return "Result"
                }
                if self.is_struct_name(cname) {
                    return cname
                }
                let resolved_cname = self.resolve_function_name(cname, 0usize)
                var fi = 0usize
                while fi < self.parser.functions.len {
                    let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                    if str_eq(fn_s, cname) || str_eq(fn_s, resolved_cname) {
                        return self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                    }
                    fi = fi + 1usize
                }
            }
        }
        if k == EXPR_CAST {
            return self.clean_type_name(ep[expr_id].target_type.as_ptr() as str)
        }
        if k == EXPR_INDEX {
            let coll_id = ep[expr_id].left
            var coll_ty = ""
            if ep[coll_id].kind == EXPR_FIELD_ACCESS && str_eq(ep[coll_id].field_name.as_ptr() as str, "ptr") {
                coll_ty = self.get_expr_struct_name(ep[coll_id].left)
            } else {
                coll_ty = self.get_expr_struct_name(coll_id)
            }
            if str_len(coll_ty) == 0usize && ep[coll_id].kind == EXPR_IDENT {
                coll_ty = self.get_raw_var_type(ep[coll_id].str_val.as_ptr() as str)
            }
            if str_starts_with(coll_ty, "Vec<") {
                let plen = str_len(coll_ty)
                if plen > 5usize {
                    var inner = String.new()
                    let cp = coll_ty as *raw u8
                    var ci = 4usize
                    var depth = 1
                    while ci < plen && depth > 0 {
                        if cp[ci] == 60u8 {
                            depth = depth + 1
                        } else if cp[ci] == 62u8 {
                            depth = depth - 1
                        }
                        if depth > 0 {
                            inner.push_byte(cp[ci])
                        }
                        ci = ci + 1usize
                    }
                    inner.push_byte(0u8)
                    return inner.as_ptr() as str
                }
            } else if str_starts_with(coll_ty, "[]") {
                return (coll_ty as usize + 2usize) as str
            } else if str_len(coll_ty) > 0usize && self.is_struct_name(coll_ty) {
                return coll_ty
            }
        }
        if k == EXPR_TRY || k == EXPR_AWAIT {
            return self.get_expr_struct_name(ep[expr_id].left)
        }
        return ""
    }

    fn get_monomorphized_field_type(self, sdef: StructDef, s_type: str, fi: usize) -> str {
        if fi >= sdef.field_types.len {
            return ""
        }
        let raw_fty = sdef.field_types.ptr[fi].as_ptr() as str
        if !str_contains(s_type, "<") {
            return raw_fty
        }
        let p = s_type as *raw u8
        let slen = str_len(s_type)
        var start_lt = 0usize
        while start_lt < slen && p[start_lt] != 60u8 { // '<'
            start_lt = start_lt + 1usize
        }
        if start_lt >= slen {
            return raw_fty
        }
        start_lt = start_lt + 1usize
        var cur_arg = String.new()
        var arg_idx = 0usize
        var depth = 0i64
        var pos = start_lt
        while pos < slen {
            let b = p[pos]
            if b == 60u8 { // '<'
                depth = depth + 1i64
                cur_arg.push_byte(b)
            } else if b == 62u8 { // '>'
                if depth == 0i64 {
                    if arg_idx == fi {
                        cur_arg.push_byte(0u8)
                        return cur_arg.as_ptr() as str
                    }
                    break
                } else {
                    depth = depth - 1i64
                    cur_arg.push_byte(b)
                }
            } else if b == 44u8 && depth == 0i64 { // ','
                if arg_idx == fi {
                    cur_arg.push_byte(0u8)
                    return cur_arg.as_ptr() as str
                }
                arg_idx = arg_idx + 1usize
                cur_arg = String.new()
            } else if b != 32u8 || cur_arg.len() > 0usize {
                cur_arg.push_byte(b)
            }
            pos = pos + 1usize
        }
        return raw_fty
    }

    fn emit_to_bool_i1(var self, expr_id: usize, reg: i32) -> i32 {
        let bool_reg = self.alloc_ssa()
        self.ir.push_str("  %")
        self.ir.push_str(int_to_str(bool_reg).as_ptr() as str)
        if self.is_expr_ptr(expr_id) {
            self.ir.push_str(" = icmp ne ptr %")
            self.ir.push_str(int_to_str(reg).as_ptr() as str)
            self.ir.push_str(", null\n")
        } else if self.is_expr_float(expr_id) {
            if self.is_expr_f32(expr_id) {
                self.ir.push_str(" = fcmp one float %")
                self.ir.push_str(int_to_str(reg).as_ptr() as str)
                self.ir.push_str(", 0.0\n")
            } else {
                self.ir.push_str(" = fcmp one double %")
                self.ir.push_str(int_to_str(reg).as_ptr() as str)
                self.ir.push_str(", 0.0\n")
            }
        } else {
            self.ir.push_str(" = icmp ne i64 %")
            self.ir.push_str(int_to_str(reg).as_ptr() as str)
            self.ir.push_str(", 0\n")
        }
        return bool_reg
    }

    fn is_expr_float(self, id: usize) -> bool {
        let ep = self.parser.exprs.ptr
        let k = ep[id].kind
        if k == EXPR_FLOAT {
            return true
        }
        if k == EXPR_IDENT {
            let vname = ep[id].str_val.as_ptr() as str
            let ty = self.get_var_type(vname)
            return str_eq(ty, "double") || str_eq(ty, "float")
        }
        if k == EXPR_BINARY {
            let op = ep[id].op
            if op == TOK_EQEQ || op == TOK_NEQ || op == TOK_LT || op == TOK_LEQ || op == TOK_GT || op == TOK_GEQ || op == TOK_ANDAND || op == TOK_OROR ||
               op == TOK_AMP || op == TOK_PIPE || op == TOK_CARET || op == TOK_SHL || op == TOK_SHR || op == TOK_PERCENT {
                return false
            }
            return self.is_expr_float(ep[id].left) || self.is_expr_float(ep[id].right)
        }
        if k == EXPR_CAST {
            let tgt = ep[id].target_type.as_ptr() as str
            return str_eq(tgt, "f64") || str_eq(tgt, "f32")
        }
        if k == EXPR_UNARY {
            return self.is_expr_float(ep[id].left)
        }
        if k == EXPR_TRY || k == EXPR_AWAIT {
            return self.is_expr_float(ep[id].left)
        }
        if k == EXPR_FIELD_ACCESS {
            let fname = ep[id].field_name.as_ptr() as str
            let fname_p = fname as *raw u8
            if str_len(fname) > 0usize && fname_p[0] >= 48u8 && fname_p[0] <= 57u8 {
                let recv_id = ep[id].left
                let f_idx = parse_int(fname)
                let elem_ty = self.get_tuple_elem_type(recv_id, f_idx)
                if str_len(elem_ty) > 0usize {
                    let lty = self.emit_llvm_type(elem_ty)
                    return str_eq(lty, "double") || str_eq(lty, "float")
                }
                if ep[recv_id].kind == EXPR_TUPLE && (f_idx as usize) < ep[recv_id].args.len {
                    return self.is_expr_float(ep[recv_id].args.ptr[f_idx as usize])
                }
                return false
            }
            let recv_id = ep[id].left
            var s_type = self.get_expr_struct_name(recv_id)
            if str_len(s_type) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                s_type = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            var si = 0usize
            while si < self.parser.structs.len {
                let sdef = self.parser.structs.ptr[si]
                if str_len(s_type) == 0usize || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                    var fi = 0usize
                    while fi < sdef.field_names.len {
                        if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                            let fty = self.get_monomorphized_field_type(sdef, s_type, fi)
                            return str_eq(fty, "f64") || str_eq(fty, "f32")
                        }
                        fi = fi + 1usize
                    }
                }
                si = si + 1usize
            }
        }
        if k == EXPR_INDEX {
            let left_id = ep[id].left
            if ep[left_id].kind == EXPR_IDENT {
                let raw_ty = self.get_raw_var_type(ep[left_id].str_val.as_ptr() as str)
                if str_ends_with(raw_ty, "f64") || str_ends_with(raw_ty, "f32") {
                    return true
                }
            } else if ep[left_id].kind == EXPR_FIELD_ACCESS {
                let fname = ep[left_id].field_name.as_ptr() as str
                let recv_id = ep[left_id].left
                let s_type = self.get_expr_struct_name(recv_id)
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if str_len(s_type) == 0usize || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                if str_ends_with(fty, "f64") || str_ends_with(fty, "f32") {
                                    return true
                                }
                            }
                            fi = fi + 1usize
                        }
                    }
                    si = si + 1usize
                }
            }
        }
        if k == EXPR_CALL {
            let callee_id = ep[id].left
            if ep[callee_id].kind == EXPR_LAMBDA {
                let rty = self.get_indirect_ret_llvm_type(callee_id, "")
                return str_eq(rty, "double") || str_eq(rty, "float")
            }
            if ep[callee_id].kind == EXPR_IDENT {
                let fname = ep[callee_id].str_val.as_ptr() as str
                let raw_var = self.get_raw_var_type(fname)
                if str_starts_with(raw_var, "fn(") || str_starts_with(raw_var, "closure(") {
                    let rty = self.get_func_ptr_ret_type(raw_var)
                    return str_eq(rty, "double") || str_eq(rty, "float")
                }
                let rty = self.get_func_ret_type(fname)
                return str_eq(rty, "double") || str_eq(rty, "float")
            }
            if ep[callee_id].kind == EXPR_FIELD_ACCESS {
                let member = ep[callee_id].field_name.as_ptr() as str
                let rty = self.get_func_ret_type(member)
                return str_eq(rty, "double") || str_eq(rty, "float")
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[id].left
            let member = ep[id].str_val.as_ptr() as str
            var raw_ty = self.get_expr_struct_name(recv_id)
            if str_len(raw_ty) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                raw_ty = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            if str_starts_with(raw_ty, "dyn ") {
                let trait_name = (raw_ty as usize + 4usize) as str
                var ti = 0usize
                while ti < self.parser.traits.len {
                    if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                        var mi = 0usize
                        while mi < self.parser.traits.ptr[ti].methods.len {
                            if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, member) {
                                let rty = self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str
                                return str_eq(rty, "f64") || str_eq(rty, "f32")
                            }
                            mi = mi + 1usize
                        }
                    }
                    ti = ti + 1usize
                }
            }
            if str_len(raw_ty) > 0usize && !str_eq(raw_ty, "String") && !str_eq(raw_ty, "Vec") {
                var mangled = String.new()
                mangled.push_str(raw_ty)
                mangled.push_str("__")
                mangled.push_str(member)
                let rty = self.get_func_ret_type(mangled.as_ptr() as str)
                if str_eq(rty, "double") || str_eq(rty, "float") {
                    return true
                }
            }
            let rty = self.get_func_ret_type(member)
            return str_eq(rty, "double") || str_eq(rty, "float")
        }
        return false
    }

    fn is_expr_f32(self, id: usize) -> bool {
        let ep = self.parser.exprs.ptr
        let k = ep[id].kind
        if k == EXPR_IDENT {
            let vname = ep[id].str_val.as_ptr() as str
            let ty = self.get_var_type(vname)
            return str_eq(ty, "float")
        }
        if k == EXPR_CAST {
            let tgt = ep[id].target_type.as_ptr() as str
            return str_eq(tgt, "f32")
        }
        if k == EXPR_CALL {
            let callee_id = ep[id].left
            if ep[callee_id].kind == EXPR_LAMBDA {
                let rty = self.get_indirect_ret_llvm_type(callee_id, "")
                return str_eq(rty, "float")
            }
            if ep[callee_id].kind == EXPR_IDENT {
                let fname = ep[callee_id].str_val.as_ptr() as str
                let raw_var = self.get_raw_var_type(fname)
                if str_starts_with(raw_var, "fn(") || str_starts_with(raw_var, "closure(") {
                    let rty = self.get_func_ptr_ret_type(raw_var)
                    return str_eq(rty, "float")
                }
                let rty = self.get_func_ret_type(fname)
                return str_eq(rty, "float")
            }
            if ep[callee_id].kind == EXPR_FIELD_ACCESS {
                let member = ep[callee_id].field_name.as_ptr() as str
                let rty = self.get_func_ret_type(member)
                return str_eq(rty, "float")
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[id].left
            let member = ep[id].str_val.as_ptr() as str
            var raw_ty = self.get_expr_struct_name(recv_id)
            if str_len(raw_ty) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                raw_ty = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            if str_starts_with(raw_ty, "dyn ") {
                let trait_name = (raw_ty as usize + 4usize) as str
                var ti = 0usize
                while ti < self.parser.traits.len {
                    if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                        var mi = 0usize
                        while mi < self.parser.traits.ptr[ti].methods.len {
                            if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, member) {
                                let rty = self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str
                                return str_eq(rty, "f32")
                            }
                            mi = mi + 1usize
                        }
                    }
                    ti = ti + 1usize
                }
            }
            if str_len(raw_ty) > 0usize && !str_eq(raw_ty, "String") && !str_eq(raw_ty, "Vec") {
                var mangled = String.new()
                mangled.push_str(raw_ty)
                mangled.push_str("__")
                mangled.push_str(member)
                let rty = self.get_func_ret_type(mangled.as_ptr() as str)
                if str_eq(rty, "float") {
                    return true
                }
            }
            let rty = self.get_func_ret_type(member)
            return str_eq(rty, "float")
        }
        return false
    }

    fn get_raw_func_param_type(self, fname: str, param_idx: usize) -> str {
        let clean_fn = self.clean_type_name(fname)
        let resolved = self.resolve_function_name(clean_fn, 0usize)
        var fi = 0usize
        while fi < self.parser.functions.len {
            let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
            if str_eq(fn_s, fname) || str_eq(fn_s, clean_fn) || str_eq(fn_s, resolved) {
                if param_idx < self.parser.functions.ptr[fi].param_types.len {
                    return self.parser.functions.ptr[fi].param_types.ptr[param_idx].as_ptr() as str
                }
            }
            fi = fi + 1usize
        }
        return ""
    }

    fn get_func_param_type(self, fname: str, param_idx: usize) -> str {
        let clean_fn = self.clean_type_name(fname)
        let resolved = self.resolve_function_name(clean_fn, 0usize)
        var fi = 0usize
        while fi < self.parser.functions.len {
            let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
            if str_eq(fn_s, fname) || str_eq(fn_s, clean_fn) || str_eq(fn_s, resolved) {
                if param_idx < self.parser.functions.ptr[fi].param_types.len {
                    return self.emit_llvm_type(self.parser.functions.ptr[fi].param_types.ptr[param_idx].as_ptr() as str)
                }
            }
            fi = fi + 1usize
        }
        if str_eq(fname, "__rad_is_some") || str_eq(fname, "__rad_get_val") || str_starts_with(fname, "Option__") || str_starts_with(fname, "Result__") {
            if param_idx == 0usize { return "ptr" }
        }
        if str_eq(fname, "ptr_read") || str_eq(fname, "ptr_write") || str_eq(fname, "read_volatile") || str_eq(fname, "write_volatile") || str_eq(fname, "is_null") || str_eq(fname, "offset") || str_eq(fname, "offset_var") {
            if param_idx == 0usize { return "ptr" }
            return "i64"
        }
        if str_eq(fname, "atomic_swap_i32") {
            if param_idx == 0usize { return "ptr" }
            return "i32"
        }
        if str_eq(fname, "atomic_swap_i64") {
            if param_idx == 0usize { return "ptr" }
            return "i64"
        }
        if str_eq(fname, "size_of_val") {
            return "i64"
        }
        if str_eq(fname, "len") || str_eq(fname, "is_empty") || str_eq(fname, "capacity") || str_eq(fname, "clear") || str_eq(fname, "reverse") || str_eq(fname, "drop") || str_eq(fname, "push") || str_eq(fname, "push_byte") || str_eq(fname, "push_str") || str_eq(fname, "pop") || str_eq(fname, "as_ptr") || str_eq(fname, "for_each") || str_eq(fname, "map") || str_eq(fname, "filter") {
            if param_idx == 0usize { return "ptr" }
        }
        if str_eq(fname, "parse_int") || str_eq(fname, "String__to_int") || str_eq(fname, "String__parse_int") || str_eq(fname, "to_int") {
            if param_idx == 0usize { return "ptr" }
        }
        if str_eq(fname, "puts") || str_eq(fname, "println") || str_eq(fname, "print") || str_eq(fname, "system") || str_eq(fname, "free") || str_eq(fname, "fclose") || str_eq(fname, "ftell") || str_eq(fname, "getenv") || (str_eq(fname, "printf") && param_idx == 0usize) || str_eq(fname, "atexit") || str_eq(fname, "panic") || str_eq(fname, "__rad_register_panic_hook") {
            return "ptr"
        }
        if str_eq(fname, "fopen") {
            return "ptr"
        }
        if str_eq(fname, "fread") || str_eq(fname, "fwrite") {
            if param_idx == 0usize || param_idx == 3usize { return "ptr" }
            return "i64"
        }
        if str_eq(fname, "fseek") {
            if param_idx == 0usize { return "ptr" }
            if param_idx == 1usize { return "i64" }
            return "i32"
        }
        if str_eq(fname, "malloc") {
            return "i64"
        }
        if str_eq(fname, "realloc") {
            if param_idx == 0usize { return "ptr" }
            return "i64"
        }
        if str_starts_with(fname, "syscall") {
            return "i64"
        }
        return "i64"
    }

    fn get_raw_func_ret_type(self, fname: str) -> str {
        if str_starts_with(fname, "syscall") {
            return "i64"
        }
        let clean_fn = self.clean_type_name(fname)
        let resolved = self.resolve_function_name(clean_fn, 0usize)
        var fi = 0usize
        while fi < self.parser.functions.len {
            let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
            if str_eq(fn_s, fname) || str_eq(fn_s, clean_fn) || str_eq(fn_s, resolved) {
                let rty = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                if str_contains(fname, "<") {
                    let turboty = self.extract_type_arg(fname)
                    if str_len(turboty) > 0usize && (str_eq(rty, "T") || str_eq(rty, "U") || str_eq(rty, "V")) {
                        return turboty
                    }
                }
                return rty
            }
            fi = fi + 1usize
        }
        return ""
    }

    fn get_func_ret_type(self, fname: str) -> str {
        if str_starts_with(fname, "syscall") {
            return "i64"
        }
        let clean_fn = self.clean_type_name(fname)
        let resolved = self.resolve_function_name(clean_fn, 0usize)
        var fi = 0usize
        while fi < self.parser.functions.len {
            let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
            if str_eq(fn_s, fname) || str_eq(fn_s, clean_fn) || str_eq(fn_s, resolved) {
                let rty = self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                if str_contains(fname, "<") {
                    let turboty = self.extract_type_arg(fname)
                    if str_len(turboty) > 0usize && (str_eq(rty, "T") || str_eq(rty, "U") || str_eq(rty, "V")) {
                        return self.emit_llvm_type(turboty)
                    }
                }
                return self.emit_llvm_type(rty)
            }
            fi = fi + 1usize
        }
        if str_eq(fname, "parse_int") || str_eq(fname, "String__to_int") || str_eq(fname, "String__parse_int") || str_eq(fname, "to_int") {
            return "i64"
        }
        if str_eq(fname, "malloc") || str_eq(fname, "realloc") || str_eq(fname, "fopen") || str_eq(fname, "getenv") || str_eq(fname, "input") || str_eq(fname, "__rad_get_terminal_guard") || str_eq(fname, "null") || str_eq(fname, "null_var") || str_eq(fname, "offset") || str_eq(fname, "offset_var") || str_eq(fname, "map") || str_eq(fname, "Vec__map") || str_eq(fname, "filter") || str_eq(fname, "Vec__filter") || str_eq(fname, "Some") || str_eq(fname, "None") || str_eq(fname, "Ok") || str_eq(fname, "Err") || str_eq(fname, "get") || str_eq(fname, "Vec__get") || str_eq(fname, "pop") || str_eq(fname, "Vec__pop") || str_eq(fname, "as_ptr") || str_eq(fname, "new") || str_eq(fname, "from_str") {
            return "ptr"
        }
        if str_eq(fname, "is_null") || str_eq(fname, "atomic_swap_i32") {
            return "i32"
        }
        if str_eq(fname, "__rad_is_some") || str_eq(fname, "__rad_get_val") || str_eq(fname, "ptr_read") || str_eq(fname, "read_volatile") || str_eq(fname, "size_of_val") || str_eq(fname, "size_of") || str_eq(fname, "atomic_swap_i64") || str_eq(fname, "len") || str_eq(fname, "capacity") || str_eq(fname, "is_empty") {
            return "i64"
        }
        if str_starts_with(fname, "__rad_") || str_eq(fname, "panic") || str_eq(fname, "eprintln") || str_eq(fname, "ptr_write") || str_eq(fname, "write_volatile") || str_eq(fname, "for_each") || str_eq(fname, "Vec__for_each") || str_eq(fname, "clear") || str_eq(fname, "drop") || str_eq(fname, "reverse") || str_eq(fname, "push") || str_eq(fname, "push_byte") || str_eq(fname, "push_str") {
            return "void"
        }
        if str_eq(fname, "atexit") {
            return "i32"
        }
        if str_eq(fname, "fread") || str_eq(fname, "fwrite") || str_eq(fname, "ftell") {
            return "i64"
        }
        if str_eq(fname, "main") || str_eq(fname, "rad_test_main") || str_eq(fname, "println") || str_eq(fname, "print") || str_eq(fname, "puts") || str_eq(fname, "system") || str_eq(fname, "fclose") || str_eq(fname, "printf") || str_eq(fname, "remove") {
            return "i32"
        }
        return "i64"
    }

    fn match_struct_name(self, sdef_name: str, target: str) -> bool {
        if str_eq(sdef_name, target) {
            return true
        }
        let t_len = str_len(target)
        let s_len = str_len(sdef_name)
        if t_len > s_len {
            let b = (target as *raw u8)[s_len]
            if (b == 60u8 || b == 32u8) && str_starts_with(target, sdef_name) {
                return true
            }
        }
        return false
    }

    fn is_struct_name(self, name: str) -> bool {
        let resolved = self.resolve_type_alias(name)
        if str_starts_with(resolved, "dyn ") {
            return true
        }
        var si = 0usize
        while si < self.parser.structs.len {
            if self.match_struct_name(self.parser.structs.ptr[si].struct_name.as_ptr() as str, resolved) {
                return true
            }
            si = si + 1usize
        }
        return false
    }

    fn get_struct_field_idx(self, field_name: str) -> i64 {
        if str_eq(field_name, "kind") { return 0i64 }
        if str_eq(field_name, "ptr") { return 0i64 }
        if str_eq(field_name, "cap") { return 1i64 }
        if str_eq(field_name, "len") { return 2i64 }

        // Token
        if str_eq(field_name, "text") { return 1i64 }
        if str_eq(field_name, "int_val") { return 2i64 }
        if str_eq(field_name, "line") { return 3i64 }
        if str_eq(field_name, "col") { return 4i64 }
        if str_eq(field_name, "len") { return 5i64 }

        // Expr
        if str_eq(field_name, "op") { return 1i64 }
        if str_eq(field_name, "int_val") { return 2i64 }
        if str_eq(field_name, "str_val") { return 3i64 }
        if str_eq(field_name, "target_type") { return 4i64 }
        if str_eq(field_name, "left") { return 5i64 }
        if str_eq(field_name, "right") { return 6i64 }
        if str_eq(field_name, "args") { return 7i64 }
        if str_eq(field_name, "field_name") { return 8i64 }
        if str_eq(field_name, "expr_line") { return 9i64 }
        if str_eq(field_name, "expr_col") { return 10i64 }

        // Stmt
        if str_eq(field_name, "name") { return 1i64 }
        if str_eq(field_name, "type_name") { return 2i64 }
        if str_eq(field_name, "expr_id") { return 3i64 }
        if str_eq(field_name, "index_expr") { return 4i64 }
        if str_eq(field_name, "then_stmts") { return 5i64 }
        if str_eq(field_name, "else_stmts") { return 6i64 }
        if str_eq(field_name, "body_stmts") { return 7i64 }
        if str_eq(field_name, "stmt_line") { return 8i64 }
        if str_eq(field_name, "stmt_col") { return 9i64 }

        // FunctionDef
        if str_eq(field_name, "fn_name") { return 0i64 }
        if str_eq(field_name, "param_names") { return 1i64 }
        if str_eq(field_name, "param_types") { return 2i64 }
        if str_eq(field_name, "ret_type") { return 3i64 }
        if str_eq(field_name, "body") { return 4i64 }
        if str_eq(field_name, "is_test") { return 5i64 }
        if str_eq(field_name, "is_async") { return 6i64 }

        // TraitMethodDef
        if str_eq(field_name, "method_name") { return 0i64 }

        // TraitDef
        if str_eq(field_name, "trait_name") { return 0i64 }
        if str_eq(field_name, "methods") { return 1i64 }

        // TraitImplDef
        if str_eq(field_name, "target_struct_name") { return 1i64 }

        // StructDef
        if str_eq(field_name, "struct_name") { return 0i64 }
        if str_eq(field_name, "field_names") { return 1i64 }
        if str_eq(field_name, "field_types") { return 2i64 }

        // Parser
        if str_eq(field_name, "tokens") { return 0i64 }
        if str_eq(field_name, "pos") { return 1i64 }
        if str_eq(field_name, "exprs") { return 2i64 }
        if str_eq(field_name, "stmts") { return 3i64 }
        if str_eq(field_name, "functions") { return 4i64 }
        if str_eq(field_name, "structs") { return 5i64 }
        if str_eq(field_name, "traits") { return 6i64 }
        if str_eq(field_name, "trait_impls") { return 7i64 }
        if str_eq(field_name, "const_names") { return 8i64 }
        if str_eq(field_name, "const_values") { return 9i64 }
        if str_eq(field_name, "filename") { return 10i64 }
        if str_eq(field_name, "error_count") { return 11i64 }
        if str_eq(field_name, "source") { return 12i64 }
        if str_eq(field_name, "source_files") { return 13i64 }
        if str_eq(field_name, "expr_source_ids") { return 14i64 }
        if str_eq(field_name, "stmt_source_ids") { return 15i64 }
        if str_eq(field_name, "current_source_id") { return 16i64 }
        if str_eq(field_name, "moved_vars") { return 17i64 }
        if str_eq(field_name, "imported_modules") { return 18i64 }
        if str_eq(field_name, "diagnostics") { return 19i64 }
        if str_eq(field_name, "color_mode") { return 20i64 }
        if str_eq(field_name, "json_format") { return 21i64 }
        if str_eq(field_name, "test_mode") { return 22i64 }
        if str_eq(field_name, "cur_is_test") { return 23i64 }
        if str_eq(field_name, "cur_is_async") { return 24i64 }

        // SourceFile
        if str_eq(field_name, "file_path") { return 0i64 }
        if str_eq(field_name, "file_text") { return 1i64 }

        // StringEntry
        if str_eq(field_name, "content") { return 0i64 }
        if str_eq(field_name, "byte_len") { return 1i64 }

        // DeferThunkMeta
        if str_eq(field_name, "stmt_id") { return 0i64 }
        if str_eq(field_name, "cap_vars") { return 1i64 }

        // Codegen
        if str_eq(field_name, "parser") { return 0i64 }
        if str_eq(field_name, "target") { return 1i64 }
        if str_eq(field_name, "ir") { return 2i64 }
        if str_eq(field_name, "fn_allocas") { return 3i64 }
        if str_eq(field_name, "allocated_vars") { return 4i64 }
        if str_eq(field_name, "ssa_counter") { return 5i64 }
        if str_eq(field_name, "label_counter") { return 6i64 }
        if str_eq(field_name, "strings") { return 7i64 }
        if str_eq(field_name, "current_ret_type") { return 8i64 }
        if str_eq(field_name, "loop_cond_labels") { return 9i64 }
        if str_eq(field_name, "loop_end_labels") { return 10i64 }
        if str_eq(field_name, "loop_drop_stack") { return 11i64 }
        if str_eq(field_name, "loop_defer_stack") { return 12i64 }
        if str_eq(field_name, "current_func_idx") { return 13i64 }
        if str_eq(field_name, "active_defers") { return 14i64 }
        if str_eq(field_name, "active_drops_var") { return 15i64 }
        if str_eq(field_name, "active_drops_type") { return 16i64 }
        if str_eq(field_name, "debug_info") { return 17i64 }
        if str_eq(field_name, "source_file") { return 18i64 }
        if str_eq(field_name, "fn_defer_metas") { return 19i64 }
        if str_eq(field_name, "pending_defer_thunks") { return 20i64 }
        if str_eq(field_name, "closure_metas") { return 21i64 }

        // CompilerOptions
        if str_eq(field_name, "input_paths") { return 0i64 }
        if str_eq(field_name, "extra_objects") { return 1i64 }
        if str_eq(field_name, "output_path") { return 2i64 }
        if str_eq(field_name, "emit_llvm") { return 3i64 }
        if str_eq(field_name, "check_only") { return 4i64 }
        if str_eq(field_name, "opt_level") { return 5i64 }
        if str_eq(field_name, "target_triple") { return 6i64 }
        if str_eq(field_name, "linker_cmd") { return 7i64 }
        if str_eq(field_name, "show_version") { return 8i64 }
        if str_eq(field_name, "compile_only") { return 9i64 }
        if str_eq(field_name, "cli_color_mode") { return 10i64 }
        if str_eq(field_name, "cli_json_format") { return 11i64 }
        if str_eq(field_name, "test_mode") { return 12i64 }

        var si = 0usize
        while si < self.parser.structs.len {
            let sdef = self.parser.structs.ptr[si]
            var fi = 0usize
            while fi < sdef.field_names.len {
                if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, field_name) {
                    return fi as i64
                }
                fi = fi + 1usize
            }
            si = si + 1usize
        }
        return -1i64
    }

    fn find_similar_ident(self, target: str) -> str {
        var best_cand = ""
        var best_dist = 999i32
        var vi = 0usize
        while vi < self.allocated_vars.len {
            let cand = self.allocated_vars.ptr[vi].as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            vi = vi + 1usize
        }
        if self.current_func_idx < self.parser.functions.len {
            let cur_fn = self.parser.functions.ptr[self.current_func_idx]
            var pi = 0usize
            while pi < cur_fn.param_names.len {
                let cand = cur_fn.param_names.ptr[pi].as_ptr() as str
                if is_name_similar(target, cand) {
                    let d = levenshtein_dist(target, cand)
                    if d < best_dist {
                        best_dist = d
                        best_cand = cand
                    }
                }
                pi = pi + 1usize
            }
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            let cand = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            fi = fi + 1usize
        }
        var ci = 0usize
        while ci < self.parser.const_names.len {
            let cand = self.parser.const_names.ptr[ci].as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            ci = ci + 1usize
        }
        if is_name_similar(target, "println") && 1i32 < best_dist { best_cand = "println"; best_dist = 1i32 }
        if is_name_similar(target, "print") && 1i32 < best_dist { best_cand = "print"; best_dist = 1i32 }
        if is_name_similar(target, "eprintln") && 1i32 < best_dist { best_cand = "eprintln"; best_dist = 1i32 }
        if is_name_similar(target, "panic") && 1i32 < best_dist { best_cand = "panic"; best_dist = 1i32 }
        if is_name_similar(target, "assert") && 1i32 < best_dist { best_cand = "assert"; best_dist = 1i32 }
        return best_cand
    }

    fn find_similar_field(self, fname: str, s_type: str) -> str {
        var best_cand = ""
        var best_dist = 999i32
        if str_len(s_type) > 0usize {
            var si = 0usize
            while si < self.parser.structs.len {
                let sdef = self.parser.structs.ptr[si]
                if self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                    var fld_i = 0usize
                    while fld_i < sdef.field_names.len {
                        let cand = sdef.field_names.ptr[fld_i].as_ptr() as str
                        if is_name_similar(fname, cand) {
                            let d = levenshtein_dist(fname, cand)
                            if d < best_dist {
                                best_dist = d
                                best_cand = cand
                            }
                        }
                        fld_i = fld_i + 1usize
                    }
                    break
                }
                si = si + 1usize
            }
        }
        return best_cand
    }

    fn is_expr_ptr(self, id: usize) -> bool {
        let ep = self.parser.exprs.ptr
        let k = ep[id].kind
        if k == EXPR_ARRAY_LITERAL || k == EXPR_TUPLE || k == EXPR_FSTRING || k == EXPR_LAMBDA {
            return true
        }
        if k == EXPR_STR {
            return true
        }
        if k == EXPR_IDENT {
            let vname = ep[id].str_val.as_ptr() as str
            if str_eq(vname, "None") || str_eq(vname, "Option::None") {
                return true
            }
            var is_alloc = false
            var ai = 0usize
            while ai < self.allocated_vars.len {
                if str_eq(self.allocated_vars.ptr[ai].as_ptr() as str, vname) {
                    is_alloc = true
                    break
                }
                ai = ai + 1usize
            }
            if is_alloc {
                return str_eq(self.get_var_type(vname), "ptr")
            }
            let resolved_vname = self.resolve_function_name(vname, 0usize)
            var fi = 0usize
            while fi < self.parser.functions.len {
                let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                if str_eq(fn_s, vname) || str_eq(fn_s, resolved_vname) {
                    return true
                }
                fi = fi + 1usize
            }
            if str_starts_with(vname, "__rad_") {
                return true
            }
            return false
        }
        if k == EXPR_UNARY && ep[id].op == TOK_AMP {
            return true
        }
        if k == EXPR_CAST {
            let target_ty = self.emit_llvm_type(ep[id].target_type.as_ptr() as str)
            return str_eq(target_ty, "ptr")
        }
        if k == EXPR_TRY {
            let left_id = ep[id].left
            var inner_ty = self.get_expr_struct_name(left_id)
            if str_len(inner_ty) == 0usize && ep[left_id].kind == EXPR_IDENT {
                inner_ty = self.get_raw_var_type(ep[left_id].str_val.as_ptr() as str)
            }
            if str_starts_with(inner_ty, "Option<") {
                let plen = str_len(inner_ty)
                if plen > 8usize {
                    var inner = String.new()
                    let cp = inner_ty as *raw u8
                    var ci = 7usize
                    while ci < plen && cp[ci] != 62u8 {
                        inner.push_byte(cp[ci])
                        ci = ci + 1usize
                    }
                    inner.push_byte(0u8)
                    let elem_t = inner.as_ptr() as str
                    return str_eq(self.emit_llvm_type(elem_t), "ptr")
                }
            }
            if str_starts_with(inner_ty, "Result<") {
                let plen = str_len(inner_ty)
                if plen > 8usize {
                    var inner = String.new()
                    let cp = inner_ty as *raw u8
                    var ci = 7usize
                    while ci < plen && cp[ci] != 44u8 && cp[ci] != 62u8 {
                        inner.push_byte(cp[ci])
                        ci = ci + 1usize
                    }
                    inner.push_byte(0u8)
                    let elem_t = inner.as_ptr() as str
                    return str_eq(self.emit_llvm_type(elem_t), "ptr")
                }
            }
            return false
        }
        if k == EXPR_AWAIT {
            return self.is_expr_ptr(ep[id].left)
        }
        if k == EXPR_CALL {
            let callee_id = ep[id].left
            if ep[callee_id].kind == EXPR_LAMBDA {
                let rty = self.get_indirect_ret_llvm_type(callee_id, "")
                return str_eq(rty, "ptr")
            }
            if ep[callee_id].kind == EXPR_IDENT {
                let fname = ep[callee_id].str_val.as_ptr() as str
                if self.is_struct_name(fname) {
                    return true
                }
                let turbofish_ty = ep[callee_id].target_type.as_ptr() as str
                if str_len(turbofish_ty) > 0usize {
                    let clean_t = self.clean_type_name(turbofish_ty)
                    let lt = self.emit_llvm_type(clean_t)
                    if str_eq(lt, "ptr") {
                        return true
                    }
                }
                if str_eq(self.get_func_ret_type(fname), "ptr") {
                    return true
                }
                let raw_var = self.get_raw_var_type(fname)
                if str_len(raw_var) > 0usize && str_contains(raw_var, "->") {
                    let rty = self.get_func_ptr_ret_type(raw_var)
                    return str_eq(rty, "ptr")
                }
            }
            if ep[callee_id].kind == EXPR_FIELD_ACCESS {
                let recv_id = ep[callee_id].left
                let type_s = ep[recv_id].str_val.as_ptr() as str
                let member_s = ep[callee_id].field_name.as_ptr() as str
                var full_name = String.new()
                full_name.push_str(type_s)
                full_name.push_str("__")
                full_name.push_str(member_s)
                if str_eq(self.get_func_ret_type(full_name.as_ptr() as str), "ptr") {
                    return true
                }
                if str_eq(self.get_func_ret_type(member_s), "ptr") {
                    return true
                }
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[id].left
            let member = ep[id].str_val.as_ptr() as str
            let clean_m = self.clean_type_name(member)
            if str_eq(clean_m, "as_ptr") || str_eq(clean_m, "new") || str_eq(clean_m, "from_str") || str_eq(clean_m, "as_str") || str_eq(clean_m, "to_string") {
                return true
            }
            if str_contains(member, "<") {
                let turbofish_ty = self.extract_type_arg(member)
                if str_len(turbofish_ty) > 0usize {
                    let clean_t = self.clean_type_name(turbofish_ty)
                    let lt = self.emit_llvm_type(clean_t)
                    if str_eq(lt, "ptr") {
                        return true
                    }
                }
            }
            var is_static = false
            if ep[recv_id].kind == EXPR_IDENT {
                let p_recv: *raw u8 = ep[recv_id].str_val.as_ptr()
                if (p_recv as usize) != 0usize && (p_recv[0usize] >= 65u8 && p_recv[0usize] <= 90u8) {
                    is_static = true
                } else {
                    let vname = ep[recv_id].str_val.as_ptr() as str
                    let is_var = str_len(self.get_raw_var_type(vname)) > 0usize
                    if !is_var {
                        is_static = true
                    }
                }
            }
            if is_static {
                let type_s = ep[recv_id].str_val.as_ptr() as str
                var mangled = String.new()
                mangled.push_str(type_s)
                mangled.push_str("__")
                mangled.push_str(clean_m)
                if str_eq(self.get_func_ret_type(mangled.as_ptr() as str), "ptr") {
                    return true
                }
            }
            if !is_static {
                var raw_ty = self.get_expr_struct_name(recv_id)
                if str_len(raw_ty) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                    raw_ty = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
                }
                if str_starts_with(raw_ty, "dyn ") {
                    let trait_name = (raw_ty as usize + 4usize) as str
                    var ti = 0usize
                    while ti < self.parser.traits.len {
                        if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                            var mi = 0usize
                            while mi < self.parser.traits.ptr[ti].methods.len {
                                if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, clean_m) {
                                    let rty = self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str
                                    let lty = self.emit_llvm_type(rty)
                                    return str_eq(lty, "ptr")
                                }
                                mi = mi + 1usize
                            }
                        }
                        ti = ti + 1usize
                    }
                }
                if str_len(raw_ty) > 0usize {
                    let base_ty = self.clean_type_name(raw_ty)
                    if str_eq(base_ty, "Vec") && (str_eq(clean_m, "map") || str_eq(clean_m, "filter") || str_eq(clean_m, "get") || str_eq(clean_m, "pop")) {
                        return true
                    }
                    if str_eq(base_ty, "Vec") && str_eq(clean_m, "for_each") {
                        return false
                    }
                    var mangled = String.new()
                    mangled.push_str(base_ty)
                    mangled.push_str("__")
                    mangled.push_str(clean_m)
                    var found_m = false
                    var fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, mangled.as_ptr() as str) {
                            found_m = true
                            break
                        }
                        fi = fi + 1usize
                    }
                    if found_m {
                        let ret_ty = self.get_func_ret_type(mangled.as_ptr() as str)
                        if str_len(ret_ty) > 0usize && !str_eq(ret_ty, "void") {
                            return str_eq(ret_ty, "ptr")
                        }
                    }
                }
            }
            if str_eq(self.get_func_ret_type(clean_m), "ptr") {
                return true
            }
            var fi = 0usize
            while fi < self.parser.functions.len {
                let fn_str = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                if str_ends_with(fn_str, clean_m) {
                    let flen = str_len(fn_str)
                    let mlen = str_len(clean_m)
                    if flen > mlen + 2usize {
                        let p = fn_str as *raw u8
                        if p[flen - mlen - 1usize] == 95u8 && p[flen - mlen - 2usize] == 95u8 {
                            if str_eq(self.get_func_ret_type(fn_str), "ptr") {
                                return true
                            }
                        }
                    }
                }
                fi = fi + 1usize
            }
        }
        if k == EXPR_FIELD_ACCESS {
            let recv_id = ep[id].left
            let fname = ep[id].field_name.as_ptr() as str
            if ep[recv_id].kind == EXPR_IDENT {
                let rec_name = ep[recv_id].str_val.as_ptr() as str
                if str_eq(rec_name, "Option") && str_eq(fname, "None") {
                    return true
                }
            }
            if str_eq(fname, "ptr") {
                return true
            }
            let fname_p = fname as *raw u8
            if str_len(fname) > 0usize && fname_p[0] >= 48u8 && fname_p[0] <= 57u8 {
                let recv_id = ep[id].left
                let f_idx = parse_int(fname)
                let elem_ty = self.get_tuple_elem_type(recv_id, f_idx)
                if str_len(elem_ty) > 0usize {
                    let lty = self.emit_llvm_type(elem_ty)
                    return str_eq(lty, "ptr") || str_eq(elem_ty, "str") || str_eq(elem_ty, "String")
                }
                if ep[recv_id].kind == EXPR_TUPLE && (f_idx as usize) < ep[recv_id].args.len {
                    return self.is_expr_ptr(ep[recv_id].args.ptr[f_idx as usize])
                }
                return false
            }
            let recv_id = ep[id].left
            var s_type = self.get_expr_struct_name(recv_id)
            if str_len(s_type) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                s_type = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            var si = 0usize
            while si < self.parser.structs.len {
                let sdef = self.parser.structs.ptr[si]
                if str_len(s_type) == 0usize || str_starts_with(s_type, "*") || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                    var fi = 0usize
                    while fi < sdef.field_names.len {
                        if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                            let fty = self.get_monomorphized_field_type(sdef, s_type, fi)
                            let lty = self.emit_llvm_type(fty)
                            return str_eq(lty, "ptr") || str_eq(fty, "str") || str_eq(fty, "String") || str_starts_with(fty, "*raw")
                        }
                        fi = fi + 1usize
                    }
                }
                si = si + 1usize
            }
        }
        if k == EXPR_INDEX {
            let left_id = ep[id].left
            if ep[left_id].kind == EXPR_IDENT {
                let raw_ty = self.get_raw_var_type(ep[left_id].str_val.as_ptr() as str)
                if str_starts_with(raw_ty, "*raw *raw") || str_starts_with(raw_ty, "**") {
                    return true
                }
            }
        }
        return false
    }

    fn is_expr_string_obj(self, expr_id: usize) -> bool {
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_FSTRING {
            return true
        }
        if k == EXPR_AWAIT {
            return self.is_expr_string_obj(ep[expr_id].left)
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            let raw_ty = self.get_raw_var_type(vname)
            return str_eq(raw_ty, "String")
        }
        if k == EXPR_CALL {
            let callee = ep[expr_id].left
            if ep[callee].kind == EXPR_IDENT {
                let cname = ep[callee].str_val.as_ptr() as str
                if str_eq(cname, "input") {
                    return true
                }
            }
        }
        if k == EXPR_METHOD_CALL {
            let mname = ep[expr_id].str_val.as_ptr() as str
            if str_eq(mname, "new") || str_eq(mname, "from_str") {
                let recv = ep[expr_id].left
                if ep[recv].kind == EXPR_IDENT {
                    let rname = ep[recv].str_val.as_ptr() as str
                    if str_eq(rname, "String") {
                        return true
                    }
                }
            }
            let st_nm = self.get_expr_struct_name(expr_id)
            if str_eq(st_nm, "String") {
                return true
            }
        }
        if k == EXPR_FIELD_ACCESS {
            let recv_id = ep[expr_id].left
            let fname = ep[expr_id].field_name.as_ptr() as str
            if ep[recv_id].kind == EXPR_IDENT {
                let s_type = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if str_len(s_type) == 0usize || str_starts_with(s_type, "*") || self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                return str_eq(fty, "String")
                            }
                            fi = fi + 1usize
                        }
                    }
                    si = si + 1usize
                }
            }
        }
        return false
    }

    fn is_expr_str_type(self, expr_id: usize) -> bool {
        if expr_id == 0usize || expr_id >= self.parser.exprs.len {
            return false
        }
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_STR {
            return true
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            let raw_ty = self.get_raw_var_type(vname)
            return str_eq(raw_ty, "str")
        }
        if k == EXPR_CAST {
            let tgt = ep[expr_id].target_type.as_ptr() as str
            return str_eq(tgt, "str")
        }
        if k == EXPR_METHOD_CALL {
            let mname = ep[expr_id].str_val.as_ptr() as str
            let clean_m = self.clean_type_name(mname)
            return str_eq(clean_m, "as_str") || str_eq(clean_m, "to_str")
        }
        return false
    }

    fn get_bin_op_str(self, op: i32) -> str {
        if op == TOK_PLUS { return "+" }
        if op == TOK_MINUS { return "-" }
        if op == TOK_STAR { return "*" }
        if op == TOK_SLASH { return "/" }
        if op == TOK_PERCENT { return "%" }
        if op == TOK_AMP { return "&" }
        if op == TOK_PIPE { return "|" }
        if op == TOK_CARET { return "^" }
        if op == TOK_SHL { return "<<" }
        if op == TOK_SHR { return ">>" }
        if op == TOK_ANDAND { return "&&" }
        if op == TOK_OROR { return "||" }
        return "binary op"
    }

    fn get_expr_type_name(self, expr_id: usize) -> str {
        if expr_id == 0usize || expr_id >= self.parser.exprs.len {
            return "unknown"
        }
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if self.is_expr_float(expr_id) {
            if self.is_expr_f32(expr_id) {
                return "f32"
            }
            return "f64"
        }
        if self.is_expr_string_obj(expr_id) {
            return "String"
        }
        if k == EXPR_STR {
            return "str"
        }
        if k == EXPR_BOOL {
            return "bool"
        }
        if k == EXPR_INT {
            return "i64"
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            let raw = self.get_raw_var_type(vname)
            if str_len(raw) > 0usize {
                return raw
            }
        }
        if k == EXPR_CALL {
            let callee = ep[expr_id].left
            if ep[callee].kind == EXPR_IDENT {
                let cname = ep[callee].str_val.as_ptr() as str
                if str_eq(cname, "input") {
                    return "String"
                }
                let raw_r = self.get_func_ret_type(cname)
                if str_len(raw_r) > 0usize && !str_eq(raw_r, "ptr") {
                    return raw_r
                }
            }
        }
        let s_ty = self.get_expr_struct_name(expr_id)
        if str_len(s_ty) > 0usize {
            return s_ty
        }
        if self.is_expr_ptr(expr_id) {
            return "ptr"
        }
        return "i64"
    }

}
