    fn report_error(var self, err_code: str, err_msg: str, line: i64, col: i64) {
        self.report_error_span(err_code, err_msg, line, col, self.cur_tok_len())
    }

    fn report_error_span_for_source(var self, source_id: usize, err_code: str, err_msg: str, line: i64, col: i64, span_len: i64) {
        if source_id >= self.source_files.len {
            self.report_error_span(err_code, err_msg, line, col, span_len)
            return
        }

        let previous_filename = self.filename
        let previous_source = self.source
        self.filename = self.source_files.ptr[source_id].file_path
        self.source = self.source_files.ptr[source_id].file_text
        self.report_error_span(err_code, err_msg, line, col, span_len)
        self.filename = previous_filename
        self.source = previous_source
    }

    fn expect_tok(var self, expected: i32, expected_desc: str) -> bool {
        if self.peek_kind() == expected {
            self.advance()
            return true
        }
        var cur_line = 1i64
        var cur_col = 1i64
        var cur_len = 1i64
        if self.pos < self.tokens.len {
            cur_line = self.tokens.ptr[self.pos].line
            cur_col = self.tokens.ptr[self.pos].col
            cur_len = self.tokens.ptr[self.pos].len
        }
        var msg = String.new()
        msg.push_str("expected '")
        msg.push_str(expected_desc)
        msg.push_str("', found '")
        if self.peek_kind() == TOK_EOF {
            msg.push_str("EOF")
        } else {
            let s = self.peek_text()
            if str_len(s) > 0usize {
                msg.push_str(s)
            } else {
                msg.push_str("token")
            }
        }
        msg.push_str("'")

        var err_code = "E0001"
        if expected == TOK_LBRACE || expected == TOK_RBRACE || expected == TOK_LPAREN || expected == TOK_RPAREN || expected == TOK_LBRACKET || expected == TOK_RBRACKET {
            err_code = "E0010"
        } else if expected == TOK_IDENT {
            err_code = "E0013"
        } else if expected == TOK_SEMI {
            err_code = "E0011"
        }
        self.report_error_span(err_code, msg.as_ptr() as str, cur_line, cur_col, cur_len)
        return false
    }

    fn add_expr(var self, expr: Expr) -> usize {
        let id = self.exprs.len
        self.exprs.push(expr)
        self.expr_source_ids.push(self.current_source_id)
        return id
    }

    fn add_stmt(var self, stmt: Stmt) -> usize {
        let id = self.stmts.len
        self.stmts.push(stmt)
        self.stmt_source_ids.push(self.current_source_id)
        return id
    }

    fn cur_tok_line(self) -> i64 {
        if self.pos < self.tokens.len {
            return self.tokens.ptr[self.pos].line
        }
        if self.tokens.len > 0usize {
            return self.tokens.ptr[self.tokens.len - 1usize].line
        }
        return 1i64
    }

    fn cur_tok_col(self) -> i64 {
        if self.pos < self.tokens.len {
            return self.tokens.ptr[self.pos].col
        }
        if self.tokens.len > 0usize {
            return self.tokens.ptr[self.tokens.len - 1usize].col
        }
        return 1i64
    }

    fn peek_kind(self) -> i32 {
        if self.pos >= self.tokens.len {
            return TOK_EOF
        }
        let tp = self.tokens.ptr
        return tp[self.pos].kind
    }

    fn peek_next_kind(self) -> i32 {
        if self.pos + 1usize >= self.tokens.len {
            return TOK_EOF
        }
        let tp = self.tokens.ptr
        return tp[self.pos + 1usize].kind
    }

    fn is_ident_or_contextual_kw(self) -> bool {
        let k = self.peek_kind()
        if k == TOK_IDENT || k == TOK_HANDLE || k == TOK_PERFORM || k == TOK_RESUME || k == TOK_EFFECT || k == TOK_WITH || k == TOK_REQUIRES || k == TOK_ENSURES || k == TOK_ACTOR || k == TOK_ASYNC || k == TOK_AWAIT || k == TOK_DYN {
            return true
        }
        return false
    }

    fn match_ident_or_kw(var self) -> bool {
        if self.is_ident_or_contextual_kw() {
            self.advance()
            return true
        }
        return self.match_tok(TOK_IDENT)
    }

    fn peek_text(self) -> str {
        if self.pos >= self.tokens.len {
            return ""
        }
        let tp = self.tokens.ptr
        if tp[self.pos].text.len() == 0usize {
            return ""
        }
        return tp[self.pos].text.as_ptr() as str
    }

    fn peek_int(self) -> i64 {
        if self.pos >= self.tokens.len {
            return 0i64
        }
        let tp = self.tokens.ptr
        return tp[self.pos].int_val
    }

    fn advance(var self) {
        if self.pos < self.tokens.len {
            self.pos = self.pos + 1usize
        }
    }

    fn match_tok(var self, expected: i32) -> bool {
        if self.peek_kind() == expected {
            self.advance()
            return true
        }
        return false
    }

    fn parse_type_str(var self) -> String {
        var ty = String.new()
        if self.peek_kind() == TOK_VAR {
            ty.push_str("var ")
            self.advance()
        }
        if self.peek_kind() == TOK_LBRACKET {
            ty.push_str("[")
            self.advance()
            while self.peek_kind() != TOK_RBRACKET && self.peek_kind() != TOK_EOF {
                ty.push_str(self.peek_text())
                self.advance()
            }
            if self.match_tok(TOK_RBRACKET) {
                ty.push_str("]")
            }
            if self.peek_kind() == TOK_VAR {
                ty.push_str("var ")
                self.advance()
            }
            if self.peek_kind() == TOK_IDENT {
                ty.push_str(self.peek_text())
                self.advance()
            }
            return ty
        }
        // 1. Consume pointer modifiers: *raw var, *raw const, *raw, *
        while self.peek_kind() == TOK_STAR {
            self.advance()
            ty.push_str("*")
            if self.peek_kind() == TOK_IDENT {
                let s = self.peek_text()
                if str_eq(s, "raw") || str_eq(s, "const") {
                    ty.push_str(" ")
                    ty.push_str(s)
                    self.advance()
                }
            }
            if self.peek_kind() == TOK_VAR {
                ty.push_str(" var")
                self.advance()
            } else if self.peek_kind() == TOK_IDENT {
                let s = self.peek_text()
                if str_eq(s, "const") {
                    ty.push_str(" const")
                    self.advance()
                }
            }
        }
        // If there are more pointer stars (e.g. *raw *raw u8)
        while self.peek_kind() == TOK_STAR {
            self.advance()
            ty.push_str("*")
            if self.peek_kind() == TOK_IDENT {
                let s = self.peek_text()
                if str_eq(s, "raw") || str_eq(s, "const") {
                    ty.push_str(" ")
                    ty.push_str(s)
                    self.advance()
                }
            }
        }
        // 2. Consume the single base type name: e.g. u8, i32, usize, String, Vec, dyn Trait, etc.
        if self.peek_kind() == TOK_DYN || str_eq(self.peek_text(), "dyn") {
            self.advance()
            if ty.len() > 0usize {
                ty.push_str(" ")
            }
            ty.push_str("dyn ")
            if self.peek_kind() == TOK_IDENT {
                ty.push_str(self.peek_text())
                self.advance()
            }
            return ty
        }
        if self.peek_kind() == TOK_IDENT {
            if ty.len() > 0usize {
                ty.push_str(" ")
            }
            ty.push_str(self.peek_text())
            self.advance()
            // Optional generics: <T, U>
            if self.peek_kind() == TOK_LT {
                ty.push_str("<")
                self.advance()
                var depth = 1
                while depth > 0 && self.peek_kind() != TOK_EOF {
                    if self.peek_kind() == TOK_LT {
                        depth = depth + 1
                        ty.push_str("<")
                        self.advance()
                    } else if self.peek_kind() == TOK_GT {
                        depth = depth - 1
                        ty.push_str(">")
                        self.advance()
                    } else if self.peek_kind() == TOK_SHR {
                        depth = depth - 2
                        ty.push_str(">>")
                        self.advance()
                    } else if str_eq(self.peek_text(), "dyn") || self.peek_kind() == TOK_DYN {
                        ty.push_str("dyn ")
                        self.advance()
                    } else {
                        ty.push_str(self.peek_text())
                        self.advance()
                    }
                }
            }
        }
        return ty
    }

    fn get_binop_prec(self, op: i32) -> i32 {
        if op == TOK_DOTDOT {
            return 1
        }
        if op == TOK_OROR {
            return 2
        }
        if op == TOK_ANDAND {
            return 3
        }
        if op == TOK_PIPE {
            return 4
        }
        if op == TOK_CARET {
            return 5
        }
        if op == TOK_AMP {
            return 6
        }
        if op == TOK_EQEQ || op == TOK_NEQ {
            return 7
        }
        if op == TOK_LT || op == TOK_LEQ || op == TOK_GT || op == TOK_GEQ {
            return 8
        }
        if op == TOK_SHL || op == TOK_SHR {
            return 9
        }
        if op == TOK_PLUS || op == TOK_MINUS {
            return 10
        }
        if op == TOK_STAR || op == TOK_SLASH || op == TOK_PERCENT {
            return 11
        }
        return 0
    }

    fn parse_primary(var self) -> usize {
        let k = self.peek_kind()
        let tok_l = self.cur_tok_line()
        let tok_c = self.cur_tok_col()
        if k == TOK_PERFORM || (k == TOK_IDENT && str_eq(self.peek_text(), "perform")) {
            self.advance()
            return self.parse_primary()
        }
        if k == TOK_FLOAT {
            let txt = String.from_str(self.peek_text())
            self.advance()
            return self.add_expr(Expr {
                kind: EXPR_FLOAT,
                op: 0,
                int_val: 0i64,
                str_val: txt,
                target_type: String.from_str("f64"),
                left: 0usize,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_INT {
            let v = self.peek_int()
            self.advance()
            return self.add_expr(Expr {
                kind: EXPR_INT,
                op: 0,
                int_val: v,
                str_val: String.new(),
                target_type: String.new(),
                left: 0usize,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_STR {
            let txt = String.from_str(self.peek_text())
            let is_fstr = self.peek_int()
            self.advance()
            return self.add_expr(Expr {
                kind: EXPR_STR,
                op: 0,
                int_val: is_fstr,
                str_val: txt,
                target_type: String.new(),
                left: 0usize,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_TRUE {
            self.advance()
            return self.add_expr(Expr {
                kind: EXPR_BOOL,
                op: 0,
                int_val: 1i64,
                str_val: String.new(),
                target_type: String.new(),
                left: 0usize,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_FALSE {
            self.advance()
            return self.add_expr(Expr {
                kind: EXPR_BOOL,
                op: 0,
                int_val: 0i64,
                str_val: String.new(),
                target_type: String.new(),
                left: 0usize,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_IDENT || k == TOK_RESUME || k == TOK_HANDLE {
            let id = String.from_str(self.peek_text())
            let id_str = id.as_ptr() as str
            var mi = 0usize
            while mi < self.moved_vars.len {
                if str_eq(self.moved_vars.ptr[mi].as_ptr() as str, id_str) {
                    var msg = String.new()
                    msg.push_str("use of moved value '")
                    msg.push_str(id_str)
                    msg.push_str("'")
                    self.report_error_span("E0005", msg.as_ptr() as str, tok_l, tok_c, str_len(id_str) as i64)
                    break
                }
                mi = mi + 1usize
            }
            self.advance()
            return self.add_expr(Expr {
                kind: EXPR_IDENT,
                op: 0,
                int_val: 0i64,
                str_val: id,
                target_type: String.new(),
                left: 0usize,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_AMP {
            self.advance()
            let sub = self.parse_primary()
            return self.parse_postfix(sub)
        }
        if k == TOK_LPAREN {
            self.advance()
            let e = self.parse_expr(0)
            self.expect_tok(TOK_RPAREN, ")")
            return e
        }
        if k == TOK_LBRACKET {
            self.advance()
            var elems = Vec.new()
            while self.peek_kind() != TOK_RBRACKET && self.peek_kind() != TOK_EOF {
                let e = self.parse_expr(0)
                elems.push(e)
                if !self.match_tok(TOK_COMMA) {
                    break
                }
            }
            self.expect_tok(TOK_RBRACKET, "]")
            return self.add_expr(Expr {
                kind: EXPR_ARRAY_LITERAL,
                op: 0,
                int_val: elems.len as i64,
                str_val: String.new(),
                target_type: String.new(),
                left: 0usize,
                right: 0usize,
                args: elems,
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_AWAIT || str_eq(self.peek_text(), "await") {
            self.advance()
            let operand = self.parse_expr(10)
            return self.add_expr(Expr {
                kind: EXPR_AWAIT,
                op: 0,
                int_val: 0i64,
                str_val: String.new(),
                target_type: String.new(),
                left: operand,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_MINUS || k == TOK_NOT || k == TOK_TILDE {
            let un_op = k + 0
            self.advance()
            let operand = self.parse_expr(10)
            return self.add_expr(Expr {
                kind: EXPR_UNARY,
                op: un_op,
                int_val: 0i64,
                str_val: String.new(),
                target_type: String.new(),
                left: operand,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: tok_l,
                expr_col: tok_c,
            })
        }
        if k == TOK_ERROR {
            self.check_lex_error()
            return 0usize
        }
        if k == TOK_IF {
            let cur_l = self.cur_tok_line()
            let cur_c = self.cur_tok_col()
            var msg = String.new()
            msg.push_str("unexpected 'if' in expression: Rad does not support if-expressions; use an 'if' statement to assign to a variable")
            self.report_error("E0014", msg.as_ptr() as str, cur_l, cur_c)
            self.advance()
            let _cond = self.parse_expr(0)
            if self.peek_kind() == TOK_LBRACE {
                self.advance()
                let _then = self.parse_block_stmts()
                self.expect_tok(TOK_RBRACE, "}")
            }
            if self.match_tok(TOK_ELSE) {
                if self.peek_kind() == TOK_IF {
                    let _dummy = self.parse_primary()
                } else if self.peek_kind() == TOK_LBRACE {
                    self.advance()
                    let _else = self.parse_block_stmts()
                    self.expect_tok(TOK_RBRACE, "}")
                }
            }
            return 0usize
        }
        if k != TOK_EOF {
            let cur_l = self.cur_tok_line()
            let cur_c = self.cur_tok_col()
            var msg = String.new()
            msg.push_str("unexpected token '")
            msg.push_str(self.peek_text())
            msg.push_str("' in expression")
            self.report_error("E0014", msg.as_ptr() as str, cur_l, cur_c)
            self.advance()
        }
        0usize
    }

    fn parse_postfix(var self, base_val: usize) -> usize {
        var base = base_val + 0usize
        while true {
            let k = self.peek_kind()
            let base_l = self.exprs.ptr[base].expr_line
            let base_c = self.exprs.ptr[base].expr_col
            if k == TOK_LPAREN { // Call expr(args...)
                self.advance()
                var args = Vec.new()
                while self.peek_kind() != TOK_RPAREN && self.peek_kind() != TOK_EOF {
                    let a = self.parse_expr(0)
                    args.push(a)
                    if !self.match_tok(TOK_COMMA) {
                        break
                    }
                }
                self.expect_tok(TOK_RPAREN, ")")
                var is_print_func = false
                if self.exprs.ptr[base].kind == EXPR_IDENT {
                    let cname = self.exprs.ptr[base].str_val.as_ptr() as str
                    if str_eq(cname, "println") || str_eq(cname, "print") {
                        is_print_func = true
                    }
                }
                if is_print_func {
                    if args.len == 1usize {
                        let first_arg_id = args.ptr[0usize]
                        if self.exprs.ptr[first_arg_id].kind == EXPR_STR {
                            let str_line = self.exprs.ptr[first_arg_id].expr_line
                            let str_col = self.exprs.ptr[first_arg_id].expr_col
                            var prefix_len: i64 = 1i64
                            if self.exprs.ptr[first_arg_id].int_val == 1i64 {
                                prefix_len = 2i64
                            }
                            let s_ptr: *raw u8 = self.exprs.ptr[first_arg_id].str_val.as_ptr()
                            let s_len = str_len(s_ptr as str)
                            var has_interp = false
                            var si = 0usize
                            while si < s_len {
                                if s_ptr[si] == 123u8 && si + 1usize < s_len && s_ptr[si + 1usize] != 125u8 {
                                    has_interp = true
                                }
                                si = si + 1usize
                            }
                            if has_interp {
                                var new_fmt = String.new()
                                var scan_i = 0usize
                                while scan_i < s_len {
                                    if s_ptr[scan_i] == 123u8 { // '{'
                                        var end_brace = scan_i + 1usize
                                        while end_brace < s_len && s_ptr[end_brace] != 125u8 { // '}'
                                            end_brace = end_brace + 1usize
                                        }
                                        if end_brace < s_len && end_brace > scan_i + 1usize {
                                            var var_name = String.new()
                                            var vi = scan_i + 1usize
                                            while vi < end_brace {
                                                var_name.push_byte(s_ptr[vi])
                                                vi = vi + 1usize
                                            }
                                            var_name.push_byte(0u8)
                                            let var_col = str_col + prefix_len + (scan_i as i64) + 1i64
                                            var interp_expr = 0usize
                                            let v_str = var_name.as_ptr() as str
                                            if str_contains(v_str, ".") {
                                                var obj_name = String.new()
                                                var f_name = String.new()
                                                var past_dot = false
                                                var di = 0usize
                                                let v_len = str_len(v_str)
                                                let vp = v_str as *raw u8
                                                while di < v_len {
                                                    if vp[di] == 46u8 { // '.'
                                                        past_dot = true
                                                    } else if !past_dot {
                                                        obj_name.push_byte(vp[di])
                                                    } else {
                                                        f_name.push_byte(vp[di])
                                                    }
                                                    di = di + 1usize
                                                }
                                                obj_name.push_byte(0u8)
                                                f_name.push_byte(0u8)
                                                let obj_expr = self.add_expr(Expr {
                                                    kind: EXPR_IDENT,
                                                    op: 0,
                                                    int_val: 0i64,
                                                    str_val: obj_name,
                                                    target_type: String.new(),
                                                    left: 0usize,
                                                    right: 0usize,
                                                    args: Vec.new(),
                                                    field_name: String.new(),
                                                    expr_line: str_line,
                                                    expr_col: var_col,
                                                })
                                                interp_expr = self.add_expr(Expr {
                                                    kind: EXPR_FIELD_ACCESS,
                                                    op: 0,
                                                    int_val: 0i64,
                                                    str_val: String.new(),
                                                    target_type: String.new(),
                                                    left: obj_expr,
                                                    right: 0usize,
                                                    args: Vec.new(),
                                                    field_name: f_name,
                                                    expr_line: str_line,
                                                    expr_col: var_col,
                                                })
                                            } else {
                                                interp_expr = self.add_expr(Expr {
                                                    kind: EXPR_IDENT,
                                                    op: 0,
                                                    int_val: 0i64,
                                                    str_val: var_name,
                                                    target_type: String.new(),
                                                    left: 0usize,
                                                    right: 0usize,
                                                    args: Vec.new(),
                                                    field_name: String.new(),
                                                    expr_line: str_line,
                                                    expr_col: var_col,
                                                })
                                            }
                                            args.push(interp_expr)
                                            new_fmt.push_byte(123u8) // '{'
                                            new_fmt.push_byte(125u8) // '}'
                                            scan_i = end_brace + 1usize
                                        } else {
                                            new_fmt.push_byte(s_ptr[scan_i])
                                            scan_i = scan_i + 1usize
                                        }
                                    } else {
                                        new_fmt.push_byte(s_ptr[scan_i])
                                        scan_i = scan_i + 1usize
                                    }
                                }
                                new_fmt.push_byte(0u8)
                                self.exprs.ptr[first_arg_id].str_val = new_fmt
                            }
                        }
                    }
                }
                base = self.add_expr(Expr {
                    kind: EXPR_CALL,
                    op: 0,
                    int_val: 0i64,
                    str_val: String.new(),
                    target_type: String.new(),
                    left: base,
                    right: 0usize,
                    args: args,
                    field_name: String.new(),
                    expr_line: base_l,
                    expr_col: base_c,
                })
            } else if k == TOK_LBRACKET { // Indexing arr[idx]
                self.advance()
                let idx = self.parse_expr(0)
                self.match_tok(TOK_RBRACKET)
                base = self.add_expr(Expr {
                    kind: EXPR_INDEX,
                    op: 0,
                    int_val: 0i64,
                    str_val: String.new(),
                    target_type: String.new(),
                    left: base,
                    right: idx,
                    args: Vec.new(),
                    field_name: String.new(),
                    expr_line: base_l,
                    expr_col: base_c,
                })
            } else if k == TOK_LT && self.exprs.ptr[base].kind == EXPR_IDENT {
                let p_name: *raw u8 = self.exprs.ptr[base].str_val.as_ptr()
                let slen = str_len(p_name as str)
                var is_generic_inst = false
                if (p_name as usize) != 0usize && slen > 0usize && p_name[0usize] >= 65u8 && p_name[0usize] <= 90u8 {
                    var scan = self.pos + 1usize
                    var depth = 1i64
                    while scan < self.tokens.len && depth > 0i64 {
                        let sk = self.tokens.ptr[scan].kind
                        if sk == TOK_LT {
                            depth = depth + 1i64
                        } else if sk == TOK_GT {
                            depth = depth - 1i64
                        } else if sk == TOK_SEMI || sk == TOK_EOF {
                            break
                        }
                        scan = scan + 1usize
                    }
                    if depth == 0i64 && scan < self.tokens.len {
                        let nk = self.tokens.ptr[scan].kind
                        if nk == TOK_LBRACE || nk == TOK_DOT || nk == TOK_COLONCOLON {
                            is_generic_inst = true
                        }
                    }
                }
                if is_generic_inst {
                    self.advance() // skip '<'
                    var full_type = String.new()
                    full_type.push_str(self.exprs.ptr[base].str_val.as_ptr() as str)
                    full_type.push_byte(60u8) // '<'
                    var depth = 1i64
                    while self.peek_kind() != TOK_EOF && depth > 0i64 {
                        let tk = self.peek_kind()
                        if tk == TOK_LT {
                            depth = depth + 1i64
                            full_type.push_byte(60u8)
                        } else if tk == TOK_GT {
                            depth = depth - 1i64
                            if depth == 0i64 {
                                full_type.push_byte(62u8) // '>'
                                self.advance()
                                break
                            } else {
                                full_type.push_byte(62u8)
                            }
                        } else if tk == TOK_COMMA {
                            full_type.push_str(", ")
                        } else {
                            full_type.push_str(self.peek_text())
                        }
                        self.advance()
                    }
                    full_type.push_byte(0u8)
                    self.exprs.ptr[base].str_val = full_type
                    continue
                } else {
                    break
                }
            } else if k == TOK_LBRACE {
                var is_struct = false
                if self.exprs.ptr[base].kind == EXPR_IDENT {
                    let p_name: *raw u8 = self.exprs.ptr[base].str_val.as_ptr()
                    let slen = str_len(p_name as str)
                    if (p_name as usize) != 0usize && slen > 0usize {
                        let is_upper = p_name[0usize] >= 65u8 && p_name[0usize] <= 90u8
                        let p1 = self.pos + 1usize
                        if p1 < self.tokens.len {
                            let k1 = self.tokens.ptr[p1].kind
                            if k1 == TOK_RBRACE {
                                if is_upper {
                                    is_struct = true
                                }
                            } else if (k1 == TOK_IDENT || k1 == TOK_HANDLE || k1 == TOK_PERFORM || k1 == TOK_RESUME || k1 == TOK_EFFECT || k1 == TOK_WITH || k1 == TOK_REQUIRES || k1 == TOK_ENSURES || k1 == TOK_ACTOR || k1 == TOK_ASYNC || k1 == TOK_AWAIT || k1 == TOK_DYN) && p1 + 1usize < self.tokens.len {
                                if self.tokens.ptr[p1 + 1usize].kind == TOK_COLON {
                                    is_struct = true
                                }
                            }
                        }
                    }
                }
                if is_struct {
                    self.advance()
                    var f_args = Vec.new()
                    while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                        let _fld = self.match_ident_or_kw()
                        let _col = self.match_tok(TOK_COLON)
                        let v = self.parse_expr(0)
                        f_args.push(v)
                        if !self.match_tok(TOK_COMMA) {
                            break
                        }
                    }
                    let _rb = self.match_tok(TOK_RBRACE)
                    base = self.add_expr(Expr {
                        kind: EXPR_CALL,
                        op: 0,
                        int_val: 0i64,
                        str_val: String.new(),
                        target_type: String.new(),
                        left: base,
                        right: 0usize,
                        args: f_args,
                        field_name: String.new(),
                        expr_line: base_l,
                        expr_col: base_c,
                    })
                } else {
                    break
                }
            } else if k == TOK_DOT || k == TOK_COLONCOLON { // Field or Method access
                self.advance()
                let member = String.from_str(self.peek_text())
                self.match_ident_or_kw()
                if self.peek_kind() == TOK_LPAREN {
                    self.advance()
                    var m_args = Vec.new()
                    while self.peek_kind() != TOK_RPAREN && self.peek_kind() != TOK_EOF {
                        let a = self.parse_expr(0)
                        m_args.push(a)
                        if !self.match_tok(TOK_COMMA) {
                            break
                        }
                    }
                    self.expect_tok(TOK_RPAREN, ")")
                    base = self.add_expr(Expr {
                        kind: EXPR_METHOD_CALL,
                        op: 0,
                        int_val: 0i64,
                        str_val: member,
                        target_type: String.new(),
                        left: base,
                        right: 0usize,
                        args: m_args,
                        field_name: String.new(),
                        expr_line: base_l,
                        expr_col: base_c,
                    })
                } else {
                    if self.exprs.ptr[base].kind == EXPR_IDENT {
                        var full_const = String.new()
                        full_const.push_str(self.exprs.ptr[base].str_val.as_ptr() as str)
                        full_const.push_str("::")
                        full_const.push_str(member.as_ptr() as str)
                        var ci = 0usize
                        var found_const = false
                        while ci < self.const_names.len {
                            if str_eq(self.const_names.ptr[ci].as_ptr() as str, full_const.as_ptr() as str) {
                                found_const = true
                                break
                            }
                            ci = ci + 1usize
                        }
                        if found_const {
                            base = self.add_expr(Expr {
                                kind: EXPR_IDENT,
                                op: 0,
                                int_val: 0i64,
                                str_val: full_const,
                                target_type: String.from_str("i64"),
                                left: 0usize,
                                right: 0usize,
                                args: Vec.new(),
                                field_name: String.new(),
                                expr_line: base_l,
                                expr_col: base_c,
                            })
                        } else {
                            base = self.add_expr(Expr {
                                kind: EXPR_FIELD_ACCESS,
                                op: 0,
                                int_val: 0i64,
                                str_val: String.new(),
                                target_type: String.new(),
                                left: base,
                                right: 0usize,
                                args: Vec.new(),
                                field_name: member,
                                expr_line: base_l,
                                expr_col: base_c,
                            })
                        }
                    } else {
                        base = self.add_expr(Expr {
                            kind: EXPR_FIELD_ACCESS,
                            op: 0,
                            int_val: 0i64,
                            str_val: String.new(),
                            target_type: String.new(),
                            left: base,
                            right: 0usize,
                            args: Vec.new(),
                            field_name: member,
                            expr_line: base_l,
                            expr_col: base_c,
                        })
                    }
                }
            } else if k == TOK_AS { // Cast expr as Type
                self.advance()
                let target_ty = self.parse_type_str()
                base = self.add_expr(Expr {
                    kind: EXPR_CAST,
                    op: 0,
                    int_val: 0i64,
                    str_val: String.new(),
                    target_type: target_ty,
                    left: base,
                    right: 0usize,
                    args: Vec.new(),
                    field_name: String.new(),
                    expr_line: base_l,
                    expr_col: base_c,
                })
            } else if k == TOK_QUESTION { // Try operator expr?
                self.advance()
                base = self.add_expr(Expr {
                    kind: EXPR_TRY,
                    op: 0,
                    int_val: 0i64,
                    str_val: String.new(),
                    target_type: String.new(),
                    left: base,
                    right: 0usize,
                    args: Vec.new(),
                    field_name: String.new(),
                    expr_line: base_l,
                    expr_col: base_c,
                })
            } else {
                break
            }
        }
        return base
    }

    fn parse_expr(var self, prec: i32) -> usize {
        let prim = self.parse_primary()
        var left = self.parse_postfix(prim)

        while true {
            let bin_op = self.peek_kind()
            let op_prec = self.get_binop_prec(bin_op)
            if op_prec <= prec {
                break
            }
            self.advance()
            let right = self.parse_expr(op_prec)
            var b_kind = EXPR_BINARY
            if bin_op == TOK_DOTDOT {
                b_kind = EXPR_RANGE
            }
            left = self.add_expr(Expr {
                kind: b_kind,
                op: bin_op,
                int_val: 0i64,
                str_val: String.new(),
                target_type: String.new(),
                left: left,
                right: right,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: self.exprs.ptr[left].expr_line,
                expr_col: self.exprs.ptr[left].expr_col,
            })
        }

        return left
    }

    fn parse_stmt(var self) -> usize {
        let start_pos = self.pos
        var res_id = 0usize
        if self.check_lex_error() {
            return 0usize
        }
        let stmt_l = self.cur_tok_line()
        let stmt_c = self.cur_tok_col()
        let k = self.peek_kind()
        if k == TOK_LET || k == TOK_VAR {
            var s_kind = STMT_LET + 0
            if k == TOK_VAR {
                s_kind = STMT_VAR
            }
            self.advance()
            let v_name = String.from_str(self.peek_text())
            self.expect_tok(TOK_IDENT, "identifier")
            var v_type = String.new()
            if self.match_tok(TOK_COLON) {
                v_type = self.parse_type_str()
            }
            var init_id = 0usize
            if self.match_tok(TOK_EQ) {
                init_id = self.parse_expr(0)
            }
            if v_type.len() == 0usize && init_id != 0usize {
                let ik = self.exprs.ptr[init_id].kind
                if ik == EXPR_CAST {
                    v_type = self.exprs.ptr[init_id].target_type
                } else if ik == EXPR_STR {
                    v_type = String.from_str("str")
                } else if ik == EXPR_BOOL {
                    v_type = String.from_str("bool")
                } else if ik == EXPR_METHOD_CALL {
                    let mname = self.exprs.ptr[init_id].str_val.as_ptr() as str
                    if str_eq(mname, "as_ptr") {
                        v_type = String.from_str("*raw u8")
                    } else if str_eq(mname, "new") || str_eq(mname, "from_str") {
                        let recv = self.exprs.ptr[init_id].left
                        if self.exprs.ptr[recv].kind == EXPR_IDENT {
                            let rname = self.exprs.ptr[recv].str_val.as_ptr() as str
                            if str_eq(rname, "String") {
                                v_type = String.from_str("String")
                            } else if str_eq(rname, "Vec") {
                                v_type = String.from_str("Vec")
                            }
                        }
                    }
                } else if ik == EXPR_CALL {
                    let callee = self.exprs.ptr[init_id].left
                    if self.exprs.ptr[callee].kind == EXPR_IDENT {
                        let cname = self.exprs.ptr[callee].str_val.as_ptr() as str
                        if str_eq(cname, "input") {
                            v_type = String.from_str("String")
                        }
                    }
                }
            }
            if init_id != 0usize && self.exprs.ptr[init_id].kind == EXPR_IDENT {
                let moved_name = self.exprs.ptr[init_id].str_val.as_ptr() as str
                var is_move = false
                var si = self.stmts.len
                while si > 0usize {
                    si = si - 1usize
                    let sk = self.stmts.ptr[si].kind
                    if sk == STMT_LET || sk == STMT_VAR {
                        if str_eq(self.stmts.ptr[si].name.as_ptr() as str, moved_name) {
                            let sty = self.stmts.ptr[si].type_name.as_ptr() as str
                            if str_eq(sty, "String") || str_eq(sty, "Vec") {
                                is_move = true
                            } else if str_len(sty) == 0usize {
                                let se_id = self.stmts.ptr[si].expr_id
                                if se_id != 0usize && self.exprs.ptr[se_id].kind == EXPR_METHOD_CALL {
                                    let recv = self.exprs.ptr[se_id].left
                                    if self.exprs.ptr[recv].kind == EXPR_IDENT {
                                        let rname = self.exprs.ptr[recv].str_val.as_ptr() as str
                                        if str_eq(rname, "String") || str_eq(rname, "Vec") {
                                            is_move = true
                                        }
                                    }
                                }
                            }
                            break
                        }
                    }
                }
                if is_move {
                    self.moved_vars.push(self.exprs.ptr[init_id].str_val)
                }
            }
            res_id = self.add_stmt(Stmt {
                kind: s_kind,
                name: v_name,
                type_name: v_type,
                expr_id: init_id,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: Vec.new(),
                stmt_line: stmt_l,
                stmt_col: stmt_c,
            })
        } else if k == TOK_IF {
            self.advance()
            let cond_id = self.parse_expr(0)
            self.expect_tok(TOK_LBRACE, "{")
            let then_stmts = self.parse_block_stmts()
            self.expect_tok(TOK_RBRACE, "}")
            var else_stmts = Vec.new()
            if self.match_tok(TOK_ELSE) {
                if self.peek_kind() == TOK_IF {
                    let elif_st = self.parse_stmt()
                    else_stmts.push(elif_st)
                } else {
                    let _lb = self.expect_tok(TOK_LBRACE, "{")
                    else_stmts = self.parse_block_stmts()
                    let _rb = self.expect_tok(TOK_RBRACE, "}")
                }
            }
            res_id = self.add_stmt(Stmt {
                kind: STMT_IF,
                name: String.new(),
                type_name: String.new(),
                expr_id: cond_id,
                index_expr: 0usize,
                then_stmts: then_stmts,
                else_stmts: else_stmts,
                body_stmts: Vec.new(),
                stmt_line: stmt_l,
                stmt_col: stmt_c,
            })
        } else if k == TOK_WHILE {
            self.advance()
            let cond_id = self.parse_expr(0)
            self.expect_tok(TOK_LBRACE, "{")
            let body_stmts = self.parse_block_stmts()
            self.expect_tok(TOK_RBRACE, "}")
            res_id = self.add_stmt(Stmt {
                kind: STMT_WHILE,
                name: String.new(),
                type_name: String.new(),
                expr_id: cond_id,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: body_stmts,
                stmt_line: stmt_l,
                stmt_col: stmt_c,
            })
        } else if k == TOK_LOOP {
            self.advance()
            self.expect_tok(TOK_LBRACE, "{")
            let body_stmts = self.parse_block_stmts()
            self.expect_tok(TOK_RBRACE, "}")
            let true_expr = self.add_expr(Expr {
                kind: EXPR_BOOL,
                op: 0,
                int_val: 1i64,
                str_val: String.new(),
                target_type: String.from_str("bool"),
                left: 0usize,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: stmt_l,
                expr_col: stmt_c,
            })
            res_id = self.add_stmt(Stmt {
                kind: STMT_WHILE,
                name: String.new(),
                type_name: String.new(),
                expr_id: true_expr,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: body_stmts,
                stmt_line: stmt_l,
                stmt_col: stmt_c,
            })
        } else if k == TOK_FOR {
            let tok_l = self.cur_tok_line()
            let tok_c = self.cur_tok_col()
            self.advance()
            let var_name = String.from_str(self.peek_text())
            self.expect_tok(TOK_IDENT, "loop variable")
            var type_name = String.new()
            if self.peek_kind() == TOK_COLON {
                self.advance()
                type_name = self.parse_type_str()
            }
            self.expect_tok(TOK_IN, "in")
            let iter_expr = self.parse_expr(0)
            self.expect_tok(TOK_LBRACE, "{")
            let body_stmts = self.parse_block_stmts()
            self.expect_tok(TOK_RBRACE, "}")
            var s_kind = STMT_FOR_IN
            if self.exprs.ptr[iter_expr].kind == EXPR_RANGE {
                s_kind = STMT_FOR_RANGE
            }
            res_id = self.add_stmt(Stmt {
                kind: s_kind,
                name: var_name,
                type_name: type_name,
                expr_id: iter_expr,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: body_stmts,
                stmt_line: tok_l,
                stmt_col: tok_c,
            })
        } else if k == TOK_DEFER {
            let tok_l = self.cur_tok_line()
            let tok_c = self.cur_tok_col()
            self.advance()
            var def_stmts = Vec.new()
            if self.peek_kind() == TOK_LBRACE {
                self.advance()
                def_stmts = self.parse_block_stmts()
                self.expect_tok(TOK_RBRACE, "}")
            } else {
                let s_id = self.parse_stmt()
                def_stmts.push(s_id)
            }
            res_id = self.add_stmt(Stmt {
                kind: STMT_DEFER,
                name: String.new(),
                type_name: String.new(),
                expr_id: 0usize,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: def_stmts,
                stmt_line: tok_l,
                stmt_col: tok_c,
            })
        } else if (k == TOK_HANDLE || (k == TOK_IDENT && str_eq(self.peek_text(), "handle"))) && self.peek_next_kind() != TOK_DOT && self.peek_next_kind() != TOK_EQ && self.peek_next_kind() != TOK_LPAREN {
            self.advance()
            let comp_expr = self.parse_expr(0)
            if self.peek_kind() == TOK_WITH || (self.peek_kind() == TOK_IDENT && str_eq(self.peek_text(), "with")) {
                self.advance()
            }
            self.expect_tok(TOK_LBRACE, "{")
            var handle_stmts = Vec.new()
            while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                let _pat_expr = self.parse_expr(0)
                if self.peek_kind() == TOK_FAT_ARROW || self.peek_kind() == TOK_ARROW {
                    self.advance()
                }
                if self.match_tok(TOK_LBRACE) {
                    let b = self.parse_block_stmts()
                    var bi = 0usize
                    while bi < b.len {
                        handle_stmts.push(b.ptr[bi])
                        bi = bi + 1usize
                    }
                    self.expect_tok(TOK_RBRACE, "}")
                } else {
                    let st = self.parse_stmt()
                    handle_stmts.push(st)
                    self.match_tok(TOK_SEMI)
                }
                self.match_tok(TOK_COMMA)
            }
            self.expect_tok(TOK_RBRACE, "}")
            res_id = self.add_stmt(Stmt {
                kind: STMT_EXPR,
                name: String.new(),
                type_name: String.new(),
                expr_id: comp_expr,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: handle_stmts,
                stmt_line: tok_l,
                stmt_col: tok_c,
            })
        } else if k == TOK_MATCH || (k == TOK_IDENT && str_eq(self.peek_text(), "match")) {
            self.advance()
            let target_expr = self.parse_expr(0)
            self.expect_tok(TOK_LBRACE, "{")
            var arms = Vec.new()
            while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                var is_wild = false
                var cond_id = 0usize
                var bound_name = String.new()
                if self.peek_kind() == TOK_IDENT && str_eq(self.peek_text(), "_") {
                    is_wild = true
                    self.advance()
                } else {
                    let pat_expr = self.parse_expr(0)
                    let pep = self.exprs.ptr
                    if pep[pat_expr].kind == EXPR_METHOD_CALL && pep[pat_expr].args.len == 1usize {
                        let arg_id = pep[pat_expr].args.ptr[0usize]
                        if pep[arg_id].kind == EXPR_IDENT {
                            bound_name = pep[arg_id].str_val
                        }
                        let zero_expr = self.add_expr(Expr {
                            kind: EXPR_INT,
                            op: 0,
                            int_val: 0i64,
                            str_val: String.from_str("0"),
                            target_type: String.from_str("i64"),
                            left: 0usize,
                            right: 0usize,
                            args: Vec.new(),
                            field_name: String.new(),
                expr_line: self.cur_tok_line(),
                expr_col: self.cur_tok_col(),
                        })
                        cond_id = self.add_expr(Expr {
                            kind: EXPR_BINARY,
                            op: TOK_NEQ,
                            int_val: 0i64,
                            str_val: String.new(),
                            target_type: String.from_str("bool"),
                            left: target_expr,
                            right: zero_expr,
                            args: Vec.new(),
                            field_name: String.new(),
                expr_line: self.cur_tok_line(),
                expr_col: self.cur_tok_col(),
                        })
                    } else {
                        cond_id = self.add_expr(Expr {
                            kind: EXPR_BINARY,
                            op: TOK_EQEQ,
                            int_val: 0i64,
                            str_val: String.new(),
                            target_type: String.from_str("bool"),
                            left: target_expr,
                            right: pat_expr,
                            args: Vec.new(),
                            field_name: String.new(),
                expr_line: self.cur_tok_line(),
                expr_col: self.cur_tok_col(),
                        })
                    }
                }
                if self.peek_kind() == TOK_FAT_ARROW {
                    self.advance()
                } else if self.peek_kind() == TOK_EQ {
                    self.advance()
                    if self.peek_kind() == TOK_GT {
                        self.advance()
                    }
                }
                var arm_stmts = Vec.new()
                if str_len(bound_name.as_ptr() as str) > 0usize {
                    let let_stmt = self.add_stmt(Stmt {
                        kind: STMT_LET,
                        name: String.from_str(bound_name.as_ptr() as str),
                        type_name: String.new(),
                        expr_id: target_expr,
                        index_expr: 0usize,
                        then_stmts: Vec.new(),
                        else_stmts: Vec.new(),
                        body_stmts: Vec.new(),
                stmt_line: self.cur_tok_line(),
                stmt_col: self.cur_tok_col(),
                    })
                    arm_stmts.push(let_stmt)
                }
                if self.match_tok(TOK_LBRACE) {
                    let bstmts = self.parse_block_stmts()
                    var bi = 0usize
                    while bi < bstmts.len {
                        arm_stmts.push(bstmts.ptr[bi])
                        bi = bi + 1usize
                    }
                    let _disc = self.expect_tok(TOK_RBRACE, "}")
                } else {
                    let st = self.parse_stmt()
                    arm_stmts.push(st)
                    self.match_tok(TOK_SEMI)
                }
                self.match_tok(TOK_COMMA)
                arms.push(MatchArm {
                    is_wildcard: is_wild,
                    cond_expr: cond_id,
                    bound_var: bound_name,
                    stmts: arm_stmts,
                })
            }
            self.expect_tok(TOK_RBRACE, "}")
            var current_else = Vec.new()
            var ai = arms.len
            while ai > 0usize {
                ai = ai - 1usize
                let arm = arms.ptr[ai]
                if arm.is_wildcard && ai == arms.len - 1usize {
                    current_else = arm.stmts
                } else {
                    let if_stmt = self.add_stmt(Stmt {
                        kind: STMT_IF,
                        name: String.new(),
                        type_name: String.new(),
                        expr_id: arm.cond_expr,
                        index_expr: 0usize,
                        then_stmts: arm.stmts,
                        else_stmts: current_else,
                        body_stmts: Vec.new(),
                stmt_line: self.cur_tok_line(),
                stmt_col: self.cur_tok_col(),
                    })
                    var new_else = Vec.new()
                    new_else.push(if_stmt)
                    current_else = new_else
                }
            }
            if current_else.len > 0usize {
                res_id = current_else.ptr[0usize]
            }
        } else if k == TOK_RETURN {
            let ret_pos = self.pos
            let ret_line = self.tokens.ptr[ret_pos].line
            self.advance()
            var ret_val = 0usize
            if self.peek_kind() != TOK_SEMI && self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                if self.pos < self.tokens.len && self.tokens.ptr[self.pos].line == ret_line {
                    ret_val = self.parse_expr(0)
                }
            }
            res_id = self.add_stmt(Stmt {
                kind: STMT_RETURN,
                name: String.new(),
                type_name: String.new(),
                expr_id: ret_val,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: Vec.new(),
                stmt_line: stmt_l,
                stmt_col: stmt_c,
            })
        } else if k == TOK_BREAK {
            self.advance()
            res_id = self.add_stmt(Stmt {
                kind: STMT_BREAK,
                name: String.new(),
                type_name: String.new(),
                expr_id: 0usize,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: Vec.new(),
                stmt_line: stmt_l,
                stmt_col: stmt_c,
            })
        } else if k == TOK_CONTINUE {
            self.advance()
            res_id = self.add_stmt(Stmt {
                kind: STMT_CONTINUE,
                name: String.new(),
                type_name: String.new(),
                expr_id: 0usize,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: Vec.new(),
                stmt_line: stmt_l,
                stmt_col: stmt_c,
            })
        } else {
            // Expression or Assignment
            let lhs = self.parse_expr(0)
            let lhs_l = self.exprs.ptr[lhs].expr_line
            let lhs_c = self.exprs.ptr[lhs].expr_col
            if self.match_tok(TOK_EQ) {
                let rhs = self.parse_expr(0)
                let ep = self.exprs.ptr
                if ep[lhs].kind == EXPR_IDENT {
                    let vname = ep[lhs].str_val.as_ptr() as str
                    // Check if variable is immutable (declared with let)
                    var si = self.stmts.len
                    while si > 0usize {
                        si = si - 1usize
                        if str_eq(self.stmts.ptr[si].name.as_ptr() as str, vname) {
                            if self.stmts.ptr[si].kind == STMT_LET {
                                var err = String.new()
                                err.push_str("cannot assign to immutable variable '")
                                err.push_str(vname)
                                err.push_str("'")
                                self.report_error_span("E0021", err.as_ptr() as str, lhs_l, lhs_c, str_len(vname) as i64)
                            }
                            break
                        }
                    }
                    res_id = self.add_stmt(Stmt {
                        kind: STMT_ASSIGN,
                        name: ep[lhs].str_val,
                        type_name: String.new(),
                        expr_id: rhs,
                        index_expr: 0usize,
                        then_stmts: Vec.new(),
                        else_stmts: Vec.new(),
                        body_stmts: Vec.new(),
                        stmt_line: lhs_l,
                        stmt_col: lhs_c,
                    })
                } else if ep[lhs].kind == EXPR_INDEX {
                    var arr_sub = Vec.new()
                    arr_sub.push(ep[lhs].left)
                    var arr_name = String.new()
                    if ep[ep[lhs].left].kind == EXPR_IDENT {
                        arr_name = ep[ep[lhs].left].str_val
                    }
                    res_id = self.add_stmt(Stmt {
                        kind: STMT_ASSIGN_INDEX,
                        name: arr_name,
                        type_name: String.new(),
                        expr_id: rhs,
                        index_expr: ep[lhs].right,
                        then_stmts: arr_sub,
                        else_stmts: Vec.new(),
                        body_stmts: Vec.new(),
                        stmt_line: lhs_l,
                        stmt_col: lhs_c,
                    })
                } else if ep[lhs].kind == EXPR_FIELD_ACCESS {
                    res_id = self.add_stmt(Stmt {
                        kind: STMT_ASSIGN_FIELD,
                        name: ep[lhs].field_name,
                        type_name: String.new(),
                        expr_id: rhs,
                        index_expr: ep[lhs].left,
                        then_stmts: Vec.new(),
                        else_stmts: Vec.new(),
                        body_stmts: Vec.new(),
                        stmt_line: lhs_l,
                        stmt_col: lhs_c,
                    })
                } else {
                    res_id = self.add_stmt(Stmt {
                        kind: STMT_EXPR,
                        name: String.new(),
                        type_name: String.new(),
                        expr_id: rhs,
                        index_expr: 0usize,
                        then_stmts: Vec.new(),
                        else_stmts: Vec.new(),
                        body_stmts: Vec.new(),
                        stmt_line: lhs_l,
                        stmt_col: lhs_c,
                    })
                }
            } else {
                res_id = self.add_stmt(Stmt {
                    kind: STMT_EXPR,
                    name: String.new(),
                    type_name: String.new(),
                    expr_id: lhs,
                    index_expr: 0usize,
                    then_stmts: Vec.new(),
                    else_stmts: Vec.new(),
                    body_stmts: Vec.new(),
                    stmt_line: lhs_l,
                    stmt_col: lhs_c,
                })
            }
        }
        if self.pos == start_pos {
            self.advance()
        }
        return res_id
    }

    fn parse_block_stmts(var self) -> Vec<usize> {
        var stmts = Vec.new()
        while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
            if self.error_count >= 25i64 {
                break
            }
            // 1. Consume leading or standalone semicolons (empty statements)
            while self.match_tok(TOK_SEMI) {
            }
            if self.peek_kind() == TOK_RBRACE || self.peek_kind() == TOK_EOF {
                break
            }

            let start_p = self.pos
            let errs_before = self.error_count
            let st = self.parse_stmt()
            if st > 0usize {
                stmts.push(st)
            } else if self.error_count > errs_before {
                self.synchronize_stmt()
                continue
            }

            // 2. Determine end line of the parsed statement
            var end_line = 0i64
            if self.pos > 0usize && self.pos - 1usize < self.tokens.len {
                end_line = self.tokens.ptr[self.pos - 1usize].line
            }

            // 3. Consume any semicolons following the statement
            var had_semi = false
            while self.match_tok(TOK_SEMI) {
                had_semi = true
            }

            // 4. If block terminates or EOF reached, no separator required before '}'
            let next_k = self.peek_kind()
            if next_k == TOK_RBRACE || next_k == TOK_EOF {
                break
            }

            // 5. Another token / statement follows on the same line without semicolon
            if self.pos < self.tokens.len {
                let next_line = self.tokens.ptr[self.pos].line
                if !had_semi && next_line == end_line {
                    let next_col = self.tokens.ptr[self.pos].col
                    self.report_error("E0011", "expected ';' or newline between statements on the same line", next_line, next_col)
                }
            }

            // 6. Guarantee parser makes forward progress
            if self.pos == start_p {
                self.advance()
            }
        }
        return stmts
    }

    fn parse_function(var self, prefix: str) {
        self.moved_vars = Vec.new()
        self.advance() // skip 'fn'
        let raw_fn_name = String.from_str(self.peek_text())
        self.match_ident_or_kw()
        if self.peek_kind() == TOK_LT {
            while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                self.advance()
            }
            if self.peek_kind() == TOK_GT {
                self.advance()
            }
        }
        self.match_tok(TOK_LPAREN)

        var param_names = Vec.new()
        var param_types = Vec.new()
        var has_self = false
        while self.peek_kind() != TOK_RPAREN && self.peek_kind() != TOK_EOF {
            let k = self.peek_kind()
            if k == TOK_VAR {
                self.advance()
            }
            let p_name = String.from_str(self.peek_text())
            self.match_ident_or_kw()
            if self.match_tok(TOK_COLON) {
                let p_ty = self.parse_type_str()
                param_names.push(p_name)
                param_types.push(p_ty)
            } else if str_eq(p_name.as_ptr() as str, "self") {
                has_self = true
                param_names.push(p_name)
                if str_len(prefix) > 0usize {
                    param_types.push(String.from_str(prefix))
                } else {
                    param_types.push(String.from_str("*raw var ptr"))
                }
            }
            if !self.match_tok(TOK_COMMA) {
                break
            }
        }
        var fn_name = String.new()
        if str_len(prefix) > 0usize && !str_eq(prefix, "String") && !str_eq(prefix, "Vec") {
            fn_name.push_str(prefix)
            fn_name.push_str("__")
        }
        fn_name.push_str(raw_fn_name.as_ptr() as str)
        fn_name.push_byte(0u8)
        while self.peek_kind() != TOK_RPAREN && self.peek_kind() != TOK_LBRACE && self.peek_kind() != TOK_EOF {
            self.advance()
        }
        self.match_tok(TOK_RPAREN)

        var ret_type = String.from_str("void")
        if self.match_tok(TOK_ARROW) {
            ret_type = self.parse_type_str()
        }

        var req_expr = 0usize
        if self.peek_kind() == TOK_REQUIRES || (self.peek_kind() == TOK_IDENT && str_eq(self.peek_text(), "requires")) {
            self.advance()
            req_expr = self.parse_expr(0)
        }
        var ens_expr = 0usize
        if self.peek_kind() == TOK_ENSURES || (self.peek_kind() == TOK_IDENT && str_eq(self.peek_text(), "ensures")) {
            self.advance()
            ens_expr = self.parse_expr(0)
        }

        var body = Vec.new()
        if self.match_tok(TOK_SEMI) {
            // Prototype / Trait method signature without body
        } else {
            self.expect_tok(TOK_LBRACE, "{")
            body = self.parse_block_stmts()
            self.expect_tok(TOK_RBRACE, "}")
        }

        if req_expr != 0usize {
            let panic_fn = self.add_expr(Expr {
                kind: EXPR_IDENT,
                op: 0,
                int_val: 0i64,
                str_val: String.from_str("__rad_contract_violation"),
                target_type: String.new(),
                left: 0usize,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: self.cur_tok_line(),
                expr_col: self.cur_tok_col(),
            })
            let panic_call = self.add_expr(Expr {
                kind: EXPR_CALL,
                op: 0,
                int_val: 0i64,
                str_val: String.new(),
                target_type: String.from_str("void"),
                left: panic_fn,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: self.cur_tok_line(),
                expr_col: self.cur_tok_col(),
            })
            let panic_st = self.add_stmt(Stmt {
                kind: STMT_EXPR,
                name: String.new(),
                type_name: String.new(),
                expr_id: panic_call,
                index_expr: 0usize,
                then_stmts: Vec.new(),
                else_stmts: Vec.new(),
                body_stmts: Vec.new(),
                stmt_line: self.cur_tok_line(),
                stmt_col: self.cur_tok_col(),
            })
            var panic_stmts = Vec.new()
            panic_stmts.push(panic_st)

            let not_cond = self.add_expr(Expr {
                kind: EXPR_UNARY,
                op: TOK_NOT,
                int_val: 0i64,
                str_val: String.new(),
                target_type: String.from_str("bool"),
                left: req_expr,
                right: 0usize,
                args: Vec.new(),
                field_name: String.new(),
                expr_line: self.cur_tok_line(),
                expr_col: self.cur_tok_col(),
            })
            let if_assert = self.add_stmt(Stmt {
                kind: STMT_IF,
                name: String.new(),
                type_name: String.new(),
                expr_id: not_cond,
                index_expr: 0usize,
                then_stmts: panic_stmts,
                else_stmts: Vec.new(),
                body_stmts: Vec.new(),
                stmt_line: self.cur_tok_line(),
                stmt_col: self.cur_tok_col(),
            })
            var new_body = Vec.new()
            new_body.push(if_assert)
            var bi = 0usize
            while bi < body.len {
                new_body.push(body.ptr[bi])
                bi = bi + 1usize
            }
            body = new_body
        }

        let f_is_test = self.cur_is_test
        self.cur_is_test = false
        let f_is_async = self.cur_is_async
        self.cur_is_async = false

        self.functions.push(FunctionDef {
            fn_name: fn_name,
            param_names: param_names,
            param_types: param_types,
            ret_type: ret_type,
            body: body,
            is_test: f_is_test,
            is_async: f_is_async,
        })
    }

    fn parse_extern_fn(var self) {
        self.advance() // skip 'fn'
        let raw_fn_name = String.from_str(self.peek_text())
        self.match_ident_or_kw()
        if self.peek_kind() == TOK_LT {
            while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                self.advance()
            }
            if self.peek_kind() == TOK_GT {
                self.advance()
            }
        }
        self.match_tok(TOK_LPAREN)

        var param_names = Vec.new()
        var param_types = Vec.new()
        while self.peek_kind() != TOK_RPAREN && self.peek_kind() != TOK_EOF {
            let p_name = String.from_str(self.peek_text())
            self.match_ident_or_kw()
            if self.match_tok(TOK_COLON) {
                let p_ty = self.parse_type_str()
                param_names.push(p_name)
                param_types.push(p_ty)
            }
            if !self.match_tok(TOK_COMMA) {
                break
            }
        }
        while self.peek_kind() != TOK_RPAREN && self.peek_kind() != TOK_SEMI && self.peek_kind() != TOK_ARROW && self.peek_kind() != TOK_EOF {
            self.advance()
        }
        self.match_tok(TOK_RPAREN)

        var ret_type = String.from_str("void")
        if self.match_tok(TOK_ARROW) {
            ret_type = self.parse_type_str()
        }
        let _disc_semi = self.match_tok(TOK_SEMI)

        self.functions.push(FunctionDef {
            fn_name: raw_fn_name,
            param_names: param_names,
            param_types: param_types,
            ret_type: ret_type,
            body: Vec.new(),
            is_test: false,
            is_async: false,
        })
    }

    fn parse_struct(var self) {
        self.advance() // skip 'struct' or 'actor'
        let s_name = String.from_str(self.peek_text())
        self.match_tok(TOK_IDENT)
        if self.peek_kind() == TOK_LT {
            while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                self.advance()
            }
            if self.peek_kind() == TOK_GT {
                self.advance()
            }
        }
        self.expect_tok(TOK_LBRACE, "{")

        var f_names = Vec.new()
        var f_types = Vec.new()
        while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
            while self.match_tok(TOK_COMMA) || self.match_tok(TOK_SEMI) {}
            if self.peek_kind() == TOK_RBRACE || self.peek_kind() == TOK_EOF {
                break
            }
            if self.peek_kind() == TOK_PUB {
                self.advance()
            }
            if self.peek_kind() == TOK_RBRACE || self.peek_kind() == TOK_EOF {
                break
            }
            if self.peek_kind() == TOK_ASYNC || str_eq(self.peek_text(), "async") {
                self.cur_is_async = true
                self.advance()
            }
            if self.peek_kind() == TOK_FN {
                self.parse_function(s_name.as_ptr() as str)
                continue
            }
            if self.peek_kind() == TOK_VAR || self.peek_kind() == TOK_LET {
                self.advance()
            }
            if self.peek_kind() == TOK_RBRACE || self.peek_kind() == TOK_EOF {
                break
            }
            let start_pos = self.pos
            let fnm = String.from_str(self.peek_text())
            self.match_ident_or_kw()
            self.match_tok(TOK_COLON)
            let fty = self.parse_type_str()
            f_names.push(fnm)
            f_types.push(fty)

            var end_line = 0i64
            if self.pos > 0usize && self.pos - 1usize < self.tokens.len {
                end_line = self.tokens.ptr[self.pos - 1usize].line
            }

            var had_sep = false
            while self.match_tok(TOK_COMMA) || self.match_tok(TOK_SEMI) {
                had_sep = true
            }

            if self.peek_kind() == TOK_RBRACE || self.peek_kind() == TOK_EOF {
                break
            }

            if self.pos < self.tokens.len {
                let next_line = self.tokens.ptr[self.pos].line
                if !had_sep && next_line == end_line {
                    let next_col = self.tokens.ptr[self.pos].col
                    self.report_error("E0011", "expected separator (',', ';', or newline) between struct fields on the same line", next_line, next_col)
                }
            }

            if self.pos == start_pos {
                self.advance()
            }
        }
        self.expect_tok(TOK_RBRACE, "}")

        self.structs.push(StructDef {
            struct_name: s_name,
            field_names: f_names,
            field_types: f_types,
        })
    }

    fn parse_program(var self) {
        while self.peek_kind() != TOK_EOF {
            let start_pos = self.pos + 0usize
            if self.check_lex_error() {
                continue
            }
            var is_test = false
            var cfg_test = false
            while self.peek_kind() == TOK_HASH {
                self.advance()
                if self.match_tok(TOK_LBRACKET) {
                    let attr_name = self.peek_text()
                    if str_eq(attr_name, "test") || str_eq(attr_name, "bench") {
                        is_test = true
                        self.advance()
                    } else if str_eq(attr_name, "cfg") {
                        self.advance()
                        if self.match_tok(TOK_LPAREN) {
                            let cfg_arg = self.peek_text()
                            if str_eq(cfg_arg, "test") || str_eq(cfg_arg, "bench") {
                                cfg_test = true
                            }
                            self.advance()
                            self.match_tok(TOK_RPAREN)
                        }
                    } else {
                        while self.peek_kind() != TOK_RBRACKET && self.peek_kind() != TOK_EOF {
                            self.advance()
                        }
                    }
                    self.match_tok(TOK_RBRACKET)
                }
            }

            if (cfg_test || is_test) && !self.test_mode {
                while self.peek_kind() == TOK_PUB {
                    self.advance()
                }
                if str_eq(self.peek_text(), "mod") {
                    self.advance()
                    self.match_tok(TOK_IDENT)
                    if self.match_tok(TOK_LBRACE) {
                        var depth = 1i64
                        while depth > 0i64 && self.peek_kind() != TOK_EOF {
                            if self.peek_kind() == TOK_LBRACE {
                                depth = depth + 1i64
                            } else if self.peek_kind() == TOK_RBRACE {
                                depth = depth - 1i64
                            }
                            self.advance()
                        }
                    }
                    continue
                }
                if self.peek_kind() == TOK_FN {
                    self.advance()
                    while self.peek_kind() != TOK_LBRACE && self.peek_kind() != TOK_EOF {
                        self.advance()
                    }
                    if self.match_tok(TOK_LBRACE) {
                        var depth = 1i64
                        while depth > 0i64 && self.peek_kind() != TOK_EOF {
                            if self.peek_kind() == TOK_LBRACE {
                                depth = depth + 1i64
                            } else if self.peek_kind() == TOK_RBRACE {
                                depth = depth - 1i64
                            }
                            self.advance()
                        }
                    }
                    continue
                }
            }
            self.cur_is_test = is_test
            while self.peek_kind() == TOK_PUB || str_eq(self.peek_text(), "extern") || self.peek_kind() == TOK_STR || self.peek_kind() == TOK_ASYNC || str_eq(self.peek_text(), "async") {
                if self.peek_kind() == TOK_ASYNC || str_eq(self.peek_text(), "async") {
                    self.cur_is_async = true
                }
                if str_eq(self.peek_text(), "extern") {
                    let next_p = self.pos + 1usize
                    if next_p < self.tokens.len && self.tokens.ptr[next_p].kind == TOK_LBRACE {
                        break
                    }
                    if next_p + 1usize < self.tokens.len && self.tokens.ptr[next_p].kind == TOK_STR && self.tokens.ptr[next_p + 1usize].kind == TOK_LBRACE {
                        break
                    }
                }
                self.advance()
            }
            if self.peek_kind() == TOK_FN {
                self.parse_function("")
            } else if self.peek_kind() == TOK_STRUCT || self.peek_kind() == TOK_ACTOR || str_eq(self.peek_text(), "actor") {
                self.parse_struct()
            } else if self.peek_kind() == TOK_EFFECT || str_eq(self.peek_text(), "effect") {
                self.advance() // skip 'effect'
                let eff_name = String.from_str(self.peek_text())
                self.match_tok(TOK_IDENT)
                if self.peek_kind() == TOK_LT {
                    while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                        self.advance()
                    }
                    if self.peek_kind() == TOK_GT {
                        self.advance()
                    }
                }
                self.expect_tok(TOK_LBRACE, "{")
                while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                    if self.peek_kind() == TOK_PUB {
                        self.advance()
                    }
                    if self.peek_kind() == TOK_FN {
                        self.parse_function(eff_name.as_ptr() as str)
                    } else {
                        self.advance()
                    }
                }
                self.expect_tok(TOK_RBRACE, "}")
            } else if self.peek_kind() == TOK_TRAIT || str_eq(self.peek_text(), "trait") {
                self.advance() // skip 'trait'
                let trait_name = String.from_str(self.peek_text())
                self.match_tok(TOK_IDENT)
                if self.peek_kind() == TOK_LT {
                    while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                        self.advance()
                    }
                    if self.peek_kind() == TOK_GT {
                        self.advance()
                    }
                }
                self.expect_tok(TOK_LBRACE, "{")
                var trait_methods = Vec.new()
                while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                    if self.peek_kind() == TOK_PUB {
                        self.advance()
                    }
                    if self.peek_kind() == TOK_ASYNC || str_eq(self.peek_text(), "async") {
                        self.cur_is_async = true
                        self.advance()
                    }
                    if self.peek_kind() == TOK_FN {
                        let fn_idx_before = self.functions.len
                        self.parse_function(trait_name.as_ptr() as str)
                        if self.functions.len > fn_idx_before {
                            let fdef = self.functions.ptr[fn_idx_before]
                            var m_name = fdef.fn_name
                            let prefix_len = trait_name.len() + 2usize
                            if m_name.len() > prefix_len {
                                var short_name = String.new()
                                let mp = m_name.as_ptr() as *raw u8
                                var mi = prefix_len
                                while mi < m_name.len() {
                                    short_name.push_byte(mp[mi])
                                    mi = mi + 1usize
                                }
                                m_name = short_name
                            }
                            trait_methods.push(TraitMethodDef {
                                method_name: m_name,
                                param_names: fdef.param_names,
                                param_types: fdef.param_types,
                                ret_type: fdef.ret_type,
                            })
                        }
                    } else {
                        self.advance()
                    }
                }
                let _disc_tr = self.expect_tok(TOK_RBRACE, "}")
                self.traits.push(TraitDef {
                    trait_name: trait_name,
                    methods: trait_methods,
                })
            } else if str_eq(self.peek_text(), "impl") {
                self.advance() // skip 'impl'
                if self.peek_kind() == TOK_LT {
                    while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                        self.advance()
                    }
                    if self.peek_kind() == TOK_GT {
                        self.advance()
                    }
                }
                var target_name = String.from_str(self.peek_text())
                self.match_tok(TOK_IDENT)
                if self.peek_kind() == TOK_LT {
                    while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                        self.advance()
                    }
                    if self.peek_kind() == TOK_GT {
                        self.advance()
                    }
                }
                if str_eq(self.peek_text(), "for") {
                    self.advance() // skip 'for'
                    let t_trait = String.from_str(target_name.as_ptr() as str)
                    let s_struct = String.from_str(self.peek_text())
                    self.match_tok(TOK_IDENT)
                    if self.peek_kind() == TOK_LT {
                        while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                            self.advance()
                        }
                        if self.peek_kind() == TOK_GT {
                            self.advance()
                        }
                    }
                    self.trait_impls.push(TraitImplDef {
                        trait_name: t_trait,
                        target_struct_name: String.from_str(s_struct.as_ptr() as str),
                    })
                    target_name = s_struct
                }
                let struct_name = target_name
                self.expect_tok(TOK_LBRACE, "{")
                while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                    if self.peek_kind() == TOK_PUB {
                        self.advance()
                    }
                    if self.peek_kind() == TOK_ASYNC || str_eq(self.peek_text(), "async") {
                        self.cur_is_async = true
                        self.advance()
                    }
                    if self.peek_kind() == TOK_FN {
                        self.parse_function(struct_name.as_ptr() as str)
                    } else {
                        self.advance()
                    }
                }
                let _disc1 = self.expect_tok(TOK_RBRACE, "}")
            } else if self.peek_kind() == TOK_ENUM || str_eq(self.peek_text(), "enum") {
                self.advance() // skip 'enum'
                let e_name = String.from_str(self.peek_text())
                self.match_tok(TOK_IDENT)
                if self.peek_kind() == TOK_LT {
                    while self.peek_kind() != TOK_GT && self.peek_kind() != TOK_EOF {
                        self.advance()
                    }
                    if self.peek_kind() == TOK_GT {
                        self.advance()
                    }
                }
                self.expect_tok(TOK_LBRACE, "{")
                var v_idx = 0i64
                while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                    let v_name = String.from_str(self.peek_text())
                    self.match_tok(TOK_IDENT)
                    if self.peek_kind() == TOK_LPAREN {
                        while self.peek_kind() != TOK_RPAREN && self.peek_kind() != TOK_EOF {
                            self.advance()
                        }
                        if self.peek_kind() == TOK_RPAREN {
                            self.advance()
                        }
                    }
                    self.match_tok(TOK_COMMA)
                    var full_vname = String.new()
                    full_vname.push_str(e_name.as_ptr() as str)
                    full_vname.push_str("::")
                    full_vname.push_str(v_name.as_ptr() as str)
                    self.const_names.push(full_vname)
                    self.const_values.push(v_idx)
                    v_idx = v_idx + 1i64
                }
                let _disc2 = self.expect_tok(TOK_RBRACE, "}")
            } else if str_eq(self.peek_text(), "extern") {
                self.advance()
                if self.peek_kind() == TOK_STR {
                    self.advance()
                }
                if self.match_tok(TOK_LBRACE) {
                    while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                        if self.peek_kind() == TOK_FN {
                            self.parse_extern_fn()
                        } else {
                            self.advance()
                        }
                    }
                    let _disc4 = self.match_tok(TOK_RBRACE)
                } else if self.peek_kind() == TOK_FN {
                    self.parse_extern_fn()
                }
            } else if str_eq(self.peek_text(), "import") {
                self.advance()
                var spec = String.new()
                if self.peek_kind() == TOK_STR {
                    spec.push_str(self.peek_text())
                    self.advance()
                } else {
                    while self.peek_kind() != TOK_SEMI && self.peek_kind() != TOK_EOF && self.peek_kind() != TOK_FN && self.peek_kind() != TOK_STRUCT && self.peek_kind() != TOK_ENUM && !str_eq(self.peek_text(), "impl") && !str_eq(self.peek_text(), "const") && !str_eq(self.peek_text(), "import") {
                        let k = self.peek_kind()
                        if k == TOK_DOT {
                            spec.push_byte(46u8) // '.'
                        } else if k == TOK_SLASH {
                            spec.push_byte(47u8) // '/'
                        } else if k == TOK_COLONCOLON {
                            spec.push_byte(47u8) // '::' -> '/'
                        } else {
                            let t = self.peek_text()
                            if str_len(t) > 0usize {
                                spec.push_str(t)
                            }
                        }
                        self.advance()
                    }
                }
                if self.peek_kind() == TOK_SEMI {
                    self.advance()
                }
                spec.push_byte(0u8)
                let s_str = spec.as_ptr() as str
                if str_len(s_str) > 0usize {
                    self.imported_modules.push(spec)
                }
            } else if str_eq(self.peek_text(), "const") {
                self.advance()
                let c_name = String.from_str(self.peek_text())
                self.match_tok(TOK_IDENT)
                self.match_tok(TOK_COLON)
                let _ty = self.parse_type_str()
                self.match_tok(TOK_EQ)
                var is_neg = false
                if self.peek_kind() == TOK_MINUS {
                    is_neg = true
                    self.advance()
                }
                var c_val = 0i64
                if self.peek_kind() == TOK_FLOAT {
                    c_val = parse_int(self.peek_text())
                } else {
                    c_val = self.peek_int()
                }
                if is_neg {
                    c_val = 0i64 - c_val
                }
                self.advance()
                self.match_tok(TOK_SEMI)
                self.const_names.push(c_name)
                self.const_values.push(c_val)
            } else if str_eq(self.peek_text(), "mod") {
                self.advance() // skip 'mod'
                let mod_name = String.from_str(self.peek_text())
                self.match_tok(TOK_IDENT)
                self.expect_tok(TOK_LBRACE, "{")
                while self.peek_kind() != TOK_RBRACE && self.peek_kind() != TOK_EOF {
                    var inner_is_test = false
                    while self.peek_kind() == TOK_HASH {
                        self.advance()
                        if self.match_tok(TOK_LBRACKET) {
                            if str_eq(self.peek_text(), "test") || str_eq(self.peek_text(), "bench") {
                                inner_is_test = true
                            }
                            while self.peek_kind() != TOK_RBRACKET && self.peek_kind() != TOK_EOF {
                                self.advance()
                            }
                            self.match_tok(TOK_RBRACKET)
                        }
                    }
                    while self.peek_kind() == TOK_PUB {
                        self.advance()
                    }
                    self.cur_is_test = inner_is_test
                    if self.peek_kind() == TOK_FN {
                        self.parse_function(mod_name.as_ptr() as str)
                    } else if self.peek_kind() == TOK_STRUCT || self.peek_kind() == TOK_ACTOR || str_eq(self.peek_text(), "actor") || self.peek_kind() == TOK_EFFECT || str_eq(self.peek_text(), "effect") {
                        self.parse_struct()
                    } else if str_eq(self.peek_text(), "import") {
                        self.advance()
                        while self.peek_kind() != TOK_SEMI && self.peek_kind() != TOK_EOF {
                            self.advance()
                        }
                        self.match_tok(TOK_SEMI)
                    } else {
                        self.advance()
                    }
                }
                self.expect_tok(TOK_RBRACE, "}")
            } else if self.peek_kind() != TOK_SEMI {
                let err_line = self.cur_tok_line()
                let err_col = self.cur_tok_col()
                var err = String.new()
                err.push_str("expected top-level item ('fn', 'struct', 'actor', 'trait', 'impl', 'enum', 'const', 'import', 'mod'), found '")
                err.push_str(self.peek_text())
                err.push_str("'")
                self.report_error("E0012", err.as_ptr() as str, err_line, err_col)
                self.synchronize_item()
            } else {
                self.advance()
            }

            if self.error_count >= 25i64 {
                break
            }

            if self.pos == start_pos {
                self.advance()
            }
        }
    }
}
