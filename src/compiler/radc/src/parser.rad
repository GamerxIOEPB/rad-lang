// ==============================================================================
// radc/src/parser.rad — Pratt Recursive Descent Parser
// ==============================================================================

struct Parser {
    tokens: Vec<Token>,
    pos: usize,
    exprs: Vec<Expr>,
    stmts: Vec<Stmt>,
    functions: Vec<FunctionDef>,
    structs: Vec<StructDef>,
    enum_names: Vec<String>,
    traits: Vec<TraitDef>,
    trait_impls: Vec<TraitImplDef>,
    const_names: Vec<String>,
    const_values: Vec<i64>,
    type_alias_names: Vec<String>,
    type_alias_targets: Vec<String>,
    filename: String,
    error_count: i64,
    source: String,
    source_files: Vec<SourceFile>,
    expr_source_ids: Vec<usize>,
    stmt_source_ids: Vec<usize>,
    current_source_id: usize,
    moved_vars: Vec<String>,
    imported_modules: Vec<String>,
    diagnostics: Vec<Diagnostic>,
    color_mode: i32,      // 0 = auto, 1 = always, 2 = never
    json_format: bool,
    test_mode: bool,
    cur_is_test: bool,
    cur_is_async: bool,
    extra_stmts: Vec<usize>,
    tup_tmp_counter: i64,
    lambda_counter: i64,
    enum_variant_ctors: Vec<String>,
    enum_variant_arities: Vec<i64>,
}

fn json_escape_str(s: str) -> String {
    var res = String.new()
    if (s as usize) == 0usize {
        res.push_byte(0u8)
        return res
    }
    let p: *raw u8 = s as *raw u8
    var i = 0usize
    let len = str_len(s)
    while i < len {
        let b = p[i]
        if b == 34u8 { // '"'
            res.push_byte(92u8)
            res.push_byte(34u8)
        } else if b == 92u8 { // '\\'
            res.push_byte(92u8)
            res.push_byte(92u8)
        } else if b == 10u8 { // '\n'
            res.push_byte(92u8)
            res.push_byte(110u8)
        } else if b == 13u8 { // '\r'
            res.push_byte(92u8)
            res.push_byte(114u8)
        } else if b == 9u8 { // '\t'
            res.push_byte(92u8)
            res.push_byte(116u8)
        } else {
            res.push_byte(b)
        }
        i = i + 1usize
    }
    res.push_byte(0u8)
    return res
}

fn get_source_line(source: String, target_line: i64) -> String {
    var res = String.new()
    let p = source.as_ptr()
    let len = source.len()
    var cur_line = 1i64
    var i = 0usize
    while i < len && cur_line < target_line {
        if p[i] == 10u8 {
            cur_line = cur_line + 1i64
        }
        i = i + 1usize
    }
    if cur_line == target_line {
        while i < len && p[i] != 10u8 && p[i] != 13u8 {
            res.push_byte(p[i])
            i = i + 1usize
        }
    }
    res.push_byte(0u8)
    return res
}

fn levenshtein_dist(a: str, b: str) -> i32 {
    let la = str_len(a)
    let lb = str_len(b)
    if la == 0usize { return lb as i32 }
    if lb == 0usize { return la as i32 }
    if lb > 64usize || la > 64usize { return 999i32 }
    let v0 = malloc(65usize * 4usize) as *raw var i32
    let v1 = malloc(65usize * 4usize) as *raw var i32
    let pa = a as *raw u8
    let pb = b as *raw u8
    var j = 0usize
    while j <= lb {
        v0[j] = j as i32
        j = j + 1usize
    }
    var i = 0usize
    while i < la {
        v1[0] = (i + 1usize) as i32
        j = 0usize
        while j < lb {
            var cost = 1i32
            if pa[i] == pb[j] {
                cost = 0i32
            }
            let del_cost = v0[j + 1usize] + 1i32
            let ins_cost = v1[j] + 1i32
            let sub_cost = v0[j] + cost
            var min_val = del_cost
            if ins_cost < min_val {
                min_val = ins_cost
            }
            if sub_cost < min_val {
                min_val = sub_cost
            }
            v1[j + 1usize] = min_val
            j = j + 1usize
        }
        j = 0usize
        while j <= lb {
            v0[j] = v1[j]
            j = j + 1usize
        }
        i = i + 1usize
    }
    let res = v0[lb]
    free(v0 as *raw var u8)
    free(v1 as *raw var u8)
    return res
}

fn is_name_similar(target: str, cand: str) -> bool {
    let lt = str_len(target)
    let lc = str_len(cand)
    if lt == 0usize || lc == 0usize { return false }
    if str_eq(target, cand) { return false }
    var diff = 0i32
    if lt > lc {
        diff = (lt - lc) as i32
    } else {
        diff = (lc - lt) as i32
    }
    if diff > 2i32 { return false }
    let d = levenshtein_dist(target, cand)
    if lt <= 3usize {
        return d == 1i32
    }
    return d <= 2i32
}

impl Parser {
    fn add_type_alias(var self, name: String, target: String) {
        var i = 0usize
        while i < self.type_alias_names.len {
            if str_eq(self.type_alias_names.ptr[i].as_ptr() as str, name.as_ptr() as str) {
                self.type_alias_targets.ptr[i] = target
                return
            }
            i = i + 1usize
        }
        self.type_alias_names.push(name)
        self.type_alias_targets.push(target)
    }

    fn resolve_type_alias(self, ty: str) -> str {
        var cur = ty
        var iter = 0usize
        while iter < 16usize {
            var found = false
            var i = 0usize
            while i < self.type_alias_names.len {
                if str_eq(self.type_alias_names.ptr[i].as_ptr() as str, cur) {
                    cur = self.type_alias_targets.ptr[i].as_ptr() as str
                    found = true
                    break
                }
                i = i + 1usize
            }
            if !found {
                return cur
            }
            iter = iter + 1usize
        }
        return cur
    }

    fn is_stmt_start_token(self, k: i32) -> bool {
        if k == TOK_LET || k == TOK_VAR || k == TOK_IF || k == TOK_WHILE || k == TOK_LOOP || k == TOK_FOR || k == TOK_RETURN || k == TOK_MATCH || k == TOK_BREAK || k == TOK_CONTINUE || k == TOK_HANDLE || k == TOK_PERFORM {
            return true
        }
        return false
    }

    fn synchronize_stmt(var self) {
        while self.peek_kind() != TOK_EOF && self.peek_kind() != TOK_RBRACE {
            let k = self.peek_kind()
            if k == TOK_SEMI {
                self.advance()
                return
            }
            if self.is_stmt_start_token(k) {
                return
            }
            self.advance()
        }
    }

    fn synchronize_item(var self) {
        while self.peek_kind() != TOK_EOF {
            let k = self.peek_kind()
            if k == TOK_FN || k == TOK_STRUCT || k == TOK_ACTOR || k == TOK_ENUM || k == TOK_ASYNC || k == TOK_EFFECT {
                return
            }
            let txt = self.peek_text()
            if str_eq(txt, "impl") || str_eq(txt, "trait") || str_eq(txt, "const") || str_eq(txt, "import") || str_eq(txt, "mod") || str_eq(txt, "extern") || str_eq(txt, "async") || str_eq(txt, "actor") || str_eq(txt, "effect") {
                return
            }
            if k == TOK_SEMI || k == TOK_RBRACE {
                self.advance()
                return
            }
            self.advance()
        }
    }

    fn cur_tok_len(self) -> i64 {
        if self.pos < self.tokens.len {
            let l = self.tokens.ptr[self.pos].len
            if l > 0i64 {
                return l
            }
        }
        return 1i64
    }

    fn check_lex_error(var self) -> bool {
        if self.peek_kind() == TOK_ERROR {
            let msg = self.peek_text()
            var code = "E0001"
            var desc = ""
            desc = msg
            if str_starts_with(msg, "E0001") {
                code = "E0001"
                if str_len(msg) > 7usize {
                    desc = (msg as usize + 7usize) as str
                }
            } else if str_starts_with(msg, "E0002") {
                code = "E0002"
                desc = "unterminated string literal"
            } else if str_starts_with(msg, "E0003") {
                code = "E0003"
                desc = "unterminated character literal"
            } else if str_starts_with(msg, "E0004") {
                code = "E0004"
                desc = "unterminated block comment"
            } else if str_starts_with(msg, "E0005") {
                code = "E0005"
                desc = "invalid hex escape sequence"
            }
            self.report_error_span(code, desc, self.cur_tok_line(), self.cur_tok_col(), self.cur_tok_len())
            self.advance()
            return true
        }
        return false
    }

    fn report_error_span(var self, err_code: str, err_msg: str, line: i64, col: i64, span_len: i64) {
        self.error_count = self.error_count + 1i64
        var actual_span = span_len
        if actual_span <= 0i64 {
            actual_span = 1i64
        }

        var line_str = String.new()
        if self.source.len() > 0usize && line > 0i64 {
            line_str = get_source_line(self.source, line)
        }

        let diag = Diagnostic {
            code: String.from_str(err_code),
            severity: String.from_str("error"),
            message: String.from_str(err_msg),
            file: self.filename,
            line: line,
            col: col,
            end_line: line,
            end_col: col + actual_span,
            source_line: line_str,
            help: String.new(),
        }
        self.diagnostics.push(diag)

        if self.json_format {
            var j = String.new()
            j.push_str("{\"code\":\"")
            j.push_str(err_code)
            j.push_str("\",\"severity\":\"error\",\"message\":\"")
            j.push_str(json_escape_str(err_msg).as_ptr() as str)
            j.push_str("\",\"file\":\"")
            j.push_str(json_escape_str(self.filename.as_ptr() as str).as_ptr() as str)
            j.push_str("\",\"line\":")
            j.push_str(int_to_str(line as i32).as_ptr() as str)
            j.push_str(",\"col\":")
            j.push_str(int_to_str(col as i32).as_ptr() as str)
            j.push_str(",\"end_line\":")
            j.push_str(int_to_str(line as i32).as_ptr() as str)
            j.push_str(",\"end_col\":")
            j.push_str(int_to_str((col + actual_span) as i32).as_ptr() as str)
            j.push_str(",\"source_line\":\"")
            j.push_str(json_escape_str(line_str.as_ptr() as str).as_ptr() as str)
            j.push_str("\",\"help\":\"\"}")
            println(j.as_ptr() as str)
            return
        }

        var use_color = false
        if self.color_mode == 1 {
            use_color = true
        } else if self.color_mode == 0 {
            let no_col = getenv("NO_COLOR")
            if (no_col as usize) == 0usize || str_len(no_col) == 0usize {
                if isatty(2) != 0 {
                    use_color = true
                }
            }
        }

        if use_color {
            var line1 = String.new()
            line1.push_str("\x1b[1;31merror[")
            line1.push_str(err_code)
            line1.push_str("]\x1b[0m\x1b[1m: ")
            line1.push_str(err_msg)
            line1.push_str("\x1b[0m")
            println(line1.as_ptr() as str)

            var line2 = String.new()
            line2.push_str("\x1b[1;34m  --> \x1b[0m")
            line2.push_str(self.filename.as_ptr() as str)
            line2.push_str(":")
            line2.push_str(int_to_str(line as i32).as_ptr() as str)
            line2.push_str(":")
            line2.push_str(int_to_str(col as i32).as_ptr() as str)
            println(line2.as_ptr() as str)

            if line_str.len() > 0usize {
                let l_num = int_to_str(line as i32)
                println("\x1b[1;34m   |\x1b[0m")
                var line3 = String.new()
                line3.push_str("\x1b[1;34m")
                line3.push_str(l_num.as_ptr() as str)
                line3.push_str(" | \x1b[0m")
                line3.push_str(line_str.as_ptr() as str)
                println(line3.as_ptr() as str)

                var line4 = String.new()
                line4.push_str("\x1b[1;34m   | \x1b[0m")
                var ci = 1i64
                while ci < col {
                    line4.push_byte(32u8) // ' '
                    ci = ci + 1i64
                }
                line4.push_str("\x1b[1;31m")
                var c_span = 0i64
                while c_span < actual_span {
                    line4.push_byte(94u8) // '^'
                    c_span = c_span + 1i64
                }
                line4.push_str("\x1b[0m")
                println(line4.as_ptr() as str)
            }
        } else {
            var line1 = String.new()
            line1.push_str("error[")
            line1.push_str(err_code)
            line1.push_str("]: ")
            line1.push_str(err_msg)
            println(line1.as_ptr() as str)

            var line2 = String.new()
            line2.push_str("  --> ")
            line2.push_str(self.filename.as_ptr() as str)
            line2.push_str(":")
            line2.push_str(int_to_str(line as i32).as_ptr() as str)
            line2.push_str(":")
            line2.push_str(int_to_str(col as i32).as_ptr() as str)
            println(line2.as_ptr() as str)

            if line_str.len() > 0usize {
                let l_num = int_to_str(line as i32)
                println("   |")
                var line3 = String.new()
                line3.push_str(l_num.as_ptr() as str)
                line3.push_str(" | ")
                line3.push_str(line_str.as_ptr() as str)
                println(line3.as_ptr() as str)

                var line4 = String.new()
                line4.push_str("   | ")
                var ci = 1i64
                while ci < col {
                    line4.push_byte(32u8) // ' '
                    ci = ci + 1i64
                }
                var c_span = 0i64
                while c_span < actual_span {
                    line4.push_byte(94u8) // '^'
                    c_span = c_span + 1i64
                }
                line4.push_byte(0u8)
                println(line4.as_ptr() as str)
            }
        }
    }

    fn report_warning_span(var self, warn_code: str, warn_msg: str, line: i64, col: i64, span_len: i64) {
        var actual_span = span_len
        if actual_span <= 0i64 {
            actual_span = 1i64
        }

        var line_str = String.new()
        if self.source.len() > 0usize && line > 0i64 {
            line_str = get_source_line(self.source, line)
        }

        let diag = Diagnostic {
            code: String.from_str(warn_code),
            severity: String.from_str("warning"),
            message: String.from_str(warn_msg),
            file: self.filename,
            line: line,
            col: col,
            end_line: line,
            end_col: col + actual_span,
