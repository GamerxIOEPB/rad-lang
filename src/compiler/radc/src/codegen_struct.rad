// radc/src/codegen_struct.rad - Struct & Field Resolution Pass
import util;
import token;
import ast;
import parser;

impl Codegen {
    fn get_expr_struct_name(self, expr_id: usize) -> str {
        if expr_id == 0usize || expr_id >= self.parser.exprs.len {
            return ""
        }
        let ep = self.parser.exprs.ptr
        let k = ep[expr_id].kind
        if k == EXPR_FSTRING {
            return "String"
        }
        if k == EXPR_IDENT {
            let vname = ep[expr_id].str_val.as_ptr() as str
            if str_eq(vname, "Option") || str_eq(vname, "Result") || self.is_struct_name(vname) {
                return vname
            }
            let raw = self.get_raw_var_type(vname)
            if str_starts_with(raw, "*") || str_starts_with(raw, "&") || str_starts_with(raw, "raw ") || str_starts_with(raw, "var ") {
                return self.clean_type_name(raw)
            }
            return raw
        }
        if k == EXPR_FIELD_ACCESS {
            let recv_id = ep[expr_id].left
            let parent_struct = self.get_expr_struct_name(recv_id)
            let fname = ep[expr_id].field_name.as_ptr() as str
            if str_eq(parent_struct, "Option") && str_eq(fname, "None") {
                return "Option"
            }
            if str_starts_with(parent_struct, "Vec<") && str_eq(fname, "ptr") {
                return ""
            }
            if str_len(parent_struct) > 0usize {
                var si = 0usize
                while si < self.parser.structs.len {
                    let sdef = self.parser.structs.ptr[si]
                    if self.match_struct_name(sdef.struct_name.as_ptr() as str, parent_struct) {
                        var fi = 0usize
                        while fi < sdef.field_names.len {
                            if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, fname) {
                                let fty = sdef.field_types.ptr[fi].as_ptr() as str
                                if str_starts_with(fty, "Vec<") {
                                    return fty
                                }
                                return self.clean_type_name(fty)
                            }
                            fi = fi + 1usize
                        }
                    }
                    si = si + 1usize
                }
            }
        }
        if k == EXPR_METHOD_CALL {
            let recv_id = ep[expr_id].left
            let member = ep[expr_id].str_val.as_ptr() as str
            var parent_struct = self.get_expr_struct_name(recv_id)
            if str_len(parent_struct) == 0usize && ep[recv_id].kind == EXPR_IDENT {
                parent_struct = self.get_raw_var_type(ep[recv_id].str_val.as_ptr() as str)
            }
            if str_starts_with(parent_struct, "Option<") {
                let clean_m = self.clean_type_name(member)
                if !str_eq(clean_m, "unwrap") && !str_eq(clean_m, "unwrap_or") && !str_eq(clean_m, "is_some") && !str_eq(clean_m, "is_none") && !str_eq(clean_m, "ok_or") && !str_eq(clean_m, "expect") {
                    let plen = str_len(parent_struct)
                    if plen > 8usize {
                        var inner = String.new()
                        let cp = parent_struct as *raw u8
                        var ci = 7usize
                        while ci < plen && cp[ci] != 62u8 {
                            inner.push_byte(cp[ci])
                            ci = ci + 1usize
                        }
                        inner.push_byte(0u8)
                        parent_struct = inner.as_ptr() as str
                    }
                }
            }
            if str_starts_with(parent_struct, "dyn ") {
                let trait_name = (parent_struct as usize + 4usize) as str
                var ti = 0usize
                while ti < self.parser.traits.len {
                    if str_eq(self.parser.traits.ptr[ti].trait_name.as_ptr() as str, trait_name) {
                        var mi = 0usize
                        while mi < self.parser.traits.ptr[ti].methods.len {
                            if str_eq(self.parser.traits.ptr[ti].methods.ptr[mi].method_name.as_ptr() as str, member) {
                                return self.clean_type_name(self.parser.traits.ptr[ti].methods.ptr[mi].ret_type.as_ptr() as str)
                            }
                            mi = mi + 1usize
                        }
                    }
                    ti = ti + 1usize
                }
            }
            let clean_m = self.clean_type_name(member)
            if (str_eq(clean_m, "get") || str_eq(clean_m, "pop")) && (str_eq(parent_struct, "Vec") || str_starts_with(parent_struct, "Vec<")) {
                if str_starts_with(parent_struct, "Vec<") {
                    let plen = str_len(parent_struct)
                    if plen > 5usize {
                        var opt_t = String.new()
                        opt_t.push_str("Option<")
                        let cp = parent_struct as *raw u8
                        var ci = 4usize
                        while ci < plen && cp[ci] != 62u8 {
                            opt_t.push_byte(cp[ci])
                            ci = ci + 1usize
                        }
                        opt_t.push_byte(62u8) // '>'
                        opt_t.push_byte(0u8)
                        return opt_t.as_ptr() as str
                    }
                }
                return "Option"
            }
            if str_len(parent_struct) > 0usize {
                var mangled = String.new()
                mangled.push_str(parent_struct)
                mangled.push_str("__")
                mangled.push_str(clean_m)
                mangled.push_byte(0u8)
                let m_name = mangled.as_ptr() as str
                var fi = 0usize
                while fi < self.parser.functions.len {
                    if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, m_name) {
                        return self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                    }
                    fi = fi + 1usize
                }
                let base_ty = self.clean_type_name(parent_struct)
                if !str_eq(base_ty, parent_struct) && str_len(base_ty) > 0usize {
                    var bm = String.new()
                    bm.push_str(base_ty)
                    bm.push_str("__")
                    bm.push_str(clean_m)
                    bm.push_byte(0u8)
                    let bm_name = bm.as_ptr() as str
                    fi = 0usize
                    while fi < self.parser.functions.len {
                        if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, bm_name) {
                            return self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                        }
                        fi = fi + 1usize
                    }
                }
            }
            var fi = 0usize
            while fi < self.parser.functions.len {
                if str_eq(self.parser.functions.ptr[fi].fn_name.as_ptr() as str, member) {
                    return self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                }
                fi = fi + 1usize
            }
        }
        if k == EXPR_CALL {
            let callee_id = ep[expr_id].left
            if ep[callee_id].kind == EXPR_IDENT {
                let cname = ep[callee_id].str_val.as_ptr() as str
                if str_eq(cname, "Some") || str_eq(cname, "None") {
                    return "Option"
                }
                if str_eq(cname, "Ok") || str_eq(cname, "Err") {
                    return "Result"
                }
                if self.is_struct_name(cname) {
                    return cname
                }
                let resolved_cname = self.resolve_function_name(cname, 0usize)
                var fi = 0usize
                while fi < self.parser.functions.len {
                    let fn_s = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
                    if str_eq(fn_s, cname) || str_eq(fn_s, resolved_cname) {
                        return self.parser.functions.ptr[fi].ret_type.as_ptr() as str
                    }
                    fi = fi + 1usize
                }
            }
        }
        if k == EXPR_CAST {
            return self.clean_type_name(ep[expr_id].target_type.as_ptr() as str)
        }
        if k == EXPR_INDEX {
            let coll_id = ep[expr_id].left
            var coll_ty = ""
            if ep[coll_id].kind == EXPR_FIELD_ACCESS && str_eq(ep[coll_id].field_name.as_ptr() as str, "ptr") {
                coll_ty = self.get_expr_struct_name(ep[coll_id].left)
            } else {
                coll_ty = self.get_expr_struct_name(coll_id)
            }
            if str_len(coll_ty) == 0usize && ep[coll_id].kind == EXPR_IDENT {
                coll_ty = self.get_raw_var_type(ep[coll_id].str_val.as_ptr() as str)
            }
            if str_starts_with(coll_ty, "Vec<") {
                let plen = str_len(coll_ty)
                if plen > 5usize {
                    var inner = String.new()
                    let cp = coll_ty as *raw u8
                    var ci = 4usize
                    var depth = 1
                    while ci < plen && depth > 0 {
                        if cp[ci] == 60u8 {
                            depth = depth + 1
                        } else if cp[ci] == 62u8 {
                            depth = depth - 1
                        }
                        if depth > 0 {
                            inner.push_byte(cp[ci])
                        }
                        ci = ci + 1usize
                    }
                    inner.push_byte(0u8)
                    return inner.as_ptr() as str
                }
            } else if str_starts_with(coll_ty, "[]") {
                return (coll_ty as usize + 2usize) as str
            } else if str_len(coll_ty) > 0usize && self.is_struct_name(coll_ty) {
                return coll_ty
            }
        }
        if k == EXPR_TRY || k == EXPR_AWAIT {
            return self.get_expr_struct_name(ep[expr_id].left)
        }
        return ""
    }

    fn get_monomorphized_field_type(self, sdef: StructDef, s_type: str, fi: usize) -> str {
        if fi >= sdef.field_types.len {
            return ""
        }
        let raw_fty = sdef.field_types.ptr[fi].as_ptr() as str
        if !str_contains(s_type, "<") {
            return raw_fty
        }
        let p = s_type as *raw u8
        let slen = str_len(s_type)
        var start_lt = 0usize
        while start_lt < slen && p[start_lt] != 60u8 { // '<'
            start_lt = start_lt + 1usize
        }
        if start_lt >= slen {
            return raw_fty
        }
        start_lt = start_lt + 1usize
        var cur_arg = String.new()
        var arg_idx = 0usize
        var depth = 0i64
        var pos = start_lt
        while pos < slen {
            let b = p[pos]
            if b == 60u8 { // '<'
                depth = depth + 1i64
                cur_arg.push_byte(b)
            } else if b == 62u8 { // '>'
                if depth == 0i64 {
                    if arg_idx == fi {
                        cur_arg.push_byte(0u8)
                        return cur_arg.as_ptr() as str
                    }
                    break
                } else {
                    depth = depth - 1i64
                    cur_arg.push_byte(b)
                }
            } else if b == 44u8 && depth == 0i64 { // ','
                if arg_idx == fi {
                    cur_arg.push_byte(0u8)
                    return cur_arg.as_ptr() as str
                }
                arg_idx = arg_idx + 1usize
                cur_arg = String.new()
            } else if b != 32u8 || cur_arg.len() > 0usize {
                cur_arg.push_byte(b)
            }
            pos = pos + 1usize
        }
        return raw_fty
    }

    fn match_struct_name(self, sdef_name: str, target: str) -> bool {
        if str_eq(sdef_name, target) {
            return true
        }
        let t_len = str_len(target)
        let s_len = str_len(sdef_name)
        if t_len > s_len {
            let b = (target as *raw u8)[s_len]
            if (b == 60u8 || b == 32u8) && str_starts_with(target, sdef_name) {
                return true
            }
        }
        return false
    }

    fn is_struct_name(self, name: str) -> bool {
        let resolved = self.resolve_type_alias(name)
        if str_starts_with(resolved, "dyn ") {
            return true
        }
        var si = 0usize
        while si < self.parser.structs.len {
            if self.match_struct_name(self.parser.structs.ptr[si].struct_name.as_ptr() as str, resolved) {
                return true
            }
            si = si + 1usize
        }
        return false
    }

    fn get_struct_field_idx(self, field_name: str) -> i64 {
        if str_eq(field_name, "kind") { return 0i64 }
        if str_eq(field_name, "ptr") { return 0i64 }
        if str_eq(field_name, "cap") { return 1i64 }
        if str_eq(field_name, "len") { return 2i64 }

        // Token
        if str_eq(field_name, "text") { return 1i64 }
        if str_eq(field_name, "int_val") { return 2i64 }
        if str_eq(field_name, "line") { return 3i64 }
        if str_eq(field_name, "col") { return 4i64 }
        if str_eq(field_name, "len") { return 5i64 }

        // Expr
        if str_eq(field_name, "op") { return 1i64 }
        if str_eq(field_name, "int_val") { return 2i64 }
        if str_eq(field_name, "str_val") { return 3i64 }
        if str_eq(field_name, "target_type") { return 4i64 }
        if str_eq(field_name, "left") { return 5i64 }
        if str_eq(field_name, "right") { return 6i64 }
        if str_eq(field_name, "args") { return 7i64 }
        if str_eq(field_name, "field_name") { return 8i64 }
        if str_eq(field_name, "expr_line") { return 9i64 }
        if str_eq(field_name, "expr_col") { return 10i64 }

        // Stmt
        if str_eq(field_name, "name") { return 1i64 }
        if str_eq(field_name, "type_name") { return 2i64 }
        if str_eq(field_name, "expr_id") { return 3i64 }
        if str_eq(field_name, "index_expr") { return 4i64 }
        if str_eq(field_name, "then_stmts") { return 5i64 }
        if str_eq(field_name, "else_stmts") { return 6i64 }
        if str_eq(field_name, "body_stmts") { return 7i64 }
        if str_eq(field_name, "stmt_line") { return 8i64 }
        if str_eq(field_name, "stmt_col") { return 9i64 }

        // FunctionDef
        if str_eq(field_name, "fn_name") { return 0i64 }
        if str_eq(field_name, "param_names") { return 1i64 }
        if str_eq(field_name, "param_types") { return 2i64 }
        if str_eq(field_name, "ret_type") { return 3i64 }
        if str_eq(field_name, "body") { return 4i64 }
        if str_eq(field_name, "is_test") { return 5i64 }
        if str_eq(field_name, "is_async") { return 6i64 }

        // TraitMethodDef
        if str_eq(field_name, "method_name") { return 0i64 }

        // TraitDef
        if str_eq(field_name, "trait_name") { return 0i64 }
        if str_eq(field_name, "methods") { return 1i64 }

        // TraitImplDef
        if str_eq(field_name, "target_struct_name") { return 1i64 }

        // StructDef
        if str_eq(field_name, "struct_name") { return 0i64 }
        if str_eq(field_name, "field_names") { return 1i64 }
        if str_eq(field_name, "field_types") { return 2i64 }

        // Parser
        if str_eq(field_name, "tokens") { return 0i64 }
        if str_eq(field_name, "pos") { return 1i64 }
        if str_eq(field_name, "exprs") { return 2i64 }
        if str_eq(field_name, "stmts") { return 3i64 }
        if str_eq(field_name, "functions") { return 4i64 }
        if str_eq(field_name, "structs") { return 5i64 }
        if str_eq(field_name, "traits") { return 6i64 }
        if str_eq(field_name, "trait_impls") { return 7i64 }
        if str_eq(field_name, "const_names") { return 8i64 }
        if str_eq(field_name, "const_values") { return 9i64 }
        if str_eq(field_name, "filename") { return 10i64 }
        if str_eq(field_name, "error_count") { return 11i64 }
        if str_eq(field_name, "source") { return 12i64 }
        if str_eq(field_name, "source_files") { return 13i64 }
        if str_eq(field_name, "expr_source_ids") { return 14i64 }
        if str_eq(field_name, "stmt_source_ids") { return 15i64 }
        if str_eq(field_name, "current_source_id") { return 16i64 }
        if str_eq(field_name, "moved_vars") { return 17i64 }
        if str_eq(field_name, "imported_modules") { return 18i64 }
        if str_eq(field_name, "diagnostics") { return 19i64 }
        if str_eq(field_name, "color_mode") { return 20i64 }
        if str_eq(field_name, "json_format") { return 21i64 }
        if str_eq(field_name, "test_mode") { return 22i64 }
        if str_eq(field_name, "cur_is_test") { return 23i64 }
        if str_eq(field_name, "cur_is_async") { return 24i64 }

        // SourceFile
        if str_eq(field_name, "file_path") { return 0i64 }
        if str_eq(field_name, "file_text") { return 1i64 }

        // StringEntry
        if str_eq(field_name, "content") { return 0i64 }
        if str_eq(field_name, "byte_len") { return 1i64 }

        // DeferThunkMeta
        if str_eq(field_name, "stmt_id") { return 0i64 }
        if str_eq(field_name, "cap_vars") { return 1i64 }

        // Codegen
        if str_eq(field_name, "parser") { return 0i64 }
        if str_eq(field_name, "target") { return 1i64 }
        if str_eq(field_name, "ir") { return 2i64 }
        if str_eq(field_name, "fn_allocas") { return 3i64 }
        if str_eq(field_name, "allocated_vars") { return 4i64 }
        if str_eq(field_name, "ssa_counter") { return 5i64 }
        if str_eq(field_name, "label_counter") { return 6i64 }
        if str_eq(field_name, "strings") { return 7i64 }
        if str_eq(field_name, "current_ret_type") { return 8i64 }
        if str_eq(field_name, "loop_cond_labels") { return 9i64 }
        if str_eq(field_name, "loop_end_labels") { return 10i64 }
        if str_eq(field_name, "loop_drop_stack") { return 11i64 }
        if str_eq(field_name, "loop_defer_stack") { return 12i64 }
        if str_eq(field_name, "current_func_idx") { return 13i64 }
        if str_eq(field_name, "active_defers") { return 14i64 }
        if str_eq(field_name, "active_drops_var") { return 15i64 }
        if str_eq(field_name, "active_drops_type") { return 16i64 }
        if str_eq(field_name, "debug_info") { return 17i64 }
        if str_eq(field_name, "source_file") { return 18i64 }
        if str_eq(field_name, "fn_defer_metas") { return 19i64 }
        if str_eq(field_name, "pending_defer_thunks") { return 20i64 }
        if str_eq(field_name, "closure_metas") { return 21i64 }

        // CompilerOptions
        if str_eq(field_name, "input_paths") { return 0i64 }
        if str_eq(field_name, "extra_objects") { return 1i64 }
        if str_eq(field_name, "output_path") { return 2i64 }
        if str_eq(field_name, "emit_llvm") { return 3i64 }
        if str_eq(field_name, "check_only") { return 4i64 }
        if str_eq(field_name, "opt_level") { return 5i64 }
        if str_eq(field_name, "target_triple") { return 6i64 }
        if str_eq(field_name, "linker_cmd") { return 7i64 }
        if str_eq(field_name, "show_version") { return 8i64 }
        if str_eq(field_name, "compile_only") { return 9i64 }
        if str_eq(field_name, "cli_color_mode") { return 10i64 }
        if str_eq(field_name, "cli_json_format") { return 11i64 }
        if str_eq(field_name, "test_mode") { return 12i64 }

        var si = 0usize
        while si < self.parser.structs.len {
            let sdef = self.parser.structs.ptr[si]
            var fi = 0usize
            while fi < sdef.field_names.len {
                if str_eq(sdef.field_names.ptr[fi].as_ptr() as str, field_name) {
                    return fi as i64
                }
                fi = fi + 1usize
            }
            si = si + 1usize
        }
        return -1i64
    }

    fn find_similar_ident(self, target: str) -> str {
        var best_cand = ""
        var best_dist = 999i32
        var vi = 0usize
        while vi < self.allocated_vars.len {
            let cand = self.allocated_vars.ptr[vi].as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            vi = vi + 1usize
        }
        if self.current_func_idx < self.parser.functions.len {
            let cur_fn = self.parser.functions.ptr[self.current_func_idx]
            var pi = 0usize
            while pi < cur_fn.param_names.len {
                let cand = cur_fn.param_names.ptr[pi].as_ptr() as str
                if is_name_similar(target, cand) {
                    let d = levenshtein_dist(target, cand)
                    if d < best_dist {
                        best_dist = d
                        best_cand = cand
                    }
                }
                pi = pi + 1usize
            }
        }
        var fi = 0usize
        while fi < self.parser.functions.len {
            let cand = self.parser.functions.ptr[fi].fn_name.as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            fi = fi + 1usize
        }
        var ci = 0usize
        while ci < self.parser.const_names.len {
            let cand = self.parser.const_names.ptr[ci].as_ptr() as str
            if is_name_similar(target, cand) {
                let d = levenshtein_dist(target, cand)
                if d < best_dist {
                    best_dist = d
                    best_cand = cand
                }
            }
            ci = ci + 1usize
        }
        if is_name_similar(target, "println") && 1i32 < best_dist { best_cand = "println"; best_dist = 1i32 }
        if is_name_similar(target, "print") && 1i32 < best_dist { best_cand = "print"; best_dist = 1i32 }
        if is_name_similar(target, "eprintln") && 1i32 < best_dist { best_cand = "eprintln"; best_dist = 1i32 }
        if is_name_similar(target, "panic") && 1i32 < best_dist { best_cand = "panic"; best_dist = 1i32 }
        if is_name_similar(target, "assert") && 1i32 < best_dist { best_cand = "assert"; best_dist = 1i32 }
        return best_cand
    }

    fn find_similar_field(self, fname: str, s_type: str) -> str {
        var best_cand = ""
        var best_dist = 999i32
        if str_len(s_type) > 0usize {
            var si = 0usize
            while si < self.parser.structs.len {
                let sdef = self.parser.structs.ptr[si]
                if self.match_struct_name(sdef.struct_name.as_ptr() as str, s_type) {
                    var fld_i = 0usize
                    while fld_i < sdef.field_names.len {
                        let cand = sdef.field_names.ptr[fld_i].as_ptr() as str
                        if is_name_similar(fname, cand) {
                            let d = levenshtein_dist(fname, cand)
                            if d < best_dist {
                                best_dist = d
                                best_cand = cand
                            }
                        }
                        fld_i = fld_i + 1usize
                    }
                    break
                }
                si = si + 1usize
            }
        }
        return best_cand
    }

}
