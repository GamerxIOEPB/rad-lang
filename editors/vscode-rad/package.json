{
  "name": "rad-utils",
  "displayName": "Rad Utils",
  "description": "Official Rad language support: real-time diagnostics, LSP code completion, go-to-definition, hover, outline, formatting, and syntax highlighting.",
  "version": "0.2.3",
  "publisher": "rad-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/rad-lang/rad"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "rad",
    "systems",
    "compiler",
    "lsp",
    "formatter",
    "rad-utils"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:rad",
    "onCommand:rad.restartLsp",
    "onCommand:rad.showVersion",
    "onCommand:rad.formatFile"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rad",
        "aliases": [
          "Rad",
          "rad"
        ],
        "extensions": [
          ".rad"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rad",
        "scopeName": "source.rad",
        "path": "./syntaxes/rad.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rad",
        "path": "./snippets/rad.json"
      }
    ],
    "commands": [
      {
        "command": "rad.restartLsp",
        "title": "Rad: Restart Language Server"
      },
      {
        "command": "rad.showVersion",
        "title": "Rad: Show Toolchain Version"
      },
      {
        "command": "rad.formatFile",
        "title": "Rad: Format Document"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Rad Configuration",
      "properties": {
        "rad.lsp.path": {
          "type": "string",
          "default": "rad",
          "description": "Path to the `rad` binary executable."
        },
        "rad.lsp.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the rad binary to start the language server."
        },
        "rad.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Rad language server."
        },
        "rad.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable native Rad document formatting via `rad fmt`."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vscode-languageclient": "^9.0.1"
  }
}
