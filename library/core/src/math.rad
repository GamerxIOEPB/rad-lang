// Rad Core Library: Math Operations

pub fn min(a: i64, b: i64) -> i64 {
    if a < b {
        a
    } else {
        b
    }
}

pub fn max(a: i64, b: i64) -> i64 {
    if a > b {
        a
    } else {
        b
    }
}

pub fn abs(x: i64) -> i64 {
    if x < 0 {
        -x
    } else {
        x
    }
}

pub fn clamp(val: i64, min_val: i64, max_val: i64) -> i64 {
    if val < min_val {
        min_val
    } else if val > max_val {
        max_val
    } else {
        val
    }
}
