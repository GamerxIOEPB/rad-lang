// Rad Core Library: Result<T, E>

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl Result<T, E> {
    pub fn is_ok(res: Result<T, E>) -> bool {
        match res {
            Result.Ok(_) => true,
            Result.Err(_) => false,
        }
    }

    pub fn is_err(res: Result<T, E>) -> bool {
        match res {
            Result.Ok(_) => false,
            Result.Err(_) => true,
        }
    }

    pub fn unwrap_or(res: Result<T, E>, default_val: T) -> T {
        match res {
            Result.Ok(val) => val,
            Result.Err(_) => default_val,
        }
    }
}
