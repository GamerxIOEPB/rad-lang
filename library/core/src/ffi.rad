// Rad Core Library: Foreign Function Interface Types
// Primitive type aliases matching target C ABI definitions.

type c_char = i8
type c_schar = i8
type c_uchar = u8
type c_short = i16
type c_ushort = u16
type c_int = i32
type c_uint = u32
type c_long = i64
type c_ulong = u64
type c_longlong = i64
type c_ulonglong = u64
type c_float = f32
type c_double = f64
type size_t = usize
type ssize_t = isize
type c_void = void
