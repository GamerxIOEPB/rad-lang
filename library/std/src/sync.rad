// Rad Standard Library: Concurrency Primitives and Synchronization

pub fn sched_yield() -> i32
pub fn pthread_create(thread: *raw var u64, attr: *raw var u8, routine: *raw var u8, arg: *raw var u8) -> i32
pub fn pthread_join(thread: u64, retval: *raw var u8) -> i32
pub fn pthread_mutex_init(mutex: *raw var u8, attr: *raw var u8) -> i32
pub fn pthread_mutex_lock(mutex: *raw var u8) -> i32
pub fn pthread_mutex_unlock(mutex: *raw var u8) -> i32
pub fn pthread_mutex_destroy(mutex: *raw var u8) -> i32
pub fn pthread_cond_init(cond: *raw var u8, attr: *raw var u8) -> i32
pub fn pthread_cond_wait(cond: *raw var u8, mutex: *raw var u8) -> i32
pub fn pthread_cond_signal(cond: *raw var u8) -> i32
pub fn pthread_cond_broadcast(cond: *raw var u8) -> i32
pub fn pthread_cond_destroy(cond: *raw var u8) -> i32
pub fn pthread_rwlock_init(rwlock: *raw var u8, attr: *raw var u8) -> i32
pub fn pthread_rwlock_rdlock(rwlock: *raw var u8) -> i32
pub fn pthread_rwlock_wrlock(rwlock: *raw var u8) -> i32
pub fn pthread_rwlock_unlock(rwlock: *raw var u8) -> i32
pub fn pthread_rwlock_destroy(rwlock: *raw var u8) -> i32

pub fn atomic_load_i32(ptr: *raw i32) -> i32
pub fn atomic_load_i64(ptr: *raw i64) -> i64
pub fn atomic_store_i32(ptr: *raw var i32, val: i32)
pub fn atomic_store_i64(ptr: *raw var i64, val: i64)
pub fn atomic_fetch_add_i32(ptr: *raw var i32, val: i32) -> i32
pub fn atomic_fetch_add_i64(ptr: *raw var i64, val: i64) -> i64
pub fn atomic_fetch_sub_i32(ptr: *raw var i32, val: i32) -> i32
pub fn atomic_fetch_sub_i64(ptr: *raw var i64, val: i64) -> i64
pub fn atomic_swap_i32(ptr: *raw var i32, val: i32) -> i32
pub fn atomic_swap_i64(ptr: *raw var i64, val: i64) -> i64
pub fn atomic_compare_exchange_i32(ptr: *raw var i32, expected: i32, desired: i32) -> i32
pub fn atomic_compare_exchange_i64(ptr: *raw var i64, expected: i64, desired: i64) -> i64
pub fn atomic_fence()

pub struct AtomicI32 {
    pub ptr: *raw var i32,
}

impl AtomicI32 {
    pub fn new(val: i32) -> AtomicI32 {
        let p = malloc(4usize) as *raw var i32
        atomic_store_i32(p, val)
        AtomicI32 { ptr: p }
    }

    pub fn load(self) -> i32 {
        atomic_load_i32(self.ptr as *raw i32)
    }

    pub fn store(self, val: i32) {
        atomic_store_i32(self.ptr, val)
    }

    pub fn swap(self, val: i32) -> i32 {
        atomic_swap_i32(self.ptr, val)
    }

    pub fn compare_exchange(self, expected: i32, desired: i32) -> i32 {
        atomic_compare_exchange_i32(self.ptr, expected, desired)
    }

    pub fn fetch_add(self, val: i32) -> i32 {
        atomic_fetch_add_i32(self.ptr, val)
    }

    pub fn fetch_sub(self, val: i32) -> i32 {
        atomic_fetch_sub_i32(self.ptr, val)
    }

    pub fn destroy(self) {
        free(self.ptr as *raw var u8)
    }
}

