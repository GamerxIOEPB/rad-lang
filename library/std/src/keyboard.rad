// ==============================================================================
// Rad Standard Library — Native Keyboard Input
// Nonblocking sys_poll reader, escape sequence state machine, Kitty protocol.
// Zero C, zero libc, zero external library dependencies.
// ==============================================================================

pub const KEY_NONE: i32       = 0
pub const KEY_CHAR: i32       = 1
pub const KEY_ENTER: i32      = 2
pub const KEY_BACKSPACE: i32  = 3
pub const KEY_TAB: i32        = 4
pub const KEY_ESC: i32        = 5
pub const KEY_UP: i32         = 6
pub const KEY_DOWN: i32       = 7
pub const KEY_LEFT: i32       = 8
pub const KEY_RIGHT: i32      = 9
pub const KEY_HOME: i32       = 10
pub const KEY_END: i32        = 11
pub const KEY_PAGE_UP: i32    = 12
pub const KEY_PAGE_DOWN: i32  = 13
pub const KEY_INSERT: i32     = 14
pub const KEY_DELETE: i32     = 15
pub const KEY_F1: i32         = 16
pub const KEY_F2: i32         = 17
pub const KEY_F3: i32         = 18
pub const KEY_F4: i32         = 19
pub const KEY_F5: i32         = 20
pub const KEY_F6: i32         = 21
pub const KEY_F7: i32         = 22
pub const KEY_F8: i32         = 23
pub const KEY_F9: i32         = 24
pub const KEY_F10: i32        = 25
pub const KEY_F11: i32        = 26
pub const KEY_F12: i32        = 27

pub struct KeyEvent {
    pub code: i32,
    pub char_val: u8,
    pub ctrl: bool,
    pub alt: bool,
    pub shift: bool,
}

impl KeyEvent {
    pub fn none() -> KeyEvent {
        KeyEvent { code: KEY_NONE, char_val: 0u8, ctrl: false, alt: false, shift: false }
    }

    pub fn char(ch: u8) -> KeyEvent {
        KeyEvent { code: KEY_CHAR, char_val: ch, ctrl: false, alt: false, shift: false }
    }

    pub fn key(code: i32) -> KeyEvent {
        KeyEvent { code: code, char_val: 0u8, ctrl: false, alt: false, shift: false }
    }

    pub fn is_char(self, ch: u8) -> bool {
        self.code == KEY_CHAR && self.char_val == ch && !self.ctrl
    }

    pub fn is_ctrl(self, ch: u8) -> bool {
        self.code == KEY_CHAR && self.char_val == ch && self.ctrl
    }
}

// ------------------------------------------------------------------------------
// KeyboardReader
// ------------------------------------------------------------------------------

pub struct KeyboardReader {
    pub pollfd: *raw var u8,
    pub inbuf: *raw var u8,
}

impl KeyboardReader {
    pub fn new() -> KeyboardReader {
        let pfd = malloc(16usize) as *raw var u8
        // fd = 0 (stdin)
        pfd[0usize] = 0u8
        pfd[1usize] = 0u8
        pfd[2usize] = 0u8
        pfd[3usize] = 0u8
        // events = POLLIN (1)
        pfd[4usize] = 1u8
        pfd[5usize] = 0u8
        // revents = 0
        pfd[6usize] = 0u8
        pfd[7usize] = 0u8

        let buf = malloc(128usize) as *raw var u8
        KeyboardReader {
            pollfd: pfd,
            inbuf: buf,
        }
    }

    pub fn poll(self, timeout_ms: i32) -> bool {
        let pfd = self.pollfd as *raw var u8
        pfd[6usize] = 0u8
        pfd[7usize] = 0u8
        // SYS_poll = 7
        let n = syscall3(7i64, pfd, 1i64, timeout_ms as i64)
        if n > 0i64 {
            let rev0 = pfd[6usize] as i32
            let rev1 = pfd[7usize] as i32
            let rev = rev0 | (rev1 << 8)
            // POLLIN (1) | POLLERR (8) | POLLHUP (16)
            return (rev & 25) != 0
        }
        false
    }

    pub fn read_key(var self, timeout_ms: i32) -> KeyEvent {
        let ready = self.poll(timeout_ms)
        if !ready {
            return KeyEvent.none()
        }

        let buf = self.inbuf as *raw var u8
        // SYS_read = 0, STDIN_FILENO = 0
        var n = syscall3(0i64, 0i64, buf, 64i64)
        if n <= 0i64 {
            return KeyEvent.none()
        }

        let b0 = buf[0usize]

        // Escape sequence or lone Escape
        if b0 == 27u8 {
            if n == 1i64 {
                // Timeout disambiguation: wait up to 30ms for following escape bytes
                let follow = self.poll(30)
                if !follow {
                    return KeyEvent { code: KEY_ESC, char_val: 27u8, ctrl: false, alt: false, shift: false }
                }
                let buf_cont = (buf as usize + 1usize) as *raw var u8
                let n2 = syscall3(0i64, 0i64, buf_cont, 63i64)
                if n2 <= 0i64 {
                    return KeyEvent { code: KEY_ESC, char_val: 27u8, ctrl: false, alt: false, shift: false }
                }
                n = n + n2
            }

            let b1 = buf[1usize]

            // Alt + character: \x1b followed by ASCII char
            if n == 2i64 && b1 >= 32u8 && b1 < 127u8 {
                return KeyEvent { code: KEY_CHAR, char_val: b1, ctrl: false, alt: true, shift: false }
            }

            // SS3 sequence: \x1bO [P, Q, R, S] -> F1, F2, F3, F4
            if b1 == 79u8 && n >= 3i64 {
                let b2 = buf[2usize]
                if b2 == 80u8 { return KeyEvent.key(KEY_F1) }
                if b2 == 81u8 { return KeyEvent.key(KEY_F2) }
                if b2 == 82u8 { return KeyEvent.key(KEY_F3) }
                if b2 == 83u8 { return KeyEvent.key(KEY_F4) }
            }

            // CSI sequence: \x1b[ ...
            if b1 == 91u8 && n >= 3i64 {
                let b2 = buf[2usize]
                if b2 == 65u8 { return KeyEvent.key(KEY_UP) }
                if b2 == 66u8 { return KeyEvent.key(KEY_DOWN) }
                if b2 == 67u8 { return KeyEvent.key(KEY_RIGHT) }
                if b2 == 68u8 { return KeyEvent.key(KEY_LEFT) }
                if b2 == 72u8 { return KeyEvent.key(KEY_HOME) }
                if b2 == 70u8 { return KeyEvent.key(KEY_END) }

                if n >= 4i64 && buf[3usize] == 126u8 { // ~ terminator
                    if b2 == 49u8 { return KeyEvent.key(KEY_HOME) }
                    if b2 == 50u8 { return KeyEvent.key(KEY_INSERT) }
                    if b2 == 51u8 { return KeyEvent.key(KEY_DELETE) }
                    if b2 == 52u8 { return KeyEvent.key(KEY_END) }
                    if b2 == 53u8 { return KeyEvent.key(KEY_PAGE_UP) }
                    if b2 == 54u8 { return KeyEvent.key(KEY_PAGE_DOWN) }
                }

                // F5 - F12 sequences: \x1b[15~ .. \x1b[24~
                if n >= 5i64 && buf[4usize] == 126u8 {
                    let b3 = buf[3usize]
                    if b2 == 49u8 && b3 == 53u8 { return KeyEvent.key(KEY_F5) }
                    if b2 == 49u8 && b3 == 55u8 { return KeyEvent.key(KEY_F6) }
                    if b2 == 49u8 && b3 == 56u8 { return KeyEvent.key(KEY_F7) }
                    if b2 == 49u8 && b3 == 57u8 { return KeyEvent.key(KEY_F8) }
                    if b2 == 50u8 && b3 == 48u8 { return KeyEvent.key(KEY_F9) }
                    if b2 == 50u8 && b3 == 49u8 { return KeyEvent.key(KEY_F10) }
                    if b2 == 50u8 && b3 == 51u8 { return KeyEvent.key(KEY_F11) }
                    if b2 == 50u8 && b3 == 52u8 { return KeyEvent.key(KEY_F12) }
                }

                // Kitty Keyboard Protocol: \x1b[ {key} ; {mod} u or \x1b[ {key} u
                let last_b = buf[(n - 1i64) as usize]
                if last_b == 117u8 { // 'u'
                    // Basic fallback decoding of Kitty key code
                    if b2 >= 48u8 && b2 <= 57u8 {
                        var key_val = (b2 - 48u8) as i32
                        var ki = 3usize
                        let limit = (n - 1i64) as usize
                        while ki < limit && buf[ki] >= 48u8 && buf[ki] <= 57u8 {
                            key_val = (key_val * 10) + ((buf[ki] - 48u8) as i32)
                            ki = ki + 1usize
                        }
                        if key_val >= 32 && key_val < 127 {
                            return KeyEvent.char(key_val as u8)
                        }
                    }
                }
            }

            return KeyEvent.key(KEY_ESC)
        }

        // Enter key
        if b0 == 10u8 || b0 == 13u8 {
            return KeyEvent.key(KEY_ENTER)
        }

        // Backspace key
        if b0 == 127u8 || b0 == 8u8 {
            return KeyEvent.key(KEY_BACKSPACE)
        }

        // Tab key
        if b0 == 9u8 {
            return KeyEvent.key(KEY_TAB)
        }

        // Ctrl + letter: ASCII 1..26
        if b0 >= 1u8 && b0 <= 26u8 {
            let ch = 96u8 + b0 // 1 -> 'a' (97), 3 -> 'c' (99)
            return KeyEvent { code: KEY_CHAR, char_val: ch, ctrl: true, alt: false, shift: false }
        }

        // Printable ASCII
        if b0 >= 32u8 && b0 < 127u8 {
            return KeyEvent.char(b0)
        }

        KeyEvent.none()
    }

    pub fn close_reader(var self) {
        if (self.pollfd as usize) != 0usize {
            free(self.pollfd as *raw u8)
            self.pollfd = 0usize as *raw var u8
        }
        if (self.inbuf as usize) != 0usize {
            free(self.inbuf as *raw u8)
            self.inbuf = 0usize as *raw var u8
        }
    }
}
