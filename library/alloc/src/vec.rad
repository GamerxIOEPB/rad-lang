// Rad Alloc Library: Vec<T> (Growable Contiguous Vector)

pub struct Vec<T> {
    pub ptr: *raw var T,
    pub cap: usize,
    pub len: usize,
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        Vec {
            ptr: 0 as *raw var T,
            cap: 0usize,
            len: 0usize,
        }
    }

    pub fn len(self) -> usize {
        self.len
    }

    pub fn capacity(self) -> usize {
        self.cap
    }

    pub fn is_empty(self) -> bool {
        self.len == 0usize
    }

    pub fn push(var self, item: T) {
        let item_size = size_of_val(item)
        if self.cap == 0usize {
            let new_cap = 4usize
            let raw = malloc((new_cap + 1usize) * item_size)
            self.ptr = raw as *raw var T
            self.cap = new_cap
        } else if self.len == self.cap {
            let new_cap = self.cap * 2usize
            let raw = realloc(self.ptr as *raw var u8, (new_cap + 1usize) * item_size)
            self.ptr = raw as *raw var T
            self.cap = new_cap
        }
        self.ptr[self.len] = item
        self.len = self.len + 1usize
        var zero_p = self.ptr as *raw var u8
        zero_p[self.len * item_size] = 0u8
    }

    pub fn pop(var self) -> Option<T> {
        if self.len == 0usize {
            Option.None
        } else {
            self.len = self.len - 1usize
            Option.Some(self.ptr[self.len])
        }
    }

    pub fn get(self, idx: usize) -> Option<T> {
        if idx >= self.len {
            Option.None
        } else {
            Option.Some(self.ptr[idx])
        }
    }

    pub fn set(var self, idx: usize, item: T) -> bool {
        if idx >= self.len {
            false
        } else {
            self.ptr[idx] = item
            true
        }
    }

    pub fn clear(var self) {
        self.len = 0usize
    }

    pub fn drop(var self) {
        if self.cap > 0usize {
            free(self.ptr as *raw var u8)
            self.cap = 0usize
            self.len = 0usize
        }
    }
}
